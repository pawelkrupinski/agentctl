<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  agentctl orphans kill safe, every 15 min (~/bin/AGENTCTL.md, "orphans"): ends only strays -- dead owners' records and
  their CI runs, wait loops whose agent or runs are gone (or duplicates), sbt servers whose worktree is gone, whose
  serving command's owner died, or that hold a running command with no CPU for 20 min (a thread dump first, in
  ~/.cache/agentctl/sbt-dumps/) -- never an owner merely on old code (it re-execs itself). Every kill is logged in
  ~/.cache/agentctl/reap.log. Source: ~/bin/launchd/; installed as a copy.
  Install: cp ~/bin/launchd/net.bitcashier.agentctl-reap.plist ~/Library/LaunchAgents/ &&
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.bitcashier.agentctl-reap.plist
  Unload:  launchctl bootout gui/$(id -u)/net.bitcashier.agentctl-reap
-->
<dict>
    <key>Label</key>
    <string>net.bitcashier.agentctl-reap</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/pawel/bin/agentctl</string>
        <string>orphans</string>
        <string>--kill</string>
        <string>--safe</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/pawel/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/pawel</string>
    </dict>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>StandardOutPath</key>
    <string>/Users/pawel/Library/Logs/agentctl-reap.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/pawel/Library/Logs/agentctl-reap.log</string>
</dict>
</plist>
