<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  agentctl watchdog, every 60 s and at login (~/bin/docs/landing-reconciler-design.md §10, phase 1 step 2): the
  invariant watchdog. W1 oldest unlanded change < 2 h, W2 no gate red unheld > 10 min, W5 the processor beats,
  W6 every due escalation notified, WM maintain ran. A violation: an INVARIANT condition + a notification; W5 also
  kickstarts net.bitcashier.agentctl-waiting (at most every 10 min). maintain watches it in turn.
  Source: ~/bin/launchd/; installed as a copy.
  Install: cp ~/bin/launchd/net.bitcashier.agentctl-watchdog.plist ~/Library/LaunchAgents/ &&
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.bitcashier.agentctl-watchdog.plist
  Unload:  launchctl bootout gui/$(id -u)/net.bitcashier.agentctl-watchdog
-->
<dict>
    <key>Label</key>
    <string>net.bitcashier.agentctl-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/pawel/bin/agentctl</string>
        <string>watchdog</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/pawel/bin:/Users/pawel/.sdkman/candidates/java/current/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/pawel</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/pawel/Library/Logs/agentctl-watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/pawel/Library/Logs/agentctl-watchdog.log</string>
</dict>
</plist>
