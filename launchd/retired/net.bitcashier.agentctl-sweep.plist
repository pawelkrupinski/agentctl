<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  agentctl sweep, daily at 09:00 (~/bin/AGENTCTL.md, "The lifecycle closes itself"): lists movies' unmerged worktrees and
  branches idle more than 3 days and deletes remote branches proven merged into main (standing OK). Report in
  ~/.cache/agentctl/sweep/<date>.txt, log below. Source: ~/bin/launchd/; installed as a copy.
  Install: cp ~/bin/launchd/net.bitcashier.agentctl-sweep.plist ~/Library/LaunchAgents/ &&
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.bitcashier.agentctl-sweep.plist
  Unload:  launchctl bootout gui/$(id -u)/net.bitcashier.agentctl-sweep
-->
<dict>
    <key>Label</key>
    <string>net.bitcashier.agentctl-sweep</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/pawel/bin/agentctl</string>
        <string>sweep</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/pawel/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/pawel</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/pawel/Library/Logs/agentctl-sweep.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/pawel/Library/Logs/agentctl-sweep.log</string>
</dict>
</plist>
