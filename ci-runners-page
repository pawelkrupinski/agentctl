    const lim = t => t.max && t.max !== "max" ? "max " + gib(t.max) : t.high && t.high !== "max" ? "high " + gib(t.high) : t.low && t.low !== "0" ? "low " + gib(t.low) : "no cap";
    const C = d.cpu || {tiers: {}, tasks: {}, peaks: {}}, H = d.history || [];
    const ncpu = set => (set || "").split(",").reduce((a, p) => a + (p.includes("-") ? p.split("-")[1] - p.split("-")[0] + 1 : (p.trim() ? 1 : 0)), 0);
    // A one-hour sparkline of centicores, against the ceiling it can reach.
    const spark = (vals, max) => { if (vals.length < 2) return ""; const w = 176, h = 34;
      const pts = vals.map((v, i) => `${(i * w / (vals.length - 1)).toFixed(1)},${(h - Math.min(1, (v || 0) / max) * h).toFixed(1)}`).join(" ");
      return `<svg class="spark" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none"><polyline points="${pts}"/></svg>`; };
    drawChart(d);
    const ccLine = (now, max) => now == null ? "" : `<span class="${now > 0.9 * max ? "old" : ""}">${now}</span> / ${max} cc`;
    document.getElementById("tiers").innerHTML = (L.host ? `<div class="tier"><b>Host</b> <span class="free">load ${esc(L.host.load)}</span><br>CPU ${ccLine(C.host, 3200)}
      ${spark(H.map(x => x[1]), 3200)}<span class="meta">last hour · ${esc(L.host.cpus)} threads = 3200 cc</span></div>` : "") +
      ["deploy","gate","check","measure"].filter(t => L.tiers && L.tiers[t]).map(t => { const x = L.tiers[t];
        const slots = Object.entries(L.runners).filter(([n, r]) => r.tier === t);
        const cap = slots.reduce((a, [, r]) => a + r.capacity, 0), used = slots.reduce((a, [n]) => a + (by[n] || []).length, 0);
        return `<div class="tier ${used >= cap ? "full" : ""}"><b>${t}</b> <span class="free">weight ${esc(x.weight)}</span>
