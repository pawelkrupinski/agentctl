    const d = await (await fetch("data.json", {cache: "no-store"})).json();
    document.getElementById("err").textContent = d.error ? "Could not read Forgejo" + (d.at ? " (showing " + d.at + ", " + dur(d.stale_secs) + " old)" : "") + ": " + d.error : "";
