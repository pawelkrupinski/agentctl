#!/usr/bin/env python3
"""Live page: what each Forgejo runner on ci-runner is running now, and what waits for which label.

  ~/bin/ci-runners-page [--port 8790]     then open http://localhost:8790

Reads Forgejo's database read-only through `agentctl db-q` (sqlite3 -readonly over ssh) every refresh.
"""
import argparse, collections, html, json, re, subprocess, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

AGENTCTL = str(Path.home() / "bin" / "agentctl")
FORGEJO = "http://forgejo.internal:3000"

RUNNING = """
select t.id as task, rn.name as runner, rp.owner_name || '/' || rp.name as repo, r."index" as run, r.workflow_id as workflow,
       replace(r.ref, 'refs/heads/', '') as ref, substr(r.commit_sha, 1, 9) as sha, j.name as job,
       j.runs_on as label, cast(strftime('%s','now') - j.started as integer) as secs
from action_task t
join action_runner rn on rn.id = t.runner_id
join action_run_job j on j.id = t.job_id
join action_run r on r.id = j.run_id
join repository rp on rp.id = r.repo_id
where t.status = 6
order by rn.name, j.started
"""

WAITING = """
select j.runs_on as label, count(*) as jobs, cast(max(strftime('%s','now') - j.created) as integer) as oldest,
       group_concat(distinct rp.name || ' ' || r.workflow_id) as runs
from action_run_job j
join action_run r on r.id = j.run_id
join repository rp on rp.id = r.repo_id
where j.status = 5 and j.runs_on != '[]'
group by j.runs_on
order by jobs desc
"""


def query(sql):
    beat()
    try:
        out = subprocess.run([AGENTCTL, "db-q", " ".join(sql.split())], capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        raise RuntimeError("the read of Forgejo's database (agentctl db-q over ssh to ci-runner) timed out after 60 s")
    lines = [l for l in out.stdout.splitlines() if l.strip()]
    if out.returncode != 0 or not lines:
        raise RuntimeError((out.stderr or out.stdout).strip()[-300:]
                           or f"agentctl db-q exited {out.returncode} with no output (ssh to ci-runner failed?)")
    head = lines[0].split("\t")
    return [dict(zip(head, l.split("\t"))) for l in lines[1:]]


WAITING_JOBS = """
select j.runs_on as label, rp.owner_name || '/' || rp.name as repo, r."index" as run, r.workflow_id as workflow,
       replace(r.ref, 'refs/heads/', '') as ref, substr(r.commit_sha, 1, 9) as sha, j.name as job,
       cast(strftime('%s','now') - j.created as integer) as secs
from action_run_job j
join action_run r on r.id = j.run_id
join repository rp on rp.id = r.repo_id
where j.status = 5 and j.runs_on != '[]'
order by j.runs_on, j.created
"""

LABELS = """
select name, agent_labels as labels from action_runner
where id in (select max(id) from action_runner where coalesce(deleted, 0) = 0 group by name)
"""

# Each runner's slot capacity and tier, and each tier's live CPU and memory limits, read off ci-runner itself (the
# runner configs and cgroups hold them; Forgejo's database does not). Read-only: systemctl show, cat, grep.
HOST_PROBE = r"""
for u in $(systemctl list-units 'gitea-runner-*.service' --no-legend --plain | awk '{print $1}'); do
  c=$(systemctl show -p ExecStart "$u" | grep -o '/nix/store/[^ ;]*config[^ ;]*' | head -1)
  printf 'R\t%s\t%s\t%s\t%s\n' "${u#gitea-runner-}" "$(grep -m1 -o 'capacity: [0-9]*' "$c" | cut -d' ' -f2)" \
    "$(systemctl show -p Slice --value "$u")" "$(systemctl show -p SubState --value "$u")"
done
for t in deploy gate check measure; do d=/sys/fs/cgroup/ci.slice/ci-$t.slice
  printf 'T\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$t" "$(cat $d/cpu.weight)" "$(cat $d/cpuset.cpus.effective)" \
    "$(head -1 $d/cpu.pressure | sed 's/.*avg10=\([0-9.]*\).*/\1/')" "$(cat $d/memory.current)" "$(cat $d/memory.max)" \
    "$(cat $d/memory.high)" "$(cat $d/memory.low)"
done
printf 'H\t%s\t%s\n' "$(cut -d' ' -f1-3 /proc/loadavg)" "$(nproc)"
"""


def host():
    beat()
    out = subprocess.run(["ssh", "-o", "ConnectTimeout=10", "pawel@10.1.0.3", HOST_PROBE], capture_output=True,
                         text=True, timeout=60)
    if out.returncode != 0:
        raise RuntimeError((out.stderr or "ssh failed").strip()[-300:])
    runners, tiers, load = {}, {}, None
    for line in out.stdout.splitlines():
        f = line.split("\t")
        if f[0] == "R" and len(f) >= 5:
            runners["runner-" + f[1].removesuffix(".service")] = {"capacity": int(f[2] or 0), "tier": f[3].removeprefix("ci-").removesuffix(".slice"),
                                         "state": f[4]}
        elif f[0] == "T" and len(f) >= 9:
            tiers[f[1]] = dict(zip(["weight", "cpus", "pressure", "mem", "max", "high", "low"], f[2:9]))
        elif f[0] == "H":
            load = {"load": f[1], "cpus": f[2]}
    return {"runners": runners, "tiers": tiers, "host": load}


# CPU use, every poll: each tier's and each job container's cumulative cpu.stat usage, and the host's /proc/stat, read
# off ci-runner (read-only). Rates come from consecutive samples; a job's container name carries its Forgejo task id.
CPU_PROBE = r"""
for t in deploy gate check measure; do printf 'S\t%s\t%s\n' "$t" "$(awk '/usage_usec/{print $2}' /sys/fs/cgroup/ci.slice/ci-$t.slice/cpu.stat)"; done
printf 'P\t%s\n' "$(head -1 /proc/stat)"
sudo -n docker ps --no-trunc --format '{{.ID}} {{.Names}}' | while read id n; do
  f=$(ls -d /sys/fs/cgroup/ci.slice/ci-*.slice/docker-$id.scope 2>/dev/null | head -1)
  [ -n "$f" ] && printf 'C\t%s\t%s\n' "$n" "$(awk '/usage_usec/{print $2}' $f/cpu.stat)"
done
true  # else the loop's last test sets the exit status: a job with no ci.slice scope must not fail the probe
"""


def cpu_sample():
    beat()
    out = subprocess.run(["ssh", "-o", "ConnectTimeout=10", "pawel@10.1.0.3", CPU_PROBE], capture_output=True,
                         text=True, timeout=60)
    if out.returncode != 0:
        raise RuntimeError((out.stderr or "ssh failed").strip()[-300:])
    tiers, tasks, busy = {}, {}, None
    for line in out.stdout.splitlines():
        f = line.split("\t")
        if f[0] == "S" and len(f) == 3 and f[2].isdigit():
            tiers[f[1]] = int(f[2])
        elif f[0] == "P":
            j = [int(x) for x in f[1].split()[1:]]
            busy = (sum(j) - j[3] - j[4], sum(j))  # (busy, total) jiffies: idle and iowait out
        elif f[0] == "C" and len(f) == 3:
            m = re.search(r"TASK-(\d+)_", f[1])
            if m and f[2].isdigit():
                tasks[m.group(1)] = int(f[2])
    return {"t": time.time(), "tiers": tiers, "tasks": tasks, "busy": busy}


def cpu_count(cpuset):
    n = 0
    for part in (cpuset or "").split(","):
        if "-" in part:
            a, b = part.split("-")
            n += int(b) - int(a) + 1
        elif part.strip().isdigit():
            n += 1
    return n


PREV = {}
PEAK = {}  # task id -> highest centicores seen
HISTORY = collections.deque(maxlen=360)  # (time, host cc, {tier: cc}) every 10 s: the last hour


def cpu_rates(now):
    """Centicores (1 core = 100) per tier, per running job's task and for the host, since the previous sample."""
    global PREV
    prev, PREV = PREV, now
    if not prev:
        return None
    dt = now["t"] - prev["t"]
    cc = lambda a, b: max(0, round((a - b) / dt / 10000))  # usec of CPU per second -> centicores
    tiers = {t: cc(v, prev["tiers"][t]) for t, v in now["tiers"].items() if t in prev["tiers"]}
    tasks = {k: cc(v, prev["tasks"][k]) for k, v in now["tasks"].items() if k in prev["tasks"]}
    for k, v in tasks.items():
        PEAK[k] = max(PEAK.get(k, 0), v)
    for k in [k for k in PEAK if k not in now["tasks"]]:
        del PEAK[k]
    host = None
    if now["busy"] and prev["busy"]:
        (b1, t1), (b0, t0) = now["busy"], prev["busy"]
        host = round(3200 * (b1 - b0) / max(1, t1 - t0))  # share of all 32 threads, in centicores
    HISTORY.append((round(now["t"]), host, tiers))
    return {"tiers": tiers, "tasks": tasks, "peaks": dict(PEAK), "host": host}


# The machine's last 24 hours, from the fleet Prometheus (node_exporter on ci-runner): CPU busy as centicores of its
# 32 threads, every 5 minutes. Asked over ssh on the monitoring host, whose Prometheus binds its private address only.
PROM = "10.0.0.25"
DAY_QUERY = '3200 * (1 - avg(rate(node_cpu_seconds_total{mode=~"idle|iowait",instance=~"10.1.0.3:.*"}[5m])) * 1)'


def day_history():
    end = int(time.time())
    cmd = (f"curl -s -G 'http://{PROM}:9090/api/v1/query_range' --data-urlencode 'query={DAY_QUERY}' "
           f"--data-urlencode start={end - 86400} --data-urlencode end={end} --data-urlencode step=300")
    beat()
    out = subprocess.run(["ssh", "-o", "ConnectTimeout=10", PROM, cmd], capture_output=True, text=True, timeout=60)
    res = json.loads(out.stdout)["data"]["result"]
    return [[int(float(t)), round(float(v))] for t, v in res[0]["values"]] if res else []


# The last good reading, refreshed by ONE background poller: a page load never waits on ssh to ci-runner, a slow or
# failed read keeps serving the last good one marked stale (like the events page, never a blank page), and /healthz
# reports whether the poller itself is alive, which is what the watchdog restarts on.
STATE = {"at": None, "running": [], "waiting": [], "waiting_jobs": [], "limits": {"runners": {}, "tiers": {}, "host": None}, "cpu": None, "history": [], "day": [], "error": "first read in progress", "polled": time.time()}
LOCK = threading.Lock()
SAVED = Path.home() / ".cache" / "ci-runners-page" / "last-good.json"  # survives a restart (the watchdog's included)


def beat():
    """The poller is making progress: stamped before each ssh read (each bounded at 60 s), so /healthz tells a stuck
    poller from a slow network -- a cycle of six slow but answering reads is no stall, and no restart."""
    with LOCK:
        STATE["polled"] = time.time()


def save_good():
    try:
        SAVED.parent.mkdir(parents=True, exist_ok=True)
        with LOCK:
            data = dict(STATE, history=list(HISTORY))
        tmp = SAVED.with_suffix(".tmp")
        tmp.write_text(json.dumps(data))
        tmp.replace(SAVED)
    except OSError:
        pass


def load_good():
    """The last good reading from before a restart, served marked stale until the first read succeeds."""
    try:
        data = json.loads(SAVED.read_text())
    except (OSError, ValueError):
        return
    for x in data.pop("history", None) or []:
        if time.time() - x[0] < 3600:
            HISTORY.append(tuple(x))
    data.update(history=list(HISTORY), error="first read since a restart in progress", polled=time.time())
    with LOCK:
        STATE.update(data)


def poll_forever(every=10):
    n = 0
    while True:
        started = time.time()
        try:
            fresh = {"running": query(RUNNING), "waiting": query(WAITING), "waiting_jobs": query(WAITING_JOBS)}
            if n % 6 == 0:
                try:
                    fresh["day"] = day_history()
                except Exception as e:  # the day chart is extra: its failure never blanks the page
                    fresh["day_error"] = str(e)
            if n % 6 == 0:  # limits change rarely: once a minute
                labels = {r["name"]: r["labels"] for r in query(LABELS)}
                h = host()
                for name, r in h["runners"].items():
                    r["labels"] = labels.get(name, "")
                fresh["limits"] = h
            n += 1
            try:
                rates = cpu_rates(cpu_sample())
                if rates:
                    fresh["cpu"] = rates
                    fresh["history"] = list(HISTORY)
            except Exception as e:  # CPU figures are extra: their failure never blanks the jobs
                fresh["cpu_error"] = str(e)
            with LOCK:
                STATE.update(fresh, at=time.strftime("%H:%M:%S"), ok=time.time(), error=None)
            save_good()
        except Exception as e:
            with LOCK:
                STATE["error"] = str(e)
        with LOCK:
            STATE["polled"] = time.time()
        time.sleep(max(1.0, every - (time.time() - started)))


def snapshot():
    with LOCK:
        s = dict(STATE)
    s["stale_secs"] = int(time.time() - s["ok"]) if s.get("ok") else None
    return s


