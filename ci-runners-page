#!/usr/bin/env python3
"""Live page: what each GitHub Actions runner is running now, and what waits for which label.

  ~/bin/ci-runners-page [--port 8790]     then open http://runners.localhost:8790

- bitcashier's self-hosted runners on ci-runner (bitcashier-gh-builder-*, -deployer-*): online/offline, busy, labels,
  the job each runs, and the jobs queued for a self-hosted label;
- the hosted runners of pawelkrupinski's repos (HOSTED_REPOS): the jobs in progress and queued, the runner image, and
  the concurrency in use against GitHub's hosted limit (HOSTED_LIMIT jobs per account);
- ci-runner's health (load, CPU per tier and per runner, memory, swap, disk), read-only over ssh, and its last 24 h
  from the fleet Prometheus.

Reads GitHub through `gh api` (the owner's own gh auth: no token of its own). ONE background poller, never a page load,
asks GitHub: at most one request a second, each answer cached 15 s (60 s for a repo with nothing running, an hour for
the org's repo list) and re-asked with its ETag, so an unchanged answer is a 304, which GitHub does not count against
the 5,000/h budget. Below LOW_REMAINING requests left it slows to one every LOW_GAP s; at 0 it waits for the reset.
The last good reading is kept in ~/.cache/ci-runners-page/last-good.json (served marked stale after a restart; agentctl's
red queue_full reads its `running`/`waiting_jobs`/`limits`). Binds 127.0.0.1 and answers only runners.localhost,
localhost and 127.0.0.1 (another name pointing here is a rebinding page). Read-only: GET alone.
"""
import argparse, collections, datetime, html, json, os, shutil, subprocess, threading, time, urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

ORG = "bitcashier"  # its self-hosted runners, and its repos' runs (the ones pushed to in REPO_RECENT)
HOSTED_OWNER = "pawelkrupinski"
HOSTED_REPOS = ("movies", "agentctl", "recommend", "movies-gitops")
HOSTED_LIMIT = 20  # GitHub's concurrent hosted-runner jobs per account (Free plan: 20)
REPO_RECENT = 14 * 86400
ACTIVE = {"queued", "in_progress", "waiting", "requested", "pending"}
# The run statuses asked for by name, every page: a live run older than the newest 40 is still live (2026-11-16: an
# Identity takes run's six queued drift rows read as 0 waiting for an hour, forty newer movies runs past it).
LIVE_STATUSES = ("queued", "in_progress")
EVERY = 15  # seconds between polls (and each answer's cache age)
IDLE_AGE = 60  # a repo with no run in progress is re-asked at most this often
MIN_GAP = 1.0  # seconds between two GitHub requests
LOW_REMAINING, LOW_GAP = 1000, 10.0
HOSTS = {"runners.localhost", "localhost", "127.0.0.1"}
SSH = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "ci-runner"]
SAVED = Path.home() / ".cache" / "ci-runners-page" / "last-good.json"
GH = shutil.which("gh") or "/opt/homebrew/bin/gh"


def epoch(s):
    try:
        return datetime.datetime.fromisoformat(str(s).replace("Z", "+00:00")).timestamp()
    except (TypeError, ValueError):
        return None


# ---------------------------------------------------------------- GitHub, politely
def parse_http(text):
    """(status, {lower-case header: value}, body) of `gh api -i` output."""
    text = text.replace("\r\n", "\n")
    head, _, body = text.partition("\n\n")
    lines = head.split("\n")
    parts = lines[0].split()
    if len(parts) < 2 or not parts[0].startswith("HTTP/") or not parts[1].isdigit():
        raise RuntimeError(f"no HTTP status in gh's answer: {text[:200]!r}")
    headers = {}
    for line in lines[1:]:
        k, _, v = line.partition(":")
        headers[k.strip().lower()] = v.strip()
    return int(parts[1]), headers, body


def gh_raw(path, etag=None):
    cmd = [GH, "api", "-i", path] + (["-H", f"If-None-Match: {etag}"] if etag else [])
    out = subprocess.run(cmd, capture_output=True, text=True, timeout=30)  # a 304 exits 1: the status line tells
    if not out.stdout.strip():
        raise RuntimeError((out.stderr or f"gh api exited {out.returncode}").strip()[-300:])
    return parse_http(out.stdout)


class GitHub:
    """GET with a per-path cache, ETags and one request at a time at most every MIN_GAP s (LOW_GAP when the budget runs
    low, none at all until the reset when it is spent)."""

    def __init__(self, raw=gh_raw, clock=time.time, sleep=time.sleep, beat=lambda: None):
        self.raw, self.clock, self.sleep, self.beat = raw, clock, sleep, beat
        self.cache = {}  # path -> {"etag", "body", "at", "used"}
        self.last = 0.0
        self.remaining = self.limit = self.reset = None
        self.calls = collections.deque()  # (time, status) of the last hour's requests

    def gap(self):
        return LOW_GAP if self.remaining is not None and self.remaining < LOW_REMAINING else MIN_GAP

    def get(self, path, max_age=EVERY):
        now = self.clock()
        c = self.cache.get(path)
        if c:
            c["used"] = now
            if now - c["at"] < max_age:
                return c["body"]
        if self.remaining == 0 and self.reset and now < self.reset:
            if c:
                return c["body"]
            raise RuntimeError(f"GitHub's rate limit is spent until {time.strftime('%H:%M', time.localtime(self.reset))}")
        wait = self.last + self.gap() - now
        if wait > 0:
            self.sleep(wait)
        self.beat()
        self.last = self.clock()
        status, headers, body = self.raw(path, c["etag"] if c else None)
        self.calls.append((self.last, status))
        while self.calls and self.calls[0][0] < self.last - 3600:
            self.calls.popleft()
        for k, attr in (("x-ratelimit-remaining", "remaining"), ("x-ratelimit-limit", "limit"),
                        ("x-ratelimit-reset", "reset")):
            if headers.get(k, "").isdigit():
                setattr(self, attr, int(headers[k]))
        if status == 304 and c:
            c["at"] = self.last
            if headers.get("etag"):
                c["etag"] = headers["etag"]
            return c["body"]
        if status == 200:
            data = json.loads(body or "null")
            self.cache[path] = {"etag": headers.get("etag"), "body": data, "at": self.last, "used": self.last}
            return data
        raise RuntimeError(f"GitHub {path}: HTTP {status} {body.strip()[:200]}")

    def prune(self, older=3600):
        """Forget answers nobody asked for in an hour (a finished run's jobs)."""
        now = self.clock()
        for p in [p for p, c in self.cache.items() if now - c["used"] > older]:
            del self.cache[p]

    def budget(self):
        return {"remaining": self.remaining, "limit": self.limit, "reset": self.reset,
                "calls": len(self.calls), "not_modified": sum(1 for _, s in self.calls if s == 304)}


def watched_repos(gh, now):
    """bitcashier's repos pushed to within REPO_RECENT (the org list asked hourly), then HOSTED_REPOS."""
    rs = gh.get(f"orgs/{ORG}/repos?per_page=100&type=all", 3600) or []
    org = sorted(f"{ORG}/{r['name']}" for r in rs
                 if not r.get("archived") and now - (epoch(r.get("pushed_at")) or 0) <= REPO_RECENT)
    return org + [f"{HOSTED_OWNER}/{n}" for n in HOSTED_REPOS]


def job_row(o_r, run, j, now):
    labels = list(j.get("labels") or [])
    start = epoch(j.get("started_at")) if j.get("status") == "in_progress" else epoch(j.get("created_at"))
    return {"repo": o_r, "run": run.get("run_number"), "run_id": run.get("id"), "workflow": run.get("name") or
            j.get("workflow_name") or "", "job": j.get("name") or "", "ref": run.get("head_branch") or "",
            "sha": (run.get("head_sha") or "")[:9], "status": j.get("status"), "labels": labels,
            "label": json.dumps(labels), "runner": j.get("runner_name") or "", "job_id": j.get("id"),
            "url": j.get("html_url") or run.get("html_url") or "", "secs": max(0, int(now - start)) if start else 0}


def runs_by_status(gh, o_r, status, age):
    """Every run of `o_r` GitHub lists under `status`, page after page while a page is full."""
    out, page = [], 1
    while True:
        got = (gh.get(f"repos/{o_r}/actions/runs?status={status}&per_page=100&page={page}", age) or {}).get(
            "workflow_runs") or []
        out += got
        if len(got) < 100:
            return out
        page += 1


def collect(gh, now, active_repos):
    """(runners, active job rows, errors) from GitHub. One repo's failure is that repo's line in errors, never a blank
    page. active_repos (mutated): the repos whose last listing had a run in progress, re-asked every EVERY s."""
    runners = (gh.get(f"orgs/{ORG}/actions/runners?per_page=100") or {}).get("runners") or []
    jobs, errors = [], []
    for o_r in watched_repos(gh, now):
        try:
            age = EVERY if o_r in active_repos else IDLE_AGE
            runs = (gh.get(f"repos/{o_r}/actions/runs?per_page=40", age) or {}).get("workflow_runs") or []
            live = {r["id"]: r for r in runs if r.get("status") in ACTIVE}
            for status in LIVE_STATUSES:
                for r in runs_by_status(gh, o_r, status, age):
                    live.setdefault(r["id"], r)
            live = list(live.values())
            (active_repos.add if live else active_repos.discard)(o_r)
            for r in live:
                for j in (gh.get(f"repos/{o_r}/actions/runs/{r['id']}/jobs?per_page=100") or {}).get("jobs") or []:
                    if j.get("status") in ACTIVE:
                        jobs.append(job_row(o_r, r, j, now))
        except Exception as e:
            errors.append(f"{o_r}: {e}"[:300])
    gh.prune()
    return runners, jobs, errors


