#!/usr/bin/env python3
"""Live page: what each Forgejo runner on ci-runner is running now, and what waits for which label.

  ~/bin/ci-runners-page [--port 8790]     then open http://localhost:8790

Reads Forgejo's database read-only through `agentctl db-q` (sqlite3 -readonly over ssh) every refresh.
"""
import argparse, html, json, subprocess, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

AGENTCTL = str(Path.home() / "bin" / "agentctl")
FORGEJO = "http://forgejo.internal:3000"

RUNNING = """
select rn.name as runner, rp.owner_name || '/' || rp.name as repo, r."index" as run, r.workflow_id as workflow,
       replace(r.ref, 'refs/heads/', '') as ref, substr(r.commit_sha, 1, 9) as sha, j.name as job,
       j.runs_on as label, cast(strftime('%s','now') - j.started as integer) as secs
from action_task t
join action_runner rn on rn.id = t.runner_id
join action_run_job j on j.id = t.job_id
join action_run r on r.id = j.run_id
join repository rp on rp.id = r.repo_id
where t.status = 6
order by rn.name, j.started
"""

WAITING = """
select j.runs_on as label, count(*) as jobs, cast(max(strftime('%s','now') - j.created) as integer) as oldest,
       group_concat(distinct rp.name || ' ' || r.workflow_id) as runs
from action_run_job j
join action_run r on r.id = j.run_id
join repository rp on rp.id = r.repo_id
where j.status = 5 and j.runs_on != '[]'
group by j.runs_on
order by jobs desc
"""


def query(sql):
    out = subprocess.run([AGENTCTL, "db-q", " ".join(sql.split())], capture_output=True, text=True, timeout=60)
    lines = [l for l in out.stdout.splitlines() if l.strip()]
    if out.returncode != 0 or not lines:
        raise RuntimeError((out.stderr or out.stdout).strip()[-300:] or "no output")
    head = lines[0].split("\t")
    return [dict(zip(head, l.split("\t"))) for l in lines[1:]]


WAITING_JOBS = """
select j.runs_on as label, rp.owner_name || '/' || rp.name as repo, r."index" as run, r.workflow_id as workflow,
       replace(r.ref, 'refs/heads/', '') as ref, substr(r.commit_sha, 1, 9) as sha, j.name as job,
       cast(strftime('%s','now') - j.created as integer) as secs
from action_run_job j
join action_run r on r.id = j.run_id
join repository rp on rp.id = r.repo_id
where j.status = 5 and j.runs_on != '[]'
order by j.runs_on, j.created
"""

LABELS = """
select name, agent_labels as labels from action_runner
where id in (select max(id) from action_runner where coalesce(deleted, 0) = 0 group by name)
"""

# Each runner's slot capacity and tier, and each tier's live CPU and memory limits, read off ci-runner itself (the
# runner configs and cgroups hold them; Forgejo's database does not). Read-only: systemctl show, cat, grep.
HOST_PROBE = r"""
for u in $(systemctl list-units 'gitea-runner-*.service' --no-legend --plain | awk '{print $1}'); do
  c=$(systemctl show -p ExecStart "$u" | grep -o '/nix/store/[^ ;]*config[^ ;]*' | head -1)
  printf 'R\t%s\t%s\t%s\t%s\n' "${u#gitea-runner-}" "$(grep -m1 -o 'capacity: [0-9]*' "$c" | cut -d' ' -f2)" \
    "$(systemctl show -p Slice --value "$u")" "$(systemctl show -p SubState --value "$u")"
done
for t in deploy gate check measure; do d=/sys/fs/cgroup/ci.slice/ci-$t.slice
  printf 'T\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$t" "$(cat $d/cpu.weight)" "$(cat $d/cpuset.cpus.effective)" \
    "$(head -1 $d/cpu.pressure | sed 's/.*avg10=\([0-9.]*\).*/\1/')" "$(cat $d/memory.current)" "$(cat $d/memory.max)" \
    "$(cat $d/memory.high)" "$(cat $d/memory.low)"
done
printf 'H\t%s\t%s\n' "$(cut -d' ' -f1-3 /proc/loadavg)" "$(nproc)"
"""


def host():
    out = subprocess.run(["ssh", "-o", "ConnectTimeout=10", "pawel@10.1.0.3", HOST_PROBE], capture_output=True,
                         text=True, timeout=60)
    if out.returncode != 0:
        raise RuntimeError((out.stderr or "ssh failed").strip()[-300:])
    runners, tiers, load = {}, {}, None
    for line in out.stdout.splitlines():
        f = line.split("\t")
        if f[0] == "R" and len(f) >= 5:
            runners["runner-" + f[1].removesuffix(".service")] = {"capacity": int(f[2] or 0), "tier": f[3].removeprefix("ci-").removesuffix(".slice"),
                                         "state": f[4]}
        elif f[0] == "T" and len(f) >= 9:
            tiers[f[1]] = dict(zip(["weight", "cpus", "pressure", "mem", "max", "high", "low"], f[2:9]))
        elif f[0] == "H":
            load = {"load": f[1], "cpus": f[2]}
    return {"runners": runners, "tiers": tiers, "host": load}


# The last good reading, refreshed by ONE background poller: a page load never waits on ssh to ci-runner, a slow or
# failed read keeps serving the last good one marked stale (like the events page, never a blank page), and /healthz
# reports whether the poller itself is alive, which is what the watchdog restarts on.
STATE = {"at": None, "running": [], "waiting": [], "waiting_jobs": [], "limits": {"runners": {}, "tiers": {}, "host": None}, "error": "first read in progress", "polled": time.time()}
LOCK = threading.Lock()


def poll_forever(every=10):
    n = 0
    while True:
        started = time.time()
        try:
            fresh = {"running": query(RUNNING), "waiting": query(WAITING), "waiting_jobs": query(WAITING_JOBS)}
            if n % 6 == 0:  # limits change rarely: once a minute
                labels = {r["name"]: r["labels"] for r in query(LABELS)}
                h = host()
                for name, r in h["runners"].items():
                    r["labels"] = labels.get(name, "")
                fresh["limits"] = h
            n += 1
            with LOCK:
                STATE.update(fresh, at=time.strftime("%H:%M:%S"), ok=time.time(), error=None)
        except Exception as e:
            with LOCK:
                STATE["error"] = str(e)
        with LOCK:
            STATE["polled"] = time.time()
        time.sleep(max(1.0, every - (time.time() - started)))


def snapshot():
    with LOCK:
        s = dict(STATE)
    s["stale_secs"] = int(time.time() - s["ok"]) if s.get("ok") else None
    return s


PAGE = """<!doctype html><html><head><meta charset="utf-8"><title>CI runners</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
:root{--bg:#fff;--fg:#1d1d1f;--muted:#6e6e73;--line:#e5e5ea;--card:#f5f5f7;--accent:#0a66c2;--warn:#b25000}
@media (prefers-color-scheme: dark){:root{--bg:#1c1c1e;--fg:#f2f2f7;--muted:#98989d;--line:#38383a;--card:#2c2c2e;--accent:#64a8ff;--warn:#ffb340}}
body{margin:0;padding:16px;background:var(--bg);color:var(--fg);font:14px/1.4 -apple-system,system-ui,sans-serif}
h1{font-size:20px;margin:0 0 4px}.sub{color:var(--muted);margin-bottom:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(360px,1fr));gap:12px}
.card{background:var(--card);border-radius:10px;padding:12px}.card h2{font-size:15px;margin:0 0 8px;display:flex;justify-content:space-between}
