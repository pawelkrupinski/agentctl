const dur = s => { s = +s; return s >= 3600 ? Math.floor(s/3600)+"h"+String(Math.floor(s%3600/60)).padStart(2,"0") : Math.floor(s/60)+"m"+String(s%60).padStart(2,"0")+"s"; };
async function tick() {
