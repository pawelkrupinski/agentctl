@media (max-width:420px){.grid{grid-template-columns:1fr}}
</style></head><body>
<h1>CI runners</h1><div class="sub" id="sub">loading…</div><div id="err" class="err"></div>
<div class="chartcard"><div class="charthead"><b>ci-runner</b> <span class="meta" id="chartnote"></span>
<span class="range"><button data-r="hour">Last hour, by tier</button><button data-r="day">Last 24 h</button></span></div>
<div id="chart"></div></div>
<div class="tiers" id="tiers"></div>
<div class="grid" id="runners"></div>
<h1 style="margin-top:24px">Waiting for a self-hosted runner</h1><table id="waiting"></table>
<h1 style="margin-top:24px">Hosted runners</h1><div class="tiers" id="hostedmeter"></div>
<div class="grid" id="hosted"></div>
<h2 style="font-size:15px;margin:16px 0 4px">Queued on hosted runners</h2><table id="hostedq"></table>
<script>
const esc = s => String(s ?? "").replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const dur = s => { s = +s || 0; return s >= 3600 ? Math.floor(s/3600)+"h"+String(Math.floor(s%3600/60)).padStart(2,"0") : Math.floor(s/60)+"m"+String(s%60).padStart(2,"0")+"s"; };
const gib = b => isNaN(+b) || b === "" ? b : (+b / 2**30).toFixed(0) + "G";
const link = j => /^https:\\/\\/github\\.com\\//.test(j.url || "") ? `<a href="${esc(j.url)}" target="_blank" rel="noopener">${esc(j.repo.split("/")[1])} #${esc(j.run)}</a>` : `${esc(j.repo.split("/")[1])} #${esc(j.run)}`;
const old = (s, lim) => `<span class="${+s > lim ? "old" : ""}">${dur(s)}</span>`;
const ncpu = (set, dflt) => (set || "").split(",").reduce((a, p) => a + (p.includes("-") ? p.split("-")[1] - p.split("-")[0] + 1 : (p.trim() ? 1 : 0)), 0) || dflt;
const spark = (vals, max) => { if (vals.length < 2) return ""; const w = 176, h = 34;
  const pts = vals.map((v, i) => `${(i * w / (vals.length - 1)).toFixed(1)},${(h - Math.min(1, (v || 0) / max) * h).toFixed(1)}`).join(" ");
  return `<svg class="spark" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none"><polyline points="${pts}"/></svg>`; };
const ccLine = (now, max) => now == null ? "" : `<span class="${now > 0.9 * max ? "old" : ""}">${now}</span> / ${max} cc`;
async function tick() {
  try {
    const d = await (await fetch("data.json", {cache: "no-store"})).json();
    const notes = (d.notes || []).map(esc).join("<br>");
    document.getElementById("err").innerHTML = (d.error ? "Could not read GitHub" + (d.at ? " (showing " + esc(d.at) + ", " + dur(d.stale_secs) + " old)" : "") + ": " + esc(d.error) : "") + (notes ? (d.error ? "<br>" : "") + notes : "");
    const L = d.limits || {runners: {}, tiers: {}}, C = d.cpu || {tiers: {}, runners: {}, peaks: {}}, H = d.history || [];
    const host = L.host || {}, CPUS = host.cpus || 32, HMAX = 100 * CPUS;
    drawChart(d, HMAX);
    const m = host.mem || {}, memUsed = m.MemTotal ? m.MemTotal - m.MemAvailable : null, swapUsed = m.SwapTotal ? m.SwapTotal - m.SwapFree : null;
    const tierCards = Object.keys(L.tiers || {}).filter(t => (d.runners || []).some(r => r.tier === t)).map(t => { const x = L.tiers[t];
      const mine = (d.runners || []).filter(r => r.tier === t), used = mine.filter(r => r.busy).length, cap = mine.length, max = 100 * ncpu(x.cpus, CPUS);
      return `<div class="tier ${used >= cap ? "full" : ""}"><b>${esc(t)}</b> <span class="free">weight ${esc(x.weight)}</span>
        <div class="bar"><i style="width:${cap ? Math.min(100, 100*used/cap) : 0}%"></i></div>${used}/${cap} runners busy<br>
        CPU pressure <span class="${+x.pressure > 40 ? "old" : ""}">${esc(x.pressure)}%</span> · mem ${gib(x.mem)}${x.max && x.max !== "max" ? " (max " + gib(x.max) + ")" : ""}<br>
        CPU ${ccLine((C.tiers || {})[t], max)}${spark(H.map(h => (h[2] || {})[t]), max)}</div>`; }).join("");
    document.getElementById("tiers").innerHTML = (host.load ? `<div class="tier ${memUsed > 0.9 * m.MemTotal ? "full" : ""}"><b>Host</b> <span class="free">load ${esc(host.load)}</span><br>CPU ${ccLine(C.host, HMAX)}
      ${spark(H.map(x => x[1]), HMAX)}<span class="meta">last hour · ${esc(CPUS)} threads = ${HMAX} cc</span><br>
      mem ${gib(memUsed)} / ${gib(m.MemTotal)}${swapUsed != null ? " · swap " + gib(swapUsed) + " / " + gib(m.SwapTotal) : ""}<br>
      ${(host.disks || []).map(k => `disk ${esc(k.mount)} <span class="${k.used > 0.9 * k.size ? "old" : ""}">${gib(k.used)} / ${gib(k.size)}</span>`).join("<br>")}</div>` : "") + tierCards;
    const g = d.github || {};
    document.getElementById("sub").textContent = (d.running || []).length + " self-hosted and " + ((d.hosted || {}).running || []).length + " hosted jobs running · data from " + (d.at || "—") + " · every 15 s" +
      (g.remaining != null ? " · GitHub API " + g.remaining + "/" + g.limit + " left, " + g.calls + " calls in the last hour (" + g.not_modified + " unchanged)" : "");
    const jobOf = {}; for (const j of d.running || []) jobOf[j.runner] = j;
    document.getElementById("runners").innerHTML = (d.runners || []).map(r => { const j = jobOf[r.name], off = r.status !== "online";
      return `<div class="card ${r.busy ? "full" : ""}"><h2>${esc(r.name)}<span class="count ${off ? "old" : ""}">${off ? esc(r.status) : r.busy ? "busy" : "idle"}</span></h2>` +
        `<div class="meta">${r.tier ? "tier " + esc(r.tier) + " · " : ""}${esc(r.labels.join(", "))}${r.unit && r.unit !== "running" ? " · <span class='old'>unit " + esc(r.unit) + "</span>" : ""}</div>` +
        (j ? `<div class="job">${link(j)} · ${esc(j.workflow)} · ${esc(j.job)}
          <div class="meta">${esc(j.ref)} @ ${esc(j.sha)} · ${old(j.secs, 1800)}${(C.runners || {})[r.name] != null ? ` · CPU <b>${C.runners[r.name]}</b> cc, peak ${(C.peaks || {})[r.name] ?? "?"}` : ""}</div></div>`
           : r.busy ? `<div class="job meta">busy with a job outside the watched repos</div>` : "") + "</div>"; }).join("") || "<div class='sub'>No runners.</div>";
    const jobsOf = {};
    for (const j of (d.waiting_jobs || [])) (jobsOf[j.label] ??= []).push(j);
    const lbl = l => { try { return JSON.parse(l).join(", "); } catch { return l; } };
    document.getElementById("waiting").innerHTML = (d.waiting || []).length ? "<tr><th>Label</th><th>Jobs</th><th>Oldest wait</th><th>From</th></tr>" +
      d.waiting.map(w => `<tr class="wrow" data-label="${esc(w.label)}"><td>${open.has(w.label) ? "▾" : "▸"} ${esc(lbl(w.label))}</td><td>${esc(w.jobs)}</td><td>${old(w.oldest, 1800)}</td><td class="meta">${esc((w.runs||"").split(",").join(", "))}</td></tr>` +
        (open.has(w.label) ? (jobsOf[w.label] || []).map(j => `<tr class="wjob"><td></td><td colspan="3">${link(j)} · ${esc(j.workflow)} · ${esc(j.job)} <span class="meta">· ${esc(j.ref)} @ ${esc(j.sha)} · waiting ${old(j.secs, 1800)}</span></td></tr>`).join("") : "")).join("")
      : "<tr><td class='meta'>Nothing waiting.</td></tr>";
    const Hd = d.hosted || {}, lim = Hd.limit || 20, used = Hd.used || {};
    const owners = [...new Set([Hd.owner, ...Object.keys(used)])].filter(Boolean);
    document.getElementById("hostedmeter").innerHTML = owners.map(o => { const u = used[o] || 0;
      return `<div class="tier ${u >= lim ? "full" : ""}"><b>${esc(o)}</b> <span class="free">concurrent jobs</span><div class="bar"><i style="width:${Math.min(100, 100*u/lim)}%"></i></div>${u}/${lim} in use${u >= lim ? " · <span class='old'>at the limit: new jobs queue</span>" : ""}</div>`; }).join("");
    const byRepo = {}; for (const j of Hd.running || []) (byRepo[j.repo] ??= []).push(j);
    document.getElementById("hosted").innerHTML = Object.keys(byRepo).sort().map(o_r => `<div class="card"><h2>${esc(o_r)}<span class="count">${byRepo[o_r].length} running</span></h2>` +
      byRepo[o_r].map(j => `<div class="job">${link(j)} · ${esc(j.workflow)} · ${esc(j.job)}
        <div class="meta">${esc(j.ref)} @ ${esc(j.sha)} · ${esc(j.labels.join(", "))}${j.runner ? " · " + esc(j.runner) : ""} · ${old(j.secs, 1800)}</div></div>`).join("") + "</div>").join("") || "<div class='sub'>Nothing running on hosted runners.</div>";
    document.getElementById("hostedq").innerHTML = (Hd.queued || []).length ? "<tr><th>Job</th><th>Image</th><th>Waiting</th></tr>" + Hd.queued.map(j =>
      `<tr><td>${link(j)} · ${esc(j.workflow)} · ${esc(j.job)} <span class="meta">· ${esc(j.ref)} @ ${esc(j.sha)}${j.status !== "queued" ? " · " + esc(j.status) : ""}</span></td><td class="meta">${esc(j.labels.join(", "))}</td><td>${old(j.secs, 600)}</td></tr>`).join("")
      : "<tr><td class='meta'>Nothing queued.</td></tr>";
  } catch (e) { document.getElementById("err").textContent = "Page server unreachable: " + e; }
}
// The machine chart: the last hour stacked by tier (a sample every poll, kept by the page server), or the last 24 h of
// the host's CPU from the fleet Prometheus. Y axis: centicores, 100 per thread.
const TIER_COLORS = {deploy: "#2e7d32", gate: "#0a66c2", check: "#b25000", measure: "#8e44ad"};
let range = (() => { try { return localStorage.getItem("ci-runners-range") || "hour"; } catch { return "hour"; } })();
let lastData = null, lastMax = 3200;
function drawChart(d, MAX) {
  lastData = d; lastMax = MAX;
  document.querySelectorAll(".range button").forEach(b => b.classList.toggle("on", b.dataset.r === range));
  const W = 1000, H = 180, L = 40, B = 18, T = 6, R = W - 4;
  const y = v => T + (H - T - B) * (1 - Math.min(1, (v || 0) / MAX));
  let series = [], t0, t1, legend = "", note = "";
  if (range === "day") {
    const pts = (d.day || []).filter(p => p[1] != null);
    if (pts.length < 2) { document.getElementById("chart").innerHTML = "<div class='meta'>No 24 h data yet" + (d.day_error ? ": " + esc(d.day_error) : "") + "</div>"; return; }
    t0 = pts[0][0]; t1 = pts[pts.length - 1][0];
    series = [{color: "var(--accent)", area: pts.map(p => [p[0], p[1]]), base: pts.map(p => [p[0], 0])}];
    const avg = Math.round(pts.reduce((a, p) => a + p[1], 0) / pts.length);
    note = `avg ${avg} cc (${Math.round(100 * avg / MAX)}%), peak ${Math.max(...pts.map(p => p[1]))} cc · 5 min steps`;
  } else {
    const h = (d.history || []).filter(x => x[1] != null);
    if (h.length < 2) { document.getElementById("chart").innerHTML = "<div class='meta'>Collecting the last hour (one sample every poll)…</div>"; return; }
    t0 = h[0][0]; t1 = h[h.length - 1][0];
    let below = h.map(x => [x[0], 0]);
    for (const tier of Object.keys(TIER_COLORS)) {
      const top = h.map((x, i) => [x[0], below[i][1] + ((x[2] || {})[tier] || 0)]);
      series.push({color: TIER_COLORS[tier], area: top, base: below});
      below = top;
    }
    series.push({color: "var(--fg)", line: h.map(x => [x[0], x[1]])});
    legend = Object.entries(TIER_COLORS).map(([t, c]) => `<span><i style="background:${c}"></i>${t}</span>`).join("") + `<span><i style="background:var(--fg)"></i>host total</span>`;
    const avg = Math.round(h.reduce((a, x) => a + x[1], 0) / h.length);
    note = `now ${h[h.length - 1][1]} cc · avg ${avg} cc (${Math.round(100 * avg / MAX)}%) over ${dur(t1 - t0)}`;
  }
  const x = t => L + (R - L) * (t - t0) / Math.max(1, t1 - t0);
  const path = pts => pts.map((p, i) => (i ? "L" : "M") + x(p[0]).toFixed(1) + "," + y(p[1]).toFixed(1)).join("");
  let svg = "";
  for (let i = 0; i <= 4; i++) { const v = Math.round(MAX * i / 4); svg += `<line class="grid" x1="${L}" x2="${R}" y1="${y(v)}" y2="${y(v)}"/><text x="${L - 4}" y="${y(v) + 3}" text-anchor="end">${v}</text>`; }
  for (let i = 0; i <= 4; i++) { const t = t0 + (t1 - t0) * i / 4, dt = new Date(t * 1000);
    svg += `<text x="${x(t)}" y="${H - 4}" text-anchor="${i === 0 ? "start" : i === 4 ? "end" : "middle"}">${String(dt.getHours()).padStart(2, "0")}:${String(dt.getMinutes()).padStart(2, "0")}</text>`; }
  for (const s of series) {
    if (s.area) svg += `<path d="${path(s.area)}L${[...s.base].reverse().map(p => x(p[0]).toFixed(1) + "," + y(p[1]).toFixed(1)).join("L")}Z" fill="${s.color}" fill-opacity="0.55" stroke="none"/>`;
    if (s.line) svg += `<path d="${path(s.line)}" fill="none" stroke="${s.color}" stroke-width="1.5" vector-effect="non-scaling-stroke"/>`;
  }
  document.getElementById("chart").innerHTML = `<svg viewBox="0 0 ${W} ${H}">${svg}</svg>` + (legend ? `<div class="legend">${legend}</div>` : "");
  document.getElementById("chartnote").textContent = note + ` · ${MAX} cc = all threads`;
}
document.querySelector(".range").addEventListener("click", e => {
  const b = e.target.closest("button"); if (!b) return;
  range = b.dataset.r; try { localStorage.setItem("ci-runners-range", range); } catch {}
  if (lastData) drawChart(lastData, lastMax);
});
// Unfolded labels survive the refresh and a reload.
const open = new Set((() => { try { return JSON.parse(localStorage.getItem("ci-runners-open") || "[]"); } catch { return []; } })());
document.getElementById("waiting").addEventListener("click", e => {
  const row = e.target.closest(".wrow");
  if (!row || e.target.closest("a")) return;
  const l = row.dataset.label;
  open.has(l) ? open.delete(l) : open.add(l);
  try { localStorage.setItem("ci-runners-open", JSON.stringify([...open])); } catch {}
  tick();
});
tick(); setInterval(tick, 15000);
</script></body></html>"""


def host_ok(host):
    """Only runners.localhost, localhost and 127.0.0.1 (any port)."""
    h = (host or "").strip().lower()
    if not h or h.startswith("["):
        return False
    name, _, port = h.partition(":")
    return name in HOSTS and (not port or port.isdigit())


class Handler(BaseHTTPRequestHandler):
    server_version = "ci-runners-page"

    def send(self, code, body, kind):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", "default-src 'none'; script-src 'unsafe-inline'; "
                         "style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def do_GET(self):
        if not host_ok(self.headers.get("Host")):
            return self.send(403, "forbidden host\n", "text/plain; charset=utf-8")
        path = urllib.parse.urlsplit(self.path).path
        if path == "/healthz":
            with LOCK:
                alive = time.time() - STATE["polled"] < 180
            return self.send(200 if alive else 503, "ok\n" if alive else "poller stalled\n", "text/plain")
        if path == "/data.json":
            return self.send(200, json.dumps(snapshot()), "application/json")
        if path in ("/", "/index.html"):
            return self.send(200, PAGE, "text/html; charset=utf-8")
        return self.send(404, "not found\n", "text/plain")

    do_HEAD = do_GET

    def do_POST(self):  # read-only
        self.send(405, "read-only: GET only\n", "text/plain")
    do_PUT = do_DELETE = do_PATCH = do_POST

    def log_message(self, *a):
        pass


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--port", type=int, default=8790)
    port = ap.parse_args().port
    rates = Rates()
    load_good(rates)
    threading.Thread(target=poll_forever, args=(GitHub(beat=beat), rates), daemon=True).start()
    print(f"ci-runners-page on http://runners.localhost:{port}", flush=True)
    ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
