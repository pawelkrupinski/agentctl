.job a{color:var(--accent);text-decoration:none}.meta{color:var(--muted);font-size:12px}
.old{color:var(--warn)}.wrow{cursor:pointer}.wrow:hover{background:var(--card)}.wjob td{border-top:none;padding-top:2px;padding-bottom:2px}table{border-collapse:collapse;width:100%}td,th{text-align:left;padding:6px 8px;border-top:1px solid var(--line);vertical-align:top}
th{color:var(--muted);font-weight:normal}.err{color:var(--warn);margin-bottom:12px}
.tiers{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px;margin-bottom:16px}
.tier{background:var(--card);border-radius:10px;padding:8px 12px;font-size:13px}.tier b{font-size:14px}
.bar{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:6px 0 4px}.bar i{display:block;height:100%;background:var(--accent)}
.full .bar i{background:var(--warn)}.free{color:var(--muted);font-weight:normal}
</style></head><body>
<h1>CI runners</h1><div class="sub" id="sub">loading…</div><div id="err" class="err"></div>
<div class="tiers" id="tiers"></div>
<div class="grid" id="runners"></div>
<h1 style="margin-top:24px">Waiting</h1><table id="waiting"></table>
<script>
const F = "%FORGEJO%";
const esc = s => String(s ?? "").replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const dur = s => { s = +s; return s >= 3600 ? Math.floor(s/3600)+"h"+String(Math.floor(s%3600/60)).padStart(2,"0") : Math.floor(s/60)+"m"+String(s%60).padStart(2,"0")+"s"; };
async function tick() {
  try {
    const d = await (await fetch("data.json", {cache: "no-store"})).json();
    document.getElementById("err").textContent = d.error ? "Could not read Forgejo" + (d.at ? " (showing " + d.at + ", " + dur(d.stale_secs) + " old)" : "") + ": " + d.error : "";
    const by = {}, L = d.limits || {runners: {}, tiers: {}};
    for (const r of d.running) (by[r.runner] ??= []).push(r);
    for (const n of Object.keys(L.runners || {})) by[n] ??= [];
    const gib = b => isNaN(+b) ? b : (+b / 2**30).toFixed(0) + "G";
    const lim = t => t.max && t.max !== "max" ? "max " + gib(t.max) : t.high && t.high !== "max" ? "high " + gib(t.high) : t.low && t.low !== "0" ? "low " + gib(t.low) : "no cap";
    document.getElementById("tiers").innerHTML = (L.host ? `<div class="tier"><b>Host</b><br>load ${esc(L.host.load)}<br>${esc(L.host.cpus)} CPUs</div>` : "") +
      ["deploy","gate","check","measure"].filter(t => L.tiers && L.tiers[t]).map(t => { const x = L.tiers[t];
        const slots = Object.entries(L.runners).filter(([n, r]) => r.tier === t);
        const cap = slots.reduce((a, [, r]) => a + r.capacity, 0), used = slots.reduce((a, [n]) => a + (by[n] || []).length, 0);
        return `<div class="tier ${used >= cap ? "full" : ""}"><b>${t}</b> <span class="free">weight ${esc(x.weight)}</span>
          <div class="bar"><i style="width:${cap ? Math.min(100, 100*used/cap) : 0}%"></i></div>${used}/${cap} slots · CPUs ${esc(x.cpus)}<br>
          CPU pressure <span class="${+x.pressure > 40 ? "old" : ""}">${esc(x.pressure)}%</span> · mem ${gib(x.mem)} (${lim(x)})</div>`; }).join("");
    document.getElementById("sub").textContent = d.running.length + " jobs running · data from " + (d.at || "—") + " · every 10 s";
    document.getElementById("runners").innerHTML = Object.keys(by).sort().map(n => { const r = (L.runners || {})[n]; const cap = r ? r.capacity : null;
      return `<div class="card ${cap !== null && by[n].length >= cap ? "full" : ""}"><h2>${esc(n)}<span class="count">${by[n].length}${cap !== null ? "/" + cap : ""} busy${cap !== null ? " · " + Math.max(0, cap - by[n].length) + " free" : ""}</span></h2>` +
        (r ? `<div class="meta">tier ${esc(r.tier)} · ${esc((() => { try { return JSON.parse(r.labels || "[]").join(", "); } catch { return r.labels; } })())}${r.state !== "running" ? " · <span class='old'>" + esc(r.state) + "</span>" : ""}</div>` +
             `<div class="bar"><i style="width:${cap ? Math.min(100, 100*by[n].length/cap) : 0}%"></i></div>` : "") +
      by[n].map(j => `<div class="job"><a href="${F}/${esc(j.repo)}/actions/runs/${esc(j.run)}" target="_blank">${esc(j.repo.split("/")[1])} #${esc(j.run)}</a> · ${esc(j.workflow)} · ${esc(j.job)}
        <div class="meta">${esc(j.ref)} @ ${esc(j.sha)} · ${esc(j.label)} · <span class="${+j.secs > 1800 ? "old" : ""}">${dur(j.secs)}</span></div></div>`).join("") + "</div>"; }).join("") || "<div class='sub'>Nothing running.</div>";
    const jobsOf = {};
    for (const j of (d.waiting_jobs || [])) (jobsOf[j.label] ??= []).push(j);
    document.getElementById("waiting").innerHTML = "<tr><th>Label</th><th>Jobs</th><th>Oldest wait</th><th>From</th></tr>" +
      d.waiting.map(w => `<tr class="wrow" data-label="${esc(w.label)}"><td>${open.has(w.label) ? "▾" : "▸"} ${esc(w.label)}</td><td>${esc(w.jobs)}</td><td class="${+w.oldest > 1800 ? "old" : ""}">${dur(w.oldest)}</td><td class="meta">${esc((w.runs||"").split(",").join(", "))}</td></tr>` +
        (open.has(w.label) ? (jobsOf[w.label] || []).map(j => `<tr class="wjob"><td></td><td colspan="3"><a href="${F}/${esc(j.repo)}/actions/runs/${esc(j.run)}" target="_blank">${esc(j.repo.split("/")[1])} #${esc(j.run)}</a> · ${esc(j.workflow)} · ${esc(j.job)} <span class="meta">· ${esc(j.ref)} @ ${esc(j.sha)} · <span class="${+j.secs > 1800 ? "old" : ""}">waiting ${dur(j.secs)}</span></span></td></tr>`).join("") : "")).join("");
  } catch (e) { document.getElementById("err").textContent = "Page server unreachable: " + e; }
}
// Unfolded labels survive the 10 s refresh and a reload.
const open = new Set(JSON.parse((() => { try { return localStorage.getItem("ci-runners-open") || "[]"; } catch { return "[]"; } })()));
document.getElementById("waiting").addEventListener("click", e => {
  const row = e.target.closest(".wrow");
  if (!row || e.target.closest("a")) return;
  const l = row.dataset.label;
  open.has(l) ? open.delete(l) : open.add(l);
  try { localStorage.setItem("ci-runners-open", JSON.stringify([...open])); } catch {}
  tick();
});
tick(); setInterval(tick, 10000);
</script></body></html>"""


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path.startswith("/healthz"):
            with LOCK:
                alive = time.time() - STATE["polled"] < 180
            self.send_response(200 if alive else 503)
            self.end_headers()
            self.wfile.write(b"ok\n" if alive else b"poller stalled\n")
            return
        if self.path.startswith("/data.json"):
            body, kind = json.dumps(snapshot()).encode(), "application/json"
        elif self.path in ("/", "/index.html"):
            body, kind = PAGE.replace("%FORGEJO%", html.escape(FORGEJO)).encode(), "text/html; charset=utf-8"
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", kind)
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *a):
        pass


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--port", type=int, default=8790)
    port = ap.parse_args().port
    threading.Thread(target=poll_forever, daemon=True).start()
    print(f"ci-runners-page on http://runners.localhost:{port}", flush=True)
    ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
