def parse_host(text, t):
    """One sample of ci-runner: host figures, tiers and runners, with cumulative CPU counters for rates."""
    h = {"t": t, "load": None, "cpus": None, "mem": {}, "disks": [], "tiers": {}, "runners": {}, "busy": None}
    for line in text.splitlines():
        f = line.split("\t")
        if f[0] == "H" and len(f) >= 3:
            h["load"], h["cpus"] = f[1], int(f[2]) if f[2].isdigit() else None
        elif f[0] == "M" and len(f) >= 3 and f[2].isdigit():
            h["mem"][f[1].rstrip(":")] = int(f[2]) * 1024
        elif f[0] == "D" and len(f) >= 4 and f[2].isdigit() and f[3].isdigit():
            h["disks"].append({"mount": f[1], "size": int(f[2]) * 1024, "used": int(f[3]) * 1024})
        elif f[0] == "T" and len(f) >= 8:
            h["tiers"][f[1]] = {"weight": f[2], "cpus": f[3], "usage": int(f[4]) if f[4].isdigit() else None,
                                "mem": f[5], "max": f[6], "pressure": f[7]}
        elif f[0] == "R" and len(f) >= 5:
            h["runners"][f[1]] = {"tier": f[2], "usage": int(f[3]) if f[3].isdigit() else None, "state": f[4]}
        elif f[0] == "P" and len(f) >= 2:
            j = [int(x) for x in f[1].split()[1:] if x.isdigit()]
            if len(j) > 4:
                h["busy"] = (sum(j) - j[3] - j[4], sum(j))  # (busy, total) jiffies: idle and iowait out
    return h


def host_sample():
    out = subprocess.run(SSH + [HOST_PROBE], capture_output=True, text=True, timeout=60)
    if out.returncode != 0:
        raise RuntimeError((out.stderr or "ssh to ci-runner failed").strip()[-300:])
    return parse_host(out.stdout, time.time())


def cpu_count(cpuset, default):
    n = 0
    for part in (cpuset or "").split(","):
        if "-" in part:
            a, b = part.split("-")
            n += int(b) - int(a) + 1
        elif part.strip().isdigit():
            n += 1
    return n or default


PROM = "10.0.0.25"
DAY_QUERY = '100 * count(node_cpu_seconds_total{mode="idle",instance=~"10.1.0.3:.*"}) * ' \
            '(1 - avg(rate(node_cpu_seconds_total{mode=~"idle|iowait",instance=~"10.1.0.3:.*"}[5m])))'


def day_history():
    """ci-runner's last 24 h of CPU busy in centicores, every 5 min, from the fleet Prometheus (private address: asked
    over ssh on the monitoring host)."""
    end = int(time.time())
    cmd = (f"curl -s -G 'http://{PROM}:9090/api/v1/query_range' --data-urlencode 'query={DAY_QUERY}' "
           f"--data-urlencode start={end - 86400} --data-urlencode end={end} --data-urlencode step=300")
    out = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", PROM, cmd], capture_output=True,
                         text=True, timeout=60)
    res = json.loads(out.stdout)["data"]["result"]
    return [[int(float(t)), round(float(v))] for t, v in res[0]["values"]] if res else []


# ---------------------------------------------------------------- the page's data
class Rates:
    """Centicores (1 core = 100) per tier, per runner and for the host between consecutive samples; each runner's peak
    for the job it runs now; the last hour of (time, host, {tier: cc})."""

    def __init__(self):
        self.prev, self.peaks, self.history = None, {}, collections.deque()

    def update(self, now, job_of):
        prev, self.prev = self.prev, now
        if not prev or now["t"] <= prev["t"]:
            return None
        dt = now["t"] - prev["t"]

        def rate(a, b):
            return max(0, round((a - b) / dt / 10000)) if a is not None and b is not None else None
        tiers = {t: rate(v["usage"], prev["tiers"].get(t, {}).get("usage")) for t, v in now["tiers"].items()}
        runners = {n: rate(v["usage"], prev["runners"].get(n, {}).get("usage")) for n, v in now["runners"].items()}
        for n, cc in runners.items():
            job = job_of.get(n)
            old = self.peaks.get(n)
            if job is None:
                self.peaks.pop(n, None)
            elif cc is not None:
                self.peaks[n] = (job, max(cc, old[1] if old and old[0] == job else 0))
        host = None
        if now["busy"] and prev["busy"]:
            (b1, t1), (b0, t0) = now["busy"], prev["busy"]
            host = round(100 * (now["cpus"] or 1) * (b1 - b0) / max(1, t1 - t0))
        self.history.append((round(now["t"]), host, {t: v for t, v in tiers.items() if v is not None}))
        while self.history and self.history[0][0] < now["t"] - 3600:
            self.history.popleft()
        return {"tiers": tiers, "runners": runners, "peaks": {n: p[1] for n, p in self.peaks.items()}, "host": host}


def is_self_hosted(row, names):
    return row["runner"] in names or "self-hosted" in row["labels"]


def assemble(runners, jobs, host=None, cpu=None):
    """The page's (and last-good.json's) data. Keys agentctl's red.queue_full reads keep the old page's shape:
    running[].runner/repo/run, waiting_jobs[].label/repo/run/secs (label: the job's runs-on as a JSON list), and
    limits.runners[name].labels (JSON list)/capacity/state ("running" when online)."""
    names = {r.get("name") for r in runners}
    host = host or {}
    rows = []
    for r in sorted(runners, key=lambda r: r.get("name") or ""):
        n = r.get("name")
        h = (host.get("runners") or {}).get(n, {})
        rows.append({"name": n, "status": r.get("status"), "busy": bool(r.get("busy")),
                     "labels": [x.get("name") for x in r.get("labels") or []], "tier": h.get("tier"),
                     "unit": h.get("state")})
    self_hosted = [j for j in jobs if is_self_hosted(j, names)]
    hosted = [j for j in jobs if not is_self_hosted(j, names)]
    running = [j for j in self_hosted if j["status"] == "in_progress" and j["runner"]]
    waiting_jobs = sorted((j for j in self_hosted if j["status"] != "in_progress"), key=lambda j: (j["label"], -j["secs"]))
    by_label = collections.OrderedDict()
    for j in waiting_jobs:
        by_label.setdefault(j["label"], []).append(j)
    waiting = sorted(({"label": label, "jobs": len(js), "oldest": max(j["secs"] for j in js),
                       "runs": ",".join(sorted({f"{j['repo'].split('/')[1]} {j['workflow']}" for j in js}))}
                      for label, js in by_label.items()), key=lambda w: -w["jobs"])
    used = collections.Counter(j["repo"].split("/")[0] for j in hosted if j["status"] == "in_progress")
    tiers = {t: {k: v for k, v in x.items() if k != "usage"} for t, x in (host.get("tiers") or {}).items()}
    return {
        "runners": rows, "running": running, "waiting": waiting, "waiting_jobs": waiting_jobs,
        "hosted": {"limit": HOSTED_LIMIT, "owner": HOSTED_OWNER, "used": dict(used),
                   "running": sorted((j for j in hosted if j["status"] == "in_progress"), key=lambda j: -j["secs"]),
                   "queued": sorted((j for j in hosted if j["status"] != "in_progress"), key=lambda j: -j["secs"])},
        "limits": {"runners": {r["name"]: {"labels": json.dumps(r["labels"]), "capacity": 1, "tier": r["tier"],
                                            "state": "running" if r["status"] == "online" else r["status"]}
                               for r in rows},
                   "tiers": tiers,
                   "host": {k: host.get(k) for k in ("load", "cpus", "mem", "disks")} if host else None},
        "cpu": cpu,
    }


# ---------------------------------------------------------------- the poller and its state
STATE = {"at": None, "ok": None, "runners": [], "running": [], "waiting": [], "waiting_jobs": [],
         "hosted": {"limit": HOSTED_LIMIT, "owner": HOSTED_OWNER, "used": {}, "running": [], "queued": []},
         "limits": {"runners": {}, "tiers": {}, "host": None}, "cpu": None, "history": [], "day": [],
         "error": "first read in progress", "polled": time.time()}
LOCK = threading.Lock()


def beat():
    """The poller is making progress (stamped before each GitHub request and ssh read): /healthz tells a stuck poller
    from a slow network."""
    with LOCK:
        STATE["polled"] = time.time()


def save_good():
    try:
        SAVED.parent.mkdir(parents=True, exist_ok=True)
        with LOCK:
            data = json.dumps(STATE)
        tmp = SAVED.with_suffix(".tmp")
        tmp.write_text(data)
        tmp.replace(SAVED)
    except OSError:
        pass


def load_good(rates):
    """The last good reading from before a restart, served marked stale until the first read succeeds."""
    try:
        data = json.loads(SAVED.read_text())
    except (OSError, ValueError):
        return
    if not isinstance(data, dict) or "runners" not in data:
        return
    for x in data.get("history") or []:
        if time.time() - x[0] < 3600:
            rates.history.append(tuple(x))
    data.update(history=list(rates.history), error="first read since a restart in progress", polled=time.time())
    with LOCK:
        STATE.update(data)


def poll_once(gh, rates, active_repos, n, sample=host_sample, day=day_history):
    fresh, notes = {}, []
    runners, jobs, errors = collect(gh, time.time(), active_repos)
    notes += errors
    host, cpu = None, None
    try:
        beat()
        host = sample()
        job_of = {j["runner"]: j["job_id"] for j in jobs if j["status"] == "in_progress" and j["runner"]}
        cpu = rates.update(host, job_of)
    except Exception as e:  # ci-runner's figures are extra: their failure never blanks the jobs
        notes.append(f"ci-runner: {e}"[:300])
    if n % 8 == 0:
        try:
            beat()
            fresh["day"] = day()
        except Exception as e:
            fresh["day_error"] = str(e)[:300]
    fresh.update(assemble(runners, jobs, host, cpu))
    if host is None:  # keep the last host figures rather than none
        with LOCK:
            fresh["limits"]["host"] = (STATE.get("limits") or {}).get("host")
            fresh["limits"]["tiers"] = (STATE.get("limits") or {}).get("tiers") or {}
    fresh.update(history=list(rates.history), notes=notes, github=gh.budget())
    return fresh


def poll_forever(gh, rates):
    active_repos, n = set(), 0
    while True:
        started = time.time()
        try:
            fresh = poll_once(gh, rates, active_repos, n)
            with LOCK:
                STATE.update(fresh, at=time.strftime("%H:%M:%S"), ok=time.time(), error=None)
            save_good()
        except Exception as e:
            with LOCK:
                STATE["error"] = str(e)[:500]
        n += 1
        beat()
        time.sleep(max(1.0, EVERY - (time.time() - started)))


def snapshot():
    with LOCK:
        s = dict(STATE)
    s["stale_secs"] = int(time.time() - s["ok"]) if s.get("ok") else None
    return s


