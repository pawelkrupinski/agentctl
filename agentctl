        return None


def entry_path(qd, eid):
    return os.path.join(qd, "entries", eid + ".json")


def read_entries(qd):
    es = [e for e in (read_json(p) for p in glob.glob(os.path.join(qd, "entries", "*.json"))) if e]
    return sorted(es, key=lambda e: (e.get("added_at", 0), e["id"]))


def write_entry(qd, e):
    e["updated"] = ts()
    write_json(entry_path(qd, e["id"]), e)


def find_entry(qd, ref, worktree=None):
    es = read_entries(qd)
    if ref:
        hits = [e for e in es if e["id"] == ref] or [e for e in es if ref in e["id"]]
        if len(hits) != 1:
            raise SystemExit(f"agentctl: {'no' if not hits else 'more than one'} queue entry matches {ref!r} (`agentctl queue status`)")
        return hits[0]
    mine = [e for e in es if e.get("worktree") == worktree]
    if not mine:
        raise SystemExit(f"agentctl: no queue entry for {worktree}; name one (`agentctl queue status`)")
    open_ = [e for e in mine if e["state"] not in FINAL]
    return (open_ or mine)[-1]


def processor_running(qd):
    st = read_json(os.path.join(qd, "processor.json")) or {}
    return bool(st.get("pid")) and st.get("phase") != "exited" and pid_alive(st["pid"]), st


def spawn_processor(qd, main):
    """Start `agentctl queue run` detached (its own session: it outlives the agent's turn), logging to the queue dir.
    A second processor exits at once on the lock, so starting one too many is harmless."""
    if os.environ.get("AGENTCTL_QUEUE_NO_SPAWN"):
        return None
    with open(os.path.join(qd, "processor.log"), "a") as log:
        p = subprocess.Popen([sys.executable, os.path.realpath(__file__), "queue", "run", "--repo", main], cwd=main,
                             stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, start_new_session=True, env=tool_env())
    return p.pid


def has_landing_check(repo, head):
    return bool(os.environ.get("AGENTCTL_LANDING_CHECK")) or git_ok(repo, "cat-file", "-e", f"{head}:scripts/identity-landing-check")


def cmd_queue(a):
    return {"add": cmd_queue_add, "status": cmd_queue_status, "wait": cmd_queue_wait, "cancel": cmd_queue_cancel,
            "run": cmd_queue_run,
            "resume": cmd_queue_resume, "requeue": cmd_queue_requeue}[a.qcmd](a)


def cmd_queue_add(a):
    if os.environ.get("PREPUSH_SKIP"):
        print("NOT QUEUED: PREPUSH_SKIP is set in the environment; the queue never skips checks. `unset PREPUSH_SKIP`.")
        return 1
    wt = git(a.repo or os.getcwd(), "rev-parse", "--show-toplevel").strip()
    main = main_checkout(wt)
    qd = queue_dir(main)
    main_ref = f"refs/remotes/{REMOTE}/main"
    if git(wt, "fetch", "--quiet", REMOTE, "main", check=False).returncode:
        err(f"git fetch {REMOTE} main failed; using the last fetched {REMOTE}/main")
    head = git(wt, "rev-parse", "HEAD").strip()
    branch = git(wt, "rev-parse", "--abbrev-ref", "HEAD").strip()
    if landed(wt, head, main_ref):
        print(f"LANDED {head} (already on {REMOTE}/main; nothing to queue)")
        return 0
    base = git(wt, "merge-base", head, main_ref).strip()
    commits = git(wt, "rev-list", "--reverse", f"{base}..{head}").split()
    files = [f for f in git(wt, "diff", "--name-only", base, head).splitlines() if f]
    why_identity = next((f for f in files if needs_identity_check(f)), None) if has_landing_check(wt, head) else None
    identity = bool(a.identity or why_identity)
    prod = [c for c in commits if any(is_production_path(p) for p in git(wt, "diff-tree", "--no-commit-id", "--name-only", "-r", c).split())]
    fixes = bool(prod) and all("Fixes-Red:" in git(wt, "log", "-1", "--format=%B", c) for c in prod)
    if git(wt, "status", "--porcelain", "--untracked-files=no").strip():
        err("note: uncommitted changes are not queued: only the committed HEAD is")
    with Flock(os.path.join(qd, "queue.lock")):
        es = read_entries(qd)
        dup = next((e for e in es if e["state"] not in FINAL and e.get("worktree") == wt), None)
        if dup:
            print(f"NOT QUEUED: {wt} already has entry {dup['id']} ({dup['state']}, head {dup['head'][:10]}). Wait for it, or "
                  f"`agentctl queue cancel {dup['id']}` (a queued entry only) and add again.")
            return 1
        eid = f"{now():%Y%m%d-%H%M%S}-{re.sub(r'[^A-Za-z0-9._-]+', '-', branch)[:40]}-{os.urandom(2).hex()}"
        e = {"id": eid, "state": "queued", "repo": main, "worktree": wt, "branch": branch, "head": head, "base": base,
             "commits": commits, "identity": identity, "identity_why": "--identity" if a.identity else why_identity,
             "production": bool(prod), "fixes_red": fixes, "added": ts(), "added_at": time.time(), "note": ""}
        write_entry(qd, e)
        write_json(os.path.join(qd, "config.json"), {"repo": main})
        pos = sum(1 for x in es if x["state"] not in FINAL) + 1
    print(f"QUEUED {eid}: {len(commits)} commit(s) up to {head[:10]} ({branch}); identity landing check: "
          + (f"yes ({e['identity_why']})" if identity else "no") + f"; {'production' if prod else 'tools-only'}; position {pos}")
    if not hand_over_token(qd, main):
        ns = queue_ns(main)
        print(f"note: no Forgejo token in this session (vault {ns} locked?): the processor cannot dispatch checks. "
              f"Ask the user to run `! secrets unlock {ns}`, then `agentctl queue resume`.")
    running, st = processor_running(qd)
    if not running:
        pid = spawn_processor(qd, main)
        if pid:
            err(f"started the queue processor (pid {pid}; log {os.path.join(qd, 'processor.log')})")
    hold = read_hold(qd)
    if hold:
        print(f"note: the queue is HELD: {hold['what']}")
    print(f"wait for it (Bash run_in_background=true, then END YOUR TURN): ~/bin/agentctl queue wait {eid}")
    return 0


def cmd_queue_status(a):
    main = main_checkout(a.repo or os.getcwd())
    qd = queue_dir(main)
    running, st = processor_running(qd)
    print(f"queue {qd} (repo {main})")
    if running:
        detail = " ".join(f"{k}={v}" for k, v in st.items() if k not in ("pid", "phase", "since") and v)
        print(f"processor: pid {st['pid']}, {st.get('phase')} since {st.get('since')}" + (f"; {detail}" if detail else ""))
    else:
        print("processor: not running")
    hold = read_hold(qd)
    if hold:
        print(f"HELD since {hold.get('since')}: {hold['what']}" + (f" -- {hold['detail']}" if hold.get("detail") else "")
              + ("; `agentctl queue resume` to go on" if hold.get("kind") == "flaky" else "; resumes when main moves and the gate is green"))
    es = read_entries(qd)
    open_ = [e for e in es if e["state"] not in FINAL]
    for e in open_:
        print(f"  {e['id']}  {e['state']:<10} {e['head'][:10]} {e.get('branch')} identity={'yes' if e.get('identity') else 'no'} "
              f"{'production' if e.get('production') else 'tools-only'}" + (" solo" if e.get("solo") else "")
              + (f"\n      {e['note']}" if e.get("note") else ""))
    if not open_:
        print("  (no open entries)")
    cutoff = time.time() - 86400
    done = [e for e in es if e["state"] in FINAL and e.get("finished_at", 0) >= cutoff]
    if done:
        print("finished in the last 24 h:")
        for e in done[-15:]:
            what = f"LANDED {e.get('result_sha', '')[:10]}" if e["state"] == "landed" else f"REJECTED {(e.get('why') or '').splitlines()[0][:100]}"
            print(f"  {e['id']}  {what}")
    return 0


def cmd_queue_wait(a):
    wt = git(a.repo or os.getcwd(), "rev-parse", "--show-toplevel").strip()
    main = main_checkout(wt)
    qd = queue_dir(main)
    eid = find_entry(qd, a.entry, wt)["id"]
    poll = float(os.environ.get("AGENTCTL_QUEUE_POLL", "20"))
    deadline, spawned_at = time.time() + a.timeout, 0.0
    while True:
        e = read_json(entry_path(qd, eid)) or {}
        if e.get("state") == "landed":
            print(f"LANDED {e['result_sha']}" + (f" ({e['why']})" if e.get("why") else ""))
            return 0
        if e.get("state") == "rejected":
            why = (e.get("why") or "no reason recorded").splitlines()
            for l in why[1:]:
                print(f"  {l}")
            print(f"REJECTED {why[0]}")
            return 1
        hold = read_hold(qd)
        if hold and hold_needs_resume(hold):
            if hold.get("kind") == "flaky":
                print(f"  {hold.get('detail', '')}; nobody rejected, nothing landed. Not yours unless your spec is named: report it.")
                print(f"  the owner resumes with `agentctl queue resume` once it is fixed on main")
                print(f"HELD flaky {', '.join(hold.get('specs') or [])} ({hold['what']})")
            else:
                print("  not your entry's fault: nobody rejected, nothing landed. Report it.")
                print(f"HELD {hold['what']}")
            return 3
        cfg = read_json(os.path.join(qd, "config.json")) or {}
        if not processor_running(qd)[0] and time.time() - spawned_at > 300:
            pid = spawn_processor(qd, cfg.get("repo") or main)
            spawned_at = time.time()
            if pid:
                err(f"no queue processor was running; started one (pid {pid})")
        if time.time() >= deadline:
            print(f"TIMEOUT after {a.timeout}s: {eid} is still {e.get('state')}" + (f" ({e['note']})" if e.get("note") else ""))
            return 2
        time.sleep(max(0.05, min(poll, deadline - time.time())))


def cmd_queue_cancel(a):
    wt = git(a.repo or os.getcwd(), "rev-parse", "--show-toplevel").strip()
    qd = queue_dir(main_checkout(wt))
    with Flock(os.path.join(qd, "queue.lock")):
        e = find_entry(qd, a.entry, wt)
        if e["state"] != "queued":
            print(f"NOT CANCELLED: {e['id']} is {e['state']}" + (" (in the current batch)" if e["state"] == "processing" else ""))
            return 1
        e.update(state="rejected", why="cancelled by its owner", finished=ts(), finished_at=time.time())
        write_entry(qd, e)
    print(f"CANCELLED {e['id']}")
    return 0


def queue_ns(main):
    try:
        return "movies" if slug(main).startswith("pawelkrupinski/") else "bitcashier"
    except (SystemExit, RuntimeError):
        return "movies"


def session_token(ns):
    """FORGEJO_API_TOKEN as THIS session sees it ($FORGEJO_API_TOKEN, else the vault). A detached processor is in
    another session and cannot read a vault unlocked here: `queue add` / `queue resume` hand it over."""
    if os.environ.get("FORGEJO_API_TOKEN"):
        return os.environ["FORGEJO_API_TOKEN"]
    try:
        r = subprocess.run(["secrets", "get", ns, "FORGEJO_API_TOKEN"], capture_output=True, text=True, timeout=15,
                           stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def store_token(qd, tok):
    """<queue dir>/token, mode 0600 from creation: never in argv, env of other tools, logs or status."""
    path, tmp = os.path.join(qd, "token"), os.path.join(qd, f".token.{os.getpid()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(tok + "\n")
    os.replace(tmp, path)


def stored_token(qd):
    try:
        with open(os.path.join(qd, "token")) as f:
            return f.read().strip() or None
    except OSError:
        return None


def hand_over_token(qd, main):
    """Refresh the processor's token from this session; lift a no-token hold when it worked. True when stored."""
    tok = session_token(queue_ns(main))
    if not tok:
        return False
    store_token(qd, tok)
    with Flock(os.path.join(qd, "queue.lock")):
        hold = read_hold(qd)
        if hold and hold.get("kind") == "no-token":
            os.unlink(os.path.join(qd, "hold.json"))
    return True


def token_verdict(tok):
    """'ok', 'rejected' (Forgejo answers 401/403) or 'unknown' (unreachable: the check will say so itself)."""
    req = urllib.request.Request(f"{API}/user", headers={"Authorization": f"token {tok}"})
    try:
        with urllib.request.urlopen(req, timeout=20):
            return "ok"
    except urllib.error.HTTPError as e:
        return "rejected" if e.code in (401, 403) else "unknown"
    except Exception:
        return "unknown"


def no_token_what(ns, why):
    return f"no-token: run `secrets unlock {ns}`, then `agentctl queue resume` ({why})"


def failure_signature(out):
    """The failing specs/steps a landing check named: the `  - <spec>: <test>` rows under its last `BLOCKED` line."""
    lines = out.splitlines()
    starts = [i for i, l in enumerate(lines) if l.strip() == "BLOCKED"]
    if not starts:
        return ("(no spec named)",)
    specs = {m.group(1).strip() for l in lines[starts[-1] + 1:] if (m := re.match(r"^\s+- ([^:]+):", l))}
    return tuple(sorted(specs)) or ("(no spec named)",)


def read_hold(qd):
    return read_json(os.path.join(qd, "hold.json"))


def hold_needs_resume(hold):
    return bool(hold.get("needs_resume") or hold.get("kind") in ("flaky", "no-token"))


def cmd_queue_requeue(a):
    """A wrongly rejected entry back in its ORIGINAL place. When its worktree already has an open entry for the same
    head (re-added meanwhile), that one takes the original place instead: no duplicate, its waiters stay valid."""
    main = main_checkout(a.repo or os.getcwd())
    qd = queue_dir(main)
    with Flock(os.path.join(qd, "queue.lock")):
        e = find_entry(qd, a.entry)
        if e["state"] != "rejected":
            print(f"NOT REQUEUED: {e['id']} is {e['state']}")
            return 1
        dup = next((x for x in read_entries(qd) if x["state"] not in FINAL and x.get("worktree") == e.get("worktree")), None)
        if dup and dup["head"] != e["head"]:
            print(f"NOT REQUEUED: {e.get('worktree')} has open entry {dup['id']} at another head ({dup['head'][:10]})")
            return 1
        if dup:
            dup.update(added_at=e["added_at"], note=f"moved to the place of {e['id']} (requeued)")
            write_entry(qd, dup)
            print(f"REQUEUED {dup['id']} in the place of {e['id']} (same head {e['head'][:10]}; not duplicated)")
        else:
            e.update(state="queued", why="", result_sha=None, finished=None, finished_at=None, note="requeued")
            if a.last:
                e["added_at"] = time.time()
            write_entry(qd, e)
            print(f"REQUEUED {e['id']} " + ("behind the open entries" if a.last else "in its original place"))
    if not processor_running(qd)[0]:
        spawn_processor(qd, main)
    return 0


def cmd_queue_resume(a):
    main = main_checkout(a.repo or os.getcwd())
    qd = queue_dir(main)
    if not hand_over_token(qd, main):
        ns = queue_ns(main)
        print(f"NOT RESUMED: no Forgejo token in this session: run `secrets unlock {ns}` here, then `agentctl queue resume`")
        return 1
    with Flock(os.path.join(qd, "queue.lock")):
        hold = read_hold(qd)
        if not hold:
            print("queue: not held (token refreshed)")
            if not processor_running(qd)[0]:
                spawn_processor(qd, main)
            return 0
        os.unlink(os.path.join(qd, "hold.json"))
        for p in glob.glob(os.path.join(qd, "verdicts", "*.json")):  # a resumed queue judges afresh
            os.unlink(p)
        with open(os.path.join(qd, "flaky.log"), "a") as f:
            f.write(f"{ts()}\tRESUMED\t{hold.get('what')}\n")
    print(f"RESUMED (was: {hold.get('what')})")
    if not processor_running(qd)[0]:
        spawn_processor(qd, main)
    return 0


def cmd_queue_run(a):
    main = main_checkout(a.repo or os.getcwd())
    qd = queue_dir(main)
    if os.environ.get("PREPUSH_SKIP"):
        print(f"{ts()} queue: refusing to run with PREPUSH_SKIP set", flush=True)
        return 1
    lock = Flock(os.path.join(qd, "processor.lock"))
    if not lock.acquire(block=False, tries=10):
        print(f"{ts()} queue: a processor already runs (pid {processor_running(qd)[1].get('pid')}); exiting", flush=True)
        return 0
    try:
        return QueueProcessor(qd, main, a.once).run(lock)
    finally:
        lock.release()


class QueueProcessor:
    def __init__(self, qd, repo, once=False):
        self.qd, self.repo, self.once = qd, repo, once
        self.work = os.path.join(qd, "work")
        self.main_ref = f"refs/remotes/{REMOTE}/main"
        self.env = tool_env()
        self.qlock = os.path.join(qd, "queue.lock")
        self.held_why = ""
        self.stop = False  # a FLAKY hold: exit, and stay down until `queue resume`
        self.batch_id = ""
        self.max_foreign = int(os.environ.get("AGENTCTL_MAX_FOREIGN", "2"))

    # -- bookkeeping
    def log(self, msg):
        print(f"{ts()} {msg}", flush=True)

    def status(self, phase, **kw):
        write_json(os.path.join(self.qd, "processor.json"), {"pid": os.getpid(), "phase": phase, "since": ts(), **kw})

    def update(self, e, only_if=None, **fields):
        with Flock(self.qlock):
            cur = read_json(entry_path(self.qd, e["id"]))
            if not cur or (only_if and cur["state"] != only_if):
                return None
            cur.update(fields)
            write_entry(self.qd, cur)
            return cur

    def finish(self, e, state, sha=None, why=""):
        self.log(f"{state.upper()} {e['id']}" + (f" {sha}" if sha else "") + (f": {why.splitlines()[0]}" if why else ""))
        self.update(e, state=state, result_sha=sha, why=why, finished=ts(), finished_at=time.time(), note="")

    def reject(self, e, why):
        self.finish(e, "rejected", why=why)

    def requeue(self, entries, note, solo=False):
        for e in entries:
            self.log(f"requeue {e['id']}: {note}")
            self.update(e, state="queued", note=note, batch_sha=None, **({"solo": True} if solo else {}))

    # -- the loop
    def run(self, lock):
        self.status("starting")
        for e in read_entries(self.qd):
            if e["state"] == "processing":  # we hold the lock: whoever was processing it is gone
                self.update(e, state="queued", note="requeued: the processor that held it ended")
        hold = backoff(float(os.environ.get("AGENTCTL_QUEUE_HOLD_POLL", "60")), 300)
        try:
            while True:
                try:
                    outcome = self.pass_()
                except Exception as e:  # never strand claimed entries: requeue them and hold
                    self.log(f"processor error: {e}\n{traceback.format_exc()}")
                    self.requeue([x for x in read_entries(self.qd) if x["state"] == "processing"], f"requeued after a processor error: {e}")
                    self.held_why, outcome = f"processor error: {e}", "held"
                if outcome == "progress":
                    hold = backoff(float(os.environ.get("AGENTCTL_QUEUE_HOLD_POLL", "60")), 300)
                    continue
                if outcome == "held":
                    if self.once or self.stop:
                        self.log(f"held ({self.held_why}); --once: exiting")
                        return 0
                    d = next(hold)
                    self.status("holding", why=self.held_why, retry_in=f"{d:.0f}s")
                    self.log(f"held ({self.held_why}); next try in {d:.0f}s")
                    time.sleep(d)
                    continue
                # idle: give up the lock, then look once more -- an entry added while we were leaving is not stranded
                self.status("exited")
                lock.release()
                if not any(e["state"] == "queued" for e in read_entries(self.qd)) or not lock.acquire(block=False, tries=10):
                    return 0
                self.status("starting")
        finally:
            if lock.fd is not None:
                self.status("exited")

    def fetch(self):
        for i in range(2):
            if git(self.repo, "fetch", "--quiet", REMOTE, "main", check=False).returncode == 0:
                return git(self.repo, "rev-parse", self.main_ref).strip()
            if i == 0:
                time.sleep(15)
        return None

    def gate(self):
        """(red, summary) from ci-why -- the pre-push red gate's view. ci-why failing holds nothing: the hook still gates."""
        try:
            red, text = ci_why(slug(self.repo), 3, repo=self.repo)
        except (Exception, SystemExit) as e:
            self.log(f"gate: ci-why failed ({e}); not holding (the pre-push hook still enforces the gate)")
            return False, ""
        return red, "; ".join(l.strip() for l in text.splitlines() if ": RED" in l) or "main is red for the gate"

    def preflight_token(self):
        """The Forgejo token, BEFORE any check dispatches or measure branch is pushed: the one `queue add`/`resume`
        handed over, else $FORGEJO_API_TOKEN, else this session's vault. None, or one Forgejo rejects -> HOLD no-token."""
        ns = queue_ns(self.repo)
        tok = stored_token(self.qd) or os.environ.get("FORGEJO_API_TOKEN") or session_token(ns)
        why = "none handed over and the vault is locked to the processor" if not tok else (
            "Forgejo rejects the handed-over token" if token_verdict(tok) == "rejected" else None)
        if why:
            self.set_hold("no-token", no_token_what(ns, why), needs_resume=True)
            self.stop = True
            return False
        self.env["FORGEJO_API_TOKEN"] = os.environ["FORGEJO_API_TOKEN"] = tok  # the check, the hook, ci-why's gate
        return True

    def set_hold(self, kind, what, **kw):
        write_json(os.path.join(self.qd, "hold.json"), {"kind": kind, "what": what, "since": ts(), **kw})
        self.log(f"HOLD {what}")
        self.held_why = what

    def pass_(self):
        hold = read_hold(self.qd)
        if hold and hold_needs_resume(hold):
            self.held_why, self.stop = f"{hold['what']}; `agentctl queue resume` to go on", True
            return "held"
        main = self.fetch()
        if not main:
            self.held_why = f"git fetch {REMOTE} main failed (tunnel? `agentctl env --check`)"
            return "held"
        if hold and hold.get("kind") == "main-red":
            if main == hold.get("sha") or self.gate()[0]:
                self.held_why = f"{hold['what']}; resumes when main moves and the gate is green"
                return "held"
            with Flock(self.qlock):
                if read_hold(self.qd) == hold:
                    os.unlink(os.path.join(self.qd, "hold.json"))
            self.log(f"resumed: main moved to {main[:10]} and the gate is green (was {hold['what']})")
        queued = [e for e in read_entries(self.qd) if e["state"] == "queued"]
        if not queued:
            return "idle"
        if not self.preflight_token():
            return "held"
        cands = [queued[0]] if queued[0].get("solo") else list(itertools.takewhile(lambda e: not e.get("solo"), queued))
        red, why = self.gate()
        ok = cands if not red else [e for e in cands if not e.get("production") or e.get("fixes_red")]
        if red:
            for e in cands:
                if e not in ok:
                    self.update(e, only_if="queued", note=f"held: main is red for the gate ({why}); production commits wait "
                                f"for green, tools-only entries land")
        if not ok:
            self.held_why = f"main is red for the gate ({why})"
            return "held"
        claimed = []
        with Flock(self.qlock):
            for e in ok:
                cur = read_json(entry_path(self.qd, e["id"]))
                if cur and cur["state"] == "queued":
                    cur.update(state="processing", note="")
                    write_entry(self.qd, cur)
                    claimed.append(cur)
        return self.batch(main, claimed) if claimed else "progress"

    # -- building
    def ensure_work(self, sha):
        if not (os.path.isdir(self.work) and git_ok(self.work, "rev-parse", "--git-dir")):
            git(self.repo, "worktree", "prune", check=False)
            if os.path.exists(self.work):
                os.rename(self.work, f"{self.work}.broken-{int(time.time())}")
            git(self.repo, "worktree", "add", "--detach", "-q", self.work, sha)
        git(self.work, "rebase", "--abort", check=False)
        git(self.work, "checkout", "-q", "--detach", "-f", sha)

    def rebases_alone(self, main, e):
        r = git(self.work, "rebase", "--quiet", "--onto", main, e["base"], e["head"], check=False)
        if r.returncode:
            git(self.work, "rebase", "--abort", check=False)
        return r.returncode == 0

    def batch(self, main, entries):
        self.status("building", batch=" ".join(e["id"] for e in entries))
        self.ensure_work(main)
        tip, included = main, []
        for e in entries:
            r = git(self.work, "rebase", "--quiet", "--onto", tip, e["base"], e["head"], check=False)
            if r.returncode:
                files = git(self.work, "diff", "--name-only", "--diff-filter=U", check=False).stdout.split()
                git(self.work, "rebase", "--abort", check=False)
                what = ", ".join(files) or r.stderr.strip()[:300]
                if tip != main and self.rebases_alone(main, e):
                    why = (f"conflicts with an earlier entry of the batch ({', '.join(x['id'] for x in included)}) in: {what}\n"
                           f"it rebases onto {REMOTE}/main alone: once those land, `git rebase {REMOTE}/main`, resolve, "
                           f"`agentctl queue add` again")
                else:
                    why = f"does not rebase onto {REMOTE}/main: conflicts in: {what}\n`git rebase {REMOTE}/main`, resolve, `agentctl queue add` again"
                self.reject(e, why)
                git(self.work, "checkout", "-q", "--detach", "-f", tip)
                continue
            new = git(self.work, "rev-parse", "HEAD").strip()
            if new == tip:
                if tip == main:
                    self.finish(e, "landed", sha=e["head"], why=f"already on {REMOTE}/main")
                else:
                    self.reject(e, "its commits are already in an earlier entry of the batch: "
                                   + ", ".join(x["id"] for x in included))
                continue
            problems = check_range(self.work, tip, new, [], self.max_foreign)
            if problems:
                self.reject(e, "prepush-check refused it after the rebase:\n" + "\n".join(problems))
                git(self.work, "checkout", "-q", "--detach", "-f", tip)
                continue
            e["batch_sha"] = new
            self.update(e, batch_sha=new)
            included.append(e)
            tip = new
        if not included:
            return "progress"
        self.batch_id = f"{now():%Y%m%d-%H%M%S}-{tip[:7]}"
        self.log(f"batch {self.batch_id} on {main[:10]}: " + ", ".join(e["id"] for e in included) + f" -> {tip[:10]}")
        if any(e.get("identity") for e in included):
            v, text, logp, sig = self.check(tip, main)
            if v == "error":
                return self.check_error(included, text, logp)
            if v == "red":
                return self.bisect(main, included, text, logp, sig)
        return self.push(main, tip, included)

    # -- the landing check
    @contextlib.contextmanager
    def slot(self):
        """One of the global landing-check slots (the same mkdir slots agents take by hand)."""
        slots = (os.environ.get("AGENTCTL_LANDING_SLOTS") or LANDING_SLOTS).split()
        poll = float(os.environ.get("AGENTCTL_SLOT_POLL", "60"))
        got = None
        while not got:
            for s in slots:
                try:
                    os.mkdir(s)
                    got = s
                    break
                except FileExistsError:
                    pass
            if not got:
                self.status("waiting for a landing-check slot", slots=" ".join(slots))
                time.sleep(poll)
        try:
            yield got
        finally:
            try:
                os.rmdir(got)
            except OSError:
                pass

    def check(self, sha, main, fresh=False):
        """('green'|'red'|'error', output tail, log path, failure signature) of the landing check at sha. A verdict is
        cached by (main, tree): identity-landing-check measures the tree against its merge-base with main, nothing
        else -- so bare main's own (base) verdict is paid once per main sha. fresh: run it, whatever the cache holds."""
        tree = git(self.work, "rev-parse", f"{sha}^{{tree}}").strip()
        vdir = os.path.join(self.qd, "verdicts")
        os.makedirs(vdir, exist_ok=True)
        cache = os.path.join(vdir, f"{main}-{tree}.json")
        hit = None if fresh else read_json(cache)
        if hit:
            self.log(f"landing check {sha[:10]}: {hit['verdict']} (cached for this main and tree)")
            return hit["verdict"], hit["text"], hit["log"], tuple(hit.get("sig") or ())
        argv = shlex.split(os.environ.get("AGENTCTL_LANDING_CHECK") or LANDING_CHECK) + [sha]
        os.makedirs(os.path.join(self.qd, "checks"), exist_ok=True)
        logp = os.path.join(self.qd, "checks", f"{sha[:12]}-{int(time.time())}.log")
        with self.slot():
            self.status("checking", sha=sha, log=logp)
            self.log(f"landing check {sha[:10]}: {' '.join(argv)} (log {logp})")
            with open(logp, "w") as f:
                try:
                    r = subprocess.run(argv, cwd=self.work, stdout=subprocess.PIPE, stderr=f, text=True, env=self.env,
                                       stdin=subprocess.DEVNULL, timeout=8 * 3600)
                    rc, out = r.returncode, r.stdout
                except subprocess.TimeoutExpired:
                    rc, out = 124, "landing check timed out after 8 h\n"
                f.write(out)
        lines = [l for l in out.splitlines() if l.strip()]
        last = lines[-1].strip() if lines else ""
        v = "green" if rc == 0 and last.startswith("LANDABLE") else "red" if rc == 1 else "error"
        with open(logp, errors="replace") as f:
            text = "\n".join(f.read().splitlines()[-30:])
        if v != "error":
            with Flock(self.qlock):
                h = read_hold(self.qd)
                if h and h.get("kind") == "no-verdict":
                    os.unlink(os.path.join(self.qd, "hold.json"))
                    self.log(f"a verdict again: lifted {h['what']}")
        sig = failure_signature(out) if v == "red" else ()
        self.log(f"landing check {sha[:10]}: {v} (exit {rc}; {last[:120]})" + (f" signature {', '.join(sig)}" if sig else ""))
        if v != "error":
            write_json(cache, {"verdict": v, "text": text, "log": logp, "sha": sha, "sig": list(sig)})
        return v, text, logp, sig

    def check_error(self, entries, text, logp):
        """No verdict (infra, dispatch, token) is NEVER an entry's fault: requeue everyone and HOLD the queue. Retried
        with backoff; after QUEUE_CHECK_ERRORS in a row the hold waits for `agentctl queue resume`."""
        self.requeue(entries, "requeued: the landing check gave no verdict")
        if re.search(r"no Forgejo token|HTTP 401", text):
            ns = queue_ns(self.repo)
            self.set_hold("no-token", no_token_what(ns, "the check could not authenticate"), needs_resume=True, log=logp)
            self.stop = True
            return "held"
        prev = read_hold(self.qd) or {}
        n = prev.get("attempts", 0) + 1 if prev.get("kind") == "no-verdict" else 1
        stop = n >= QUEUE_CHECK_ERRORS
        what = (f"no-verdict: the landing check could not run ({n}/{QUEUE_CHECK_ERRORS}; log {logp})"
                + ("; fix the cause, then `agentctl queue resume`" if stop else "; retrying with backoff"))
        self.set_hold("no-verdict", what, attempts=n, needs_resume=stop, log=logp, tail=text[-2000:])
        self.stop = stop
        return "held"

    def bisect(self, main, entries, red_text, red_log, red_sig):
        """The batch tip is BLOCKED. Blame needs proof, never a guess:
        1. bare main's own verdict (cached per main sha): any red there is not the batch's -> HOLD `MAIN RED`;
        2. by halves, the first prefix that is red (signature S) after a green one;
        3. ONE fresh re-check of that prefix: red again with the same S -> reject that entry, land the green prefix,
           requeue the rest. Green, or another signature -> a FLAKE: nobody rejected, nothing landed, HOLD `FLAKY`
           until `agentctl queue resume` (movies: never rerun to green; never pick between a red and a green run)."""
        bv, btext, blog, bsig = self.check(main, main)
        if bv == "error":
            return self.check_error(entries, btext, blog)
        if bv == "red":
            what = f"MAIN RED {', '.join(bsig)} at {main[:10]}"
            self.set_hold("main-red", what, sha=main, specs=list(bsig), log=blog, batch=self.batch_id)
            self.requeue(entries, f"HELD: {what} (base check {blog}): not this batch's; resumes when main moves and the gate is green")
            return "held"
        tips = [e["batch_sha"] for e in entries]
        lo, hi, runs = 0, len(entries), [red_log]
        while hi - lo > 1:
            mid = (lo + hi) // 2
            self.log(f"bisect: checking the first {mid} of {len(entries)} entries ({tips[mid - 1][:10]})")
            v, text, logp, sig = self.check(tips[mid - 1], main)
            runs.append(logp)
            if v == "error":
                return self.check_error(entries, text, logp)
            if v == "green":
                lo = mid
            else:
                hi, red_text, red_log, red_sig = mid, text, logp, sig
        self.log(f"re-checking the red boundary {tips[hi - 1][:10]} once (signature {', '.join(red_sig)})")
        v2, text2, log2, sig2 = self.check(tips[hi - 1], main, fresh=True)
        runs.append(log2)
        if v2 == "error":
            return self.check_error(entries, text2, log2)
        specs = ", ".join(red_sig)
        if v2 != "red" or sig2 != red_sig:
            detail = "green on the re-check" if v2 == "green" else f"re-check red with a different signature ({', '.join(sig2)})"
            what = f"FLAKY {specs} (batch {self.batch_id}, runs {red_log} {log2})"
            self.set_hold("flaky", what, specs=list(red_sig), batch=self.batch_id, runs=[red_log, log2], detail=detail,
                          entries=[e["id"] for e in entries])
            with open(os.path.join(self.qd, "flaky.log"), "a") as f:
                f.write(f"{ts()}\tFLAKY\t{specs}\tbatch {self.batch_id}\t{detail}\truns {' '.join(runs)}\n")
            self.requeue(entries, f"HELD flaky {specs}: {detail}; nobody rejected, nothing landed; "
                                  "`agentctl queue resume` once it is fixed on main (or the owner decides)")
            self.stop = True
            return "held"
        culprit, prefix, rest = entries[hi - 1], entries[:lo], entries[hi:]
        how = (f"with the {hi - 1} entr{'y' if hi == 2 else 'ies'} before it LANDABLE" if hi > 1 else "with bare main LANDABLE")
        self.reject(culprit, f"the identity landing check is BLOCKED with it, twice ({specs}); {how}; logs {red_log} {log2}\n{text2}")
        if prefix:
            outcome = self.push(main, tips[lo - 1], prefix)
            self.requeue(rest, f"requeued after {culprit['id']} was rejected")
            return outcome
        self.requeue(rest, f"requeued after {culprit['id']} was rejected")
        return "progress"

    # -- landing
    def push(self, main, tip, entries):
        cur = self.fetch()
        if cur != main:
            self.requeue(entries, f"{REMOTE}/main moved ({main[:10]} -> {(cur or '?')[:10]}) under the batch: rebuilding and rechecking")
            return "progress"
        self.status("pushing", sha=tip, batch=" ".join(e["id"] for e in entries))
        git(self.work, "checkout", "-q", "--detach", "-f", tip)  # the hook checks the pushed tree in place
        r = subprocess.run(push_argv(REMOTE, tip), cwd=self.work, capture_output=True, text=True, env=self.env)
        out = r.stdout + r.stderr
        logp = os.path.join(self.qd, "checks", f"push-{tip[:12]}-{int(time.time())}.log")
        os.makedirs(os.path.dirname(logp), exist_ok=True)
        with open(logp, "w") as f:
            f.write(out)
        if r.returncode == 0:
            self.fetch()
            for e in entries:
                if landed(self.repo, e["batch_sha"], self.main_ref):
                    self.finish(e, "landed", sha=e["batch_sha"])
                else:
                    self.reject(e, f"the push exited 0 but {e['batch_sha'][:10]} is not on {REMOTE}/main after a fetch; see {logp}")
            return "progress"
        if RACE.search(out):
            self.requeue(entries, f"push race ({RACE.search(out).group(0)}): rebuilding on the new main and rechecking")
            return "progress"
        tail = "\n".join([l for l in out.splitlines() if l.strip()][-25:])
        if REDGATE.search(out):
            self.requeue(entries, "held: the red gate refused the push (main is red)")
            self.held_why = "the red gate refused the push"
            return "held"
        if len(entries) > 1:
            self.log(f"the batch's pre-push hook failed (log {logp}):\n{tail}")
            self.requeue(entries, f"the batch's pre-push hook failed (log {logp}); retrying each entry alone", solo=True)
            return "progress"
        hint = ("\nHINT: the hook could not reach Forgejo (tunnel dropped?): `~/bin/agentctl env --check`, then queue add again"
                if TUNNEL_TROUBLE.search(out) else "")
        self.reject(entries[0], f"the pre-push hook failed (full log {logp}):\n{tail}{hint}")
        return "progress"


# ---------------------------------------------------------------- env
TUNNEL_PORTS = [(3000, "Forgejo web/API"), (2222, "Forgejo ssh")]


def default_ns():
    return "movies" if os.path.realpath(os.getcwd()).startswith(os.path.realpath(f"{HOME}/projects/movies")) else "bitcashier"


def vault_state(ns):
    """'unlocked', 'locked' or 'unknown: <why>' -- `secrets status` only; never unlock, never read a value."""
    try:
        r = subprocess.run(["secrets", "status", ns], capture_output=True, text=True, timeout=10, stdin=subprocess.DEVNULL)
    except FileNotFoundError:
        return "unknown: no `secrets` command"
    except subprocess.TimeoutExpired:
        return "unknown: `secrets status` timed out"
    out = r.stdout.strip()
    return out if out in ("unlocked", "locked") else ("locked" if "locked" in out and "unlocked" not in out else f"unknown: {out or r.stderr.strip()[:80]}")


def locked_line(ns):
    return f"vault {ns} locked: ask the user to run `! secrets unlock {ns}`"


def port_open(port, host="127.0.0.1", timeout=2.0):
    import socket
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def export_lines():
    lines = []
    bins = [b for b in SDKMAN_BINS if os.path.isdir(b)]
    if bins:
        lines.append(f'export PATH="{":".join(bins)}:$PATH"')
    jh = f"{HOME}/.sdkman/candidates/java/current"
    if os.path.isdir(jh):
        lines.append(f'export JAVA_HOME="{jh}"')
    lines.append(f'export AGENTCTL_ENV=1')
    return lines


def token_works(ns):
    """Read the Forgejo token inside this call (never printed) and ask the API who it is. (ok, detail)."""
    r = subprocess.run(["secrets", "get", ns, "FORGEJO_API_TOKEN"], capture_output=True, text=True, timeout=15, stdin=subprocess.DEVNULL)
    tok = r.stdout.strip()
    if r.returncode or not tok:
        return False, f"no FORGEJO_API_TOKEN in vault {ns}"
    try:
        req = urllib.request.Request(f"{API}/user", headers={"Authorization": f"token {tok}"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            login = json.loads(resp.read()).get("login")
        return True, f"token valid (user {login})"
    except Exception as e:
        return False, f"token rejected or API unreachable: {str(e)[:80]}"
    finally:
        tok = None


def cmd_env(a):
    ns = a.ns or default_ns()
    if not a.check:
        print("\n".join(export_lines()))
        st = vault_state(ns)
        if st != "unlocked":
            print(locked_line(ns) if st == "locked" else f"vault {ns} {st}", file=sys.stderr)
            return 1
        return 0
    env = tool_env()
    problems, report = [], []

    def which(cmd):
        for d in env["PATH"].split(":"):
            p = os.path.join(d, cmd)
            if os.path.isfile(p) and os.access(p, os.X_OK):
                return p
        return None

    sbt = which("sbt")
    (report if sbt else problems).append(f"sbt: {sbt or 'NOT FOUND (install sdkman sbt)'}")
    java = os.path.join(env["JAVA_HOME"], "bin", "java") if env.get("JAVA_HOME") else which("java")
    jv = subprocess.run([java, "-version"], capture_output=True, text=True, timeout=30) if java else None
    if jv and jv.returncode == 0:
        report.append(f"java: {(jv.stderr or jv.stdout).splitlines()[0]}")
    else:
        problems.append(f"java: no java that runs ({java or 'none on PATH'})")
    st = vault_state(ns)
    if st == "locked":
        print(locked_line(ns))
        return 1
    (report if st == "unlocked" else problems).append(f"vault {ns}: {st}")
    tunnel_ok = True
    for port, what in TUNNEL_PORTS:
        ok = port_open(port)
        tunnel_ok &= ok
        (report if ok else problems).append(f"tunnel localhost:{port} ({what}): {'open' if ok else 'REFUSED'}")
    if not tunnel_ok:
        problems.append("  fix: launchctl kickstart -k gui/$(id -u)/net.bitcashier.forgejo-tunnel")
    if st == "unlocked" and port_open(TUNNEL_PORTS[0][0]):
        ok, detail = token_works(ns)
        (report if ok else problems).append(f"forgejo-gh token ({ns}): {detail}")
    gh = os.path.exists(FORGEJO_GH)
    (report if gh else problems).append(f"forgejo-gh: {FORGEJO_GH if gh else 'MISSING ' + FORGEJO_GH}")
    for l in report:
        print(f"ok   {l}")
    for l in problems:
        print(f"FAIL {l}")
    return 1 if problems else 0


# ---------------------------------------------------------------- db-q
DB_ENVS = {
    "forgejo": ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", "pawel@10.1.0.3",
                'sudo -u forgejo nix --extra-experimental-features "nix-command flakes" shell nixpkgs#sqlite -c '
                "sqlite3 -readonly -safe -bail -header -tabs /mnt/data/forgejo/data/forgejo.db"],
}
# Defence in depth: sqlite3 already runs -readonly -safe. One statement, starting SELECT / WITH / PRAGMA, and none of
# these (a CTE can front an INSERT/UPDATE/DELETE; -safe already blocks the file functions).
WRITE_WORDS = re.compile(r"\bINSERT\b|\bREPLACE\s+INTO\b|\bUPDATE\b\s+\S+\s+SET\b|\bDELETE\s+FROM\b|"
                         r"\b(DROP|ALTER|CREATE|ATTACH|DETACH|VACUUM|REINDEX)\s+\w|"
                         r"\b(load_extension|writefile|readfile|edit|fts3_tokenizer)\s*\(", re.I)
TUNNEL_LABEL = "net.bitcashier.forgejo-tunnel"


def strip_sql(sql):
    """The SQL with comments and string/identifier literals blanked (keywords inside them say nothing), in one pass."""
    tok = re.compile(r"'(?:[^']|'')*'|\"(?:[^\"]|\"\")*\"|`[^`]*`|\[[^\]]*\]|--[^\n]*|/\*.*?\*/", re.S)
    return tok.sub(lambda m: " " if m.group(0)[:2] in ("--", "/*") else "''", sql)


def sql_refusal(sql):
    """None when the SQL is a single read-only SELECT / WITH ... SELECT / PRAGMA read; else why it is refused."""
    if any(l.lstrip().startswith(".") for l in sql.splitlines()):
        return "sqlite3 dot-commands are refused"
    bare = strip_sql(sql).strip()
    if not bare:
        return "empty query"
    if ";" in bare.rstrip(";").rstrip():
        return "one statement only"
    first = bare.split(None, 1)[0].upper()
    if first not in ("SELECT", "WITH", "PRAGMA"):
        return f"only SELECT, WITH and PRAGMA are allowed (got {first})"
    m = WRITE_WORDS.search(bare)
    if m:
        return f"write/side-effect keyword {m.group(0)!r} is refused"
    if first == "PRAGMA" and "=" in bare:
        return "PRAGMA assignments are refused (reads only)"
    return None


def kick_tunnel():
    subprocess.run(["launchctl", "kickstart", "-k", f"gui/{os.getuid()}/{TUNNEL_LABEL}"], capture_output=True)
    for _ in range(15):
        if port_open(TUNNEL_PORTS[0][0]):
            return True
        time.sleep(1)
    return False


def run_db(argv, sql):
    return subprocess.run(argv, input=sql.rstrip().rstrip(";") + ";\n", capture_output=True, text=True, timeout=300)


def cmd_db_q(a):
    why = sql_refusal(a.sql)
    if why:
        print(f"agentctl db-q: REFUSED: {why}", file=sys.stderr)
        return 2
    argv = DB_ENVS[a.env]
    r = run_db(argv, a.sql)
    if r.returncode != 0 and re.search(r"Connection refused|Connection timed out|No route to host", r.stderr):
        err(f"connection refused; reopening the tunnel ({TUNNEL_LABEL}) once")
        kick_tunnel()
        r = run_db(argv, a.sql)
    if r.returncode != 0:
        print(f"agentctl db-q: failed (exit {r.returncode}): {r.stderr.strip()[-500:]}", file=sys.stderr)
        return 1
    lines = r.stdout.splitlines()
    head, rows = lines[:1], lines[1:]
    print("\n".join(head + rows[: a.max_rows]))
    if len(rows) > a.max_rows:
        print(f"... {len(rows) - a.max_rows} more row(s) not shown (capped at {a.max_rows}; add LIMIT/WHERE or --max-rows)")
    return 0


