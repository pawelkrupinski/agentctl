class Flock:
    """An flock(2) lock: released by the kernel when its holder dies, so it never goes stale."""

    def __init__(self, path):
        self.path, self.fd = path, None

    def acquire(self, block=True, tries=1, delay=0.2):
        fd = os.open(self.path, os.O_CREAT | os.O_RDWR, 0o644)
        for i in range(tries):
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | (0 if block else fcntl.LOCK_NB))
                self.fd = fd
                return True
            except BlockingIOError:
                if i + 1 < tries:
                    time.sleep(delay)
        os.close(fd)
        return False

    def release(self):
        if self.fd is not None:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)
            self.fd = None

    def __enter__(self):
        self.acquire()
        return self

    def __exit__(self, *exc):
        self.release()


