# -- infra NOT LANDED (the owner, 2026-10-28: 7 changes sat unlanded overnight after infra failures and nobody retried):
# a NOT LANDED whose text names infra opens a condition on the same infra check; when it passes, `agentctl land` runs
# again in that worktree (it rebases first: a conflict is a real NOT LANDED for the author). A cause the text does not
# name is real (the author's) and retried at most once; a test failure, a conflict, a refusal stay the author's.
LAND_INFRA = [  # (pattern, probe kind): first match wins
    (re.compile(r"git fetch \S+ main failed|could not read from remote|Could not resolve host|ls-remote|"
                r"Connection (refused|reset|timed out)|tunnel|network", re.I), "git_fetch"),
    (re.compile(r"remote run .*(cannot be read|unreadable)|ci-runner|runner .*(overload|busy|lost|offline)|"
                r"remote check.*(timed? ?out|timeout|overload)", re.I), "tunnel"),
    (re.compile(r"stalled|no output and no CPU|timed out waiting for the landing lock|ended without a verdict", re.I),
     "laptop_load"),
]
LAND_REAL = re.compile(r"conflict|checks failed|pre-push checks failed|prepush-check refused|uncommitted|squash|"
                       r"PREPUSH_SKIP|red gate refused|no longer applies|superseded", re.I)


def land_failure_cause(verdict, tail=()):
    """('real' | 'infra' | 'unknown', probe kind or None) for a NOT LANDED verdict: its first line, and when that names
    nothing, its tail (audit #6: "the push failed (pre-push hook or remote)" hid a tunnel error in the tail)."""
    if LAND_REAL.search(verdict):
        return "real", None
    for text in (verdict, "\n".join(list(tail)[-40:])):
        for pat, probe in LAND_INFRA:
            if pat.search(text):
                return "infra", probe
        if text is not verdict and TRANSIENT_PUSH.search(text):
            return "infra", "git_fetch"
    return "unknown", "git_fetch"


def land_not_landed(verdict, worktree, tail=(), code=1):
    """A NOT LANDED to the inbox: infra (or an unknown cause, once) opens a condition that lands it again on recovery."""
    first = verdict.splitlines()[0]
    cause, probe = land_failure_cause(first, tail)
    attempt = 0
    if cause != "real" and worktree:  # counted per worktree and CHANGE (its patch-ids: a rebase keeps the count), on disk
        try:
            _c, change = orphan_key(movies_repo_path() if not os.path.isdir(worktree) else worktree, worktree) \
                if os.path.isdir(worktree) else ([], None)
        except (Exception, SystemExit):
            change = None
        counts = read_record(recovery_dir("relands.json")) or {}
        k = f"{os.path.realpath(worktree)}@{change}"
        attempt = counts[k] = int(counts.get(k) or 0) + 1
        write_json(recovery_dir("relands.json"), dict(list(counts.items())[-200:]))
    if cause != "real" and worktree and attempt <= LAND_RETRY_MAX[cause]:
        r = run_probe(probe, {"repo": movies_repo_path()} if probe == "git_fetch" else {})
        if r.ok:  # the infra check passes already (a blip): land again now, no condition to wait on
            done = recover_reland(None, {"worktree": worktree, "attempt": attempt})
            if done.startswith("landing"):
                line = f"RELANDING: {first} ({cause}; {r.detail}): landing again now (attempt {attempt})"
                return inbox_write("land", line, [line], list(tail)[-25:], code, cwd=worktree)
            first = f"{first} -- and it could not be landed again: {done}"  # said, final: never a silent drop
        c = open_condition("LAND_INFRA" if cause == "infra" else "LAND_UNKNOWN",
                           f"{first} ({cause}: lands again when {probe_words(probe, r.args)})", r,
                           [("reland", {"worktree": worktree, "attempt": attempt})],
                           key=re.sub(r"[^\w.-]+", "_", f"land-{os.path.basename(worktree)}"), command="land",
                           exit_code=code, cwd=worktree, tail=list(tail)[-25:])
        if c:
            return c
    return inbox_write("land", first, [first], list(tail)[-25:], code, cwd=worktree)


# THE ESCALATION THAT WAKES SOMEBODY (the owner, 2026-10-27: Main #2146's RED UNCLAIMED sat unread for 85+ min because
# the orchestrator's `inbox wait` was not re-armed). An unread RED UNCLAIMED, RED BUDGET or STALLED entry older than
# INBOX_ESCALATE_MIN (a gate fixer cap: at once) is escalated past the orchestrator: ONE macOS notification per entry
# (`osascript -e 'display notification ...'`, never a dialog), and the status line leads with a bold `ESCALATED: ...`
# until it is acked. Driven by the always-on processor (each minute) and by the status line's refresh.
ESCALATE_KINDS = ("INVARIANT", "RED_UNCLAIMED", "RED_BUDGET", "STALLED", "UNLANDED_ORPHAN", "RED_ESCALATE", "BLOCKED", "DIAGNOSED",
                  "FIXER_FAILED")  # 2026-10-28: an escalation nobody is told of is no escalation
INBOX_ESCALATE_MIN = 10  # $AGENTCTL_INBOX_ESCALATE_MIN
_last_escalate = [0.0]


def red_escalation_resolved(e):
    """A RED UNCLAIMED / BUDGET / ESCALATE entry whose red is now claimed, green or superseded: True -- through the
    registry's red_resolved probe, the check every such condition is opened with (an entry from before the registry, or
    one whose condition is gone, clears through the same check). Unknown (no run number, no snapshot): False."""
    if (e.get("kind") or inbox_kind(e.get("verdict"))) not in ("RED_UNCLAIMED", "RED_BUDGET", "RED_ESCALATE",
                                                                "FIXER_FAILED", "DIAGNOSED"):
        return False  # a fixer's failure or diagnosis is solved too once its red is held again, green or superseded
    m = re.search(r"#(\d+)", str(e.get("verdict") or ""))
    person = {"person": True} if (e.get("kind") or inbox_kind(e.get("verdict"))) == "RED_ESCALATE" else {}
    return bool(m) and run_probe("red_resolved", {"run": m.group(1), **person}).ok is True


def inbox_escalations(now_=None):
    """The unacked entries due for escalation. An escalated red that has since been claimed or gone green is
    acknowledged here (the status line's ESCALATED clears on its own: nobody has to ack a solved problem)."""
    t = now_ if now_ is not None else time.time()
    lim = env_num("AGENTCTL_INBOX_ESCALATE_MIN", INBOX_ESCALATE_MIN) * 60
    out = []
    by_entry = {}  # inbox id -> its OPEN condition: one escalation per condition, none for a closed one
    for c in open_conditions():
        for i in c.get("inbox") or []:
            by_entry[i] = c["key"]
    seen = set()
    for e in inbox_entries():
        kind = e.get("kind") or inbox_kind(e.get("verdict"))
        if e["read"] or not e.get("final", True) or kind not in ESCALATE_KINDS:
            continue
        if kind in CONDITION_KINDS and kind not in ("RED_UNCLAIMED", "RED_BUDGET", "RED_ESCALATE"):
            key = by_entry.get(e["id"])
            if key is None:  # its condition is closed (or it predates the registry): nothing left to act on
                os.makedirs(os.path.join(inbox_dir(), "acked"), exist_ok=True)
                open(os.path.join(inbox_dir(), "acked", e["id"]), "a").close()
                continue
            if key in seen:
                continue
            seen.add(key)
        try:
            if red_escalation_resolved(e):
                os.makedirs(os.path.join(inbox_dir(), "acked"), exist_ok=True)
                open(os.path.join(inbox_dir(), "acked", e["id"]), "a").close()
                continue
        except (Exception, SystemExit) as ex:  # never stops the escalation: the entry stays
            err(f"inbox: could not check {e['id']} ({str(ex)[:120]})")
        if t - float(e.get("at") or 0) >= lim or "gate fixer cap" in str(e.get("verdict") or ""):
            out.append(e)
    return out


def applescript_str(text):
    return '"' + str(text).replace("\\", "\\\\").replace('"', '\\"') + '"'


def notify(title, text):
    """A macOS notification (no dialog box); $AGENTCTL_NOTIFY: a command run with (title, text) instead (the tests')."""
    cmd = os.environ.get("AGENTCTL_NOTIFY")
    if cmd:
        subprocess.run([cmd, title, text], capture_output=True, timeout=10)
        return
    if sys.platform != "darwin":
        return
    subprocess.run(["osascript", "-e", f"display notification {applescript_str(text)} with title {applescript_str(title)} "
                    'sound name "Basso"'], capture_output=True, timeout=10)


def escalate_inbox(now_=None):
    """Notify each escalated entry once (a marker in inbox/escalated/); returns every escalated entry."""
    es = inbox_escalations(now_)
    d = os.path.join(inbox_dir(), "escalated")
    for e in es:
        m = os.path.join(d, e["id"])
        if os.path.exists(m):
            continue
        try:
            os.makedirs(d, exist_ok=True)
            open(m, "a").close()  # first: never notified twice, even if the notification hangs
            notify(f"agentctl: {e.get('kind')} unacked", str(e.get("verdict") or "")[:220])
        except (OSError, subprocess.SubprocessError) as ex:
            err(f"inbox: could not escalate {e['id']} ({ex})")
    return es


def escalation_line(es):
    if not es:
        return ""
    first = re.sub(r"\s+--\s+`.*$", "", str(es[-1].get("verdict") or ""))[:90]
    return f"ESCALATED: {len(es)} unacked ({first}{'; …' if len(es) > 1 else ''})"


def maybe_escalate_inbox():
    if time.time() - _last_escalate[0] < 60:
        return
    _last_escalate[0] = time.time()
    try:
        escalate_inbox()
    except Exception as e:  # never stops the loop
        err(f"inbox escalation: {e}")


def cmd_inbox(a):
    if a.ids[:1] == ["escalated"]:  # the status line's: notify what is due, print the bold line (nothing when none)
        line = escalation_line(escalate_inbox())
