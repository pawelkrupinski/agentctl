def patrol_repo(repo, dispatch=True, wait_recheck=True):
    """The processor's look at the reds: the gate (and the reds outside it), who fixes each, notes and dispatch. Reads the
    CI-state snapshot when it is fresh, else Forgejo. A stale local-checks red is rechecked (in the background in the
    processor, wait_recheck=False)."""
    o_r = slug(repo)
    if o_r not in GATING:
        return []
    snap = ci_state_load(o_r)
    pre = recheck_local(repo, wait=wait_recheck)
    if snap:
        rows = [(n, d, _gate_lists.get(n, []), True) for n, d, _nw, _s in gate_from_snap(snap)]
        others = [(n, r, _outside_lists.get(n, []), False) for n, r, _s, _c in outside_from_snap(snap)]
    else:
        rows = [(n, d, _gate_lists.get(n, []), True) for n, d, _nw, _s in gate_runs(o_r)]
        try:
            others = [(n, r, _outside_lists.get(n, []), False) for n, r, _s, _c in outside_gate(o_r)]
        except (Exception, SystemExit):
            others = []
    units = gate_red_units(o_r, rows, others) + local_units(repo)
    scan = scan_repo_for(o_r, repo)
    landed = scan_fix_commits(scan)[1] if scan else []
    acts = review_cleared(o_r, repo, units, landed)
    units += flake_units()
    infos = find_fixers(scan, units, o_r=o_r)
    gate_unread_spell(o_r, None)
    return pre + acts + red_patrol(o_r, repo, units, infos, dispatch=dispatch)


def maybe_patrol(repo):
    """At most every RED_PATROL_INTERVAL s, from the waiting processor's loop. Never fatal; no gate, no dispatch."""
    every = env_num("AGENTCTL_RED_PATROL", RED_PATROL_INTERVAL)
    if every <= 0 or time.time() - _last_patrol[0] < every:
        return
    _last_patrol[0] = time.time()

    def work():
        try:
            for line in patrol_repo(repo, dispatch=True, wait_recheck=False):
                err(f"red patrol: {line}")
        except (Exception, SystemExit) as e:
            why = str(e).replace("agentctl: ", "")[:200]
