def probe_red_resolved(a):
    """Red run a['run'] is claimed by someone, or its workflow decided on a later run (green, or superseded)."""
    n = str(a["run"]).lstrip("#")
    held = ("claimed", "blocked", "committed") if a.get("person") else ("claimed", "blocked", "committed", "diagnosed")
    snap = ci_state_load(SHORT["movies"])
    streak = {n}  # the red's current streak: a claim of an earlier run of it follows it (claim_follows)
    for u in ((snap or {}).get("gate") or []) + ((snap or {}).get("outside") or []):
        if a.get("workflow") and u.get("name") == a["workflow"]:
            streak |= set().union(*[set(map(str, run_names(r))) for r in streak_runs(u.get("runs") or [])] or [set()])
    for c in all_claims():  # person: an escalation clears for a claim by an agent or a person, not a dispatched fixer
        if c.get("state", "claimed") in held and not (a.get("person") and c.get("dispatched")) and not claim_stale(c) \
                and ({str(c.get("run")), str(c.get("run_id"))} | set(map(str, c.get("runs") or []))) & streak \
                and (str(c.get("run")) == n or n in set(map(str, c.get("runs") or [])) or c.get("workflow") == a.get("workflow")):
            return True, f"#{n} is claimed by {c.get('who')}"
    if a.get("workflow") == LOCAL_FLOW or n == "local":
        return (False, "main's local checks are red") if local_red().get("checks") else (True, "main's local checks pass")
    if not snap:
        return None, "no fresh CI-state snapshot"
    for u in (snap.get("gate") or []) + (snap.get("outside") or []):
        d = u.get("decided") or {}
        if str(d.get("number")) == n:
            return d.get("conclusion") not in RED_CONCLUSIONS, f"#{n} is {d.get('conclusion')}"
        if a.get("workflow") and u.get("name") == a["workflow"]:
            if n.isdigit() and int(d.get("number") or 0) < int(n):
                return None, f"the snapshot predates #{n}"
            return True, f"{a['workflow']} decided on #{d.get('number')} since"
    if float(snap.get("at") or 0) < float(a.get("since") or 0):
        return None, "the snapshot predates the condition"
    return True, f"#{n} is no longer the red its workflow decided on (green, or superseded)"


