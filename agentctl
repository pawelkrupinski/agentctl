def group_cpu_seconds(pgid):
    """The CPU seconds every live process of process group `pgid` has used (ps's cumulative TIME), or 0."""
    r = subprocess.run(["ps", "-A", "-o", "pgid=,time="], capture_output=True, text=True)
    total = 0.0
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) != 2 or parts[0] != str(pgid):
            continue
        secs = 0.0
        for field in re.split(r"[:-]", parts[1]):
            try:
                secs = secs * 60 + float(field)
            except ValueError:
                pass
        total += secs
    return total


STALL_CPU_SECONDS = 1.0  # CPU that counts as progress per window: a watchdog's polls are not work


def stall_clock():
    """The stall judge's clock (tests drive it, with group_cpu_seconds, so no verdict depends on the machine's load)."""
    return time.monotonic()


WATCHED_GROUPS = set()  # process groups run_watched started and that may still run: the watchdog ends them first


def run_watched(argv, cwd, env, log_path, step, stall=None, sampler=None, cpu=None, clock=None, wall=None):
    """Run argv (its own process group, stdin closed), its output into a file beside log_path. (returncode, output);
    returncode None when it STALLED: no output and no CPU in its process group for `stall` seconds, after which the
    group is ended. Waits with Popen.wait, never time.sleep. `cpu` (pgid -> CPU seconds) and `clock` are the samples the
    verdict reads: group_cpu_seconds and stall_clock unless given."""
    cpu_of, clock = cpu or group_cpu_seconds, clock or stall_clock
    stall = stall if stall is not None else float(os.environ.get("AGENTCTL_LAND_STALL_MIN", LAND_STALL_MIN)) * 60
    out_path = f"{log_path}.{re.sub(r'[^A-Za-z0-9_-]', '_', step)}.out"
    with open(out_path, "w") as out:
        p = subprocess.Popen(argv, cwd=cwd, env=env, stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                             start_new_session=True)
    WATCHED_GROUPS.add(p.pid)
    size, cpu, changed, stalled = -1, None, clock(), False
    poll = max(0.2, min(15.0, stall / 4))
    need = float(os.environ.get("AGENTCTL_STALL_CPU_SECONDS", STALL_CPU_SECONDS))
    t_start = time.monotonic()
    while True:
        try:
            p.wait(timeout=poll)
            break
        except subprocess.TimeoutExpired:
            pass
        if sampler:
            sampler()
        now_size, now_cpu = os.path.getsize(out_path), cpu_of(p.pid)
        try:  # the landing lease's holder renews on real progress only (output bytes, whole CPU seconds)
            lock_beat(f"{step}:{now_size}:{int(now_cpu or 0)}")
        except LeaseLost as ex:
            err(f"{ex}: ending {step}")
            stalled = True
        # progress: output grew, or the group used a real second of CPU since the last progress (the hook idle in
        # `wait` with only its watchdog polling used ~0.08 s in 50 min, 2026-10-27: that is not progress)
        now_c = clock()
        if now_size != size or cpu is None or now_cpu - cpu >= need:
            size, cpu, changed = now_size, now_cpu, now_c
        elif now_c - changed > stall:
            stalled = True
        if wall is not None and time.monotonic() - t_start > wall:  # busy or not: the wall bound (a push's)
            stalled = True
        if stalled:
            for sig, grace in ((signal.SIGTERM, 10), (signal.SIGKILL, 5)):
                try:
                    os.killpg(p.pid, sig)
                except ProcessLookupError:
                    break
                try:
                    p.wait(timeout=grace)
                    break
                except subprocess.TimeoutExpired:
                    continue
            break
    WATCHED_GROUPS.discard(p.pid)
    with open(out_path, errors="replace") as f:
        output = f.read()
    try:
        os.unlink(out_path)
    except OSError:
        pass
    return (None if stalled else p.returncode), output


# ---------------------------------------------------------------- the governor: ONE admission control for memory and CPU
# The owner (2026-10-27): "one governor for laptop memory and CPU". Three limiters guarded the 36 GB / 14-core Mac each on
# its own -- movies' scripts/jvm-gate.sh (4 JVM slots), the check slots' cap (below) and sbt-warm's kept servers (each
# holding a JVM slot, idle or not) -- so an idle warm server held the slot a red fix's check waited for, and none knew
# what the others had admitted. Now one governor admits every heavy unit of work:
#
# - A TICKET is an flock on <gov>/t-<id>.lock (freed by the kernel when its holder ends, however it ends) with its record
#   beside it, t-<id>.json: class, expected GB, label, pid, cwd, since. agentctl's own checks hold one in-process; movies'
#   scripts/jvm-gate.sh opens descriptor 7 on a ticket file and runs `agentctl gov admit --fd 7`, which locks that shared
#   open file: the shell, and the JVM or the kept server's keeper it hands descriptor 7 to, hold the ticket.
# - CLASSES, in priority order: red (a change carrying Fixes-Red for a red run; a red fixer's worktree), check (a
#   pre-commit check), agent (an agent's own sbt), measure (identity-measure*). Waiters queue in that order, first come
#   first served within a class, and only the head of the queue is admitted: a lower class never overtakes a higher one.
# - MEMORY: the expected GB must fit under the BUDGET (the sum of the live tickets' expected GB; $AGENTCTL_GOV_BUDGET_GB,
#   default 60% of RAM), and what it needs NOW ($AGENTCTL_GOV_FREE_NEED_GB, 2.5, or less) must fit into FREE memory
#   (free + inactive + speculative pages) less a reserve ($AGENTCTL_GOV_RESERVE_GB, 1) less what the tickets admitted in
#   the last 2 min will still grow into (a JVM takes its heap over its first minutes); and memory pressure (100 -
#   memory_pressure's free %) must be under 75% (90% for red).
# - CPU: checks wait while the 1-min load is over 4x the cores (a load of ~250 kept an sbt server from starting in 5 min
#   and failed two checks, 2026-10-27), agent work over 1.5x, measurements over 1x; red never.
# - EVICTION: when the head waiter does not fit on memory, the governor stops the idle kept sbt server unused longest
#   (sbt-warm's registry: no call running in it -- its busy lock taken exclusively for the stop, so none starts under it --
#   unused for a minute, not serving, never the root checkout's), then looks again. Idle warm servers go first.
# - CHECKS keep their cap (`checks`, below): measured and auto-tuned as before, now one of the governor's limits.
# Every admission is a line of <gov>/admits.jsonl (class, GB, wait, what it waited on); every eviction a line of gov.log.
GOV_CLASSES = {"red": 0, "check": 1, "agent": 2, "measure": 3}
GOV_MEM_GB = {"red": 5.0, "check": 5.0, "agent": 5.0, "measure": 6.0, "hook": 1.0}
GOV_RAMP = 120          # seconds a new ticket's JVM is still growing into its expected memory
GOV_RESERVE_GB = 1.0
GOV_FREE_NEED_GB = 2.5  # free memory a new JVM needs NOW (beyond the reserve); its heap grows into the budget's share later
GOV_PRESSURE_STOP = {"red": 90}  # memory pressure (%) at which a class waits; others: GOV_PRESSURE_DEFAULT
GOV_PRESSURE_DEFAULT = 75
GOV_LOAD = {"check": 4.0, "agent": 1.5, "measure": 1.0}  # waits while load1 > factor x cores; red never waits on CPU
GOV_EVICT_IDLE = 60     # a kept server unused this long (seconds) may be evicted
GOV_POLL = 2.0
GOV_REPORT = 600


def gov_dir():
    d = os.environ.get("AGENTCTL_GOV_DIR") or state_root("gov")
    os.makedirs(d, exist_ok=True)
    return d


def gov_log(msg):
    with open(os.path.join(gov_dir(), "gov.log"), "a") as f:
        f.write(f"{ts()} {msg}\n")


def ram_gb():
    try:
        r = subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True, text=True, timeout=10)
        return int(r.stdout.strip()) / 2 ** 30
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return 36.0


def gov_budget():
    return env_num("AGENTCTL_GOV_BUDGET_GB", round(0.6 * ram_gb(), 1))


def free_gb():
    """GB of RAM a new heap can have now (free + inactive + speculative pages); $AGENTCTL_GOV_FREE_PROBE's output when
    set (the tests' seam); None when unreadable."""
    probe = os.environ.get("AGENTCTL_GOV_FREE_PROBE")
    if probe:
        try:
            return float(subprocess.run(probe, shell=True, capture_output=True, text=True).stdout.strip())
        except ValueError:
            return None
    try:
        out = subprocess.run(["vm_stat"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    page = re.search(r"page size of (\d+) bytes", out)
    pages = sum(int(m.group(2)) for m in re.finditer(r"Pages (free|inactive|speculative):\s+(\d+)", out))
    return pages * int(page.group(1)) / 2 ** 30 if page else None


def gov_machine():
    """{free, pressure, load1, cores}: live memory and CPU ($AGENTCTL_GOV_PRESSURE_PROBE / _LOAD_PROBE: the tests')."""
    load1, _cpu, pressure, _swap = machine_sample()
    if os.environ.get("AGENTCTL_GOV_PRESSURE_PROBE"):
        pressure = float(subprocess.run(os.environ["AGENTCTL_GOV_PRESSURE_PROBE"], shell=True, capture_output=True,
                                        text=True).stdout.strip() or 0)
    if os.environ.get("AGENTCTL_GOV_LOAD_PROBE"):
        load1 = float(subprocess.run(os.environ["AGENTCTL_GOV_LOAD_PROBE"], shell=True, capture_output=True,
                                     text=True).stdout.strip() or 0)
    return {"free": free_gb(), "pressure": pressure, "load1": load1, "cores": os.cpu_count() or 1}


def gov_tickets():
    """The live tickets' records (their lock held), oldest first; a dead ticket's files are removed."""
    out = []
    for p in sorted(glob.glob(os.path.join(gov_dir(), "t-*.json"))):
        lock = p[:-5] + ".lock"
        if not lock_held(lock):
            try:
                if time.time() - os.path.getmtime(p) > 30:  # never one being written
                    os.unlink(p)
                    os.unlink(lock)
            except OSError:
                pass
            continue
        rec = read_record(p)
        if rec:
            rec["path"] = lock
            out.append(rec)
    return sorted(out, key=lambda r: r.get("at", 0))


def gov_committed(tickets):
    return sum(float(t.get("mem") or 0) for t in tickets)


def gov_ramp(tickets, now=None):
    now = now or time.time()
    return sum(float(t.get("mem") or 0) for t in tickets if now - t.get("at", 0) < GOV_RAMP)


def gov_fits(cls, mem, tickets, m, kind="job"):
    """(True, None) when work of class cls expecting `mem` GB may start now; else (False, why, on_memory)."""
    if kind == "check" and cls != "red":
        checks = sum(1 for t in tickets if t.get("kind") == "check")
        if checks >= checks_cap():
            return False, f"{checks}/{checks_cap()} checks running (the check cap)", False
    budget = gov_budget()
    committed = gov_committed(tickets)
    if committed + mem > budget:
        return False, f"{committed:.0f}+{mem:.0f} GB over the {budget:.0f} GB budget", True
    if m.get("free") is not None:
        room = m["free"] - env_num("AGENTCTL_GOV_RESERVE_GB", GOV_RESERVE_GB) - gov_ramp(tickets)
        need = min(mem, env_num("AGENTCTL_GOV_FREE_NEED_GB", GOV_FREE_NEED_GB))
        if need > room:
            return False, (f"{m['free']:.1f} GB free, {gov_ramp(tickets):.0f} GB still growing: {max(room, 0):.1f} GB "
                           f"for the {need:g} GB it needs now"), True
    stop = GOV_PRESSURE_STOP.get(cls, GOV_PRESSURE_DEFAULT)
    if m.get("pressure") is not None and m["pressure"] >= stop:
        return False, f"memory pressure {m['pressure']:.0f}% (waits at {stop}%)", True
    factor = GOV_LOAD.get(cls)
    if factor and m.get("load1") is not None and m["load1"] > factor * m["cores"]:
        return False, f"load {m['load1']:.0f} over {factor:g}x {m['cores']} cores", False
    return True, None, False


def gov_waiters():
    """The live waiters, in admission order: (class priority, arrival)."""
    out = []
    for p in glob.glob(os.path.join(gov_dir(), "w-*.json")):
        rec = read_record(p)
        if not rec or not pid_alive(int(rec.get("pid", 0))):
            try:
                os.unlink(p)
            except OSError:
                pass
            continue
        rec["path"] = p
        out.append(rec)
    return sorted(out, key=lambda r: (GOV_CLASSES.get(r.get("class"), 9), r.get("at", 0)))


def sbt_warm_state():
    return os.environ.get("KINOWO_SBT_WARM_STATE") or os.path.join(HOME, ".cache", "kinowo-sbt-warm")


def idle_servers(min_idle=None):
    """The kept sbt servers the governor may evict, unused longest first: [(idle seconds, root, key prefix)]. Never the
    root checkout's (the owner's own), a serving one, or one a call is running in (its busy lock held)."""
    min_idle = GOV_EVICT_IDLE if min_idle is None else min_idle
    out = []
    for f in glob.glob(os.path.join(sbt_warm_state(), "*.root")):
        prefix = f[:-5]
        try:
            with open(f) as rf, open(prefix + ".pid") as pf:
                root, pid = rf.read().strip(), int(pf.read().strip())
        except (OSError, ValueError):
            continue
        if not os.path.isdir(root) or os.path.isdir(os.path.join(root, ".git")) or not pid_alive(pid):
            continue
        if os.path.exists(prefix + ".serving") or lock_held(prefix + ".busy"):
            continue
        try:
            idle = time.time() - os.path.getmtime(prefix + ".used")
        except OSError:
            continue
        if idle >= min_idle:
            out.append((idle, root, prefix))
    return sorted(out, reverse=True)


def gov_evict(why):
    """Stop the idle kept server unused longest (holding its busy lock, so no call starts under the stop). The evicted
    checkout, or None."""
    for idle, root, prefix in idle_servers():
        f = open(prefix + ".busy", "a+")
        try:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                continue  # a call started meanwhile
            script = os.path.join(root, "scripts", "sbt-warm")
            if not os.access(script, os.X_OK):
                continue
            try:
                subprocess.run([script, "--stop", "--root"], cwd=root, capture_output=True, text=True, timeout=180)
            except subprocess.TimeoutExpired:
                gov_log(f"evict {root}: sbt-warm --stop took over 3 min")
            gov_log(f"evicted the idle sbt server of {root} (unused {int(idle // 60)} min) for: {why}")
            return root
        finally:
            f.close()
    return None


class GovTicket:
    def __init__(self, path, rec, f=None):
        self.path, self.rec, self.f = path, rec, f
        self.waited, self.why = rec.get("waited", 0.0), rec.get("waited_on")

    def release(self):
        for p in (self.path[:-5] + ".json", self.path):
            try:
                os.unlink(p)
            except OSError:
                pass
        if self.f:
            self.f.close()
            self.f = None


class GovTimeout(RuntimeError):
    """The governor did not admit the work within its bound (audit #12: an unbounded wait hid a stuck queue entry)."""


GOV_ADMIT_MAX = 2 * 3600  # a check waits this long for the governor at most ($AGENTCTL_GOV_ADMIT_MAX)


def gov_admit(cls, mem=None, label="", kind="job", fd=None, ticket=None, wait=True, force=False, pid=None, cwd=None,
              report=None, max_wait=None):
    """Admit one unit of work: a GovTicket once it may start (None for a --try that may not). With `fd`, the lock is
    taken on that inherited descriptor (a shell's, which then holds the ticket); else on a file this process keeps open."""
    cls = cls if cls in GOV_CLASSES else "agent"
    mem = GOV_MEM_GB.get(cls, 5.0) if mem is None else float(mem)
    d = gov_dir()
    t0 = time.time()
    me = os.path.join(d, f"w-{t0:.6f}-{os.getpid()}.json")
    write_json(me, {"class": cls, "mem": mem, "label": label, "kind": kind, "pid": os.getpid(), "at": t0})
    said, report_at, why = False, 0.0, None
    report = report or err
    try:
        while True:
            tickets = gov_tickets()
            waiters = gov_waiters()
            head = waiters and os.path.abspath(waiters[0]["path"]) == os.path.abspath(me)
            if force:
                ok, why, on_mem = True, None, False
            elif not head:
                w = waiters[0] if waiters else {}
                ok, on_mem = False, False
                why = f"behind {w.get('class')} work ({w.get('label') or '?'}, pid {w.get('pid')})"
            else:
                ok, why, on_mem = gov_fits(cls, mem, tickets, gov_machine(), kind)
            if ok:
                break
            if head and on_mem and cls != "measure" and gov_evict(f"{cls} {label} ({why})"):
                time.sleep(env_num("AGENTCTL_GOV_EVICT_SETTLE", 3))  # the freed memory shows in vm_stat
                continue
            if not wait:
                return None
            if max_wait is not None and time.time() - t0 > max_wait:
                raise GovTimeout(f"the governor did not admit {cls} work ({label}) in {int(max_wait // 60)} min: {why}")
            try:  # a check waiting its turn holds its leases (bounded by max_wait and their max hold), never loses them
                lock_beat(f"gov-wait:{label}:{int(time.time() // 60)}")
            except LeaseLost as ex:
                raise GovTimeout(f"{ex} while waiting for the governor") from None
            if time.monotonic() >= report_at:
                report(f"{'still ' if said else ''}waiting for the governor ({cls}, {mem:g} GB, {label}): {why}; "
                       f"{len(tickets)} admitted, {gov_committed(tickets):.0f}/{gov_budget():.0f} GB")
                said, report_at = True, time.monotonic() + GOV_REPORT
            time.sleep(env_num("AGENTCTL_GOV_POLL", GOV_POLL))
    finally:
        try:
            os.unlink(me)
        except OSError:
            pass
    path = ticket or os.path.join(d, f"t-{t0:.6f}-{os.getpid()}.lock")
    f = None
    if fd is not None:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    else:
        f = open(path, "a+")
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    waited = round(time.time() - t0, 1)
    rec = {"class": cls, "mem": mem, "label": label, "kind": kind, "pid": pid or os.getpid(), "cwd": cwd or os.getcwd(),
           "at": time.time(), "since": ts(), "waited": waited, "waited_on": why if waited >= 1 else None}
    write_json(path[:-5] + ".json", rec)
    with open(os.path.join(d, "admits.jsonl"), "a") as af:
        af.write(json.dumps({k: rec[k] for k in ("class", "mem", "label", "kind", "at", "waited", "waited_on")}) + "\n")
    if said:
        report(f"admitted by the governor after {int(waited)} s ({cls}, {mem:g} GB, {label})")
    return GovTicket(path, rec, f)


@contextlib.contextmanager
def gov_ticket(cls, mem=None, label="", kind="job", report=None):
    t = gov_admit(cls, mem, label, kind=kind, report=report)
    try:
        yield t
    finally:
        t.release()


def gov_pressure():
    """Why the laptop is under pressure now (memory pressure, free memory or load past the governor's limits for a
    check), or None: `land` runs a change's checks on ci-runner while it says so."""
    m = gov_machine()
    if m.get("pressure") is not None and m["pressure"] >= env_num("AGENTCTL_REMOTE_PRESSURE", GOV_PRESSURE_DEFAULT):
        return f"memory pressure {m['pressure']:.0f}%"
    if m.get("free") is not None and m["free"] < env_num("AGENTCTL_GOV_RESERVE_GB", GOV_RESERVE_GB) + GOV_MEM_GB["check"] \
            and not idle_servers():
        return f"{m['free']:.1f} GB free and no idle sbt server to evict"
    if m.get("load1") is not None and m["load1"] > env_num("AGENTCTL_REMOTE_LOAD", 2.0) * m["cores"]:
        return f"load {m['load1']:.0f} on {m['cores']} cores"
    return None


def gov_class_of(repo, commits, reds):
    """red when a commit carries Fixes-Red for a red run, else check."""
    return "red" if reds and (fixes_of(repo, commits) & reds) else "check"


def cmd_gov(a):
    if a.gcmd == "admit":
        t = gov_admit(a.cls, a.mem, a.label or "", kind=a.kind, fd=a.fd, ticket=a.ticket, wait=not a.try_,
                      force=a.force, pid=a.pid, cwd=a.cwd)
        return 0 if t else 1
    if a.gcmd == "evict":
        if a.dry_run:
            for idle, root, _p in idle_servers():
                print(f"would evict {root} (unused {int(idle // 60)} min)")
            return 0
        root = gov_evict("by hand (agentctl gov evict)")
        print(f"evicted {root}" if root else "no idle sbt server to evict")
        return 0
    if a.gcmd == "status":
        tickets, m = gov_tickets(), gov_machine()
        print(f"governor: {len(tickets)} admitted, {gov_committed(tickets):.1f}/{gov_budget():.0f} GB committed, "
              f"{gov_ramp(tickets):.0f} GB still growing; free {m['free'] if m['free'] is None else round(m['free'], 1)} "
              f"GB, pressure {m['pressure']}%, load {m['load1']:.1f}/{m['cores']} cores; check cap {checks_cap()}")
        for t in tickets:
            print(f"  {t.get('class'):<7} {t.get('mem'):>4} GB  {t.get('kind'):<5} {t.get('label')}  pid {t.get('pid')}  "
                  f"since {t.get('since')}  {t.get('cwd')}")
        for w in gov_waiters():
            print(f"  WAITING {w.get('class'):<7} {w.get('mem'):>4} GB  {w.get('label')}  pid {w.get('pid')}")
        idle = idle_servers()
        if idle:
            print("evictable: " + ", ".join(f"{os.path.basename(r)} ({int(i // 60)} min)" for i, r, _p in idle))
        why = gov_pressure()
        print(f"pressure: {why} (land checks on ci-runner)" if why else "pressure: none (land checks locally)")
        return 0
    if a.gcmd == "stats":
        rc = cmd_checks(argparse.Namespace(ccmd="stats", days=a.days))
        cutoff = time.time() - a.days * 86400
        rows = []
        try:
            with open(os.path.join(gov_dir(), "admits.jsonl")) as f:
                for line in f:
                    try:
                        r = json.loads(line)
                    except ValueError:
                        continue
                    if r.get("at", 0) >= cutoff:
                        rows.append(r)
        except OSError:
            pass
        print(f"{'class':>7} {'admits':>6} {'p50 wait':>9} {'p90 wait':>9} {'waited>1m':>9}")
        for cls in GOV_CLASSES:
            rs = [r for r in rows if r.get("class") == cls]
            if rs:
                w = [r.get("waited", 0) for r in rs]
                print(f"{cls:>7} {len(rs):>6} {pct(w, .5):>8.0f}s {pct(w, .9):>8.0f}s {sum(1 for x in w if x > 60):>9}")
        try:
            ev = sum(1 for l in open(os.path.join(gov_dir(), "gov.log")) if " evicted " in l)
        except OSError:
            ev = 0
        print(f"evictions (all time): {ev}")
        return rc
    return 2


# ---------------------------------------------------------------- check slots
# The owner (2026-10-27): "just limit the precommit checks to a reasonable number", and "keep measuring to adjust that
# number". Every pre-commit check run (land's dry run, the `waiting` batch check, the known-red baseline) is admitted by
# THE GOVERNOR (above) as a check-kind ticket of class `check` (`red` for a change fixing a red run, which skips the
# cap): at most N run at once. Its ticket counts a JVM's 5 GB: the hook's `sbt -batch` takes no ticket of its own; an
# sbt server it starts through sbt-warm does (at the check's priority, KINOWO_GOV_CLASS), counted twice for a while.
# N: $AGENTCTL_MAX_CHECKS if set, else the automatic cap (checks/cap.json, default 3, at most the budget's worth of sbt
# servers). A waiter prints why it waits. Each run appends to checks/runs.jsonl: its duration, its wait, the cap and the
# number of checks running, the load average, CPU % and memory pressure / swap sampled during it. After each run the cap
# is adjusted from the data (adjust_cap), at most once a day, each change logged and sent to the inbox.
CHECKS_DEFAULT_CAP = 3


def checks_dir():
    d = os.environ.get("AGENTCTL_CHECKS_DIR") or state_root("checks")
    os.makedirs(d, exist_ok=True)
    return d


def gov_max_checks():
    """The most checks the budget holds: one sbt server's worth of memory each."""
    return max(1, int(gov_budget() // GOV_MEM_GB["check"]))


def cap_state():
    try:
        with open(os.path.join(checks_dir(), "cap.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"cap": CHECKS_DEFAULT_CAP}


def checks_cap():
    if os.environ.get("AGENTCTL_MAX_CHECKS"):
        return max(1, int(os.environ["AGENTCTL_MAX_CHECKS"]))
    return max(1, min(gov_max_checks(), int(cap_state().get("cap", CHECKS_DEFAULT_CAP))))


def machine_sample():
    """(load1, cpu %, memory pressure %, swap used MB) of this machine, cheaply; None where unreadable."""
    load1 = os.getloadavg()[0]
    cpu = min(100.0, 100.0 * load1 / (os.cpu_count() or 1))
    pressure = swap = None
    try:
        r = subprocess.run(["memory_pressure", "-Q"], capture_output=True, text=True, timeout=10)
        m = re.search(r"free percentage:\s*(\d+)", r.stdout)
        pressure = 100 - int(m.group(1)) if m else None
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        r = subprocess.run(["sysctl", "-n", "vm.swapusage"], capture_output=True, text=True, timeout=10)
        m = re.search(r"used = ([\d.]+)M", r.stdout)
        swap = float(m.group(1)) if m else None
    except (OSError, subprocess.TimeoutExpired):
        pass
    return load1, cpu, pressure, swap


class Slot:
    def __init__(self, label, cls="check"):
        self.label, self.cls, self.ticket, self.waited, self.t0 = label, cls, None, 0.0, None
        self.samples, self.running, self.cap, self._last_sample = [], 0, 0, 0.0

    def sample(self, force=False):
        if force or time.monotonic() - self._last_sample >= 30:
            self._last_sample = time.monotonic()
            try:
                self.samples.append(machine_sample())
            except Exception:
                pass

    def done(self, rc, out):
        self.rc, self.out = rc, out

    def env(self, env):
        """The hook's environment: its sbt JVM is admitted at this check's priority."""
        return dict(env, KINOWO_GOV_CLASS=self.cls)


def slot_holders(cap=None):
    return [f"pid {t.get('pid')} {t.get('label')} since {t.get('since')} ({t.get('class')})"
            for t in gov_tickets() if t.get("kind") == "check"]


@contextlib.contextmanager
def check_slot(repo, label, cls="check"):
    """Hold a check ticket of the governor for a pre-commit check run (waiting, with a line saying why, until it is
    admitted). Records the run in runs.jsonl and adjusts the cap afterwards."""
    slot = Slot(label, cls)
    slot.ticket = gov_admit(cls, GOV_MEM_GB["check"], label, kind="check",
                            max_wait=env_num("AGENTCTL_GOV_ADMIT_MAX", GOV_ADMIT_MAX))
    slot.waited, slot.cap = slot.ticket.waited, checks_cap()
    slot.running = len(slot_holders())
    slot.t0, slot.rc = time.monotonic(), None
    slot.sample(force=True)
    try:
        yield slot
    finally:
        slot.sample(force=True)
        record_check(slot, time.monotonic() - slot.t0)
        slot.ticket.release()
        try:
            maybe_adjust_cap()
        except Exception as e:
            err(f"could not adjust the check cap: {e}")


def record_check(slot, duration):
    def mx(i):
        vals = [x[i] for x in slot.samples if x and x[i] is not None]
        return max(vals) if vals else None
    rec = {"at": time.time(), "label": slot.label, "duration": round(duration, 1), "waited": round(slot.waited, 1),
           "cap": slot.cap, "running": slot.running, "rc": slot.rc, "load1": mx(0), "cpu": mx(1), "pressure": mx(2),
           "swap_mb": mx(3), "swap_mb_start": slot.samples[0][3] if slot.samples and slot.samples[0] else None}
    with open(os.path.join(checks_dir(), "runs.jsonl"), "a") as f:
        f.write(json.dumps(rec) + "\n")


def check_runs(days=7, now=None):
    now = now or time.time()
    out = []
    try:
        with open(os.path.join(checks_dir(), "runs.jsonl")) as f:
            for line in f:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if r.get("at", 0) >= now - days * 86400:
                    out.append(r)
    except OSError:
        pass
    return out


def pct(vals, q):
    vals = sorted(vals)
    if not vals:
        return None
    return vals[min(len(vals) - 1, int(round(q * (len(vals) - 1))))]


SLOT_WAIT_COMMON = 0.3        # share of the day's runs that waited over a minute for a slot
PRESSURE_LOW, PRESSURE_HIGH = 50, 75
SWAP_GROWTH_HIGH_MB = 512


def adjust_cap(runs, cap, max_cap, last_change, now):
    """(new cap, reason) from the last day's check runs, or (cap, None). At most one change a day. Lower by 1 (to 1)
    when memory pressure or swap rises, or when p90 duration at the current level is over 1.5x the p90 at the level
    below; raise by 1 (to max_cap) when slot waits are common and memory pressure and swap stay low."""
    if now - (last_change or 0) < 86400:
        return cap, None
    day = [r for r in runs if r.get("at", 0) >= now - 86400]
    if not day:
        return cap, None
    pressures = [r["pressure"] for r in day if r.get("pressure") is not None]
    growth = [(r["swap_mb"] or 0) - (r.get("swap_mb_start") or 0) for r in day if r.get("swap_mb") is not None]
    if (pressures and max(pressures) >= PRESSURE_HIGH) or (growth and max(growth) >= SWAP_GROWTH_HIGH_MB):
        if cap > 1:
            return cap - 1, (f"memory pressure up to {max(pressures) if pressures else '?'}% or swap growing up to "
                             f"{int(max(growth)) if growth else 0} MB during a check")
        return cap, None
    at = [r["duration"] for r in runs if r.get("running") == cap]
    below = [r["duration"] for r in runs if r.get("running") == cap - 1]
    if cap > 1 and len(at) >= 5 and len(below) >= 5 and pct(at, 0.9) > 1.5 * pct(below, 0.9):
        return cap - 1, f"p90 check duration with {cap} running is {pct(at, 0.9):.0f}s, over 1.5x the {pct(below, 0.9):.0f}s with {cap - 1}"
    waited = [r for r in day if r.get("waited", 0) > 60]
    if (cap < max_cap and len(day) >= 5 and len(waited) / len(day) >= SLOT_WAIT_COMMON
            and (not pressures or max(pressures) < PRESSURE_LOW) and (not growth or max(growth) < 64)):
        return cap + 1, (f"{len(waited)} of {len(day)} checks today waited over a minute for a slot, memory pressure "
                         f"under {PRESSURE_LOW}% and swap steady")
    return cap, None


def maybe_adjust_cap(now=None):
    if os.environ.get("AGENTCTL_MAX_CHECKS"):
        return None
    now = now or time.time()
    st = cap_state()
    cap = int(st.get("cap", CHECKS_DEFAULT_CAP))
    new, why = adjust_cap(check_runs(7, now), cap, gov_max_checks(), st.get("changed_at"), now)
    if why is None or new == cap:
        return None
    st = {"cap": new, "changed_at": now, "reason": why, "previous": cap}
    with open(os.path.join(checks_dir(), "cap.json.tmp"), "w") as f:
        json.dump(st, f)
    os.replace(os.path.join(checks_dir(), "cap.json.tmp"), os.path.join(checks_dir(), "cap.json"))
    line = f"CHECK CAP {cap} -> {new}: {why}"
    with open(os.path.join(checks_dir(), "adjust.log"), "a") as f:
        f.write(f"{ts()} {line}\n")
    inbox_write("checks", line, [line], [], 0)
    return line


def cmd_checks(a):
    if a.ccmd == "stats":
        runs = check_runs(a.days)
        cap = checks_cap()
        st = cap_state()
        print(f"check slots: cap {cap}" + (" ($AGENTCTL_MAX_CHECKS)" if os.environ.get("AGENTCTL_MAX_CHECKS") else
                                          f" (auto; last change: {st.get('reason', 'none')})")
              + f"; running now: {len(slot_holders(cap))}; {len(runs)} check run(s) in {a.days} d")
        print(f"{'running':>7} {'runs':>5} {'p50 dur':>8} {'p90 dur':>8} {'p50 wait':>9} {'p90 wait':>9} {'max mem%':>8} {'max swap':>8}")
        for level in sorted({r.get("running", 0) for r in runs}):
            rs = [r for r in runs if r.get("running", 0) == level]
            dur, wait = [r["duration"] for r in rs], [r["waited"] for r in rs]
            mem = [r["pressure"] for r in rs if r.get("pressure") is not None]
            swp = [r["swap_mb"] for r in rs if r.get("swap_mb") is not None]
            print(f"{level:>7} {len(rs):>5} {pct(dur, .5):>7.0f}s {pct(dur, .9):>7.0f}s {pct(wait, .5):>8.0f}s "
                  f"{pct(wait, .9):>8.0f}s {max(mem) if mem else '-':>8} {int(max(swp)) if swp else '-':>8}")
        return 0
    if a.ccmd == "status":
        cap = checks_cap()
        holders = slot_holders(cap)
        print(f"checks: {len(holders)}/{cap} running (the governor's check cap; `agentctl gov status` for the rest)"
              + "".join(f"\n  {h}" for h in holders))
        return 0
    return 2


def stalled(step, output, log_path):
    mins = float(os.environ.get("AGENTCTL_LAND_STALL_MIN", LAND_STALL_MIN))
    print(f"NOT LANDED: stalled {step}: no output and no CPU for {mins:g} min, so it was ended (the landing lock is free "
          f"again). Last lines (full log {log_path}):\n  {tail_of(output)}")
    return 1


def tool_env():
    """os.environ with sdkman's sbt and java first on PATH (the movies hook's sbt check needs them)."""
    env = dict(os.environ)
    path = env.get("PATH", "").split(":")
    env["PATH"] = ":".join([b for b in SDKMAN_BINS if os.path.isdir(b) and b not in path] + path)
    java_home = f"{HOME}/.sdkman/candidates/java/current"
    if not env.get("JAVA_HOME") and os.path.isdir(java_home):
        env["JAVA_HOME"] = java_home
    # the movies hook's known-red baseline: `<dir>/<main sha>`, written by baseline_failures (a hook without the mode
    # ignores it)
    env.setdefault("PREPUSH_BASELINE_DIR", reds_dir("baseline-out"))
    return env


# EVERY PUSH IS BOUNDED (the owner, 2026-10-28, "fix root cause in a structural way": a queued change's `git push` over
# the ssh tunnel died with "Connection to localhost closed by remote host" when the hotspot dropped, then hung -- no
# progress, no exit -- holding the landing lock 30+ min while a checked batch waited behind it with the gate green): a
# push gets a no-progress bound (no output and no CPU) of PUSH_STALL_SECS and a wall bound of PUSH_WALL_MIN, its group
# killed on either; a stalled or dead-transport push is infra (re-queued), never a hang.
PUSH_STALL_SECS = 180
PUSH_WALL_MIN = 45


def push_bounds():
    return {"stall": env_num("AGENTCTL_PUSH_STALL_SECS", PUSH_STALL_SECS),
            "wall": env_num("AGENTCTL_PUSH_WALL_MIN", PUSH_WALL_MIN) * 60}


def push_argv(remote, src, dst="main"):
    argv = ["git", "push", remote, f"{src}:refs/heads/{dst}"]
    assert not any(a in ("--no-verify", "-n", "--force", "-f") or a.startswith("--force") for a in argv)
    return argv


class Stash:
    """A NAMED stash (git's stash list is shared by every worktree of a clone): found again by its own sha, never by
    position, and restored exactly once."""

    def __init__(self, repo):
        self.repo, self.name, self.sha = repo, f"agentctl-land-{os.getpid()}-{int(time.time())}", None

    def save(self):
        git(self.repo, "stash", "push", "--include-untracked", "-m", self.name)
        for line in git(self.repo, "stash", "list", "--format=%H %gs").splitlines():
            sha, _, msg = line.partition(" ")
            if msg.endswith(self.name):
                self.sha = sha
                return
        raise RuntimeError(f"stash {self.name} not found after saving it")

    def restore(self):
        if not self.sha:
            return True
        r = git(self.repo, "stash", "apply", "--index", self.sha, check=False)
        if r.returncode != 0:
            r = git(self.repo, "stash", "apply", self.sha, check=False)
        if r.returncode != 0:
            err(f"could not re-apply stash {self.name} ({self.sha[:10]}): {r.stderr.strip()[:200]}; it is kept: "
                f"`git stash list | grep {self.name}`")
            return False
        for i, line in enumerate(git(self.repo, "stash", "list", "--format=%H").splitlines()):
            if line.strip() == self.sha:
                git(self.repo, "stash", "drop", f"stash@{{{i}}}", check=False)
                break
        self.sha = None
        return True


def landed(repo, sha, main_ref):
    if git_ok(repo, "merge-base", "--is-ancestor", sha, main_ref):
        return "ancestor"
    lines = git(repo, "cherry", main_ref, sha).splitlines()
    if lines and all(l.startswith("-") for l in lines):
        return "patch-equivalent"
    return None


# THE LANDING LOCK IS A LEASE (design §6, phase 1 step 3; the owner, 2026-10-28: a push hung on a dropped tunnel held
# the flock 30+ min and a checked batch waited behind it). `land/<repo>` in the store: TTL LAND_LEASE_TTL, renewed only
# on real progress (run_watched's output / CPU), capped at LAND_LEASE_MAX; a holder that stops progressing simply
# loses it, and a waiter takes it. No flock, no heartbeat file, no killing another process: expiry IS the release.
# A holder that lost the lease stops its work (run_watched ends its group: LeaseLost).
LAND_LEASE_TTL = 120
LAND_LEASE_MAX = 45 * 60  # the design's 300 s once checks no longer run in the push's hook under the lease (step 6)


def land_lease_name(repo):
    """One lease per repository: every worktree of a clone shares its git common dir."""
    common = os.path.realpath(git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir").strip())
    return "land/" + re.sub(r"[^A-Za-z0-9._-]", "_", common.strip("/"))


_held_lock = [None]  # (store, name, lease) of the landing lease this process holds


def lock_note(step):
    """Say in the held landing lease what the holder is doing now (waiters print it)."""
    if _held_lock[0]:
        st, name, lease = _held_lock[0]
        st.note(name, lease["epoch"], lease["secret"], f"{step} since {ts()}")


def lock_beat(progress=None):
    """The holder at work renews every lease this process holds -- the landing lease, a check slot, a change's check --
    with its progress mark (run_watched: output bytes and CPU). Raises LeaseLost when one is gone: the work must stop."""
    if progress is None:
        return
    if _held_lock[0]:
        st, name, lease = _held_lock[0]
        if st.renew(name, lease["epoch"], lease["secret"], progress, lease["ttl"]) == "lost":
            raise LeaseLost(f"the landing lease {name} (epoch {lease['epoch']}) was lost")
    for h in list(_held_leases):
        if h.renew(progress) == "lost":
            raise LeaseLost(f"the lease {h.name} (epoch {h.lease['epoch']}) was lost")


_held_leases = []  # the LeaseHold objects this process holds (renewed together on progress)


class LeaseHold:
    """One lease this process holds: acquired (or not: held elsewhere), renewed on progress, released at the end."""

    def __init__(self, name, ttl, max_hold, meta=None, store=None):
        self.name, self.ttl, self.max_hold, self.meta = name, ttl, max_hold, dict(meta or {}, pid=os.getpid())
        self.store, self.lease, self.held = store or Store(), None, None

    def acquire(self):
        got = self.store.acquire(self.name, f"{socket_host()}:{self.name.split('/')[0]}:{os.getpid()}", self.ttl,
                                 self.max_hold, progress="acquired", meta=self.meta)
        if "held" in got:
            self.held = got["held"]
            return False
        self.lease = got
        _held_leases.append(self)
        return True

    def renew(self, progress):
        if not self.lease:
            return "lost"
        return self.store.renew(self.name, self.lease["epoch"], self.lease["secret"], progress, self.ttl)

    def release(self):
        if self in _held_leases:
            _held_leases.remove(self)
        if self.lease:
            self.store.release(self.name, self.lease["epoch"], self.lease["secret"])
            self.lease = None

    def close(self):  # the old slot file's name for it
        self.release()


def lease_live(name, store=None):
    """The live lease `name` (its row, meta decoded), or None."""
    r = (store or Store()).get(name)
    if r and r["holder"] and r["expires_at"] > time.time():
        r["meta"] = json.loads(r["meta"] or "{}")
        return r
    return None


def held_for(lease):
    return f"{int((time.time() - float(lease.get('acquired_at') or time.time())) // 60)} min"


@contextlib.contextmanager
def land_lock(repo):
    """Hold the repository's landing lease, waiting for it with a line saying who holds it and doing what, repeated
    every LAND_WAIT_REPORT_MIN minutes. Yields True when held, False when the wait timed out."""
    st, name = Store(), land_lease_name(repo)
    holder = f"{socket_host()}:land:{os.getpid()}"
    ttl = env_num("AGENTCTL_LAND_LEASE_TTL", LAND_LEASE_TTL)
    got = st.acquire(name, holder, ttl, env_num("AGENTCTL_LAND_LEASE_MAX", LAND_LEASE_MAX), progress="acquired",
                     meta={"pid": os.getpid(), "repo": repo})
    if "held" in got:
        def said(h):
            meta = json.loads(h.get("meta") or "{}")
            return f"{h['holder']} (pid {meta.get('pid')}), {meta.get('note') or 'working'}; expires in {int(h['expires_at'] - time.time())} s"
        err(f"waiting for the landing lease {name}, held by {said(got['held'])}")
        deadline = time.monotonic() + float(os.environ.get("AGENTCTL_LAND_LOCK_TIMEOUT", LAND_LOCK_TIMEOUT))
        every = float(os.environ.get("AGENTCTL_LAND_WAIT_REPORT_MIN", LAND_WAIT_REPORT_MIN)) * 60
        report_at = time.monotonic() + every
        while "held" in got:
            if time.monotonic() > deadline:
                yield False
                return
            if time.monotonic() > report_at:
                err(f"still waiting for the landing lease: {said(got['held'])}")
                report_at = time.monotonic() + every
            time.sleep(2)
            got = st.acquire(name, holder, ttl, env_num("AGENTCTL_LAND_LEASE_MAX", LAND_LEASE_MAX),
                             progress="acquired", meta={"pid": os.getpid(), "repo": repo})
        err("got the landing lease")
    got["ttl"] = ttl
    _held_lock[0] = (st, name, got)
    try:
        yield True
    finally:
        _held_lock[0] = None
        st.release(name, got["epoch"], got["secret"])


def socket_host():
    import socket
    return socket.gethostname().split(".")[0]


def precheck_hook(repo):
    """The repo's own pre-push hook, when it has one with a dry-run mode (movies: scripts/hooks/pre-push --range)."""
    hook = os.path.join(repo, "scripts", "hooks", "pre-push")
    return hook if os.access(hook, os.X_OK) else None


LAND_SUBCOMMANDS = {"status": "status", "hold": "pause", "release": "resume", "cancel": "cancel"}
WAITING_RENAMED = {"status": "land status", "pause": "land hold", "resume": "land release", "cancel": "land cancel <id>",
                   "run": "tick", "service": "tick service"}
ALIASES_UNTIL = "2026-11-05"  # the old command names (design §14.5) answer until then, each naming its new one


def cmd_land(a):
    if getattr(a, "lcmd", None):  # land status | hold | release | cancel <id>: the queue (design §14.5)
        if a.lcmd == "cancel" and not a.entry:
            print("usage: agentctl land cancel <id>")
            return 2
        w = argparse.Namespace(wcmd=LAND_SUBCOMMANDS[a.lcmd], repo=a.repo, entry=a.entry, renamed=True)
        return cmd_waiting(w)
    if os.environ.get("PREPUSH_SKIP"):
        print("NOT LANDED: PREPUSH_SKIP is set in the environment; agentctl land never skips checks. `unset PREPUSH_SKIP`.")
        return 1
    repo = git(a.repo or os.getcwd(), "rev-parse", "--show-toplevel").strip()
    main_ref = f"refs/remotes/{REMOTE}/main"
    env = tool_env()
    log_path = os.path.join(scratch(), f"agentctl-land-{os.path.basename(repo)}-{os.getpid()}.log")

    def sh(*args):
        return subprocess.run(args, cwd=repo, capture_output=True, text=True, env=env)

    dirty = git(repo, "status", "--porcelain", "--untracked-files=no").strip()
    stash = None
    if dirty and not a.stash:
        print(f"NOT LANDED: the working tree has uncommitted changes ({len(dirty.splitlines())} file(s)). Commit them, or "
              "pass --stash to set them aside in a named stash and restore them afterwards.")
        return 1
    if a.branch:
        r = sh("git", "rev-parse", "--abbrev-ref", "HEAD")
        if r.stdout.strip() != a.branch:
            if dirty:
                print("NOT LANDED: --branch with a dirty tree; commit first")
                return 1
            r = sh("git", "switch", a.branch)
            if r.returncode:
                print(f"NOT LANDED: cannot switch to {a.branch}: {r.stderr.strip()}")
                return 1
    try:
        if dirty:
            stash = Stash(repo)
            stash.save()
            err(f"stashed local changes as {stash.name} ({stash.sha[:10]})")
        if queue_mode(repo, a):  # THE LAND QUEUE: rebase, guard, QUEUED -- the checks and the push are the processor's
            return enqueue(repo, main_ref, sh, a)
        a.landed_sha, a.pushed_at, a.waiting = None, None, None
        rc = None
        for round_ in range(LAND_PRECHECK_ROUNDS + 1):
            # The long checks first, WITHOUT the lock (the last round: under it, so a lander always finishes).
            a.prechecked = None
            if round_ < LAND_PRECHECK_ROUNDS:
                rc = precheck(repo, main_ref, sh, log_path, a)
                if rc is not None:
                    break
            with land_lock(repo) as held:
                if not held:
                    print("NOT LANDED: timed out waiting for the landing lock (another land is running its checks); "
                          "land again.")
                    return 1
                rc = land_loop(repo, main_ref, sh, log_path, a)
            if rc != MAIN_MOVED:
                break
            err(f"{REMOTE}/main moved since the check: checking again on it, outside the lock")
    finally:
        if stash and not stash.restore():
            print(f"WARNING: local changes are in stash {stash.name}, not restored")
    if rc == 0 and a.waiting and not getattr(a, "follow", False):
        return 0  # the processor lands it; LANDED / NOT LANDED and the WATCH verdict go to `agentctl inbox`
    if rc == 0 and a.waiting:  # --follow: wait here for the batch, then watch
        rc, a.landed_sha, a.pushed_at = await_entry(repo, a.waiting["id"], close=None if getattr(a, "keep_worktree", False) else repo)
    if rc != 0 or not a.landed_sha or getattr(a, "no_watch", False):
        return rc
    if not getattr(a, "follow", False):  # land ends at LANDED; its watch item's verdict goes to the inbox
        start_watch(repo, a.landed_sha, a.pushed_at, worktree=repo,
                    close=None if getattr(a, "keep_worktree", False) else repo,
                    session=os.environ.get("CLAUDE_CODE_SESSION_ID"))
        print(f"watching {a.landed_sha[:10]}: its WATCH verdict goes to `agentctl inbox`", flush=True)
        return 0
    # the lock is free again: the next lander goes while this one watches main's CI; on WATCH OK the worktree it ran
    # from is closed when proven merged (close_worktree), unless --keep-worktree
    return watch_landed(repo, a.landed_sha, a.pushed_at, close=None if getattr(a, "keep_worktree", False) else repo,
                        fixes=getattr(a, "fixes", None) or ())


MAIN_MOVED = "main moved"  # land_loop: the check outside the lock no longer covers forgejo/main


def sync(repo, main_ref, sh):
    """Fetch, rebase onto forgejo/main, the squash guard: (rc, None) when land is decided here, else (None, head)."""
    r = sh("git", "fetch", "--quiet", REMOTE, "main")
    if r.returncode:  # a tunnel restart is seconds long: one more try before giving up
        err(f"git fetch failed ({r.stderr.strip()[:120]}); retrying once in 15 s")
        time.sleep(15)
        r = sh("git", "fetch", "--quiet", REMOTE, "main")
    if r.returncode:
        print(f"NOT LANDED: git fetch {REMOTE} main failed: {r.stderr.strip()[:300]} (tunnel? `agentctl env --check`)")
        return 1, None
    head = git(repo, "rev-parse", "HEAD").strip()
    if landed(repo, head, main_ref):
        print(f"LANDED {head} (already on {REMOTE}/main)")
        return 0, None
    r = sh("git", "rebase", "--quiet", f"{REMOTE}/main")
    if r.returncode:
        conflicts = git(repo, "diff", "--name-only", "--diff-filter=U", check=False).stdout.split()
        sh("git", "rebase", "--abort")
        print(f"NOT LANDED: rebase onto {REMOTE}/main conflicts in: {', '.join(conflicts) or r.stderr.strip()[:300]}. "
              "Resolve by hand (git rebase forgejo/main), then land again.")
        return 1, None
    head = git(repo, "rev-parse", "HEAD").strip()
    if landed(repo, head, main_ref):
        print(f"LANDED {head} (the rebase left nothing: already on {REMOTE}/main)")
        return 0, None
    problems = check_range(repo, f"{REMOTE}/main", head, [], int(os.environ.get("AGENTCTL_MAX_FOREIGN", "2")))
    if problems:
        print("NOT LANDED: prepush-check refused:\n  " + "\n  ".join(problems))
        return 1, None
    return None, head


def dry_run(repo, hook, head, log_path, attempt, mode="--range", rechecked=False, cls="check"):
    """The repo hook's dry run over forgejo/main..head, admitted by the governor as a check (`red` for a fix of a red
    run), watched for a stall: None when it passed, else land's rc."""
    err(f"checking {head[:10]}: {os.path.relpath(hook, repo)} {mode} {REMOTE}/main..HEAD (log: {log_path})")
    lock_note(f"checks of {head[:10]}")
    with check_slot(repo, f"land {os.path.basename(repo)} {head[:10]}", cls) as slot:
        rc, out = run_watched([hook, mode, f"{REMOTE}/main..{head}"], repo, slot.env(tool_env()), log_path, "checks",
                              sampler=slot.sample)
        slot.done(rc, out)
    with open(log_path, "a") as f:
        f.write(f"=== check {attempt} {ts()} {head}\n{out}\n")
    if rc is None:
        return stalled("checks (scripts/hooks/pre-push --range)", out, log_path)
    if rc != 0:
        if not REDGATE.search(out) and os.environ.get("AGENTCTL_BASELINE", "1") != "0":
            new, known = judge_against_baseline(repo, hook, head, out, log_path)
            if known and not new:
                checks = ", ".join(sorted(known))
                print(f"KNOWN RED: {checks} fail{'s' if len(known) == 1 else ''} the same way on plain {REMOTE}/main "
                      f"(see `agentctl ci-why`, `Local checks`): not held against this change", flush=True)
                if not rechecked:  # the hook again, now with main's baseline written: it passes known reds (stored)
                    return dry_run(repo, hook, head, log_path, f"{attempt}, against the known-red baseline", mode,
                                   rechecked=True, cls=cls)
                return refused(repo, out, log_path, f"the pre-push checks failed only where plain {REMOTE}/main fails "
                               f"too ({checks}; a known red, claimable as `local`), and the hook still held them "
                               "against it (no baseline mode, or no baseline for this main), so this change lands once "
                               "they are fixed on main (or with the fix)")
            if known:
                print(f"KNOWN RED (not held against this change): {', '.join(sorted(known))}; NEW with this change: "
                      f"{', '.join(sorted(new))}", flush=True)
        return refused(repo, out, log_path, "the pre-push checks failed")
    if os.path.exists(reds_dir("local.json")):  # passing checks clear main's known red
        main_ = git(repo, "rev-parse", f"{REMOTE}/main").strip()
        had = bool(local_red().get("checks"))
        note_local_red(main_, {}, check_passes(out))
        if had and not os.path.exists(reds_dir("local.json")):
            try:
                local_cleared(repo, main_)
            except (Exception, SystemExit) as e:
                err(f"local red cleared, but releasing it failed ({str(e)[:120]})")
    return None


# THE KNOWN-RED BASELINE (the owner, 2026-10-27: "pre-push fails on plain forgejo/main" is itself a claimed red, and
# while it is open a change is judged against main's known-failing checks). When a change's dry run fails, the same
# checks run on plain forgejo/main's tree: a commit with main's tree on top of the change (`git commit-tree
# main^{tree} -p <head>`), checked with `--checks-only <head>..<that>` -- the change's paths select the checks, main's
# tree is checked. Checks failing there the same way (the same normalized failure lines) are main's own red: recorded
# in reds/local.json, shown by ci-why as `Local checks`, claimable (`red claim local`) and dispatched like any red, and
# land says which failures are the change's own. The hook's own output there is kept as `reds/baseline-out/<main sha>`
# (first line `pre-push baseline <main sha>`), the file movies' pre-push reads through $PREPUSH_BASELINE_DIR (tool_env):
# land's dry run then runs the hook once more, which passes a check failing only as it fails on main (its pass stored,
# so the push reuses it). No file for main: the hook blocks every failure (fail-closed).
HOOK_STATUS = re.compile(r"pre-push (\S+) (ok|FAILED) \(\d+s\)")
LOCAL_FLOW = "Local checks"


def check_failures(out):
    """{failed check: {normalized failure lines}} of a hook run's output."""
    fails, seg = {}, []
    for raw in (out or "").splitlines():
        line = ANSI.sub("", raw)
        m = HOOK_STATUS.search(line)
        if m:
            if m.group(2) == "FAILED":
                fails[m.group(1)] = {norm_line(l) for l in seg if STRONG.search(l)} or {"(no failure line)"}
            seg = []
            continue
        seg.append(line)
    return fails


def check_passes(out):
    return {m.group(1) for m in (HOOK_STATUS.search(ANSI.sub("", l)) for l in (out or "").splitlines())
            if m and m.group(2) == "ok"}


def local_red():
    return read_record(reds_dir("local.json")) or {}


def baseline_failures(repo, hook, head, log_path):
    """The change's checks run on plain forgejo/main's tree: {check: lines} failing there (cached per main tree and
    change paths), or None when it could not be run."""
    import hashlib
    main = git(repo, "rev-parse", f"{REMOTE}/main").strip()
    paths = git(repo, "diff", "--name-only", f"{REMOTE}/main...{head}").split()
    key = hashlib.sha1("\n".join([git(repo, "rev-parse", f"{main}^{{tree}}").strip()] + sorted(paths)).encode()).hexdigest()[:16]
    cache = reds_dir("baseline", f"{key}.json")
    rec = read_record(cache)
    if rec is not None:
        return {k: set(v) for k, v in rec["fails"].items()}
    synth = git(repo, "commit-tree", f"{main}^{{tree}}", "-p", head, "-m", f"agentctl baseline: {REMOTE}/main {main[:10]}",
                check=False)
    if synth.returncode != 0:
        return None
    synth = synth.stdout.strip()
    _d, clone, _w = waiting_state(repo)
    tree = f"{clone}-wt-baseline-{os.getpid()}"
    if git(repo, "worktree", "add", "-q", "--detach", mark_internal(tree), synth, check=False).returncode != 0:
        return None
    try:
        err(f"the change's checks failed: running them on plain {REMOTE}/main {main[:10]} (the known-red baseline)")
        with check_slot(repo, f"baseline {main[:10]}") as slot:
            rc, out = run_watched([os.path.join(tree, os.path.relpath(hook, repo)), "--checks-only", f"{head}..{synth}"],
                                  tree, {**slot.env(tool_env()), "PREPUSH_BASELINE_DIR": ""}, log_path, "baseline",
                                  sampler=slot.sample)
            slot.done(rc, out)
    finally:
        git(repo, "worktree", "remove", "--force", tree, check=False)
    if rc is None:
        return None
    write_baseline_out(main, out)
    fails = check_failures(out) if rc else {}
    write_json(cache, {"main": main, "at": ts(), "fails": {k: sorted(v) for k, v in fails.items()},
                       "passes": sorted(check_passes(out))})
    note_local_red(main, fails, check_passes(out))
    return fails


def write_baseline_out(main, out):
    """reds/baseline-out/<main>: the hook's output on plain main (appended to a run for other paths on the same main),
    for the hook's known-red baseline; files older than 3 days go."""
    d = reds_dir("baseline-out")
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, main)
    try:
        with open(path) as f:
            old = f.read()
    except OSError:
        old = ""
    if not old.startswith(f"pre-push baseline {main}\n"):
        old = f"pre-push baseline {main}\n"
    tmp = f"{path}.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(old + (out or "") + ("" if (out or "").endswith("\n") else "\n"))
    os.replace(tmp, path)
    for name in os.listdir(d):
        p = os.path.join(d, name)
        try:
            if time.time() - os.path.getmtime(p) > 3 * 86400:
                os.unlink(p)
        except OSError:
            pass


@contextlib.contextmanager
def local_lock():
    """One writer of reds/local.json at a time."""
    os.makedirs(reds_dir(), exist_ok=True)
    with open(reds_dir("local.lock"), "a+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def note_local_red(main, fails, passes):
    """Keep reds/local.json: the checks failing on plain forgejo/main (added), those seen passing (cleared)."""
    with local_lock():
        rec = local_red()
        checks = rec.get("checks") or {}
        for c in passes:
            checks.pop(c, None)
        for c, lines in fails.items():
            old = checks.get(c) or {"since": ts(), "first_main": main}
            checks[c] = {**old, "lines": sorted(lines)[:20], "main": main}
        rec.update(checks=checks, main=main, at=ts())
        if checks:
            write_json(reds_dir("local.json"), rec)
        elif os.path.exists(reds_dir("local.json")):
            os.unlink(reds_dir("local.json"))


# A STALE LOCAL RED (2026-10-27: `Local checks: RED on plain forgejo/main ac65cbbd7e` outlived the commit that fixed it).
# reds/local.json is keyed to the main sha it was computed on. Once forgejo/main moves past it the record is stale: shown as
# `stale, rechecking` (never RED), and the failing checks are run again on the new main's tree -- in the background by the
# processor's patrol (the governor's check class), synchronously by `red patrol`, or by the next land's dry run. A pass
# clears the red, releases its claims, stops its dispatched fixer (process groups) and puts FIX OK in the inbox; the
# fixer's worktrees whose commits are patch-equivalent on main are removed, any other is listed in the inbox.
HOOK_CHECKS = ("eslint drift snapshot sbt dashboards scripttests actionlint shellcheck oldrefs identity page ios "
               "judgements lintspecs linux basic").split()


def recheck_local(repo, wait=True):
    """Recompute a stale local red on the current forgejo/main. Returns action lines (when it ran synchronously)."""
    main = local_stale(repo)
    if not main:
        return release_local_leftovers(repo)
    if not wait:
        import threading
        t = _bounded.get("local-recheck")
        if t and t.is_alive():
            return []
        t = threading.Thread(target=lambda: _recheck_guarded(repo, main), name="local-recheck", daemon=True)
        _bounded["local-recheck"] = t
        t.start()
        return []
    return _recheck_guarded(repo, main)


def _recheck_guarded(repo, main):
    """One recheck at a time across processes (the processor's and a `red patrol`): the second one leaves it."""
    os.makedirs(reds_dir("local"), exist_ok=True)
    try:
        with open(reds_dir("local", "recheck.lock"), "a+") as lf:
            try:
                fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                return []
            return run_local_recheck(repo, main)
    except (Exception, SystemExit) as e:
        err(f"local recheck: skipped ({str(e).replace('agentctl: ', '')[:200]})")
        return []


def run_local_recheck(repo, main):
    """Run the recorded failing checks on main's tree (the hook over <recorded main>..main, every other check skipped)."""
    failing = sorted(local_red().get("checks") or {})
    hook = precheck_hook(repo)
    if not hook:
        return []
    # The base is the main the red FIRST appeared on (first_main; the record's `main` moves with every recheck): the checks judge what changed since (shellcheck fails only on warnings
    # a change ADDS, so against an empty base the whole tree would count). Unknown to this clone: the empty tree.
    firsts = [str(c.get("first_main") or "") for c in (local_red().get("checks") or {}).values()]
    old_main = next((f for f in firsts if f and git_ok(repo, "cat-file", "-e", f"{f}^{{commit}}")), "")
    if old_main and git_ok(repo, "cat-file", "-e", f"{old_main}^{{commit}}"):
        base = old_main
    else:
        empty = git(repo, "hash-object", "-t", "tree", "-w", "--stdin", input="").strip()
        base = git(repo, "commit-tree", empty, "-m", "agentctl recheck base").strip()
    synth = git(repo, "commit-tree", f"{main}^{{tree}}", "-p", base, "-m", f"agentctl recheck: {REMOTE}/main {main[:10]}").strip()
    _d, clone, _w = waiting_state(repo)
    for w in worktrees(repo)[1:]:  # a killed recheck's tree (its pid is gone)
        m = re.fullmatch(re.escape(clone) + r"-wt-recheck-(\d+)", w["worktree"])
        if m and not pid_alive(int(m.group(1))):
            git(repo, "worktree", "remove", "--force", w["worktree"], check=False)
    tree = f"{clone}-wt-recheck-{os.getpid()}"
    if git(repo, "worktree", "add", "-q", "--detach", mark_internal(tree), synth, check=False).returncode != 0:
        return []
    log_path = reds_dir("local", "recheck.log")
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    try:
        err(f"local checks were recorded on an older main: rechecking {', '.join(failing)} on {REMOTE}/main {main[:10]}")
        with check_slot(repo, f"local recheck {main[:10]}", "check") as slot:
            env = {**slot.env(tool_env()), "PREPUSH_BASELINE_DIR": "",
                   "PREPUSH_SKIP": " ".join(c for c in HOOK_CHECKS if c not in failing)}
            rc, out = run_watched([os.path.join(tree, os.path.relpath(hook, repo)), "--checks-only", f"{base}..{synth}"],
                                  tree, env, log_path, "recheck", sampler=slot.sample)
            slot.done(rc, out)
    finally:
        git(repo, "worktree", "remove", "--force", tree, check=False)
        git(repo, "gc", "--auto", "--quiet", check=False)
    if rc is None:
        return []  # stalled: stays stale, rechecked next time
    return apply_local_recheck(repo, main, rc, out)


def apply_local_recheck(repo, main, rc, out):
    """Record a recheck's outcome (also what land's passing dry run does): still failing -> re-keyed to main; passed ->
    cleared and released."""
    failing = dict(local_red().get("checks") or {})
    passes = check_passes(out)
    fails = check_failures(out) if rc else {}
    for c, v in failing.items():  # neither seen passing nor failing (not run): still the old failure, on the new main
        if c not in passes and c not in fails:
            fails[c] = set(v.get("lines") or [])
    write_baseline_out(main, out)
    note_local_red(main, fails, passes)
    if os.path.exists(reds_dir("local.json")):
        return [f"local checks still fail on {REMOTE}/main {main[:10]}: {', '.join(sorted(fails))}"]
    return local_cleared(repo, main)


def local_cleared(repo, main):
    """The local red is gone (its red item clears at the next tick, its holder told to stop): FIX OK to the inbox, the
    fixer's worktrees tidied."""
    line = f"FIX OK: Local checks pass on {REMOTE}/main {main[:10]}; the red is cleared"
    inbox_write("red", line, [line], [], 0)
    return [line] + release_local_leftovers(repo)


def release_local_leftovers(repo):
    """With no local red: each ended local fixer's worktree is removed when its commits are patch-equivalent on main
    (git cherry); anything else is listed in the inbox, never deleted. Once per fixer record."""
    if local_red().get("checks"):
        return []
    acts = []
    for r in fixer_records():
        if r.get("workflow") != LOCAL_FLOW or r["alive"] or r.get("tidied"):
            continue
        wt = r.get("worktree")
        if not wt or not os.path.isdir(wt):
            msg = None
        else:
            msg = close_worktree(wt)
            if not msg.startswith("closed"):
                line = f"RED LEFTOVER: the local fixer's {wt.replace(HOME, '~')} was kept ({msg.split(': ', 1)[-1]}); not patch-equivalent on main, review it"
                inbox_write("red", line, [line], [], 1)
                acts.append(line)
                msg = None
        if msg:
            acts.append(f"removed the local fixer's worktree: {msg}")
        rec = read_record(r["path"]) or {}
        rec["tidied"] = ts()
        write_json(r["path"], rec)
    return acts


def judge_against_baseline(repo, hook, head, out, log_path):
    """(new failures, known): the change's failures that plain forgejo/main does not share, and those it does."""
    mine = check_failures(out)
    if not mine:
        return None, {}
    base = baseline_failures(repo, hook, head, log_path)
    if base is None:
        return None, {}
    new = {c: l for c, l in mine.items() if c not in base or not (l <= base[c])}
    return new, {c: l for c, l in mine.items() if c not in new}


def current_main(repo):
    r = git(repo, "rev-parse", "--verify", "-q", f"{REMOTE}/main", check=False) if repo else None
    return r.stdout.strip() if r is not None and r.returncode == 0 else None


def local_stale(repo):
    """forgejo/main's sha when the recorded local red was computed on an older one (the record is stale), else None."""
    rec = local_red()
    if not rec.get("checks"):
        return None
    cur = current_main(repo)
    return cur if cur and cur != rec.get("main") else None


def local_units(repo=None):
    """main's own local-checks red (reds/local.json) as red units: one per failing check, run `local`. A record
    computed on an older main is stale: no units (shown as `stale, rechecking`, never RED)."""
    if repo and local_stale(repo):
        return []
    rec = local_red()
    units = []
    for check, c in sorted((rec.get("checks") or {}).items()):
        line = (c.get("lines") or [""])[0]
        s = {"job": check, "kind": "test", "line": line, "sig": signature(LOCAL_FLOW, check, line)}
        run = {"number": "local", "databaseId": f"local-{str(c.get('main'))[:10]}", "headSha": c.get("main"),
               "status": "completed", "conclusion": "failure"}
        units += red_units("?", LOCAL_FLOW, run, [], [s], True)
    return units


def precheck(repo, main_ref, sh, log_path, a):
    """Before the lock: sync and the hook's dry run (the long part). None when land goes on to the lock (with
    a.prechecked = (head, base) when the dry run passed there), else land's rc."""
    rc, head = sync(repo, main_ref, sh)
    if rc is not None:
        return rc
    hook = precheck_hook(repo)
    if not hook:
        return None
    # The change's OWN checks first, red main or green (the owner, 2026-10-27: "once the checks are done but build is
    # red, merge to waiting"): main red and the change one that must wait, without the gate (--checks-only), since it
    # will join `waiting` and land with the batch at green.
    reds = gate_reds(repo) if waiting_supported(repo) else set()
    commits = waiting_commits(repo, f"{REMOTE}/main", head)
    joining = bool(reds) and must_wait(repo, commits, reds)
    rc = dry_run(repo, hook, head, log_path, "before the lock", mode="--checks-only" if joining else "--range",
                 cls=gov_class_of(repo, commits, reds))
    if rc is not None:
        return rc
    a.prechecked = (head, git(repo, "rev-parse", main_ref).strip())
    return None


def land_loop(repo, main_ref, sh, log_path, a):
    for attempt in range(LAND_RETRIES + 1):
        lock_note("fetch and rebase")
        rc, head = sync(repo, main_ref, sh)
        if rc is not None:
            return rc
        reds = gate_reds(repo) if waiting_supported(repo) else set()
        if reds and must_wait(repo, waiting_commits(repo, f"{REMOTE}/main", head), reds):
            # checked already (before the lock, without the gate): only the cherry-pick onto `waiting` here
            return join(repo, main_ref, sh, log_path, a, head=head)
        hook = precheck_hook(repo)
        prechecked = getattr(a, "prechecked", None)
        if hook and prechecked and prechecked != (head, git(repo, "rev-parse", main_ref).strip()):
            # main moved since the check outside the lock: give the lock back and check again outside it
            a.prechecked = None
            return MAIN_MOVED
        if hook and not prechecked:
            # CHECK FIRST: the hook's dry run over exactly what the push will carry (its pass is stored, so the push's own
            # hook run reuses it in seconds). A long hook inside `git push` holds the push's ssh connection idle, and a
            # tunnel drop kills it after "all clear" (2026-10-23); the area tests make long hooks the norm.
            rc = dry_run(repo, hook, head, log_path, attempt + 1,
                         cls=gov_class_of(repo, waiting_commits(repo, f"{REMOTE}/main", head), reds))
            if rc is not None:
                return rc
        a.prechecked = None  # a retry after a push race checks its new base again
        try:  # the runs the pushed commits claim to fix: the watch verifies them
            a.fixes = sorted(fixes_of(repo, waiting_commits(repo, f"{REMOTE}/main", head)))
        except Exception:
            a.fixes = []
        err(f"pushing {head[:10]} to {REMOTE}/main (attempt {attempt + 1}/{LAND_RETRIES + 1}; hook log: {log_path})")
        lock_note(f"push of {head[:10]}")
        a.pushed_at = time.time()
        rc, out = run_watched(push_argv(REMOTE, head), repo, tool_env(), log_path, "push", **push_bounds())
        if rc == 0:
            mark_gate_dirty()
        with open(log_path, "a") as f:
            f.write(f"=== attempt {attempt + 1} {ts()} {head}\n{out}\n")
        if rc is None:
            return stalled("push (git push and its pre-push hook)", out, log_path)
        if rc == 0:
            sh("git", "fetch", "--quiet", REMOTE, "main")
            how = landed(repo, head, main_ref)
            if how:
                print(f"LANDED {head}" + ("" if how == "ancestor" else f" ({how})"), flush=True)
                a.landed_sha = head
                return 0
            print(f"NOT LANDED: the push exited 0 but {head[:10]} is not on {REMOTE}/main after a fetch; see {log_path}")
            return 1
        if RACE.search(out) and attempt < LAND_RETRIES:
            err(f"push race ({RACE.search(out).group(0)}): refetch, rebase, retry")
            time.sleep(min(30, 2 + 3 * attempt))
            continue
        if RACE.search(out) and not REDGATE.search(out):
            print(f"NOT LANDED: still racing after {LAND_RETRIES} retries ({RACE.search(out).group(0)}); try again shortly.")
            return 1
        return refused(repo, out, log_path, "the push failed (pre-push hook or remote)")
    return 1


def refused(repo, out, log_path, what):
    """Print the NOT LANDED line for a hook or push that said no: the red gate explained by ci-why, a tunnel hinted."""
    tail = "\n  ".join([l for l in out.splitlines() if l.strip()][-25:])
    if REDGATE.search(out):
        print(f"NOT LANDED: the red gate refused the push (main is red).\n  {tail}")
        try:
            print(ci_why(slug(repo), 4, repo=repo)[1])
        except Exception as e:
            print(f"(agentctl ci-why failed: {e})")
        return 1
    hint = ""
    if TUNNEL_TROUBLE.search(out):
        hint = ("\n  HINT: the hook could not reach Forgejo (tunnel dropped?): `~/bin/agentctl env --check` "
                "(it says the kickstart fix), then land again.")
    print(f"NOT LANDED: {what}. Last lines (full log {log_path}):\n  {tail}{hint}")
    return 1


# ---------------------------------------------------------------- land: the watch after LANDED
# The owner (2026-10-26): "whenever an agent pushed to main, make a script watch the corresponding convergence and main
# build and tell the agent if it fails". With no pre-merge CI, main's CI is where a change is tested in full: land keeps
# running after LANDED until Main and the convergence say green or red, so the agent (land in the background) hears it.
WATCH = {"pawelkrupinski/movies": {"main": ("Main", "main.yml"),
                                   "convergence": ("Identity model convergence", "identity-model-convergence.yml")}}
WATCH_TIMEOUT = 3 * 3600          # either run undecided by then: exit 2, could not tell
WATCH_CONV_START = 3600           # no convergence run containing the sha started by then: said, not waited for
WATCH_SLACK = 120                 # clock skew between the laptop and Forgejo's createdAt
WATCH_STALL_MIN = 120  # a watch with no change in its runs for this long ends WATCH STALLED
UNDECIDED = ("cancelled", "skipped", "neutral", "")


def contains(repo, sha, head):
    """Whether a run's head commit contains sha (fetching main once when head is unknown here)."""
    if not head:
        return False
    if head == sha:
        return True
    if not git_ok(repo, "cat-file", "-e", f"{head}^{{commit}}"):
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
    return git_ok(repo, "merge-base", "--is-ancestor", sha, head)


def is_cancelled(r):
    return r.get("status") == "completed" and (r.get("conclusion") or "") in UNDECIDED


def pick_main_run(repo, sha, runs):
    """Main's run for sha: its own push run, unless that was cancelled or never came (a newer push superseded it); then the
    newest run whose head contains sha."""
    own = next((r for r in runs if r.get("headSha") == sha and not is_cancelled(r)), None)
    if own:
        return own
    later = [r for r in runs if not is_cancelled(r) and contains(repo, sha, r.get("headSha"))]
    return max(later, key=lambda r: r["databaseId"]) if later else None


def pick_convergence_run(repo, sha, runs, pushed_at):
    """The FIRST convergence run on main created after the push whose head contains sha -- this commit's kick, a later
    push's, or the daily run (the owner, 2026-10-26: never hunt the sha's own kick). A cancelled one (the lane replaced
    it) passes to the next."""
    after = [r for r in runs if r.get("createdAt") and parse_time(r["createdAt"]).timestamp() >= pushed_at - WATCH_SLACK]
    ok = [r for r in sorted(after, key=lambda r: r["databaseId"]) if not is_cancelled(r) and contains(repo, sha, r.get("headSha"))]
    return ok[0] if ok else None


def watch_landed(repo, sha, pushed_at, o_r=None, close=None, fixes=()):
    """Watch Main and the convergence for a landed sha. 0 green (or nothing to watch), 3 red, 2 could not tell. OWNED
    (one watcher per sha; on agentctl's new code it re-execs as `agentctl watch`). fixes: the runs the landed commits'
    `Fixes-Red:` trailers name (the sha's own are read here too): each is verified against the new run (FIX OK / FIX
    FAILED, to the inbox)."""
    o_r = o_r or slug(repo)
    flows = WATCH.get(o_r)
    if not flows:
        print(f"watch: no CI watched for {o_r} (only movies' Main and convergence are)")
        return 0
    pushed_at = pushed_at or time.time()
    try:
        fixes = sorted(set(fixes) | fixes_of(repo, [sha]))
    except Exception:
        fixes = sorted(set(fixes))
    own = Owned("watch", f"{o_r}-{sha}", ["watch", "--repo", repo, "--sha", sha, "--pushed-at", str(pushed_at)]
                + (["--close", close] if close else []) + [x for f in fixes for x in ("--fixes", f)])
    if not own.acquire():
        h = own.holder or {}
        print(f"WATCH UNKNOWN: another agentctl (pid {h.get('pid')}, {h.get('owner')}) already watches {sha[:10]}; "
              "its verdict is its own (`agentctl orphans` lists owners)")
        return 2
    try:
        rc = _watch(repo, sha, pushed_at, o_r, flows, own, fixes)
    finally:
        own.release()
    if rc == 0 and close:
        print(close_worktree(close), flush=True)
    return rc


def failed_jobs(o_r, rid):
    d = gh_json(o_r, "run", "view", str(rid), "--json", "jobs")
    return [j["name"] for j in d.get("jobs") or [] if j.get("conclusion") in ("failure", "timed_out", "cancelled")]


def run_id_of_number(o_r, n):
    """The run id whose run NUMBER (Forgejo's index_in_repo, the #N of every link) is n, or None."""
    try:
        runs = (api(o_r, "GET", "actions/runs", {"run_number": int(n), "limit": 5}) or {}).get("workflow_runs") or []
    except (Exception, SystemExit):
        return None
    hit = next((x for x in runs if str(x.get("index_in_repo", x.get("run_number"))) == str(n)), None)
    return hit and hit.get("id")


def repo_for_verify(o_r):
    return scan_repo_for(o_r) or repo_path_for(o_r)


def workflow_file_of(repo, sha, name):
    """(path in the tree, text) of the workflow file whose `name:` is `name`, at sha."""
    for d in (".forgejo/workflows", ".github/workflows"):
        r = git(repo, "ls-tree", "--name-only", sha, f"{d}/", check=False)
        for path in r.stdout.split():
            txt = git(repo, "show", f"{sha}:{path}", check=False).stdout
            if re.search(rf"^name:\s*[\"']?{re.escape(name)}[\"']?\s*$", txt, re.M):
                return path, txt
    return None, ""


def _watch(repo, sha, pushed_at, o_r, flows, own, fixes=()):
    timeout = float(os.environ.get("AGENTCTL_WATCH_TIMEOUT", WATCH_TIMEOUT))
    conv_start = float(os.environ.get("AGENTCTL_WATCH_CONV_START", WATCH_CONV_START))
    t0 = time.time()
    err(f"watching Main and the convergence for {sha[:10]} (up to {int(timeout // 60)} min; `--no-watch` skips this)"
        + (f"; its Fixes-Red {', '.join(fixes)} is verified by the red's own item (`agentctl red status`)" if fixes else ""))
    done, said, listed = {}, set(), {}  # kind -> (run, ok | None for none started); kind -> the runs last listed
    # NO PROGRESS: nothing about the followed runs (which run, its status, its last update) changed for this long ends
    # the watch with a named verdict (a queue Forgejo never serves, a runner lost mid-run), not a silent 3 h wait
    stall = float(os.environ.get("AGENTCTL_WATCH_STALL_MIN", WATCH_STALL_MIN)) * 60
    state, changed = None, time.time()
    delays = backoff(float(os.environ.get("AGENTCTL_WATCH_POLL", 60)), 300)
    # UNREACHABLE: a failed read backs off (to 5 min) and is retried until the watch's own bound; only then UNKNOWN,
    # saying for how long Forgejo could not be read (2026-10-27: ten failures in a row used to end it in minutes)
    unreachable, failures, last_error, err_delays = None, 0, "", None

    def verdict(rc, line):
        print(line, flush=True)
        return rc

    while True:
        seen = {}
        try:
            for kind, (name, wfile) in flows.items():
                if kind in done:
                    continue
                runs = gh_json(o_r, "run", "list", "--workflow", wfile, "--branch", "main", "--limit", "30",
                               "--json", RUN_FIELDS)
                listed[kind] = runs
                run = pick_main_run(repo, sha, runs) if kind == "main" else pick_convergence_run(repo, sha, runs, pushed_at)
                if run is None:
                    if kind == "convergence" and time.time() - t0 >= conv_start:
                        done[kind] = (None, None)
                        print(f"convergence: none started within {int(conv_start // 60)} min of the push", flush=True)
                    continue
                seen[kind] = (run.get("databaseId"), run.get("status"), run.get("updatedAt"))
                if (kind, run["databaseId"]) not in said:
                    said.add((kind, run["databaseId"]))
                    err(f"{name}: following run #{run.get('number')} ({run.get('status')}, head {str(run.get('headSha'))[:10]})")
                if run.get("status") == "completed" and not is_cancelled(run):
                    done[kind] = (run, run.get("conclusion") == "success")
                    print(f"{name} #{run.get('number')}: {run.get('conclusion')}", flush=True)
            if unreachable is not None:
                err(f"watch: Forgejo answers again after {red_for(iso_at(unreachable))} ({failures} failed reads)")
            unreachable, failures, err_delays = None, 0, None
        except NoToken as e:  # no vault for this process: retrying cannot help
            return verdict(2, f"WATCH UNKNOWN: no Forgejo token ({str(e).replace('agentctl: ', '')}); "
                              f"check `agentctl ci-why` for {sha[:10]}")
        except Exception as e:  # a tunnel blip, Forgejo down: read again, backing off, until the bound
            failures += 1
            last_error = str(e)[:160]
            if unreachable is None:
                unreachable, err_delays = time.time(), backoff(float(os.environ.get("AGENTCTL_WATCH_ERROR_POLL", 30)), 300)
            err(f"watch: could not read the runs ({last_error}) [{failures} failed, unreachable for "
                f"{red_for(iso_at(unreachable))}]")
        reds = [(k, r) for k, (r, ok) in done.items() if ok is False]
        if reds:
            for kind, r in reds:
                try:
                    failed = failed_jobs(o_r, r["databaseId"])
                except (Exception, SystemExit) as e:  # the verdict stands without the job names
                    err(f"could not read the jobs of run {r['databaseId']} ({str(e)[:120]})")
                    failed = []
                print(f"WATCH RED: {flows[kind][0]} #{r.get('number')} {', '.join(failed) or r.get('conclusion')} "
                      f"(it contains your {sha[:10]}: if your change broke it, fix forward now with `Fixes-Red: "
                      f"{r.get('number')}`)", flush=True)
            try:
                print(ci_why(o_r, 4, repo=repo)[1])
            except (Exception, SystemExit) as e:
                print(f"(agentctl ci-why failed: {e})")
            return 3
        if len(done) == len(flows):
            parts = [f"{flows[k][0].split()[0] if k == 'main' else 'convergence'} " +
                     (f"#{r.get('number')} green" if r else "none started") for k, (r, ok) in done.items()]
            return verdict(0, "WATCH OK: " + ", ".join(sorted(parts, key=lambda x: not x.startswith("Main"))))
        if time.time() - t0 >= timeout:
            left = ", ".join(flows[k][0] for k in flows if k not in done)
            if unreachable is not None:
                return verdict(2, f"WATCH UNKNOWN: Forgejo's runs could not be read for {red_for(iso_at(unreachable))} "
                                  f"({failures} failed reads, the last: {last_error}); {left} undecided after "
                                  f"{int(timeout // 60)} min; check `agentctl ci-why` later")
            return verdict(2, f"WATCH UNKNOWN: {left} undecided after {int(timeout // 60)} min; check `agentctl ci-why` "
                              "later")
        if unreachable is None:  # a failed read says nothing about the runs: no stall judged on it
            now_state = (tuple(sorted(done)), tuple(sorted(seen.items())))
            if now_state != state:
                state, changed = now_state, time.time()
            elif time.time() - changed >= stall:
                left = ", ".join(f"{flows[k][0]} {('run ' + str(v[0]) + ' ' + str(v[1])) if v else 'no run'}"
                                 for k, v in [(k, seen.get(k)) for k in flows if k not in done])
                return verdict(2, f"WATCH STALLED: no change in {left} for {int(stall // 60)} min; check `agentctl "
                                  "ci-why` later")
        restart_if_changed([own])
        time.sleep(next(err_delays) if unreachable is not None else next(delays))


def iso_at(t):
    return dt.datetime.fromtimestamp(t, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ---------------------------------------------------------------- waiting: production changes held while main is red
# The owner (2026-10-26): "when waiting for main to go green, merge all waiting changes into one waiting branch (always
# use the same name) and merge it when main is green". While the gate is red, `land` puts a production change onto the
# local branch `waiting` (worktree <main clone>-wt-waiting) instead of being refused: rebased onto it, the local checks
# run on the combined tip, `WAITING <sha> (n changes queued on waiting)`. One processor (`waiting run`, detached, locked)
# watches the gate; once main is green it rebuilds `waiting` on forgejo/main, runs the hook's dry run, pushes the whole
# branch in ONE push, deletes it, and every waiting `land` goes on to its LANDED and WATCH. Tools-only commits and
# Fixes-Red fixes never wait (the hook lets them land while red). Replaces the merge queue.
WAITING_BRANCH = "waiting"
WAITING_DIR = None  # a test's override; else waiting_dir(): under the state root, resolved at each use


def waiting_dir():
    return WAITING_DIR or state_root("waiting")
PRODUCTION_GLOBS = ("*/src/main/*", "conf/*", "*/conf/*", "build.sbt", "project/*", "infra/nix/*", "infra/kubernetes/*",
                    "Dockerfile")
WAITING_AWAIT_TIMEOUT = 24 * 3600
WAITING_POLL = 60          # the processor's gate poll floor (backs off to 300 s)
WAITING_HELP = """The processor (one loop of ticks, launchd net.bitcashier.agentctl-waiting) and its queue: every landed change is
an item -- queued, checking, checked, pushing, landed; or waiting while main is red. At green the waiting changes are ONE
batch item: its tip assembled in a check tree (main plus the changes, Fixes-Red first), checked once (pre-push
--fast-only, a fresh sbt server; a stall retried once, then HELD), pushed in one push; a failing batch is bisected and
only the confirmed culprit rejected. No `waiting` branch. Every verdict goes to `agentctl inbox`.

  agentctl land status                          # the changes, the batch, the gate, the processor (hands it the token)
  agentctl land cancel <id>                     # drop a change
  agentctl land hold|release                    # stop / restart taking batches (changes still queue)
  agentctl tick [--once]                        # the processor
  agentctl tick service install|uninstall|status   # it as the launchd agent net.bitcashier.agentctl-waiting
The old names (`waiting status|pause|resume|cancel|run|service`) answer until 2026-11-05, each naming its new one."""


def is_production_path(p):
    """movies' pre-push is_production_path: what reaches a pod or a fleet host (the rest lands while red)."""
    return any(fnmatch.fnmatch(p, g) for g in PRODUCTION_GLOBS)


GATE_UNREAD = "unread"  # gate_reds' member when the gate could not be read: never green, and no Fixes-Red matches it
gate_unread_why = [""]


def gate_reds(repo):
    """The ids (run numbers and run ids) of the gating workflows' red runs on main; empty when green or not gated.
    When the gate cannot be read: {GATE_UNREAD}, which every caller takes as RED -- a production change waits, the
    processor takes no batch (the owner, 2026-10-27: an unread gate is never green; at 08:05Z a launchd processor with
    no Forgejo token read it as green, and the hook, with no token either, skipped its own gate: a push onto red #2047)."""
    try:
        o_r = slug(repo)
        if o_r not in GATING:
            return set()
        reds = set()
        for _name, decided, _newer, _streak in gate_runs(o_r):
            if decided and decided.get("conclusion") != "success":
                reds |= {str(decided.get("number")), str(decided.get("databaseId"))}
        gate_unread_why[0] = ""
        return reds
    except (Exception, SystemExit) as e:  # SystemExit: NoToken
        gate_unread_why[0] = str(e).replace("agentctl: ", "")[:200]
        err(f"could not read the gate ({gate_unread_why[0]}): taken as RED until it is read")
        return {GATE_UNREAD}


def waiting_supported(repo):
    """A repo hook, if any, must have --checks-only (its checks without the red gate) to check a waiting tip."""
    hook = precheck_hook(repo)
    if not hook:
        return True
    with open(hook) as f:
        return "--checks-only" in f.read()


def waiting_commits(repo, base, head):
    return git(repo, "rev-list", "--reverse", f"{base}..{head}").split()


def must_wait(repo, commits, reds):
    """A production commit with no Fixes-Red: naming a red run waits; tools-only and declared fixes go (the hook's rule)."""
    for c in commits:
        paths = git(repo, "diff-tree", "--no-commit-id", "--name-only", "-r", "--root", "-m", c).split("\n")
        if not any(p and is_production_path(p) for p in paths):
            continue
        fixes = git(repo, "log", "-1", "--format=%(trailers:key=Fixes-Red,valueonly,separator=%x2C)", c).strip()
        if not ({f.strip().lstrip("#") for f in fixes.split(",") if f.strip()} & reds):
            return True
    return False


def waiting_state(repo):
    common = os.path.realpath(git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir").strip())
    d = os.path.join(waiting_dir(), re.sub(r"[^A-Za-z0-9._-]", "_", common.strip("/")))
    os.makedirs(os.path.join(d, "entries"), exist_ok=True)
    clone = os.path.dirname(common) if os.path.basename(common) == ".git" else common
    return d, clone, f"{clone}-wt-waiting"


def waiting_entries(d, open_only=True):
    out = []
    for p in sorted(glob.glob(os.path.join(d, "entries", "*.json"))):
        try:
            with open(p) as f:
                e = json.load(f)
        except (OSError, ValueError):
            continue
        if not open_only or e.get("status") == "waiting":
            out.append(e)
    return sorted(out, key=lambda e: e["seq"])


ENTRY_FINAL = ("landed", "rejected", "superseded", "cancelled", "joined")


def save_entry(d, e):
    """The entry, written atomically. A final status on disk is never overwritten by a racing writer's non-final one
    (audit S2: `supersede` raced the checker's save): the disk's status and verdict stand."""
    p = os.path.join(d, "entries", f"{e['id']}.json")
    disk = read_record(p) or {}
    if disk.get("status") in ENTRY_FINAL and e.get("status") not in ENTRY_FINAL:
        e.update({k: disk[k] for k in ("status", "why", "decided", "superseded_by", "landed_sha") if k in disk})
    with open(p + ".tmp", "w") as f:
        json.dump(e, f, indent=1)
    os.replace(p + ".tmp", p)


def wlog(d, msg):
    with open(os.path.join(d, "processor.log"), "a") as f:
        f.write(f"{ts()} {msg}\n")


# NEVER AN EMPTY COMMIT (2026-10-27). An agent queued a commit, queued it again, and both entries ran: the later one's
# commit had already landed through the earlier one, its rebase (a cherry-pick with --keep-redundant-commits) left an
# EMPTY commit, and that was pushed -- four times on movies main (317fba9b3, 1fddd8951, 1d554f051, 693e1be78/82f4d9f55).
# Now every rebuild of an entry drops a commit that is patch-equivalent to its new base, or empty after the pick; an
# entry left with nothing is LANDED (already on main via <commit>); re-queueing supersedes the older entry; and the
# squash guard refuses any push carrying an empty commit unless it is a deliberate one with an `Allow-Empty:` trailer.
ALLOW_EMPTY_TRAILER = "Allow-Empty"


def deliberate_empty(repo, c):
    """A commit made empty on purpose: `git commit --allow-empty` with an `Allow-Empty: <why>` trailer."""
    return bool(git(repo, "log", "-1", f"--format=%(trailers:key={ALLOW_EMPTY_TRAILER},valueonly)", c,
                    check=False).stdout.strip())


def is_empty_commit(repo, c):
    """A non-merge commit whose tree is its parent's (a root commit is never empty here)."""
    parents = git(repo, "rev-list", "--parents", "-n", "1", c).split()[1:]
    if len(parents) != 1:
        return False
    return git(repo, "rev-parse", f"{c}^{{tree}}").strip() == git(repo, "rev-parse", f"{parents[0]}^{{tree}}").strip()


def patch_id(repo, c):
    diff = git(repo, "show", "--format=", "--no-color", "--no-ext-diff", c, check=False).stdout
    if not diff.strip():
        return None
    r = subprocess.run(["git", "patch-id", "--stable"], cwd=repo, input=diff, capture_output=True, text=True)
    return (r.stdout.split() or [None])[0]


def equivalent_on(repo, c, upstream, limit=400):
    """The commit of `upstream` (since its merge-base with c) that carries c's patch, or None (`git cherry`'s test,
    naming the commit)."""
    pid = patch_id(repo, c)
    if not pid:
        return None
    mb = git(repo, "merge-base", c, upstream, check=False).stdout.strip()
    rng = f"{mb}..{upstream}" if mb else upstream
    for u in git(repo, "rev-list", "--no-merges", "-n", str(limit), rng, check=False).stdout.split():
        if patch_id(repo, u) == pid:
            return u
    return None


def pick(wt, commits, dropped=None):
    """Cherry-pick commits onto wt's HEAD, one at a time: None, or the conflicting files (the pick aborted, HEAD back
    where it was). A commit already in HEAD's history (patch-equivalent), or empty once picked, is DROPPED, never kept
    as an empty commit: appended to `dropped` as (commit, the commit of HEAD carrying it, or None). A deliberate empty
    commit (an Allow-Empty: trailer) is kept."""
    start = git(wt, "rev-parse", "HEAD").strip()
    for c in commits:
        before = git(wt, "rev-parse", "HEAD").strip()
        r = git(wt, "cherry-pick", "--allow-empty", "--keep-redundant-commits", c, check=False)
        if r.returncode != 0:
            files = git(wt, "diff", "--name-only", "--diff-filter=U", check=False).stdout.split()
            git(wt, "cherry-pick", "--abort", check=False)
            via = equivalent_on(wt, c, before) if files else None
            if via:  # its patch is already there, and a later change to the same lines conflicts with it again
                git(wt, "reset", "--hard", "-q", before)
                if dropped is not None:
                    dropped.append((c, via))
                continue
            git(wt, "reset", "--hard", "-q", start)
            return files or [r.stderr.strip()[:200]]
        if is_empty_commit(wt, "HEAD") and not deliberate_empty(wt, c):
            git(wt, "reset", "--hard", "-q", before)
            if dropped is not None:
                dropped.append((c, equivalent_on(wt, c, before)))
    return None


def apply_entry(d, wt, e, base):
    """Pick the entry's commits onto wt's HEAD (base, or base plus earlier entries): ('ok', None), ('conflict', files),
    ('landed', via) or ('duplicate', via). A commit already on MAIN (base's history) is dropped from the entry for good
    (a partly landed entry keeps only the rest); one only an earlier entry carries is left out of this build alone (that
    entry may still be rejected). Nothing left of it on main: 'landed' -- the caller says LANDED, never pushes empty."""
    first = git(wt, "rev-parse", "HEAD").strip() == base
    dropped = []
    conflict = pick(wt, e["commits"], dropped)
    if conflict:
        return "conflict", conflict
    if not dropped:
        return "ok", None
    on_main = [(c, v) for c, v in dropped
               if (v and git(wt, "merge-base", "--is-ancestor", v, base, check=False).returncode == 0) or (not v and first)]
    if on_main:
        gone = {c for c, _v in on_main}
        e["commits"] = [c for c in e["commits"] if c not in gone]
        e.setdefault("dropped", []).extend([[c, v] for c, v in on_main])
        save_entry(d, e)
        wlog(d, f"{e['id']}: {len(on_main)} commit(s) already on {REMOTE}/main, dropped: "
                + ", ".join(f"{c[:10]} (via {v[:10] if v else 'an empty pick'})" for c, v in on_main))
        if not e["commits"]:
            return "landed", next((v for _c, v in reversed(on_main) if v), None)
    if not [c for c in e["commits"] if c not in {x for x, _v in dropped}]:  # all of it is on an earlier entry
        return "duplicate", next((v for _c, v in reversed(dropped) if v), None)
    return "ok", None


def already_landed(d, e, via):
    """Every commit of the entry is on main already (an earlier entry, or someone, landed it): LANDED, nothing pushed."""
    queue_verdict(d, e, "landed", f"LANDED {e['head']} (already on main via {via or 'an equivalent commit'}): "
                                  "nothing left to push", code=0, landed_sha=via, already=True)


def supersede(d, e, by, why):
    """The entry gives way to `by` (a newer entry of the same worktree and branch, or one carrying the same change): its
    checker, if running, is stopped; said in the inbox."""
    line = f"SUPERSEDED {e['id']} by {by}: {why}"
    set_change(d, e, "superseded", event=change_event(e, line, code=0), superseded_by=by, why=why, decided=ts())
    cancel_entry_remote(e, f"its queue entry was superseded by {by}")
    h = read_record(entry_owned(e["id"]).record) or {}
    if lock_held(entry_owned(e["id"]).lockpath) and h.get("pid") and int(h["pid"]) != os.getpid():
        try:
            os.kill(int(h["pid"]), signal.SIGTERM)  # its checker: its CI run is cancelled with it
        except OSError:
            pass
    wlog(d, line)


def run_hook(wt, mode, base):
    """(ok, output) of the checkout's scripts/hooks/pre-push <mode> base..HEAD; (True, '') when the repo has no hook."""
    hook = precheck_hook(wt)
    if not hook:
        return True, ""
    with open(hook) as f:
        has_checks_only = "--checks-only" in f.read()
    if mode == "--checks-only" and not has_checks_only:
        return False, ("scripts/hooks/pre-push has no --checks-only mode (the checks without the red gate) at this base: "
                       "the waiting branch needs the hook from movies' 'waiting' change")
    head = git(wt, "rev-parse", "HEAD").strip()
    lock_note(f"{mode} checks on `{WAITING_BRANCH}`")
    rc, out = run_watched([hook, mode, f"{base}..{head}"], wt, tool_env(), os.path.join(scratch(), f"agentctl-waiting-{os.getpid()}"),
                          "waiting-checks")
    if rc is None:
        mins = float(os.environ.get("AGENTCTL_LAND_STALL_MIN", LAND_STALL_MIN))
        return False, f"{out}\nstalled: scripts/hooks/pre-push {mode}: no output and no CPU for {mins:g} min, so it was ended"
    return rc == 0, out


def tail_of(out, n=25):
    return "\n  ".join([l for l in out.splitlines() if l.strip()][-n:])


def batching(repo):
    """Whether land batches here (every change joins `waiting`): a repo hook with --checks-only (movies)."""
    hook = precheck_hook(repo)
    return bool(hook) and waiting_supported(repo)


def fixes_of(repo, commits):
    """The run ids/numbers the commits' Fixes-Red: trailers name."""
    out = set()
    for c in commits:
        v = git(repo, "log", "-1", "--format=%(trailers:key=Fixes-Red,valueonly,separator=%x2C)", c).strip()
        out |= {f.strip().lstrip("#") for f in v.split(",") if f.strip()}
    return out


def batch_order(repo, entries, reds):
    """The order a batch is built in: a fix for the current red first, then (main red) what may land while red -- tools
    only, or every commit carrying a Fixes-Red for a red run -- then the rest; by join order within each."""
    def rank(e):
        if reds and set(e.get("fixes") or []) & reds:
            return 0
        if reds and not must_wait(repo, e["commits"], reds):
            return 1
        return 2
    return sorted(entries, key=lambda e: (rank(e), e["seq"]))


def join(repo, main_ref, sh, log_path, a, head=None, worktree=None, branch=None):
    """The change (its own checks passed) waits for main to turn green: a `waiting` entry (design §14.1: no branch, no
    worktree -- the batch is computed at green, in a check tree). Prints `WAITING <head> (entry <id>, n waiting)`."""
    if head is None:
        rc, head = sync(repo, main_ref, sh)
        if rc is not None:
            return rc
    d, _clone, _wt = waiting_state(repo)
    commits = waiting_commits(repo, f"{REMOTE}/main", head)
    branch = branch_of(repo) if branch is None else branch
    with open(os.path.join(d, "seq.lock"), "a+") as seq_lock:  # a seq of its own, beside a land queueing meanwhile
        fcntl.flock(seq_lock, fcntl.LOCK_EX)
        seq = max([e["seq"] for e in waiting_entries(d, open_only=False)] + [0]) + 1
        eid = f"{dt.datetime.now().strftime('%Y%m%d-%H%M%S')}-{os.path.basename(worktree or repo)}-{seq}"
        for old in waiting_entries(d):  # waiting again replaces this worktree and branch's older waiting entry
            if same_change_source(old, worktree or repo, branch):
                supersede(d, old, eid, f"{worktree or repo} waits again; only the newest entry lands")
        e = {"id": eid, "seq": seq, "worktree": worktree or repo, "branch": branch, "head": head, "commits": commits,
             "fixes": sorted(fixes_of(repo, commits)), "status": "waiting", "created": ts(), "tip": head,
             "follow": bool(getattr(a, "follow", False))}
        save_entry(d, e)
    n = len(waiting_entries(d))
    with open(log_path, "a") as f:
        f.write(f"=== waiting {ts()} {head} as {e['id']} ({n} waiting)\n")
    print(f"WAITING {head} (entry {e['id']}, {n} waiting)", flush=True)
    a.waiting = e
    spawn_waiting_processor(repo)
    offer_token(repo)
    return 0


# ---------------------------------------------------------------- the land queue: agents never wait on a land
# The owner (2026-10-27): "agents never wait on a land". `land` rebases the change onto forgejo/main, runs the squash
# guard, enqueues it and returns at once: `QUEUED <id> (<sha>)`. The always-on `waiting` processor (launchd
# net.bitcashier.agentctl-waiting) runs each queued change's checks in a CHECK TREE of its own (a pool of detached
# worktrees <clone>-wt-check-<n>, kept warm between checks, seeded from the shared build cache when cold), admitted by
# the governor (a check; red for a Fixes-Red fix of a red run, which goes first) -- or on ci-runner's check tier when the
# governor reports pressure (see "remote checks") -- then, under the landing lock: main green (or a change that may land
# while red), the checked tip is pushed (`LANDED`, and a detached watch); main red, it joins `waiting` (`WAITING`). Main
# moved meanwhile: rebased in the tree and checked again. Every verdict goes to the inbox with the agent's worktree.
# `land --follow` keeps the old in-process land (checks, push, watch) for scripts and red fixers.
QUEUE_POOL = 3          # check trees, so at most this many queued changes are checked at once ($AGENTCTL_CHECK_TREES)
# A check the LAPTOP failed, not the change: sbt's server never came up or was lost, a script test cut off by its
# time bound, a stall. Queued again after QUEUE_INFRA_DELAY, at most QUEUE_INFRA_RETRIES times, then judged as it is.
INFRA_CHECK_FAILURE = re.compile(r"failed to connect to server|sbt server did not start within \d+ seconds|"
                                 r"sbt server disconnected|^TIMEOUT +\d+s|STALLED:", re.M)
QUEUE_INFRA_RETRIES = 3
QUEUE_INFRA_DELAY = 300
# A PUSH, FETCH OR TUNNEL BLIP IS NO VERDICT ON THE CHANGE (audit #6, 2026-10-28: entry 67 "the push failed (pre-push
# hook or remote)" was a tunnel error in its tail; a fixer GAVE UP on it): such a failure, a stalled push, a lock that
# never came free and main moving under every round re-queue the entry (retry_after, at most QUEUE_INFRA_RETRIES),
# its `attempts` reset (a checker restart after an infra re-queue is no failure of the change).
TRANSIENT_PUSH = re.compile(r"Connection (reset|refused|timed out|closed)|closed by remote host|Could not resolve host|ssh: connect to host|"
                            r"kex_exchange_identification|[Bb]roken pipe|early EOF|remote end hung up|RPC failed|"
                            r"unable to access|HTTP (502|503|504)|timed out|Operation timed out|tunnel", re.I)
SLOT_WAIT_MAX = 2 * 3600  # a checker waits this long for a check tree, then the entry is re-queued


INFRA_BACKOFF = (300, 600, 1800, 3600)  # infra re-queues back off; from the third, each one escalates


def requeue_infra(d, e, why, delay=None):
    """Back to queued for a later look: infra NEVER rejects a change (design §5.1). The delay grows 5 -> 60 min; from
    QUEUE_INFRA_RETRIES on, each re-queue is an escalation (its event's severity). Returns True."""
    n = e.get("infra_retries", 0) + 1
    wait = delay if delay is not None else INFRA_BACKOFF[min(n - 1, len(INFRA_BACKOFF) - 1)]
    sev = "escalate" if n >= QUEUE_INFRA_RETRIES else "info"
    set_change(d, e, "queued", data={"infra_attempts": n},
               event=change_event(e, f"QUEUED AGAIN {e['id']}: infra ({why}); checked again in {int(wait // 60)} min",
                                  code=None, final=False, severity=sev),
               infra_retries=n, retry_after=time.time() + wait, why=f"infra: {why}", waiting_on=None)
    wlog(d, f"{e['id']}: {why}: queued again in {int(wait // 60)} min (infra retry {n}"
            + (", escalated" if sev == "escalate" else "") + ")")
    return True


# Main moved between a change's check and its push: re-checked only when what landed meanwhile can change the verdict
# (the owner, 2026-10-27: memo-key -41 passed runs 3341 and 3350, then main moved and it was checked a third time) --
# a path both touch, an sbt module one touches that the other's module is (or depends on: the hook's own compile plan,
# `pre-push --compile-plan`, build.sbt's dependsOn), or the build or the hook itself. Otherwise rebased and pushed with
# the change's checks skipped at the push (PREPUSH_SKIP: the hook's own plan for its paths; the red gate still runs);
# main's CI tests the combination. A rebase conflict is NOT LANDED, as ever.
RECHECK_ALWAYS = re.compile(r"^(build\.sbt|project/.*|scripts/hooks/.*|scripts/hooks-path\.sh|scripts/tool-conventions\.sh)$")


def range_paths(cwd, a, b):
    """The paths a..b changes (both sides of a rename)."""
    return [p for p in git(cwd, "diff", "--name-only", "--no-renames", a, b).splitlines() if p]


def hook_query(hook, tree, flag, paths):
    """The hook's dry-run answer for paths on stdin (`--plan`, `--compile-plan`), as words; None when unreadable."""
    try:
        r = subprocess.run([hook, flag], cwd=tree, input="".join(f"{p}\n" for p in paths), capture_output=True,
                           text=True, timeout=120, env=tool_env())
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout.split() if r.returncode == 0 else None


def sbt_modules(hook, tree, paths):
    """[(module, {module and its dependents})] per path that compiles into one, from the hook's compile plan (its first
    task is the path's own module); None when the plan cannot be read. The plan reads a path's directory and extension
    only, so one query per (directory, extension)."""
    reps = {}
    for p in paths:
        reps.setdefault((os.path.dirname(p), os.path.splitext(p)[1]), p)
    out = []
    for p in reps.values():
        tasks = hook_query(hook, tree, "--compile-plan", [p])
        if tasks is None:
            return None
        mods = [t.split("/", 1)[0] for t in tasks]
        if mods:
            out.append((mods[0], set(mods)))
    return out


def recheck_reason(hook, tree, base, moved, change_paths):
    """(commits main moved by, why the change must be checked again or None)."""
    n = len(git(tree, "rev-list", f"{base}..{moved}", check=False).stdout.split())
    landed_paths = range_paths(tree, base, moved)
    build = sorted(p for p in landed_paths if RECHECK_ALWAYS.match(p))
    if build:
        return n, f"they change {build[0]}"
    same = sorted(set(landed_paths) & set(change_paths))
    if same:
        return n, f"both touch {same[0]}" + (f" (+{len(same) - 1} more)" if len(same) > 1 else "")
    if not hook:
        return n, None
    mine, theirs = sbt_modules(hook, tree, change_paths), sbt_modules(hook, tree, landed_paths)
    if mine is None or theirs is None:
        return n, "the hook's compile plan could not be read"
    for m, m_deps in mine:
        for t, t_deps in theirs:
            if m in t_deps or t in m_deps:
                return n, f"sbt modules overlap ({m} and {t})"
    return n, None


def branch_of(wt):
    """The worktree's checked-out branch ('' when detached or gone)."""
    if not os.path.isdir(wt or ""):
        return ""
    return git(wt, "symbolic-ref", "--short", "-q", "HEAD", check=False).stdout.strip()


def same_change_source(e, worktree, branch):
    """Whether entry e came from this worktree and branch (an entry from before branches were recorded: the worktree)."""
    if os.path.realpath(e.get("worktree") or "") != os.path.realpath(worktree or ""):
        return False
    return not e.get("branch") or not branch or e["branch"] == branch


def queued_entries(d):
    return [e for e in waiting_entries(d, open_only=False) if e.get("status") in ("queued", "checking", "checked", "pushing")]


def queue_mode(repo, a):
    """Whether land queues (QUEUED, returning at once): a repo whose hook can check a change apart (movies), unless
    --follow / --no-watch (scripts), a dispatched red fixer (its wrapper reads LANDED), or AGENTCTL_QUEUE=0."""
    if getattr(a, "follow", False) or getattr(a, "no_watch", False) or os.environ.get("AGENTCTL_RED_FIXER"):
        return False
    return os.environ.get("AGENTCTL_QUEUE", "1") != "0" and batching(repo)


# SUBMISSION BY REF (design §13 step 14, §14.2): a queued change is also pushed to Forgejo as refs/heads/land/<entry>
# (its own ref: the movies hook checks nothing on it, no workflow runs on it), so the change no longer lives only in a
# worktree -- an author that ends, a worktree removed, leave it reachable. The tick deletes every land/* ref whose change
# is decided (or unknown). Checks rebuild from the commits, never from the worktree.
LAND_REF_SWEEP_EVERY = 600
_last_ref_sweep = [0.0]


def land_refs_supported(repo):
    """The repository's hook at forgejo/main checks nothing on a land/ ref (else the push would run its full checks)."""
    hook = git(repo, "show", f"{REMOTE}/main:scripts/hooks/pre-push", check=False).stdout
    return "refs/heads/land/" in hook


def submit_ref(repo, d, e, remote=False):
    """Push the change to refs/heads/land/<entry> (bounded); the entry records it. Never fatal in phase 1 (the queue does
    not need it); in phase 2 (remote: ci-runner fetches the change from it) the caller refuses without it."""
    if not land_refs_supported(repo):
        return None
    ref = f"refs/heads/land/{e['id']}"
    rc, out = run_watched(["git", "push", "--quiet", REMOTE, f"{e['head']}:{ref}"], repo, tool_env(),
                          os.path.join(d, f"submit-{e['id']}"), "submit", **push_bounds())
    if rc == 0:
        e["ref"] = ref
        if not remote:
            save_entry(d, e)
        return ref
    err(f"submit: could not push {ref} ({tail_of(out or '', 2)[:160]}); the change is queued all the same")
    return None


def sweep_land_refs(repo, d, now_=None):
    """Every LAND_REF_SWEEP_EVERY s: each remote land/<entry> ref whose change is decided, or unknown here, deleted."""
    t = now_ if now_ is not None else time.time()
    if t - _last_ref_sweep[0] < env_num("AGENTCTL_LAND_REF_SWEEP", LAND_REF_SWEEP_EVERY):
        return []
    _last_ref_sweep[0] = t
    r = git(repo, "ls-remote", "--heads", REMOTE, "refs/heads/land/*", check=False)
    if r.returncode != 0:
        return []
    every = {e["id"]: e for e in waiting_entries(d, open_only=False)}
    did = []
    for line in r.stdout.splitlines():
        ref = line.split()[-1]
        eid = ref[len("refs/heads/land/"):]
        e = every.get(eid)
        if e and e.get("status") not in ENTRY_FINAL:
            continue
        dr = git(repo, "push", "--quiet", REMOTE, f":{ref}", check=False)
        did.append(f"{ref}: deleted" if dr.returncode == 0 else f"{ref}: could not delete")
    return did


def enqueue(repo, main_ref, sh, a):
    """Rebase, squash guard, then the change becomes a queued entry: prints QUEUED and starts the processor."""
    rc, head = sync(repo, main_ref, sh)
    if rc is not None:
        return rc
    d, _clone, _wt = waiting_state(repo)
    commits = waiting_commits(repo, f"{REMOTE}/main", head)
    fields = {"worktree": repo, "branch": branch_of(repo), "head": head, "commits": commits,
              "fixes": sorted(fixes_of(repo, commits)), "keep_worktree": bool(getattr(a, "keep_worktree", False)),
              "claude_pid": int(os.environ["CLAUDE_PID"]) if (os.environ.get("CLAUDE_PID") or "").isdigit() else None,
              "session": os.environ.get("CLAUDE_CODE_SESSION_ID") or None,
              "base": git(repo, "rev-parse", main_ref).strip(), "host": os.uname().nodename}
    if host_role() == "sync":  # PHASE 2: the change goes to ci-runner's queue -- its ref first, then the submission
        e = {**fields, "id": f"{dt.datetime.now().strftime('%Y%m%d-%H%M%S')}-{os.path.basename(repo)}-"
                             f"{os.urandom(3).hex()}"}
        if not submit_ref(repo, d, e, remote=True):
            print(f"NOT LANDED: could not push the change to refs/heads/land/{e['id']} (ci-runner checks it from there): "
                  "`agentctl env --check`, then land again")
            return 1
        r = submit_remote(Store(), e)
        if r.get("outbox"):
            print(f"QUEUED-LOCAL {e['id']} ({head[:10]}): the store is unreachable ({r['outbox']}); the sync submits it "
                  "when it answers. LANDED / WAITING / NOT LANDED goes to `agentctl inbox`", flush=True)
            return 0
        ahead = r.get("ahead") or 0
        print(f"QUEUED {r['id']} ({head[:10]}{f', {ahead} ahead' if ahead > 0 else ''}): its checks run on ci-runner; "
              "LANDED / WAITING / NOT LANDED goes to `agentctl inbox`", flush=True)
        return 0
    e, ahead = queue_change(d, fields)
    submit_ref(repo, d, e)
    print(f"QUEUED {e['id']} ({head[:10]}{f', {ahead} ahead' if ahead > 0 else ''}): its checks run in the background; "
          "LANDED / WAITING / NOT LANDED goes to `agentctl inbox`", flush=True)
    spawn_waiting_processor(repo)
    offer_token(repo)
    return 0


# CHECK SLOTS AND A CHANGE'S CHECK ARE LEASES (design §6, §7.1; phase 1 step 4): `slot/check/<repo>/<i>` (one per
# check tree) and `check/<entry>` (its checker), TTL CHECK_LEASE_TTL renewed on the check's real progress
# (run_watched's output and CPU; a remote check's run status), max hold CHECK_LEASE_MAX. A checker that stops
# progressing loses both: the slot frees, and the entry's next checker adopts its remote run. No lock files.
CHECK_LEASE_TTL = 10 * 60
CHECK_LEASE_MAX = 3 * 3600


def check_tree_slot(repo, d):
    """(index, LeaseHold) of a free check tree slot, or None when all QUEUE_POOL are busy."""
    n = int(env_num("AGENTCTL_CHECK_TREES", QUEUE_POOL))
    key = os.path.basename(d.rstrip("/"))
    for i in range(1, n + 1):
        if lock_held(os.path.join(d, f"check-tree-{i}.lock")):  # MIGRATION ONLY: a checker from before step 4 (its flock);
            continue  # never two checkers in one tree across the deploy. Deleted in step 6 with the checkers.
        h = LeaseHold(f"slot/check/{key}/{i}", env_num("AGENTCTL_CHECK_LEASE_TTL", CHECK_LEASE_TTL), CHECK_LEASE_MAX)
        if h.acquire():
            return i, h
    return None


def checker_lease(eid):
    return LeaseHold(f"check/{eid}", env_num("AGENTCTL_CHECK_LEASE_TTL", CHECK_LEASE_TTL), CHECK_LEASE_MAX,
                     meta={"entry": eid})


def checker_alive(eid):
    """The live checker lease of entry eid (meta: its pid), or None."""
    return lease_live(f"check/{eid}")


def check_tree(repo, i, sha):
    """The detached worktree <clone>-wt-check-<i> at sha (kept between checks: its build stays warm)."""
    _d, clone, _w = waiting_state(repo)
    tree = mark_internal(f"{clone}-wt-check-{i}")
    if not os.path.isdir(tree):
        git(repo, "worktree", "prune", check=False)
        git(repo, "worktree", "add", "-q", "--detach", mark_internal(tree), sha)
        seed = os.path.join(tree, "scripts", "sbt-warm")
        if os.access(seed, os.X_OK):  # a cold tree's first compile seeded from the shared build cache, not from scratch
            try:
                subprocess.run([seed, "--seed"], cwd=tree, capture_output=True, text=True, timeout=600, env=tool_env())
            except subprocess.TimeoutExpired:
                err(f"sbt-warm --seed in {tree} took over 10 min")
    else:
        git(tree, "reset", "-q", "--hard", check=False)
        git(tree, "clean", "-qfd", "-e", "target/", check=False)
        git(tree, "checkout", "-q", "--force", "--detach", sha)
    return tree


def entry_owned(eid):
    return Owned("check", eid, ["waiting", "check", eid])


# THE TICK DRIVES CHANGES (design §5.1, phase 1 step 6). A change item's state is written ONLY by set_change: the store
# item (a transition, with its event) and the entry's mirrored `status` (which the batch code still reads until step
# 8). The executor (`waiting check <id>`, holding check/<entry>) takes a change from queued to checking and, by its
# verdict, to checked, rejected (a test failure, a conflict) or back to queued (infra: never a rejection). The tick
# (tick_changes, every processor cycle) starts executors, re-queues a change whose checker lost its lease, and pushes a
# checked change under the landing lease: pushing -> landed, or back to checked (a push never rejects; after 3
# failures a condition on the git route). Main moving with an overlap is a new round (queued), never an attempt.
ENTRY_STATUS = {"queued": "queued", "checking": "checking", "checked": "checked", "pushing": "pushing",
                "waiting": "joined", "landed": "landed", "rejected": "rejected", "superseded": "superseded",
                "cancelled": "cancelled"}
PUSH_ATTEMPTS_MAX = 3


def set_change(d, e, to, data=None, event=None, store=None, **fields):
    """THE writer of a change's state: its item (transition + event) and its entry's status, together."""
    st = store or Store()
    cur = st.put_item("change", e["id"], ENTRY_STATE.get(e.get("status"), "queued"),
                      {"worktree": e.get("worktree"), "head": e.get("head")})
    try:
        if not machine_state("change", cur["state"]).terminal:
            st.transition("change", e["id"], to, cur["version"], data=data, event=event)
    except StaleVersion:  # another writer moved it: re-read once
        cur = st.item("change", e["id"])
        if not machine_state("change", cur["state"]).terminal:
            st.transition("change", e["id"], to, cur["version"], data=data, event=event)
    e.update(status=ENTRY_STATUS[to], **fields)
    save_entry(d, e)


def queue_verdict(d, e, status, verdict, tail=(), code=1, **fields):
    """A change's final verdict: its state (set_change), whose event the projector makes its author's inbox entry."""
    set_change(d, e, {"joined": "waiting"}.get(status, status), event=change_event(e, verdict, tail, code),
               decided=ts(), why=verdict, **fields)
    wlog(d, f"{e['id']}: {verdict.splitlines()[0]}")


def rebase_in_tree(d, tree, e, base):
    """The entry's commits on base, in the tree: (head, None); (None, None) on a conflict (aborted); (None, via) when
    every commit is on base already (dropped: LANDED via that commit, never an empty push)."""
    git(tree, "checkout", "-q", "--force", "--detach", base)
    how, x = apply_entry(d, tree, e, base)
    if how == "conflict":
        return None, None
    if how in ("landed", "duplicate"):
        return None, x or "an equivalent commit"
    return git(tree, "rev-parse", "HEAD").strip(), None


def check_entry(repo, eid):
    """THE EXECUTOR of one change's checks (`waiting check <id>`, detached): holding check/<entry> and a check tree slot
    (leases), it takes the change to checking and leaves it checked (with the tip and base it passed on), rejected (a
    test failure, a conflict) or queued again (infra). It never pushes: the tick does (push_change)."""
    d, _c, _w = waiting_state(repo)
    lease = checker_lease(eid)
    if not lease.acquire():  # another checker holds it (and progresses)
        return 0
    own = entry_owned(eid)
    if not own.acquire():
        lease.release()
        return 0
    try:
        e = read_record(os.path.join(d, "entries", f"{eid}.json"))
        if not e or e.get("status") not in ("queued", "checking"):
            return 0
        slot = check_tree_slot(repo, d)
        if not slot:  # all trees busy: it stays queued, the tick starts it again when one frees
            return 0
        i, slot_h = slot
        try:
            return _check_entry(repo, d, e, i, own)
        finally:
            slot_h.release()
    finally:
        own.release()
        lease.release()


def _check_entry(repo, d, e, i, own=None):
    hook = precheck_hook(repo)
    log_path = os.path.join(d, f"check-{e['id']}")
    if e.get("status") != "checking":
        set_change(d, e, "checking", event={"text": f"{e['id']}: checking"}, since=ts())
    git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
    if not git_ok(repo, "rev-parse", "--verify", "-q", f"{REMOTE}/main"):
        return 0 if requeue_infra(d, e, "its fetch of main failed") else 1
    base = git(repo, "rev-parse", f"{REMOTE}/main").strip()
    if not git_ok(repo, "cat-file", "-e", f"{e['head']}^{{commit}}"):  # phase 2: the change is on Forgejo, as land/<id>
        git(repo, "fetch", "--quiet", REMOTE, f"refs/heads/land/{e['id']}", check=False)
        if not git_ok(repo, "cat-file", "-e", f"{e['head']}^{{commit}}"):
            return 0 if requeue_infra(d, e, f"its commits are not here and refs/heads/land/{e['id']} gave none") else 1
    rem = e.get("remote") or {}
    adopt = (rem.get("head") == e["head"] and rem.get("base") == base and not rem.get("collected_at")
             and rem.get("status") not in ("cancelled", "skipped", "abandoned")
             and git_ok(repo, "cat-file", "-e", f"{rem.get('tip')}^{{commit}}"))
    if adopt:  # a replacement checker (the last one lost its lease, died or re-exec'd mid-wait): the same tip, its run
        tree = check_tree(repo, i, rem["tip"])
        head, via = rem["tip"], None
    else:
        if rem.get("run") is not None and not rem.get("status"):
            cancel_entry_remote(e, "superseded by a new round of its checks")
        e.pop("remote", None)
        e.pop("remote_run", None)
        e["round_since"] = ts()
        save_entry(d, e)
        tree = check_tree(repo, i, base)
        head, via = rebase_in_tree(d, tree, e, base)
    if via:
        already_landed(d, e, via if via != "an equivalent commit" else None)
        return 0
    if not head:
        queue_verdict(d, e, "rejected", f"NOT LANDED: the change no longer applies on {REMOTE}/main {base[:10]} "
                      f"(main moved since QUEUED): rebase onto forgejo/main and land again")
        return 1
    e["tip"] = head
    save_entry(d, e)
    reds = gate_reds(repo) if waiting_supported(repo) else set()
    commits = waiting_commits(tree, base, head)
    joining = bool(reds) and must_wait(repo, commits, reds)
    cls = gov_class_of(repo, commits, reds)
    mode = "--checks-only" if joining else "--range"
    where = "no hook"
    if hook:
        ok, out, where = run_entry_checks(repo, d, e, tree, base, head, mode, cls, log_path, own)
        if ok is None:  # stalled: the laptop's, not the change's
            return 0 if requeue_infra(d, e, f"its checks stalled ({where})") else 1
        if not ok and INFRA_CHECK_FAILURE.search(out or ""):
            return 0 if requeue_infra(d, e, f"its checks failed on the laptop, not on the change "
                                           f"({INFRA_CHECK_FAILURE.search(out).group(0)})") else 1
        if not ok:
            queue_verdict(d, e, "rejected", f"NOT LANDED: the pre-push checks failed ({where}); the change "
                          f"{e['head'][:10]} stays in {e['worktree']}", (out or "").splitlines())
            return 1
    set_change(d, e, "checked", data={"tip": head, "base": base, "mode": mode, "where": where},
               event={"text": f"{e['id']}: checked {head[:10]} on {base[:10]} ({where})"},
               tip=head, checked_base=base, checked_mode=mode, checked_where=where, tree=i)
    wlog(d, f"{e['id']}: checked {head[:10]} on {base[:10]} ({where})")
    return 0


def push_change(repo, d, e):
    """The tick's push of one checked change, under the landing lease: rebased onto a moved main (re-checked when what
    landed overlaps: a new round, queued), joined to `waiting` while main is red and it must wait, else pushed with
    the push's bounds and verified. pushing -> landed, or back to checked (a push never rejects); after
    PUSH_ATTEMPTS_MAX failures a condition on the git route, and it waits for it."""
    hook = precheck_hook(repo)
    log_path = os.path.join(d, f"check-{e['id']}")
    tree = check_tree_for_push(repo, e)
    with land_lock(repo) as held:
        if not held:
            return "busy"
        now_ = read_record(os.path.join(d, "entries", f"{e['id']}.json")) or {}
        if now_.get("status") != "checked":  # superseded / cancelled since its checks: no push
            return now_.get("status")
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
        moved = git(repo, "rev-parse", f"{REMOTE}/main").strip()
        base, head, where, skip = e["checked_base"], e["tip"], e.get("checked_where") or "", None
        if moved != base:
            new_head, via = rebase_in_tree(d, tree, e, moved)
            if via:
                already_landed(d, e, via if via != "an equivalent commit" else None)
                return "landed"
            if not new_head:
                queue_verdict(d, e, "rejected", f"NOT LANDED: the change no longer applies on {REMOTE}/main "
                              f"{moved[:10]} (main moved during its checks): rebase onto forgejo/main and land again")
                return "rejected"
            tree_hook = precheck_hook(tree) if hook else None
            mine = range_paths(tree, moved, new_head)
            n, why = recheck_reason(tree_hook, tree, base, moved, mine)
            if why is None and tree_hook:
                skip = hook_query(tree_hook, tree, "--plan", mine)
                if skip is None:
                    why = "the hook's plan could not be read"
            moved_by = f"main moved by {n} commit{'' if n == 1 else 's'}"
            if why is not None:  # a new round, not an attempt
                set_change(d, e, "queued", data={"rounds": e.get("rounds", 0) + 1},
                           event={"text": f"{e['id']}: {moved_by} since its checks, {why}: checked again"},
                           rounds=e.get("rounds", 0) + 1, retry_after=0)
                wlog(d, f"{e['id']}: {moved_by} during its checks, {why}: queued for a new round")
                return "queued"
            note = f"{moved_by}, no overlap: pushed without re-check"
            wlog(d, f"{e['id']}: {note}")
            where = f"{where}; {note}"
            e.pop("remote_run", None)
            base, head, e["tip"] = moved, new_head, new_head
        commits = waiting_commits(tree, base, head)
        reds = gate_reds(repo) if waiting_supported(repo) else set()
        if reds and must_wait(repo, commits, reds):
            return "joined" if queue_join(repo, d, e, tree, head) == 0 else "rejected"
        fixes = sorted(fixes_of(repo, commits))
        set_change(d, e, "pushing", event={"text": f"{e['id']}: pushing {head[:10]}"})
        pushed_at = time.time()
        env = tool_env()
        if e.get("remote_run"):  # the hook takes ci-runner's pass once Forgejo confirms it (remote checks)
            env["PREPUSH_REMOTE_RUN"] = str(e["remote_run"])
        if skip:  # checked on the old base, no overlap with what landed since: the hook judges the red gate only
            env["PREPUSH_SKIP"] = " ".join(skip)
        rc, out = run_watched(push_argv(REMOTE, head), tree, env, log_path, "push", **push_bounds())
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
        if landed(repo, head, f"refs/remotes/{REMOTE}/main"):  # verify: the tip is on main, whatever rc said
            mark_gate_dirty()
            queue_verdict(d, e, "landed", f"LANDED {head} (queued {e['id']}, checked {where})", code=0,
                          landed_sha=head, pushed_at=pushed_at)
            close = None if e.get("keep_worktree") else e["worktree"]
            start_watch(repo, head, pushed_at, worktree=e["worktree"],
                        close=close if close and os.path.isdir(close) else None, session=e.get("session"))
            return "landed"
        if rc is not None and (RACE.search(out or "") or REDGATE.search(out or "")):
            set_change(d, e, "checked", event={"text": f"{e['id']}: the push raced or met a red gate: tried again"})
            return "checked"
        n = e.get("push_attempts", 0) + 1
        why = "the push stalled" if rc is None else ((TRANSIENT_PUSH.search(out or "") or [None])[0]
                                                     or f"the push failed (exit {rc})")
        set_change(d, e, "checked", data={"push_attempts": n},
                   event={"text": f"{e['id']}: {why}: push attempt {n}", "severity": "escalate" if n >= PUSH_ATTEMPTS_MAX else "info",
                          "audience": {"worktree": e.get("worktree")}},
                   push_attempts=n, retry_after=time.time() + min(60 * 2 ** n, 1800))
        wlog(d, f"{e['id']}: {why} (push attempt {n}); its tail: {tail_of(out or '')[:300]}")
        if n >= PUSH_ATTEMPTS_MAX:
            open_condition("STALLED", f"STALLED: the push of {e['id']} failed {n} times ({why}); it is tried again when "
                                      f"git can read {REMOTE}/main", run_probe("git_fetch", {"repo": repo}), [],
                           key=f"push-failing-{e['id']}", command="land", cwd=e.get("worktree"),
                           tail=(out or "").splitlines()[-15:])
        return "checked"


def check_tree_for_push(repo, e):
    """The tree the change was checked in (its tip is there), else a fresh check tree at its tip."""
    _d, clone, _w = waiting_state(repo)
    i = e.get("tree") or 1
    tree = f"{clone}-wt-check-{i}"
    if not os.path.isdir(tree) or not git_ok(tree, "cat-file", "-e", f"{e['tip']}^{{commit}}"):
        tree = check_tree(repo, i, e["tip"])
    git(tree, "checkout", "-q", "--force", "--detach", e["tip"], check=False)
    return tree


def tick_changes(repo, d, now_=None):
    """One tick over the change items: re-queueing re-derived (only the newest entry per worktree and branch runs), an
    executor started for each queued or lease-less checking change (red fixes first, while a slot is free), a
    checking change past its deadline back to queued (infra), a queued one past its deadline escalated, and each
    checked change pushed. Returns what it did."""
    t = now_ if now_ is not None else time.time()
    st = Store()
    try:
        reds = gate_reds(repo)
    except Exception:
        reds = set()
    todo = sorted(queued_entries(d), key=lambda e: (0 if reds and set(e.get("fixes") or []) & reds else 1, e["seq"]))
    newest = {}
    for e in sorted(todo, key=lambda e: e["seq"]):  # entries queued before re-queueing replaced: the newest one runs
        for k, older in list(newest.items()):
            if same_change_source(older, e["worktree"], e.get("branch") or ""):
                supersede(d, older, e["id"], f"{e['worktree']} queued again; only the newest entry runs")
                del newest[k]
        newest[e["id"]] = e
    did = []
    for e in [e for e in todo if e["id"] in newest]:
        it = st.put_item("change", e["id"], ENTRY_STATE.get(e["status"], "queued"),
                         {"worktree": e.get("worktree"), "head": e.get("head")})
        state = it["state"]
        if state == "pushing":  # a tick that died mid-push: verified next, never pushed twice blindly
            set_change(d, e, "checked", event={"text": f"{e['id']}: its push was interrupted: verified, then tried again"})
            state = "checked"
        if state == "checked":
            if e.get("retry_after", 0) > t:
                continue
            did.append(f"{e['id']}: {push_change(repo, d, e)}")
            continue
        alive = checker_alive(e["id"])
        if state == "checking" and not alive and t > it["deadline"]:
            requeue_infra(d, e, "its check passed its deadline with no live checker")
            did.append(f"{e['id']}: re-queued (checking past its deadline)")
            continue
        if state == "queued" and t > it["deadline"]:  # waits past its deadline: said, re-deadlined (an escalation)
            st.transition("change", e["id"], "queued", it["version"],
                          event={"text": f"{e['id']}: queued for {fmt_age(t - it['entered_at'])}, waiting on "
                                         f"{e.get('waiting_on') or 'a check slot' if not e.get('retry_after', 0) > t else 'its retry'}",
                                 "audience": {"worktree": e.get("worktree")}})
        if alive or e.get("retry_after", 0) > t:
            continue
        slot = check_tree_slot(repo, d)
        if not slot:
            continue
        slot[1].release()  # the executor takes it again itself
        spawn_executor(repo, d, e["id"])
        did.append(f"{e['id']}: executor started")
    return did


def spawn_executor(repo, d, eid):
    """`agentctl waiting check <eid>`, detached: the change's checks (check_entry)."""
    with open(os.path.join(d, "processor.log"), "a") as logf:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "waiting", "check", eid, "--repo", repo],
                         stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, start_new_session=True, cwd=repo,
                         env=detached_env(repo))
    time.sleep(1)  # it takes its tree slot before the next looks


def queue_join(repo, d, e, tree, head):
    """Under the landing lock, main red: the checked change joins `waiting` (land's join, from the check tree)."""
    a = argparse.Namespace(follow=False)
    out = io.StringIO()
    with contextlib.redirect_stdout(out):
        rc = join(repo, f"refs/remotes/{REMOTE}/main", lambda *x: subprocess.run(x, cwd=tree, capture_output=True,
                                                                                  text=True, env=tool_env()),
                  os.path.join(d, f"check-{e['id']}"), a, head=head, worktree=e["worktree"],
                  branch=e.get("branch") or "")
    line = (out.getvalue().strip().splitlines() or [""])[-1]
    if rc == 0:
        set_change(d, e, "waiting", event=change_event(e, line, code=None, final=False), decided=ts(),
                   waiting_id=a.waiting["id"])
        wlog(d, f"{e['id']}: {line}")
        return 0
    queue_verdict(d, e, "rejected", line or "NOT LANDED: could not join `waiting`")
    return 1


def run_entry_checks(repo, d, e, tree, base, head, mode, cls, log_path, own=None):
    """(ok, output, where) of the change's checks: on ci-runner when the governor reports pressure (and the repo has the
    remote check workflow), else in the tree, admitted by the governor. ok None: stalled."""
    adopted = remote_matches(e, base, head, mode)
    why = "its remote run, adopted" if adopted else \
        "the reconciler on ci-runner checks on the CI tier (owner decision 1)" if host_role() == "server" else \
        gov_pressure() if os.environ.get("AGENTCTL_REMOTE_CHECKS", "1") != "0" else None
    if why and (adopted or remote_checks_supported(tree)):
        wlog(d, f"{e['id']}: the laptop is under pressure ({why}): checks on ci-runner")
        ok, out = remote_check(repo, e, base, head, mode, own)
        if ok is not None:
            return ok, out, f"on ci-runner ({why})"
        wlog(d, f"{e['id']}: the remote check gave no verdict ({out.splitlines()[-1] if out else '?'}): checking here")
    # the range through the remote's ref (forgejo/main is `base` now, fetched just before): the hook finds the remote, and
    # with it Forgejo's red gate, from it -- given bare shas it fell back to gh (GitHub, suspended): the gate unread
    rng = f"{REMOTE}/main..{head}" if git(tree, "rev-parse", f"{REMOTE}/main").strip() == base else f"{base}..{head}"
    e["waiting_on"] = "the governor (a check slot)"
    save_entry(d, e)
    try:
        with check_slot(repo, f"queued {e['id']} {head[:10]}", cls) as slot:
            e["waiting_on"] = None
            save_entry(d, e)
            rc, out = run_watched([os.path.join(tree, "scripts", "hooks", "pre-push"), mode, rng], tree,
                                  slot.env(tool_env()), log_path, "checks", sampler=slot.sample)
            slot.done(rc, out)
    except GovTimeout as ex:  # an infra failure of the laptop, re-queued by the caller (INFRA_CHECK_FAILURE)
        return False, f"TIMEOUT 0s {ex}", "locally (never admitted)"
    with open(os.path.join(d, "checks.log"), "a") as f:
        f.write(f"=== {ts()} {e['id']} {base[:10]}..{head[:10]} {mode} rc {rc}\n{out}\n")
    return (None if rc is None else rc == 0), out, f"locally, check tree {os.path.basename(tree)}"


# ---------------------------------------------------------------- remote checks: ci-runner's check tier under pressure
# The owner (2026-10-27): when the governor reports memory or CPU pressure (gov_pressure), a queued change's pre-commit
# checks run on ci-runner's check tier instead. The checked tip is pushed to `check/<entry id>` (the hook checks nothing
# for a check/ branch: it is a run's ref, never landed), whose push runs .github/workflows/precommit-check.yml: the same
# hook, `--checks-only <merge-base with main>..HEAD`, on the check tier's runner. agentctl follows that run (owned: the run
# is cancelled if the checker dies), reads the verdict -- the same (ok, output) shape as a local check, the failed jobs'
# relevant lines as output -- and deletes the branch. The push to main then carries PREPUSH_REMOTE_RUN=<run id>: the hook
# takes that run's pass for its checks only after Forgejo confirms it (the workflow, success, the pushed commit itself).
REMOTE_WORKFLOW = "precommit-check.yml"
REMOTE_TIMEOUT = 2 * 3600
REMOTE_START = 15 * 60  # no run for the pushed branch by then: no verdict (checked locally instead)


def remote_checks_supported(tree):
    return os.path.exists(os.path.join(tree, ".github", "workflows", REMOTE_WORKFLOW))


REMOTE_EXPECTED_MIN = 30  # a check's expected duration ($AGENTCTL_CHECK_EXPECTED_MIN): an entry checking 2x that is re-examined
REMOTE_COLLECT_GRACE = 300  # a run decided this long ago and still uncollected: its checker is stranded, stopped, replaced


class Terminated(SystemExit):
    """A signal's exit (Owned's handler): never swallowed by a wait loop that rides out a token or tunnel outage."""


def remote_matches(e, base, head, mode):
    """The entry's recorded remote check, when it is the check of exactly this tip on this base in this mode."""
    rem = e.get("remote") or {}
    if rem.get("tip") == head and rem.get("base") == base and rem.get("mode") == mode and rem.get("head") == e.get("head") \
            and rem.get("status") not in ("cancelled", "skipped", "abandoned"):
        return rem
    return None


def remote_poll(o_r, rem):
    """STATELESS: the remote check's state from Forgejo alone -- the run (found by its check/ branch and tip when its id
    is not known yet), its status, and for a decided run the verdict. Returns the updated record (a copy); raises when
    Forgejo cannot be read."""
    rem = dict(rem)
    if rem.get("run") is None:
        runs = (api(o_r, "GET", "actions/runs", {"workflow_id": REMOTE_WORKFLOW, "limit": 50})
                or {}).get("workflow_runs") or []
        hit = next((x for x in runs if x.get("commit_sha") == rem["tip"]
                    and x.get("prettyref") in (rem["branch"], f"refs/heads/{rem['branch']}")), None)
        if not hit:
            return rem
        rem["run"] = hit["id"]
    run = api(o_r, "GET", f"actions/runs/{rem['run']}") or {}
    status = run.get("status")
    rem["run_status"] = status
    if status in ("success", "failure", "cancelled", "skipped") and not rem.get("status"):
        rem["status"], rem["decided_at"] = status, time.time()
        name = f"{REMOTE_WORKFLOW} run {rem['run']} (#{run.get('index_in_repo')})"
        if status == "success":
            rem["out"] = f"{name}: success"
        elif status == "failure":
            out = [f"{name} failed: {run.get('html_url')}"]
            try:
                for job, ls in relevant_lines(fetch_failed_log(o_r, rem["run"]), 25).items():
                    out += [f"-- {job}"] + ls
            except Exception as ex:
                out.append(f"(its failed log could not be read: {str(ex)[:120]})")
            rem["out"] = "\n".join(out)
        else:
            rem["out"] = f"{REMOTE_WORKFLOW} run {rem['run']} {status}"
    return rem


def save_remote(d, e, rem):
    """The remote check's record in the entry, saved at once (a replacement checker adopts it); `remote_run` mirrors the
    run for the push's hook and `waiting status`."""
    e["remote"] = rem
    if rem.get("run") is not None:
        e["remote_run"] = rem["run"]
    else:
        e.pop("remote_run", None)
    if d and e.get("seq") is not None:
        save_entry(d, e)


def delete_check_branch(o_r, branch):
    try:
        api(o_r, "DELETE", f"branches/{urllib.parse.quote(branch, safe='')}")
    except Exception as ex:
        err(f"could not delete {branch} ({str(ex)[:120]}): `agentctl sweep` lists it")


def remote_check(repo, e, base, head, mode, own=None):
    """(ok, output) of the change's checks on ci-runner; ok None when no verdict came (the caller checks locally).
    The run belongs to the ENTRY, not to this process: its record (`remote` in the entry) is saved the moment the branch is
    pushed and again when the run is found, so a checker that dies or is replaced mid-wait strands nothing -- the next one
    ADOPTS the run (no new push, no new run) and the processor re-derives its state from Forgejo every cycle. Its time
    bounds count from the push, not from this process's start."""
    o_r = slug(repo)
    try:
        d = waiting_state(repo)[0]
    except (Exception, SystemExit):
        d = None
    rem = remote_matches(e, base, head, mode)
    if rem and d:
        wlog(d, f"{e['id']}: adopting its remote check (run {rem.get('run') or 'not found yet'}, pushed "
                f"{int((time.time() - rem['pushed_at']) // 60)} min ago)")
    if not rem:
        branch = f"check/{e['id']}"
        r = git(repo, "push", "--quiet", "--force", REMOTE, f"{head}:refs/heads/{branch}", check=False)
        if r.returncode != 0:
            return None, f"push of {branch} failed: {r.stderr.strip()[:300]}"
        rem = {"branch": branch, "head": e.get("head"), "base": base, "tip": head, "mode": mode, "run": None,
               "pushed_at": time.time(), "status": None}
        save_remote(d, e, rem)
        try:
            record_dispatch(branch=branch, workflow=REMOTE_WORKFLOW, worktree=e.get("worktree"), sha=head,
                            agent="land queue", pid=os.getpid(), purpose=f"pre-commit check of queue entry {e['id']}")
        except (Exception, SystemExit) as ex:
            err(f"remote check of {e['id']}: owner not recorded ({str(ex)[:120]})")
    delays = backoff(15, 120)
    while True:
        try:
            new = remote_poll(o_r, rem)
            if new.get("run") is not None and rem.get("run") is None:
                try:
                    save_dispatch({"branch": rem["branch"], "run_id": new["run"]})
                except OSError:
                    pass
            if new != rem:
                rem = new
                save_remote(d, e, rem)
        except Terminated:
            raise
        except (Exception, SystemExit) as ex:  # Forgejo down for a while: keep reading until the bound
            err(f"remote check of {e['id']}: {str(ex)[:160]}")
        try:  # the CI run is the check's work: its status (and, while it runs, the minute) is the progress mark
            lock_beat(f"remote:{rem.get('run')}:{rem.get('status') or rem.get('run_status') or 'pending'}:"
                      f"{int(time.time() // 60)}")
        except LeaseLost as ex:
            err(f"remote check of {e['id']}: {ex}; a new checker adopts its run")
            return None, str(ex)
        if rem.get("status"):
            rem["collected_at"] = time.time()
            save_remote(d, e, rem)
            delete_check_branch(o_r, rem["branch"])
            if rem["status"] in ("success", "failure"):
                return rem["status"] == "success", rem["out"]
            return None, rem["out"]
        age = time.time() - rem["pushed_at"]
        if rem.get("run") is None and age > REMOTE_START:
            rem.update(status="abandoned", collected_at=time.time())
            save_remote(d, e, rem)
            delete_check_branch(o_r, rem["branch"])
            return None, f"no {REMOTE_WORKFLOW} run started for {rem['branch']} in {REMOTE_START // 60} min"
        if age > REMOTE_TIMEOUT:
            cancel_run(o_r, rem["run"], "the remote check timed out")
            rem.update(status="abandoned", collected_at=time.time())
            save_remote(d, e, rem)
            delete_check_branch(o_r, rem["branch"])
            return None, f"{REMOTE_WORKFLOW} run {rem['run']} undecided after {REMOTE_TIMEOUT // 3600} h"
        time.sleep(next(delays))


def cancel_entry_remote(e, why):
    """An entry that ends (superseded, cancelled) takes its undecided remote run with it: the run is the entry's."""
    rem = e.get("remote") or {}
    if rem.get("run") is not None and not rem.get("status"):
        try:
            cancel_run(slug(e["worktree"]) if os.path.isdir(e.get("worktree") or "") else SHORT["movies"], rem["run"], why)
        except (Exception, SystemExit) as ex:
            err(f"could not cancel run {rem['run']} of {e['id']}: {str(ex)[:120]}")


def processor_owned(d, repo=None):
    """The processor's ownership: one per waiting state directory (one per repository)."""
    return Owned("waiting", os.path.basename(d.rstrip("/")) or "repo", ["waiting", "run", "--repo", repo or ""])


def waiting_processor_alive(d):
    return lock_held(processor_owned(d).lockpath)


def spawn_waiting_processor(repo):
    d, clone, _w = waiting_state(repo)
    if waiting_processor_alive(d):
        return
    repo = clone if os.path.isdir(clone) else repo  # the clone, not a joiner's worktree: that one closes after WATCH OK
    with open(os.path.join(d, "processor.log"), "a") as logf:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "waiting", "run", "--repo", repo],
                         stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, start_new_session=True, cwd=repo,
                         env=detached_env(repo))


# THE TOKEN HAND-OFF. The processor as a launchd service, or detached once its land exits, gets no answer from the vault
# (an unlock belongs to the session that made it). So it listens on a unix socket (0600, in a 0700 directory) and a
# process that can read the vault -- every `land` that joins `waiting`, and `waiting status` / `resume` -- hands it the
# token. It lives only in the processor's memory and environment (a re-exec keeps it; the push's hook and the watches it
# starts inherit it), never on disk. Until it has one, the gate is unread: taken as red, said once in the inbox.
def token_sock_path(d):
    import hashlib
    base = os.environ.get("AGENTCTL_SOCK_DIR") or f"/tmp/agentctl-{os.getuid()}"  # short: a socket path is <= 104 bytes
    return os.path.join(base, hashlib.sha1(os.path.abspath(d).encode()).hexdigest()[:12] + ".sock")


TOKEN_SHAPE = re.compile(r"[\w.~+/=-]{8,512}")
TOKEN_REQUEST = b"?token\n"  # a client asking the processor for its token (not shaped like one)


class TokenDrop:
    """The processor's end of the hand-off."""

    def __init__(self, d, o_r):
        self.path, self.o_r, self.sock = token_sock_path(d), o_r, None

    def open(self):
        import socket
        try:
            os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
            os.chmod(os.path.dirname(self.path), 0o700)
            if os.path.exists(self.path):
                os.unlink(self.path)
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            old = os.umask(0o177)
            try:
                s.bind(self.path)
            finally:
                os.umask(old)
            s.listen(4)
            self.sock = s
            import threading  # served on a thread of its own: no step of the main loop can leave a client waiting
            threading.Thread(target=self.serve, name="token-socket", daemon=True).start()
        except OSError as e:
            err(f"no token hand-off socket ({e}): the processor reads the vault itself")
        return self

    def held(self):
        return os.environ.get("FORGEJO_API_TOKEN" if token_ns(self.o_r) == "movies" else "GH_TOKEN", "")

    def serve(self):
        import select
        while self.sock:
            try:
                ready, _, _ = select.select([self.sock], [], [], 1)
                if ready and self.sock:
                    self.take()
            except (OSError, ValueError):
                return

    def nap(self, secs):
        """Sleep secs (the socket is served by its own thread)."""
        end = time.time() + secs
        while True:
            left = end - time.time()
            if left <= 0:
                return
            time.sleep(min(left, 10))

    def take(self):
        try:
            conn, _ = self.sock.accept()
        except OSError:
            return
        with conn:
            conn.settimeout(5)
            try:
                tok = conn.recv(4096).decode().strip()
                if tok == TOKEN_REQUEST.decode().strip():  # a same-uid process (the socket is 0600) asks for the token
                    conn.sendall(self.held().encode())
                    return
            except (OSError, UnicodeDecodeError):
                return
            if TOKEN_SHAPE.fullmatch(tok):
                os.environ["FORGEJO_API_TOKEN" if token_ns(self.o_r) == "movies" else "GH_TOKEN"] = tok
                err("the Forgejo token was handed over: the gate is read again")

    def close(self):
        if self.sock:
            sock, self.sock = self.sock, None
            sock.close()
            try:
                os.unlink(self.path)
            except OSError:
                pass


def offer_token(repo):
    """Hand this process's Forgejo token to the repo's waiting processor when it listens (see THE TOKEN HAND-OFF). Never
    fatal; True when handed over."""
    import socket
    try:
        d, _c, _w = waiting_state(repo)
        path = token_sock_path(d)
        if not os.path.exists(path):
            return False
        tok = token(slug(repo))
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(3)
            s.connect(path)
            s.sendall(tok.encode())
        return True
    except (Exception, SystemExit):
        return False


def await_entry(repo, eid, close=None):
    """Block until the entry lands or is rejected: (rc, landed sha, pushed_at). Restarts a dead processor. OWNED (one
    awaiter per entry; on agentctl's new code it re-execs as `agentctl waiting await <entry>`, which then watches)."""
    own = Owned("await", eid, ["waiting", "await", eid, "--repo", repo] + (["--close", close] if close else []))
    if not own.acquire():
        h = own.holder or {}
        print(f"NOT LANDED (still waiting): entry {eid} is already awaited by pid {h.get('pid')} ({h.get('owner')})")
        return 2, None, None
    try:
        return _await_entry(repo, eid, own)
    finally:
        own.release()


def _await_entry(repo, eid, own):
    d, _c, _w = waiting_state(repo)
    p = os.path.join(d, "entries", f"{eid}.json")
    t0, delays = time.time(), backoff(15, 60)
    timeout = float(os.environ.get("AGENTCTL_WAITING_TIMEOUT", WAITING_AWAIT_TIMEOUT))
    while True:
        with open(p) as f:
            e = json.load(f)
        if e["status"] == "landed":
            print(f"LANDED {e['landed_sha']} (with the {e.get('batch', 1)} change(s) of `{WAITING_BRANCH}`, once main was green)",
                  flush=True)
            return 0, e["landed_sha"], e.get("pushed_at")
        if e["status"] in ("rejected", "cancelled", "superseded"):  # audit S1: a superseded entry never hangs a follow
            print(f"NOT LANDED: {e.get('why') or e['status']}")
            return 1, None, None
        if time.time() - t0 > timeout:
            print(f"NOT LANDED (still waiting): entry {eid} on `{WAITING_BRANCH}` after {int(timeout // 3600)} h; "
                  "`agentctl land status`")
            return 2, None, None
        spawn_waiting_processor(repo)
        restart_if_changed([own])
        time.sleep(next(delays))


def assemble(repo, d, wt, entries, base):
    """The batch's tip in check tree wt = base + each entry's commits, in order; a conflicting entry is rejected alone,
    one already on main LANDED, a duplicate superseded. Returns the kept entries (each with its tip in the batch)."""
    git(wt, "reset", "--hard", "-q", base)
    git(wt, "checkout", "-q", "--force", "--detach", base)
    kept = []
    for e in entries:
        how, x = apply_entry(d, wt, e, base)
        if how == "conflict":
            queue_verdict(d, e, "rejected", f"NOT LANDED: main moved while it waited and the change no longer applies "
                                            f"(conflicts in: {', '.join(x)}): rebase onto forgejo/main and land again")
            continue
        if how == "landed":  # all of it reached main meanwhile: LANDED, and nothing of it is pushed again
            already_landed(d, e, x)
            continue
        if how == "duplicate":  # an earlier entry carries the very same change: that one lands it
            owner = next((k for k in kept if x and git(wt, "merge-base", "--is-ancestor", x, k["tip"],
                                                        check=False).returncode == 0), None)
            supersede(d, e, owner["id"] if owner else "an earlier entry",
                      "the same change already waits" + (f" as {owner['id']}" if owner else ""))
            continue
        e["tip"] = git(wt, "rev-parse", "HEAD").strip()  # its tip IN THE BATCH: bisect and the push read it from disk
        save_entry(d, e)
        kept.append(e)
    return kept


def sbt_stop(tree):
    """A FRESH sbt server for the batch check: stop the tree's server and keeper (scripts/sbt-warm --stop), if any."""
    script = os.path.join(tree, "scripts", "sbt-warm")
    if os.access(script, os.X_OK):
        try:
            subprocess.run([script, "--stop"], cwd=tree, capture_output=True, text=True, timeout=180, env=tool_env())
        except subprocess.TimeoutExpired:
            err(f"sbt-warm --stop in {tree} took over 3 min")


STALL_SIGNAL = re.compile(r"(^|\s)(pre-push |sbt-warm )?STALLED:", re.M)
BATCH_HOLD = 30 * 60


def batch_mode(hook):
    """The combined check's hook mode: `--fast-only` (compile of every test config and the fast tests: every change
    passed its own full checks before it joined) when the hook has it, else the full `--range` dry run."""
    try:
        with open(hook) as f:
            return "--fast-only" if "--fast-only" in f.read() else "--range"
    except OSError:
        return "--range"


def batch_check(repo, d, tree, base, tip, cls="check"):
    """The hook's dry run over base..tip in `tree` (the basic checks plus every touched area's), on a fresh sbt server,
    under the stall abort. (ok, output, stalled): a stall -- land's 20 min, or the hook's exit 75 / `STALLED:` -- is
    retried once on a fresh server; stalled twice, `stalled` is True."""
    hook = precheck_hook(tree) or precheck_hook(repo)
    if not hook:
        return True, "", False
    if host_role() == "server" and remote_checks_supported(tree):  # ci-runner: the CI check tier (owner decision 1)
        ok, out = remote_check(repo, {"id": f"batch-{tip[:10]}", "head": tip}, base, tip, batch_mode(hook))
        return (ok, out, False) if ok is not None else (False, out, True)
    out = ""
    for attempt in (1, 2):
        git(tree, "checkout", "-q", "--force", "--detach", tip)
        sbt_stop(tree)
        wlog(d, f"checking {base[:10]}..{tip[:10]} (attempt {attempt}, fresh sbt server)")
        with check_slot(repo, f"waiting batch {tip[:10]}", cls) as slot:
            rc, out = run_watched([hook, batch_mode(hook), f"{base}..{tip}"], tree, slot.env(tool_env()),
                                  os.path.join(d, f"check-{tip[:10]}"), f"batch-check-{attempt}", sampler=slot.sample)
            slot.done(rc, out)
        sbt_stop(tree)
        with open(os.path.join(d, "checks.log"), "a") as f:
            f.write(f"=== {ts()} {base[:10]}..{tip[:10]} attempt {attempt} rc {rc}\n{out}\n")
        if rc is None or rc == 75 or STALL_SIGNAL.search(out or ""):
            wlog(d, f"the check of {tip[:10]} STALLED (attempt {attempt})")
            continue
        return rc == 0, out, False
    return False, out, True


def main_clone(path):
    """The main clone a worktree belongs to (its git common dir's checkout): what a DETACHED process works from, since
    the worktree it was started for may be removed under it (2026-10-27: a watch crashed with `git rev-parse
    --show-toplevel in ~/projects/movies-wt-gate-closed: cannot change to ...` after its agent removed the worktree at
    LANDED). A path that is gone resolves by name: <clone>-wt-<name> -> <clone>."""
    if path and os.path.isdir(path):
        r = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir", check=False)
        if r.returncode == 0:
            common = os.path.realpath(r.stdout.strip())
            clone = os.path.dirname(common) if os.path.basename(common) == ".git" else common
            if os.path.isdir(clone):
                return clone
        return git(path, "rev-parse", "--show-toplevel").strip()
    m = re.match(r"^(.*?)-wt-[^/]+/?$", path or "")
    if m and os.path.isdir(m.group(1)):
        return m.group(1)
    raise RuntimeError(f"{path}: gone, and no main clone found for it")


# WATCHES FROM ITEMS (design §5.1 `landed`, phase 1 step 9): a landed sha is a `watch` item; each tick evaluates it ONCE
# (no detached process, no loop): its Main run and convergence run (pick_main_run / pick_convergence_run), WATCH OK
# -> ok (the worktree closed when proven merged), WATCH RED -> red (its author told; the red machine attaches it), still
# undecided at its 3 h deadline -> unknown, an escalation (a stuck run). The verdicts reach the author's inbox as
# events. `land --follow` keeps its in-process watch (the agent waits on purpose).
WATCH_EVERY = 60


def start_watch(repo, sha, pushed_at, worktree=None, close=None, session=None):
    """The landed sha's watch item (idempotent)."""
    o_r = slug(repo)
    if not WATCH.get(o_r):
        return None
    return Store().put_item("watch", sha, "watching", {"repo": main_clone(repo), "o_r": o_r, "pushed_at": pushed_at or time.time(),
                                                       "worktree": worktree or repo, "close": close, "session": session,
                                                       "next_at": 0})


def watch_event(it, verdict, severity="info", code=0):
    dd = it["data"]
    return {"text": verdict.splitlines()[0], "severity": severity,
            "audience": {"worktree": dd.get("worktree"), "session": dd.get("session")},
            "refs": {"verdict": verdict.splitlines()[0], "tail": verdict.splitlines()[1:25], "exit": code,
                     "command": "watch", "sha": it["id"]}}


def tick_watches(now_=None):
    """One evaluation of each due watch item. Returns what it decided."""
    t = now_ if now_ is not None else time.time()
    st = Store()
    did = []
    for it in st.items("watch", states=("watching",)):
        dd = it["data"]
        if t > it["deadline"]:
            st.transition("watch", it["id"], "unknown", it["version"],
                          event=watch_event(it, f"WATCH UNKNOWN: Main or the convergence still undecided for {it['id'][:10]} "
                                                f"after {int(WATCH_TIMEOUT // 3600)} h: a stuck run (`agentctl ci-why`)",
                                            "escalate", 2))
            did.append(f"watch {it['id'][:10]}: unknown")
            continue
        if float(dd.get("next_at") or 0) > t:
            continue
        flows = WATCH.get(dd["o_r"]) or {}
        try:
            verdict = watch_eval(dd["repo"], it["id"], dd["pushed_at"], dd["o_r"], flows, t)
        except (Exception, SystemExit) as e:  # unreadable now: tried again at the next look, the deadline bounds it
            err(f"watch {it['id'][:10]}: could not read the runs ({str(e)[:120]})")
            verdict = None
        if verdict is None:
            st.update_item("watch", it["id"], it["version"], {"next_at": t + env_num("AGENTCTL_WATCH_POLL", WATCH_EVERY)})
            continue
        state, line, red_runs = verdict
        st.transition("watch", it["id"], state, it["version"], event=watch_event(it, line, code=0 if state == "ok" else 3))
        if state == "ok" and dd.get("close") and os.path.isdir(dd["close"]):
            err(close_worktree(dd["close"]))
        for wf, n in red_runs:  # the red machine takes it, its author offered first
            try:
                red_attach(st, wf, n, author={"session": dd.get("session"), "worktree": dd.get("worktree")})
            except (Exception, SystemExit) as e:
                err(f"watch {it['id'][:10]}: could not attach {wf} #{n} ({str(e)[:120]})")
        did.append(f"watch {it['id'][:10]}: {state}")
    return did


def watch_eval(repo, sha, pushed_at, o_r, flows, now_):
    """One look at the runs that contain sha: ('ok', line), ('red', line) or None (undecided)."""
    done = {}
    conv_start = float(os.environ.get("AGENTCTL_WATCH_CONV_START", WATCH_CONV_START))
    for kind, (name, wfile) in flows.items():
        runs = gh_json(o_r, "run", "list", "--workflow", wfile, "--branch", "main", "--limit", "30", "--json", RUN_FIELDS)
        run = pick_main_run(repo, sha, runs) if kind == "main" else pick_convergence_run(repo, sha, runs, pushed_at)
        if run is None:
            if kind == "convergence" and now_ - float(pushed_at) >= conv_start:
                done[kind] = (None, None)
            continue
        if run.get("status") == "completed" and not is_cancelled(run):
            done[kind] = (run, run.get("conclusion") == "success")
    reds = [(k, r) for k, (r, ok) in done.items() if ok is False]
    if reds:
        lines = []
        for kind, r in reds:
            try:
                failed = failed_jobs(o_r, r["databaseId"])
            except (Exception, SystemExit):
                failed = []
            lines.append(f"WATCH RED: {flows[kind][0]} #{r.get('number')} {', '.join(failed) or r.get('conclusion')} "
                         f"(it contains your {sha[:10]}: if your change broke it, fix forward now with `Fixes-Red: "
                         f"{r.get('number')}`)")
        return "red", "\n".join(lines), [(flows[k][0], r.get("number")) for k, r in reds]
    if len(done) == len(flows):
        parts = [f"{flows[k][0].split()[0] if k == 'main' else 'convergence'} " +
                 (f"#{r.get('number')} green" if r else "none started") for k, (r, ok) in done.items()]
        return "ok", "WATCH OK: " + ", ".join(sorted(parts, key=lambda x: not x.startswith("Main"))) + f" ({sha[:10]})", []
    return None


def bisect(repo, d, batch, base, bwt):
    """The batch failed: the first entry whose prefix fails (binary search over the prefixes' tips, in the batch's tree
    bwt). (index, output) of the culprit; (None, output) when the whole batch passes on its own again (flaky or infra)."""
    lo, hi, out_hi = 0, len(batch) - 1, ""
    ok, out, stalled = batch_check(repo, d, bwt, base, batch[hi]["tip"])
    if ok or stalled:
        return None, out
    out_hi = out
    while lo < hi:
        mid = (lo + hi) // 2
        ok, out, stalled = batch_check(repo, d, bwt, base, batch[mid]["tip"])
        if stalled:
            return None, out
        if ok:
            lo = mid + 1
        else:
            hi, out_hi = mid, out
    # one flaky failure rejects nobody (audit #10): the culprit's prefix is checked once more before it is rejected
    ok, out, stalled = batch_check(repo, d, bwt, base, batch[lo]["tip"])
    if ok or stalled:
        wlog(d, f"bisect: the prefix through {batch[lo]['id']} passed when checked again: flaky, nobody rejected")
        return None, out
    return lo, out_hi


def unread_note(d, reds, entries):
    """The gate unread while changes wait: once per unread spell, an UNKNOWN inbox entry (they would wait unseen)."""
    if GATE_UNREAD not in reds or condition_item_of(Store(), "gate-unread-waiting"):
        return
    wlog(d, f"the gate is unread ({gate_unread_why[0]}): taken as red")
    open_condition("UNKNOWN", f"UNKNOWN: the waiting processor cannot read the gate ({gate_unread_why[0]}); {len(entries)} "
                              "change(s) wait, taken as red. Hand it the token: `~/bin/agentctl land status` from a "
                              "session with the vault unlocked",
                   run_probe("gate_read", {"since": time.time()}), [], key="gate-unread-waiting", command="waiting",
                   exit_code=2, cwd=entries[0].get("worktree") if entries else None)


# ---------------------------------------------------------------- the batch machine (design §5.2 + §14.1; step 8)
# The batch is an ITEM, not a branch: while main is red, checked changes wait (entries `waiting`); at green -- or with a
# Fixes-Red fix for the red among them -- the tick ASSEMBLES the batch in a check tree (main + each waiting change, in
# batch order: a conflict rejects that change alone, one already on main is LANDED), and the batch executor (`waiting
# check-batch <id>`, holding check/batch-<id> and the tree's slot) checks it once (--fast-only, a fresh sbt server, a
# stall retried once) and, failing, bisects it (a culprit confirmed before it is rejected). The tick pushes a passing
# batch under the landing lease (PREPUSH_REUSE_FAST) and verifies it on main: every change LANDED. A batch that fails to
# land BATCH_RETRY_MAX times, or stalls twice, is held for 30 min (its deadline), then assembled again. Every state has
# its deadline and its exit (MACHINES["batch"]); nothing loops, nothing waits on a lock.
BATCH_RETRY_MAX = 3


def batch_key(d):
    return os.path.basename(d.rstrip("/"))


def current_batch(st, d):
    """The repository's open batch item, or None."""
    key = batch_key(d)
    open_ = [it for it in st.items("batch") if it["id"].startswith(key + "#")
             and not machine_state("batch", it["state"]).terminal]
    return max(open_, key=lambda it: int(it["id"].rsplit("#", 1)[1])) if open_ else None


def new_batch(st, d, state):
    key = batch_key(d)
    n = int(st.meta_get(f"batch_seq:{key}", 0) or 0) + 1
    st.meta_set(f"batch_seq:{key}", n)
    return st.put_item("batch", f"{key}#{n}", state, {"retries": 0})


def batch_move(st, it, to, data=None, text=None, severity=None):
    ev = {"text": text or f"batch {it['id']}: {it['state']} -> {to}"}
    if severity:
        ev["severity"] = severity
    st.transition("batch", it["id"], to, it["version"], data=data, event=ev)
    return st.item("batch", it["id"])


def batch_fail(st, d, it, why, n_changes=0):
    """A batch that did not land: assembled again, or after BATCH_RETRY_MAX tries held (with a condition on the git
    route, cleared by git answering)."""
    n = int(it["data"].get("retries") or 0) + 1
    if n < env_num("AGENTCTL_BATCH_RETRY_MAX", BATCH_RETRY_MAX):
        wlog(d, f"the batch {it['id']} did not land ({why}): retry {n}/{BATCH_RETRY_MAX}")
        return batch_move(st, it, "assembling", {"retries": n})
    text = (f"HELD: the batch {it['id']} ({n_changes} change(s)) did not land {n} times ({why}); it is assembled again "
            f"when git can read {REMOTE}/main, or in 30 min")
    wlog(d, text)
    it = batch_move(st, it, "held", {"retries": 0, "why": why}, text=text, severity="escalate")
    open_condition("STALLED", text, run_probe("git_fetch", {"repo": repo_of_waiting(d)}),
                   [("clear_hold", {"d": d})], key=f"batch-retry-{it['id'].replace('#', '-')}", command="waiting")
    return it


def repo_of_waiting(d):
    return movies_repo_path()


def batch_members(d, it):
    ids = it["data"].get("members") or []
    es = {e["id"]: e for e in waiting_entries(d)}
    return [es[i] for i in ids if i in es]


def tick_batch(repo, d, now_=None):
    """One tick of the repository's batch. Returns what it did."""
    t = now_ if now_ is not None else time.time()
    st = Store()
    waiting = waiting_entries(d)
    it = current_batch(st, d)
    if not waiting and not it:
        return []
    if os.path.exists(os.path.join(d, "PAUSED")):
        return ["paused"]
    reds = gate_reds(repo)
    did = landed_meanwhile(repo, d, waiting, t) if reds else []  # at green the assembly finds them (with their commit)
    waiting = waiting_entries(d)
    if not waiting and not it:
        return did
    unread_note(d, reds, waiting)
    fix_waits = bool(reds) and any(set(e.get("fixes") or []) & reds for e in waiting)
    if not it:
        it = new_batch(st, d, "assembling" if (not reds or fix_waits) else "blocked-red")
    spec = machine_state("batch", it["state"])
    if t > it["deadline"] and it["state"] != "checking" and it["state"] != "bisecting":
        it = batch_move(st, it, spec.on_deadline, text=f"batch {it['id']}: {it['state']} past its deadline")
        return [f"batch {it['id']}: deadline -> {it['state']}"]
    state = it["state"]
    if state == "blocked-red":
        if not reds or fix_waits:
            batch_move(st, it, "assembling")
            return [f"batch {it['id']}: assembling"]
        return []
    if state == "assembling":
        if reds and not fix_waits:
            batch_move(st, it, "blocked-red")
            return [f"batch {it['id']}: blocked by the red gate"]
        order = batch_order(repo, waiting, reds)
        batch = [e for e in order if not reds or not must_wait(repo, e["commits"], reds)]
        if not batch:
            if not waiting:
                batch_move(st, it, "landed", {"members": []}, text=f"batch {it['id']}: nothing left to land")
            return []
        slot = check_tree_slot(repo, d)
        if not slot:
            return [f"batch {it['id']}: waiting for a check tree"]
        i, h = slot
        try:
            git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
            base = git(repo, "rev-parse", f"{REMOTE}/main").strip()
            tree = check_tree(repo, i, base)
            kept = assemble(repo, d, tree, batch, base)
            tip = git(tree, "rev-parse", "HEAD").strip()
        finally:
            h.release()
        if not kept:
            if not waiting_entries(d):
                batch_move(st, it, "landed", {"members": []}, text=f"batch {it['id']}: nothing left to land")
            return [f"batch {it['id']}: nothing kept"]
        batch_move(st, it, "checking", {"members": [e["id"] for e in kept], "tip": tip, "base": base, "tree": i,
                                        "cls": "red" if fix_waits else "check"},
                   text=f"batch {it['id']}: checking {len(kept)} change(s) at {tip[:10]} on {base[:10]}")
        spawn_batch_executor(repo, d, it["id"])
        return [f"batch {it['id']}: assembled {len(kept)} change(s), checking {tip[:10]}"]
    if state in ("checking", "bisecting"):
        if not lease_live(f"check/batch-{it['id']}"):
            if t > it["deadline"]:
                return [batch_fail(st, d, it, "its check passed its deadline with no live checker")["state"]]
            spawn_batch_executor(repo, d, it["id"])
            return [f"batch {it['id']}: its executor started again"]
        return []
    if state == "pushing":
        return [push_batch_item(repo, d, st, it)]
    return []


LANDED_LOOK_EVERY = 600


def landed_meanwhile(repo, d, waiting, now_):
    """§5.1's exit, for waiting changes while the batch waits on a red: one whose every commit is patch-equivalent on
    main (someone landed it meanwhile) is LANDED at once -- looked at every LANDED_LOOK_EVERY s per entry."""
    main = f"refs/remotes/{REMOTE}/main"
    did = []
    for e in waiting:
        if float(e.get("landed_look_at") or 0) > now_ - LANDED_LOOK_EVERY or not e.get("commits"):
            continue
        e["landed_look_at"] = now_
        save_entry(d, e)
        last = e["commits"][-1]
        if git_ok(repo, "merge-base", "--is-ancestor", last, main):  # pushed as it is
            already_landed(d, e, last)
            did.append(f"{e['id']}: its commits are on main: landed")
            continue
        ch = git(repo, "cherry", main, last, f"{e['commits'][0]}^", check=False)
        lines = [l for l in (ch.stdout if ch.returncode == 0 else "").splitlines() if l.strip()]
        if lines and all(l.startswith("- ") for l in lines):  # landed as an equivalent patch
            already_landed(d, e, None)
            did.append(f"{e['id']}: its commits are on main: landed")
    return did


def spawn_batch_executor(repo, d, bid):
    with open(os.path.join(d, "processor.log"), "a") as logf:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "waiting", "check-batch", bid, "--repo", repo],
                         stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, start_new_session=True, cwd=repo,
                         env=detached_env(repo))


def check_batch(repo, bid):
    """THE BATCH EXECUTOR (`waiting check-batch <id>`): holding check/batch-<id> and its tree's slot, it checks the
    assembled tip; pass -> pushing (the tick pushes); fail -> bisecting -> a confirmed culprit rejected and the passing
    prefix -> pushing (or assembling), every prefix passing -> assembling again (counted); stalled twice -> held."""
    d, _c, _w = waiting_state(repo)
    st = Store()
    it = st.item("batch", bid)
    if not it or it["state"] not in ("checking", "bisecting"):
        return 0
    lease = LeaseHold(f"check/batch-{bid}", env_num("AGENTCTL_CHECK_LEASE_TTL", CHECK_LEASE_TTL), CHECK_LEASE_MAX)
    if not lease.acquire():
        return 0
    i = it["data"]["tree"]
    slot = LeaseHold(f"slot/check/{batch_key(d)}/{i}", env_num("AGENTCTL_CHECK_LEASE_TTL", CHECK_LEASE_TTL),
                     CHECK_LEASE_MAX)
    try:
        if not slot.acquire():
            return 0
        _d, clone, _w = waiting_state(repo)
        tree = f"{clone}-wt-check-{i}"
        base, tip, members = it["data"]["base"], it["data"]["tip"], batch_members(d, it)
        if not members:
            batch_move(st, it, "assembling", text=f"batch {bid}: its changes are gone")
            return 0
        if it["state"] == "checking":
            ok, out, stalled = batch_check(repo, d, tree, base, tip, it["data"].get("cls") or "check")
            it = st.item("batch", bid)
            if stalled:
                text = (f"HELD: the batch check of {tip[:10]} ({len(members)} change(s)) stalled twice on a fresh sbt "
                        "server; checked again in 30 min")
                batch_move(st, it, "held", {"why": "stalled"}, text=text, severity="escalate")
                return 0
            if ok:
                batch_move(st, it, "pushing", text=f"batch {bid}: {tip[:10]} passed its check")
                return 0
            if REDGATE.search(out or ""):
                batch_move(st, it, "assembling", text=f"batch {bid}: the gate went red")
                return 0
            it = batch_move(st, it, "bisecting", text=f"batch {bid}: {tip[:10]} failed its check; bisecting")
        culprit, cout = bisect(repo, d, members, base, tree)
        it = st.item("batch", bid)
        if culprit is None:
            batch_fail(st, d, it, "it failed, then every prefix passed on its own (flaky or infra)", len(members))
            return 0
        bad = members[culprit]
        queue_verdict(d, bad, "rejected", f"NOT LANDED: the checks failed with your change in the batch (entry {bad['id']})"
                                          f"\n  {tail_of(cout)}", cout.splitlines()[-25:])
        if culprit > 0:  # the prefix before it passed its own check: it lands now; the rest join the next batch
            prefix = members[:culprit]
            batch_move(st, it, "pushing", {"members": [e["id"] for e in prefix], "tip": prefix[-1]["tip"]},
                       text=f"batch {bid}: {bad['id']} rejected; the {culprit} change(s) before it land")
        else:
            batch_move(st, it, "assembling", text=f"batch {bid}: {bad['id']} rejected")
        return 1
    finally:
        slot.release()
        lease.release()


def push_batch_item(repo, d, st, it):
    """The tick's push of a passing batch, under the landing lease: main moved -> assembled again; else the tip pushed
    (the batch's fast pass stands for the push: PREPUSH_REUSE_FAST) and verified on main -> every change LANDED."""
    members = batch_members(d, it)
    tip, base, i = it["data"]["tip"], it["data"]["base"], it["data"]["tree"]
    if not members:
        batch_move(st, it, "assembling", text=f"batch {it['id']}: its changes are gone")
        return f"batch {it['id']}: nothing to push"
    _d, clone, _w = waiting_state(repo)
    tree = f"{clone}-wt-check-{i}"
    with land_lock(repo) as held:
        if not held:
            return f"batch {it['id']}: the landing lease is busy"
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
        if git(repo, "rev-parse", f"{REMOTE}/main").strip() != base:
            batch_move(st, it, "assembling", text=f"batch {it['id']}: main moved during its check: assembled again")
            return f"batch {it['id']}: main moved"
        lock_note(f"push of the batch {tip[:10]}")
        if not os.path.isdir(tree) or not git_ok(tree, "cat-file", "-e", f"{tip}^{{commit}}"):
            batch_move(st, it, "assembling", text=f"batch {it['id']}: its tree is gone: assembled again")
            return f"batch {it['id']}: tree gone"
        git(tree, "checkout", "-q", "--force", "--detach", tip, check=False)
        pushed_at = time.time()
        env = dict(tool_env(), PREPUSH_REUSE_FAST="1")
        rc, out = run_watched(push_argv(REMOTE, tip), tree, env, os.path.join(d, f"push-{tip[:10]}"), "push",
                              **push_bounds())
        with open(os.path.join(d, "checks.log"), "a") as f:
            f.write(f"=== push {ts()} {tip[:10]} rc {rc}\n{out}\n")
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
        if not landed(repo, tip, f"refs/remotes/{REMOTE}/main"):
            if rc is not None and REDGATE.search(out or ""):
                batch_move(st, it, "assembling", text=f"batch {it['id']}: the gate went red before the push")
                return f"batch {it['id']}: red"
            if rc is not None and RACE.search(out or ""):
                batch_move(st, it, "assembling", text=f"batch {it['id']}: raced: assembled again")
                return f"batch {it['id']}: raced"
            why = "its push stalled" if rc is None else f"its push failed: {tail_of(out or '', 3)[:160]}"
            batch_fail(st, d, it, why, len(members))
            return f"batch {it['id']}: {why}"
    mark_gate_dirty()
    for e in members:
        queue_verdict(d, e, "landed", f"LANDED {e['tip']} (batch: {len(members)} change(s) in one push)", code=0,
                      landed_sha=e["tip"], pushed_at=pushed_at, batch=len(members))
        if not lock_held(Owned("await", e["id"]).lockpath):  # a `land --follow` waiting on it watches it itself
            start_watch(repo, e["tip"], pushed_at, worktree=e["worktree"],
                        close=e["worktree"] if os.path.isdir(e["worktree"]) else None, session=e.get("session"))
    batch_move(st, st.item("batch", it["id"]), "landed", text=f"LANDED {tip} ({len(members)} change(s) in one push)")
    wlog(d, f"LANDED {tip} ({len(members)} change(s) in one push)")
    return f"batch {it['id']}: landed {tip[:10]}"


ROUND_ERRORS_MAX = 3
SERVICE_IDLE_POLL = 30  # seconds between looks at an empty `waiting` (a directory listing: no git, no network)


def write_snapshot(d, store=None):
    """The tick's part of state.json: the open items and the tick's own time and code version."""
    st = store or Store()
    open_ = lambda typ: [i for i in st.items(typ) if typ in MACHINES and not machine_state(typ, i["state"]).terminal]
    brief = lambda i: {"id": i["id"], "state": i["state"], "deadline": i["deadline"], "level": i["level"],
                       "worktree": (i["data"] or {}).get("worktree")}
    queued = queued_entries(d)
    waiting = waiting_entries(d)
    state_update(tick_at=time.time(), version=code_version(),
                 changes=[brief(i) for i in open_("change")], batch=[brief(i) for i in open_("batch")],
                 reds=[brief(i) for i in open_("red")] if "red" in MACHINES else [],
                 conditions=[brief(i) for i in open_("condition")] if "condition" in MACHINES else [],
                 waiting=[e["worktree"] for e in waiting], queued=[e["worktree"] for e in queued])


def status_line(now_=None):
    """The status line from state.json alone (no git, no Forgejo, no subprocess): the gate line, the waiting and
    checking changes, the unread inbox; `RECONCILER STALLED since HH:MM` when the tick is over 2 min old."""
    t = now_ if now_ is not None else time.time()
    d = state_read()
    epoch, _repo, line = published_summary()
    gate = line or "gate ?"
    if epoch and t - epoch > GATE_SUMMARY_MAX_AGE:
        gate = f"gate UNREAD (as of {time.strftime('%H:%M', time.localtime(epoch))}: {gate[5:]})"
    short = lambda wts: ", ".join(re.sub(r"^.*-wt-", "", os.path.basename(w or "")) for w in wts)
    waiting, queued = d.get("waiting") or [], d.get("queued") or []
    parts = [gate]
    tick = d.get("tick_at")
    if not tick or t - float(tick) > 120:
        parts.insert(0, f"RECONCILER STALLED since {time.strftime('%H:%M', time.localtime(float(tick)))}" if tick
                     else "RECONCILER not running")
    parts.append(f"waiting: {len(waiting)}" + (f" — {short(waiting)}" if waiting else "")
                 + (f" · checking: {len(queued)} — {short(queued)}" if queued else ""))
    return " · ".join(parts)


def cmd_status(a):
    if a.line:
        print(status_line())
        return 0
    d, t = state_read(), time.time()
    print(status_line())
    for key in ("changes", "batch", "reds", "conditions"):
        rows = d.get(key) or []
        print(f"{key}: {len(rows)}")
        for r in rows:
            print(f"  {r['id']}  {r['state']}  deadline in {int((r['deadline'] - t) // 60)} min"
                  + (f"  (level {r['level']})" if r.get("level") else ""))
    tick = d.get("tick_at")
    print(f"tick: {int(t - tick)} s ago, code {d.get('version')}" if tick else "tick: never")
    return 0


TICK = 5  # seconds between ticks ($AGENTCTL_TICK); every step is bounded or rate-limited inside


def waiting_run(repo, once=False, service=False):
    """THE processor: ONE loop of ticks (design §3, phase 1 step 8): the change items (executors, pushes), the batch,
    events -> inbox and the notifier, the network and tunnel watches, the gate line, the red tick, the recovery
    registry, the inbox escalations. Nothing in it blocks for long (checks run in executors with leases); it re-execs
    onto agentctl's new code between ticks; the external watchdog (W5) watches its beat."""
    d, _c, _wt = waiting_state(repo)
    own = processor_owned(d, repo)
    if not own.acquire():
        return 0
    argv = ["waiting", "run", "--repo", repo] + (["--once"] if once else []) + (["--service"] if service else [])
    with contextlib.ExitStack() as stack:
        stack.callback(own.release)
        try:
            o_r = slug(repo)
        except (Exception, SystemExit):
            o_r = SHORT["movies"]
        _IN_PROCESSOR[0] = True
        drop = TokenDrop(d, o_r).open()
        stack.callback(drop.close)
        errors = 0
        role = host_role()
        steps = sync_steps(repo, d, o_r) if role == "sync" else tuple(
            (n, f) for n, f in (("change items", lambda: project_changes(d)),
                                ("change tick", lambda: [wlog(d, f"tick: {x}") for x in tick_changes(repo, d)]),
                                ("batch tick", lambda: [wlog(d, f"tick: {x}") for x in tick_batch(repo, d)]),
                                ("watches", lambda: [wlog(d, f"tick: {x}") for x in tick_watches()]),
                                ("land refs", lambda: [wlog(d, f"tick: {x}") for x in sweep_land_refs(repo, d)]),
                                ("lease archive", lambda: maybe_archive_leases(d)),
                                ("events", project_events), ("notifier", notify_escalations),
                                ("network watch", network_watch), ("tunnel probe", tunnel_watch),
                                ("gate summary", lambda: maybe_publish_gate(repo)),
                                ("red time", lambda: track_red_time(Store(), gate_is_red_now())),
                                ("red tick", lambda: maybe_red_tick(repo)),
                                ("recovery", maybe_recovery_tick))
            if not (role == "server" and n in LAPTOP_ONLY_STEPS))
        while True:
            if TICK_STOP[0]:  # SIGTERM (systemd's stop): between ticks, never inside one
                return 0
            write_beat("processor")
            LOOP_CYCLED[0] = True
            restart_if_changed([own], argv)
            failed = False
            for name, step in steps:
                try:
                    step()
                except (Exception, SystemExit) as e:  # one step's error is that step's, never the loop's (audit #9)
                    failed = True
                    err(f"{name} failed: {str(e).replace('agentctl: ', '')[:200]}")
                write_beat("processor")
                sd_notify("WATCHDOG=1")  # each bounded step is progress: systemd's WatchdogSec never cuts a long tick
            errors = errors + 1 if failed else 0
            if errors == ROUND_ERRORS_MAX:
                open_condition("STALLED", f"STALLED: the waiting processor's ticks failed {ROUND_ERRORS_MAX} times in a row; "
                                          f"see {d}/processor.log and service.log",
                               run_probe("waiting_ok", {"d": d, "since": time.time()}), [], key="waiting-rounds",
                               command="waiting")
            if not failed:
                write_json(os.path.join(d, "round-ok.json"), {"at": time.time()})
            if role != "sync":  # the sync's state.json is ci-runner's, mirrored
                try:
                    write_snapshot(d)
                except Exception as e:
                    err(f"the snapshot could not be written: {e}")
            sd_notify("WATCHDOG=1")
            if once and (role == "sync" or (not queued_entries(d) and not waiting_entries(d))):
                return 0
            drop.nap(env_num("AGENTCTL_TICK", TICK))


TICK_STOP = [False]  # set by SIGTERM in `agentctl tick`: the loop returns between ticks

SERVICE_LABEL = "net.bitcashier.agentctl-waiting"


def launch_agents_dir():
    return os.environ.get("AGENTCTL_LAUNCH_AGENTS") or os.path.join(HOME, "Library", "LaunchAgents")


def launchctl(*args):
    return subprocess.run([os.environ.get("AGENTCTL_LAUNCHCTL", "launchctl")] + list(args), capture_output=True,
                          text=True)


def service_plist(repo, log):
    from xml.sax.saxutils import escape
    argv = [sys.executable, os.path.realpath(__file__), "waiting", "run", "--service", "--repo", repo]
    args = "".join(f"\n        <string>{escape(x)}</string>" for x in argv)
    path_env = ":".join(SDKMAN_BINS + ["/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"])
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{SERVICE_LABEL}</string>
    <key>ProgramArguments</key>
    <array>{args}
    </array>
    <key>WorkingDirectory</key>
    <string>{escape(repo)}</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{escape(path_env)}</string>
        <key>HOME</key>
        <string>{escape(HOME)}</string>
    </dict>
    <key>StandardOutPath</key>
    <string>{escape(log)}</string>
    <key>StandardErrorPath</key>
    <string>{escape(log)}</string>
</dict>
</plist>
"""


def waiting_service(action, repo):
    """The `waiting` processor as a launchd agent (KeepAlive, RunAtLoad): `agentctl waiting run --service` for the clone,
    its log in the waiting state dir. install writes the plist and bootstraps it; uninstall boots it out and removes it."""
    d, clone, _wt = waiting_state(repo)
    plist = os.path.join(launch_agents_dir(), f"{SERVICE_LABEL}.plist")
    domain = f"gui/{os.getuid()}"
    log = os.path.join(d, "service.log")
    if action == "install":
        os.makedirs(launch_agents_dir(), exist_ok=True)
        with open(plist, "w") as f:
            f.write(service_plist(clone, log))
        launchctl("bootout", f"{domain}/{SERVICE_LABEL}")  # a previous one, if any
        r = launchctl("bootstrap", domain, plist)
        if r.returncode != 0:
            print(f"wrote {plist}, but launchctl bootstrap failed: {r.stderr.strip() or r.stdout.strip()}")
            return 1
        print(f"installed {SERVICE_LABEL}: `agentctl waiting run --service --repo {clone}`, log {log}")
        return 0
    if action == "uninstall":
        launchctl("bootout", f"{domain}/{SERVICE_LABEL}")
        try:
            os.unlink(plist)
        except FileNotFoundError:
            pass
        print(f"uninstalled {SERVICE_LABEL}")
        return 0
    if action == "status":
        r = launchctl("print", f"{domain}/{SERVICE_LABEL}")
        if r.returncode != 0:
            print(f"{SERVICE_LABEL}: not loaded" + (f" (plist {plist} present)" if os.path.exists(plist) else ""))
            return 1
        state = re.search(r"^\s*state = (\S+)", r.stdout, re.M)
        pid = re.search(r"^\s*pid = (\d+)", r.stdout, re.M)
        print(f"{SERVICE_LABEL}: {state.group(1) if state else 'loaded'}" + (f", pid {pid.group(1)}" if pid else "")
              + f"; processor {'running' if waiting_processor_alive(d) else 'not running'}; log {log}")
        return 0
    return 2


def cmd_waiting(a):
    if a.wcmd in WAITING_RENAMED and not getattr(a, "renamed", False) and \
            (a.wcmd not in ("run", "service") or sys.stdin.isatty()):
        err(f"`agentctl waiting {a.wcmd}` is now `agentctl {WAITING_RENAMED[a.wcmd]}` (the old name answers until "
            f"{ALIASES_UNTIL})")
    repo = main_clone(a.repo or safe_cwd()) if a.wcmd == "await" else git(a.repo or os.getcwd(), "rev-parse", "--show-toplevel").strip()
    d, _c, wt = waiting_state(repo)
    if a.wcmd == "run":
        return waiting_run(repo, once=a.once, service=getattr(a, "service", False))
    if a.wcmd == "check":  # one queued change's checker (the processor starts it)
        return check_entry(main_clone(repo), a.entry)
    if a.wcmd == "check-batch":  # the batch's executor (the processor starts it)
        return check_batch(main_clone(repo), a.entry)
    if a.wcmd == "service":
        return waiting_service(a.action, repo)
    if a.wcmd == "await":  # land's wait on its entry, resumed after a restart on new code
        a.inbox_cwd = a.close or a.repo
        repo = main_clone(repo)
        os.chdir(repo)
        rc, sha, pushed_at = await_entry(repo, a.entry)
        return watch_landed(repo, sha, pushed_at, close=a.close) if rc == 0 and sha else rc
    if a.wcmd == "pause":
        open(os.path.join(d, "PAUSED"), "a").close()
        print(f"held: the processor takes no batch until `agentctl land release` ({d}/PAUSED); changes still queue")
        return 0
    if a.wcmd == "resume":
        try:
            os.unlink(os.path.join(d, "PAUSED"))
        except FileNotFoundError:
            pass
        recover_clear_hold(None, {"d": d})  # a held batch is assembled again at once
        spawn_waiting_processor(repo)
        offer_token(repo)
        print("released: the processor takes the next batch")
        return 0
    if a.wcmd == "status":
        entries = waiting_entries(d)
        print(f"waiting {d}")
        print(f"processor: {'running' if waiting_processor_alive(d) else 'not running'}"
              + ("; HELD (`agentctl land release`)" if os.path.exists(os.path.join(d, "PAUSED")) else ""))
        bt = current_batch(Store(), d)
        if bt:
            dd = bt["data"]
            print(f"batch {bt['id']}: {bt['state']}" + (f", {len(dd.get('members') or [])} change(s) at "
