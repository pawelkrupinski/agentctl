def push_argv(remote, src, dst="main"):
    argv = ["git", "push", remote, f"{src}:refs/heads/{dst}"]
    assert not any(a in ("--no-verify", "-n", "--force", "-f") or a.startswith("--force") for a in argv)
    return argv


class Stash:
    """A NAMED stash (git's stash list is shared by every worktree of a clone): found again by its own sha, never by
    position, and restored exactly once."""

    def __init__(self, repo):
        self.repo, self.name, self.sha = repo, f"agentctl-land-{os.getpid()}-{int(time.time())}", None

    def save(self):
        git(self.repo, "stash", "push", "--include-untracked", "-m", self.name)
        for line in git(self.repo, "stash", "list", "--format=%H %gs").splitlines():
            sha, _, msg = line.partition(" ")
            if msg.endswith(self.name):
                self.sha = sha
                return
        raise RuntimeError(f"stash {self.name} not found after saving it")

    def restore(self):
        if not self.sha:
            return True
        r = git(self.repo, "stash", "apply", "--index", self.sha, check=False)
        if r.returncode != 0:
            r = git(self.repo, "stash", "apply", self.sha, check=False)
        if r.returncode != 0:
            err(f"could not re-apply stash {self.name} ({self.sha[:10]}): {r.stderr.strip()[:200]}; it is kept: "
                f"`git stash list | grep {self.name}`")
            return False
        for i, line in enumerate(git(self.repo, "stash", "list", "--format=%H").splitlines()):
            if line.strip() == self.sha:
                git(self.repo, "stash", "drop", f"stash@{{{i}}}", check=False)
                break
        self.sha = None
        return True


def landed(repo, sha, main_ref):
    if git_ok(repo, "merge-base", "--is-ancestor", sha, main_ref):
        return "ancestor"
    lines = git(repo, "cherry", main_ref, sha).splitlines()
    if lines and all(l.startswith("-") for l in lines):
        return "patch-equivalent"
    return None


def land_lock_path(repo):
    """One lock per repository: every worktree of a clone shares its git common dir."""
    common = os.path.realpath(git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir").strip())
    return os.path.join(LAND_LOCK_DIR, re.sub(r"[^A-Za-z0-9._-]", "_", common.strip("/")) + ".lock")


_held_lock = [None]  # (file, first line) of the landing lock this process holds


def lock_note(step):
    """Say in the held landing lock's file what the holder is doing now (waiters print it)."""
    if _held_lock[0]:
        f, first = _held_lock[0]
        f.seek(0)
        f.truncate()
        f.write(f"{first}; now: {step} since {ts()}\n")
        f.flush()


def held_for(holder):
    """'37 min' since the holder's `since <ts>`, or '?'."""
    m = re.search(r"since (\S+?)(?:;|$|\s)", holder)
    if not m:
        return "?"
    try:
        t = dt.datetime.fromisoformat(m.group(1).replace("Z", "+00:00"))
        if t.tzinfo is None:
            t = t.replace(tzinfo=dt.timezone.utc)
    except ValueError:
        return "?"
    return f"{int((dt.datetime.now(dt.timezone.utc) - t).total_seconds() // 60)} min"


@contextlib.contextmanager
def land_lock(repo):
    """Hold the repository's landing lock (an flock, freed by the kernel when the holder dies), waiting for it with a
    line saying who holds it, for how long and doing what, repeated every LAND_WAIT_REPORT_MIN minutes. Yields True
    when held, False when the wait timed out."""
    path = land_lock_path(repo)
    os.makedirs(LAND_LOCK_DIR, exist_ok=True)
    f = open(path, "a+")
    try:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            def holder():
                f.seek(0)
                return f.read().strip() or "unknown"
            h = holder()
            err(f"waiting for the landing lock ({path}), held for {held_for(h)} by: {h}")
            deadline = time.monotonic() + float(os.environ.get("AGENTCTL_LAND_LOCK_TIMEOUT", LAND_LOCK_TIMEOUT))
            every = float(os.environ.get("AGENTCTL_LAND_WAIT_REPORT_MIN", LAND_WAIT_REPORT_MIN)) * 60
            report_at = time.monotonic() + every
            while True:
                try:
                    fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() > deadline:
                        yield False
                        return
                    if time.monotonic() > report_at:
                        h = holder()
                        err(f"still waiting for the landing lock: held for {held_for(h)} by: {h}")
                        report_at = time.monotonic() + every
                    time.sleep(5)
            err("got the landing lock")
        first = f"pid {os.getpid()} {repo} since {ts()}"
        f.seek(0)
        f.truncate()
        f.write(first + "\n")
        f.flush()
        _held_lock[0] = (f, first)
        yield True
    finally:
        _held_lock[0] = None
        f.close()


def precheck_hook(repo):
    """The repo's own pre-push hook, when it has one with a dry-run mode (movies: scripts/hooks/pre-push --range)."""
    hook = os.path.join(repo, "scripts", "hooks", "pre-push")
    return hook if os.access(hook, os.X_OK) else None


def cmd_land(a):
