def sweep_claims(now_=None, out=None):
    """Remove stale claims (the sweep's); a blocked one stays until released."""
    removed = []
    for c in all_claims():
        why = claim_stale(c, now_)
        if why:
            try:
                os.unlink(c["path"])
                removed.append(f"removed stale claim {c.get('workflow') or 'run'} #{c.get('run')} by {c.get('who')}: {why}")
