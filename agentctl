def cmd_orphans(a):
    sbt_only = getattr(a, "sbt_only", False)  # the daily sweep: stuck sbt servers only
    safe = getattr(a, "safe", False)  # the scheduled reaper: never an owner merely on old code (it re-execs itself)
    owners = [] if sbt_only else owner_orphans(a.kill and not safe) if safe else owner_orphans(a.kill)
    if safe and a.kill:  # a dead owner's record and runs only
        owners = [o for o in owners if "process gone" in o[2]]
        owner_orphans_dead_only()
    procs = ps()
    cwds = process_cwds()
    me = {os.getpid(), os.getppid()}
    found = []
    status_cache = {}

    def finished(repo, rid):
        k = (repo, rid)
        if k not in status_cache:
            try:
                status_cache[k] = gh_json(repo, "run", "view", rid, "--json", "status").get("status") == "completed"
            except Exception:
                status_cache[k] = None
        return status_cache[k]

    seen_targets = {}
    loops = [] if sbt_only else [p for p in procs if p[0] not in me and is_wait_loop(p[3])]
    loops.sort(key=lambda p: p[0])
    for pid, ppid, etime, cmd in loops:
        body = loop_body(cmd)
        reasons = []
        if ppid == 1:
            reasons.append("owning shell/agent is gone")
        gone = missing_tree_paths(body + " " + cwds.get(pid, ""))
        if gone:
            reasons.append(f"worktree missing: {', '.join(gone)}")
        repo, ids = loop_targets(body)
        if repo and ids:
            states = [finished(repo, i) for i in ids]
            if all(s is True for s in states):
                reasons.append(f"all target runs finished ({repo} {' '.join(ids)})")
            key = (repo, tuple(ids))
            if key in seen_targets and pid_alive(seen_targets[key]):
                reasons.append(f"duplicate of loop pid {seen_targets[key]}")
            else:
                seen_targets.setdefault(key, pid)
        if reasons:
            found.append(("wait-loop", pid, etime, "; ".join(reasons), body[:140].replace("\n", " ")))
    cpu_path = os.path.join(HOME, ".cache", "agentctl", "sbt-cpu.json")
    try:
        with open(cpu_path) as f:
            cpu_state = json.load(f)
    except (OSError, ValueError):
        cpu_state = {}
    procs_cpu, children = {}, {}
    for line in subprocess.run(["ps", "-A", "-o", "pid=,ppid=,time="], capture_output=True, text=True).stdout.splitlines():
        f3 = line.split()
        if len(f3) == 3:
            secs = 0.0
            for x in re.split(r"[:-]", f3[2]):
                try:
                    secs = secs * 60 + float(x)
                except ValueError:
                    pass
            procs_cpu[int(f3[0])] = secs
            children.setdefault(int(f3[1]), []).append(int(f3[0]))
    clients = {}
    for pid, ppid, etime, cmd in procs:
        if "sbtn" in cmd.split(" ", 1)[0] and cwds.get(pid):
            clients.setdefault(cwds[pid], []).append(pid)
    serving, now, live = sbt_serving(), time.time(), set()
    for pid, ppid, etime, cmd in procs:
        if pid in me or not is_sbt(cmd):
            continue
        cwd = cwds.get(pid, "")
        reasons = []
        if "java" in cmd.split(" ", 1)[0] and os.environ.get("AGENTCTL_SBT_REAP") != "0":  # tests: "0"
            live.add(str(pid))
            reasons += sbt_stuck_reasons(pid, cwd, tree_cpu(pid, procs_cpu, children), clients, serving, cpu_state, now)
        if cwd and not os.path.isdir(cwd):
            reasons.append(f"cwd gone: {cwd}")
        elif cwd and not os.path.exists(os.path.join(cwd, ".git")) and cwd.startswith(HOME + "/projects"):
            reasons.append(f"cwd {cwd} is no longer a git checkout")
        gone = missing_tree_paths(cmd)
        if gone:
            reasons.append(f"worktree missing: {', '.join(gone)}")
        if reasons:
            found.append(("sbt", pid, etime, "; ".join(reasons), f"{cwd}: {cmd[:120]}"))
    try:
        if not live and os.environ.get("AGENTCTL_SBT_REAP") == "0":
            raise OSError("tests: the real state is left alone")
        with open(cpu_path + ".tmp", "w") as f:
            json.dump({k: v for k, v in cpu_state.items() if k in live}, f)
        os.replace(cpu_path + ".tmp", cpu_path)
    except OSError:
        pass
    for kind, pid, why, what in owners:
        print(f"{kind:9} pid {pid!s:<6}  {why}\n          {what}")
    if not found:
        if not owners:
            print("no orphans")
        return 0
    for kind, pid, etime, why, what in found:
        print(f"{kind:9} pid {pid:<6} up {etime:>11}  {why}\n          {what}")
    if a.kill:
        for kind, pid, *_ in found:
            if kind == "sbt" and "java" in (next((c for p, _pp, _e, c in procs if p == pid), "").split(" ", 1)[0]):
                print(f"thread dump of sbt server pid {pid}: {thread_dump(pid, cwds.get(pid, ''))}")
            kids = subprocess.run(["pgrep", "-P", str(pid)], capture_output=True, text=True).stdout.split()
            for p in [pid] + [int(k) for k in kids]:
                try:
                    os.kill(p, signal.SIGTERM)
                except ProcessLookupError:
                    pass
            print(f"killed {kind} pid {pid}" + (f" (+children {kids})" if kids else ""))
            reap_log(f"killed {kind} pid {pid}" + (f" (+children {kids})" if kids else "") + ": "
                     + next((f"{w} | {what}" for k, p, _e, w, what in found if p == pid), ""))
    return 0

# ---------------------------------------------------------------- inbox
# The owner (2026-10-27): three agents ended their turns while their land/watch still ran, and the WATCH verdicts went
# nowhere. Every `land`, `watch`, `wait` and `waiting await` writes its verdict to an inbox when it ends -- normally, on
# a signal, or on a crash -- and land's WAITING line too (it may wait for hours): one JSON file per verdict under
# ~/.cache/agentctl/inbox/ ($AGENTCTL_INBOX_DIR; beside $AGENTCTL_OWNERS_DIR when only that is set). The orchestrating
# session reads it with `agentctl inbox` whether or not the agent that started the command is still alive. A restart
# on new code (os.execv) writes nothing: the resumed process writes the verdict. Only a SIGKILL leaves no entry (its
# owner record stays, and `agentctl orphans` names it).
INBOX_COMMANDS = {"land", "watch", "wait", "waiting await"}
VERDICT_LINE = re.compile(r"^(LANDED \S+|NOT LANDED|WAITING \S+|WATCH (OK|RED|UNKNOWN|STALLED)\b|run \S+#\d+: |file \S+: )")
INBOX_TAIL = 15


def inbox_dir():
    if os.environ.get("AGENTCTL_INBOX_DIR"):
        return os.environ["AGENTCTL_INBOX_DIR"]
    if os.environ.get("AGENTCTL_OWNERS_DIR"):
        return os.path.join(os.path.dirname(os.path.abspath(os.environ["AGENTCTL_OWNERS_DIR"])), "inbox")
    return os.path.join(HOME, ".cache", "agentctl", "inbox")


class VerdictTee:
    """stdout, with every line also kept: the verdict lines, and the last INBOX_TAIL lines for context."""

    def __init__(self, stream, on_line=None):
        self.stream, self.on_line, self.partial = stream, on_line, ""
        self.verdicts, self.tail = [], []

    def write(self, s):
        n = self.stream.write(s)
        self.partial += s
        while "\n" in self.partial:
            line, self.partial = self.partial.split("\n", 1)
            self._line(line)
        return n

    def _line(self, line):
        self.tail = (self.tail + [line])[-INBOX_TAIL:]
        if VERDICT_LINE.match(line):
            self.verdicts.append(line)
            if self.on_line:
                self.on_line(line)

    def finish(self):
        if self.partial:
            self._line(self.partial)
            self.partial = ""

    def flush(self):
        return self.stream.flush()

    def __getattr__(self, name):
        return getattr(self.stream, name)


def safe_cwd():
    """The cwd, or what it was: a watch's WATCH OK closes the worktree it runs in, and os.getcwd() then raises (the
    verdict was lost with it)."""
    try:
        return os.getcwd()
    except OSError:
        return os.environ.get("PWD") or "(removed)"


INBOX_KINDS = [("FIX_FAILED", r"FIX FAILED"), ("FIX_OK", r"FIX OK"), ("FIX_UNVERIFIED", r"FIX UNVERIFIED"),
               ("RED", r"WATCH RED"), ("OK", r"WATCH OK"), ("STALLED", r"WATCH STALLED|.*\bstalled\b"),
               # a crash, a signal or an exit with no verdict: whatever it watched is unknown now
               ("UNKNOWN", r"WATCH UNKNOWN|UNKNOWN:|crashed:|exited:|ended by signal|exit \d+ with no verdict"),
               ("NOT_LANDED", r"NOT LANDED"), ("LANDED", r"LANDED "), ("WAITING", r"WAITING "), ("HELD", r"HELD:"),
               ("CHECK", r"CHECK CAP")]
WAIT_KINDS_DEFAULT = "RED,FIX_FAILED,NOT_LANDED,STALLED,UNKNOWN"


def inbox_kind(verdict, final=True):
    """An entry's kind, from its verdict line: what `inbox wait --kinds` selects on."""
    v = verdict or ""
    if not final:
        return "WAITING"
    for kind, pat in INBOX_KINDS:
        if re.match(pat, v):
            return kind
    return "OTHER"


def inbox_write(command, verdict, verdicts, tail, exit_code, final=True, cwd=None):
    """One inbox entry, written atomically; returns its id (None when the inbox cannot be written: never fatal)."""
    now = dt.datetime.now(dt.timezone.utc)
    eid = (f"{now.strftime('%Y%m%dT%H%M%S%f')}-{os.getpid()}-{re.sub(r'[^a-z]+', '-', command)}"
           + ("" if final else "-waiting"))
    here = safe_cwd()
    rec = {"id": eid, "time": now.strftime("%Y-%m-%dT%H:%M:%SZ"), "at": now.timestamp(), "command": command, "argv": sys.argv[1:],
           "cwd": cwd or here, "pid": os.getpid(), "final": final, "exit": exit_code, "verdict": verdict,
           "kind": inbox_kind(verdict, final),
           "owner": os.environ.get("CLAUDE_CODE_SESSION_ID") or f"{os.environ.get('USER', '?')}@{here}",
           "verdicts": verdicts, "tail": tail}
    try:
        d = inbox_dir()
        os.makedirs(d, exist_ok=True)
        tmp = os.path.join(d, f".{eid}.tmp")
        with open(tmp, "w") as f:
            json.dump(rec, f, indent=1)
        os.replace(tmp, os.path.join(d, eid + ".json"))
        return eid
    except OSError as e:
        err(f"could not write the inbox entry ({e})")
        return None


def inbox_command(a):
    """The inbox's name for a parsed command, or None when it writes no entry."""
    name = a.cmd + (f" {a.wcmd}" if a.cmd == "waiting" else "")
    return name if name in INBOX_COMMANDS else None


def with_inbox(command, handler, a):
    """Run handler(a) with its stdout teed; whatever way it ends, write its verdict to the inbox."""
    waiting_line = []

    def on_line(line):
        if line.startswith("WAITING "):
            inbox_write(command, line, [line], tee.tail, None, final=False)
            waiting_line.append(line)
    tee = VerdictTee(sys.stdout, on_line)
    errs = VerdictTee(sys.stderr)  # its last lines name a cause when stdout has no verdict
    sys.stdout, sys.stderr, code, crash = tee, errs, 1, None
    try:
        code = handler(a)
        return code
    except SystemExit as e:
        code = e.code if isinstance(e.code, int) else (0 if e.code is None else 1)
        if code >= 128:
            crash = f"ended by signal {code - 128}"
        elif e.code is not None and not isinstance(e.code, int):  # SystemExit("agentctl: ..."): the message is the cause
            crash = f"exited: {str(e.code).replace('agentctl: ', '')}"
        raise
    except BaseException as e:
        crash = f"crashed: {type(e).__name__}: {e}"
        raise
    finally:
        sys.stdout, sys.stderr = tee.stream, errs.stream
        tee.finish()
        errs.finish()
        last = next((l for l in reversed(tee.tail) if l.strip()), None)
        last_err = next((l.replace("agentctl: ", "") for l in reversed(errs.tail) if l.strip()), None)
        if tee.verdicts:
            verdict = crash or tee.verdicts[-1]
        elif crash:
            verdict = crash
        elif code:  # never a bare exit: what it said last, on stderr first
            verdict = f"exit {code} with no verdict line; it said last: {last_err or last or 'nothing'}"
        else:
            verdict = last or last_err or "exit 0 with no output"
        if not (crash is None and code == 0 and waiting_line and verdict == waiting_line[-1]):  # land ended AT WAITING:
            inbox_write(command, verdict, tee.verdicts, tee.tail, code if crash is None else (code or 1))  # written once


