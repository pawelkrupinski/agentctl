    main_ref = f"refs/remotes/{REMOTE}/main"
    env = tool_env()
    log_path = os.path.join(scratch(), f"agentctl-land-{os.path.basename(repo)}-{os.getpid()}.log")

    def sh(*args):
        return subprocess.run(args, cwd=repo, capture_output=True, text=True, env=env)

    dirty = git(repo, "status", "--porcelain", "--untracked-files=no").strip()
    stash = None
    if dirty and not a.stash:
        print(f"NOT LANDED: the working tree has uncommitted changes ({len(dirty.splitlines())} file(s)). Commit them, or "
              "pass --stash to set them aside in a named stash and restore them afterwards.")
        return 1
    if a.branch:
        r = sh("git", "rev-parse", "--abbrev-ref", "HEAD")
        if r.stdout.strip() != a.branch:
            if dirty:
                print("NOT LANDED: --branch with a dirty tree; commit first")
                return 1
            r = sh("git", "switch", a.branch)
            if r.returncode:
                print(f"NOT LANDED: cannot switch to {a.branch}: {r.stderr.strip()}")
                return 1
    try:
        if dirty:
            stash = Stash(repo)
            stash.save()
            err(f"stashed local changes as {stash.name} ({stash.sha[:10]})")
        a.landed_sha, a.pushed_at, a.waiting = None, None, None
        rc = None
        for round_ in range(LAND_PRECHECK_ROUNDS + 1):
            # The long checks first, WITHOUT the lock (the last round: under it, so a lander always finishes).
            a.prechecked = None
            if round_ < LAND_PRECHECK_ROUNDS:
                rc = precheck(repo, main_ref, sh, log_path, a)
                if rc is not None:
                    break
            with land_lock(repo) as held:
                if not held:
                    print("NOT LANDED: timed out waiting for the landing lock (another land is running its checks); "
                          "land again.")
                    return 1
                rc = land_loop(repo, main_ref, sh, log_path, a)
            if rc != MAIN_MOVED:
                break
            err(f"{REMOTE}/main moved since the check: checking again on it, outside the lock")
    finally:
        if stash and not stash.restore():
            print(f"WARNING: local changes are in stash {stash.name}, not restored")
    if rc == 0 and a.waiting and not getattr(a, "follow", False):
        return 0  # the processor lands it; LANDED / NOT LANDED and the WATCH verdict go to `agentctl inbox`
    if rc == 0 and a.waiting:  # --follow: wait here for the batch, then watch
        rc, a.landed_sha, a.pushed_at = await_entry(repo, a.waiting["id"], close=None if getattr(a, "keep_worktree", False) else repo)
    if rc != 0 or not a.landed_sha or getattr(a, "no_watch", False):
        return rc
    if not getattr(a, "follow", False):  # land ends at LANDED; a detached watch sends its verdict to the inbox
        spawn_watch_of(repo, a.landed_sha, a.pushed_at, close=None if getattr(a, "keep_worktree", False) else repo,
                       fixes=getattr(a, "fixes", None) or ())
        print(f"watching {a.landed_sha[:10]} detached: its WATCH verdict goes to `agentctl inbox`", flush=True)
        return 0
    # the lock is free again: the next lander goes while this one watches main's CI; on WATCH OK the worktree it ran
    # from is closed when proven merged (close_worktree), unless --keep-worktree
    return watch_landed(repo, a.landed_sha, a.pushed_at, close=None if getattr(a, "keep_worktree", False) else repo,
                        fixes=getattr(a, "fixes", None) or ())


MAIN_MOVED = "main moved"  # land_loop: the check outside the lock no longer covers forgejo/main


def sync(repo, main_ref, sh):
    """Fetch, rebase onto forgejo/main, the squash guard: (rc, None) when land is decided here, else (None, head)."""
    r = sh("git", "fetch", "--quiet", REMOTE, "main")
    if r.returncode:  # a tunnel restart is seconds long: one more try before giving up
        err(f"git fetch failed ({r.stderr.strip()[:120]}); retrying once in 15 s")
        time.sleep(15)
        r = sh("git", "fetch", "--quiet", REMOTE, "main")
    if r.returncode:
        print(f"NOT LANDED: git fetch {REMOTE} main failed: {r.stderr.strip()[:300]} (tunnel? `agentctl env --check`)")
        return 1, None
    head = git(repo, "rev-parse", "HEAD").strip()
    if landed(repo, head, main_ref):
        print(f"LANDED {head} (already on {REMOTE}/main)")
        return 0, None
    r = sh("git", "rebase", "--quiet", f"{REMOTE}/main")
    if r.returncode:
        conflicts = git(repo, "diff", "--name-only", "--diff-filter=U", check=False).stdout.split()
        sh("git", "rebase", "--abort")
        print(f"NOT LANDED: rebase onto {REMOTE}/main conflicts in: {', '.join(conflicts) or r.stderr.strip()[:300]}. "
              "Resolve by hand (git rebase forgejo/main), then land again.")
        return 1, None
    head = git(repo, "rev-parse", "HEAD").strip()
    if landed(repo, head, main_ref):
        print(f"LANDED {head} (the rebase left nothing: already on {REMOTE}/main)")
        return 0, None
    problems = check_range(repo, f"{REMOTE}/main", head, [], int(os.environ.get("AGENTCTL_MAX_FOREIGN", "2")))
    if problems:
        print("NOT LANDED: prepush-check refused:\n  " + "\n  ".join(problems))
        return 1, None
    return None, head


def dry_run(repo, hook, head, log_path, attempt, mode="--range"):
    """The repo hook's dry run over forgejo/main..head, in a check slot, watched for a stall: None when it passed, else
    land's rc."""
    err(f"checking {head[:10]}: {os.path.relpath(hook, repo)} {mode} {REMOTE}/main..HEAD (log: {log_path})")
    lock_note(f"checks of {head[:10]}")
    with check_slot(repo, f"land {os.path.basename(repo)} {head[:10]}") as slot:
        rc, out = run_watched([hook, mode, f"{REMOTE}/main..{head}"], repo, tool_env(), log_path, "checks",
                              sampler=slot.sample)
        slot.done(rc, out)
    with open(log_path, "a") as f:
        f.write(f"=== check {attempt} {ts()} {head}\n{out}\n")
    if rc is None:
        return stalled("checks (scripts/hooks/pre-push --range)", out, log_path)
    if rc != 0:
        return refused(repo, out, log_path, "the pre-push checks failed")
    return None


def precheck(repo, main_ref, sh, log_path, a):
    """Before the lock: sync and the hook's dry run (the long part). None when land goes on to the lock (with
    a.prechecked = (head, base) when the dry run passed there), else land's rc."""
    rc, head = sync(repo, main_ref, sh)
    if rc is not None:
        return rc
    hook = precheck_hook(repo)
    if not hook:
        return None
    # The change's OWN checks first, red main or green (the owner, 2026-10-27: "once the checks are done but build is
    # red, merge to waiting"): main red and the change one that must wait, without the gate (--checks-only), since it
    # will join `waiting` and land with the batch at green.
    reds = gate_reds(repo) if waiting_supported(repo) else set()
    joining = bool(reds) and must_wait(repo, waiting_commits(repo, f"{REMOTE}/main", head), reds)
    rc = dry_run(repo, hook, head, log_path, "before the lock", mode="--checks-only" if joining else "--range")
    if rc is not None:
        return rc
    a.prechecked = (head, git(repo, "rev-parse", main_ref).strip())
    return None


def land_loop(repo, main_ref, sh, log_path, a):
    for attempt in range(LAND_RETRIES + 1):
        lock_note("fetch and rebase")
        rc, head = sync(repo, main_ref, sh)
        if rc is not None:
            return rc
        reds = gate_reds(repo) if waiting_supported(repo) else set()
        if reds and must_wait(repo, waiting_commits(repo, f"{REMOTE}/main", head), reds):
            # checked already (before the lock, without the gate): only the cherry-pick onto `waiting` here
            return join(repo, main_ref, sh, log_path, a, head=head)
        hook = precheck_hook(repo)
        prechecked = getattr(a, "prechecked", None)
        if hook and prechecked and prechecked != (head, git(repo, "rev-parse", main_ref).strip()):
            # main moved since the check outside the lock: give the lock back and check again outside it
            a.prechecked = None
            return MAIN_MOVED
        if hook and not prechecked:
            # CHECK FIRST: the hook's dry run over exactly what the push will carry (its pass is stored, so the push's own
            # hook run reuses it in seconds). A long hook inside `git push` holds the push's ssh connection idle, and a
            # tunnel drop kills it after "all clear" (2026-10-23); the area tests make long hooks the norm.
            rc = dry_run(repo, hook, head, log_path, attempt + 1)
            if rc is not None:
                return rc
        a.prechecked = None  # a retry after a push race checks its new base again
        try:  # the runs the pushed commits claim to fix: the watch verifies them
            a.fixes = sorted(fixes_of(repo, waiting_commits(repo, f"{REMOTE}/main", head)))
        except Exception:
            a.fixes = []
        err(f"pushing {head[:10]} to {REMOTE}/main (attempt {attempt + 1}/{LAND_RETRIES + 1}; hook log: {log_path})")
        lock_note(f"push of {head[:10]}")
        a.pushed_at = time.time()
        rc, out = run_watched(push_argv(REMOTE, head), repo, tool_env(), log_path, "push")
        with open(log_path, "a") as f:
            f.write(f"=== attempt {attempt + 1} {ts()} {head}\n{out}\n")
        if rc is None:
            return stalled("push (git push and its pre-push hook)", out, log_path)
        if rc == 0:
            sh("git", "fetch", "--quiet", REMOTE, "main")
            how = landed(repo, head, main_ref)
            if how:
                print(f"LANDED {head}" + ("" if how == "ancestor" else f" ({how})"), flush=True)
                a.landed_sha = head
                return 0
            print(f"NOT LANDED: the push exited 0 but {head[:10]} is not on {REMOTE}/main after a fetch; see {log_path}")
            return 1
        if RACE.search(out) and attempt < LAND_RETRIES:
            err(f"push race ({RACE.search(out).group(0)}): refetch, rebase, retry")
            time.sleep(min(30, 2 + 3 * attempt))
            continue
        if RACE.search(out) and not REDGATE.search(out):
            print(f"NOT LANDED: still racing after {LAND_RETRIES} retries ({RACE.search(out).group(0)}); try again shortly.")
            return 1
        return refused(repo, out, log_path, "the push failed (pre-push hook or remote)")
    return 1


def refused(repo, out, log_path, what):
    """Print the NOT LANDED line for a hook or push that said no: the red gate explained by ci-why, a tunnel hinted."""
    tail = "\n  ".join([l for l in out.splitlines() if l.strip()][-25:])
    if REDGATE.search(out):
        print(f"NOT LANDED: the red gate refused the push (main is red).\n  {tail}")
        try:
            print(ci_why(slug(repo), 4, repo=repo)[1])
        except Exception as e:
            print(f"(agentctl ci-why failed: {e})")
        return 1
    hint = ""
    if TUNNEL_TROUBLE.search(out):
        hint = ("\n  HINT: the hook could not reach Forgejo (tunnel dropped?): `~/bin/agentctl env --check` "
                "(it says the kickstart fix), then land again.")
    print(f"NOT LANDED: {what}. Last lines (full log {log_path}):\n  {tail}{hint}")
    return 1


# ---------------------------------------------------------------- land: the watch after LANDED
# The owner (2026-10-26): "whenever an agent pushed to main, make a script watch the corresponding convergence and main
# build and tell the agent if it fails". With no pre-merge CI, main's CI is where a change is tested in full: land keeps
# running after LANDED until Main and the convergence say green or red, so the agent (land in the background) hears it.
WATCH = {"pawelkrupinski/movies": {"main": ("Main", "main.yml"),
                                   "convergence": ("Identity model convergence", "identity-model-convergence.yml")}}
WATCH_TIMEOUT = 3 * 3600          # either run undecided by then: exit 2, could not tell
WATCH_CONV_START = 3600           # no convergence run containing the sha started by then: said, not waited for
WATCH_SLACK = 120                 # clock skew between the laptop and Forgejo's createdAt
WATCH_STALL_MIN = 120  # a watch with no change in its runs for this long ends WATCH STALLED
UNDECIDED = ("cancelled", "skipped", "neutral", "")


def contains(repo, sha, head):
    """Whether a run's head commit contains sha (fetching main once when head is unknown here)."""
    if not head:
        return False
    if head == sha:
        return True
    if not git_ok(repo, "cat-file", "-e", f"{head}^{{commit}}"):
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
    return git_ok(repo, "merge-base", "--is-ancestor", sha, head)


def is_cancelled(r):
    return r.get("status") == "completed" and (r.get("conclusion") or "") in UNDECIDED


def pick_main_run(repo, sha, runs):
    """Main's run for sha: its own push run, unless that was cancelled or never came (a newer push superseded it); then the
    newest run whose head contains sha."""
    own = next((r for r in runs if r.get("headSha") == sha and not is_cancelled(r)), None)
    if own:
        return own
    later = [r for r in runs if not is_cancelled(r) and contains(repo, sha, r.get("headSha"))]
    return max(later, key=lambda r: r["databaseId"]) if later else None


def pick_convergence_run(repo, sha, runs, pushed_at):
    """The FIRST convergence run on main created after the push whose head contains sha -- this commit's kick, a later
    push's, or the daily run (the owner, 2026-10-26: never hunt the sha's own kick). A cancelled one (the lane replaced
    it) passes to the next."""
    after = [r for r in runs if r.get("createdAt") and parse_time(r["createdAt"]).timestamp() >= pushed_at - WATCH_SLACK]
    ok = [r for r in sorted(after, key=lambda r: r["databaseId"]) if not is_cancelled(r) and contains(repo, sha, r.get("headSha"))]
    return ok[0] if ok else None


def watch_landed(repo, sha, pushed_at, o_r=None, close=None, fixes=()):
    """Watch Main and the convergence for a landed sha. 0 green (or nothing to watch), 3 red, 2 could not tell. OWNED
    (one watcher per sha; on agentctl's new code it re-execs as `agentctl watch`). fixes: the runs the landed commits'
    `Fixes-Red:` trailers name (the sha's own are read here too): each is verified against the new run (FIX OK / FIX
    FAILED, to the inbox)."""
    o_r = o_r or slug(repo)
    flows = WATCH.get(o_r)
    if not flows:
        print(f"watch: no CI watched for {o_r} (only movies' Main and convergence are)")
        return 0
    pushed_at = pushed_at or time.time()
    try:
        fixes = sorted(set(fixes) | fixes_of(repo, [sha]))
    except Exception:
        fixes = sorted(set(fixes))
    own = Owned("watch", f"{o_r}-{sha}", ["watch", "--repo", repo, "--sha", sha, "--pushed-at", str(pushed_at)]
                + (["--close", close] if close else []) + [x for f in fixes for x in ("--fixes", f)])
    if not own.acquire():
        h = own.holder or {}
        print(f"WATCH UNKNOWN: another agentctl (pid {h.get('pid')}, {h.get('owner')}) already watches {sha[:10]}; "
              "its verdict is its own (`agentctl orphans` lists owners)")
        return 2
    try:
        rc = _watch(repo, sha, pushed_at, o_r, flows, own, fixes)
    finally:
        own.release()
    if rc == 0 and close:
        print(close_worktree(close), flush=True)
    return rc


def failed_jobs(o_r, rid):
    d = gh_json(o_r, "run", "view", str(rid), "--json", "jobs")
    return [j["name"] for j in d.get("jobs") or [] if j.get("conclusion") in ("failure", "timed_out", "cancelled")]


def job_results(o_r, rid):
    d = gh_json(o_r, "run", "view", str(rid), "--json", "jobs")
    return {j.get("name"): j.get("conclusion") or j.get("status") or "" for j in d.get("jobs") or []}


def claimed_run(o_r, n, listed):
    """(kind, run) of the run a `Fixes-Red: n` names -- a run number or a run id -- among the runs the watch listed, else
    by `run view` (an id); (None, None) when it is not one of the watched workflows."""
    for kind, runs in listed.items():
        for r in runs:
            if str(n) in (str(r.get("number")), str(r.get("databaseId"))):
                return kind, r
    try:
        r = gh_json(o_r, "run", "view", str(n), "--json", RUN_FIELDS)
    except Exception:
        return None, None
    for kind, (name, _wfile) in WATCH.get(o_r, {}).items():
        if r.get("workflowName") == name:
            return kind, r
    return None, None


def verify_fixes(o_r, sha, fixes, done, listed, flows):
    """The owner (2026-10-27): the batch fix 97bb6d835 claimed Fixes-Red 2047, Main #2059 failed again in the same
    worker-identity job, and nothing said so. For each claimed run N: the first completed run of N's workflow containing
    the commit (the watch's) against N's failed jobs. Each verdict is printed and written to the inbox."""
    for n in fixes:
        try:
            kind, old = claimed_run(o_r, n, listed)
            if old is None:
                line = f"FIX UNVERIFIED: #{n} (fix {sha[:10]}) is not a run of {' or '.join(f[0] for f in flows.values())}"
            elif kind not in done or done[kind][0] is None:
                line = (f"FIX UNVERIFIED: no completed {flows[kind][0]} run containing {sha[:10]} when the watch ended "
                        f"(fix claimed #{old.get('number')})")
            else:
                new = done[kind][0]
                was = failed_jobs(o_r, old["databaseId"])
                now_ = job_results(o_r, new["databaseId"])
                again = [j for j in was if now_.get(j) in ("failure", "timed_out", "cancelled")]
                missing = [j for j in was if now_.get(j) != "success" and j not in again]
                if again:
                    line = (f"FIX FAILED: {flows[kind][0]} #{new.get('number')} still fails {', '.join(again)} "
                            f"(fix {sha[:10]} claimed #{old.get('number')})")
                elif missing:
                    line = (f"FIX UNVERIFIED: {flows[kind][0]} #{new.get('number')} did not run {', '.join(missing)} "
                            f"(fix {sha[:10]} claimed #{old.get('number')})")
                else:
                    line = f"FIX OK: #{old.get('number')} cleared by #{new.get('number')}"
        except (Exception, SystemExit) as e:
            line = f"FIX UNVERIFIED: #{n} (fix {sha[:10]}) could not be compared ({str(e)[:160]})"
        print(line, flush=True)
        inbox_write("watch", line, [line], [], 1 if line.startswith("FIX FAILED") else 0)


def _watch(repo, sha, pushed_at, o_r, flows, own, fixes=()):
    timeout = float(os.environ.get("AGENTCTL_WATCH_TIMEOUT", WATCH_TIMEOUT))
    conv_start = float(os.environ.get("AGENTCTL_WATCH_CONV_START", WATCH_CONV_START))
    t0 = time.time()
    err(f"watching Main and the convergence for {sha[:10]} (up to {int(timeout // 60)} min; `--no-watch` skips this)"
        + (f"; verifying Fixes-Red {', '.join(fixes)}" if fixes else ""))
    done, said, listed = {}, set(), {}  # kind -> (run, ok | None for none started); kind -> the runs last listed
    # NO PROGRESS: nothing about the followed runs (which run, its status, its last update) changed for this long ends
    # the watch with a named verdict (a queue Forgejo never serves, a runner lost mid-run), not a silent 3 h wait
    stall = float(os.environ.get("AGENTCTL_WATCH_STALL_MIN", WATCH_STALL_MIN)) * 60
    state, changed = None, time.time()
    delays = backoff(float(os.environ.get("AGENTCTL_WATCH_POLL", 60)), 300)
    # UNREACHABLE: a failed read backs off (to 5 min) and is retried until the watch's own bound; only then UNKNOWN,
    # saying for how long Forgejo could not be read (2026-10-27: ten failures in a row used to end it in minutes)
    unreachable, failures, last_error, err_delays = None, 0, "", None

    def verdict(rc, line):
        print(line, flush=True)
        if fixes:
            verify_fixes(o_r, sha, fixes, done, listed, flows)
        return rc

    while True:
        seen = {}
        try:
            for kind, (name, wfile) in flows.items():
                if kind in done:
                    continue
                runs = gh_json(o_r, "run", "list", "--workflow", wfile, "--branch", "main", "--limit", "30",
                               "--json", RUN_FIELDS)
                listed[kind] = runs
                run = pick_main_run(repo, sha, runs) if kind == "main" else pick_convergence_run(repo, sha, runs, pushed_at)
                if run is None:
                    if kind == "convergence" and time.time() - t0 >= conv_start:
                        done[kind] = (None, None)
                        print(f"convergence: none started within {int(conv_start // 60)} min of the push", flush=True)
                    continue
                seen[kind] = (run.get("databaseId"), run.get("status"), run.get("updatedAt"))
                if (kind, run["databaseId"]) not in said:
                    said.add((kind, run["databaseId"]))
                    err(f"{name}: following run #{run.get('number')} ({run.get('status')}, head {str(run.get('headSha'))[:10]})")
                if run.get("status") == "completed" and not is_cancelled(run):
                    done[kind] = (run, run.get("conclusion") == "success")
                    print(f"{name} #{run.get('number')}: {run.get('conclusion')}", flush=True)
            if unreachable is not None:
                err(f"watch: Forgejo answers again after {red_for(iso_at(unreachable))} ({failures} failed reads)")
            unreachable, failures, err_delays = None, 0, None
        except NoToken as e:  # no vault for this process: retrying cannot help
            return verdict(2, f"WATCH UNKNOWN: no Forgejo token ({str(e).replace('agentctl: ', '')}); "
                              f"check `agentctl ci-why` for {sha[:10]}")
        except Exception as e:  # a tunnel blip, Forgejo down: read again, backing off, until the bound
            failures += 1
            last_error = str(e)[:160]
            if unreachable is None:
                unreachable, err_delays = time.time(), backoff(float(os.environ.get("AGENTCTL_WATCH_ERROR_POLL", 30)), 300)
            err(f"watch: could not read the runs ({last_error}) [{failures} failed, unreachable for "
                f"{red_for(iso_at(unreachable))}]")
        reds = [(k, r) for k, (r, ok) in done.items() if ok is False]
        if reds:
            for kind, r in reds:
                try:
                    failed = failed_jobs(o_r, r["databaseId"])
                except (Exception, SystemExit) as e:  # the verdict stands without the job names
                    err(f"could not read the jobs of run {r['databaseId']} ({str(e)[:120]})")
                    failed = []
                print(f"WATCH RED: {flows[kind][0]} #{r.get('number')} {', '.join(failed) or r.get('conclusion')} "
                      f"(it contains your {sha[:10]}: if your change broke it, fix forward now with `Fixes-Red: "
                      f"{r.get('number')}`)", flush=True)
            try:
                print(ci_why(o_r, 4, repo=repo)[1])
            except (Exception, SystemExit) as e:
                print(f"(agentctl ci-why failed: {e})")
            if fixes:
                verify_fixes(o_r, sha, fixes, done, listed, flows)
            return 3
        if len(done) == len(flows):
            parts = [f"{flows[k][0].split()[0] if k == 'main' else 'convergence'} " +
                     (f"#{r.get('number')} green" if r else "none started") for k, (r, ok) in done.items()]
            return verdict(0, "WATCH OK: " + ", ".join(sorted(parts, key=lambda x: not x.startswith("Main"))))
        if time.time() - t0 >= timeout:
            left = ", ".join(flows[k][0] for k in flows if k not in done)
            if unreachable is not None:
                return verdict(2, f"WATCH UNKNOWN: Forgejo's runs could not be read for {red_for(iso_at(unreachable))} "
                                  f"({failures} failed reads, the last: {last_error}); {left} undecided after "
                                  f"{int(timeout // 60)} min; check `agentctl ci-why` later")
            return verdict(2, f"WATCH UNKNOWN: {left} undecided after {int(timeout // 60)} min; check `agentctl ci-why` "
                              "later")
        if unreachable is None:  # a failed read says nothing about the runs: no stall judged on it
            now_state = (tuple(sorted(done)), tuple(sorted(seen.items())))
            if now_state != state:
                state, changed = now_state, time.time()
            elif time.time() - changed >= stall:
                left = ", ".join(f"{flows[k][0]} {('run ' + str(v[0]) + ' ' + str(v[1])) if v else 'no run'}"
                                 for k, v in [(k, seen.get(k)) for k in flows if k not in done])
                return verdict(2, f"WATCH STALLED: no change in {left} for {int(stall // 60)} min; check `agentctl "
                                  "ci-why` later")
        restart_if_changed([own])
        time.sleep(next(err_delays) if unreachable is not None else next(delays))


def iso_at(t):
    return dt.datetime.fromtimestamp(t, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ---------------------------------------------------------------- waiting: production changes held while main is red
# The owner (2026-10-26): "when waiting for main to go green, merge all waiting changes into one waiting branch (always
# use the same name) and merge it when main is green". While the gate is red, `land` puts a production change onto the
# local branch `waiting` (worktree <main clone>-wt-waiting) instead of being refused: rebased onto it, the local checks
# run on the combined tip, `WAITING <sha> (n changes queued on waiting)`. One processor (`waiting run`, detached, locked)
# watches the gate; once main is green it rebuilds `waiting` on forgejo/main, runs the hook's dry run, pushes the whole
# branch in ONE push, deletes it, and every waiting `land` goes on to its LANDED and WATCH. Tools-only commits and
# Fixes-Red fixes never wait (the hook lets them land while red). Replaces the merge queue.
WAITING_BRANCH = "waiting"
WAITING_DIR = os.path.join(HOME, ".cache", "agentctl", "waiting")
PRODUCTION_GLOBS = ("*/src/main/*", "conf/*", "*/conf/*", "build.sbt", "project/*", "infra/nix/*", "infra/kubernetes/*",
                    "Dockerfile")
WAITING_AWAIT_TIMEOUT = 24 * 3600
WAITING_POLL = 60          # the processor's gate poll floor (backs off to 300 s)
WAITING_HELP = """While main is red, a production change that passed its OWN checks (land runs them first, red or green) joins
ONE local branch, `waiting`, by cherry-pick (land: WAITING <sha> (entry <id>, n in batch), exit 0). At green the
processor rebuilds `waiting` on main, runs ONE fast check of the batch (pre-push --fast-only: compile and the fast tests,
a fresh sbt server, a stall retried once then HELD), pushes it in one push, bisects a failing batch by prefix and rejects
only the culprit. A Fixes-Red entry goes first. Every verdict (LANDED, NOT LANDED, HELD, each landed entry's detached
WATCH) goes to `agentctl inbox`.

  agentctl waiting status                       # the entries, the batch being checked, a HELD batch, the gate
  agentctl waiting cancel <id>                  # drop a change; `waiting` is rebuilt without it
  agentctl waiting pause|resume                 # stop / restart taking batches (joins still queue)
  agentctl waiting run [--once] [--service]     # the processor (land starts it detached; one at a time, by lock)
  agentctl waiting service install|uninstall|status   # it as the launchd agent net.bitcashier.agentctl-waiting"""


def is_production_path(p):
    """movies' pre-push is_production_path: what reaches a pod or a fleet host (the rest lands while red)."""
    return any(fnmatch.fnmatch(p, g) for g in PRODUCTION_GLOBS)


GATE_UNREAD = "unread"  # gate_reds' member when the gate could not be read: never green, and no Fixes-Red matches it
gate_unread_why = [""]


def gate_reds(repo):
    """The ids (run numbers and run ids) of the gating workflows' red runs on main; empty when green or not gated.
    When the gate cannot be read: {GATE_UNREAD}, which every caller takes as RED -- a production change waits, the
    processor takes no batch (the owner, 2026-10-27: an unread gate is never green; at 08:05Z a launchd processor with
    no Forgejo token read it as green, and the hook, with no token either, skipped its own gate: a push onto red #2047)."""
    try:
        o_r = slug(repo)
        if o_r not in GATING:
            return set()
        reds = set()
        for _name, decided, _newer, _streak in gate_runs(o_r):
            if decided and decided.get("conclusion") != "success":
                reds |= {str(decided.get("number")), str(decided.get("databaseId"))}
        gate_unread_why[0] = ""
        return reds
    except (Exception, SystemExit) as e:  # SystemExit: NoToken
        gate_unread_why[0] = str(e).replace("agentctl: ", "")[:200]
        err(f"could not read the gate ({gate_unread_why[0]}): taken as RED until it is read")
        return {GATE_UNREAD}


def waiting_supported(repo):
    """A repo hook, if any, must have --checks-only (its checks without the red gate) to check a waiting tip."""
    hook = precheck_hook(repo)
    if not hook:
        return True
    with open(hook) as f:
        return "--checks-only" in f.read()


def waiting_commits(repo, base, head):
    return git(repo, "rev-list", "--reverse", f"{base}..{head}").split()


def must_wait(repo, commits, reds):
    """A production commit with no Fixes-Red: naming a red run waits; tools-only and declared fixes go (the hook's rule)."""
    for c in commits:
        paths = git(repo, "diff-tree", "--no-commit-id", "--name-only", "-r", "--root", "-m", c).split("\n")
        if not any(p and is_production_path(p) for p in paths):
            continue
        fixes = git(repo, "log", "-1", "--format=%(trailers:key=Fixes-Red,valueonly,separator=%x2C)", c).strip()
        if not ({f.strip().lstrip("#") for f in fixes.split(",") if f.strip()} & reds):
            return True
    return False


def waiting_state(repo):
    common = os.path.realpath(git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir").strip())
    d = os.path.join(WAITING_DIR, re.sub(r"[^A-Za-z0-9._-]", "_", common.strip("/")))
    os.makedirs(os.path.join(d, "entries"), exist_ok=True)
    clone = os.path.dirname(common) if os.path.basename(common) == ".git" else common
    return d, clone, f"{clone}-wt-waiting"


def waiting_entries(d, open_only=True):
    out = []
    for p in sorted(glob.glob(os.path.join(d, "entries", "*.json"))):
        try:
            with open(p) as f:
                e = json.load(f)
        except (OSError, ValueError):
            continue
        if not open_only or e.get("status") == "waiting":
            out.append(e)
    return sorted(out, key=lambda e: e["seq"])


def save_entry(d, e):
    p = os.path.join(d, "entries", f"{e['id']}.json")
    with open(p + ".tmp", "w") as f:
        json.dump(e, f, indent=1)
    os.replace(p + ".tmp", p)


def wlog(d, msg):
    with open(os.path.join(d, "processor.log"), "a") as f:
        f.write(f"{ts()} {msg}\n")


def ensure_waiting_tree(repo, wt):
    if not os.path.isdir(wt):
        if git_ok(repo, "rev-parse", "--verify", "-q", f"refs/heads/{WAITING_BRANCH}"):
            git(repo, "worktree", "add", "-q", wt, WAITING_BRANCH)
        else:
            git(repo, "worktree", "add", "-q", "-b", WAITING_BRANCH, wt, f"{REMOTE}/main")
    return wt


def drop_waiting_tree(repo, wt):
    if os.path.isdir(wt):
        git(repo, "worktree", "remove", "--force", wt, check=False)
    git(repo, "worktree", "prune", check=False)
    git(repo, "branch", "-D", WAITING_BRANCH, check=False)


def pick(wt, commits):
    """Cherry-pick commits onto wt's HEAD: None, or the conflicting files (the pick aborted)."""
    r = git(wt, "cherry-pick", "--allow-empty", "--keep-redundant-commits", *commits, check=False)
    if r.returncode == 0:
        return None
    files = git(wt, "diff", "--name-only", "--diff-filter=U", check=False).stdout.split()
    git(wt, "cherry-pick", "--abort", check=False)
    return files or [r.stderr.strip()[:200]]


def run_hook(wt, mode, base):
    """(ok, output) of the checkout's scripts/hooks/pre-push <mode> base..HEAD; (True, '') when the repo has no hook."""
    hook = precheck_hook(wt)
    if not hook:
        return True, ""
    with open(hook) as f:
        has_checks_only = "--checks-only" in f.read()
    if mode == "--checks-only" and not has_checks_only:
        return False, ("scripts/hooks/pre-push has no --checks-only mode (the checks without the red gate) at this base: "
                       "the waiting branch needs the hook from movies' 'waiting' change")
    head = git(wt, "rev-parse", "HEAD").strip()
    lock_note(f"{mode} checks on `{WAITING_BRANCH}`")
    rc, out = run_watched([hook, mode, f"{base}..{head}"], wt, tool_env(), os.path.join(scratch(), f"agentctl-waiting-{os.getpid()}"),
                          "waiting-checks")
    if rc is None:
        mins = float(os.environ.get("AGENTCTL_LAND_STALL_MIN", LAND_STALL_MIN))
        return False, f"{out}\nstalled: scripts/hooks/pre-push {mode}: no output and no CPU for {mins:g} min, so it was ended"
    return rc == 0, out


def tail_of(out, n=25):
    return "\n  ".join([l for l in out.splitlines() if l.strip()][-n:])


def batching(repo):
    """Whether land batches here (every change joins `waiting`): a repo hook with --checks-only (movies)."""
    hook = precheck_hook(repo)
    return bool(hook) and waiting_supported(repo)


def fixes_of(repo, commits):
    """The run ids/numbers the commits' Fixes-Red: trailers name."""
    out = set()
    for c in commits:
        v = git(repo, "log", "-1", "--format=%(trailers:key=Fixes-Red,valueonly,separator=%x2C)", c).strip()
        out |= {f.strip().lstrip("#") for f in v.split(",") if f.strip()}
    return out


def batch_order(repo, entries, reds):
    """The order a batch is built in: a fix for the current red first, then (main red) what may land while red -- tools
    only, or every commit carrying a Fixes-Red for a red run -- then the rest; by join order within each."""
    def rank(e):
        if reds and set(e.get("fixes") or []) & reds:
            return 0
        if reds and not must_wait(repo, e["commits"], reds):
            return 1
        return 2
    return sorted(entries, key=lambda e: (rank(e), e["seq"]))


def join(repo, main_ref, sh, log_path, a, head=None):
    """Under the landing lock, in seconds: the change (its own checks passed) joins `waiting`, rebuilt on forgejo/main.
    Rejected only on a cherry-pick conflict. Prints `WAITING <tip> (entry <id>, n in batch)`, starts the processor."""
    lock_note("join `waiting`")
    if head is None:
        rc, head = sync(repo, main_ref, sh)
        if rc is not None:
            return rc
    d, _clone, wt = waiting_state(repo)
    commits = waiting_commits(repo, f"{REMOTE}/main", head)
    reds = gate_reds(repo)
    ensure_waiting_tree(repo, wt)
    base = git(repo, "rev-parse", main_ref).strip()
    rebuild(repo, d, wt, batch_order(repo, waiting_entries(d), reds), base)
    before = git(wt, "rev-parse", "HEAD").strip()
    conflict = pick(wt, commits)
    if conflict:
        git(wt, "reset", "--hard", "-q", before)
        print(f"NOT LANDED: the change conflicts with the changes already on `{WAITING_BRANCH}` (rebuilt on {REMOTE}/main "
              f"{base[:10]}) in: {', '.join(conflict)}. Rebase onto them (git rebase {WAITING_BRANCH}) or wait for them "
              f"to land.")
        return 1
    seq = max([e["seq"] for e in waiting_entries(d, open_only=False)] + [0]) + 1
    e = {"id": f"{dt.datetime.now().strftime('%Y%m%d-%H%M%S')}-{os.path.basename(repo)}-{seq}", "seq": seq,
         "worktree": repo, "head": head, "commits": commits, "fixes": sorted(fixes_of(repo, commits)),
         "status": "waiting", "created": ts(), "tip": git(wt, "rev-parse", "HEAD").strip(),
         "follow": bool(getattr(a, "follow", False))}
    save_entry(d, e)
    if reds and set(e["fixes"]) & reds:  # a fix goes FIRST: the branch is rebuilt in batch order with it
        rebuild(repo, d, wt, batch_order(repo, waiting_entries(d), reds), base)
        e = next(x for x in waiting_entries(d) if x["id"] == e["id"])
    n = len(waiting_entries(d))
    with open(log_path, "a") as f:
        f.write(f"=== joined {ts()} {head} as {e['id']} ({n} on {WAITING_BRANCH})\n")
    print(f"WAITING {e['tip']} (entry {e['id']}, {n} in batch)", flush=True)
    a.waiting = e
    spawn_waiting_processor(repo)
    offer_token(repo)
    return 0


def processor_owned(d, repo=None):
    """The processor's ownership: one per waiting state directory (one per repository)."""
    return Owned("waiting", os.path.basename(d.rstrip("/")) or "repo", ["waiting", "run", "--repo", repo or ""])


def waiting_processor_alive(d):
    return lock_held(processor_owned(d).lockpath)


def spawn_waiting_processor(repo):
    d, clone, _w = waiting_state(repo)
    if waiting_processor_alive(d):
        return
    repo = clone if os.path.isdir(clone) else repo  # the clone, not a joiner's worktree: that one closes after WATCH OK
    with open(os.path.join(d, "processor.log"), "a") as logf:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "waiting", "run", "--repo", repo],
                         stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, start_new_session=True, cwd=repo,
                         env=detached_env(repo))


# THE TOKEN HAND-OFF. The processor as a launchd service, or detached once its land exits, gets no answer from the vault
# (an unlock belongs to the session that made it). So it listens on a unix socket (0600, in a 0700 directory) and a
# process that can read the vault -- every `land` that joins `waiting`, and `waiting status` / `resume` -- hands it the
# token. It lives only in the processor's memory and environment (a re-exec keeps it; the push's hook and the watches it
# starts inherit it), never on disk. Until it has one, the gate is unread: taken as red, said once in the inbox.
def token_sock_path(d):
    import hashlib
    base = os.environ.get("AGENTCTL_SOCK_DIR") or f"/tmp/agentctl-{os.getuid()}"  # short: a socket path is <= 104 bytes
    return os.path.join(base, hashlib.sha1(os.path.abspath(d).encode()).hexdigest()[:12] + ".sock")


TOKEN_SHAPE = re.compile(r"[\w.~+/=-]{8,512}")


class TokenDrop:
    """The processor's end of the hand-off."""

    def __init__(self, d, o_r):
        self.path, self.o_r, self.sock = token_sock_path(d), o_r, None

    def open(self):
        import socket
        try:
            os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
            os.chmod(os.path.dirname(self.path), 0o700)
            if os.path.exists(self.path):
                os.unlink(self.path)
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            old = os.umask(0o177)
            try:
                s.bind(self.path)
            finally:
                os.umask(old)
            s.listen(4)
            self.sock = s
        except OSError as e:
            err(f"no token hand-off socket ({e}): the processor reads the vault itself")
        return self

    def nap(self, secs):
        """Sleep secs; take a token handed over meanwhile."""
        if not self.sock:
            time.sleep(secs)
            return
        import select
        end = time.time() + secs
        while True:
            left = end - time.time()
            if left <= 0:
                return
            ready, _, _ = select.select([self.sock], [], [], left)
            if ready:
                self.take()

    def take(self):
        try:
            conn, _ = self.sock.accept()
        except OSError:
            return
        with conn:
            conn.settimeout(5)
            try:
                tok = conn.recv(4096).decode().strip()
            except (OSError, UnicodeDecodeError):
                return
            if TOKEN_SHAPE.fullmatch(tok):
                os.environ["FORGEJO_API_TOKEN" if token_ns(self.o_r) == "movies" else "GH_TOKEN"] = tok
                err("the Forgejo token was handed over: the gate is read again")

    def close(self):
        if self.sock:
            self.sock.close()
            self.sock = None
            try:
                os.unlink(self.path)
            except OSError:
                pass


def offer_token(repo):
    """Hand this process's Forgejo token to the repo's waiting processor when it listens (see THE TOKEN HAND-OFF). Never
    fatal; True when handed over."""
    import socket
    try:
        d, _c, _w = waiting_state(repo)
        path = token_sock_path(d)
        if not os.path.exists(path):
            return False
        tok = token(slug(repo))
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(3)
            s.connect(path)
            s.sendall(tok.encode())
        return True
    except (Exception, SystemExit):
        return False


def await_entry(repo, eid, close=None):
    """Block until the entry lands or is rejected: (rc, landed sha, pushed_at). Restarts a dead processor. OWNED (one
    awaiter per entry; on agentctl's new code it re-execs as `agentctl waiting await <entry>`, which then watches)."""
    own = Owned("await", eid, ["waiting", "await", eid, "--repo", repo] + (["--close", close] if close else []))
    if not own.acquire():
        h = own.holder or {}
        print(f"NOT LANDED (still waiting): entry {eid} is already awaited by pid {h.get('pid')} ({h.get('owner')})")
        return 2, None, None
    try:
        return _await_entry(repo, eid, own)
    finally:
        own.release()


def _await_entry(repo, eid, own):
    d, _c, _w = waiting_state(repo)
    p = os.path.join(d, "entries", f"{eid}.json")
    t0, delays = time.time(), backoff(15, 60)
    timeout = float(os.environ.get("AGENTCTL_WAITING_TIMEOUT", WAITING_AWAIT_TIMEOUT))
    while True:
        with open(p) as f:
            e = json.load(f)
        if e["status"] == "landed":
            print(f"LANDED {e['landed_sha']} (with the {e.get('batch', 1)} change(s) of `{WAITING_BRANCH}`, once main was green)",
                  flush=True)
            return 0, e["landed_sha"], e.get("pushed_at")
        if e["status"] in ("rejected", "cancelled"):
            print(f"NOT LANDED: {e.get('why') or e['status']}")
            return 1, None, None
        if time.time() - t0 > timeout:
            print(f"NOT LANDED (still waiting): entry {eid} on `{WAITING_BRANCH}` after {int(timeout // 3600)} h; "
                  "`agentctl waiting status`")
            return 2, None, None
        spawn_waiting_processor(repo)
        restart_if_changed([own])
        time.sleep(next(delays))


def reject(d, e, why):
    e.update(status="rejected", why=why, decided=ts())
    save_entry(d, e)
    wlog(d, f"rejected {e['id']}: {why.splitlines()[0]}")


def rebuild(repo, d, wt, entries, base):
    """`waiting` = base + each entry's commits, in order; a conflicting entry is rejected alone. Returns the kept ones."""
    git(wt, "reset", "--hard", "-q", base)
    kept = []
    for e in entries:
        conflict = pick(wt, e["commits"])
        if conflict:
            reject(d, e, f"main moved while it waited and the change no longer applies (conflicts in: "
                         f"{', '.join(conflict)}): rebase onto forgejo/main and land again")
            continue
        e["tip"] = git(wt, "rev-parse", "HEAD").strip()
        kept.append(e)
    return kept


def batch_state(d):
    try:
        with open(os.path.join(d, "batch.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_batch_state(d, st):
    with open(os.path.join(d, "batch.json.tmp"), "w") as f:
        json.dump(st, f, indent=1)
    os.replace(os.path.join(d, "batch.json.tmp"), os.path.join(d, "batch.json"))


def batch_tree(repo, sha):
    """A detached worktree of the clone at `sha`: the batch is checked there, so `waiting` keeps taking joins."""
    _d, clone, wt = waiting_state(repo)
    bwt = f"{clone}-wt-batch"
    if not os.path.isdir(bwt):
        git(repo, "worktree", "prune", check=False)
        git(repo, "worktree", "add", "-q", "--detach", bwt, sha)
    else:
        git(bwt, "checkout", "-q", "--force", "--detach", sha)
    return bwt


def sbt_stop(tree):
    """A FRESH sbt server for the batch check: stop the tree's server and keeper (scripts/sbt-warm --stop), if any."""
    script = os.path.join(tree, "scripts", "sbt-warm")
    if os.access(script, os.X_OK):
        try:
            subprocess.run([script, "--stop"], cwd=tree, capture_output=True, text=True, timeout=180, env=tool_env())
        except subprocess.TimeoutExpired:
            err(f"sbt-warm --stop in {tree} took over 3 min")


STALL_SIGNAL = re.compile(r"(^|\s)(pre-push |sbt-warm )?STALLED:", re.M)
BATCH_HOLD = 30 * 60


def batch_mode(hook):
    """The combined check's hook mode: `--fast-only` (compile of every test config and the fast tests: every change
    passed its own full checks before it joined) when the hook has it, else the full `--range` dry run."""
    try:
        with open(hook) as f:
            return "--fast-only" if "--fast-only" in f.read() else "--range"
    except OSError:
        return "--range"


def batch_check(repo, d, tree, base, tip):
    """The hook's dry run over base..tip in `tree` (the basic checks plus every touched area's), on a fresh sbt server,
    under the stall abort. (ok, output, stalled): a stall -- land's 20 min, or the hook's exit 75 / `STALLED:` -- is
    retried once on a fresh server; stalled twice, `stalled` is True."""
    hook = precheck_hook(tree) or precheck_hook(repo)
    if not hook:
        return True, "", False
    out = ""
    for attempt in (1, 2):
        batch_tree(repo, tip)
        sbt_stop(tree)
        wlog(d, f"checking {base[:10]}..{tip[:10]} (attempt {attempt}, fresh sbt server)")
        with check_slot(repo, f"waiting batch {tip[:10]}") as slot:
            rc, out = run_watched([hook, batch_mode(hook), f"{base}..{tip}"], tree, tool_env(),
                                  os.path.join(d, f"check-{tip[:10]}"), f"batch-check-{attempt}", sampler=slot.sample)
            slot.done(rc, out)
        sbt_stop(tree)
        with open(os.path.join(d, "checks.log"), "a") as f:
            f.write(f"=== {ts()} {base[:10]}..{tip[:10]} attempt {attempt} rc {rc}\n{out}\n")
        if rc is None or rc == 75 or STALL_SIGNAL.search(out or ""):
            wlog(d, f"the check of {tip[:10]} STALLED (attempt {attempt})")
            continue
        return rc == 0, out, False
    return False, out, True


def push_batch(repo, d, entries, tip, base, how):
    """Under the lock: push `tip` (main still at `base`) through the hook. 'landed' | 'moved' | 'red' | 'failed'."""
    with land_lock(repo) as held:
        if not held:
            return "moved"
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
        if git(repo, "rev-parse", f"{REMOTE}/main").strip() != base:
            wlog(d, f"main moved during the check of {tip[:10]}: the batch is rebuilt and checked again")
            return "moved"
        lock_note(f"push of the batch {tip[:10]}")
        pushed_at = time.time()
        tree = batch_tree(repo, tip)  # the push's hook runs in the tree it checked, so it reuses that pass
        env = dict(tool_env(), PREPUSH_REUSE_FAST="1")  # the batch's fast pass stands for the push (pre-push --fast-only)
        rc, out = run_watched(push_argv(REMOTE, tip), tree, env, os.path.join(d, f"push-{tip[:10]}"), "push")
        with open(os.path.join(d, "checks.log"), "a") as f:
            f.write(f"=== push {ts()} {tip[:10]} rc {rc}\n{out}\n")
        if rc is None:
            wlog(d, f"the push of {tip[:10]} stalled")
            return "failed"
        if rc != 0:
            if REDGATE.search(out):
                wlog(d, "the gate went red before the push: waiting")
                return "red"
            if RACE.search(out):
                return "moved"
            wlog(d, f"the push of {tip[:10]} failed:\n  {tail_of(out, 12)}")
            return "failed"
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
        if not landed(repo, tip, f"refs/remotes/{REMOTE}/main"):
            return "moved"
    for e in entries:
        e.update(status="landed", landed_sha=e["tip"], pushed_at=pushed_at, batch=len(entries), decided=ts())
        save_entry(d, e)
        inbox_write("land", f"LANDED {e['tip']} ({how}: {len(entries)} change(s) in one push)", [f"LANDED {e['tip']}"],
                    [], 0, cwd=e["worktree"])
        spawn_watch(repo, e, pushed_at)
    wlog(d, f"LANDED {tip} ({len(entries)} change(s) in one push)")
    return "landed"


def spawn_watch_of(repo, sha, pushed_at, close=None, fixes=()):
    """A DETACHED `agentctl watch` of sha (its own session): its verdict goes to the inbox, agent alive or not. It is
    handed the Forgejo token (token_env): once land exits, the vault no longer answers it."""
    d = os.path.join(HOME, ".cache", "agentctl")
    os.makedirs(d, exist_ok=True)
    argv = [sys.executable, os.path.realpath(__file__), "watch", "--repo", repo, "--sha", sha,
            "--pushed-at", str(pushed_at or time.time())] + (["--close", close] if close else []) + \
        [x for f in fixes for x in ("--fixes", str(f))]
    with open(os.path.join(d, "watches.log"), "a") as logf:
        subprocess.Popen(argv, cwd=repo, stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, start_new_session=True,
                         env=detached_env(repo))


def spawn_watch(repo, e, pushed_at):
    """A DETACHED watch of a landed entry (its own session): its WATCH verdict goes to the inbox whether or not the agent
    that joined lives. Not when a `land --follow` (or an older land's await) waits on the entry: that one watches."""
    if lock_held(Owned("await", e["id"]).lockpath):
        return
    where = e["worktree"] if os.path.isdir(e["worktree"]) else repo
    d, _c, _w = waiting_state(repo)
    argv = [sys.executable, os.path.realpath(__file__), "watch", "--repo", where, "--sha", e["tip"],
            "--pushed-at", str(pushed_at)] + (["--close", e["worktree"]] if os.path.isdir(e["worktree"]) else []) + \
        [x for f in e.get("fixes") or [] for x in ("--fixes", str(f))]
    with open(os.path.join(d, "watches.log"), "a") as logf:
        subprocess.Popen(argv, cwd=where, stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, start_new_session=True,
                         env=detached_env(repo))


def bisect(repo, d, batch, base):
    """The batch failed: the first entry whose prefix fails (binary search over the prefixes' tips). (index, output) of
    the culprit; (None, output) when the whole batch passes on its own again (flaky or infra)."""
    _d, _c, _w = waiting_state(repo)
    bwt = batch_tree(repo, batch[-1]["tip"])
    lo, hi, out_hi = 0, len(batch) - 1, ""
    ok, out, stalled = batch_check(repo, d, bwt, base, batch[hi]["tip"])
    if ok or stalled:
        return None, out
    out_hi = out
    while lo < hi:
        mid = (lo + hi) // 2
        ok, out, stalled = batch_check(repo, d, bwt, base, batch[mid]["tip"])
        if stalled:
            return None, out
        if ok:
            lo = mid + 1
        else:
            hi, out_hi = mid, out
    return lo, out_hi


def unread_note(d, reds, entries):
    """The gate unread while changes wait: once per unread spell, an UNKNOWN inbox entry (they would wait unseen)."""
    flag = os.path.join(d, "GATE_UNREAD")
    if GATE_UNREAD not in reds:
        if os.path.exists(flag):
            os.unlink(flag)
        return
    if os.path.exists(flag):
        return
    open(flag, "w").write(ts() + "\n")
    wlog(d, f"the gate is unread ({gate_unread_why[0]}): taken as red")
    inbox_write("waiting", f"UNKNOWN: the waiting processor cannot read the gate ({gate_unread_why[0]}); {len(entries)} "
                           "change(s) wait, taken as red. Hand it the token: `~/bin/agentctl waiting status` from a session "
                           "with the vault unlocked", [], [], 2, cwd=entries[0].get("worktree") if entries else None)


def waiting_round(repo, d, wt):
    """One batch: 'empty', 'paused', 'held', 'red' (nothing may go while red), 'landed', 'rejected', 'retry'.

    Under the lock (seconds): fetch, rebuild `waiting` on forgejo/main in batch order, take the batch -- every entry, or
    while main is red only what may land while red, and only once a Fixes-Red entry for the red run is among them.
    Released, one check of the batch's tip (a fresh sbt server, the stall abort; a stall is retried once, then the batch
    is HELD with an inbox entry). Pass: one push of the tip through the hook, every entry LANDED. Fail: bisect by
    prefix, reject only the culprit (NOT LANDED with the failing tail, to the inbox), land the passing prefix before it.
    Entries that join meanwhile wait for the next batch."""
    entries = waiting_entries(d)
    if not entries:
        return "empty"
    st = batch_state(d)
    if os.path.exists(os.path.join(d, "PAUSED")):
        return "paused"
    if st.get("held_until", 0) > time.time():
        return "held"
    reds = gate_reds(repo)
    unread_note(d, reds, entries)
    with land_lock(repo) as held:
        if not held:
            return "retry"
        lock_note("rebuild `waiting` for a batch")
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
        ensure_waiting_tree(repo, wt)
        base = git(repo, "rev-parse", f"{REMOTE}/main").strip()
        kept = rebuild(repo, d, wt, batch_order(repo, entries, reds), base)
    for e in [e for e in entries if e not in kept]:
        inbox_write("land", f"NOT LANDED: {e.get('why', 'rejected').splitlines()[0]}", [], [], 1, cwd=e["worktree"])
    if not kept:
        return "rejected"
    if reds:
        batch = [e for e in kept if not must_wait(repo, e["commits"], reds)]
        if not any(set(e.get("fixes") or []) & reds for e in batch):
            return "red"
    else:
        batch = kept
    tip = batch[-1]["tip"]
    save_batch_state(d, {"checking": [e["id"] for e in batch], "tip": tip, "base": base, "since": ts()})
    bwt = batch_tree(repo, tip)
    ok, out, stalled = batch_check(repo, d, bwt, base, tip)
    save_batch_state(d, {})
    if stalled:
        until = time.time() + float(os.environ.get("AGENTCTL_BATCH_HOLD", BATCH_HOLD))
        save_batch_state(d, {"held_until": until, "why": f"the check of {tip[:10]} stalled twice, on fresh sbt servers"})
        inbox_write("waiting", f"HELD: the batch check of {tip[:10]} ({len(batch)} change(s)) stalled twice on a fresh "
                               f"sbt server; the changes stay on `{WAITING_BRANCH}`, checked again after "
                               f"{int((until - time.time()) // 60)} min", [], (out or "").splitlines()[-15:], 1, cwd=repo)
        wlog(d, f"HELD: the check of {tip[:10]} stalled twice")
        return "held"
    if ok:
        r = push_batch(repo, d, batch, tip, base, "batch")
        return {"landed": "landed", "red": "red"}.get(r, "retry")
    if REDGATE.search(out or ""):
        return "red"
    wlog(d, f"the batch {tip[:10]} failed its checks; bisecting by prefix")
    culprit, cout = bisect(repo, d, batch, base)
    if culprit is None:
        wlog(d, "every prefix passed on its own again (flaky or infra): checked again next round")
        return "retry"
    bad = batch[culprit]
    reject(d, bad, f"the checks failed with your change in the batch on `{WAITING_BRANCH}`:\n  {tail_of(cout)}")
    inbox_write("land", f"NOT LANDED: the checks failed with your change in the batch (entry {bad['id']})", [],
                cout.splitlines()[-25:], 1, cwd=bad["worktree"])
    if culprit > 0:  # the prefix before it passed its own check: it lands now; the rest join the next batch
        push_batch(repo, d, batch[:culprit], batch[culprit - 1]["tip"], base, "batch prefix before a rejected change")
    return "rejected"


SERVICE_IDLE_POLL = 30  # seconds between looks at an empty `waiting` (a directory listing: no git, no network)


def waiting_run(repo, once=False, service=False):
    """The processor: batches until `waiting` is empty -- or, as the launchd service, for good, looking at an empty
    `waiting` every SERVICE_IDLE_POLL s (a directory listing). Re-execs on agentctl's new code between batches. Wall-clock
    sleeps only: after the laptop sleeps it simply polls again."""
    d, _c, wt = waiting_state(repo)
    own = processor_owned(d, repo)
    if not own.acquire():
        return 0
    with contextlib.ExitStack() as stack:
        stack.callback(own.release)
        try:
            o_r = slug(repo)
        except (Exception, SystemExit):
            o_r = SHORT["movies"]
        drop = TokenDrop(d, o_r).open()
        stack.callback(drop.close)
        delays = backoff(float(os.environ.get("AGENTCTL_WAITING_POLL", WAITING_POLL)), 300)
        while True:
            restart_if_changed([own], ["waiting", "run", "--repo", repo] + (["--once"] if once else [])
                               + (["--service"] if service else []))
            if service and not waiting_entries(d):
                if os.path.isdir(wt) and not git_ok(repo, "rev-parse", "--verify", "-q", f"refs/heads/{WAITING_BRANCH}"):
                    drop_waiting_tree(repo, wt)
                if once:
                    return 0
                drop.nap(float(os.environ.get("AGENTCTL_SERVICE_POLL", SERVICE_IDLE_POLL)))
                continue
            state = waiting_round(repo, d, wt)
            if state == "empty":
                if not waiting_entries(d):
                    drop_waiting_tree(repo, wt)
                if service:
                    continue
                return 0
            if once:
                return 0
            if state in ("landed", "rejected"):
                delays = backoff(float(os.environ.get("AGENTCTL_WAITING_POLL", WAITING_POLL)), 300)
                continue
            drop.nap(next(delays) if state in ("red", "held", "paused") else 5)


