def last_ack(d):
    """When anything was last acknowledged (the newest file in acked/), 0 if never."""
    acked = os.path.join(d, "acked")
    try:
        return max([os.stat(acked).st_mtime] + [os.stat(os.path.join(acked, n)).st_mtime for n in os.listdir(acked)])
    except OSError:
        return 0.0


INBOX_WAIT_POLL = 1.0  # seconds between stat()s of the inbox directory ($AGENTCTL_INBOX_POLL)


def inbox_wait(kinds, since_ack=False, timeout=0, verbose=False):
    """THE NOTIFIER: block until an unread entry of `kinds` exists, print it (every one there is), exit 0; 2 at the
    timeout. Cheap: one stat() of the inbox directory (and of acked/) a second, the entries read again only when either
    changed (a new entry is an os.replace into the directory, an ack a file in acked/). No Forgejo, no git."""
    d = inbox_dir()
    os.makedirs(d, exist_ok=True)
    want = {k.strip().upper().replace("-", "_") for k in kinds.split(",") if k.strip()}
    floor = last_ack(d) if since_ack else 0.0
    poll = float(os.environ.get("AGENTCTL_INBOX_POLL", INBOX_WAIT_POLL))
    t0, seen = time.time(), None
    while True:
        try:
            stamp = (os.stat(d).st_mtime_ns, os.stat(os.path.join(d, "acked")).st_mtime_ns
                     if os.path.isdir(os.path.join(d, "acked")) else 0)
        except OSError:
            stamp = None
        if stamp != seen:
            seen = stamp
            hits = [e for e in inbox_entries() if not e["read"] and (e.get("at") or 0) > floor
                    and (e.get("kind") or inbox_kind(e.get("verdict"), e.get("final", True))) in want]
            if hits:
                for e in hits:
                    print(entry_line(e))
                    if verbose:
                        for line in e.get("tail") or []:
                            print(f"    {line}")
                print(f"inbox: {len(hits)} to route; then `~/bin/agentctl inbox <id> --ack` and run `inbox wait` again")
                return 0
        if timeout and time.time() - t0 >= timeout:
            print(f"inbox: no unread {','.join(sorted(want))} entry within {int(timeout)} s")
            return 2
        time.sleep(poll)


def cmd_inbox(a):
    if a.ids[:1] == ["wait"]:
        if a.ids[1:]:
            print("usage: agentctl inbox wait [--kinds K,...] [--since-ack] [--timeout S]")
            return 2
        return inbox_wait(a.kinds, a.since_ack, a.timeout, a.verbose)
    entries = inbox_entries()
    if a.ids:
        entries = [e for e in entries if any(e["id"].startswith(i) for i in a.ids)]
    if a.unread:
        entries = [e for e in entries if not e["read"]]
    if a.limit:
        entries = entries[-a.limit:]
    if a.json:
        print(json.dumps(entries, indent=1))
    elif not entries:
        print("inbox: no " + ("unread " if a.unread else "") + f"entries ({inbox_dir()})")
    else:
        for e in entries:
            print(entry_line(e))
            if a.verbose:
                for line in e.get("tail") or []:
                    print(f"    {line}")
    if a.ack and entries:
        os.makedirs(os.path.join(inbox_dir(), "acked"), exist_ok=True)
        for e in entries:
            open(os.path.join(inbox_dir(), "acked", e["id"]), "a").close()
        print(f"inbox: acknowledged {len(entries)} entr{'y' if len(entries) == 1 else 'ies'}")
    return 0



