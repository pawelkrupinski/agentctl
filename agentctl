# ---------------------------------------------------------------- stale JVMs (folded in from reap-stale-jvms.sh)
# The owner (2026-10-27): ONE reaper. Its rules, unchanged from ~/.local/bin/reap-stale-jvms.sh (movies'
# scripts/reap-stale-jvms.sh, spec scripts/reap-stale-jvms-test.sh), which ran as launchd dev.kinowo.jvm-reaper:
#   orphan  an sbt worker / forked-test JVM whose parent is gone (PPID 1), 10 min or older: killed whatever its CPU;
#   hog     any sbt/java process 1.5 h or older that burned >= 5% of a core over its LIFETIME (cputime / elapsed, not ps's
#           decaying %CPU), with no tty (a human's terminal can Ctrl-C it), never a server a live `sbt-warm --keep`
#           keeps in its directory (2026-10-19 the hog rule killed one mid-use);
#   dup-sbt-server / dup-sbt-gone-dir   detached `sbt-launch --detach-stdio` servers (PPID 1) grouped by cwd: all but the
#           newest are reaped once 10 min old and IDLE now (recent %CPU <= 5: 2026-10-15 one was killed at 120% mid-run),
#           and a server whose cwd is gone (a `<dir>.part` whose `<dir>` exists is a finished rename, not gone).
# Spared always: IDEs and the protected names (PROTECT_REGEX), a listener on a protected port (9000) under 50% of a core,
# this reaper's own process group, and -- agentctl's rule -- any process descended from a live Claude Code session or a
# running land / check / waiting processor (another agent's working process). Before killing: the list; an sbt server
# gets a thread dump first; TERM, then KILL after 10 s; every kill one line of ~/.cache/agentctl/reap.log.
JVM_PROTECT = r"kinowo\.longrun|scripts\.IdentityCalibrate|JetBrains|IntelliJ|IDEA|Android Studio|jetbrains|toolbox|/Applications/|GradleDaemon|KotlinCompileDaemon|jdk.jcmd|VisualVM|jconsole"
JVM_SCOPE = r"(^|/)java( |$)|(^|/)java$|sbt-launch\.jar|org\.scala-sbt|sbt\.internal|sbt\.ForkMain"
JVM_ORPHAN = r"sbt\.internal\.worker[0-9]*\.WorkerMain|sbt\.ForkMain|org\.scala\.sbt\.ForkMain"
AGENT_WORK = re.compile(r"(^|/)claude( |$)|agentctl (land|waiting run|red fixer)\b|scripts/hooks/pre-push|scripts/sbt-warm")


def jvm_knob(name, default):
    """The old script's tunables, by the same names ($HOG_MIN_AGE_SECONDS, ...)."""
    return os.environ.get(name, default)


def tosec(t):
    """ps's [[dd-]hh:]mm:ss[.frac] (etime) or unbounded mm:ss (cputime) -> seconds."""
    dd = 0
    t = str(t)
    if "-" in t:
        d_, t = t.split("-", 1)
        dd = int(d_ or 0)
    s = 0.0
    for part in t.split(":"):
        try:
            s = s * 60 + float(part)
        except ValueError:
            return 0.0
    return s + dd * 86400


def jvm_candidates(rows, cwd, kept, port_pids, self_pid, isdir=os.path.isdir):
    """rows: [(pid, ppid, tty, etime, cputime, args)] -> [(pid, ppid, age, cpu, pct, rule, args)]: the old script's
    rules A (orphan), B (hog) and C (dup-sbt-server, dup-sbt-gone-dir), exactly."""
    hog_age, hog_cpu = float(jvm_knob("HOG_MIN_AGE_SECONDS", 5400)), float(jvm_knob("HOG_MIN_CPU_PERCENT", 5))
    orphan_age = float(jvm_knob("ORPHAN_MIN_AGE_SECONDS", 600))
    no_tty = str(jvm_knob("HOG_REQUIRE_NO_TTY", "1")) == "1"
    port_max = float(jvm_knob("PROTECTED_PORT_MAX_CPU_PERCENT", 50))
    protect, scope = re.compile(jvm_knob("PROTECT_REGEX", JVM_PROTECT)), re.compile(jvm_knob("SCOPE_REGEX", JVM_SCOPE))
    orphan_re = re.compile(jvm_knob("ORPHAN_REGEX", JVM_ORPHAN))
    out, servers = [], {}
    for pid, ppid, tty, etime, cputime, args in rows:
        if pid == self_pid or pid <= 1 or not scope.search(args) or protect.search(args):
            continue
        age, cpu = tosec(etime), tosec(cputime)
        pct = cpu * 100.0 / age if age > 0 else 0.0
        if pid in port_pids and pct <= port_max:
            continue
        rule = None
        if orphan_re.search(args) and ppid == 1 and age >= orphan_age:
            rule = "orphan"
        elif age >= hog_age and pct >= hog_cpu and not ("--detach-stdio" in args and pid in cwd and cwd[pid] in kept):
            if no_tty and tty not in ("??", "?", "-"):
                continue
            rule = "hog"
        if rule is None and ppid == 1 and "sbt-launch.jar" in args and "--detach-stdio" in args and pid in cwd:
            servers[pid] = (age, cpu, pct, args)
            continue
        if rule:
            out.append((pid, ppid, age, cpu, pct, rule, args))
    dirs, newest = {}, {}
    for pid in servers:
        d = re.sub(r"\.part$", "", cwd[pid])
        dirs[pid] = d
        n = newest.get(d)
        if n is None or servers[pid][0] < servers[n][0] or (servers[pid][0] == servers[n][0] and pid > n):
            newest[d] = pid
    for pid, (age, cpu, pct, args) in servers.items():
        d = dirs[pid]
        if not isdir(d) and not isdir(d + ".part"):
            rule = "dup-sbt-gone-dir"
        elif newest[d] != pid and age >= orphan_age:
            rule = "dup-sbt-server"
        else:
            continue
        out.append((pid, 1, age, cpu, pct, rule, f"{args} cwd={d}"))
    return sorted(out)


def jvm_scan():
    """The live process table for jvm_candidates ($AGENTCTL_JVM_PS / _CWD / _KEPT: fixture files for the tests)."""
    def read(env, cmd):
        if os.environ.get(env):
            with open(os.environ[env]) as f:
                return f.read()
        return subprocess.run(cmd, shell=True, capture_output=True, text=True).stdout
    rows = []
    for line in read("AGENTCTL_JVM_PS", "ps -Ao pid=,ppid=,tty=,etime=,cputime=,args=").splitlines():
        f = line.split(None, 5)
        if len(f) == 6 and f[0].isdigit() and f[1].isdigit():
            rows.append((int(f[0]), int(f[1]), f[2], f[3], f[4], f[5]))
    cwd = {}
    if os.environ.get("AGENTCTL_JVM_CWD"):
        read_cwd = read("AGENTCTL_JVM_CWD", "").splitlines()
    else:  # pid-scoped: the java processes of the ps rows above, never a machine-wide lsof
        jp = [r_[0] for r_ in rows if re.search(r"(^|/)java(\s|$)", r_[5].split(" ", 1)[0] if r_[5] else "")]
        read_cwd = [f"{p_} {d_}" for p_, d_ in lsof_cwds(jp).items()] if jp else []
    for line in read_cwd:
        p, _, d = line.partition(" ")
        if p.isdigit() and allowed_path(d):
            cwd[int(p)] = d
    if os.environ.get("AGENTCTL_JVM_KEPT"):
        kept = {l.strip() for l in read("AGENTCTL_JVM_KEPT", "").splitlines() if l.strip() and allowed_path(l.strip())}
    else:
        kp = [r_[0] for r_ in rows if "sbt-warm --keep" in r_[5]]
        kept = set(lsof_cwds(kp).values()) if kp else set()
    ports = set()
    if not os.environ.get("AGENTCTL_JVM_PS"):
        for port in str(jvm_knob("PROTECTED_PORTS", "9000")).split():
            r = subprocess.run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"], capture_output=True, text=True)
            ports |= {int(x) for x in r.stdout.split() if x.isdigit()}
    return rows, cwd, kept, ports


def agent_work(pid, procs):
    """The live Claude session or land / check / waiting processor pid descends from, if any: another agent's work."""
    parents = {p: (pp, c) for p, pp, _e, c in procs}
    seen, p = set(), parents.get(pid, (None, ""))[0]
    while p and p > 1 and p not in seen:
        seen.add(p)
        pp, c = parents.get(p, (None, ""))
        if AGENT_WORK.search(c or ""):
            return f"pid {p} ({(c or '')[:60]})"
        p = pp
    return None


def jvm_reap(cands, kill, procs):
    """List the candidates; with kill, end them under the guards (idle duplicate, alive, not this group, no agent's
    work), sbt servers after a thread dump, TERM then KILL. Returns the lines printed."""
    lines = []
    grace = float(jvm_knob("TERM_GRACE_SECONDS", 10))
    own_pgid = os.getpgid(0)
    for pid, ppid, age, cpu, pct, rule, args in cands:
        short = re.sub(r"-Duser\.(country|language)=[A-Za-z]+ ?", "", args)[:150]
        detail = f"pid={pid} ppid={ppid} rule={rule} age={int(age // 3600)}h{int(age % 3600 // 60)}m cpu={pct:.1f}%-of-a-core cmd=[{short}]"
        lines.append(f"jvm       {detail}")
    for l in lines:
        print(l)
    if not kill:
        return lines
    for pid, ppid, age, cpu, pct, rule, args in cands:
        why = None
        if rule == "dup-sbt-server":
            r = subprocess.run(["ps", "-o", "%cpu=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
            try:
                if float(r) > float(jvm_knob("DUP_MAX_RECENT_CPU_PERCENT", 5)):
                    why = f"busy now ({r}% CPU), not idle"
            except ValueError:
                pass
        if why is None and not pid_alive(pid):
            why = "already gone"
        if why is None:
            try:
                if os.getpgid(pid) == own_pgid:
                    why = "own process group"
            except OSError:
                why = "already gone"
        if why is None:
            w = agent_work(pid, procs)
            if w:
                why = f"another agent's working process (under {w})"
        if why:
            print(f"skip jvm pid {pid} ({rule}): {why}")
            reap_log(f"skip jvm pid {pid} ({rule}): {why}")
            continue
        dump = ""
        if "sbt-launch" in args or "xsbt.boot" in args:
            dump = f"; thread dump {thread_dump(pid, '')}"
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        waited = 0.0
        while waited < grace and pid_alive(pid):
            time.sleep(0.5)
            waited += 0.5
        how = f"SIGTERM, {waited:.0f}s"
        if pid_alive(pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            how = f"SIGKILL after {grace:.0f}s"
        line = f"killed jvm pid {pid} ({how}) rule={rule}{dump}: {args[:150]}"
        print(line)
        reap_log(line)
    return lines


MAINTAIN_SWEEP_HOUR = 9  # local time: the daily sweep runs at the first maintain pass from 09:00 ($AGENTCTL_SWEEP_HOUR)


# ---------------------------------------------------------------- the store (design §3, §6; phase 1 step 1)
# ONE sqlite database at the state root ($AGENTCTL_STATE_ROOT/store.db, WAL, BEGIN IMMEDIATE for writers): leases now;
# items, events and offers as the later steps move into it. Its clock is the only clock leases use.
class LeaseLost(RuntimeError):
    """A lease this process held is gone (expired and taken, past its max hold, or released): stop its work."""


class Store:
    """Leases (design §6): a holder plus a TTL, renewed only on real progress (a new progress mark), capped by an
    absolute max hold; an expired lease is free. Every acquire bumps the epoch (a fencing token) and draws a secret that
    renew and release need."""

    SCHEMA = ("CREATE TABLE IF NOT EXISTS leases (name TEXT PRIMARY KEY, holder TEXT NOT NULL, epoch INTEGER NOT NULL, "
              "secret TEXT NOT NULL, acquired_at REAL, renewed_at REAL, expires_at REAL, max_until REAL, progress TEXT, "
              "item TEXT, meta TEXT)",
              "CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT)",
              # items (design §5): one row per machine item; `version` is the compare-and-set token of every transition
              "CREATE TABLE IF NOT EXISTS items (type TEXT NOT NULL, id TEXT NOT NULL, state TEXT NOT NULL, "
              "version INTEGER NOT NULL, entered_at REAL NOT NULL, deadline REAL NOT NULL, level INTEGER NOT NULL DEFAULT 0, "
              "data TEXT, PRIMARY KEY (type, id))",
              # events (design §8.1): seq is THE cursor; dedupe makes a repeated tick a no-op
              "CREATE TABLE IF NOT EXISTS events (seq INTEGER PRIMARY KEY AUTOINCREMENT, at REAL NOT NULL, kind TEXT NOT NULL, "
              "item_type TEXT, item_id TEXT, from_state TEXT, to_state TEXT, severity TEXT NOT NULL DEFAULT 'info', "
              "audience TEXT, text TEXT, refs TEXT, dedupe TEXT UNIQUE, notified_at REAL)",
              # offers (design §6.2; step 10): open work a taker may take; take() closes it AND acquires its lease
              "CREATE TABLE IF NOT EXISTS offers (id INTEGER PRIMARY KEY AUTOINCREMENT, kind TEXT NOT NULL, item TEXT NOT NULL, "
              "lease TEXT NOT NULL, tier TEXT, priority INTEGER, deadline REAL, picture TEXT, opened_at REAL, closed_at REAL, "
              "closed_why TEXT, taken_by TEXT, reason TEXT)")

    def __init__(self, path=None, clock=None):
        self.path = path or state_root("store.db")
        self.clock = clock or time.time

    def db(self):
        import sqlite3
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        c = sqlite3.connect(self.path, timeout=30, isolation_level=None)
        c.row_factory = sqlite3.Row
        c.execute("PRAGMA journal_mode=WAL")
        for q in self.SCHEMA:
            c.execute(q)
        return c

    def _row(self, c, name):
        r = c.execute("SELECT * FROM leases WHERE name=?", (name,)).fetchone()
        return dict(r) if r else None

    def acquire(self, name, holder, ttl, max_hold, progress="", item=None, meta=None):
        """{'epoch', 'secret', 'expires_at', 'max_until'} when acquired, else {'held': the live lease}."""
        c = self.db()
        try:
            c.execute("BEGIN IMMEDIATE")
            r = self._acquire_in(c, name, holder, ttl, max_hold, progress, item, meta)
            c.execute("COMMIT")
            return r
        finally:
            c.close()

    def _acquire_in(self, c, name, holder, ttl, max_hold, progress="", item=None, meta=None):
        import secrets as _secrets
        now_ = self.clock()
        row = self._row(c, name)
        if row and row["holder"] and row["expires_at"] > now_:
            return {"held": {k: row[k] for k in ("holder", "epoch", "expires_at", "max_until", "progress", "meta")}}
        epoch = (row["epoch"] if row else 0) + 1
        secret = _secrets.token_hex(16)
        max_until = now_ + max_hold
        exp = min(now_ + ttl, max_until)
        c.execute("INSERT OR REPLACE INTO leases VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                  (name, holder, epoch, secret, now_, now_, exp, max_until, progress, item, json.dumps(meta or {})))
        return {"epoch": epoch, "secret": secret, "expires_at": exp, "max_until": max_until, "ttl": ttl}

    def renew(self, name, epoch, secret, progress, ttl, note=None):
        """'ok' (extended: the progress mark changed), 'no_progress' (not extended), or 'lost'."""
        c = self.db()
        try:
            c.execute("BEGIN IMMEDIATE")
            now_ = self.clock()
            row = self._row(c, name)
            if not row or row["epoch"] != epoch or row["secret"] != secret or not row["holder"] \
                    or row["expires_at"] <= now_ or now_ >= row["max_until"]:
                c.execute("COMMIT")
                return "lost"
            if progress == row["progress"]:
                c.execute("COMMIT")
                return "no_progress"
            meta = json.loads(row["meta"] or "{}")
            if note is not None:
                meta["note"] = note
            c.execute("UPDATE leases SET progress=?, renewed_at=?, expires_at=?, meta=? WHERE name=?",
                      (progress, now_, min(now_ + ttl, row["max_until"]), json.dumps(meta), name))
            c.execute("COMMIT")
            return "ok"
        finally:
            c.close()

    def note(self, name, epoch, secret, note):
        """Say what the holder does now (waiters print it); no renewal."""
        c = self.db()
        try:
            row = self._row(c, name)
            if row and row["epoch"] == epoch and row["secret"] == secret:
                meta = json.loads(row["meta"] or "{}")
                meta["note"] = note
                c.execute("UPDATE leases SET meta=? WHERE name=? AND epoch=?", (json.dumps(meta), name, epoch))
        finally:
            c.close()

    def release(self, name, epoch, secret, outcome=None, notes=None):
        """'ok' (the lease is free; its outcome and notes stay in its meta for the tick), or 'lost'."""
        c = self.db()
        try:
            c.execute("BEGIN IMMEDIATE")
            row = self._row(c, name)
            ok = bool(row and row["epoch"] == epoch and row["secret"] == secret and row["holder"])
            if ok:
                meta = json.loads(row["meta"] or "{}")
                if outcome is not None:
                    meta.update(outcome=outcome, notes=notes or "", released_at=self.clock())
                c.execute("UPDATE leases SET holder='', expires_at=?, meta=? WHERE name=?",
                          (self.clock(), json.dumps(meta), name))
            c.execute("COMMIT")
            return "ok" if ok else "lost"
        finally:
            c.close()

    def revoke(self, name, outcome):
        """The reconciler takes a lease back (a refuted fix, a cleared red, a fix submitted): free now, its holder's next
        renewal answers lost. True when it was live."""
        c = self.db()
        try:
            c.execute("BEGIN IMMEDIATE")
            row = self._row(c, name)
            live = bool(row and row["holder"] and row["expires_at"] > self.clock())
            if live:
                meta = json.loads(row["meta"] or "{}")
                meta.update(outcome=outcome, revoked=True, released_at=self.clock())
                c.execute("UPDATE leases SET holder='', expires_at=?, meta=? WHERE name=?",
                          (self.clock(), json.dumps(meta), name))
            c.execute("COMMIT")
            return live
        finally:
            c.close()

    def set_meta(self, name, epoch, secret, meta):
        """Merge into the holder's lease meta (its worktree, session, pid): no renewal."""
        c = self.db()
        try:
            c.execute("BEGIN IMMEDIATE")
            row = self._row(c, name)
            if row and row["epoch"] == epoch and row["secret"] == secret:
                c.execute("UPDATE leases SET meta=? WHERE name=? AND epoch=?",
                          (json.dumps({**json.loads(row["meta"] or "{}"), **meta}), name, epoch))
            c.execute("COMMIT")
        finally:
            c.close()

    # -- offers (design §6.2; step 10) ------------------------------------------------------------------------------
    def _offer_row(self, r):
        if not r:
            return None
        d = dict(r)
        d["picture"] = json.loads(d["picture"] or "{}")
        return d

    def offer(self, kind, item, lease, tier, priority, deadline, picture):
        """Open (or refresh) THE open offer of an item. Returns its id. The reconciler's only."""
        c = self.db()
        try:
            c.execute("BEGIN IMMEDIATE")
            r = c.execute("SELECT id FROM offers WHERE item=? AND closed_at IS NULL", (item,)).fetchone()
            if r:
                c.execute("UPDATE offers SET kind=?, lease=?, tier=?, priority=?, deadline=?, picture=? WHERE id=?",
                          (kind, lease, tier, priority, deadline, json.dumps(picture), r["id"]))
                oid = r["id"]
            else:
                oid = c.execute("INSERT INTO offers (kind, item, lease, tier, priority, deadline, picture, opened_at) "
                                "VALUES (?,?,?,?,?,?,?,?)", (kind, item, lease, tier, priority, deadline,
                                                             json.dumps(picture), self.clock())).lastrowid
            c.execute("COMMIT")
            return oid
        finally:
            c.close()

    def offers(self, kind=None):
        """The open offers, by priority (gate > fix > outside > flake), oldest first."""
        c = self.db()
        try:
            rows = c.execute("SELECT * FROM offers WHERE closed_at IS NULL" + (" AND kind=?" if kind else "")
                             + " ORDER BY priority, opened_at", ((kind,) if kind else ())).fetchall()
            return [self._offer_row(r) for r in rows]
        finally:
            c.close()

    def offer_of(self, item):
        c = self.db()
        try:
            return self._offer_row(c.execute("SELECT * FROM offers WHERE item=? AND closed_at IS NULL", (item,)).fetchone())
        finally:
            c.close()

    def offer_reason(self, oid, reason):
        """Why nobody took it yet (capacity, dispatch OFF): its escalation says so."""
        c = self.db()
        try:
            c.execute("UPDATE offers SET reason=? WHERE id=?", (reason, oid))
        finally:
            c.close()

    def close_offer(self, item, why):
        c = self.db()
        try:
            c.execute("UPDATE offers SET closed_at=?, closed_why=? WHERE item=? AND closed_at IS NULL",
                      (self.clock(), why, item))
        finally:
            c.close()

    def take(self, oid, holder, ttl, max_hold, meta=None):
        """Atomically: the offer closed AND its lease acquired. The lease plus the picture, {'held': ...} when the lease
        is held, or {'gone': ...} when the offer is closed."""
        c = self.db()
        try:
            c.execute("BEGIN IMMEDIATE")
            off = self._offer_row(c.execute("SELECT * FROM offers WHERE id=?", (oid,)).fetchone())
            if not off or off["closed_at"]:
                c.execute("COMMIT")
                return {"gone": oid}
            r = self._acquire_in(c, off["lease"], holder, ttl, max_hold, "taken", off["item"], meta)
            if "held" not in r:
                c.execute("UPDATE offers SET closed_at=?, closed_why='taken', taken_by=? WHERE id=?",
                          (self.clock(), holder, oid))
                r["picture"] = off["picture"]
            c.execute("COMMIT")
            return r
        finally:
            c.close()

    def get(self, name):
        c = self.db()
        try:
            return self._row(c, name)
        finally:
            c.close()

    # -- items and their transitions (design §5; phase 1 step 5) -----------------------------------------------------
    def _item(self, c, typ, iid):
        r = c.execute("SELECT * FROM items WHERE type=? AND id=?", (typ, iid)).fetchone()
        if not r:
            return None
        d = dict(r)
        d["data"] = json.loads(d["data"] or "{}")
        return d

    def item(self, typ, iid):
        c = self.db()
        try:
            return self._item(c, typ, iid)
        finally:
            c.close()

    def items(self, typ, states=None):
        c = self.db()
        try:
            rows = [self._item(c, typ, r["id"]) for r in c.execute("SELECT id FROM items WHERE type=? ORDER BY id", (typ,))]
        finally:
            c.close()
        return [r for r in rows if states is None or r["state"] in states]

    def put_item(self, typ, iid, state, data=None):
        """Create the item in `state` (version 1); an existing item is left as it is. Returns the item."""
        spec = machine_state(typ, state)
        c = self.db()
        try:
            c.execute("BEGIN IMMEDIATE")
            if not self._item(c, typ, iid):
                now_ = self.clock()
                c.execute("INSERT INTO items VALUES (?,?,?,?,?,?,?,?)",
                          (typ, iid, state, 1, now_, now_ + spec.deadline, 0, json.dumps(data or {})))
            c.execute("COMMIT")
            return self._item(c, typ, iid)
        finally:
            c.close()

    def transition(self, typ, iid, to, expect_version, data=None, event=None, deadline_s=None):
        """THE way an item changes state: compare-and-set on its version (StaleVersion on a miss), never out of a
        terminal state (TerminalState), its deadline from MACHINES, its data merged, and its event written in the same
        transaction (kind `<type>.<to>` unless given; deduped). A self-transition (an escalation) bumps the version, keeps
        entered_at and re-deadlines; deadline_s overrides the state's deadline (e.g. a gate red's shorter offer).
        Returns the new version."""
        spec = machine_state(typ, to)
        c = self.db()
        try:
            c.execute("BEGIN IMMEDIATE")
            cur = self._item(c, typ, iid)
            if not cur or cur["version"] != expect_version:
                c.execute("ROLLBACK")
                raise StaleVersion(f"{typ} {iid}: version {cur and cur['version']}, expected {expect_version}")
            if machine_state(typ, cur["state"]).terminal and to != cur["state"]:
                c.execute("ROLLBACK")
                raise TerminalState(f"{typ} {iid} is {cur['state']}: terminal")
            now_ = self.clock()
            same = to == cur["state"]
            level = cur["level"] + 1 if same and spec.escalate else (cur["level"] if same else 0)
            merged = {**cur["data"], **(data or {})}
            c.execute("UPDATE items SET state=?, version=?, entered_at=?, deadline=?, level=?, data=? WHERE type=? AND id=?",
                      (to, cur["version"] + 1, now_ if not same else cur["entered_at"],
                       now_ + (spec.deadline if deadline_s is None else float(deadline_s)), level,
                       json.dumps(merged), typ, iid))
            ev = dict(event or {})
            c.execute("INSERT OR IGNORE INTO events (at, kind, item_type, item_id, from_state, to_state, severity, "
                      "audience, text, refs, dedupe) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                      (now_, ev.get("kind") or f"{typ}.{to}", typ, iid, cur["state"], to,
                       ev.get("severity") or ("escalate" if same and spec.escalate else "info"),
                       json.dumps(ev.get("audience") or {}), ev.get("text") or "", json.dumps(ev.get("refs") or {}),
                       ev.get("dedupe") or f"{typ}:{iid}:{to}:{cur['version'] + 1}"))
            c.execute("COMMIT")
            return cur["version"] + 1
        finally:
            c.close()

    def update_item(self, typ, iid, expect_version, data):
        """Merge data into the item (compare-and-set on its version): no state, entered_at or deadline change, no
        event. Returns the new version (StaleVersion on a miss)."""
        c = self.db()
        try:
            c.execute("BEGIN IMMEDIATE")
            cur = self._item(c, typ, iid)
            if not cur or cur["version"] != expect_version:
                c.execute("ROLLBACK")
                raise StaleVersion(f"{typ} {iid}: version {cur and cur['version']}, expected {expect_version}")
            c.execute("UPDATE items SET version=?, data=? WHERE type=? AND id=?",
                      (cur["version"] + 1, json.dumps({**cur["data"], **(data or {})}), typ, iid))
            c.execute("COMMIT")
            return cur["version"] + 1
        finally:
            c.close()

    def mark_notified(self, seq):
        c = self.db()
        try:
            c.execute("UPDATE events SET notified_at=? WHERE seq=? AND notified_at IS NULL", (self.clock(), seq))
        finally:
            c.close()

    def meta_get(self, k, default=None):
        c = self.db()
        try:
            r = c.execute("SELECT v FROM meta WHERE k=?", (k,)).fetchone()
            return r["v"] if r else default
        finally:
            c.close()

    def meta_set(self, k, v):
        c = self.db()
        try:
            c.execute("INSERT OR REPLACE INTO meta VALUES (?,?)", (k, str(v)))
        finally:
            c.close()

    def events(self, after=0, limit=500):
        c = self.db()
        try:
            out = []
            for r in c.execute("SELECT * FROM events WHERE seq>? ORDER BY seq LIMIT ?", (after, limit)):
                d = dict(r)
                for k in ("audience", "refs"):
                    d[k] = json.loads(d[k] or "{}")
                out.append(d)
            return out
        finally:
            c.close()

    def archive_free_leases(self, older=None):
        """Free leases (released, revoked, lapsed) free for over LEASE_ARCHIVE_AFTER become one `lease.archived` event
        each (history: holder, epoch, outcome) and leave the table, which keeps only what is or was lately held."""
        cut = self.clock() - (LEASE_ARCHIVE_AFTER if older is None else older)
        c = self.db()
        n = 0
        try:
            c.execute("BEGIN IMMEDIATE")
            for r in c.execute("SELECT * FROM leases WHERE expires_at < ?", (cut,)).fetchall():
                meta = json.loads(r["meta"] or "{}")
                c.execute("INSERT OR IGNORE INTO events (at, kind, item_type, item_id, severity, audience, text, refs, "
                          "dedupe) VALUES (?,?,?,?,?,?,?,?,?)",
                          (self.clock(), "lease.archived", "lease", r["name"], "info", "{}",
                           f"{r['name']} epoch {r['epoch']}: {meta.get('outcome') or 'lapsed'}",
                           json.dumps({"holder": r["holder"], "epoch": r["epoch"], "acquired_at": r["acquired_at"],
                                       "free_since": r["expires_at"], "item": r["item"], "meta": meta}),
                           f"lease:{r['name']}:{r['epoch']}:archived"))
                c.execute("DELETE FROM leases WHERE name=? AND epoch=?", (r["name"], r["epoch"]))
                n += 1
            c.execute("COMMIT")
            return n
        finally:
            c.close()

    def list(self, prefix=""):
        c = self.db()
        try:
            return [dict(r) for r in c.execute("SELECT * FROM leases WHERE name LIKE ? ORDER BY name", (prefix + "%",))]
        finally:
            c.close()


# ---------------------------------------------------------------- the machines (design §5; phase 1 step 5)
# Every state of every machine has a finite deadline and an automatic exit (`on_deadline`, a state of the same
# machine); a deadline-only walk from any state ends in a terminal state or cycles through an escalation (the
# table-driven test). Terminal states archive after 14 d. The "red" and "condition" machines join with steps 10-12.
class StaleVersion(RuntimeError):
    """A transition's compare-and-set lost: the item moved since it was read."""


class TerminalState(RuntimeError):
    """A transition out of a terminal state."""


class StateSpec:
    __slots__ = ("deadline", "on_deadline", "exits", "terminal", "escalate")

    def __init__(self, deadline, on_deadline, exits=(), terminal=False, escalate=False):
        self.deadline, self.on_deadline, self.exits = float(deadline), on_deadline, tuple(exits)
        self.terminal, self.escalate = terminal, escalate


ARCHIVE = 14 * 86400
M = 60
H = 3600
MACHINES = {
    # §5.1 a submitted change
    "change": {
        "queued": StateSpec(15 * M, "queued", ("checking", "superseded", "cancelled", "landed"), escalate=True),
        "checking": StateSpec(2 * H, "queued", ("checked", "rejected", "queued")),
        "checked": StateSpec(5 * M, "checked", ("pushing", "waiting", "queued"), escalate=True),
        "waiting": StateSpec(6 * H, "waiting", ("landed", "rejected", "queued"), escalate=True),
        "pushing": StateSpec(300, "checked", ("landed", "checked")),
        "landed": StateSpec(ARCHIVE, "landed", (), terminal=True),
        "rejected": StateSpec(ARCHIVE, "rejected", (), terminal=True),
        "superseded": StateSpec(ARCHIVE, "superseded", (), terminal=True),
        "cancelled": StateSpec(ARCHIVE, "cancelled", (), terminal=True),
    },
    # step 9: a landed sha's watch of Main and the convergence (no detached process: the tick evaluates it)
    "watch": {
        "watching": StateSpec(3 * H, "unknown", ("ok", "red", "unknown")),
        "ok": StateSpec(ARCHIVE, "ok", (), terminal=True),
        "red": StateSpec(ARCHIVE, "red", (), terminal=True),
        "unknown": StateSpec(ARCHIVE, "unknown", (), terminal=True),
    },
    # §5.2 + §14.1 the batch: a computed item, no branch
    "batch": {
        "blocked-red": StateSpec(6 * H, "blocked-red", ("assembling",), escalate=True),
        "assembling": StateSpec(300, "assembling", ("checking", "held", "landed"), escalate=True),
        "checking": StateSpec(2 * H, "held", ("pushing", "bisecting", "held")),
        "bisecting": StateSpec(4 * H, "held", ("pushing", "assembling", "held")),
        "pushing": StateSpec(300, "assembling", ("landed", "assembling")),
        "held": StateSpec(30 * M, "assembling", ("assembling",), escalate=True),
        "landed": StateSpec(ARCHIVE, "landed", (), terminal=True),
    },
}

# §5.4 a condition (the recovery registry folded in), phase 1 step 12: open escalates 10 min after opening, then every
# 2 h (recovery_tick's re-deadline); only its own probe passing closes it
MACHINES["condition"] = {
    "open": StateSpec(10 * 60, "open", ("closed",), escalate=True),
    "closed": StateSpec(ARCHIVE, "closed", (), terminal=True),
}
# §5.3 a red (keyed by its failing test or step), phase 1 step 10
MACHINES["red"] = {
    "red": StateSpec(60, "offered", ("offered", "fix-pending", "leased", "blocked-external", "cleared")),
    "offered": StateSpec(RED_OFFER["other"], "offered", ("leased", "fix-pending", "blocked-external", "cleared"),
                         escalate=True),
    "leased": StateSpec(RED_CLAIM_MAX, "offered", ("fix-pending", "offered", "blocked-external", "cleared")),
    "fix-pending": StateSpec(RED_FIX_DECIDE, "fix-pending", ("offered", "verified", "cleared"), escalate=True),
    "blocked-external": StateSpec(7 * 86400, "offered", ("offered", "fix-pending", "leased", "cleared")),
    "verified": StateSpec(ARCHIVE, "verified", (), terminal=True),
    "cleared": StateSpec(ARCHIVE, "cleared", (), terminal=True),
}


def machine_state(typ, state):
    try:
        return MACHINES[typ][state]
    except KeyError:
        raise ValueError(f"no state {state!r} in machine {typ!r}") from None


def deadline_walk(typ, state):
    """The deadline-only path from `state`: (reached terminal?, cycle escalates?)."""
    seen = []
    while state not in seen:
        seen.append(state)
        spec = MACHINES[typ][state]
        if spec.terminal:
            return True, False
        state = spec.on_deadline
    cycle = seen[seen.index(state):]
    return False, any(MACHINES[typ][x].escalate for x in cycle)


# the change items, projected from today's queue entries (read-only until step 6 makes the tick their writer)
ENTRY_STATE = {"queued": "queued", "checking": "checking", "checked": "checked", "pushing": "pushing",
               "joined": "waiting", "waiting": "waiting", "landed": "landed",
               "rejected": "rejected", "superseded": "superseded", "cancelled": "cancelled"}


def project_changes(d, store=None):
    """Each queue entry's change item: created in its state, moved (a transition, with its event) when the entry's
    status moved. Returns the items."""
    st = store or Store()
    out = []
    every = {x["id"]: x for x in waiting_entries(d, open_only=False)}
    for e in every.values():
        state = ENTRY_STATE.get(e.get("status"))
        if e.get("status") == "joined":  # a pre-step-8 join: the change follows the waiting entry that carries it
            w = every.get(e.get("waiting_id") or "")
            state = ENTRY_STATE.get((w or {}).get("status"), "landed" if not w else "waiting")
        if not state:
            continue
        cur = st.put_item("change", e["id"], state, {"worktree": e.get("worktree"), "head": e.get("head"),
                                                     "submitted_at": st.clock(),
                                                     "red_accum0": float(st.meta_get("red_accum", 0) or 0)})
        if cur["state"] != state and not machine_state("change", cur["state"]).terminal:
            try:
                st.transition("change", e["id"], state, cur["version"],
                              event={"text": f"{e['id']}: {cur['state']} -> {state}", "refs": {"entry": e["id"]}})
            except (StaleVersion, TerminalState):
                pass
            cur = st.item("change", e["id"])
        out.append(cur)
    return out


# ---------------------------------------------------------------- events -> the inbox (design §8.2; phase 1 step 7)
# The PROJECTOR writes one inbox entry, in today's format, for each event with an audience or a severity other than
# info -- its verdict line (refs.verdict) or its text, the audience's worktree as its cwd, its tail and exit; the entry
# id carries the event's seq, so a repeated pass writes nothing twice. The NOTIFIER sends a macOS notification for
# each severity=escalate event once (notified_at). Both run in the processor's loop; `agentctl inbox`, `inbox wait`,
# the orchestrator's routing and the status line read the inbox as before.
def project_events(store=None):
    """Write the inbox entries of the events since the projector's cursor; returns how many."""
    st = store or Store()
    cur = int(st.meta_get("projector_seq", 0) or 0)
    n = 0
    for ev in st.events(after=cur):
        cur = ev["seq"]
        aud, refs = ev.get("audience") or {}, ev.get("refs") or {}
        if not aud and ev["severity"] == "info":
            continue
        verdict = refs.get("verdict") or ev.get("text") or ev["kind"]
        eid = (dt.datetime.fromtimestamp(ev["at"], dt.timezone.utc).strftime("%Y%m%dT%H%M%S%f")
               + f"-ev{ev['seq']}-{re.sub(r'[^a-z]+', '-', ev['kind'])}")
        d = inbox_dir()
        path = os.path.join(d, eid + ".json")
        if os.path.exists(path):
            continue
        final = refs.get("final", True)
        rec = {"id": eid, "time": dt.datetime.fromtimestamp(ev["at"], dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
               "at": ev["at"], "command": refs.get("command") or ev["kind"].split(".")[0], "argv": [],
               "cwd": aud.get("worktree") or safe_cwd(), "pid": os.getpid(), "final": final,
               "exit": refs.get("exit", 0 if ev["severity"] == "info" else 1), "verdict": verdict,
               "kind": inbox_kind(verdict, final), "owner": aud.get("session") or aud.get("worktree") or "?",
               "claude_pid": aud.get("claude_pid"), "verdicts": [verdict], "tail": list(refs.get("tail") or [])[-25:],
               "event": ev["seq"]}
        try:
            os.makedirs(d, exist_ok=True)
            write_json(path, rec)
            n += 1
        except OSError as ex:
            err(f"projector: could not write {eid} ({ex})")
            break
    st.meta_set("projector_seq", cur)
    return n


def notify_escalations(store=None):
    """One macOS notification per severity=escalate event (notified_at marks it); returns how many."""
    st = store or Store()
    n = 0
    for ev in st.events(after=int(st.meta_get("notifier_seq", 0) or 0)):
        st.meta_set("notifier_seq", ev["seq"])
        if ev["severity"] != "escalate" or ev.get("notified_at"):
            continue
        st.mark_notified(ev["seq"])
        notify(f"agentctl: {ev['kind']}", str((ev.get("refs") or {}).get("verdict") or ev.get("text") or "")[:220])
        n += 1
    return n


def change_event(e, verdict, tail=(), code=1, final=True, severity="info", **refs):
    """The event a change's transition carries to its author (the projector makes it their inbox entry)."""
    return {"text": verdict.splitlines()[0], "severity": severity,
            "audience": {"worktree": e.get("worktree"), "session": e.get("session"), "claude_pid": e.get("claude_pid")},
            "refs": {"verdict": verdict.splitlines()[0], "tail": list(tail)[-25:], "exit": code, "final": final,
                     "command": "land", "entry": e["id"], **refs}}


LEASE_ARCHIVE_AFTER = 24 * 3600  # a lease free this long is archived into the events (history), off the table
LEASE_LIST_RECENT = 3600         # `lease list` shows the live leases and those free for less than this (--all: every one)


def maybe_archive_leases(d, every=3600):
    """Once an hour: the leases free for over a day go to the events (Store.archive_free_leases)."""
    st = Store()
    if time.time() - float(st.meta_get("lease_archive_at", 0) or 0) < every:
        return 0
    st.meta_set("lease_archive_at", time.time())
    n = st.archive_free_leases()
    if n:
        wlog(d, f"tick: {n} lease(s) free for over {LEASE_ARCHIVE_AFTER // 3600} h archived into the events")
    return n


def cmd_lease(a):
    """`agentctl lease list [prefix] [--all]` (debugging; the leases' holders, epochs, expiry, notes): the live ones and
    those free for under an hour; --all every one still in the table."""
    st, now_ = Store(), time.time()
    rows = st.list(a.prefix or "")
    hidden = 0 if a.all else sum(1 for r in rows if not (r["holder"] and r["expires_at"] > now_)
                                 and now_ - r["expires_at"] > LEASE_LIST_RECENT)
    if not a.all:
        rows = [r for r in rows if (r["holder"] and r["expires_at"] > now_) or now_ - r["expires_at"] <= LEASE_LIST_RECENT]
    for r in rows:
        live = r["holder"] and r["expires_at"] > now_
        meta = json.loads(r["meta"] or "{}")
        print(f"{r['name']}  {'LIVE' if live else 'free'}  {r['holder'] or '-'}  epoch {r['epoch']}  "
              f"expires in {int(r['expires_at'] - now_)} s  max {int(r['max_until'] - now_)} s"
              + (f"  -- {meta.get('note')}" if meta.get("note") else ""))
    if not rows:
        print("no leases")
    if hidden:
        print(f"({hidden} free for over {LEASE_LIST_RECENT // 60} min not shown: --all)")
    return 0


# ---------------------------------------------------------------- phase 2: the store over HTTP (design §6.3, §13 phase 2)
# `agentctl store serve` puts the store behind a small HTTP API on ci-runner (:3014, reached through the Forgejo tunnel;
# nix/hosts/ci-runner/agentctl.nix runs it). Every request carries `Authorization: token <a Forgejo token>`, checked
# against Forgejo's /api/v1/user (the answer cached STORE_AUTH_CACHE s): an --allow-user login gets the whole API, a
# --metrics-user login GET /metrics alone, anyone else 403, no token 401. The reconciler (`agentctl tick` there) opens
# the same database in-process: two units, one WAL file, so a reconciler crash leaves leases, submissions and the event
# feed up. RemoteStore is Store's twin over the API: `Store()` returns one when $AGENTCTL_STORE_URL is set, so the
# laptop's sync, its dispatcher, `red claim` and the fixers' wrappers work against ci-runner's store unchanged.
#
# ROLES: "local" (phase 1: the laptop does everything), "server" (`agentctl tick` on ci-runner: the tick, never the
# laptop's duties), "sync" (the laptop once $AGENTCTL_STORE_URL is set: submit, events -> inbox, the notifier, the state
# mirror, the claims' activity, the fixer dispatcher; it never ticks).
STORE_RPC = ("acquire", "renew", "note", "release", "revoke", "set_meta", "offer", "offers", "offer_of", "offer_reason",
             "close_offer", "take", "get", "item", "items", "put_item", "transition", "update_item", "mark_notified",
             "meta_get", "meta_set", "events", "archive_free_leases", "list")
STORE_AUTH_CACHE = 300   # s a token's login is trusted before Forgejo is asked again (§15)
EVENTS_WAIT_MAX = 25     # s a GET /v1/events long-poll waits for a new event
STORE_PORT = 3014
SYNC_MIRROR_EVERY = 10   # s between the laptop's copies of /v1/state into state.json


def host_role():
    r = os.environ.get("AGENTCTL_ROLE")
    if r:
        return r
    if os.environ.get("AGENTCTL_STORE_URL"):
        return "sync"
    return "server" if os.environ.get("AGENTCTL_HOST") == "ci-runner" else "local"


def store_errors():
    return {"StaleVersion": StaleVersion, "TerminalState": TerminalState, "LeaseLost": LeaseLost}


class StoreUnavailable(RuntimeError):
    """The remote store did not answer (the tunnel, ci-runner, the service): no verdict either way."""


class RemoteStore:
    """Store's methods over the phase-2 API (`POST /v1/store/<method>`), plus the §6.3 calls the sync needs. The token
    is the caller's own Forgejo token ($AGENTCTL_STORE_TOKEN, else the movies token agentctl reads)."""

    def __init__(self, url, tok=None, clock=None, timeout=60):
        self.url, self._tok, self.clock, self.timeout = url.rstrip("/"), tok, clock or time.time, timeout
        self.path = self.url

    def _token(self):
        return self._tok or os.environ.get("AGENTCTL_STORE_TOKEN") or token(SHORT["movies"])

    def call(self, method, path, body=None, timeout=None):
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.url + path, data=data, method=method,
                                     headers={"Authorization": f"token {self._token()}",
                                              "Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=timeout or self.timeout) as r:
                return json.loads(r.read() or b"null")
        except urllib.error.HTTPError as e:
            try:
                b = json.loads(e.read() or b"{}")
            except ValueError:
                b = {}
            cls = store_errors().get(b.get("error"))
            if cls:
                raise cls(b.get("message") or "")
            raise StoreUnavailable(f"{method} {path}: HTTP {e.code} {b.get('message') or e.reason}") from None
        except (urllib.error.URLError, OSError, ValueError) as e:
            raise StoreUnavailable(f"{method} {path}: {e}") from None

    def _rpc(self, m, args, kwargs):
        return self.call("POST", f"/v1/store/{m}", {"args": list(args), "kwargs": kwargs})["result"]

    def state(self):
        return self.call("GET", "/v1/state")

    def wait_events(self, after, wait=EVENTS_WAIT_MAX, limit=500):
        return self.call("GET", f"/v1/events?after={int(after)}&wait={int(wait)}&limit={int(limit)}",
                         timeout=wait + 30)["events"]

    def submit(self, entry):
        return self.call("POST", "/v1/changes", entry)

    def cancel_change(self, eid, how="cancel"):
        return self.call("POST", f"/v1/changes/{urllib.parse.quote(eid, safe='')}:{how}", {})

    def nudge(self):
        return self.call("POST", "/v1/tick", {})


for _m in STORE_RPC:
    setattr(RemoteStore, _m, (lambda m: lambda self, *a, **k: self._rpc(m, a, k))(_m))


def _store_new(cls, path=None, clock=None):
    if cls is Store and path is None and os.environ.get("AGENTCTL_STORE_URL"):
        return RemoteStore(os.environ["AGENTCTL_STORE_URL"], clock=clock)
    return object.__new__(cls)


Store.__new__ = _store_new


def store_grace(st, now_=None):
    """§6.2 'Store downtime grace': at the service's start every live lease is extended by the time the store was down
    (meta last_alive), so a store restart never expires everyone at once. Returns the gap applied."""
    now_ = now_ if now_ is not None else st.clock()
    last = float(st.meta_get("last_alive", 0) or 0)
    gap = now_ - last if last else 0
    if gap > 60:
        c = st.db()
        try:
            c.execute("UPDATE leases SET expires_at=expires_at+?, max_until=max_until+? WHERE holder!='' AND expires_at>?",
                      (gap, gap, last))
        finally:
            c.close()
    st.meta_set("last_alive", now_)
    return gap if gap > 60 else 0


def server_repo():
    """The reconciler's own clone on ci-runner ($AGENTCTL_MOVIES_REPO, else ~/movies; `tick` clones it from
    $AGENTCTL_MOVIES_REMOTE as remote `forgejo`)."""
    return os.environ.get("AGENTCTL_MOVIES_REPO") or os.path.join(HOME, "movies")


def ensure_server_clone(repo=None):
    repo = repo or server_repo()
    if not os.path.isdir(os.path.join(repo, ".git")):
        url = os.environ.get("AGENTCTL_MOVIES_REMOTE")
        if not url:
            raise SystemExit("agentctl tick: no clone at {repo} and no $AGENTCTL_MOVIES_REMOTE to clone it from")
        r = subprocess.run(["git", "clone", "--quiet", "--origin", REMOTE, url, repo], capture_output=True, text=True,
                           env=dict(os.environ, GIT_TERMINAL_PROMPT="0"), timeout=1800)
        if r.returncode != 0:
            raise SystemExit(f"agentctl tick: git clone {url} failed: {r.stderr.strip()[:300]}")
    return repo


def queue_change(d, fields, entry_id=None):
    """A submitted change as a queued entry (seq under seq.lock); re-queueing from the same source supersedes the older
    one. Returns (entry, n ahead). Shared by `land` (phase 1) and POST /v1/changes (phase 2)."""
    with open(os.path.join(d, "seq.lock"), "a+") as seq_lock:  # a unique seq; never the landing lock (a push holds it)
        fcntl.flock(seq_lock, fcntl.LOCK_EX)
        every = waiting_entries(d, open_only=False)
        seq = max([e["seq"] for e in every] + [0]) + 1
        eid = entry_id or f"{dt.datetime.now().strftime('%Y%m%d-%H%M%S')}-{os.path.basename(fields['worktree'])}-{seq}"
        if any(x["id"] == eid for x in every):
            e = next(x for x in every if x["id"] == eid)
            return e, max(len(queued_entries(d)) - 1, 0)
        e = {**fields, "id": eid, "seq": seq, "status": "queued", "created": ts()}
        save_entry(d, e)
        for old in queued_entries(d):  # RE-QUEUEING REPLACES: only the newest entry per worktree and branch runs
            if old["id"] != e["id"] and same_change_source(old, e["worktree"], e.get("branch")):
                supersede(d, old, e["id"], f"{e['worktree']} queued again ({e['head'][:10]}); only the newest entry runs")
    return e, max(len(queued_entries(d)) - 1, 0)


SUBMIT_FIELDS = ("worktree", "branch", "head", "commits", "fixes", "keep_worktree", "claude_pid", "session", "base", "host")


def submit_change(body, repo=None):
    """POST /v1/changes: a change the laptop pushed to refs/heads/land/<id> becomes a queued entry of the server's queue."""
    repo = repo or server_repo()
    if not os.path.isdir(repo):
        raise ValueError(f"the reconciler has not cloned {repo} yet")
    missing = [k for k in ("worktree", "head", "commits") if not body.get(k)]
    if missing or not re.fullmatch(r"[0-9a-f]{40}", str(body.get("head"))):
        raise ValueError(f"a change needs worktree, head (a full sha) and commits; missing or bad: {missing or ['head']}")
    if body.get("id") and not re.fullmatch(r"[\w.-]{1,120}", body["id"]):
        raise ValueError("a bad change id")
    d = waiting_state(repo)[0]
    e, ahead = queue_change(d, {k: body.get(k) for k in SUBMIT_FIELDS}, body.get("id"))
    return {"id": e["id"], "seq": e["seq"], "ahead": ahead}


def cancel_submitted(eid, how="cancel", repo=None):
    d = waiting_state(repo or server_repo())[0]
    hits = [e for e in queued_entries(d) + waiting_entries(d) if e["id"] == eid]
    if not hits:
        raise KeyError(eid)
    e = hits[0]
    set_change(d, e, "cancelled", event={"text": f"{e['id']}: {how}led"}, why=f"{how}led through the store API",
               decided=ts())
    cancel_entry_remote(e, f"its queue entry was {how}led")
    return {"id": eid, "status": "cancelled"}


def gate_is_red_now():
    ci = state_read().get("ci") or {}
    return any((g.get("conclusion") or "") in ("failure", "timed_out") for g in ci.get("gate") or [])


def track_red_time(st, red, now_=None):
    """meta red_accum: the seconds main has been red, summed (the W1 gauge leaves them out of a change's age)."""
    now_ = now_ if now_ is not None else st.clock()
    last = float(st.meta_get("red_accum_at", 0) or 0)
    acc = float(st.meta_get("red_accum", 0) or 0)
    if red and last:
        acc += max(0.0, min(now_ - last, 600))
        st.meta_set("red_accum", acc)
    st.meta_set("red_accum_at", now_)
    return acc


def metrics_text(st, now_=None):
    """The Prometheus text the module's agentctl-metrics copies to node-exporter (agentctl.rules' gauges)."""
    t = now_ if now_ is not None else st.clock()
    snap = state_read()
    tick = float(snap.get("tick_at") or 0)
    acc = float(st.meta_get("red_accum", 0) or 0)
    ages = []
    for it in st.items("change"):
        if machine_state("change", it["state"]).terminal:
            continue
        dd = it.get("data") or {}
        since = float(dd.get("submitted_at") or it["entered_at"])
        acc0 = dd.get("red_accum0")
        ages.append(max(0.0, (t - since) - max(0.0, acc - float(acc if acc0 is None else acc0))))
    unleased = 0.0
    try:
        for it in red_unheld(st):
            unleased = max(unleased, t - float(it.get("entered_at") or t))
    except Exception:
        pass
    two = 2 * env_num("AGENTCTL_TICK", TICK)
    unreaped = 0
    for typ, state, lease in (("red", "leased", lambda i: red_lease(i["data"]["key"])),
                              ("change", "checking", lambda i: f"check/{i['id']}")):
        for it in st.items(typ, [state]):
            try:
                row = st.get(lease(it))
            except (KeyError, TypeError):
                continue
            if row and row["expires_at"] < t - two and row["expires_at"] > it["entered_at"]:
                unreaped += 1
    past = sum(1 for typ in MACHINES for it in st.items(typ)
               if not machine_state(typ, it["state"]).terminal and it["deadline"] < t - two)
    rows = [("agentctl_reconciler_tick_timestamp", "unix time the last tick finished", tick),
            ("agentctl_oldest_change_age_seconds", "age of the oldest non-terminal change, not counting red main time",
             max(ages) if ages else 0),
            ("agentctl_red_unleased_seconds", "longest a red on main has had no lease, fix, block or offer", unleased),
            ("agentctl_leases_expired_unreaped", "leases past their TTL by more than 2 ticks with their item unmoved",
             unreaped),
            ("agentctl_items_past_deadline", "items past their state's deadline by more than 2 ticks", past)]
    out = []
    for name, help_, v in rows:
        out += [f"# HELP {name} {help_}.", f"# TYPE {name} gauge", f"{name} {float(v):.0f}"]
    return "\n".join(out) + "\n"


class StoreAPI:
    """The HTTP API's logic, apart from the socket (tests call handle() directly too)."""

    def __init__(self, store, forgejo_url, allow=(), metrics=(), user_of=None, repo=None):
        self.store, self.forgejo = store, (forgejo_url or "").rstrip("/")
        self.allow, self.metrics = set(allow), set(metrics)
        self.user_of, self.repo = user_of or self._forgejo_user, repo
        self.cache, self.lock = {}, threading.Lock()

    def _forgejo_user(self, tok):
        req = urllib.request.Request(f"{self.forgejo}/api/v1/user", headers={"Authorization": f"token {tok}"})
        try:
            with urllib.request.urlopen(req, timeout=15) as r:
                return json.loads(r.read()).get("login")
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                return None
            raise

    def login(self, tok):
        import hashlib
        k, now_ = hashlib.sha256(tok.encode()).hexdigest(), time.time()
        with self.lock:
            hit = self.cache.get(k)
            if hit and now_ - hit[1] < STORE_AUTH_CACHE:
                return hit[0]
        who = self.user_of(tok)
        with self.lock:
            self.cache[k] = (who, now_)
        return who

    @staticmethod
    def _json(code, obj):
        return code, "application/json", json.dumps(obj).encode()

    def handle(self, method, path, headers, body=b""):
        u = urllib.parse.urlsplit(path)
        q = {k: v[-1] for k, v in urllib.parse.parse_qs(u.query).items()}
        auth = headers.get("Authorization") or headers.get("authorization") or ""
        m = re.match(r"(?i)(?:token|bearer)\s+(\S+)$", auth.strip())
        if not m:
            return self._json(401, {"error": "Unauthorized", "message": "Authorization: token <Forgejo token> required"})
        try:
            who = self.login(m.group(1))
        except Exception as e:
            return self._json(503, {"error": "Unavailable", "message": f"Forgejo could not check the token: {e}"})
        if who not in self.allow and not (who in self.metrics and method == "GET" and u.path == "/metrics"):
            return self._json(403, {"error": "Forbidden", "message": f"{who or 'this token'} may not call {u.path}"})
        try:
            if body:
                args = json.loads(body)
            else:
                args = {}
            return self.route(method, u.path, q, args)
        except tuple(store_errors().values()) as e:
            return self._json(409, {"error": type(e).__name__, "message": str(e)})
        except KeyError as e:
            return self._json(404, {"error": "NotFound", "message": str(e)})
        except (ValueError, TypeError) as e:
            return self._json(400, {"error": "BadRequest", "message": str(e)})

    def route(self, method, p, q, b):
        st = self.store
        if method == "GET" and p == "/metrics":
            return 200, "text/plain; version=0.0.4", metrics_text(st).encode()
        if method == "GET" and p == "/v1/state":
            return self._json(200, state_read())
        if method == "GET" and p == "/v1/leases":
            return self._json(200, {"leases": st.list(q.get("prefix", ""))})
        if method == "POST" and p.startswith("/v1/leases/") and ":" in p:
            name, op = urllib.parse.unquote(p[len("/v1/leases/"):]).rsplit(":", 1)
            if op == "acquire":
                r = st.acquire(name, b["holder"], float(b["ttl_s"]), float(b["max_hold_s"]), b.get("progress") or "",
                               b.get("item"), b.get("meta"))
            elif op == "renew":
                r = st.renew(name, int(b["epoch"]), b["secret"], b.get("progress") or "", float(b["ttl_s"]),
                             note=b.get("note"))
            elif op == "release":
                r = st.release(name, int(b["epoch"]), b["secret"], b.get("outcome"), b.get("notes"))
            else:
                raise KeyError(op)
            return self._json(200, {"result": r})
        if method == "GET" and p == "/v1/offers":
            return self._json(200, {"offers": st.offers(q.get("kind"))})
        if method == "POST" and re.fullmatch(r"/v1/offers/\d+:take", p):
            r = st.take(int(p.split("/")[3].split(":")[0]), b["holder"], float(b["ttl_s"]),
                        float(b.get("max_hold_s") or b["ttl_s"]), b.get("meta"))
            return self._json(200, {"result": r})
        if method == "GET" and p == "/v1/events":
            after, wait = int(q.get("after", 0)), min(float(q.get("wait", 0)), EVENTS_WAIT_MAX)
            end = time.time() + wait
            while True:
                evs = st.events(after=after, limit=int(q.get("limit", 500)))
                if evs or time.time() >= end:
                    return self._json(200, {"events": evs})
                time.sleep(0.5)
        if method == "POST" and re.fullmatch(r"/v1/events/\d+:ack", p):
            st.mark_notified(int(p.split("/")[3].split(":")[0]))
            return self._json(200, {"result": "ok"})
        if method == "POST" and p == "/v1/changes":
            return self._json(200, submit_change(b, self.repo))
        if method == "POST" and re.fullmatch(r"/v1/changes/[^/]+:(cancel|abandon)", p):
            eid, how = urllib.parse.unquote(p[len("/v1/changes/"):]).rsplit(":", 1)
            return self._json(200, cancel_submitted(eid, how, self.repo))
        if method == "POST" and p == "/v1/tick":
            with open(state_root("tick.nudge"), "a"):
                os.utime(state_root("tick.nudge"))
            return self._json(200, {"result": "ok"})
        if method == "POST" and p.startswith("/v1/store/"):
            m = p[len("/v1/store/"):]
            if m not in STORE_RPC:
                raise KeyError(m)
            return self._json(200, {"result": getattr(st, m)(*b.get("args", []), **b.get("kwargs", {}))})
        raise KeyError(f"{method} {p}")


def store_server(api, host, port):
    """A ThreadingHTTPServer serving api (returns it; serve_forever() is the caller's)."""
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def _go(self, method):
            n = int(self.headers.get("Content-Length") or 0)
            body = self.rfile.read(n) if n else b""
            code, ctype, out = api.handle(method, self.path, dict(self.headers), body)
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(out)))
            self.end_headers()
            self.wfile.write(out)

        def do_GET(self):
            self._go("GET")

        def do_POST(self):
            self._go("POST")

        def log_message(self, fmt, *args):  # the journal gets one line per non-2xx answer only
            if args and str(args[1] if len(args) > 1 else "").startswith(("4", "5")):
                sys.stderr.write("agentctl-store: %s\n" % (fmt % args))

    srv = ThreadingHTTPServer((host, port), Handler)
    srv.daemon_threads = True
    return srv


def cmd_store(a):
    """`agentctl store serve --listen ADDR:PORT --forgejo-url URL --allow-user U... --metrics-user U...`."""
    host, _, port = a.listen.rpartition(":")
    st = Store(path=state_root("store.db"))
    gap = store_grace(st)
    if gap:
        err(f"store: down {int(gap)} s; every live lease extended by that")
    api = StoreAPI(st, a.forgejo_url or os.environ.get("AGENTCTL_FORGEJO_URL") or "", a.allow_user or [],
                   a.metrics_user or [])
    srv = store_server(api, host or "127.0.0.1", int(port or STORE_PORT))

    def alive():
        while True:
            time.sleep(30)
            try:
                st.meta_set("last_alive", time.time())
            except Exception as e:
                err(f"store: last_alive not written ({e})")
    threading.Thread(target=alive, daemon=True).start()
    signal.signal(signal.SIGTERM, lambda *_: threading.Thread(target=srv.shutdown, daemon=True).start())
    err(f"store: serving {state_root('store.db')} on {host}:{port} (allow {','.join(api.allow) or '-'}; metrics "
        f"{','.join(api.metrics) or '-'})")
    srv.serve_forever()
    return 0


def sd_notify(msg):
    """systemd's notify protocol ($NOTIFY_SOCKET; '@' an abstract socket): READY=1, WATCHDOG=1. A no-op elsewhere."""
    path = os.environ.get("NOTIFY_SOCKET")
    if not path:
        return False
    import socket
    addr = "\0" + path[1:] if path.startswith("@") else path
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
            s.connect(addr)
            s.sendall(msg.encode())
        return True
    except OSError as e:
        err(f"sd_notify {msg}: {e}")
        return False


# ---- the laptop's sync (role "sync")
def sync_outbox_dir():
    return state_root("outbox")


def submit_remote(st, e):
    """Submit a change to the remote store; unreachable: kept in the outbox (QUEUED-LOCAL) for the sync to send."""
    try:
        return st.submit(e)
    except StoreUnavailable as ex:
        os.makedirs(sync_outbox_dir(), exist_ok=True)
        write_json(os.path.join(sync_outbox_dir(), f"{e['id']}.json"), e)
        return {"id": e["id"], "outbox": str(ex)[:200]}


def flush_outbox(st=None):
    """The changes `land` could not submit (the store down): sent now, oldest first. Returns how many went."""
    st = st or Store()
    n = 0
    for p in sorted(glob.glob(os.path.join(sync_outbox_dir(), "*.json"))):
        e = read_record(p)
        if not e:
            continue
        try:
            st.submit(e)
        except StoreUnavailable:
            break
        except Exception as ex:  # refused (bad request): said once, dropped
            inbox_write("land", f"NOT LANDED: {e.get('id')}: the store refused it ({str(ex)[:200]})", [], [], 1,
                        cwd=e.get("worktree") or safe_cwd())
        os.unlink(p)
        n += 1
    return n


def mirror_state(st=None):
    """ci-runner's /v1/state copied into the laptop's state.json (with fetched_at): the status line reads it."""
    st = st or Store()
    snap = st.state()
    state_update(**{**snap, "fetched_at": time.time()})
    return snap


def sync_steps(repo, d, o_r):
    """The laptop's loop once the store is remote: it never ticks."""
    last_mirror = [0.0]

    def mirror():
