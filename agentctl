            refresh_pinned_recording(o_r, repo)  # what PREDICTS MAIN RED compares a branch run's recording with
            reds_now = {g["decided"]["databaseId"] for g in snap["gate"]
                        if g.get("decided") and g["decided"].get("conclusion") in RED_CONCLUSIONS}
            if reds_now - _seen_gate_reds:
                # ASSIGN FIRST (the owner: "why is main red unassigned?"): a gate red this cycle first sees is assigned
                # -- its live author claimed, or a fixer dispatched -- BEFORE the snapshot and the gate line are
                # published, so no published state holds a red nobody was assigned to. Bounded: a dispatch under load (a
                # worktree checkout) takes minutes, and the red itself must not wait for it -- past 20 s it is published
                # as `dispatching a fixer…` (red_state's gap) while the dispatch finishes on its own thread
                if not run_bounded("assign-first", lambda: assign_first(repo, snap), env_num("AGENTCTL_ASSIGN_BOUND", 20)):
                    err("red patrol (assign first): still dispatching; the red is published meanwhile")
            _seen_gate_reds.clear()
            _seen_gate_reds.update(reds_now)
            ci_state_write(snap)
            _red, line = ci_why(o_r, summary=True, snap=snap, repo=repo)
            publish_gate_summary(o_r, line.splitlines()[-1], epoch=snap["at"])
        except (Exception, SystemExit) as e:
            err(f"gate summary: skipped ({str(e).replace('agentctl: ', '')[:200]})")
            return
        try:
            for routed in route_branch_reds(o_r, snap):
                err(f"branch reds: {routed}")
        except (Exception, SystemExit) as e:
            err(f"branch reds: not routed ({str(e).replace('agentctl: ', '')[:200]})")
    if not run_bounded("gate-publish", work, env_num("AGENTCTL_STEP_BOUND", 120)):
        err("gate summary: still reading from an earlier cycle (the loop goes on)")


