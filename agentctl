# ---------------------------------------------------------------- wait
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
LOG_TS = re.compile(r"^\d{4}-\d\d-\d\dT[\d:.]+Z ")
STRONG = re.compile(r"\*\*\* FAILED|\[error\]|::error::|(?i:assertion|assert(ion)? failed)|\bError:|ENOENT|artifact already exists|(?i:exit code [1-9])|\bFAILED\b")
WEAK = re.compile(r"\bfail(ed|ure)?\b|\berror\b|exception|assert", re.I)
NOISE = re.compile(r"Setting level of logger|\|-INFO in ch\.qos|\berrors?[=:] ?0\b|\b0 (errors?|failed)\b|\b(INFO|DEBUG|TRACE)\b", re.I)
MEASURE_WORKFLOWS = {"Identity model convergence"}


def relevant_lines(log_text, tail):
    """{job: [last `tail` relevant lines]} from `forgejo-gh run view --log-failed` output (job<TAB>step<TAB>line).
    Strong markers (*** FAILED, [error], ::error::, assertion, exit code) win; plain fail/error words only when a job
    has none, and never from INFO/DEBUG log lines."""
    strong, weak, follow = {}, {}, {}
    for raw in log_text.splitlines():
        parts = raw.split("\t", 2)
        job, line = (parts[0], parts[2]) if len(parts) == 3 else ("?", raw)
        line = LOG_TS.sub("", ANSI.sub("", line)).rstrip()
        if not line:
            continue
        if follow.get(job):  # the 2 lines after a scalatest `*** FAILED ***` carry its reason
            follow[job] -= 1
            strong.setdefault(job, []).append(line[:300])
            continue
        if "*** FAILED ***" in line:
            follow[job] = 2
        if STRONG.search(line) and not re.search(r"Setting level of logger|-INFO in ch\.qos", line):
            strong.setdefault(job, []).append(line[:300])
        elif WEAK.search(line) and not NOISE.search(line):
            weak.setdefault(job, []).append(line[:300])
    return {j: (strong.get(j) or weak.get(j))[-tail:] for j in set(strong) | set(weak)}


def raw_tails(log_text, n=3):
    """{job: (line count, last n cleaned lines)} of a --log-failed output."""
    out = {}
    for raw in log_text.splitlines():
        parts = raw.split("\t", 2)
        job, line = (parts[0], parts[2]) if len(parts) == 3 else ("?", raw)
        line = LOG_TS.sub("", ANSI.sub("", line)).rstrip()
        cnt, last = out.get(job, (0, []))
        out[job] = (cnt + 1, (last + [line[:200]])[-n:])
    return out


def fetch_failed_log(o_r, run_id):
    env = dict(os.environ, GH_TOKEN=token(o_r))
    r = subprocess.run([FORGEJO_GH, "run", "view", str(run_id), "--log-failed", "-R", o_r], capture_output=True, text=True, env=env, timeout=300)
    return r.stdout


def fetch_takes_verdicts(o_r, run_id):
    """{artifact: verdict.txt text} of a measure run's identity-takes-<cc> artifacts (the takes rows' verdict files)."""
    env = dict(os.environ, GH_TOKEN=token(o_r))
    arts = gh_json(o_r, "api", f"repos/{o_r}/actions/runs/{run_id}/artifacts").get("artifacts", [])
    out = {}
    for a in arts:
        name = a.get("name", "")
        if not name.startswith("identity-takes-"):
            continue
        d = os.path.join(scratch(), "agentctl-wait", f"art-{run_id}-{name}")
        os.makedirs(d, exist_ok=True)
        subprocess.run([FORGEJO_GH, "run", "download", str(run_id), "-n", name, "-D", d, "-R", o_r], capture_output=True, env=env, timeout=300)
        p = os.path.join(d, "verdict.txt")
        out[name] = open(p, errors="replace").read().strip() if os.path.exists(p) else "(no verdict.txt in the artifact)"
    return out


def is_measure_run(d):
    return d.get("workflowName") in MEASURE_WORKFLOWS and (d.get("headBranch") or "").startswith("measure/")


def fetch_job_log(o_r, run_id, job_id):
    env = dict(os.environ, GH_TOKEN=token(o_r))
    r = subprocess.run([FORGEJO_GH, "run", "view", str(run_id), "--log", "--job", str(job_id), "-R", o_r],
                       capture_output=True, text=True, env=env, timeout=300)
    return r.stdout


ANNOTATION = re.compile(r"::error\b[^:]*::")
MAX_JOB_LOG_FETCHES = 5


def job_log_lines(o_r, run_id, job, tail):
    """Relevant lines from a job's WHOLE log. Forgejo's per-step slices (what --log-failed prints) are shifted by a
    few lines from the stored log, so a failed step's slice can hold only its neighbours' checkout/cache lines while
    its `::error` annotation and output sit just past it (run 1988, takes (united-kingdom)). `::error` annotations
    first, else the strong/weak markers."""
    jid = job.get("databaseId") if isinstance(job, dict) else None
    if not jid:
        return []
    try:
        log = fetch_job_log(o_r, run_id, jid)
    except Exception:
        return []
    clean = [LOG_TS.sub("", ANSI.sub("", (l.split("\t", 2)[2] if l.count("\t") >= 2 else l))).rstrip() for l in log.splitlines()]
    notes = [l[:300] for l in clean if ANNOTATION.search(l)]
    if notes:
        return notes[-tail:]
    name = job.get("name", "?")
    return relevant_lines("\n".join(f"{name}\t-\t{l}" for l in clean), tail).get(name, [])


def failure_detail(o_r, run_id, failed, tail):
    """failed: job dicts (name, databaseId) or names."""
    if not failed or tail <= 0:
        return []
    try:
        per = relevant_lines(fetch_failed_log(o_r, run_id), tail)
    except Exception as e:
        return [f"  (could not read the failed log: {e})"]
    out, fetched = [], 0
    for jd in failed:
        job = jd["name"] if isinstance(jd, dict) else jd
        lines = per.get(job) or next((v for k, v in per.items() if k in job or job in k), [])
        if not lines and fetched < MAX_JOB_LOG_FETCHES and isinstance(jd, dict):
            fetched += 1
            lines = job_log_lines(o_r, run_id, jd, tail)
        out.append(f"  -- {job}: " + ("no FAILED/error/assert line in its log (0-length log or setup failure? see `agentctl ci-why`)" if not lines else f"last {len(lines)} relevant line(s)"))
        out += [f"     {l}" for l in lines]
    return out


def run_verdict(o_r, run_id, until="done", tail=0):
    """(done, ok, text) for a Forgejo run. until=landable: a measure run is done once its takes rows ended."""
    d = gh_json(o_r, "run", "view", str(run_id), "--json", "status,conclusion,jobs,workflowName,headBranch")
    jobs = d.get("jobs") or []
    head = f"run {o_r}#{run_id}"
    if until == "landable" and is_measure_run(d):
        takes = [j for j in jobs if j.get("name", "").startswith("takes")]
        if d.get("status") == "completed" or (takes and all(j.get("status") == "completed" for j in takes)):
            badj = [j for j in takes if j.get("conclusion") not in ("success", "skipped")]
            bad = [j["name"] for j in badj]
            lines = [f"{head}: takes rows ended ({len(takes)}): " + ("all green" if not bad else "failed: " + ", ".join(bad))]
            try:
                for name, text in sorted(fetch_takes_verdicts(o_r, run_id).items()):
                    lines += [f"  [{name}] {l}" for l in text.splitlines()]
            except Exception as e:
                lines.append(f"  (could not read the verdict files: {e})")
            lines.append(f"  collect the LANDABLE verdict: scripts/identity-measure --run {run_id}")
            lines += failure_detail(o_r, run_id, badj, tail)
            return True, not bad and bool(takes), "\n".join(lines)
        n_done = sum(1 for j in takes if j.get("status") == "completed")
        return False, None, f"{head}: {d.get('status')} (takes rows {n_done}/{len(takes)} ended)"
    if d.get("status") != "completed":
        return False, None, f"{head}: {d.get('status')}"
    concl = d.get("conclusion") or "unknown"
    failedj = [j for j in jobs if j.get("conclusion") in ("failure", "cancelled", "timed_out")]
    failed = [j["name"] for j in failedj]
    line = f"{head}: {concl}" + (f"; failed: {', '.join(failed)}" if failed else "")
    lines = [line] + failure_detail(o_r, run_id, failedj, tail)
    return True, concl in ("success", "skipped", "neutral"), "\n".join(lines)


def file_verdict(path, contains):
    if not os.path.exists(path):
        return False, None, f"file {path}: absent"
    if contains:
        try:
            with open(path, errors="replace") as f:
                if not re.search(contains, f.read(), re.M):
                    return False, None, f"file {path}: present, no match for {contains!r}"
        except OSError as e:
            return False, None, f"file {path}: unreadable ({e})"
    st = os.stat(path)
    when = dt.datetime.fromtimestamp(st.st_mtime, dt.timezone.utc).strftime("%H:%M:%SZ")
    return True, True, f"file {path}: present ({st.st_size} bytes, mtime {when})"


def foreign_loops_on(run_id):
    """Other (non-agentctl) processes already polling this run id."""
    me = os.getpid()
    out = []
    for pid, ppid, etime, cmd in ps():
        if pid in (me, os.getppid()) or "agentctl" in cmd:
            continue
        if re.search(rf"run view {run_id}\b|runs/{run_id}\b", cmd) and "sleep" in cmd:
            out.append(pid)
    return out


# ---------------------------------------------------------------- owned: every long-running mode
# The owner (2026-10-26), after a day of strays: a zombie processor blocking the next one, duplicate waiters, a processor
# still running old code after a fix, orphaned shells, abandoned CI runs, landing slots held by dead loops. So every
# long-running mode -- `wait`, land's watch and its wait on `waiting`, the `waiting` processor -- runs OWNED:
#   * one flock per (kind, key) under ~/.cache/agentctl/owners/ ($AGENTCTL_OWNERS_DIR): the kernel frees it when the
#     process dies, however it dies, so a second instance can never run beside a live one and never waits on a dead one;
#   * beside it a record (<kind>-<key>.json): owner (the Claude session, else user@cwd), pid, the process's start time,
#     argv, cwd, the code version (agentctl's sha256) and the CI runs it started;
#   * the runs it started are cancelled when it ends -- by its SIGTERM/SIGHUP/SIGINT handler, or, after a SIGKILL, by
#     the next owner of the same key, which finds the dead one's record;
#   * at each poll it compares agentctl's file with the version it started on and, when a fix has landed, re-execs
#     itself on the new code with the same pid (its runs adopted, not cancelled);
#   * `agentctl orphans` reads the records: a dead process's record, an owner on old code, an owner whose cwd is gone.
OWNERS_RESTART_CHECK = 30  # seconds between code-version checks ($AGENTCTL_RESTART_CHECK)
TOOL_PATH = os.path.realpath(__file__)


def owners_dir():
    return os.environ.get("AGENTCTL_OWNERS_DIR") or os.path.join(HOME, ".cache", "agentctl", "owners")


def code_version(path=TOOL_PATH):
    import hashlib
    try:
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:16]
    except OSError:
        return ""


START_CODE = code_version()


def process_start(pid):
    """The process's start time as ps prints it: with the pid, it names one process even after the pid is reused."""
    r = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True)
    return r.stdout.strip()


def read_record(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def cancel_run(o_r, rid, why):
    """Cancel a CI run this tool started (Forgejo's cancel is a no-op on a finished run)."""
    try:
        env = dict(os.environ, GH_TOKEN=token(o_r))
        r = subprocess.run([FORGEJO_GH, "run", "cancel", str(rid), "-R", o_r], capture_output=True, text=True, env=env,
                           timeout=120)
        err(f"cancelled {o_r} run {rid} ({why})" if r.returncode == 0 else
            f"could not cancel {o_r} run {rid} ({why}): {r.stderr.strip()[:160]}")
    except (Exception, SystemExit) as e:
        err(f"could not cancel {o_r} run {rid} ({why}): {e}")


def lock_held(lockpath):
    """Whether a live process holds the flock at lockpath (tried without blocking, released at once)."""
    if not os.path.exists(lockpath):
        return False
    with open(lockpath, "a+") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        fcntl.flock(f, fcntl.LOCK_UN)
        return False


class Held(Exception):
    def __init__(self, holder):
        super().__init__(f"held by pid {holder.get('pid')} ({holder.get('owner')}) since {holder.get('started')}")
        self.holder = holder


class Owned:
    """One long-running instance of (kind, key): see the section comment."""

    def __init__(self, kind, key, argv=None):
        self.kind, self.key = kind, re.sub(r"[^\w.-]", "_", str(key))[-150:]
        base = os.path.join(owners_dir(), f"{kind}-{self.key}")
        self.lockpath, self.record = base + ".lock", base + ".json"
        self.argv = list(sys.argv[1:] if argv is None else argv)
        self.f, self.holder, self.runs, self.started, self._old = None, None, [], None, {}

    def acquire(self):
        os.makedirs(owners_dir(), exist_ok=True)
        f = open(self.lockpath, "a+")
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            f.close()
            self.holder = read_record(self.record) or {}
            return False
        self.f = f
        prev = read_record(self.record)
        if prev and prev.get("pid") == os.getpid():  # our own re-exec on new code: its runs are still ours
            self.runs, self.started = [tuple(r) for r in prev.get("runs") or []], prev.get("started")
        elif prev:
            for o_r, rid in prev.get("runs") or []:
                cancel_run(o_r, rid, f"its owner, {prev.get('kind')} pid {prev.get('pid')}, died without ending it")
        self.started = self.started or ts()
        self._write()
        self._signals()
        return True

    def _write(self):
        rec = {"kind": self.kind, "key": self.key, "pid": os.getpid(), "started": self.started,
               "process_start": process_start(os.getpid()),
               "owner": os.environ.get("CLAUDE_CODE_SESSION_ID") or f"{os.environ.get('USER', '?')}@{os.getcwd()}",
               "cwd": os.getcwd(), "argv": self.argv, "code": code_version(), "runs": [list(r) for r in self.runs]}
        tmp = f"{self.record}.{os.getpid()}"
        with open(tmp, "w") as f:
            json.dump(rec, f)
        os.replace(tmp, self.record)

    def _signals(self):
        def end(signum, frame):
            raise SystemExit(128 + signum)
        for s in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            try:
                self._old[s] = signal.signal(s, end)
            except ValueError:  # not the main thread: the caller's own handling stands
                pass

    def add_run(self, o_r, rid):
        self.runs.append((o_r, int(rid)))
        self._write()

    def drop_run(self, rid):
        self.runs = [r for r in self.runs if r[1] != int(rid)]
        self._write()

    def release(self, cancel=True, keep_record=False):
        if not self.f:
            return
        if cancel:
            for o_r, rid in self.runs:
                cancel_run(o_r, rid, f"its {self.kind} ended")
            self.runs = []
        if not keep_record:
            try:
                os.unlink(self.record)
            except FileNotFoundError:
                pass
        for s, h in self._old.items():
            signal.signal(s, h)
        self._old = {}
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()
        self.f = None

    def __enter__(self):
        if not self.acquire():
            raise Held(self.holder)
        return self

    def __exit__(self, *exc):
        self.release()
        return False


_last_code_check = [0.0]


def restart_if_changed(owned=(), argv=None):
    """Re-exec this process on agentctl's new code (same pid; argv: given, else the first owner's, else this process's)
    once the file on disk changed.
    The owned locks are released without cancelling: the new process takes them back and adopts their runs."""
    every = float(os.environ.get("AGENTCTL_RESTART_CHECK", OWNERS_RESTART_CHECK))
    if time.time() - _last_code_check[0] < every:
        return
    _last_code_check[0] = time.time()
    now_code = code_version()
    if not now_code or now_code == START_CODE:
        return
    err(f"agentctl changed on disk ({START_CODE[:8]} -> {now_code[:8]}): restarting on the new code, pid {os.getpid()}")
    for o in owned:
        o.release(cancel=False, keep_record=True)
    sys.stdout.flush()
    sys.stderr.flush()
    # The owner's own command (land's watch resumes as `agentctl watch`, not as `land`), else this process's.
    if argv is None:
        argv = owned[0].argv if owned else sys.argv[1:]
    os.execv(sys.executable, [sys.executable, TOOL_PATH] + list(argv))


def owner_records():
    """Every owner record, each with `alive` (its lock is held) and `path`."""
    out = []
    for p in sorted(glob.glob(os.path.join(owners_dir(), "*.json"))):
        rec = read_record(p)
        if rec is None:
            continue
        rec.update(path=p, alive=lock_held(p[: -len(".json")] + ".lock"))
        out.append(rec)
    return out


def default_repo():
    try:
        return slug(os.getcwd())
    except (SystemExit, RuntimeError):
        return SHORT["movies"]


def backoff(floor, cap):
    """Poll delays: floor, x1.5 each time, never above cap (<= 300 s)."""
    d = floor
    while True:
        yield d
        d = min(cap, d * 1.5)


class Waiter:
    """One target waited on: OWNS it (and polls) or attaches to the live owner's verdict file. The verdict sits beside the
    owner record, so a waiter in any session finds it."""

    def __init__(self, key, check, argv=None):
        self.key, self.check = key, check
        self.own = Owned("wait", key, argv)
        self.verdict = self.own.record[: -len(".json")] + ".verdict"
        self.owned, self.holder, self.result = False, None, None

    def acquire(self):
        """True if we own the target now; False if a live waiter does (self.holder = its record)."""
        if self.own.acquire():
            self.owned = True
            try:
                os.unlink(self.verdict)
            except FileNotFoundError:
                pass
            return True
        self.holder = self.own.holder
        return False

    def poll_owned(self):
        try:
            done, ok, text = self.check()
        except Exception as e:  # transient API trouble: report and keep waiting
            done, ok, text = False, None, f"check failed: {e}"
        if done:
            tmp = self.verdict + f".{os.getpid()}"
            with open(tmp, "w") as f:
                json.dump({"ok": ok, "line": text, "at": ts()}, f)
            os.replace(tmp, self.verdict)
            self.result = (ok, text)
        return text

    def poll_attached(self):
        """Owner gone (its lock free): read its verdict, or take over when it left none."""
        if lock_held(self.own.lockpath):
            return
        try:
            v = json.load(open(self.verdict))
            self.result = (v["ok"], v["line"])
        except (OSError, ValueError, KeyError):
            err(f"{self.key}: waiter pid {(self.holder or {}).get('pid')} ended without a verdict; taking over")
            self.holder = None
            self.acquire()

    def release(self):
        if self.owned:
            self.own.release()
            self.owned = False


def wait_all(waiters, timeout, floor, cap):
    """Block until every waiter has a verdict. Prints each verdict as it lands. Exit 0 all ok, 1 any failed, 2 timeout."""
    deadline = time.time() + timeout
    attach_poll = float(os.environ.get("AGENTCTL_ATTACH_POLL", "15"))
    for w in waiters:
        if not w.acquire():
            err(f"{w.key}: attached to existing waiter pid {w.holder.get('pid')} (since {w.holder.get('started')}); not polling Forgejo")
    delays = backoff(floor, cap)
    next_check, last = 0.0, {}
    try:
        while True:
            pending = [w for w in waiters if w.result is None]
            if time.time() >= next_check:
                for w in pending:
                    if w.owned:
                        last[w.key] = w.poll_owned()
                        if w.result:
                            print(w.result[1], flush=True)
                next_check = time.time() + next(delays)
            for w in pending:
                if w.result is None and not w.owned:
                    w.poll_attached()
                    if w.result:
                        print(w.result[1], flush=True)
            pending = [w for w in waiters if w.result is None]
            if not pending:
                return 0 if all(w.result[0] for w in waiters) else 1
            restart_if_changed([w.own for w in waiters if w.owned])
            if time.time() >= deadline:
                for w in pending:
                    print(f"TIMEOUT after {timeout}s; last: {last.get(w.key, 'attached to another waiter')}", flush=True)
                return 2
            step = next_check - time.time()
            if any(not w.owned for w in pending):
                step = min(step, attach_poll)
            time.sleep(max(0.05, min(step, deadline - time.time())))
    finally:
        for w in waiters:
            w.release()


def cmd_wait(a):
    floor = float(os.environ.get("AGENTCTL_MIN_INTERVAL", "60"))
    cap = max(floor, min(300, a.interval))
    if a.kind == "run":
        ids = list(a.ids)
        repo = a.repo
        if ids and not ids[0].isdigit():  # legacy form: wait run <repo> <id>...
            repo = repo or ids[0]
            ids = ids[1:]
        if not ids or not all(i.isdigit() for i in ids):
            raise SystemExit("agentctl: wait run needs numeric run ids (action_run.id, the GITHUB_RUN_ID)")
        o_r = slug(repo) if repo else default_repo()
        waiters = []
        for i in dict.fromkeys(ids):
            others = foreign_loops_on(i)
            if others:
                err(f"note: other loops already poll run {i}: pids {others} (see `agentctl orphans`)")
            key = f"run-{o_r.replace('/', '_')}-{i}" + ("-landable" if a.until == "landable" else "")
            waiters.append(Waiter(key, (lambda i=i: run_verdict(o_r, int(i), a.until, a.tail))))
        return wait_all(waiters, a.timeout, floor, cap)
    path = os.path.abspath(a.target)
    key = "file-" + re.sub(r"[^\w.-]", "_", path)[-150:]
    return wait_all([Waiter(key, lambda: file_verdict(path, a.contains))], a.timeout, min(floor, a.interval), max(min(floor, a.interval), min(300, a.interval)))


# ---------------------------------------------------------------- ci-why
# Exactly the workflows movies' scripts/hooks/pre-push check_redgate reads (GatingWorkflows / GatingWorkflowFiles).
# THE GATE (the owner, 2026-10-27: "if the latest main and convergence runs are green, just push then, remember that"):
# exactly the newest decided Main run and the newest decided Identity model convergence run on main. Verify scrape
# recording no longer gates; ci-why lists it, and every other red, as information only.
GATING = {"pawelkrupinski/movies": [("Main", "main.yml"), ("Identity model convergence", "identity-model-convergence.yml")]}
SETUP_STEP = re.compile(r"^(Set up job|Initialize containers|actions/checkout|Checkout|.*(download|upload)-artifact|.*cache@|Set up .*runner)", re.I)
INFRA_LOG = re.compile(r"artifact already exists|ENOENT|No space left on device|Cannot connect to the Docker daemon|"
                       r"connection (refused|reset)|Could not resolve host|TLS handshake timeout|runner .* lost|context deadline exceeded|"
                       r"The operation was canceled|exit code 137|Killed", re.I)
RUN_FIELDS = "databaseId,number,status,conclusion,headSha,url,displayTitle,workflowName,createdAt,updatedAt"
RED_CONCLUSIONS = ("failure", "timed_out")


def repo_path_for(o_r):
    for p in REPOS:
        if os.path.isdir(p) and git_ok(p, "remote", "get-url", REMOTE):
            try:
                if slug(p) == o_r:
                    return p
            except (SystemExit, RuntimeError):
                pass
    return None


def commit_line(o_r, sha, repo=None):
    repo = repo or repo_path_for(o_r)
    if repo and git_ok(repo, "cat-file", "-e", f"{sha}^{{commit}}"):
        return git(repo, "log", "-1", "--format=%h %an <%ae> %ad: %s", "--date=format:%m-%d %H:%M", sha).strip()
    try:
        c = gh_json(o_r, "api", f"repos/{o_r}/git/commits/{sha}")
        a = c.get("author") or c.get("commit", {}).get("author", {})
        msg = c.get("message") or c.get("commit", {}).get("message", "")
        return f"{sha[:9]} {a.get('name')} <{a.get('email')}>: {msg.splitlines()[0] if msg else ''}"
    except Exception:
        return sha[:9]


def classify_job(job, lines, raw=(0, [])):
    """('infra'|'unclear'|'test', why) for one failed job, from its steps, relevant log lines and raw (count, tail)."""
    bad = [s for s in job.get("steps") or [] if s.get("conclusion") in ("failure", "timed_out")]
    step = bad[0]["name"] if bad else None
    if step and SETUP_STEP.match(step):
        return "infra", f"failed in setup step '{step}' (often a `needs:` cascade or runner/setup trouble)"
    if not raw[0] and not lines:
        return "infra", "0-length log" + (f" (step '{step}')" if step else "")
    hit = next((l for l in lines if INFRA_LOG.search(l)), None)
    if hit and not any("*** FAILED" in l or "[error]" in l for l in lines):
        return "infra", f"infra-shaped log line: {hit[:120]}"
    if not lines:
        tail = " | ".join(raw[1])
        return "unclear", f"{raw[0]}-line log with no FAILED/error/assert line (truncated? runner lost?) in step '{step}'; ends: {tail}"
    return "test", f"failed step '{step}'" if step else "test failure"


def gate_runs(o_r):
    """[(workflow, newest decided run on main | None, newer unfinished run | None, red_streak of its runs)]."""
    flows = GATING.get(o_r)
    if not flows:
        recent = gh_json(o_r, "run", "list", "--branch", "main", "--limit", "40", "--json", RUN_FIELDS)
        flows = [(n, n) for n in dict.fromkeys(r["workflowName"] for r in recent)]
    out = []
    for name, wfile in flows:
        runs = gh_json(o_r, "run", "list", "--workflow", wfile, "--branch", "main", "--limit", "30", "--json", RUN_FIELDS)
        decided = next((r for r in runs if r.get("status") == "completed" and r.get("conclusion") in ("success", "failure", "timed_out")), None)
        newer = next((r for r in runs if r.get("status") != "completed"), None)
        if newer and decided and newer["databaseId"] < decided["databaseId"]:
            newer = None
        out.append((name, decided, newer, red_streak(runs)))
    return out


def red_streak(runs):
    """(since, count) of the red streak that `runs` (one workflow's on main, newest first) ends on: its decided runs up
    to the newest success, `since` the oldest failure's completion (when CI first said red). (None, 0) when green."""
    decided = [r for r in runs if r.get("status") == "completed" and r.get("conclusion") in ("success",) + RED_CONCLUSIONS]
    streak = list(itertools.takewhile(lambda r: r.get("conclusion") in RED_CONCLUSIONS, decided))
    if not streak:
        return None, 0
    oldest = streak[-1]
    return oldest.get("updatedAt") or oldest.get("createdAt"), len(streak)


def red_for(since, now=None):
    """'3d 4h' / '5h 12m' / '7m' since an ISO time, or '?' when it cannot be read."""
    try:
        t = dt.datetime.fromisoformat(str(since).replace("Z", "+00:00"))
    except ValueError:
        return "?"
    if now is None:  # $AGENTCTL_NOW: the tests' clock
        now = (dt.datetime.fromisoformat(os.environ["AGENTCTL_NOW"].replace("Z", "+00:00")) if os.environ.get("AGENTCTL_NOW")
               else dt.datetime.now(dt.timezone.utc))
    mins = max(0, int((now - t).total_seconds() // 60))
    d, h, m = mins // 1440, mins % 1440 // 60, mins % 60
    return f"{d}d {h}h" if d else f"{h}h {m}m" if h else f"{m}m"


def outside_gate(o_r):
    """[(workflow, newest decided run, since, count)] for each workflow on main OUTSIDE the gate whose newest decided
    run is red: not blocking a push, but red, and for how long (the owner, 2026-10-27: a red nobody is shown is a red
    that gets ignored)."""
    gated = {n for n, _ in GATING.get(o_r, [])}
    runs = gh_json(o_r, "run", "list", "--branch", "main", "--limit", "200", "--json", RUN_FIELDS)
    out = []
    for name in dict.fromkeys(r.get("workflowName") for r in runs):
        if not name or name in gated:
            continue
        mine = [r for r in runs if r.get("workflowName") == name]
        since, count = red_streak(mine)
        if count:
            decided = next(r for r in mine if r.get("status") == "completed" and r.get("conclusion") in RED_CONCLUSIONS)
            out.append((name, decided, since, count))
    return sorted(out, key=lambda x: str(x[2]))


def explain_run(o_r, run, tail, repo=None):
    """Lines explaining one red run: commit, failed jobs, their log tails, infra vs test."""
    rid = run["databaseId"]
    d = gh_json(o_r, "run", "view", str(rid), "--json", "jobs,headSha,url,number,conclusion,workflowName")
    num = d.get("number") or run.get("number")
    failed = [j for j in d.get("jobs") or [] if j.get("conclusion") in ("failure", "timed_out")]
    try:
        log = fetch_failed_log(o_r, rid) if failed else ""
    except Exception as e:
        log = ""
        err(f"could not read run {rid}'s failed log: {e}")
    per, raws = relevant_lines(log, tail), raw_tails(log)
    lines = [f"  run id {rid} (#{num}) {d.get('url') or run.get('url')}",
             f"  commit {commit_line(o_r, d.get('headSha') or run.get('headSha'), repo)}"]
    kinds, fetched = [], 0
    for j in failed:
        jl = per.get(j["name"]) or []
        bad = [st for st in j.get("steps") or [] if st.get("conclusion") in ("failure", "timed_out")]
        setup = bool(bad) and bool(SETUP_STEP.match(bad[0]["name"]))
        if not jl and not setup and fetched < MAX_JOB_LOG_FETCHES:  # a shifted step slice: read the whole job log
            fetched += 1
            jl = job_log_lines(o_r, rid, j, tail)
        kind, why = classify_job(j, jl, raws.get(j["name"], (0, [])))
        kinds.append(kind)
        lines.append(f"  [{kind}] {j['name']}: {why}")
        lines += [f"      {l}" for l in jl]
    rerun = f"rerun: {FORGEJO_GH.replace(HOME, '~')} run rerun {rid} --failed -R {o_r}"
    if "test" in kinds:
        verdict = "TEST FAILURE"
    elif "unclear" in kinds:
        verdict = f"UNCLEAR (a failed step logged no FAILED/error line: read `forgejo-gh run view {rid} --log-failed`; if infra, {rerun})"
    else:
        verdict = f"INFRA-SHAPED ({rerun})" if kinds else "no failed job listed"
    lines.insert(0, f"  verdict: {verdict}")
    return lines, num


def ci_why(o_r, tail=6, run_id=None, repo=None):
    """(red, text). run_id: explain that one run; else the gating workflows' newest decided runs on main."""
    if run_id:
        lines, _ = explain_run(o_r, {"databaseId": int(run_id)}, tail, repo)
        return True, f"run {o_r}#{run_id}\n" + "\n".join(lines)
    out, red = [], False
    for name, decided, newer, (since, count) in gate_runs(o_r):
        pending = f"; newer run {newer['databaseId']} (#{newer.get('number')}) {newer.get('status')} may clear it" if newer else ""
        if not decided:
            out.append(f"{name}: no decided run on main")
            continue
        if decided["conclusion"] == "success":
            out.append(f"{name}: GREEN (run {decided['databaseId']} #{decided.get('number')})")
            continue
        red = True
        streak = f"; red for {red_for(since)} ({count} failed run{'s' if count != 1 else ''})" if count else ""
        out.append(f"{name}: RED (run {decided['databaseId']} #{decided.get('number')}, {decided['conclusion']}{streak}){pending}")
        lines, num = explain_run(o_r, decided, tail, repo)
        out += lines
        out.append(f"  clears when: a later {name} run on main is green, or every pushed commit touching a production path "
                   f"carries `Fixes-Red: {num}` (or `Fixes-Red: {decided['databaseId']}`); tools-only commits land while red")
    head = f"ci-why {o_r}: " + ("main is RED for the gate" if red else "main is green for the gate")
    if o_r in GATING:
        try:
            others = outside_gate(o_r)
        except Exception as e:  # the gate's verdict stands without them
            others, out = [], out + [f"outside the gate: could not list main's runs ({e})"]
        if others:
            out.append(f"Outside the gate (red, not blocking a push; oldest first):")
            for name, r, since, count in others:
