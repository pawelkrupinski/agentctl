GATING = {"pawelkrupinski/movies": [("Main", "main.yml"), ("Identity model convergence", "identity-model-convergence.yml")]}
SETUP_STEP = re.compile(r"^(Set up job|Initialize containers|actions/checkout|Checkout|.*(download|upload)-artifact|.*cache@|Set up .*runner)", re.I)
INFRA_LOG = re.compile(r"artifact already exists|ENOENT|No space left on device|Cannot connect to the Docker daemon|"
                       r"connection (refused|reset)|Could not resolve host|TLS handshake timeout|runner .* lost|context deadline exceeded|"
                       r"The operation was canceled|exit code 137|Killed", re.I)
# A job that says it could not judge because something OUTSIDE the code was unreachable (movies' recording health:
# `::error::UNKNOWN: proxy unreachable -- ...`, Record scrape fixtures #2238, the Decodo proxy down): an UNKNOWN, read as
# infra -- never a TEST FAILURE that sends a fixer after a code change.
# Security headers (live) / OG cards say `proxy unavailable (Decodo ...` when every proxy port failed; the Decodo probe
# workflow says `DECODO DOWN:` -- the proxy, not the code.
UNKNOWN_LOG = re.compile(r"::(error|warning)[^:]*::UNKNOWN: |\bUNKNOWN: proxy unreachable\b|proxy unavailable \(Decodo|"
                         r"\bDECODO DOWN: ")
# A job that stopped because an outside service refused the run's key -- a spent quota, a rotated or bad key -- before
# any code was judged (movies' scripts/ci/recording-preflight.sh: `::error::OMDb refuses the key (HTTP 401: Request
# limit reached) ...`, Record scrape fixtures #2426, CI's OMDb key still prod's shared one): the owner's credentials,
# read as infra -- never a TEST FAILURE, which no code change clears and `red block` refuses.
KEY_REFUSED_LOG = re.compile(r"::error[^:]*::\w+ refuses the key\b")
RUN_FIELDS = "databaseId,number,status,conclusion,headSha,url,displayTitle,workflowName,createdAt,updatedAt"
RED_CONCLUSIONS = ("failure", "timed_out")


def repo_path_for(o_r):
    for p in REPOS:
        if os.path.isdir(p) and git_ok(p, "remote", "get-url", REMOTE):
            try:
                if slug(p) == o_r:
                    return p
            except (SystemExit, RuntimeError):
                pass
    return None


def commit_line(o_r, sha, repo=None):
    repo = repo or repo_path_for(o_r)
    if repo and git_ok(repo, "cat-file", "-e", f"{sha}^{{commit}}"):
        return git(repo, "log", "-1", "--format=%h %an <%ae> %ad: %s", "--date=format:%m-%d %H:%M", sha).strip()
    try:
        c = gh_json(o_r, "api", f"repos/{o_r}/git/commits/{sha}")
        a = c.get("author") or c.get("commit", {}).get("author", {})
        msg = c.get("message") or c.get("commit", {}).get("message", "")
        return f"{sha[:9]} {a.get('name')} <{a.get('email')}>: {msg.splitlines()[0] if msg else ''}"
    except Exception:
        return sha[:9]


# scripts/ci/bounded-step.sh --reap's warning: a step outlived its own `timeout-minutes` (the runner gives up on it and
# goes on, so its log just stops). Identity rule ablation #2400 read as UNCLEAR with it in its log.
STEP_TIMED_OUT = "ending what a timed-out step left running"


def timed_out_jobs(log_text):
    """The jobs of a --log-failed output whose log carries bounded-step's timed-out-step warning."""
    return {raw.split("\t", 1)[0] for raw in log_text.splitlines() if STEP_TIMED_OUT in raw and "\t" in raw}


def classify_job(job, lines, raw=(0, []), timed_out=False):
    """('infra'|'unclear'|'test', why) for one failed job, from its steps, relevant log lines and raw (count, tail).
    timed_out: a step of it ran past its own timeout-minutes -- the row's work outgrew its bound, a code/config red
    (`TIMEOUT`), never infra: a rerun meets the same bound."""
    bad = [s for s in job.get("steps") or [] if s.get("conclusion") in ("failure", "timed_out")]
    step = bad[0]["name"] if bad else None
    if timed_out and not any("*** FAILED" in l or "[error]" in l for l in lines):
        return "test", (f"TIMEOUT: step '{step}' ran past its timeout-minutes" if step else "TIMEOUT: a step ran past its timeout-minutes") + \
            " (bounded-step.sh reaped what it left): its work outgrew its bound -- shorten the work or let it stop itself, never rerun"
    if step and SETUP_STEP.match(step):
        return "infra", f"failed in setup step '{step}' (often a `needs:` cascade or runner/setup trouble)"
    if not raw[0] and not lines:
        return "infra", "0-length log" + (f" (step '{step}')" if step else "")
    unknown = next((l for l in lines if UNKNOWN_LOG.search(l)), None)
    if unknown and not any("*** FAILED" in l or "[error]" in l for l in lines):
        return "infra", f"UNKNOWN, an outside dependency unreachable (not a code red): {unknown.strip()[:160]}"
    refused = next((l for l in lines if KEY_REFUSED_LOG.search(l)), None)
    if refused and not any("*** FAILED" in l or "[error]" in l for l in lines):
        return "infra", ("KEY REFUSED, an outside service refused the run's key (quota or credentials: the owner's, "
                         f"not a code red): {refused.strip()[:160]}")
    hit = next((l for l in lines if INFRA_LOG.search(l)), None)
    if hit and not any("*** FAILED" in l or "[error]" in l for l in lines):
        return "infra", f"infra-shaped log line: {hit[:120]}"
    if not lines:
        tail = " | ".join(raw[1])
        return "unclear", f"{raw[0]}-line log with no FAILED/error/assert line (truncated? runner lost?) in step '{step}'; ends: {tail}"
    return "test", f"failed step '{step}'" if step else "test failure"


_gate_lists, _outside_lists = {}, {}  # workflow -> the runs on main gate_runs / outside_gate last listed (newest first)


def gate_runs(o_r):
    """[(workflow, newest decided run on main | None, newer unfinished run | None, red_streak of its runs)]."""
    flows = GATING.get(o_r)
    if not flows:
        recent = gh_json(o_r, "run", "list", "--branch", "main", "--limit", "40", "--json", RUN_FIELDS)
        flows = [(n, n) for n in dict.fromkeys(r["workflowName"] for r in recent)]
    out = []
    for name, wfile in flows:
        runs = gh_json(o_r, "run", "list", "--workflow", wfile, "--branch", "main", "--limit", "30", "--json", RUN_FIELDS)
        decided = next((r for r in runs if r.get("status") == "completed" and r.get("conclusion") in ("success", "failure", "timed_out")), None)
        newer = next((r for r in runs if r.get("status") != "completed"), None)
        if newer and decided and newer["databaseId"] < decided["databaseId"]:
            newer = None
        _gate_lists[name] = runs
        out.append((name, decided, newer, red_streak(runs)))
    return out


def red_streak(runs):
    """(since, count) of the red streak that `runs` (one workflow's on main, newest first) ends on: its decided runs up
    to the newest success, `since` the oldest failure's completion (when CI first said red). (None, 0) when green."""
    decided = [r for r in runs if r.get("status") == "completed" and r.get("conclusion") in ("success",) + RED_CONCLUSIONS]
    streak = list(itertools.takewhile(lambda r: r.get("conclusion") in RED_CONCLUSIONS, decided))
    if not streak:
        return None, 0
    oldest = streak[-1]
    return oldest.get("updatedAt") or oldest.get("createdAt"), len(streak)


def red_for(since, now=None):
    """'3d 4h' / '5h 12m' / '7m' since an ISO time, or '?' when it cannot be read."""
    try:
        t = dt.datetime.fromisoformat(str(since).replace("Z", "+00:00"))
    except ValueError:
        return "?"
    if now is None:  # $AGENTCTL_NOW: the tests' clock
        now = (dt.datetime.fromisoformat(os.environ["AGENTCTL_NOW"].replace("Z", "+00:00")) if os.environ.get("AGENTCTL_NOW")
               else dt.datetime.now(dt.timezone.utc))
    mins = max(0, int((now - t).total_seconds() // 60))
    d, h, m = mins // 1440, mins % 1440 // 60, mins % 60
    return f"{d}d {h}h" if d else f"{h}h {m}m" if h else f"{m}m"


OUTSIDE_FLOW_RECHECK = 1800  # a workflow outside the newest-200 window is listed on its own this often (audit #7)
_flow_files = {}   # main sha -> {workflow name: file}
_flow_runs = {}    # workflow file -> (listed at, its runs on main)


def main_workflow_files(o_r):
    """{workflow name: file} of the workflow files on forgejo/main (cached per main sha); {} when unreadable."""
    repo = scan_repo_for(o_r)
    if not repo or not os.path.isdir(repo):
        return {}
    main = git(repo, "rev-parse", f"refs/remotes/{REMOTE}/main", check=False).stdout.strip()
    if not main:
        return {}
    if main not in _flow_files:
        out = {}
        for d in (".forgejo/workflows", ".github/workflows"):
            r = git(repo, "ls-tree", "--name-only", main, f"{d}/", check=False)
            for path in r.stdout.split():
                if path.endswith((".yml", ".yaml")):
                    txt = git(repo, "show", f"{main}:{path}", check=False).stdout
                    m = re.search(r"^name:\s*[\"']?(.+?)[\"']?\s*$", txt, re.M)
                    out[m.group(1) if m else os.path.basename(path)] = os.path.basename(path)
        _flow_files.clear()
        _flow_files[main] = out
    return _flow_files[main]


def outside_gate(o_r):
    """[(workflow, newest decided run, since, count)] for each workflow on main OUTSIDE the gate whose newest decided
    run is red: not blocking a push, but red, and for how long (the owner, 2026-10-27: a red nobody is shown is a red
    that gets ignored). EVERY workflow file on main is read (audit #7): those in the newest 200 runs from that list,
    the others listed on their own (at most every OUTSIDE_FLOW_RECHECK)."""
    gated = {n for n, _ in GATING.get(o_r, [])}
    runs = gh_json(o_r, "run", "list", "--branch", "main", "--limit", "200", "--json", RUN_FIELDS)
    lists = {}
    for r in runs:
        if r.get("workflowName"):
            lists.setdefault(r["workflowName"], []).append(r)
    for name, wfile in main_workflow_files(o_r).items():
        if name in lists or name in gated:
            continue
        at, mine = _flow_runs.get(wfile, (0.0, None))
        if mine is None or time.time() - at >= OUTSIDE_FLOW_RECHECK:
            try:
                mine = gh_json(o_r, "run", "list", "--workflow", wfile, "--branch", "main", "--limit", "30",
                               "--json", RUN_FIELDS)
                _flow_runs[wfile] = (time.time(), mine)
            except Exception as e:  # this workflow unread this time: the others stand
                err(f"outside the gate: could not list {wfile} ({str(e)[:120]})")
                mine = mine or []
        if mine:
            lists[name] = mine
    out = []
    for name, mine in lists.items():
        if name in gated:
            continue
        _outside_lists[name] = mine
        since, count = red_streak(mine)
        if count:
            decided = next(r for r in mine if r.get("status") == "completed" and r.get("conclusion") in RED_CONCLUSIONS)
            out.append((name, decided, since, count))
    return sorted(out, key=lambda x: str(x[2]))


def explain_run(o_r, run, tail, repo=None):
    """Lines explaining one red run: commit, failed jobs, their log tails, infra vs test."""
    lines, num, _per_job = explain_run_jobs(o_r, run, tail, repo)
    return lines, num


def explain_run_jobs(o_r, run, tail, repo=None):
    """(lines, run number, [(failed job, infra|unclear|test, its first relevant line)])."""
    rid = run["databaseId"]
    d = gh_json(o_r, "run", "view", str(rid), "--json", "jobs,headSha,url,number,status,conclusion,workflowName")
    num = d.get("number") or run.get("number")
    failed = [j for j in d.get("jobs") or [] if j.get("conclusion") in ("failure", "timed_out")]
    try:
        log = fetch_failed_log(o_r, rid) if failed else ""
    except Exception as e:
        log = ""
        err(f"could not read run {rid}'s failed log: {e}")
    per, raws, timed = relevant_lines(log, tail), raw_tails(log), timed_out_jobs(log)
    lines = [f"  run id {rid} (#{num}) {d.get('url') or run.get('url')}",
             f"  commit {commit_line(o_r, d.get('headSha') or run.get('headSha'), repo)}"]
    kinds, fetched, per_job = [], 0, []
    for j in failed:
        jl = per.get(j["name"]) or []
        if fetched < MAX_JOB_LOG_FETCHES and "precommit" in str(d.get("workflowName", "")).lower().replace("-", ""):
            hl = hook_lines(o_r, rid, j, tail)  # the hook's own verdict beats a passing subtest's tail
            if hl:
                fetched, jl = fetched + 1, hl
        bad = [st for st in j.get("steps") or [] if st.get("conclusion") in ("failure", "timed_out")]
        setup = bool(bad) and bool(SETUP_STEP.match(bad[0]["name"]))
        if not jl and not setup and fetched < MAX_JOB_LOG_FETCHES:  # a shifted step slice: read the whole job log
            fetched += 1
            jl = job_log_lines(o_r, rid, j, tail)
        kind, why = classify_job(j, jl, raws.get(j["name"], (0, [])), j["name"] in timed or any(STEP_TIMED_OUT in l for l in jl))
        kinds.append(kind)
        # a job with no error line is known by its failing STEP (a red is its failing test or step, never its job name)
        per_job.append((j["name"], kind, jl[0] if jl else (f"step failed: {bad[0]['name']}" if bad else "")))
        lines.append(f"  [{kind}] {j['name']}: {why}")
        lines += [f"      {l}" for l in jl]
    rerun = f"rerun: {FORGEJO_GH.replace(HOME, '~')} run rerun {rid} --failed -R {o_r}"
    if any(l.startswith("  [test]") and ": TIMEOUT: " in l for l in lines):
        verdict = "TIMEOUT (a step ran past its own timeout-minutes: a code/config red, not a rerun)"
    elif "test" in kinds:
        verdict = "TEST FAILURE"
    elif "unclear" in kinds:
        verdict = f"UNCLEAR (a failed step logged no FAILED/error line: read `forgejo-gh run view {rid} --log-failed`; if infra, {rerun})"
    else:
        verdict = f"INFRA-SHAPED ({rerun})" if kinds else "no failed job listed"
    if not kinds and d.get("status") not in (None, "completed"):  # undecided: running, or waiting for a runner slot
        verdict = (queue_full(o_r, num, runner_queue()) if not any(j.get("startedAt") for j in d.get("jobs") or [])
                   else None) or f"undecided ({d.get('status')})"
    lines.insert(0, f"  verdict: {verdict}")
    return lines, num, per_job


def ci_why(o_r, tail=6, run_id=None, repo=None, summary=False, snap=None):
    """(red, text). run_id: explain that one run; else the gating workflows' newest decided runs on main, each red row
    followed by who holds it (`fixing: <its state, holder or offer>`; never NOBODY). summary: text is the status line's one line."""
    if run_id:
        lines, _ = explain_run(o_r, {"databaseId": int(run_id)}, tail, repo)
        return True, f"run {o_r}#{run_id}\n" + "\n".join(lines)
    out, red, rows, units_of, parts = [], False, [], {}, []
    gate = gate_from_snap(snap) if snap else gate_runs(o_r)
    others, others_err = [], None
    if snap:
        others, others_err = outside_from_snap(snap), snap.get("outside_error")
    elif o_r in GATING:
        try:
            others = outside_gate(o_r)
        except Exception as e:  # the gate's verdict stands without them
            others_err = e
    lrepo = scan_repo_for(o_r, repo)
    lstale = local_stale(lrepo)
    bsnap = snap or ci_state_load(o_r)  # the branch reds come from the snapshot only (the processor writes it)
    explained = {}
    for name, decided, newer, _streak in gate:
        if decided and decided.get("conclusion") in RED_CONCLUSIONS:
            lines, num, per_job = explain_run_jobs(o_r, decided, tail, repo)
            explained[name] = (lines, num)
            save_run_sigs(o_r, decided, name, per_job)
    states, units, flakes_ = {}, [], []
    try:  # who holds each red: its item in the store (the tick acts; ci-why only renders)
        rows = [(n, d, _gate_lists.get(n, []), True) for n, d, _nw, _s in gate]
        units = gate_red_units(o_r, rows, [(n, r, _outside_lists.get(n, []), False) for n, r, _s, _c in others])
        units += local_units(lrepo) + predict_units(o_r, bsnap)
        for u in units:
            units_of.setdefault((u["workflow"], u["run"].get("databaseId")), []).append(u)
        store = Store()
        states = red_view_of_units(store, units)
        flakes_ = [it for it in red_active(store).values() if it["data"].get("red_kind") == "flake"]
    except (Exception, SystemExit) as e:  # who is fixing is information: the gate's verdict stands without it
        err(f"red: could not tell who is fixing ({str(e)[:160]})")

    def fixing(name, run, indent="  "):
        st = states.get((name, run.get("databaseId")))
        return red_lines(st, indent), st

    def short(st):
        return st["short"] if st else "?"

    for name, decided, newer, (since, count) in gate:
        pending = f"; newer run {newer['databaseId']} (#{newer.get('number')}) {newer.get('status')} may clear it" if newer else ""
        if not decided:
            out.append(f"{name}: no decided run on main")
            parts.append(f"{short_flow(name)} ?")
            continue
        if decided["conclusion"] == "success":
            out.append(f"{name}: GREEN (run {decided['databaseId']} #{decided.get('number')})")
            parts.append(f"{short_flow(name)} green")
            continue
        red = True
        streak = f"; red for {red_for(since)} ({count} failed run{'s' if count != 1 else ''})" if count else ""
        out.append(f"{name}: RED (run {decided['databaseId']} #{decided.get('number')}, {decided['conclusion']}{streak}){pending}")
        flines, finfos = fixing(name, decided)
        out += flines
        lines, num = explained.get(name) or explain_run(o_r, decided, tail, repo)
        out += lines
        out.append(f"  clears when: a later {name} run on main is green, or every pushed commit touching a production path "
                   f"carries `Fixes-Red: {num}` (or `Fixes-Red: {decided['databaseId']}`); tools-only commits land while red")
        parts.append(f"{short_flow(name)} #{decided.get('number')} \u2192 {short(finfos)}")
    lus = local_units(lrepo)
    local = [u for u in units_of.get((LOCAL_FLOW, (lus or [{"run": {}}])[0]["run"].get("databaseId")), [])]
    if lstale:
        out.append(f"{LOCAL_FLOW}: stale, rechecking (recorded on {str(local_red().get('main'))[:10]}; "
                   f"{REMOTE}/main is {lstale[:10]} now)")
        parts.append("local \u2192 stale, rechecking")
    if local:
        lr = local_red()
        main = str(lr.get("main"))[:10]
        out.append(f"{LOCAL_FLOW}: RED on plain {REMOTE}/main {main} ({', '.join(u['job'] for u in local)}: pre-push fails "
                   f"there without any change) -- claim: `agentctl red claim local`")
        flines, finfos = fixing(LOCAL_FLOW, local[0]["run"])
        out += flines
        for u in local:
            out.append(f"  [{u['job']}] {u['line'][:160]}")
        parts.append(f"local checks \u2192 {short(finfos)}")
    if flakes_:
        out.append("Flaky (passed on the next run with no fix; a red until a fix lands and a run proves it):")
        for it in flakes_:
            out.append(f"  {red_what(it['data'])}: {str(it['data'].get('line'))[:120]}")
            out.append(f"    fixing: {red_view(Store(), it)[0]}")
    head = f"ci-why {o_r}: " + ("main is RED for the gate" if red else "main is green for the gate")
    if others_err is not None:
        out.append(f"outside the gate: could not list main's runs ({others_err})")
    if others:
        out.append(f"Outside the gate (red, not blocking a push; oldest first):")
        for name, r, since, count in others:
            out.append(f"  {name}: RED for {red_for(since)} since {since} ({count} failed run{'s' if count != 1 else ''}; "
                       f"newest run {r['databaseId']} #{r.get('number')}) -- `agentctl ci-why {r['databaseId']}`")
            out += fixing(name, r, "    ")[0]
    blines = branch_lines(bsnap)
    if blines:
        out += blines
        for u in units_of.values():
            for x in u:
                if x.get("predicts"):
                    out += fixing(x["workflow"], x["run"], "    ")[0]
                    break
    if summary:
        line = "gate RED" if red else "gate green"
        if red:
            line += " (" + "; ".join(p_ for p_ in parts if not p_.startswith("local")) + ")"
        reds_, causes = [], {}
        for name, r, _since, _count in others:
            st = fixing(name, r)[1]
            cause = (st or {}).get("cause") if (st or {}).get("state") == "blocked-external" else None
            if cause:  # ONE line per outage, naming the reds it blocks
                causes.setdefault(cause, (st.get("until"), []))[1].append(name)
                continue
            reds_.append(f"{name} #{r.get('number')} \u2192 {short(st)}")
        reds_ = [f"{c} down \u2192 blocks: {', '.join(ns)}" + (f" (auto-clears when {u_})" if u_ else "")
                 for c, (u_, ns) in causes.items()] + reds_
        reds_ += [p_ for p_ in parts if p_.startswith("local")]
        if len(reds_) > SUMMARY_MAX_REDS:
            reds_ = reds_[:SUMMARY_MAX_REDS] + [f"+{len(reds_) - SUMMARY_MAX_REDS} more"]
        if reds_:
            line += " \u00b7 reds: " + "; ".join(reds_)
        bsum = branch_summary(bsnap)
        if not reds_ and not bsum and not red and others_err is None:
            line += " \u00b7 no reds"
        if bsum:
            line += " \u00b7 " + bsum
        return red, line
    return red, "\n".join([head] + out)


# THE ONE CI-STATE SNAPSHOT (the owner, 2026-10-27: the watch, the gate summary, ci-why's outside list and the red patrol
# each polled Forgejo on their own and disagreed). The processor reads every main workflow once per cycle, writes
# ci-state.json atomically; the gate verdict, the outside-the-gate reds, the published summary and the patrol read it.
# One older than CI_STATE_MAX_AGE is UNREAD (never green).
CI_STATE_MAX_AGE = 180


# THE SNAPSHOT (design §9, phase 1 step 13): ONE file, state.json at the state root, written by the processor -- the
# gate's read (`ci`), the published gate line (`summary`), and each tick the items (changes, the batch, reds,
# conditions), `tick_at` and the code version. The status line and `ci-why --summary --cached` read only it; their
# staleness words come from its times. ci-state.json, gate-summary.txt and the statusline.stale marker are gone.
_state_lock = __import__("threading").Lock()


def state_path():
    return os.environ.get("AGENTCTL_STATE_FILE") or state_root("state.json")


def state_read():
    try:
        with open(state_path()) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def state_update(**parts):
    """Merge parts into state.json, atomically (one writer at a time: a lock file, and a lock for this process's
    threads)."""
    path = state_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with _state_lock, open(path + ".lock", "a+") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        d = state_read()
        d.update(parts)
        tmp = f"{path}.{os.getpid()}.tmp"
        with open(tmp, "w") as f:
            json.dump(d, f)
        os.replace(tmp, path)
    return d


def ci_state_refresh(o_r, write=True):
    """Read the gate and every other workflow on main once, write the snapshot (unless write=False: ci_state_write
    later), return it. Raises when the gate cannot be read (nothing is written: the old snapshot ages out)."""
    gate = gate_runs(o_r)
    snap = {"at": time.time(), "repo": o_r, "outside_error": None, "outside": [],
            "gate": [{"name": n, "decided": d, "newer": nw, "since": st[0], "count": st[1],
                      "runs": _gate_lists.get(n, [])} for n, d, nw, st in gate]}
    if o_r in GATING:
        try:
            snap["outside"] = [{"name": n, "decided": r, "since": since, "count": count,
                                "runs": _outside_lists.get(n, [])} for n, r, since, count in outside_gate(o_r)]
        except Exception as e:
            snap["outside_error"] = str(e)[:200]
    try:  # the branch runs: measure/*, check/*, red fixers' and every recorded dispatch's (after the main lists)
        prev = (state_read().get("ci") or {}).get("branches") or []
        snap["branches"] = branch_state(o_r, scan_repo_for(o_r), prev)
    except (Exception, SystemExit) as e:
        snap["branches_error"] = str(e)[:200]
    latest = {}  # each workflow's newest decided run on main: what workflow_green probes read
    for name, runs in list(_outside_lists.items()) + list(_gate_lists.items()):
        d = next((r for r in runs if r.get("status") == "completed" and not is_cancelled(r)), None)
        if d:
            latest[name] = {k: d.get(k) for k in ("number", "databaseId", "conclusion", "headSha", "updatedAt")}
    snap["latest"] = latest
    snap["stuck"] = stuck_runs({**_outside_lists, **_gate_lists}, o_r=o_r)  # audit #8: undecided far past their workflow's p90
    if write:
        ci_state_write(snap)
    return snap


def ci_state_write(snap):
    state_update(ci=snap)
    return snap


def ci_state_load(o_r, now=None):
    """The snapshot when it is for o_r and at most CI_STATE_MAX_AGE old, else None (unread)."""
    try:
        snap = state_read().get("ci") or {}
        age = (now or time.time()) - float(snap["at"])
    except (KeyError, TypeError, ValueError):
        return None
    return snap if snap.get("repo") == o_r and -5 <= age <= CI_STATE_MAX_AGE else None


def gate_from_snap(snap):
    out = []
    for g in snap["gate"]:
        _gate_lists[g["name"]] = g["runs"]
        out.append((g["name"], g["decided"], g["newer"], (g["since"], g["count"])))
    return out


def outside_from_snap(snap):
    out = []
    for g in snap["outside"]:
        _outside_lists[g["name"]] = g["runs"]
        out.append((g["name"], g["decided"], g["since"], g["count"]))
    return out


# ---------------------------------------------------------------- branch runs: every dispatch has an owner, every branch red a route
# The owner (2026-10-27): "red not captured, make a structural fix". Identity model convergence #2116 (run 3264) on
# measure/pawel/982f7681f-0b04a4 failed and nobody was told: the snapshot, the status line and the reds covered main only,
# and a branch run (measure/*, check/*, a red fixer's) had no owner and no route.
#
# OWNER RECORDS, ~/.cache/agentctl/dispatches/<key>.json ($AGENTCTL_DISPATCH_DIR): every CI run agentctl or an agent
# dispatches -- the branch and/or run id, the worktree, the session or agent name, the pid, the purpose, the inputs, the
# time. `agentctl dispatch run` (a `forgejo-gh workflow run` wrapper) and `agentctl dispatch record` write one; so do
# agentctl's own dispatches (the queue's remote checks, the Fixes-Red verification). A branch run with none (the movies
# scripts call forgejo-gh themselves) is matched after the fact: measure/<user>/<sha>-<x> (else the run's head commit) to
# the worktree whose HEAD is that commit or whose HEAD reflog holds it; check/<entry> to that queue entry's worktree. The
# match is recorded, so it is made once.
#
# THE SNAPSHOT also records the newest completed run of each tracked branch and workflow (a branch with an owner record,
# or measure/*, check/*, red-*). A failed one is ONE inbox entry, `BRANCH RED: <workflow> #N on <branch> → owner <...>`
# with the first error lines (a wake-up kind for `inbox wait`). It stays a branch red until its branch is deleted or a
# newer run of that workflow on the branch is green.
#
# PREDICTS MAIN RED: the failing run is built on commits all on main now (ancestor or patch-equivalent), AND it ran with
# the inputs main's run of that workflow uses (the dispatch inputs, minus INPUTS_NOT_PREDICTIVE). Main will hit it next,
# so it is claimed and dispatched like a main red, before main fails. Inputs that differ make it a plain BRANCH RED, the
# line naming them ("recording 3166 ≠ main's 573": run 3264 replayed the fresh 10-27 recording, main replays the pinned
# one with its fixture fills). A measure on a NEWER recording that fails hermetically (a test failure, not infra) also
# says "blocks promoting recording N": that recording lacks something a promotion of it will need.
DISPATCH_PATTERNS = ("measure/", "check/", "red-")
MEASURE_BRANCH = re.compile(r"^measure/[^/]+/([0-9a-f]{7,40})-[0-9A-Za-z]+$")
# inputs that change where or how a run runs, or how much of it, never what main's run of the same workflow would decide
INPUTS_NOT_PREDICTIVE = frozenset({"tier", "runner", "profile", "jvm-options", "heap", "reuse-run", "takes-base",
                                   "takes-countries", "countries"})
# What main's convergence replays when its `recording` input is empty: each country's pin, the first word of the
# `hermetic-<code>.txt` asset of the release convergence-setup.sh reads ($FIXTURE_RELEASE_TAG in the convergence
# workflow on forgejo/main). Read from the movies repo by the processor (refresh_pinned_recording), cached in
# pinned-recording.json; $AGENTCTL_PINNED_RECORDING overrides. Never hard-coded (it was "573", and goes stale when a
# recording is promoted).
CONVERGENCE_WORKFLOW = ".github/workflows/identity-model-convergence.yml"
PIN_REFRESH = 3600
BRANCH_RUNS_LIMIT = 150
BRANCH_ROUTE_MAX_AGE = 24 * 3600  # a failure first seen older than this is recorded, not routed (no flood on upgrade)
OWNER_REMATCH = 3600  # an unmatched branch is matched again after this long
DB_HOST = "pawel@10.1.0.3"


def dispatches_dir(*parts):
    d = os.environ.get("AGENTCTL_DISPATCH_DIR") or os.path.join(os.path.dirname(reds_dir()), "dispatches")
    return os.path.join(d, *parts)


def dispatch_key(branch=None, run_id=None):
    return f"branch-{re.sub(r'[^A-Za-z0-9._-]', '_', branch)}" if branch else f"run-{run_id}"


def save_dispatch(rec, key=None):
    """Write an owner record (merged over an existing one: a later field wins, a None never erases). Returns it."""
    p = dispatches_dir(f"{key or dispatch_key(rec.get('branch'), rec.get('run_id'))}.json")
    old = read_record(p) or {}
    rec = {**old, **{k: v for k, v in rec.items() if v is not None}}
    write_json(p, rec)
    return rec


def record_dispatch(branch=None, run_id=None, workflow=None, purpose="", inputs=None, worktree=None, sha=None,
                    agent=None, pid=None, key=None, source="registered"):
    """The owner record of a dispatch made from here: who (agent name, Claude session, pid) and where (worktree)."""
    if not branch and not run_id:
        raise SystemExit("agentctl: a dispatch is recorded by its branch or its run id")
    wt = worktree or worktree_of(safe_cwd())
    cp = os.environ.get("CLAUDE_PID") or ""
    pid = pid or (int(cp) if cp.isdigit() else os.getppid())
    return save_dispatch({"branch": branch, "run_id": int(run_id) if str(run_id or "").isdigit() else None,
                          "workflow": workflow, "purpose": purpose, "inputs": inputs, "worktree": wt, "sha": sha,
                          "session": os.environ.get("CLAUDE_CODE_SESSION_ID") or None,
                          "agent": agent or os.environ.get("AGENTCTL_AGENT_NAME") or None, "pid": pid,
                          "process_start": process_start(pid) if pid else None, "at": ts(), "epoch": time.time(),
                          "source": source}, key)


def dispatch_records():
    out = []
    for p in sorted(glob.glob(dispatches_dir("*.json"))):
        r = read_record(p)
        if r:
            out.append(r)
    return out


def dispatch_for(branch, run_id=None):
    """The owner record of a branch run: its run's, else its branch's (None when there is none)."""
    for key in ([dispatch_key(None, run_id)] if run_id else []) + ([dispatch_key(branch)] if branch else []):
        r = read_record(dispatches_dir(f"{key}.json"))
        if r and (r.get("worktree") or r.get("agent") or r.get("session")):
            return r
    return None


def tracked_branch(name, recorded=()):
    return bool(name) and name not in PROTECTED_BRANCHES and (name.startswith(DISPATCH_PATTERNS) or name in recorded)


INTERNAL_TREE = re.compile(r"-wt-(check-\d+|waiting|batch)$")  # legacy fallback: trees made before they were tagged


def internal_trees_dir(*parts):
    d = os.environ.get("AGENTCTL_INTERNAL_TREES_DIR") or state_root("internal-trees")
    return os.path.join(d, *parts)


def mark_internal(path):
    """Tag a worktree agentctl made for itself (check-N, baseline, recheck, waiting, batch, a finished red fixer's):
    a registry entry, so owner and fixer detection exclude it by the tag, not by what the tree is called."""
    if not path:
        return path
    try:
        import hashlib
        p = os.path.realpath(path)
        os.makedirs(internal_trees_dir(), exist_ok=True)
        write_json(internal_trees_dir(hashlib.sha1(p.encode()).hexdigest() + ".json"), {"path": p, "at": ts()})
    except OSError:
        pass
    return path


def internal_tree(path):
    """agentctl's own trees -- tagged at creation (mark_internal): the queue's check trees, the baseline / recheck /
    `waiting` / batch trees, a finished red fixer's tree, the queue's work clone, tool caches -- never an owner, author
    or fixer (2026-10-27: the status line said `main #2146 → check-1 committed` for a fix that had landed; ci-why
    credited movies-wt-baseline-65721). A queued change's owner is its queue entry's source worktree."""
    import hashlib
    p = os.path.realpath(path or "")
    return os.path.exists(internal_trees_dir(hashlib.sha1(p.encode()).hexdigest() + ".json")) \
        or bool(INTERNAL_TREE.search(p.rstrip("/"))) or p.startswith(os.path.realpath(CACHE_TREES).rstrip("/") + "/") \
        or p.startswith(os.path.realpath(waiting_dir()).rstrip("/") + "/")


def worktree_holding(repo, sha):
    """The worktree whose HEAD is sha, else the one whose HEAD reflog holds it (the agent's own commit, since rebased).
    Never one of agentctl's internal trees."""
    try:
        trees = [w for w in worktrees(repo) if isinstance(w.get("worktree"), str) and os.path.isdir(w["worktree"])
                 and not internal_tree(w["worktree"])]
    except (RuntimeError, OSError):
        return None
    trees = trees[1:] + trees[:1]  # an agent's worktree before the root checkout (often on main itself)
    for w in trees:
        if str(w.get("HEAD", "")).startswith(sha):
            return w["worktree"]
    for w in trees:
        r = git(w["worktree"], "reflog", "--format=%H", "HEAD", check=False)
        if r.returncode == 0 and any(h.startswith(sha) for h in r.stdout.split()):
            return w["worktree"]
    return None


def queue_entry_worktree(entry_id):
    for p in glob.glob(os.path.join(waiting_dir(), "*", "entries", f"{entry_id}.json")):
        e = read_record(p) or {}
        if e.get("worktree"):
            return e["worktree"]
    return None


def branch_base(branch, run):
    """The commit a branch run was built on: a measure/<user>/<sha>-<x> branch names it (identity-ci-run pushes main's CI
    laid over it), else the run's head commit."""
    m = MEASURE_BRANCH.match(branch or "")
    return m.group(1) if m else run.get("headSha")


def owner_of(repo, branch, run):
    """The owner record of a branch run, matched after the fact (and recorded) when nobody recorded one."""
    rid = run.get("databaseId")
    rec = dispatch_for(branch, rid)
    if rec:
        return rec
    key = dispatch_key(branch)
    old = read_record(dispatches_dir(f"{key}.json")) or {}
    if old.get("source") == "unmatched" and time.time() - float(old.get("epoch") or 0) < OWNER_REMATCH:
        return None
    wt, how = None, None
    if branch.startswith("check/"):
        wt, how = queue_entry_worktree(branch[len("check/"):]), "its queue entry"
    base = branch_base(branch, run)
    if not wt and repo and base:
        wt, how = worktree_holding(repo, base), f"the worktree that holds {base[:9]}"
    if not wt:
        save_dispatch({"branch": branch, "run_id": rid, "workflow": run.get("workflowName"), "source": "unmatched",
                       "at": ts(), "epoch": time.time()}, key)
        return None
    return save_dispatch({"branch": branch, "run_id": rid, "workflow": run.get("workflowName"), "worktree": wt,
                          "sha": base, "purpose": f"matched by branch name ({how})", "source": "matched",
                          "at": ts(), "epoch": time.time()}, key)


def owner_gone(rec):
    """True when the owner is gone: its worktree removed, or its recorded pid dead. None: no owner known."""
    if not rec or not (rec.get("worktree") or rec.get("pid")):
        return None
    if rec.get("worktree") and not os.path.isdir(rec["worktree"]):
        return True
    if rec.get("pid") and not proc_alive(rec["pid"], rec.get("process_start")):
        return True
    return False


def owner_text(rec, short=False):
    if not rec:
        return "NOBODY (no owner record, no worktree holds its commit)"
    wt = rec.get("worktree") or ""
    who = rec.get("agent") or (f"session {rec['session'][:8]}" if rec.get("session") else None)
    if short:
        return os.path.basename(wt) if wt else (who or "?")
    return wt.replace(HOME, "~") + (f" ({who})" if who and who != os.path.basename(wt) else "") if wt else (who or "?")


def ssh_master_up(host=DB_HOST):
    """An open ssh control connection to the DB host: asking it costs no Touch ID prompt."""
    try:
        return subprocess.run(["ssh", "-O", "check", host], capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def db_inputs(run_ids):
    """{run id: its workflow_dispatch inputs} from Forgejo's DB (the API does not serve them), for the ids not cached.
    Asked only from an interactive foreground or over an open ssh control connection: never a prompt from the processor
    ($AGENTCTL_DB_INPUTS=0 never asks, =1 always)."""
    ids = sorted({int(i) for i in run_ids if str(i).isdigit()})
    mode = os.environ.get("AGENTCTL_DB_INPUTS")
    if not ids or mode == "0" or (mode != "1" and not (interactive_foreground() or ssh_master_up())):
        return {}
    sql = ("select id, json_extract(event_payload, '$.inputs') from action_run where id in ("
           + ",".join(map(str, ids)) + ")")
    try:
        r = run_db(DB_ENVS["forgejo"], sql)
    except (OSError, subprocess.TimeoutExpired):
        return {}
    out = {}
    for line in r.stdout.splitlines()[1:] if r.returncode == 0 else []:
        rid, _, js = line.partition("\t")
        try:
            out[int(rid)] = json.loads(js) if js.strip() else {}
        except ValueError:
            continue
    for rid, inputs in out.items():
        write_json(dispatches_dir("inputs", f"{rid}.json"), inputs)
    return out


def run_inputs(runs, recs=None):
    """{run id: inputs or None (unread)} for runs: {} for a run not dispatched by hand (a push), else the owner record's,
    the cache, Forgejo's DB."""
    out, want = {}, []
    for run in runs:
        rid = run.get("databaseId")
        rec = (recs or {}).get(rid)
        cached = read_record(dispatches_dir("inputs", f"{rid}.json"))
        if run.get("event") and run["event"] != "workflow_dispatch":
            out[rid] = {}
        elif rec and rec.get("inputs") is not None and rec.get("run_id") in (None, rid):
            out[rid] = rec["inputs"]
        elif cached is not None:
            out[rid] = cached
        else:
            out[rid] = None
            want.append(rid)
    for rid, inputs in db_inputs(want).items():
        out[rid] = inputs
    return out


def norm_input(v):
    v = "" if v is None else str(v).strip()
    return "" if v.lower() in ("false", "") else v


def input_diff(inputs, main_inputs):
    """[(key, the branch run's value, main's)] of the predictive inputs that differ."""
    keys = sorted((set(inputs) | set(main_inputs)) - INPUTS_NOT_PREDICTIVE)
    return [(k, norm_input(inputs.get(k)), norm_input(main_inputs.get(k))) for k in keys
            if norm_input(inputs.get(k)) != norm_input(main_inputs.get(k))]


def pinned_path():
    return os.path.join(os.path.dirname(reds_dir()), "pinned-recording.json")


def pin_release_tag(repo):
    """The release the convergence pins live in: FIXTURE_RELEASE_TAG as main's convergence workflow sets it."""
    r = git(repo, "show", f"refs/remotes/{REMOTE}/main:{CONVERGENCE_WORKFLOW}", check=False) if repo else None
    tags = re.findall(r"FIXTURE_RELEASE_TAG:\s*['\"]?([\w.-]+)", r.stdout if r and r.returncode == 0 else "")
    return tags[0] if tags else None


def read_pins(o_r, tag):
    """{country code: pinned recording run} from the release's hermetic-<code>.txt assets."""
    rel = api(o_r, "GET", f"releases/tags/{urllib.parse.quote(tag)}")
    base = API.split("/api/")[0]
    pins = {}
    for a in (rel or {}).get("assets") or []:
        m = re.fullmatch(r"hermetic-(\w+)\.txt", a.get("name") or "")
        if not m:
            continue
        url = f"{base}/{o_r}/releases/download/{urllib.parse.quote(tag)}/{a['name']}"
        req = urllib.request.Request(url, headers={"Authorization": f"token {token(o_r)}"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            first = (resp.read().decode(errors="replace").splitlines() or [""])[0].split()
        if first and first[0].isdigit():
            pins[m.group(1)] = first[0]
    return pins


def refresh_pinned_recording(o_r, repo, now_=None, force=False):
    """Re-read the convergence pins at most every PIN_REFRESH s (the processor's loop). Never fatal."""
    t = now_ if now_ is not None else time.time()
    rec = read_record(pinned_path()) or {}
    if not force and t - float(rec.get("at") or 0) < PIN_REFRESH:
        return rec
    try:
        tag = pin_release_tag(repo)
        if not tag:
            return rec
        pins = read_pins(o_r, tag)
        if pins:
            rec = {"at": t, "repo": o_r, "tag": tag, "pins": pins}
            write_json(pinned_path(), rec)
    except (Exception, SystemExit) as e:
        err(f"pinned recording: not re-read ({str(e)[:160]})")
    return rec


def pinned_runs():
    """The recordings main's convergence replays by default (one per pinned country, deduplicated), or []."""
    if os.environ.get("AGENTCTL_PINNED_RECORDING"):
        return [os.environ["AGENTCTL_PINNED_RECORDING"]]
    pins = (read_record(pinned_path()) or {}).get("pins") or {}
    return sorted(set(pins.values()), key=lambda x: int(x) if x.isdigit() else 0)


def pinned_recording():
    """main's pinned recording as a name: `573`, `528/573` when the countries' pins differ, or `the pinned pair
    (unread)`."""
    runs = pinned_runs()
    return "/".join(runs) if runs else "the pinned pair (unread)"


def diff_text(diff):
    parts = []
    for k, mine, theirs in diff[:3]:
        if k == "recording" and not theirs:
            theirs = pinned_recording()
        parts.append(f"{k} {mine or '(none)'} ≠ main's {theirs or '(none)'}")
    return ", ".join(parts) + (f" (+{len(diff) - 3} more)" if len(diff) > 3 else "")


def newer_recording(inputs, main_inputs):
    """The branch run's recording when it is newer than the one main replays, else None."""
    mine, theirs = norm_input(inputs.get("recording")), norm_input(main_inputs.get("recording"))
    ref = [int(theirs)] if theirs.isdigit() else [int(x) for x in pinned_runs() if x.isdigit()] if not theirs else []
    return mine if mine.isdigit() and ref and int(mine) > max(ref) else None


def predicts_main(repo, base, main_run, inputs, main_inputs):
    """(predicts, why not / '') for a failed branch run."""
    if not repo or not base:
        return False, "its commit is unknown here"
    if not git_ok(repo, "cat-file", "-e", f"{base}^{{commit}}"):
        return False, f"its commit {base[:9]} is not here"
    if not merged_reason(repo, base, f"refs/remotes/{REMOTE}/main"):
        return False, f"its commit {base[:9]} is not on main"
    if not main_run:
        return False, "main runs no such workflow"
    if inputs is None or main_inputs is None:
        return False, "its inputs or main's are unread (`agentctl ci-why` from a terminal reads them)"
    diff = input_diff(inputs, main_inputs)
    if diff:
        return False, diff_text(diff)
    return True, ""


def branch_exists(o_r, name):
    """False only when Forgejo says the branch is gone (404); True otherwise (an unread answer keeps it)."""
    try:
        gh_json(o_r, "api", f"repos/{o_r}/branches/{urllib.parse.quote(name, safe='')}")
        return True
    except (Exception, SystemExit) as e:
        return not re.search(r"HTTP 404|Not Found", str(e))


def branch_state(o_r, repo, prev=None):
    """[entry] per tracked (branch, workflow): the newest completed run, its owner, whether its branch is alive, and for
    a red one whether it PREDICTS MAIN RED (why not). A red no longer listed carries over from prev until its branch
    is gone."""
    runs = gh_json(o_r, "run", "list", "--limit", str(BRANCH_RUNS_LIMIT), "--json", RUN_FIELDS + ",headBranch,event")
    recorded = {r.get("branch") for r in dispatch_records() if r.get("branch")}
    latest, newest_main = {}, {}
    for r in runs:  # newest first
        b, wf = r.get("headBranch") or "", r.get("workflowName")
        if r.get("status") != "completed":
            continue
        if b == "main":
            newest_main.setdefault(wf, r)
        elif tracked_branch(b, recorded):
            latest.setdefault((b, wf), r)
    for wf, rs in list(_gate_lists.items()) + list(_outside_lists.items()):
        m = next((r for r in rs if r.get("status") == "completed"), None)
        if m and (wf not in newest_main or m["databaseId"] > newest_main[wf]["databaseId"]):
            newest_main[wf] = m
    for e in prev or []:  # a red past the listed window stays one until its branch goes or turns green
        k = (e["branch"], e["workflow"])
        if e.get("red") and k not in latest and e.get("alive"):
            latest[k] = dict(e["run"], headBranch=e["branch"], workflowName=e["workflow"])
    reds = {k: r for k, r in latest.items() if r.get("conclusion") in RED_CONCLUSIONS}
    recs = {r["databaseId"]: owner_of(repo, b, r) for (b, _wf), r in reds.items()}
    mains = {wf: newest_main.get(wf) for (_b, wf) in reds}
    inputs = run_inputs(list(reds.values()) + [m for m in mains.values() if m], recs)
    out = []
    for (b, wf), r in sorted(latest.items()):
        e = {"branch": b, "workflow": wf, "run": {k: r.get(k) for k in ("databaseId", "number", "conclusion", "headSha",
                                                                          "updatedAt", "url", "event")},
             "red": (b, wf) in reds}
        if e["red"]:
            rec, m = recs.get(r["databaseId"]), mains.get(wf)
            base = branch_base(b, r)
            mine, theirs = inputs.get(r["databaseId"]), inputs.get(m["databaseId"]) if m else None
            pred, why = predicts_main(repo, base, m, mine, theirs)
            e.update(owner=rec, owner_gone=owner_gone(rec), base=base, alive=branch_exists(o_r, b), predicts=pred,
                     why=why, main_run=m and {"databaseId": m["databaseId"], "number": m.get("number")},
                     newer_recording=newer_recording(mine, theirs) if mine is not None and theirs is not None else None)
        out.append(e)
    return out


def branch_reds(snap):
    """The snapshot's live branch reds: failed, branch still there (newest run of that workflow on it)."""
    return [e for e in (snap or {}).get("branches") or [] if e.get("red") and e.get("alive")]


def routed_path(rid):
    return dispatches_dir("routed", f"{rid}.json")


def entry_predicts(e):
    """PREDICTS MAIN RED, unless the routed failure is infra-shaped only (a runner's trouble predicts nothing)."""
    return bool(e.get("predicts")) and not (read_record(routed_path(e["run"]["databaseId"])) or {}).get("infra")


def branch_red_line(e):
    r, rec = e["run"], e.get("owner")
    line = f"BRANCH RED: {e['workflow']} #{r.get('number')} on {e['branch']} → owner {owner_text(rec)}"
    if entry_predicts(e):
        line += f"; PREDICTS MAIN RED (its commit {str(e.get('base'))[:9]} is on main, main's inputs)"
    elif e.get("why"):
        line += f" ({e['why']})"
    rt = read_record(routed_path(r["databaseId"])) or {}
    if rt.get("blocks_promoting"):
        line += f"; blocks promoting recording {rt['blocks_promoting']}"
    return line


def route_branch_reds(o_r, snap, now_=None):
    """ONE inbox entry per failed branch run (BRANCH RED) whose branch still exists, with ci-why's first error lines;
    signatures saved, so a PREDICTS MAIN RED run is a red unit. Returns the lines written."""
    t = now_ if now_ is not None else time.time()
    written = []
    for e in (snap or {}).get("branches") or []:
        r = e["run"]
        if not e.get("red") or not e.get("alive") or os.path.exists(routed_path(r["databaseId"])):
            continue  # a run on a deleted branch is dropped silently: its owner finished with it
        try:
            done = dt.datetime.fromisoformat(str(r.get("updatedAt")).replace("Z", "+00:00")).timestamp()
        except ValueError:
            done = t
        if t - done > BRANCH_ROUTE_MAX_AGE:
            write_json(routed_path(r["databaseId"]), {"at": ts(), "routed": False, "why": "older than the route window"})
            continue
        try:
            lines, _num, per_job = explain_run_jobs(o_r, dict(r, workflowName=e["workflow"]), 4)
            save_run_sigs(o_r, r, e["workflow"], per_job)
        except (Exception, SystemExit) as ex:
            lines, per_job = [f"  (could not read the run: {str(ex)[:160]})"], []
        kinds = {k for _j, k, _l in per_job}
        rec = {"at": ts(), "routed": True, "infra": bool(kinds) and kinds <= {"infra"},
               "blocks_promoting": e.get("newer_recording") if "test" in kinds else None}
        write_json(routed_path(r["databaseId"]), rec)
        line = branch_red_line(e)
        tail = [l for l in lines if l.startswith("      ") or l.startswith("  [")][:INBOX_TAIL] or lines[:INBOX_TAIL]
        inbox_write("branch", line, [line], tail, 1, cwd=(e.get("owner") or {}).get("worktree"))
        written.append(line)
    return written


def predict_units(o_r, snap):
    """Red units for the branch reds that PREDICT MAIN RED: gate reds (claimed, RED UNCLAIMED, dispatched) before main
    fails. Their signatures are the run's: main failing the same way later is the same red."""
    units = []
    for e in branch_reds(snap):
        if not entry_predicts(e):
            continue
        run = dict(e["run"], headBranch=e["branch"], workflowName=e["workflow"])
        for u in gate_red_units(o_r, [(e["workflow"], run, [run], True)]):
            u["predicts"] = e["branch"]
            units.append(u)
    return units


def branch_lines(snap):
    """ci-why's section on the branch reds."""
    reds = branch_reds(snap)
    if not reds:
        return []
    out = [f"Branch reds (runs on measure/check/fixer branches; {len(reds)}):"]
    for e in reds:
        out.append("  " + branch_red_line(e).removeprefix("BRANCH RED: ")
                   + f" -- `agentctl ci-why {e['run']['databaseId']}`")
    return out


def branch_summary(snap):
    """`branch reds: N → owner (workflow #n[ PREDICTS MAIN RED]); ...` for the status line, or ''."""
    reds = branch_reds(snap)
    if not reds:
        return ""
    parts = [f"{owner_text(e.get('owner'), short=True)} ({short_flow(e['workflow'])} #{e['run'].get('number')}"
             + (" PREDICTS MAIN RED" if entry_predicts(e) else "") + ")" for e in reds]
    if len(parts) > SUMMARY_MAX_REDS:
        parts = parts[:SUMMARY_MAX_REDS] + [f"+{len(parts) - SUMMARY_MAX_REDS} more"]
    return f"branch reds: {len(reds)} → " + "; ".join(parts)


def orphan_branches(repo, o_r, dry, out, runs_for=None):
    """The sweep's part: remote tracked branches whose owner is gone (worktree removed or pid dead) and whose runs all
    finished. measure/* ones are deleted (the standing OK: a finished measure/* branch); the rest are listed."""
    runs_for = runs_for or (lambda b: gh_json(o_r, "run", "list", "--branch", b, "--limit", "20", "--json", RUN_FIELDS))
    recorded = {r.get("branch") for r in dispatch_records() if r.get("branch")}
    found = []
    for line in git(repo, "ls-remote", "--heads", REMOTE, check=False).stdout.splitlines():
        sha, ref = line.split()
        b = ref.removeprefix("refs/heads/")
        if not tracked_branch(b, recorded) or b in SWEEP_KEEP_REMOTE:
            continue
        try:
            runs = runs_for(b)
        except (Exception, SystemExit) as e:
            out.append(f"  branch {b}: its runs unread ({str(e)[:100]}), kept")
            continue
        if any(r.get("status") != "completed" for r in runs):
            continue
        rec = owner_of(repo, b, (runs or [{}])[0] | {"headSha": sha}) if runs else dispatch_for(b)
        gone = owner_gone(rec)
        if not gone:
            continue
        found.append(b)
        what = f"owner {owner_text(rec)} gone, {len(runs)} run(s) finished"
        if not b.startswith("measure/"):
            out.append(f"  OWNER GONE branch {b} {sha[:10]}: {what} (listed, kept)")
        elif dry:
            out.append(f"  would delete OWNER GONE branch {b} {sha[:10]}: {what}")
        else:
            try:
                delete_remote_branch(repo, o_r, b, sha)
                log_deletion("remote-branch", o_r, b, sha, f"sweep: {what}")
                out.append(f"  deleted OWNER GONE branch {b} {sha[:10]}: {what}")
            except Exception as e:
                out.append(f"  OWNER GONE branch {b} not deleted: {e}")
    return found


DISPATCH_HELP = """Every CI run dispatched by hand has an owner record (~/.cache/agentctl/dispatches/): its failures are
routed to that owner (BRANCH RED in the inbox), and a run predicting main's next red is claimed and fixed like one.

  agentctl dispatch run <workflow> --ref <branch> [-f key=value ...] [--purpose "..."]
      `forgejo-gh workflow run`, recorded: the worktree (the cwd's), CLAUDE_CODE_SESSION_ID / $AGENTCTL_AGENT_NAME,
      $CLAUDE_PID, the inputs, the run id once it shows.
  agentctl dispatch record --branch <branch> [--run <id>] [--workflow W] [-f key=value ...] [--purpose "..."]
      register a dispatch made another way (a script's own forgejo-gh call).
  agentctl dispatch list
      every record: branch / run, owner, alive or gone, purpose.
Without a record, a measure/<user>/<sha>-<x> branch is matched to the worktree that holds <sha> (HEAD or reflog), a
check/<entry> branch to its queue entry's worktree."""


def parse_fields(fields):
    out = {}
    for kv in fields or []:
        k, sep, v = kv.partition("=")
        if not sep:
            raise SystemExit(f"agentctl: -f takes key=value (got {kv!r})")
        out[k] = v
    return out


def cmd_dispatch(a):
    o_r = slug(a.repo) if getattr(a, "repo", None) else default_repo()
    if a.dcmd == "list":
        recs = dispatch_records()
        if not recs:
            print(f"dispatch: no records ({dispatches_dir()})")
        for r in recs:
            gone = owner_gone(r)
            state = "unmatched" if r.get("source") == "unmatched" else "owner gone" if gone else "owner alive" if gone is False else "no owner"
            print(f"{r.get('at', '?')} {r.get('branch') or ''} run {r.get('run_id') or '?'} {r.get('workflow') or ''}: "
                  f"{owner_text(r) if r.get('source') != 'unmatched' else '-'} [{state}] {r.get('purpose') or ''}")
        return 0
    inputs = parse_fields(a.field)
    if a.dcmd == "record":
        rec = record_dispatch(branch=a.branch, run_id=a.run, workflow=a.workflow, purpose=a.purpose, inputs=inputs or None)
        print(f"dispatch: recorded {rec.get('branch') or ''} run {rec.get('run_id') or '?'} → owner {owner_text(rec)}")
        return 0
    # run
    t0 = dt.datetime.now(dt.timezone.utc) - dt.timedelta(seconds=60)
    argv = [FORGEJO_GH, "workflow", "run", a.workflow, "--ref", a.ref]
    for k, v in inputs.items():
        argv += ["-f", f"{k}={v}"]
    r = subprocess.run(argv + ["-R", o_r], capture_output=True, text=True, env=dict(os.environ, GH_TOKEN=token(o_r)),
                       timeout=300)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    if r.returncode != 0:
        return r.returncode
    rec = record_dispatch(branch=a.ref, run_id=None, workflow=a.workflow,
                          purpose=a.purpose, inputs=inputs,
                          key=None if a.ref != "main" else f"main-{re.sub(r'[^A-Za-z0-9._-]', '_', a.workflow)}-{int(time.time())}")
    rid = None
    for _ in range(int(env_num("AGENTCTL_DISPATCH_FIND", 12))):
        try:
            runs = gh_json(o_r, "run", "list", "--workflow", a.workflow, "--branch", a.ref, "--limit", "5", "--json", RUN_FIELDS)
            fresh = [x for x in runs if str(x.get("createdAt", "")) >= t0.strftime("%Y-%m-%dT%H:%M:%SZ")]
            if fresh:
                rid = max(x["databaseId"] for x in fresh)
                break
        except (Exception, SystemExit):
            pass
        time.sleep(env_num("AGENTCTL_DISPATCH_FIND_POLL", 5))
    if rid:
        rec = save_dispatch(dict(rec, run_id=rid), None if a.ref != "main" else dispatch_key(None, rid))
        write_json(dispatches_dir("inputs", f"{rid}.json"), inputs)
    print(f"dispatched {a.workflow} on {a.ref}: run {rid or '(not listed yet)'} → owner {owner_text(rec)}")
    return 0


SUMMARY_MAX_REDS = 3
GATE_SUMMARY_MAX_AGE = 180  # s: a published gate line older than this is never shown as the gate
GATE_LINE = re.compile(r"gate (RED|green)\b")


def publish_gate_summary(o_r, line, epoch=None):
    """The snapshot's gate line: {at, repo, line}. Only a read gate line is ever published (never UNREAD)."""
    if not GATE_LINE.match(line):
        return
    state_update(summary={"at": int(epoch or time.time()), "repo": o_r, "line": line})


def published_summary():
    """(epoch, repo, line) the processor last published, or (None, None, None)."""
    sm = state_read().get("summary") or {}
    try:
        return int(sm["at"]), sm.get("repo"), sm.get("line")
    except (KeyError, TypeError, ValueError):
        return None, None, None


def cached_gate_summary(o_r, now=None):
    """(line, published_epoch). line is None for a missing, malformed, other-repo, future-dated or too-old line."""
    epoch, repo_, line = published_summary()
    if epoch is None:
        return None, None
    age = (now or time.time()) - epoch
    if repo_ != o_r or not GATE_LINE.match(line) or age < -5 or age > GATE_SUMMARY_MAX_AGE:
        return None, epoch
    return line, epoch


_last_gate_publish = [0.0]
_bounded = {}


def run_bounded(name, fn, secs):
    """Run fn in a daemon thread and wait at most secs: a hung network call can never stall the processor's loop. A step
    still running from an earlier cycle is not started again (False); True when fn finished in time."""
    import threading
    t = _bounded.get(name)
    if t and t.is_alive():
        return False
    t = threading.Thread(target=fn, name=name, daemon=True)
    _bounded[name] = t
    t.start()
    t.join(secs)
    return not t.is_alive()


def gate_dirty_path():
    return state_root("gate.dirty")


def mark_gate_dirty():
    """A push moved main: the processor re-reads the gate at its next tick (<= TICK s)."""
    try:
        os.makedirs(os.path.dirname(gate_dirty_path()), exist_ok=True)
        with open(gate_dirty_path(), "a"):
            pass
        os.utime(gate_dirty_path(), None)
    except OSError:
        pass


def maybe_publish_gate(repo):
    """The processor's loop, at most every GATE_PUBLISH_INTERVAL s: read the gate (it holds the token) and publish the
    summary line for the status line. Never fatal; a failed read leaves the old file to age out (fail-closed)."""
    try:  # a push to main since the last publish (mark_gate_dirty): publish now, not at the 45 s mark
        marked = os.path.getmtime(gate_dirty_path()) > _last_gate_publish[0]
    except OSError:
        marked = False
    if not marked and time.time() - _last_gate_publish[0] < env_num("AGENTCTL_GATE_PUBLISH", 45):
        return
    _last_gate_publish[0] = time.time()

    def work():
        try:
            o_r = slug(repo)
            snap = ci_state_refresh(o_r, write=False)  # ONE read of Forgejo per cycle; everything below reads it
            refresh_pinned_recording(o_r, repo)  # what PREDICTS MAIN RED compares a branch run's recording with
            ci_state_write(snap)
            # THE RED TICK ON THIS SNAPSHOT before its line is published: every red it shows is an item, offered or
            # held (never NOBODY). Bounded: a dispatch's worktree checkout finishes on the tick's own thread
            if not run_bounded("red-tick", lambda: red_tick_repo(repo, snap), env_num("AGENTCTL_ASSIGN_BOUND", 20)):
                err("red tick: still running; the gate line is published meanwhile")
            _red, line = ci_why(o_r, summary=True, snap=snap, repo=repo)
            publish_gate_summary(o_r, line.splitlines()[-1], epoch=snap["at"])
        except (Exception, SystemExit) as e:
            err(f"gate summary: skipped ({str(e).replace('agentctl: ', '')[:200]})")
            return
        try:
            for routed in route_branch_reds(o_r, snap):
                err(f"branch reds: {routed}")
        except (Exception, SystemExit) as e:
            err(f"branch reds: not routed ({str(e).replace('agentctl: ', '')[:200]})")
    if not run_bounded("gate-publish", work, env_num("AGENTCTL_STEP_BOUND", 120)):
        err("gate summary: still reading from an earlier cycle (the loop goes on)")


def cmd_ci_why(a):
    o_r = slug(a.repo) if a.repo else default_repo()
    target = None if a.target in (None, "main") else a.target
    if target and not target.isdigit():
        raise SystemExit("agentctl: ci-why takes a run id or `main`")
    if getattr(a, "cached", False):
        if not getattr(a, "summary", False) or target:
            raise SystemExit("agentctl: ci-why --cached goes with --summary and main")
        # NEVER LIVE WORK (2026-10-28: a stale file sent the status line's 15 s refresh into a 60 s live read): the
        # processor's published line, or -- stale or missing -- what it last said, marked with its age. Live reads
        # belong to the processor's publish step only.
        line, epoch = cached_gate_summary(o_r)
        if line:
            print(line)
            return 1 if line.startswith("gate RED") else 0
        asof = time.strftime("%H:%M", time.localtime(epoch)) if epoch else "never"
        _e, repo_, old = published_summary()
        if old and repo_ == o_r and GATE_LINE.match(old):
            print(f"gate UNREAD (as of {asof}: {old[5:]})")
        else:
            print(f"gate UNREAD (as of {asof}: no fresh published gate)")
        return 2
    red, text = ci_why(o_r, a.tail, target, summary=getattr(a, "summary", False))
    print(text)
    return 1 if red else 0


def reds_dir(*parts):
    d = os.environ.get("AGENTCTL_REDS_DIR") or state_root("reds")
    return os.path.join(d, *parts)


def env_num(name, default):
    try:
        return float(os.environ[name]) if os.environ.get(name) else default
    except ValueError:
        return default


def write_json(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=1)
    os.replace(tmp, path)


HEXISH = re.compile(r"\b[0-9a-f]{7,40}\b")
NUMS = re.compile(r"\d+(\.\d+)?")


def norm_line(line):
    """A first error line with what changes run to run taken out: timestamps, shas, numbers, temp paths."""
    s = ANSI.sub("", line or "")
    s = LOG_TS.sub("", s)
    s = re.sub(r"/(private/)?(tmp|var/folders)/\S*", "<tmp>", s)
    s = re.sub(r"\b0x[0-9a-f]+\b", "H", s.lower())
    s = HEXISH.sub("H", s)
    s = NUMS.sub("N", s)
    return " ".join(s.split())[:160]


def signature(workflow, job, line):
    import hashlib
    return hashlib.sha1(f"{workflow}\0{job}\0{norm_line(line)}".encode()).hexdigest()[:12]


def cause_of(job, line):
    """A failure's CAUSE across workflows (the owner, 2026-10-27: one sparse-checkout failure hit findings report #2049,
    live drift #2051 and lean vs whole #2050): its job and normalized first error line, no workflow. None without a
    line (an empty-log job says nothing about its cause)."""
    return signature("*", job, line) if norm_line(line) else None


def name_causes(o_r=None, values=()):
    """{run number or id: {causes}} from every run whose signatures are known (reds/runsig), plus, with o_r, the runs
    `values` name that are not known yet (looked up once, then cached like any run)."""
    out = {}
    for p in glob.glob(reds_dir("runsig", "*.json")):
        rec = read_record(p)
        if not rec:
            continue
        cs = {cause_of(x["job"], x["line"]) for x in rec.get("sigs") or []} - {None}
        for n in (rec.get("run"), rec.get("number")):
            if n is not None:
                out.setdefault(str(n), set()).update(cs)
        out.setdefault(f"wf:{rec.get('number')}", set()).add(rec.get("workflow"))
    missing = [v for v in values if v not in out and v.isdigit()]
    if o_r and missing:
        tried = read_record(reds_dir("unknown-runs.json")) or {}
        for v in missing:
            if v in tried:
                continue
            name, r = resolve_run(o_r, v)
            if r is not None and r.get("status") == "completed" and r.get("conclusion") in RED_CONCLUSIONS:
                try:
                    sigs = run_sigs(o_r, r, name)
                    cs = {cause_of(x["job"], x["line"]) for x in sigs} - {None}
                    for n in run_names(r):
                        out.setdefault(n, set()).update(cs)
                    continue
                except (Exception, SystemExit):
                    pass
            tried[v] = ts()
        try:
            write_json(reds_dir("unknown-runs.json"), tried)
        except OSError:
            pass
    return out


def run_names(r):
    return {str(x) for x in (r.get("number"), r.get("databaseId")) if x not in (None, "")}


def streak_runs(runs):
    """The red runs of the streak `runs` (one workflow's on main, newest first) ends on."""
    decided = [r for r in runs if r.get("status") == "completed" and r.get("conclusion") in ("success",) + RED_CONCLUSIONS]
    return list(itertools.takewhile(lambda r: r.get("conclusion") in RED_CONCLUSIONS, decided))


def classifier_version():
    """What a cached signature's kind was judged by: classify_job and every pattern it reads. A record of another
    version is classified again (#2426: cached a TEST FAILURE before KEY_REFUSED_LOG, `red block` kept reading it)."""
    import hashlib, inspect
    parts = [inspect.getsource(classify_job), SETUP_STEP.pattern, INFRA_LOG.pattern, UNKNOWN_LOG.pattern,
             KEY_REFUSED_LOG.pattern, STEP_TIMED_OUT]
    return hashlib.sha1("\n".join(parts).encode()).hexdigest()[:12]


def save_run_sigs(o_r, run, workflow, per_job):
    """per_job: [(job, kind, first relevant line)] of a completed red run -> its signatures, cached on disk."""
    sigs = [{"job": j, "kind": k, "line": (l or "")[:300], "sig": signature(workflow, j, l)} for j, k, l in per_job]
    rec = {"run": run.get("databaseId"), "number": run.get("number"), "workflow": workflow, "sigs": sigs,
           "headSha": run.get("headSha"), "classifier": classifier_version()}
    try:
        write_json(reds_dir("runsig", f"{run.get('databaseId')}.json"), rec)
    except OSError:
        pass
    return sigs


def run_sigs(o_r, run, workflow):
    """The signatures of a completed red run: [{job, kind, line, sig}] (cached; explain_run fills the cache)."""
    rec = read_record(reds_dir("runsig", f"{run.get('databaseId')}.json"))
    if rec is not None and rec.get("classifier") == classifier_version():
        return rec["sigs"]
    _lines, _num, per_job = explain_run_jobs(o_r, run, 6)
    return save_run_sigs(o_r, run, workflow, per_job)


def claimant(cwd=None):
    """The agent name ($AGENTCTL_AGENT_NAME: a dispatched fixer's), else the Claude session, else the worktree."""
    if os.environ.get("AGENTCTL_AGENT_NAME"):
        return os.environ["AGENTCTL_AGENT_NAME"]
    if os.environ.get("CLAUDE_CODE_SESSION_ID"):
        return f"session {os.environ['CLAUDE_CODE_SESSION_ID'][:8]}"
    return os.path.basename(worktree_of(cwd or safe_cwd()) or safe_cwd())


def worktree_of(path):
    if not path or not os.path.isdir(path):
        return None
    r = git(path, "rev-parse", "--show-toplevel", check=False)
    return r.stdout.strip() if r.returncode == 0 else None


def proc_alive(pid, start=None):
    if not pid or not pid_alive(int(pid)):
        return False
    r = subprocess.run(["ps", "-o", "stat=", "-p", str(int(pid))], capture_output=True, text=True)
    if r.stdout.strip().startswith("Z"):  # a defunct process its parent never reaped: ended
        return False
    # the same words in any order: records written before process_start ran ps under LC_ALL=C hold a locale's order
    return not start or sorted(process_start(int(pid)).split()) == sorted(str(start).split())


def mtime(path):
    try:
        return os.stat(path).st_mtime
    except (OSError, TypeError):
        return 0.0


def red_repo(o_r):
    """The clone whose worktrees, landers and waiting entries name the fixers ($AGENTCTL_RED_REPO; '-' for none)."""
    v = os.environ.get("AGENTCTL_RED_REPO")
    if v == "-":
        return None
    return v or repo_path_for(o_r)


def trailer_values(s):
    return {f.strip().lstrip("#") for f in (s or "").split(",") if f.strip()}


# BACKGROUND CODE TOUCHES ONLY THESE ROOTS. A path learned from another process (its cwd) or from a git registry
# (`worktree list`) that lies elsewhere -- ~/Desktop, ~/Documents, ~/Downloads -- is never stat'ed or opened: macOS asks
# "Python wants to access files in your Desktop folder" for every such touch. Skipped paths are logged once.
def allowed_roots():
    h = HOME
    roots = [f"{h}/projects", f"{h}/bitcashier", f"{h}/.cache/agentctl", f"{h}/.cache", f"{h}/Library/Logs", "/tmp", "/private/tmp",
             "/var/folders", "/private/var/folders", os.path.realpath(os.environ.get("TMPDIR") or "/tmp")]
    return roots + [x for x in os.environ.get("AGENTCTL_ALLOWED_ROOTS", "").split(":") if x]


_skipped_paths = set()


def allowed_path(path):
    """True when path (a string; never stat'ed here) is under an allowed root, or a sibling worktree of ~/bin
    (~/bin, ~/bin-wt-*). Otherwise False, logged once."""
    if not path:
        return False
    n = os.path.normpath(path)
    h = HOME
    ok = (n == f"{h}/bin" or n.startswith(f"{h}/bin/") or n.startswith(f"{h}/bin-wt-")
          or any(n == r or n.startswith(r.rstrip("/") + "/") for r in allowed_roots()))
    if not ok and n not in _skipped_paths:
        _skipped_paths.add(n)
        err(f"skipped {n}: outside the roots background code may touch")
    return ok


def land_cwds():
    """{worktree: pid} of every running `agentctl land`."""
    out = {}
    for pid, _pp, _e, cmd in ps():
        if re.search(r"agentctl land\b", cmd) and pid != os.getpid():
            cwd = lsof_cwds([pid]).get(pid)
            wt = worktree_of(cwd) if cwd else None
            if wt:
                out[os.path.realpath(wt)] = pid
    return out


def contains_local(repo, sha, head):
    """True / False when both commits are here, else None."""
    if not head:
        return None
    if head == sha:
        return True
    if not git_ok(repo, "cat-file", "-e", f"{head}^{{commit}}"):
        return None
    return git_ok(repo, "merge-base", "--is-ancestor", sha, head)


def fmt_age(secs):
    secs = max(0, int(secs))
    return f"{secs // 86400} d" if secs >= 86400 else f"{secs // 3600} h" if secs >= 3600 else f"{secs // 60} min"


_blocker_cache = {}


def cached_dispatch_blocker(ttl=60):
    """dispatch_blocker runs `claude --help`: once a minute per process is enough for a display."""
    key = (reds_dir(), os.path.exists(reds_dir("DISPATCH_OFF")), os.environ.get("AGENTCTL_CLAUDE"),
           os.environ.get("AGENTCTL_CLAUDE_SETTINGS"))
    hit = _blocker_cache.get(key)
    if hit and time.time() - hit[0] < ttl:
        return hit[1]
    v = dispatch_blocker()
    _blocker_cache[key] = (time.time(), v)
    return v


