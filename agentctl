def scratch():
    d = os.environ.get("AGENTCTL_SCRATCH")
    if not d:
        sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
        hits = sorted(glob.glob(f"/private/tmp/claude-{os.getuid()}/*/{sid}/scratchpad")) if sid else []
        d = hits[0] if hits else os.path.join(HOME, ".cache", "agentctl")
    os.makedirs(d, exist_ok=True)
    return d


def git(repo, *args, check=True, input=None):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, input=input)
    if check and r.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)} in {repo}: {r.stderr.strip()}")
    return r.stdout if check else r


def git_ok(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True).returncode == 0


def slug(repo_arg):
    if repo_arg in SHORT:
        return SHORT[repo_arg]
    if os.path.isdir(repo_arg):
        url = git(repo_arg, "remote", "get-url", REMOTE).strip()
        m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?/?$", url)
        if not m:
            raise SystemExit(f"agentctl: cannot parse remote url of {repo_arg}")
        return m.group(1)
    if re.fullmatch(r"[\w.-]+/[\w.-]+", repo_arg):
        return repo_arg
    raise SystemExit(f"agentctl: unknown repo {repo_arg!r}")


_tokens = {}


class NoToken(SystemExit):
    """The vault would not give the Forgejo token. A process whose launching session ended (a detached watch once land
    exits, a launchd service) is never authorized: `secrets` anchors an unlock to the session's processes (2026-10-27:
    two detached watches died on it with no verdict, and the waiting processor read the gate as green)."""


def token_ns(o_r):
    return "movies" if o_r.startswith("pawelkrupinski/") else "bitcashier"


def token(o_r):
    if os.environ.get("GH_TOKEN"):
        return os.environ["GH_TOKEN"]
    ns = token_ns(o_r)
    if ns == "movies" and os.environ.get("FORGEJO_API_TOKEN"):  # a token the environment already carries
        return os.environ["FORGEJO_API_TOKEN"]
    if ns not in _tokens:
        try:
            r = subprocess.run(["secrets", "get", ns, "FORGEJO_API_TOKEN"], capture_output=True, text=True)
        except OSError as e:  # launchd's PATH has no `secrets`
            raise NoToken(f"agentctl: could not read the {ns} FORGEJO_API_TOKEN from the vault (secrets: {e.strerror})")
        if r.returncode != 0 or not r.stdout.strip():
            raise NoToken(f"agentctl: could not read the {ns} FORGEJO_API_TOKEN from the vault (locked for this process: "
                          "its session ended, or `! secrets unlock " + ns + "`)")
        _tokens[ns] = r.stdout.strip()
    return _tokens[ns]


def detached_env(repo):
    """token_env for the repo at path `repo` (os.environ when it names no forge)."""
    try:
        return token_env(slug(repo))
    except (Exception, SystemExit):
        return dict(os.environ)


def token_env(o_r, env=None):
    """env (default os.environ) plus the Forgejo token, for a DETACHED child: once its parent exits the vault no longer
    answers it, so it is handed the token now (in its environment, never on a command line or on disk). Without a token
    here the child gets none and says so itself."""
    env = dict(os.environ if env is None else env)
    try:
        tok = token(o_r)
    except SystemExit:
        return env
    if token_ns(o_r) == "movies":
        env["FORGEJO_API_TOKEN"] = tok
    else:
        env["GH_TOKEN"] = tok
    return env


def gh_json(o_r, *args):
    env = dict(os.environ, GH_TOKEN=token(o_r))
    r = subprocess.run([FORGEJO_GH, *args, "-R", o_r], capture_output=True, text=True, env=env, timeout=300)
    if r.returncode != 0:
        raise RuntimeError(f"forgejo-gh {' '.join(args)}: {r.stderr.strip()[:300]}")
    return json.loads(r.stdout)


def api(o_r, method, path, params=None):
    url = f"{API}/repos/{o_r}/{path}" + ("?" + urllib.parse.urlencode(params) if params else "")
    req = urllib.request.Request(url, method=method, headers={"Authorization": f"token {token(o_r)}"})
    with urllib.request.urlopen(req, timeout=60) as resp:
        body = resp.read()
    return json.loads(body) if body else None


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def parse_time(s):
