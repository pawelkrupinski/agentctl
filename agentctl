    line, _e = cached_gate_summary(SHORT["movies"])
    gate = (re.match(r"gate RED \((.*?)\)(?: ·|$)", line or "") or [None, ""])[1]
    bad = [p_.strip() for p_ in gate.split(";") if "→" in p_ and UNASSIGNED_WORDS.search(p_)]
    st = watchdog_state()
    first = st.get("w2_since")
    now_ = time.time()
