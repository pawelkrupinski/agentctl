def condition_key(kind, probe):
    return re.sub(r"[^\w.-]+", "_", f"{kind}-{probe.kind}-" + "-".join(f"{v}" for _k, v in sorted(probe.args.items())
                                                                           if _k != "since"))[:150]


def open_condition(kind, text, probe, on_recover, key=None, inbox=True, command="recover", exit_code=1, cwd=None,
                   tail=(), effect=None):
    """Open (or refresh) a non-green condition. probe: the FAILED ProbeResult of the check that found it (required: the
    same probe, passing, closes it); on_recover: [(action, args)] from RECOVER_ACTIONS. effect: a callable run inside
    (a block's claim write); its dict result is merged into every on_recover args. Writes ONE inbox entry (text) per
    spell. Returns the condition, or None when the probe passes now (nothing is wrong)."""
    if not isinstance(probe, ProbeResult):
        raise ConditionBypass(f"open_condition({kind!r}) without a ProbeResult: no condition without its recovery probe")
    for name, _a in on_recover:
        if name not in RECOVER_ACTIONS:
            raise ConditionBypass(f"unknown on_recover action {name!r}")
    if probe.ok:
        return None
    key = key or condition_key(kind, probe)
    path = recovery_dir(key + ".json")
    old = read_record(path) or {}
    _OPENING[0] += 1
    try:
        extra = (effect() if effect else None) or {}
        text = text(extra) if callable(text) else text
        ids = list(old.get("inbox") or [])
        if inbox and not old:
            eid = inbox_write(command, text, [text], list(tail), exit_code, cwd=cwd)
            ids += [eid] if eid else []
    finally:
        _OPENING[0] -= 1
    t = time.time()
    new = [[n, {**x, **extra}] for n, x in on_recover]  # effect's result goes to THIS call's actions only
    acts = list(old.get("on_recover") or []) + [x for x in new if x not in (old.get("on_recover") or [])]
    cond = {**old, "key": key, "kind": kind, "text": text if not old else old.get("text", text),
            "probe": {"kind": probe.kind, "args": probe.args},
            "until": probe_words(probe.kind, probe.args), "on_recover": acts,
            "opened": old.get("opened") or ts(), "opened_at": old.get("opened_at") or t, "inbox": ids,
            "last_checked": t, "last_result": {"ok": probe.ok, "detail": probe.detail}, "fails": old.get("fails") or 0,
            "next_check": t + PROBE_EVERY.get(probe.kind, 60)}
    write_json(path, cond)
    return cond


def open_conditions():
    out = []
    for p in sorted(glob.glob(recovery_dir("*.json"))):
        c = read_record(p)
        if c and c.get("probe"):
            c["path"] = p
            out.append(c)
    return out


def close_condition(cond, result):
    """The probe passed (result: its ProbeResult, or a reason string for a manual close): claim the close (an atomic
    rename: one closer), ack, mark dirty, run on_recover, note it."""
    if isinstance(result, str):
        result = ProbeResult(cond["probe"]["kind"], cond["probe"]["args"], True,
                             result if result.startswith("INVALID:") else f"closed by hand: {result}",
                             _made_by_run_probe=_RUN_PROBE_TOKEN)
    done = recovery_dir("closed", f"{cond['key']}-{int(time.time())}.json")
    os.makedirs(os.path.dirname(done), exist_ok=True)
    try:
        os.replace(cond["path"], done)
    except OSError:
        return None  # another process closed it
    acked = os.path.join(inbox_dir(), "acked")
    os.makedirs(acked, exist_ok=True)
    for eid in cond.get("inbox") or []:
        open(os.path.join(acked, eid), "a").close()
    did = []
    for name, a in cond.get("on_recover") or []:
        if name == "verify" and str(result.detail).startswith("INVALID:"):
            continue  # the block lost its justification: the red goes back to dispatch, nothing recovered to verify
        try:
            w = RECOVER_ACTIONS[name](cond, a)
            if w:
                did.append(w)
        except (Exception, SystemExit) as e:
            did.append(f"{name} failed: {str(e)[:120]}")
    mark_gate_dirty()
    try:
        marker = statusline_stale_path()
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        open(marker, "a").close()
        os.utime(marker, None)
    except OSError:
        pass
    manual = str(result.detail).startswith(("INVALID:", "closed by hand:"))
    reason = str(result.detail)
    line = ((f"CLOSED (unjustified): {reason[len('INVALID: '):]}: {cond.get('text', '')[:200]}"
             if reason.startswith("INVALID:") else f"CLOSED: {reason[len('closed by hand: '):]}: {cond.get('text', '')[:200]}")
            if manual else
            f"RECOVERED: {cond['until']} ({result.detail}): {cond.get('text', '')[:200]}"
            + (f"; {'; '.join(did)}" if did else ""))
    err(line)
    inbox_write("recover", line, [line], [], 0)
    write_json(done, {**{k: v for k, v in cond.items() if k != "path"}, "closed": ts(), "closed_by": result.detail,
                      "did": did})
    return line


def recovery_tick(now_=None, force=False):
    """The duties thread's look: each open condition whose next check is due re-runs ITS probe; a pass closes it.
    Backoff: PROBE_EVERY x 2^fails, at most RECOVER_BACKOFF_MAX. Returns the RECOVERED lines."""
    t = now_ if now_ is not None else time.time()
    out = []
    try:  # an owner block that lost its justification drops at every tick, whatever probe its condition was made with
        out += [x for x in validate_owner_blocks() if x.startswith(("RECOVERED", "CLOSED"))]
    except (Exception, SystemExit) as e:
        err(f"recover: could not re-validate the owner blocks ({str(e)[:160]})")
    for c in open_conditions():
        if not force and float(c.get("next_check") or 0) > t:
            continue
        r = run_probe(c["probe"]["kind"], c["probe"]["args"])
        if r.ok:
            line = close_condition(c, r)
            if line:
                out.append(line)
            continue
        fails = int(c.get("fails") or 0) + 1
        every = PROBE_EVERY.get(r.kind, 60) * 2 ** min(fails, 8)
        c.update(fails=fails, last_checked=t, last_result={"ok": r.ok, "detail": r.detail},
                 next_check=t + min(every, env_num("AGENTCTL_RECOVER_MAX", RECOVER_BACKOFF_MAX)))
        path = c.pop("path")
        if os.path.exists(path):
            write_json(path, c)
    return out


def recovery_recheck(kind):
    """An event that may have cleared conditions of probe `kind` (a claim, a block): probe those now."""
    try:
        for c in open_conditions():
            if c["probe"]["kind"] == kind:
                r = run_probe(kind, c["probe"]["args"])
                if r.ok:
                    close_condition(c, r)
    except (Exception, SystemExit) as e:
        err(f"recover: recheck of {kind} failed ({str(e)[:120]})")


def recovery_recheck_all():
    """The network changed or came back: every open condition is probed at the next tick, backoff reset."""
    for c in open_conditions():
        path = c.pop("path")
        c.update(next_check=0, fails=0)
        write_json(path, c)


