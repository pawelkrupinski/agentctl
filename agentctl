TEMPLATE = """# State: {topic}
updated: {ts}
repo:
branch:
worktree:
commits:
run ids:
waiting on:
next step:
notes:
"""


def cmd_state(a):
    path = os.path.join(scratch(), f"state-{a.topic}.md")
    if not os.path.exists(path):
        with open(path, "w") as f:
            f.write(TEMPLATE.format(topic=a.topic, ts=ts()))
        err(f"created {path}")
    text = open(path).read()
    changed = False
    for spec, append in [(s, False) for s in a.set or []] + [(s, True) for s in a.add or []]:
        field, _, value = spec.partition("=")
        field = field.strip()
        pat = re.compile(rf"^{re.escape(field)}:[ \t]*(.*)$", re.M)
        m = pat.search(text)
        if m:
            old = m.group(1).strip()
            new = f"{old}, {value}" if append and old else value
            text = text[: m.start()] + f"{field}: {new}" + text[m.end():]
        else:
            text = text.rstrip("\n") + f"\n{field}: {value}\n"
        changed = True
    if changed:
        text = re.sub(r"^updated:.*$", f"updated: {ts()}", text, count=1, flags=re.M)
        with open(path, "w") as f:
            f.write(text)
    print(f"# {path}")
    print(text, end="")
    return 0


# ---------------------------------------------------------------- prepush-check
def changed_files(repo, a, b):
    """[(status, path)] for a..b (renames split into delete + add)."""
    out = git(repo, "diff", "--name-status", "--no-renames", "-z", a, b)
    parts = out.split("\0")
    res = []
    i = 0
    while i + 1 < len(parts):
        res.append((parts[i], parts[i + 1]))
        i += 2
    return res


def blobs(repo, specs):
    """Map 'rev:path' -> blob sha or None, in one cat-file call."""
    if not specs:
        return {}
    r = git(repo, "cat-file", "--batch-check=%(objectname)", input="\n".join(specs) + "\n")
    lines = r.splitlines()
    return {s: (None if l.endswith("missing") else l.strip()) for s, l in zip(specs, lines)}


def reverted_commits(repo, mb, head):
    shas = set()
    for body in git(repo, "log", "--format=%B%x00", f"{mb}..{head}").split("\0"):
        shas.update(re.findall(r"This reverts commit ([0-9a-f]{7,40})", body))
    files = set()
    for s in shas:
        r = git(repo, "show", "--name-only", "--format=", s, check=False)
        if r.returncode == 0:
            files.update(l for l in r.stdout.splitlines() if l)
    return files


def foreign_reverts(repo, base, head, files, depth=8, since="45.days"):
    """Files whose content at head equals an OLDER version from main's history -- i.e. the push would undo
    someone's change on main (absence counts: deleting a file main recently added)."""
    hits = []
    head_specs = [f"{head}:{p}" for _, p in files]
    head_blob = blobs(repo, head_specs)
    for (_, p), hs in zip(files, head_specs):
        hb = head_blob[hs]
        commits = git(repo, "log", f"-n{depth}", f"--since={since}", "--format=%H", base, "--", p).split()
        if not commits:
            continue
        olds = blobs(repo, [f"{c}^:{p}" for c in commits])
        cur = blobs(repo, [f"{base}:{p}"])[f"{base}:{p}"]
        for c in commits:
            ob = olds[f"{c}^:{p}"]
            if ob == hb and ob != cur:
                hits.append((p, c[:10]))
                break
    return hits


def allowed(path, globs):
    return any(fnmatch.fnmatch(path, g) or path.startswith(g.rstrip("/") + "/") for g in globs)


def check_range(repo, base, head, allow, max_foreign):
    problems = []
    mb = git(repo, "merge-base", base, head).strip()
    files = changed_files(repo, mb, head)
    stat = git(repo, "diff", "--shortstat", mb, head).strip()
    print(f"prepush-check: {base}...{head[:12]}: {stat or 'no changes'}")
    if allow:
        outside = [p for _, p in files if not allowed(p, allow)]
        if outside:
            problems.append(f"{len(outside)} file(s) outside the allowed set {allow}: " + ", ".join(outside[:20]))
    exempt = reverted_commits(repo, mb, head)
    reverts = [(p, c) for p, c in foreign_reverts(repo, base, head, files) if p not in exempt]
    if allow:  # files in the allowed set are the agent's own: reverting them is its call
        reverts = [(p, c) for p, c in reverts if not allowed(p, allow)]
    if len(reverts) > max_foreign:
        problems.append(
            f"{len(reverts)} file(s) would be reverted/deleted back to an older main version (max {max_foreign}) -- "
            "a squash onto a moved main? `git rebase forgejo/main` and re-check. "
            + ", ".join(f"{p} (undoes {c})" for p, c in reverts[:20])
        )
    return problems


def cmd_prepush(a):
    repo = os.getcwd()
    allow = (a.allow or []) + os.environ.get("AGENTCTL_ALLOW", "").split()
    max_foreign = a.max_foreign if a.max_foreign is not None else int(os.environ.get("AGENTCTL_MAX_FOREIGN", "2"))
    problems = []
    if a.hook:
        remote = a.hook[0]
        base_ref = f"refs/remotes/{remote}/main"
        for line in sys.stdin.read().splitlines():
            parts = line.split()
            if len(parts) != 4:
                continue
            _, lsha, rref, rsha = parts
            if lsha == ZERO or not rref.startswith("refs/heads/"):
                continue  # deletes and tags: nothing to check
            base = base_ref if git_ok(repo, "rev-parse", "--verify", "-q", base_ref) else rsha
            if base == ZERO:
                continue
            problems += check_range(repo, base, lsha, allow, max_foreign)
    else:
        problems = check_range(repo, a.base, git(repo, "rev-parse", a.head).strip(), allow, max_foreign)
    for p in problems:
        print(f"prepush-check: REFUSED: {p}", file=sys.stderr)
    if problems:
        return 1
    print("prepush-check: ok")
    return 0


# ---------------------------------------------------------------- cleanup
def log_deletion(kind, repo, name, sha, why):
    with open(os.path.join(scratch(), "agentctl-deleted.log"), "a") as f:
        f.write(f"{ts()}\t{kind}\t{repo}\t{name}\t{sha}\t{why}\n")


def worktrees(repo):
    wts, cur = [], {}
    for line in git(repo, "worktree", "list", "--porcelain").splitlines() + [""]:
        if not line:
            if cur:
                wts.append(cur)
            cur = {}
            continue
        k, _, v = line.partition(" ")
        cur[k] = v if v else True
    return wts


def process_cwds():
    r = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fpn"], capture_output=True, text=True)
    res, pid = {}, None
    for line in r.stdout.splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid:
            res[pid] = line[1:]
    return res


def gitdir_activity(repo, wt_path):
    gd = git(repo, "-C", wt_path, "rev-parse", "--absolute-git-dir", check=False)
    if gd.returncode != 0:
        return None
    d = gd.stdout.strip()
    mt = [os.stat(os.path.join(d, f)).st_mtime for f in ("HEAD", "index", "logs/HEAD", "ORIG_HEAD") if os.path.exists(os.path.join(d, f))]
    return max(mt) if mt else None


def merged_reason(repo, head, main):
    if git_ok(repo, "merge-base", "--is-ancestor", head, main):
        return "ancestor of forgejo/main"
    lines = git(repo, "cherry", main, head).splitlines()
    if lines and all(l.startswith("-") for l in lines):
        return f"all {len(lines)} commit(s) patch-equivalent on forgejo/main"
    return None


CACHE_TREES = os.path.join(HOME, ".cache") + "/"  # tool-owned trees (e.g. kinowo-identity measure-local): reused, not litter


def plan_worktrees(repo, main, min_age_h, cwds, include_caches=False):
    """[(action, wt, branch, sha, reason)] where action is 'delete' or 'skip'."""
    plan = []
    wts = worktrees(repo)
    checked_out = {w.get("branch") for w in wts if w.get("branch")}
    for w in wts[1:]:  # the first entry is the main checkout
        path, sha = w["worktree"], w.get("HEAD", "")
        branch = w.get("branch", "").removeprefix("refs/heads/") or None
        def skip(why):
            plan.append(("skip", path, branch, sha, why))
        if "locked" in w:
            skip("locked"); continue
        if branch in PROTECTED_BRANCHES:
            skip(f"on {branch}"); continue
        if path.startswith(CACHE_TREES) and not include_caches:
            skip("tool cache tree (--include-caches to consider)"); continue
        if "prunable" in w or not os.path.isdir(path):
            skip("directory missing (prunable; not touched)"); continue
        busy = [p for p, c in cwds.items() if c == path or c.startswith(path + "/")]
        if busy:
            skip(f"in use by pid {busy[:3]}"); continue
        act = gitdir_activity(repo, path)
        if act and time.time() - act < min_age_h * 3600:
            skip(f"active {int((time.time() - act) / 60)} min ago"); continue
        dirty = git(repo, "-C", path, "status", "--porcelain", "--untracked-files=all", check=False)
        if dirty.returncode != 0:
            skip("git status failed"); continue
        if dirty.stdout.strip():
            skip(f"dirty ({len(dirty.stdout.splitlines())} changed/untracked)"); continue
        why = merged_reason(repo, sha, main)
        if not why:
            n = len(git(repo, "rev-list", f"{main}..{sha}").split())
            skip(f"unmerged ({n} commit(s) not on forgejo/main)"); continue
        plan.append(("delete", path, branch, sha, why))
    return plan


def plan_measure(o_r, runs_for, now_=None):
    """Remote measure/* branches: [(action, name, sha, reason)]. runs_for(name) -> list of run dicts."""
    now_ = now_ or now()
    plan, page = [], 1
    while True:
        bs = api(o_r, "GET", "branches", {"limit": 50, "page": page})
        for b in bs:
            if b["name"].startswith("measure/"):
                plan.append(measure_decision(b["name"], b["commit"]["id"], parse_time(b["commit"]["timestamp"]), runs_for(b["name"]), now_))
        if len(bs) < 50:
            return plan
        page += 1


def measure_decision(name, sha, commit_time, runs, now_):
    if not name.startswith("measure/"):
        return ("skip", name, sha, "not a measure/ branch")
    active = [r for r in runs if r.get("status") != "completed"]
    if active:
        return ("skip", name, sha, f"run {active[0].get('databaseId')} {active[0].get('status')}")
    if runs:
        return ("delete", name, sha, f"{len(runs)} run(s) finished")
    age_h = (now_ - commit_time).total_seconds() / 3600
    if age_h > 24:
        return ("delete", name, sha, f"no runs, {age_h:.0f}h old")
    return ("skip", name, sha, f"no runs yet, {age_h:.1f}h old")


def cmd_cleanup(a):
    dry = a.dry_run or (sys.stdin.isatty() and not a.execute)
    mode = "DRY RUN" if dry else "EXECUTE"
    print(f"agentctl cleanup ({mode}); log: {os.path.join(scratch(), 'agentctl-deleted.log')}")
    cwds = process_cwds()
    rc = 0
    for repo in a.repo or REPOS:
        repo = os.path.abspath(os.path.expanduser(repo))
        name = os.path.basename(repo)
        if not os.path.isdir(repo):
            continue
        try:
            if not a.no_fetch:
                git(repo, "fetch", "--quiet", REMOTE, "main")
            main = git(repo, "rev-parse", f"refs/remotes/{REMOTE}/main").strip()
        except RuntimeError as e:
            err(f"{name}: {e}; skipping repo"); rc = 1; continue
        print(f"\n== {name} (forgejo/main {main[:10]})")
        for action, path, branch, sha, why in plan_worktrees(repo, main, a.min_age_hours, cwds, a.include_caches):
            label = f"worktree {path} [{branch or 'detached'}] {sha[:10]}"
            if action == "skip":
                if a.verbose:
                    print(f"  keep   {label}: {why}")
                continue
            print(f"  {'would delete' if dry else 'delete'} {label}: {why}")
            if dry:
                continue
            # Re-verify right before acting; `git worktree remove` (no --force) refuses dirty trees itself.
            if git(repo, "-C", path, "rev-parse", "HEAD").strip() != sha or not merged_reason(repo, sha, main):
                print("    changed since planning; kept"); continue
            r = git(repo, "worktree", "remove", path, check=False)
            if r.returncode != 0:
                print(f"    worktree remove refused: {r.stderr.strip()}"); rc = 1; continue
            log_deletion("worktree", name, path, sha, why)
            if branch and branch not in PROTECTED_BRANCHES:
                others = {w.get("branch") for w in worktrees(repo)}
                if f"refs/heads/{branch}" in others:
                    print(f"    branch {branch} checked out elsewhere; kept"); continue
                r = git(repo, "update-ref", "-d", f"refs/heads/{branch}", sha, check=False)
                if r.returncode == 0:
                    log_deletion("branch", name, branch, sha, why)
                    print(f"    deleted branch {branch} ({sha[:10]})")
                else:
                    print(f"    branch {branch} not deleted: {r.stderr.strip()}"); rc = 1
        if a.no_remote:
            continue
        o_r = slug(repo)
        try:
            runs_for = lambda b: gh_json(o_r, "run", "list", "--branch", b, "--limit", "20", "--json", "databaseId,status")
            mplan = plan_measure(o_r, runs_for)
        except Exception as e:
            err(f"{name}: measure branches not checked: {e}"); rc = 1; continue
        for action, bname, sha, why in mplan:
            label = f"remote {o_r}:{bname} {sha[:10]}"
            if action == "skip":
                if a.verbose:
                    print(f"  keep   {label}: {why}")
                continue
            print(f"  {'would delete' if dry else 'delete'} {label}: {why}")
            if dry:
                continue
            try:
                cur = api(o_r, "GET", f"branches/{urllib.parse.quote(bname, safe='')}")["commit"]["id"]
                if cur != sha:
                    print("    moved since planning; kept"); continue
                api(o_r, "DELETE", f"branches/{urllib.parse.quote(bname, safe='')}")
                log_deletion("remote-branch", o_r, bname, sha, why)
            except Exception as e:
                print(f"    delete failed: {e}"); rc = 1
    return rc


# ---------------------------------------------------------------- orphans
def ps():
    r = subprocess.run(["ps", "-axo", "pid=,ppid=,etime=,command="], capture_output=True, text=True)
    out = []
    for line in r.stdout.splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4:
            out.append((int(parts[0]), int(parts[1]), parts[2], parts[3]))
    return out


def loop_body(cmd):
    m = re.search(r"eval '(.*)' < /dev/null", cmd, re.S)
    return m.group(1) if m else cmd


def is_wait_loop(cmd):
    if re.search(r"\bagentctl wait\b", cmd):
        return True
    if not re.match(r"\S*(zsh|bash|sh) ", cmd):
        return False
    body = loop_body(cmd)
    return bool(re.search(r"\bsleep\b", body) and re.search(r"\b(until|while)\b", body))


def loop_targets(body):
    ids = set(re.findall(r"run (?:view|watch) (\d+)", body)) | set(re.findall(r"/runs/(\d+)", body))
    ids |= {i for m in re.findall(r"for \w+ in ((?:\d+\s+)*\d+)\s*;", body) for i in m.split()}
    m = re.search(r"(?:-R|--repo)[ =]([\w.-]+/[\w.-]+)", body) or re.search(r"agentctl wait run (\S+)", body)
    repo = None
    if m:
        try:
            repo = slug(m.group(1))
        except SystemExit:
            repo = None
    return repo, sorted(ids, key=int)


def missing_tree_paths(text):
    gone = set()
    for p in re.findall(rf"{re.escape(HOME)}/(?:projects|bitcashier)/[\w.-]+", text):
        if not os.path.exists(p):
            gone.add(p)
    return sorted(gone)


def is_sbt(cmd):
    return ("java" in cmd.split(" ", 1)[0] and re.search(r"xsbt\.boot|sbt-launch|sbt\.boot|\bsbt\.server", cmd)) or bool(
        re.search(r"scripts/sbt-warm --keep", cmd)
    )


def cmd_orphans(a):
    procs = ps()
    cwds = process_cwds()
    me = {os.getpid(), os.getppid()}
    found = []
    status_cache = {}

    def finished(repo, rid):
        k = (repo, rid)
        if k not in status_cache:
            try:
                status_cache[k] = gh_json(repo, "run", "view", rid, "--json", "status").get("status") == "completed"
            except Exception:
                status_cache[k] = None
        return status_cache[k]

    seen_targets = {}
    loops = [p for p in procs if p[0] not in me and is_wait_loop(p[3])]
    loops.sort(key=lambda p: p[0])
    for pid, ppid, etime, cmd in loops:
        body = loop_body(cmd)
        reasons = []
        if ppid == 1:
            reasons.append("owning shell/agent is gone")
        gone = missing_tree_paths(body + " " + cwds.get(pid, ""))
        if gone:
            reasons.append(f"worktree missing: {', '.join(gone)}")
        repo, ids = loop_targets(body)
        if repo and ids:
            states = [finished(repo, i) for i in ids]
            if all(s is True for s in states):
                reasons.append(f"all target runs finished ({repo} {' '.join(ids)})")
            key = (repo, tuple(ids))
            if key in seen_targets and pid_alive(seen_targets[key]):
                reasons.append(f"duplicate of loop pid {seen_targets[key]}")
            else:
                seen_targets.setdefault(key, pid)
        if reasons:
            found.append(("wait-loop", pid, etime, "; ".join(reasons), body[:140].replace("\n", " ")))
    for pid, ppid, etime, cmd in procs:
        if pid in me or not is_sbt(cmd):
            continue
        cwd = cwds.get(pid, "")
        reasons = []
        if cwd and not os.path.isdir(cwd):
            reasons.append(f"cwd gone: {cwd}")
        elif cwd and not os.path.exists(os.path.join(cwd, ".git")) and cwd.startswith(HOME + "/projects"):
            reasons.append(f"cwd {cwd} is no longer a git checkout")
        gone = missing_tree_paths(cmd)
        if gone:
            reasons.append(f"worktree missing: {', '.join(gone)}")
        if reasons:
            found.append(("sbt", pid, etime, "; ".join(reasons), cmd[:140]))
    if not found:
        print("no orphans")
        return 0
    for kind, pid, etime, why, what in found:
        print(f"{kind:9} pid {pid:<6} up {etime:>11}  {why}\n          {what}")
    if a.kill:
        for kind, pid, *_ in found:
            kids = subprocess.run(["pgrep", "-P", str(pid)], capture_output=True, text=True).stdout.split()
            for p in [pid] + [int(k) for k in kids]:
                try:
                    os.kill(p, signal.SIGTERM)
                except ProcessLookupError:
                    pass
            print(f"killed {kind} pid {pid}" + (f" (+children {kids})" if kids else ""))
    return 0


# ---------------------------------------------------------------- main
def main(argv=None):
    ap = argparse.ArgumentParser(prog="agentctl", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    w = sub.add_parser("wait")
    wsub = w.add_subparsers(dest="kind", required=True)
    wr = wsub.add_parser("run", help="block until Forgejo runs finish; print only the verdicts",
                         description=WAIT_RUN_HELP, formatter_class=argparse.RawDescriptionHelpFormatter)
    wr.add_argument("ids", nargs="+", metavar="ID", help="run ids (action_run.id); a leading repo name is accepted (legacy form)")
    wr.add_argument("--repo", "-R", help="o/r or short name (movies, core, infra, ...); default: the cwd's forgejo remote, else movies")
    wr.add_argument("--until", choices=("done", "landable"), default="done",
                    help="landable: for an Identity model convergence measure/ run, stop once the takes rows end and print their verdict files")
    wr.add_argument("--tail", type=int, default=8, metavar="N", help="relevant log lines (FAILED/error/assert) per failed job (default 8; 0 = none)")
    wf = wsub.add_parser("file", help="block until a file appears (and matches)")
    wf.add_argument("target")
    wf.add_argument("--contains")
    for p in (wr, wf):
        p.add_argument("--interval", type=int, default=300, help="backoff cap in seconds (<= 300)")
        p.add_argument("--timeout", type=int, default=6 * 3600)
    s = sub.add_parser("state", help="print/update scratchpad/state-<topic>.md (the hand-off file for long waits)",
                       description="Print scratchpad/state-<topic>.md, creating it from the template first. --set field=value "
                       "replaces a field, --add field=value appends to a comma-separated one. Write it before ending a turn "
                       "that waits >30 min on CI. Reference: ~/bin/AGENTCTL.md")
    s.add_argument("topic")
    s.add_argument("--set", action="append")
    s.add_argument("--add", action="append")
    pp = sub.add_parser("prepush-check", help="refuse a push that strays outside --allow or reverts others' work on main",
                        description="Refuses when base...head touches a file outside the allowed set, or returns more than "
                        "--max-foreign (2) files to an older main version (the `reset --soft` squash onto a moved main). "
                        "movies' pre-push hook calls it with --hook; `agentctl land` runs it before every push. Exit 1 refused.")
    pp.add_argument("--base", default=f"{REMOTE}/main")
    pp.add_argument("--head", default="HEAD")
    pp.add_argument("--allow", action="append")
    pp.add_argument("--max-foreign", type=int)
    pp.add_argument("--hook", nargs="+", metavar="REMOTE [URL]")
    c = sub.add_parser("cleanup", help="remove ONLY proven-merged worktrees/branches and finished measure/* branches",
                       description="Removes only clean, idle worktrees whose HEAD is on forgejo/main (ancestor or all commits "
                       "patch-equivalent), their branches, and remote measure/* branches whose runs finished. Every deletion "
                       "is logged to scratchpad/agentctl-deleted.log. Dry run by default on a TTY; --execute acts.")
    g = c.add_mutually_exclusive_group()
    g.add_argument("--dry-run", action="store_true")
    g.add_argument("--execute", action="store_true", help="act even when stdin is a TTY")
    c.add_argument("--repo", action="append")
    c.add_argument("--no-fetch", action="store_true")
    c.add_argument("--no-remote", action="store_true", help="skip remote measure/* branches")
    c.add_argument("--min-age-hours", type=float, default=2.0)
    c.add_argument("--include-caches", action="store_true", help="also consider worktrees under ~/.cache")
    c.add_argument("-v", "--verbose", action="store_true", help="also list what is kept and why")
    cw = sub.add_parser("ci-why", help="why is main red: the gating runs' failed jobs, log tails, infra vs test, clearing rule",
                        description=CI_WHY_HELP, formatter_class=argparse.RawDescriptionHelpFormatter)
    cw.add_argument("target", nargs="?", default="main", help="`main` (default) or a run id to explain")
    cw.add_argument("--repo", "-R")
    cw.add_argument("--tail", type=int, default=6, metavar="N", help="relevant log lines per failed job")
    ld = sub.add_parser("land", help="fetch, rebase onto forgejo/main, prepush-check, push (hook runs), verify: LANDED <sha>",
                        description=LAND_HELP, formatter_class=argparse.RawDescriptionHelpFormatter)
    ld.add_argument("--repo", help="checkout to land from (default: cwd)")
    ld.add_argument("--branch", help="local branch to land (default: the checked-out HEAD)")
    ld.add_argument("--stash", action="store_true", help="set uncommitted changes aside in a NAMED stash and restore them after")
    ev = sub.add_parser("env", help="print sdkman sbt/java export lines (--print) or check the agent environment (--check)",
                        description=ENV_HELP, formatter_class=argparse.RawDescriptionHelpFormatter)
    eg = ev.add_mutually_exclusive_group()
    eg.add_argument("--print", action="store_true", help="export lines for eval (default)")
    eg.add_argument("--check", action="store_true", help="check sbt, java, the vault, the tunnel and the Forgejo token")
    ev.add_argument("--ns", choices=("movies", "bitcashier"), help="vault namespace (default: movies inside ~/projects/movies, else bitcashier)")
    dq = sub.add_parser("db-q", help="read-only query of the Forgejo DB (SELECT/WITH/PRAGMA only)",
                        description=DBQ_HELP, formatter_class=argparse.RawDescriptionHelpFormatter)
    dq.add_argument("sql")
    dq.add_argument("--env", choices=sorted(DB_ENVS), default="forgejo")
    dq.add_argument("--max-rows", type=int, default=200)
    o = sub.add_parser("orphans", help="list wait loops / sbt servers whose worktree, owner or target runs are gone",
                       description="Lists wait loops and sbt servers that are orphaned: worktree gone, owning shell dead, "
                       "every target run finished, or a duplicate of an older loop on the same runs. --kill sends SIGTERM "
                       "(to them and their children).")
    o.add_argument("--kill", action="store_true")
    q = sub.add_parser("queue", help="merge queue: batch landings, one identity landing check per batch, bisect on red",
                       description=QUEUE_HELP, formatter_class=argparse.RawDescriptionHelpFormatter)
    qs = q.add_subparsers(dest="qcmd", required=True)
    qa = qs.add_parser("add", help="enqueue this worktree's commits; start the processor if none runs")
    qa.add_argument("--identity", action="store_true", help="run the identity landing check even when no path needs it")
    qst = qs.add_parser("status", help="the processor's phase and the open entries")
    qw = qs.add_parser("wait", help="block until an entry lands or is rejected: LANDED <sha> | REJECTED <why>")
    qw.add_argument("entry", nargs="?", help="entry id (or a unique part of it); default: this worktree's newest entry")
    qw.add_argument("--timeout", type=int, default=12 * 3600)
    qc = qs.add_parser("cancel", help="drop a queued entry (not one in the current batch)")
    qc.add_argument("entry", nargs="?")
    qr = qs.add_parser("run", help="the processor (queue add starts it detached; one runs at a time)")
    qr.add_argument("--once", action="store_true", help="exit instead of waiting when only held entries are left")
    qre = qs.add_parser("resume", help="lift a FLAKY (or MAIN RED) hold; the processor starts again")
    qrq = qs.add_parser("requeue", help="put a wrongly rejected entry back in its original place")
    qrq.add_argument("entry")
    qrq.add_argument("--last", action="store_true", help="behind every open entry instead of its original place")
    for p in (qa, qst, qw, qc, qr, qre, qrq):
        p.add_argument("--repo", help="checkout (default: cwd)")
    a = ap.parse_args(argv)
    return {"queue": cmd_queue, "wait": cmd_wait, "state": cmd_state, "prepush-check": cmd_prepush, "cleanup": cmd_cleanup, "orphans": cmd_orphans, "ci-why": cmd_ci_why, "land": cmd_land, "env": cmd_env, "db-q": cmd_db_q}[a.cmd](a)


