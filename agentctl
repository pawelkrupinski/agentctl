            "laptop_load": lambda: "the laptop's load is normal", "batch_hold": lambda: "the batch hold ends",
            "fixer_slot": lambda: "a fixer slot is free", "invariant": lambda: f"invariant {a.get('id')} holds", "waiting_ok": lambda: "a waiting round completes",
            "owner_block": lambda: (probe_words(a["inner"]["kind"], a["inner"]["args"]) if a.get("inner") else "its check passes")
            + " (or the block loses its justification)", "orphan_landed": lambda: "its commits are on main or somebody works in it",
            "queue_entry": lambda: f"queue entry {a.get('eid')} moves"}.get(kind, lambda: kind)()


def run_probe(kind, args=None):
    """Run probe `kind` on args: the ONE way to a ProbeResult. A probe that raises is ok=None (cannot tell)."""
    if kind not in PROBES:
        raise ConditionBypass(f"unknown probe {kind!r}: every condition needs a probe from PROBES")
    args = dict(args or {})
    try:
        ok, detail = PROBES[kind](args)
    except (Exception, SystemExit) as e:
        ok, detail = None, f"probe error: {str(e)[:160]}"
    return ProbeResult(kind, args, ok, detail, _made_by_run_probe=_RUN_PROBE_TOKEN)


