_IN_PROCESSOR = [False]  # the processor serves the socket itself: it must never ask it


def secrets_bin():
    """`secrets` by absolute path: a detached or launchd process has a PATH without it."""
    import shutil
    for c in (shutil.which("secrets"),) + SECRETS_FALLBACKS:
        if c and os.access(c, os.X_OK):
            return c
    return None


def movies_repo_path():
    return os.environ.get("AGENTCTL_MOVIES_REPO") or os.path.join(HOME, "projects", "movies")


def interactive_foreground():
    """Only an interactive, foreground invocation may run `secrets` (it can pop a Touch ID / keychain prompt): a TTY on
    stdin or stderr, or AGENTCTL_INTERACTIVE=1. Never the processor, a launchd job, a detached watch or the statusline."""
    if _IN_PROCESSOR[0] or os.environ.get("AGENTCTL_NO_SECRETS"):
        return False
    if os.environ.get("AGENTCTL_INTERACTIVE") == "1":
        return True
    try:
        return sys.stdin.isatty() or sys.stderr.isatty()
    except (ValueError, AttributeError):
        return False


def token_from_processor(o_r):
    """Ask the always-on processor (private 0600 socket, same uid) for the token it holds. None when it is not there."""
    import socket
    if _IN_PROCESSOR[0] or token_ns(o_r) != "movies":
        return None
    try:
        d, _c, _w = waiting_state(movies_repo_path())
        path = token_sock_path(d)
        if not os.path.exists(path):
            return None
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(3)
            s.connect(path)
            s.sendall(TOKEN_REQUEST)
            s.shutdown(socket.SHUT_WR)
            tok = s.recv(4096).decode().strip()
        return tok if TOKEN_SHAPE.fullmatch(tok) else None
    except (Exception, SystemExit):
        return None


def token_unavailable_note(ns, why):
    """No source had the token: ONE inbox entry per spell (the flag clears when a token is read again)."""
    if ns != "movies":
        return
    flag = reds_dir("TOKEN_UNAVAILABLE")
    try:
        if os.path.exists(flag) and time.time() - os.path.getmtime(flag) < 3600:  # at most once an hour
            return
        os.makedirs(reds_dir(), exist_ok=True)
        with open(flag, "w") as f:
            f.write(ts() + "\n")
        inbox_write("token", f"UNKNOWN: token unavailable ({why}): run `secrets unlock {ns}` in any session; the next "
                             "land or `waiting status` re-seeds the processor", [], [], 2)
    except (Exception, SystemExit):
        pass


def token_found(ns):
    pass  # the hourly flag stands: a flapping token does not re-announce


def token(o_r):
    """ONE credential path for every agentctl process: the environment, then the processor's socket, then `secrets`
    (absolute path). No source: NoToken naming the cause, and one inbox entry."""
    if os.environ.get("GH_TOKEN"):
        return os.environ["GH_TOKEN"]
    ns = token_ns(o_r)
    if ns == "movies" and os.environ.get("FORGEJO_API_TOKEN"):  # a token the environment already carries
        return os.environ["FORGEJO_API_TOKEN"]
    if ns not in _tokens:
        tok = token_from_processor(o_r)
        why = "the waiting processor holds none"
        if not tok:
            sec = secrets_bin()
            if not interactive_foreground():
                why += "; not an interactive foreground run, so `secrets` is not tried (it would prompt)"
            elif not sec:
                why += "; no `secrets` command found"
            else:
                try:
                    r = subprocess.run([sec, "get", ns, "FORGEJO_API_TOKEN"], capture_output=True, text=True,
                                       stdin=subprocess.DEVNULL)
                    tok = r.stdout.strip() if r.returncode == 0 else ""
                except OSError as e:
                    tok, why = "", why + f"; secrets: {e.strerror}"
                if not tok:
                    why += "; the vault is locked for this process (its session ended, or `! secrets unlock " + ns + "`)"
        if not tok:
            token_unavailable_note(ns, why)
            raise NoToken(f"agentctl: could not read the {ns} FORGEJO_API_TOKEN ({why})")
        token_found(ns)
        _tokens[ns] = tok
    return _tokens[ns]


def detached_env(repo):
    """token_env for the repo at path `repo` (os.environ when it names no forge)."""
    try:
        return token_env(slug(repo))
    except (Exception, SystemExit):
        return dict(os.environ)


def token_env(o_r, env=None):
    """env (default os.environ) plus the Forgejo token, for a DETACHED child: once its parent exits the vault no longer
    answers it, so it is handed the token now (in its environment, never on a command line or on disk). Without a token
    here the child gets none and says so itself."""
    env = dict(os.environ if env is None else env)
    try:
        tok = token(o_r)
    except SystemExit:
        return env
    if token_ns(o_r) == "movies":
        env["FORGEJO_API_TOKEN"] = tok
    else:
        env["GH_TOKEN"] = tok
    return env


def gh_json(o_r, *args):
    env = dict(os.environ, GH_TOKEN=token(o_r))
    r = subprocess.run([FORGEJO_GH, *args, "-R", o_r], capture_output=True, text=True, env=env, timeout=300)
    if r.returncode != 0:
        raise RuntimeError(f"forgejo-gh {' '.join(args)}: {r.stderr.strip()[:300]}")
    return json.loads(r.stdout)


def api(o_r, method, path, params=None):
    url = f"{API}/repos/{o_r}/{path}" + ("?" + urllib.parse.urlencode(params) if params else "")
    req = urllib.request.Request(url, method=method, headers={"Authorization": f"token {token(o_r)}"})
    with urllib.request.urlopen(req, timeout=60) as resp:
        body = resp.read()
    return json.loads(body) if body else None


