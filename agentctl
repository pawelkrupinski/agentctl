# EVERY PUSH IS BOUNDED (the owner, 2026-10-28, "fix root cause in a structural way": a queued change's `git push` over
# the ssh tunnel died with "Connection to localhost closed by remote host" when the hotspot dropped, then hung -- no
# progress, no exit -- holding the landing lock 30+ min while a checked batch waited behind it with the gate green): a
# push gets a no-progress bound (no output and no CPU) of PUSH_STALL_SECS and a wall bound of PUSH_WALL_MIN, its group
# killed on either; a stalled or dead-transport push is infra (re-queued), never a hang.
PUSH_STALL_SECS = 180
PUSH_WALL_MIN = 45


def push_bounds():
    return {"stall": env_num("AGENTCTL_PUSH_STALL_SECS", PUSH_STALL_SECS),
            "wall": env_num("AGENTCTL_PUSH_WALL_MIN", PUSH_WALL_MIN) * 60}


def push_argv(remote, src, dst="main"):
    argv = ["git", "push", remote, f"{src}:refs/heads/{dst}"]
    assert not any(a in ("--no-verify", "-n", "--force", "-f") or a.startswith("--force") for a in argv)
    return argv


class Stash:
    """A NAMED stash (git's stash list is shared by every worktree of a clone): found again by its own sha, never by
    position, and restored exactly once."""

    def __init__(self, repo):
        self.repo, self.name, self.sha = repo, f"agentctl-land-{os.getpid()}-{int(time.time())}", None

    def save(self):
        git(self.repo, "stash", "push", "--include-untracked", "-m", self.name)
        for line in git(self.repo, "stash", "list", "--format=%H %gs").splitlines():
            sha, _, msg = line.partition(" ")
            if msg.endswith(self.name):
                self.sha = sha
                return
        raise RuntimeError(f"stash {self.name} not found after saving it")

    def restore(self):
        if not self.sha:
            return True
        r = git(self.repo, "stash", "apply", "--index", self.sha, check=False)
        if r.returncode != 0:
            r = git(self.repo, "stash", "apply", self.sha, check=False)
        if r.returncode != 0:
            err(f"could not re-apply stash {self.name} ({self.sha[:10]}): {r.stderr.strip()[:200]}; it is kept: "
                f"`git stash list | grep {self.name}`")
            return False
        for i, line in enumerate(git(self.repo, "stash", "list", "--format=%H").splitlines()):
            if line.strip() == self.sha:
                git(self.repo, "stash", "drop", f"stash@{{{i}}}", check=False)
                break
        self.sha = None
        return True


def landed(repo, sha, main_ref):
    if git_ok(repo, "merge-base", "--is-ancestor", sha, main_ref):
        return "ancestor"
    lines = git(repo, "cherry", main_ref, sha).splitlines()
    if lines and all(l.startswith("-") for l in lines):
        return "patch-equivalent"
    return None


# THE LANDING LOCK IS A LEASE (design §6, phase 1 step 3; the owner, 2026-10-28: a push hung on a dropped tunnel held
# the flock 30+ min and a checked batch waited behind it). `land/<repo>` in the store: TTL LAND_LEASE_TTL, renewed only
# on real progress (run_watched's output / CPU), capped at LAND_LEASE_MAX; a holder that stops progressing simply
# loses it, and a waiter takes it. No flock, no heartbeat file, no killing another process: expiry IS the release.
# A holder that lost the lease stops its work (run_watched ends its group: LeaseLost).
LAND_LEASE_TTL = 120
LAND_LEASE_MAX = 45 * 60  # the design's 300 s once checks no longer run in the push's hook under the lease (step 6)


def land_lease_name(repo):
    """One lease per repository: every worktree of a clone shares its git common dir."""
    common = os.path.realpath(git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir").strip())
    return "land/" + re.sub(r"[^A-Za-z0-9._-]", "_", common.strip("/"))


_held_lock = [None]  # (store, name, lease) of the landing lease this process holds


def lock_note(step):
    """Say in the held landing lease what the holder is doing now (waiters print it)."""
    if _held_lock[0]:
        st, name, lease = _held_lock[0]
        st.note(name, lease["epoch"], lease["secret"], f"{step} since {ts()}")


def lock_beat(progress=None):
    """The holder at work renews the landing lease with its progress mark (run_watched: output bytes and CPU). Raises
    LeaseLost when the lease is gone: the work must stop."""
    if _held_lock[0] and progress is not None:
        st, name, lease = _held_lock[0]
        if st.renew(name, lease["epoch"], lease["secret"], progress, lease["ttl"]) == "lost":
            raise LeaseLost(f"the landing lease {name} (epoch {lease['epoch']}) was lost")


def held_for(lease):
    return f"{int((time.time() - float(lease.get('acquired_at') or time.time())) // 60)} min"


@contextlib.contextmanager
def land_lock(repo):
    """Hold the repository's landing lease, waiting for it with a line saying who holds it and doing what, repeated
    every LAND_WAIT_REPORT_MIN minutes. Yields True when held, False when the wait timed out."""
    st, name = Store(), land_lease_name(repo)
    holder = f"{socket_host()}:land:{os.getpid()}"
    ttl = env_num("AGENTCTL_LAND_LEASE_TTL", LAND_LEASE_TTL)
    got = st.acquire(name, holder, ttl, env_num("AGENTCTL_LAND_LEASE_MAX", LAND_LEASE_MAX), progress="acquired",
                     meta={"pid": os.getpid(), "repo": repo})
    if "held" in got:
        def said(h):
            meta = json.loads(h.get("meta") or "{}")
            return f"{h['holder']} (pid {meta.get('pid')}), {meta.get('note') or 'working'}; expires in {int(h['expires_at'] - time.time())} s"
        err(f"waiting for the landing lease {name}, held by {said(got['held'])}")
        deadline = time.monotonic() + float(os.environ.get("AGENTCTL_LAND_LOCK_TIMEOUT", LAND_LOCK_TIMEOUT))
        every = float(os.environ.get("AGENTCTL_LAND_WAIT_REPORT_MIN", LAND_WAIT_REPORT_MIN)) * 60
        report_at = time.monotonic() + every
        while "held" in got:
            if time.monotonic() > deadline:
                yield False
                return
            if time.monotonic() > report_at:
                err(f"still waiting for the landing lease: {said(got['held'])}")
                report_at = time.monotonic() + every
            time.sleep(2)
            got = st.acquire(name, holder, ttl, env_num("AGENTCTL_LAND_LEASE_MAX", LAND_LEASE_MAX),
                             progress="acquired", meta={"pid": os.getpid(), "repo": repo})
        err("got the landing lease")
    got["ttl"] = ttl
    _held_lock[0] = (st, name, got)
    try:
        yield True
    finally:
        _held_lock[0] = None
        st.release(name, got["epoch"], got["secret"])


def socket_host():
    import socket
    return socket.gethostname().split(".")[0]


def precheck_hook(repo):
    """The repo's own pre-push hook, when it has one with a dry-run mode (movies: scripts/hooks/pre-push --range)."""
    hook = os.path.join(repo, "scripts", "hooks", "pre-push")
    return hook if os.access(hook, os.X_OK) else None


def cmd_land(a):
    if os.environ.get("PREPUSH_SKIP"):
        print("NOT LANDED: PREPUSH_SKIP is set in the environment; agentctl land never skips checks. `unset PREPUSH_SKIP`.")
        return 1
    repo = git(a.repo or os.getcwd(), "rev-parse", "--show-toplevel").strip()
    main_ref = f"refs/remotes/{REMOTE}/main"
    env = tool_env()
    log_path = os.path.join(scratch(), f"agentctl-land-{os.path.basename(repo)}-{os.getpid()}.log")

    def sh(*args):
        return subprocess.run(args, cwd=repo, capture_output=True, text=True, env=env)

    dirty = git(repo, "status", "--porcelain", "--untracked-files=no").strip()
    stash = None
    if dirty and not a.stash:
        print(f"NOT LANDED: the working tree has uncommitted changes ({len(dirty.splitlines())} file(s)). Commit them, or "
              "pass --stash to set them aside in a named stash and restore them afterwards.")
        return 1
    if a.branch:
        r = sh("git", "rev-parse", "--abbrev-ref", "HEAD")
        if r.stdout.strip() != a.branch:
            if dirty:
                print("NOT LANDED: --branch with a dirty tree; commit first")
                return 1
            r = sh("git", "switch", a.branch)
            if r.returncode:
                print(f"NOT LANDED: cannot switch to {a.branch}: {r.stderr.strip()}")
                return 1
    try:
        if dirty:
            stash = Stash(repo)
            stash.save()
            err(f"stashed local changes as {stash.name} ({stash.sha[:10]})")
        if queue_mode(repo, a):  # THE LAND QUEUE: rebase, guard, QUEUED -- the checks and the push are the processor's
            return enqueue(repo, main_ref, sh, a)
        a.landed_sha, a.pushed_at, a.waiting = None, None, None
        rc = None
        for round_ in range(LAND_PRECHECK_ROUNDS + 1):
            # The long checks first, WITHOUT the lock (the last round: under it, so a lander always finishes).
            a.prechecked = None
            if round_ < LAND_PRECHECK_ROUNDS:
                rc = precheck(repo, main_ref, sh, log_path, a)
                if rc is not None:
                    break
            with land_lock(repo) as held:
                if not held:
                    print("NOT LANDED: timed out waiting for the landing lock (another land is running its checks); "
                          "land again.")
                    return 1
                rc = land_loop(repo, main_ref, sh, log_path, a)
            if rc != MAIN_MOVED:
                break
            err(f"{REMOTE}/main moved since the check: checking again on it, outside the lock")
    finally:
        if stash and not stash.restore():
            print(f"WARNING: local changes are in stash {stash.name}, not restored")
    if rc == 0 and a.waiting and not getattr(a, "follow", False):
        return 0  # the processor lands it; LANDED / NOT LANDED and the WATCH verdict go to `agentctl inbox`
    if rc == 0 and a.waiting:  # --follow: wait here for the batch, then watch
        rc, a.landed_sha, a.pushed_at = await_entry(repo, a.waiting["id"], close=None if getattr(a, "keep_worktree", False) else repo)
    if rc != 0 or not a.landed_sha or getattr(a, "no_watch", False):
        return rc
    if not getattr(a, "follow", False):  # land ends at LANDED; a detached watch sends its verdict to the inbox
        spawn_watch_of(repo, a.landed_sha, a.pushed_at, close=None if getattr(a, "keep_worktree", False) else repo,
                       fixes=getattr(a, "fixes", None) or ())
        print(f"watching {a.landed_sha[:10]} detached: its WATCH verdict goes to `agentctl inbox`", flush=True)
        return 0
    # the lock is free again: the next lander goes while this one watches main's CI; on WATCH OK the worktree it ran
    # from is closed when proven merged (close_worktree), unless --keep-worktree
    return watch_landed(repo, a.landed_sha, a.pushed_at, close=None if getattr(a, "keep_worktree", False) else repo,
                        fixes=getattr(a, "fixes", None) or ())


MAIN_MOVED = "main moved"  # land_loop: the check outside the lock no longer covers forgejo/main


def sync(repo, main_ref, sh):
    """Fetch, rebase onto forgejo/main, the squash guard: (rc, None) when land is decided here, else (None, head)."""
    r = sh("git", "fetch", "--quiet", REMOTE, "main")
    if r.returncode:  # a tunnel restart is seconds long: one more try before giving up
        err(f"git fetch failed ({r.stderr.strip()[:120]}); retrying once in 15 s")
        time.sleep(15)
        r = sh("git", "fetch", "--quiet", REMOTE, "main")
    if r.returncode:
        print(f"NOT LANDED: git fetch {REMOTE} main failed: {r.stderr.strip()[:300]} (tunnel? `agentctl env --check`)")
        return 1, None
    head = git(repo, "rev-parse", "HEAD").strip()
    if landed(repo, head, main_ref):
        print(f"LANDED {head} (already on {REMOTE}/main)")
        return 0, None
    r = sh("git", "rebase", "--quiet", f"{REMOTE}/main")
    if r.returncode:
        conflicts = git(repo, "diff", "--name-only", "--diff-filter=U", check=False).stdout.split()
        sh("git", "rebase", "--abort")
        print(f"NOT LANDED: rebase onto {REMOTE}/main conflicts in: {', '.join(conflicts) or r.stderr.strip()[:300]}. "
              "Resolve by hand (git rebase forgejo/main), then land again.")
        return 1, None
    head = git(repo, "rev-parse", "HEAD").strip()
    if landed(repo, head, main_ref):
        print(f"LANDED {head} (the rebase left nothing: already on {REMOTE}/main)")
        return 0, None
    problems = check_range(repo, f"{REMOTE}/main", head, [], int(os.environ.get("AGENTCTL_MAX_FOREIGN", "2")))
    if problems:
        print("NOT LANDED: prepush-check refused:\n  " + "\n  ".join(problems))
        return 1, None
    return None, head


def dry_run(repo, hook, head, log_path, attempt, mode="--range", rechecked=False, cls="check"):
    """The repo hook's dry run over forgejo/main..head, admitted by the governor as a check (`red` for a fix of a red
    run), watched for a stall: None when it passed, else land's rc."""
    err(f"checking {head[:10]}: {os.path.relpath(hook, repo)} {mode} {REMOTE}/main..HEAD (log: {log_path})")
    lock_note(f"checks of {head[:10]}")
    with check_slot(repo, f"land {os.path.basename(repo)} {head[:10]}", cls) as slot:
        rc, out = run_watched([hook, mode, f"{REMOTE}/main..{head}"], repo, slot.env(tool_env()), log_path, "checks",
                              sampler=slot.sample)
        slot.done(rc, out)
    with open(log_path, "a") as f:
        f.write(f"=== check {attempt} {ts()} {head}\n{out}\n")
    if rc is None:
        return stalled("checks (scripts/hooks/pre-push --range)", out, log_path)
    if rc != 0:
        if not REDGATE.search(out) and os.environ.get("AGENTCTL_BASELINE", "1") != "0":
            new, known = judge_against_baseline(repo, hook, head, out, log_path)
            if known and not new:
                checks = ", ".join(sorted(known))
                print(f"KNOWN RED: {checks} fail{'s' if len(known) == 1 else ''} the same way on plain {REMOTE}/main "
                      f"(see `agentctl ci-why`, `Local checks`): not held against this change", flush=True)
                if not rechecked:  # the hook again, now with main's baseline written: it passes known reds (stored)
                    return dry_run(repo, hook, head, log_path, f"{attempt}, against the known-red baseline", mode,
                                   rechecked=True, cls=cls)
                return refused(repo, out, log_path, f"the pre-push checks failed only where plain {REMOTE}/main fails "
                               f"too ({checks}; a known red, claimable as `local`), and the hook still held them "
                               "against it (no baseline mode, or no baseline for this main), so this change lands once "
                               "they are fixed on main (or with the fix)")
            if known:
                print(f"KNOWN RED (not held against this change): {', '.join(sorted(known))}; NEW with this change: "
                      f"{', '.join(sorted(new))}", flush=True)
        return refused(repo, out, log_path, "the pre-push checks failed")
    if os.path.exists(reds_dir("local.json")):  # passing checks clear main's known red
        main_ = git(repo, "rev-parse", f"{REMOTE}/main").strip()
        had = bool(local_red().get("checks"))
        note_local_red(main_, {}, check_passes(out))
        if had and not os.path.exists(reds_dir("local.json")):
            try:
                local_cleared(repo, main_)
            except (Exception, SystemExit) as e:
                err(f"local red cleared, but releasing it failed ({str(e)[:120]})")
    return None


# THE KNOWN-RED BASELINE (the owner, 2026-10-27: "pre-push fails on plain forgejo/main" is itself a claimed red, and
# while it is open a change is judged against main's known-failing checks). When a change's dry run fails, the same
# checks run on plain forgejo/main's tree: a commit with main's tree on top of the change (`git commit-tree
# main^{tree} -p <head>`), checked with `--checks-only <head>..<that>` -- the change's paths select the checks, main's
# tree is checked. Checks failing there the same way (the same normalized failure lines) are main's own red: recorded
# in reds/local.json, shown by ci-why as `Local checks`, claimable (`red claim local`) and dispatched like any red, and
# land says which failures are the change's own. The hook's own output there is kept as `reds/baseline-out/<main sha>`
# (first line `pre-push baseline <main sha>`), the file movies' pre-push reads through $PREPUSH_BASELINE_DIR (tool_env):
# land's dry run then runs the hook once more, which passes a check failing only as it fails on main (its pass stored,
# so the push reuses it). No file for main: the hook blocks every failure (fail-closed).
HOOK_STATUS = re.compile(r"pre-push (\S+) (ok|FAILED) \(\d+s\)")
LOCAL_FLOW = "Local checks"


def check_failures(out):
    """{failed check: {normalized failure lines}} of a hook run's output."""
    fails, seg = {}, []
    for raw in (out or "").splitlines():
        line = ANSI.sub("", raw)
        m = HOOK_STATUS.search(line)
        if m:
            if m.group(2) == "FAILED":
                fails[m.group(1)] = {norm_line(l) for l in seg if STRONG.search(l)} or {"(no failure line)"}
            seg = []
            continue
        seg.append(line)
    return fails


def check_passes(out):
    return {m.group(1) for m in (HOOK_STATUS.search(ANSI.sub("", l)) for l in (out or "").splitlines())
            if m and m.group(2) == "ok"}


def local_red():
    return read_record(reds_dir("local.json")) or {}


def baseline_failures(repo, hook, head, log_path):
    """The change's checks run on plain forgejo/main's tree: {check: lines} failing there (cached per main tree and
    change paths), or None when it could not be run."""
    import hashlib
    main = git(repo, "rev-parse", f"{REMOTE}/main").strip()
    paths = git(repo, "diff", "--name-only", f"{REMOTE}/main...{head}").split()
    key = hashlib.sha1("\n".join([git(repo, "rev-parse", f"{main}^{{tree}}").strip()] + sorted(paths)).encode()).hexdigest()[:16]
    cache = reds_dir("baseline", f"{key}.json")
    rec = read_record(cache)
    if rec is not None:
        return {k: set(v) for k, v in rec["fails"].items()}
    synth = git(repo, "commit-tree", f"{main}^{{tree}}", "-p", head, "-m", f"agentctl baseline: {REMOTE}/main {main[:10]}",
                check=False)
    if synth.returncode != 0:
        return None
    synth = synth.stdout.strip()
    _d, clone, _w = waiting_state(repo)
    tree = f"{clone}-wt-baseline-{os.getpid()}"
    if git(repo, "worktree", "add", "-q", "--detach", mark_internal(tree), synth, check=False).returncode != 0:
        return None
    try:
        err(f"the change's checks failed: running them on plain {REMOTE}/main {main[:10]} (the known-red baseline)")
        with check_slot(repo, f"baseline {main[:10]}") as slot:
            rc, out = run_watched([os.path.join(tree, os.path.relpath(hook, repo)), "--checks-only", f"{head}..{synth}"],
                                  tree, {**slot.env(tool_env()), "PREPUSH_BASELINE_DIR": ""}, log_path, "baseline",
                                  sampler=slot.sample)
            slot.done(rc, out)
    finally:
        git(repo, "worktree", "remove", "--force", tree, check=False)
    if rc is None:
        return None
    write_baseline_out(main, out)
    fails = check_failures(out) if rc else {}
    write_json(cache, {"main": main, "at": ts(), "fails": {k: sorted(v) for k, v in fails.items()},
                       "passes": sorted(check_passes(out))})
    note_local_red(main, fails, check_passes(out))
    return fails


def write_baseline_out(main, out):
    """reds/baseline-out/<main>: the hook's output on plain main (appended to a run for other paths on the same main),
    for the hook's known-red baseline; files older than 3 days go."""
    d = reds_dir("baseline-out")
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, main)
    try:
        with open(path) as f:
            old = f.read()
    except OSError:
        old = ""
    if not old.startswith(f"pre-push baseline {main}\n"):
        old = f"pre-push baseline {main}\n"
    tmp = f"{path}.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(old + (out or "") + ("" if (out or "").endswith("\n") else "\n"))
    os.replace(tmp, path)
    for name in os.listdir(d):
        p = os.path.join(d, name)
        try:
            if time.time() - os.path.getmtime(p) > 3 * 86400:
                os.unlink(p)
        except OSError:
            pass


def note_local_red(main, fails, passes):
    """Keep reds/local.json: the checks failing on plain forgejo/main (added), those seen passing (cleared)."""
    with reds_lock():
        rec = local_red()
        checks = rec.get("checks") or {}
        for c in passes:
            checks.pop(c, None)
        for c, lines in fails.items():
            old = checks.get(c) or {"since": ts(), "first_main": main}
            checks[c] = {**old, "lines": sorted(lines)[:20], "main": main}
        rec.update(checks=checks, main=main, at=ts())
        if checks:
            write_json(reds_dir("local.json"), rec)
        elif os.path.exists(reds_dir("local.json")):
            os.unlink(reds_dir("local.json"))


# A STALE LOCAL RED (2026-10-27: `Local checks: RED on plain forgejo/main ac65cbbd7e` outlived the commit that fixed it).
# reds/local.json is keyed to the main sha it was computed on. Once forgejo/main moves past it the record is stale: shown as
# `stale, rechecking` (never RED), and the failing checks are run again on the new main's tree -- in the background by the
# processor's patrol (the governor's check class), synchronously by `red patrol`, or by the next land's dry run. A pass
# clears the red, releases its claims, stops its dispatched fixer (process groups) and puts FIX OK in the inbox; the
# fixer's worktrees whose commits are patch-equivalent on main are removed, any other is listed in the inbox.
HOOK_CHECKS = ("eslint drift snapshot sbt dashboards scripttests actionlint shellcheck oldrefs identity page ios "
               "judgements lintspecs linux basic").split()


def recheck_local(repo, wait=True):
    """Recompute a stale local red on the current forgejo/main. Returns action lines (when it ran synchronously)."""
    main = local_stale(repo)
    if not main:
        return release_local_leftovers(repo)
    if not wait:
        import threading
        t = _bounded.get("local-recheck")
        if t and t.is_alive():
            return []
        t = threading.Thread(target=lambda: _recheck_guarded(repo, main), name="local-recheck", daemon=True)
        _bounded["local-recheck"] = t
        t.start()
        return []
    return _recheck_guarded(repo, main)


def _recheck_guarded(repo, main):
    """One recheck at a time across processes (the processor's and a `red patrol`): the second one leaves it."""
    os.makedirs(reds_dir("local"), exist_ok=True)
    try:
        with open(reds_dir("local", "recheck.lock"), "a+") as lf:
            try:
                fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                return []
            return run_local_recheck(repo, main)
    except (Exception, SystemExit) as e:
        err(f"local recheck: skipped ({str(e).replace('agentctl: ', '')[:200]})")
        return []


def run_local_recheck(repo, main):
    """Run the recorded failing checks on main's tree (the hook over <recorded main>..main, every other check skipped)."""
    failing = sorted(local_red().get("checks") or {})
    hook = precheck_hook(repo)
    if not hook:
        return []
    # The base is the main the red FIRST appeared on (first_main; the record's `main` moves with every recheck): the checks judge what changed since (shellcheck fails only on warnings
    # a change ADDS, so against an empty base the whole tree would count). Unknown to this clone: the empty tree.
    firsts = [str(c.get("first_main") or "") for c in (local_red().get("checks") or {}).values()]
    old_main = next((f for f in firsts if f and git_ok(repo, "cat-file", "-e", f"{f}^{{commit}}")), "")
    if old_main and git_ok(repo, "cat-file", "-e", f"{old_main}^{{commit}}"):
        base = old_main
    else:
        empty = git(repo, "hash-object", "-t", "tree", "-w", "--stdin", input="").strip()
        base = git(repo, "commit-tree", empty, "-m", "agentctl recheck base").strip()
    synth = git(repo, "commit-tree", f"{main}^{{tree}}", "-p", base, "-m", f"agentctl recheck: {REMOTE}/main {main[:10]}").strip()
    _d, clone, _w = waiting_state(repo)
    for w in worktrees(repo)[1:]:  # a killed recheck's tree (its pid is gone)
        m = re.fullmatch(re.escape(clone) + r"-wt-recheck-(\d+)", w["worktree"])
        if m and not pid_alive(int(m.group(1))):
            git(repo, "worktree", "remove", "--force", w["worktree"], check=False)
    tree = f"{clone}-wt-recheck-{os.getpid()}"
    if git(repo, "worktree", "add", "-q", "--detach", mark_internal(tree), synth, check=False).returncode != 0:
        return []
    log_path = reds_dir("local", "recheck.log")
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    try:
        err(f"local checks were recorded on an older main: rechecking {', '.join(failing)} on {REMOTE}/main {main[:10]}")
        with check_slot(repo, f"local recheck {main[:10]}", "check") as slot:
            env = {**slot.env(tool_env()), "PREPUSH_BASELINE_DIR": "",
                   "PREPUSH_SKIP": " ".join(c for c in HOOK_CHECKS if c not in failing)}
            rc, out = run_watched([os.path.join(tree, os.path.relpath(hook, repo)), "--checks-only", f"{base}..{synth}"],
                                  tree, env, log_path, "recheck", sampler=slot.sample)
            slot.done(rc, out)
    finally:
        git(repo, "worktree", "remove", "--force", tree, check=False)
        git(repo, "gc", "--auto", "--quiet", check=False)
    if rc is None:
        return []  # stalled: stays stale, rechecked next time
    return apply_local_recheck(repo, main, rc, out)


def apply_local_recheck(repo, main, rc, out):
    """Record a recheck's outcome (also what land's passing dry run does): still failing -> re-keyed to main; passed ->
    cleared and released."""
    failing = dict(local_red().get("checks") or {})
    passes = check_passes(out)
    fails = check_failures(out) if rc else {}
    for c, v in failing.items():  # neither seen passing nor failing (not run): still the old failure, on the new main
        if c not in passes and c not in fails:
            fails[c] = set(v.get("lines") or [])
    write_baseline_out(main, out)
    note_local_red(main, fails, passes)
    if os.path.exists(reds_dir("local.json")):
        return [f"local checks still fail on {REMOTE}/main {main[:10]}: {', '.join(sorted(fails))}"]
    return local_cleared(repo, main)


def local_cleared(repo, main):
    """The local red is gone: release its claims, stop its fixer, FIX OK to the inbox, tidy the fixer's worktrees."""
    acts = []
    for c in all_claims():
        if c.get("workflow") == LOCAL_FLOW or "local" in (c.get("runs") or []):
            try:
                os.unlink(c["path"])
                acts.append(f"released claim {c.get('who')} on Local checks")
            except OSError:
                pass
    for r in fixer_records():
        if r.get("workflow") == LOCAL_FLOW and r["alive"]:
            for pg in {r.get("pid"), r.get("claude_pgid")} - {None}:
                try:
                    stop_group(int(pg))
                except OSError:  # a zombie leader nobody reaped answers EPERM: the group is gone
                    pass
            r2 = read_record(r["path"]) or r
            r2.update(ended=ts(), verdict="red cleared: Local checks pass on main")
            write_json(r2.get("path") or r["path"], {k: v for k, v in r2.items() if k not in ("path", "alive")})
            acts.append(f"stopped the dispatched local fixer (pid {r.get('pid')})")
    line = f"FIX OK: Local checks pass on {REMOTE}/main {main[:10]}; the red is cleared"
    inbox_write("red", line, [line], [], 0)
    acts.append(line)
    return acts + release_local_leftovers(repo)


def release_local_leftovers(repo):
    """With no local red: each ended local fixer's worktree is removed when its commits are patch-equivalent on main
    (git cherry); anything else is listed in the inbox, never deleted. Once per fixer record."""
    if local_red().get("checks"):
        return []
    acts = []
    for r in fixer_records():
        if r.get("workflow") != LOCAL_FLOW or r["alive"] or r.get("tidied"):
            continue
        wt = r.get("worktree")
        if not wt or not os.path.isdir(wt):
            msg = None
        else:
            msg = close_worktree(wt)
            if not msg.startswith("closed"):
                line = f"RED LEFTOVER: the local fixer's {wt.replace(HOME, '~')} was kept ({msg.split(': ', 1)[-1]}); not patch-equivalent on main, review it"
                inbox_write("red", line, [line], [], 1)
                acts.append(line)
                msg = None
        if msg:
            acts.append(f"removed the local fixer's worktree: {msg}")
        rec = read_record(r["path"]) or {}
        rec["tidied"] = ts()
        write_json(r["path"], rec)
    return acts



def judge_against_baseline(repo, hook, head, out, log_path):
    """(new failures, known): the change's failures that plain forgejo/main does not share, and those it does."""
    mine = check_failures(out)
    if not mine:
        return None, {}
    base = baseline_failures(repo, hook, head, log_path)
    if base is None:
        return None, {}
    new = {c: l for c, l in mine.items() if c not in base or not (l <= base[c])}
    return new, {c: l for c, l in mine.items() if c not in new}


def current_main(repo):
    r = git(repo, "rev-parse", "--verify", "-q", f"{REMOTE}/main", check=False) if repo else None
    return r.stdout.strip() if r is not None and r.returncode == 0 else None


def local_stale(repo):
    """forgejo/main's sha when the recorded local red was computed on an older one (the record is stale), else None."""
    rec = local_red()
    if not rec.get("checks"):
        return None
    cur = current_main(repo)
    return cur if cur and cur != rec.get("main") else None


def local_units(repo=None):
    """main's own local-checks red (reds/local.json) as red units: one per failing check, run `local`. A record
    computed on an older main is stale: no units (shown as `stale, rechecking`, never RED)."""
    if repo and local_stale(repo):
        return []
    rec = local_red()
    units = []
    for check, c in sorted((rec.get("checks") or {}).items()):
        line = (c.get("lines") or [""])[0]
        s = {"job": check, "kind": "test", "line": line, "sig": signature(LOCAL_FLOW, check, line)}
        run = {"number": "local", "databaseId": f"local-{str(c.get('main'))[:10]}", "headSha": c.get("main"),
               "status": "completed", "conclusion": "failure"}
        units += red_units("?", LOCAL_FLOW, run, [], [s], True)
    return units



def precheck(repo, main_ref, sh, log_path, a):
    """Before the lock: sync and the hook's dry run (the long part). None when land goes on to the lock (with
    a.prechecked = (head, base) when the dry run passed there), else land's rc."""
    rc, head = sync(repo, main_ref, sh)
    if rc is not None:
        return rc
    hook = precheck_hook(repo)
    if not hook:
        return None
    # The change's OWN checks first, red main or green (the owner, 2026-10-27: "once the checks are done but build is
    # red, merge to waiting"): main red and the change one that must wait, without the gate (--checks-only), since it
    # will join `waiting` and land with the batch at green.
    reds = gate_reds(repo) if waiting_supported(repo) else set()
    commits = waiting_commits(repo, f"{REMOTE}/main", head)
    joining = bool(reds) and must_wait(repo, commits, reds)
    rc = dry_run(repo, hook, head, log_path, "before the lock", mode="--checks-only" if joining else "--range",
                 cls=gov_class_of(repo, commits, reds))
    if rc is not None:
        return rc
    a.prechecked = (head, git(repo, "rev-parse", main_ref).strip())
    return None


def land_loop(repo, main_ref, sh, log_path, a):
    for attempt in range(LAND_RETRIES + 1):
        lock_note("fetch and rebase")
        rc, head = sync(repo, main_ref, sh)
        if rc is not None:
            return rc
        reds = gate_reds(repo) if waiting_supported(repo) else set()
        if reds and must_wait(repo, waiting_commits(repo, f"{REMOTE}/main", head), reds):
            # checked already (before the lock, without the gate): only the cherry-pick onto `waiting` here
            return join(repo, main_ref, sh, log_path, a, head=head)
        hook = precheck_hook(repo)
        prechecked = getattr(a, "prechecked", None)
        if hook and prechecked and prechecked != (head, git(repo, "rev-parse", main_ref).strip()):
            # main moved since the check outside the lock: give the lock back and check again outside it
            a.prechecked = None
            return MAIN_MOVED
        if hook and not prechecked:
            # CHECK FIRST: the hook's dry run over exactly what the push will carry (its pass is stored, so the push's own
            # hook run reuses it in seconds). A long hook inside `git push` holds the push's ssh connection idle, and a
            # tunnel drop kills it after "all clear" (2026-10-23); the area tests make long hooks the norm.
            rc = dry_run(repo, hook, head, log_path, attempt + 1,
                         cls=gov_class_of(repo, waiting_commits(repo, f"{REMOTE}/main", head), reds))
            if rc is not None:
                return rc
        a.prechecked = None  # a retry after a push race checks its new base again
        try:  # the runs the pushed commits claim to fix: the watch verifies them
            a.fixes = sorted(fixes_of(repo, waiting_commits(repo, f"{REMOTE}/main", head)))
        except Exception:
            a.fixes = []
        err(f"pushing {head[:10]} to {REMOTE}/main (attempt {attempt + 1}/{LAND_RETRIES + 1}; hook log: {log_path})")
        lock_note(f"push of {head[:10]}")
        a.pushed_at = time.time()
        rc, out = run_watched(push_argv(REMOTE, head), repo, tool_env(), log_path, "push", **push_bounds())
        if rc == 0:
            mark_gate_dirty()
        with open(log_path, "a") as f:
            f.write(f"=== attempt {attempt + 1} {ts()} {head}\n{out}\n")
        if rc is None:
            return stalled("push (git push and its pre-push hook)", out, log_path)
        if rc == 0:
            sh("git", "fetch", "--quiet", REMOTE, "main")
            how = landed(repo, head, main_ref)
            if how:
                print(f"LANDED {head}" + ("" if how == "ancestor" else f" ({how})"), flush=True)
                a.landed_sha = head
                return 0
            print(f"NOT LANDED: the push exited 0 but {head[:10]} is not on {REMOTE}/main after a fetch; see {log_path}")
            return 1
        if RACE.search(out) and attempt < LAND_RETRIES:
            err(f"push race ({RACE.search(out).group(0)}): refetch, rebase, retry")
            time.sleep(min(30, 2 + 3 * attempt))
            continue
        if RACE.search(out) and not REDGATE.search(out):
            print(f"NOT LANDED: still racing after {LAND_RETRIES} retries ({RACE.search(out).group(0)}); try again shortly.")
            return 1
        return refused(repo, out, log_path, "the push failed (pre-push hook or remote)")
    return 1


def refused(repo, out, log_path, what):
    """Print the NOT LANDED line for a hook or push that said no: the red gate explained by ci-why, a tunnel hinted."""
    tail = "\n  ".join([l for l in out.splitlines() if l.strip()][-25:])
    if REDGATE.search(out):
        print(f"NOT LANDED: the red gate refused the push (main is red).\n  {tail}")
        try:
            print(ci_why(slug(repo), 4, repo=repo)[1])
        except Exception as e:
            print(f"(agentctl ci-why failed: {e})")
        return 1
    hint = ""
    if TUNNEL_TROUBLE.search(out):
        hint = ("\n  HINT: the hook could not reach Forgejo (tunnel dropped?): `~/bin/agentctl env --check` "
                "(it says the kickstart fix), then land again.")
    print(f"NOT LANDED: {what}. Last lines (full log {log_path}):\n  {tail}{hint}")
    return 1


# ---------------------------------------------------------------- land: the watch after LANDED
# The owner (2026-10-26): "whenever an agent pushed to main, make a script watch the corresponding convergence and main
# build and tell the agent if it fails". With no pre-merge CI, main's CI is where a change is tested in full: land keeps
# running after LANDED until Main and the convergence say green or red, so the agent (land in the background) hears it.
WATCH = {"pawelkrupinski/movies": {"main": ("Main", "main.yml"),
                                   "convergence": ("Identity model convergence", "identity-model-convergence.yml")}}
WATCH_TIMEOUT = 3 * 3600          # either run undecided by then: exit 2, could not tell
WATCH_CONV_START = 3600           # no convergence run containing the sha started by then: said, not waited for
WATCH_SLACK = 120                 # clock skew between the laptop and Forgejo's createdAt
WATCH_STALL_MIN = 120  # a watch with no change in its runs for this long ends WATCH STALLED
UNDECIDED = ("cancelled", "skipped", "neutral", "")


def contains(repo, sha, head):
    """Whether a run's head commit contains sha (fetching main once when head is unknown here)."""
    if not head:
        return False
    if head == sha:
        return True
    if not git_ok(repo, "cat-file", "-e", f"{head}^{{commit}}"):
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
    return git_ok(repo, "merge-base", "--is-ancestor", sha, head)


def is_cancelled(r):
    return r.get("status") == "completed" and (r.get("conclusion") or "") in UNDECIDED


def pick_main_run(repo, sha, runs):
    """Main's run for sha: its own push run, unless that was cancelled or never came (a newer push superseded it); then the
    newest run whose head contains sha."""
    own = next((r for r in runs if r.get("headSha") == sha and not is_cancelled(r)), None)
    if own:
        return own
    later = [r for r in runs if not is_cancelled(r) and contains(repo, sha, r.get("headSha"))]
    return max(later, key=lambda r: r["databaseId"]) if later else None


def pick_convergence_run(repo, sha, runs, pushed_at):
    """The FIRST convergence run on main created after the push whose head contains sha -- this commit's kick, a later
    push's, or the daily run (the owner, 2026-10-26: never hunt the sha's own kick). A cancelled one (the lane replaced
    it) passes to the next."""
    after = [r for r in runs if r.get("createdAt") and parse_time(r["createdAt"]).timestamp() >= pushed_at - WATCH_SLACK]
    ok = [r for r in sorted(after, key=lambda r: r["databaseId"]) if not is_cancelled(r) and contains(repo, sha, r.get("headSha"))]
    return ok[0] if ok else None


def watch_landed(repo, sha, pushed_at, o_r=None, close=None, fixes=()):
    """Watch Main and the convergence for a landed sha. 0 green (or nothing to watch), 3 red, 2 could not tell. OWNED
    (one watcher per sha; on agentctl's new code it re-execs as `agentctl watch`). fixes: the runs the landed commits'
    `Fixes-Red:` trailers name (the sha's own are read here too): each is verified against the new run (FIX OK / FIX
    FAILED, to the inbox)."""
    o_r = o_r or slug(repo)
    flows = WATCH.get(o_r)
    if not flows:
        print(f"watch: no CI watched for {o_r} (only movies' Main and convergence are)")
        return 0
    pushed_at = pushed_at or time.time()
    try:
        fixes = sorted(set(fixes) | fixes_of(repo, [sha]))
    except Exception:
        fixes = sorted(set(fixes))
    own = Owned("watch", f"{o_r}-{sha}", ["watch", "--repo", repo, "--sha", sha, "--pushed-at", str(pushed_at)]
                + (["--close", close] if close else []) + [x for f in fixes for x in ("--fixes", f)])
    if not own.acquire():
        h = own.holder or {}
        print(f"WATCH UNKNOWN: another agentctl (pid {h.get('pid')}, {h.get('owner')}) already watches {sha[:10]}; "
              "its verdict is its own (`agentctl orphans` lists owners)")
        return 2
    try:
        rc = _watch(repo, sha, pushed_at, o_r, flows, own, fixes)
    finally:
        own.release()
    if rc == 0 and close:
        print(close_worktree(close), flush=True)
    return rc


def failed_jobs(o_r, rid):
    d = gh_json(o_r, "run", "view", str(rid), "--json", "jobs")
    return [j["name"] for j in d.get("jobs") or [] if j.get("conclusion") in ("failure", "timed_out", "cancelled")]


def job_results(o_r, rid):
    d = gh_json(o_r, "run", "view", str(rid), "--json", "jobs")
    return {j.get("name"): j.get("conclusion") or j.get("status") or "" for j in d.get("jobs") or []}


def run_id_of_number(o_r, n):
    """The run id whose run NUMBER (Forgejo's index_in_repo, the #N of every link) is n, or None."""
    try:
        runs = (api(o_r, "GET", "actions/runs", {"run_number": int(n), "limit": 5}) or {}).get("workflow_runs") or []
    except (Exception, SystemExit):
        return None
    hit = next((x for x in runs if str(x.get("index_in_repo", x.get("run_number"))) == str(n)), None)
    return hit and hit.get("id")


def fixes_red_run(o_r, n, listed=None):
    """The run a `Fixes-Red: n` names. The repo's convention is the run NUMBER (#N); an id only when no run has that
    number (2026-10-27: Fixes-Red 2133 meant Identity capture #2133, id 3281, and was read as id 2133, an old
    convergence run #1111). When the number and the id name different runs, the number wins and the run says so in
    `_note`. None when n is no run."""
    listed = listed or {}
    for runs in listed.values():
        for r in runs:
            if str(r.get("number")) == str(n):
                return dict(r)
    run = None
    rid = run_id_of_number(o_r, n)
    if rid is not None:
        try:
            run = gh_json(o_r, "run", "view", str(rid), "--json", RUN_FIELDS)
        except Exception:
            run = None
    if run is not None:
        by_id = next((r for runs in listed.values() for r in runs if str(r.get("databaseId")) == str(n)), None)
        if by_id is None:
            try:
                by_id = gh_json(o_r, "run", "view", str(n), "--json", RUN_FIELDS)
            except Exception:
                by_id = None
        if by_id and str(by_id.get("databaseId")) != str(run.get("databaseId")):
            run["_note"] = (f"Fixes-Red {n} read as run number #{n} ({run.get('workflowName')}), not run id {n} "
                            f"({by_id.get('workflowName')} #{by_id.get('number')})")
        return run
    for runs in listed.values():  # no run has that number: an id, as the trailer's fallback
        for r in runs:
            if str(r.get("databaseId")) == str(n):
                return dict(r, _note=f"Fixes-Red {n}: no run #{n}, read as run id {n}")
    try:
        r = gh_json(o_r, "run", "view", str(n), "--json", RUN_FIELDS)
        return dict(r, _note=f"Fixes-Red {n}: no run #{n}, read as run id {n}")
    except Exception:
        return None


def claimed_run(o_r, n, listed):
    """(kind, run) of the run a `Fixes-Red: n` names (fixes_red_run: its number first, then an id); kind None when it is
    not one of the watched workflows; (None, None) when n is no run."""
    r = fixes_red_run(o_r, n, listed)
    if r is None:
        return None, None
    for kind, runs in listed.items():
        if any(str(x.get("databaseId")) == str(r.get("databaseId")) for x in runs):
            return kind, r
    for kind, (name, _wfile) in WATCH.get(o_r, {}).items():
        if r.get("workflowName") == name:
            return kind, r
    return None, r


# -- a fix for a red OUTSIDE the gate (Identity capture, weekly or on dispatch) is verified now, not at the next
# scheduled run (the owner, 2026-10-27): its workflow is dispatched on main (workflow_dispatch; the inputs are the
# workflow's defaults), the run waited for, FIX OK / FIX FAILED to the inbox, the claim released, the snapshot refreshed.
# One verification dispatch per workflow at a time (a second fix landing while one is pending gets none: the pending
# run is the newest to start), counted in the daily dispatch budget. No workflow_dispatch: FIX UNVERIFIED until the
# next scheduled run.
VERIFY_WAIT = 2 * 3600


def repo_for_verify(o_r):
    return scan_repo_for(o_r) or repo_path_for(o_r)


def workflow_file_of(repo, sha, name):
    """(path in the tree, text) of the workflow file whose `name:` is `name`, at sha."""
    for d in (".forgejo/workflows", ".github/workflows"):
        r = git(repo, "ls-tree", "--name-only", sha, f"{d}/", check=False)
        for path in r.stdout.split():
            txt = git(repo, "show", f"{sha}:{path}", check=False).stdout
            if re.search(rf"^name:\s*[\"']?{re.escape(name)}[\"']?\s*$", txt, re.M):
                return path, txt
    return None, ""


def verify_dir(*parts):
    return reds_dir("verify", *parts)


def verify_outside_gate(o_r, repo, sha, n, old=None):
    """The verdict line for `Fixes-Red: n` naming a run outside the gate, or None when n is no run at all."""
    old = old if old is not None else fixes_red_run(o_r, n)
    if old is None:
        return None
    name = old.get("workflowName")
    path, txt = workflow_file_of(repo, sha, name) if name else (None, "")
    if not path:
        return None
    flow = os.path.basename(path)
    if "workflow_dispatch" not in txt:
        cron = re.search(r"cron:\s*[\"']([^\"']+)[\"']", txt)
        return (f"FIX UNVERIFIED until next scheduled run{' (cron ' + cron.group(1) + ')' if cron else ''}: {name} has no "
                f"workflow_dispatch (fix {sha[:10]} claimed #{old.get('number')})")
    rec_path = verify_dir(re.sub(r"[^\w.-]+", "_", name) + ".json")
    rec = read_record(rec_path) or {}
    if rec.get("pending") and time.time() - float(rec.get("epoch") or 0) < VERIFY_WAIT:
        return (f"FIX UNVERIFIED: {name} already has a verification run pending ({rec.get('fix', '')[:10]}); "
                f"fix {sha[:10]} gets none of its own")
    cap = int(env_num("AGENTCTL_RED_DAILY_CAP", RED_DAILY_CAP))
    if dispatches_today() >= cap:
        return f"FIX UNVERIFIED: daily dispatch budget ({cap}) reached; {name} not dispatched for fix {sha[:10]}"
    t0 = time.time()
    os.makedirs(verify_dir(), exist_ok=True)
    write_json(rec_path, {"fix": sha, "run": n, "workflow": name, "file": flow, "at": ts(), "epoch": t0, "pending": True})
    try:
        api(o_r, "POST", f"actions/workflows/{flow}/dispatches", body={"ref": "main", "inputs": {}})
        try:
            record_dispatch(branch="main", workflow=name, sha=sha, agent="red verify", pid=os.getpid(), inputs={},
                            purpose=f"verify Fixes-Red {n} (fix {sha[:10]})", key=f"verify-{flow}-{int(t0)}")
        except (Exception, SystemExit):
            pass
    except Exception as e:
        write_json(rec_path, {**read_record(rec_path), "pending": False, "error": str(e)[:160]})
        return f"FIX UNVERIFIED: could not dispatch {name} on main ({str(e)[:120]}); fix {sha[:10]} claimed #{old.get('number')}"
    new = None
    poll = env_num("AGENTCTL_VERIFY_POLL", 30)
    while time.time() - t0 < env_num("AGENTCTL_VERIFY_WAIT", VERIFY_WAIT):
        runs = gh_json(o_r, "run", "list", "--workflow", flow, "--branch", "main", "--limit", "10", "--json", RUN_FIELDS)
        fresh = [r for r in runs if r["databaseId"] > old["databaseId"] and not is_cancelled(r)
                 and r.get("databaseId") not in (rec.get("seen") or [])]
        new = min(fresh, key=lambda r: r["databaseId"]) if fresh else None
        if new and new.get("status") == "completed":
            break
        new = None
        time.sleep(poll)
    write_json(rec_path, {**read_record(rec_path), "pending": False, "new_run": new and new.get("databaseId")})
    if not new:
        return f"FIX UNVERIFIED: the verification run of {name} did not finish in time (fix {sha[:10]} claimed #{old.get('number')})"
    was = failed_jobs(o_r, old["databaseId"])
    now_ = job_results(o_r, new["databaseId"])
    again = [j for j in was if now_.get(j) in ("failure", "timed_out", "cancelled")]
    if again or (not was and new.get("conclusion") != "success"):
        return (f"FIX FAILED: {name} #{new.get('number')} (verification dispatch) still fails "
                f"{', '.join(again) or 'a job'} (fix {sha[:10]} claimed #{old.get('number')})")
    release_claims_for(n, old)
    try:
        ci_state_refresh(o_r)
    except (Exception, SystemExit):
        pass
    return f"FIX OK: #{old.get('number')} cleared by #{new.get('number')} (verification dispatch of {name})"


def release_claims_for(n, old):
    names = {str(n), str(old.get("number")), str(old.get("databaseId"))}
    for c in all_claims():
        if names & set(map(str, c.get("runs") or [])) | ({str(c.get("run"))} & names):
            try:
                os.unlink(c["path"])
            except OSError:
                pass



def verify_fixes(o_r, sha, fixes, done, listed, flows):
    """The owner (2026-10-27): the batch fix 97bb6d835 claimed Fixes-Red 2047, Main #2059 failed again in the same
    worker-identity job, and nothing said so. For each claimed run N: the first completed run of N's workflow containing
    the commit (the watch's) against N's failed jobs. Each verdict is printed and written to the inbox."""
    for n in fixes:
        try:
            kind, old = claimed_run(o_r, n, listed)
            if kind is None:
                line = verify_outside_gate(o_r, repo_for_verify(o_r), sha, n, old=old) if old is not None else None
                if line is None:
                    line = f"FIX UNVERIFIED: #{n} (fix {sha[:10]}) is not a run of {' or '.join(f[0] for f in flows.values())}"
            elif kind not in done or done[kind][0] is None:
                line = (f"FIX UNVERIFIED: no completed {flows[kind][0]} run containing {sha[:10]} when the watch ended "
                        f"(fix claimed #{old.get('number')})")
            else:
                new = done[kind][0]
                was = failed_jobs(o_r, old["databaseId"])
                now_ = job_results(o_r, new["databaseId"])
                again = [j for j in was if now_.get(j) in ("failure", "timed_out", "cancelled")]
                missing = [j for j in was if now_.get(j) != "success" and j not in again]
                if again:
                    line = (f"FIX FAILED: {flows[kind][0]} #{new.get('number')} still fails {', '.join(again)} "
                            f"(fix {sha[:10]} claimed #{old.get('number')})")
                elif missing:
                    line = (f"FIX UNVERIFIED: {flows[kind][0]} #{new.get('number')} did not run {', '.join(missing)} "
                            f"(fix {sha[:10]} claimed #{old.get('number')})")
                else:
                    line = f"FIX OK: #{old.get('number')} cleared by #{new.get('number')}"
        except (Exception, SystemExit) as e:
            line, old = f"FIX UNVERIFIED: #{n} (fix {sha[:10]}) could not be compared ({str(e)[:160]})", None
        if old is not None and old.get("_note"):
            line += f" [{old['_note']}]"
        print(line, flush=True)
        inbox_write("watch", line, [line], [], 1 if line.startswith("FIX FAILED") else 0)


def _watch(repo, sha, pushed_at, o_r, flows, own, fixes=()):
    timeout = float(os.environ.get("AGENTCTL_WATCH_TIMEOUT", WATCH_TIMEOUT))
    conv_start = float(os.environ.get("AGENTCTL_WATCH_CONV_START", WATCH_CONV_START))
    t0 = time.time()
    err(f"watching Main and the convergence for {sha[:10]} (up to {int(timeout // 60)} min; `--no-watch` skips this)"
        + (f"; verifying Fixes-Red {', '.join(fixes)}" if fixes else ""))
    done, said, listed = {}, set(), {}  # kind -> (run, ok | None for none started); kind -> the runs last listed
    # NO PROGRESS: nothing about the followed runs (which run, its status, its last update) changed for this long ends
    # the watch with a named verdict (a queue Forgejo never serves, a runner lost mid-run), not a silent 3 h wait
    stall = float(os.environ.get("AGENTCTL_WATCH_STALL_MIN", WATCH_STALL_MIN)) * 60
    state, changed = None, time.time()
    delays = backoff(float(os.environ.get("AGENTCTL_WATCH_POLL", 60)), 300)
    # UNREACHABLE: a failed read backs off (to 5 min) and is retried until the watch's own bound; only then UNKNOWN,
    # saying for how long Forgejo could not be read (2026-10-27: ten failures in a row used to end it in minutes)
    unreachable, failures, last_error, err_delays = None, 0, "", None

    def verdict(rc, line):
        print(line, flush=True)
        if fixes:
            verify_fixes(o_r, sha, fixes, done, listed, flows)
        return rc

    while True:
        seen = {}
        try:
            for kind, (name, wfile) in flows.items():
                if kind in done:
                    continue
                runs = gh_json(o_r, "run", "list", "--workflow", wfile, "--branch", "main", "--limit", "30",
                               "--json", RUN_FIELDS)
                listed[kind] = runs
                run = pick_main_run(repo, sha, runs) if kind == "main" else pick_convergence_run(repo, sha, runs, pushed_at)
                if run is None:
                    if kind == "convergence" and time.time() - t0 >= conv_start:
                        done[kind] = (None, None)
                        print(f"convergence: none started within {int(conv_start // 60)} min of the push", flush=True)
                    continue
                seen[kind] = (run.get("databaseId"), run.get("status"), run.get("updatedAt"))
                if (kind, run["databaseId"]) not in said:
                    said.add((kind, run["databaseId"]))
                    err(f"{name}: following run #{run.get('number')} ({run.get('status')}, head {str(run.get('headSha'))[:10]})")
                if run.get("status") == "completed" and not is_cancelled(run):
                    done[kind] = (run, run.get("conclusion") == "success")
                    print(f"{name} #{run.get('number')}: {run.get('conclusion')}", flush=True)
            if unreachable is not None:
                err(f"watch: Forgejo answers again after {red_for(iso_at(unreachable))} ({failures} failed reads)")
            unreachable, failures, err_delays = None, 0, None
        except NoToken as e:  # no vault for this process: retrying cannot help
            return verdict(2, f"WATCH UNKNOWN: no Forgejo token ({str(e).replace('agentctl: ', '')}); "
                              f"check `agentctl ci-why` for {sha[:10]}")
        except Exception as e:  # a tunnel blip, Forgejo down: read again, backing off, until the bound
            failures += 1
            last_error = str(e)[:160]
            if unreachable is None:
                unreachable, err_delays = time.time(), backoff(float(os.environ.get("AGENTCTL_WATCH_ERROR_POLL", 30)), 300)
            err(f"watch: could not read the runs ({last_error}) [{failures} failed, unreachable for "
                f"{red_for(iso_at(unreachable))}]")
        reds = [(k, r) for k, (r, ok) in done.items() if ok is False]
        if reds:
            for kind, r in reds:
                try:
                    failed = failed_jobs(o_r, r["databaseId"])
                except (Exception, SystemExit) as e:  # the verdict stands without the job names
                    err(f"could not read the jobs of run {r['databaseId']} ({str(e)[:120]})")
                    failed = []
                print(f"WATCH RED: {flows[kind][0]} #{r.get('number')} {', '.join(failed) or r.get('conclusion')} "
                      f"(it contains your {sha[:10]}: if your change broke it, fix forward now with `Fixes-Red: "
                      f"{r.get('number')}`)", flush=True)
            try:
                print(ci_why(o_r, 4, repo=repo)[1])
            except (Exception, SystemExit) as e:
                print(f"(agentctl ci-why failed: {e})")
            if fixes:
                verify_fixes(o_r, sha, fixes, done, listed, flows)
            return 3
        if len(done) == len(flows):
            parts = [f"{flows[k][0].split()[0] if k == 'main' else 'convergence'} " +
                     (f"#{r.get('number')} green" if r else "none started") for k, (r, ok) in done.items()]
            return verdict(0, "WATCH OK: " + ", ".join(sorted(parts, key=lambda x: not x.startswith("Main"))))
        if time.time() - t0 >= timeout:
            left = ", ".join(flows[k][0] for k in flows if k not in done)
            if unreachable is not None:
                return verdict(2, f"WATCH UNKNOWN: Forgejo's runs could not be read for {red_for(iso_at(unreachable))} "
                                  f"({failures} failed reads, the last: {last_error}); {left} undecided after "
                                  f"{int(timeout // 60)} min; check `agentctl ci-why` later")
            return verdict(2, f"WATCH UNKNOWN: {left} undecided after {int(timeout // 60)} min; check `agentctl ci-why` "
                              "later")
        if unreachable is None:  # a failed read says nothing about the runs: no stall judged on it
            now_state = (tuple(sorted(done)), tuple(sorted(seen.items())))
            if now_state != state:
                state, changed = now_state, time.time()
            elif time.time() - changed >= stall:
                left = ", ".join(f"{flows[k][0]} {('run ' + str(v[0]) + ' ' + str(v[1])) if v else 'no run'}"
                                 for k, v in [(k, seen.get(k)) for k in flows if k not in done])
                return verdict(2, f"WATCH STALLED: no change in {left} for {int(stall // 60)} min; check `agentctl "
                                  "ci-why` later")
        restart_if_changed([own])
        time.sleep(next(err_delays) if unreachable is not None else next(delays))


def iso_at(t):
    return dt.datetime.fromtimestamp(t, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ---------------------------------------------------------------- waiting: production changes held while main is red
# The owner (2026-10-26): "when waiting for main to go green, merge all waiting changes into one waiting branch (always
# use the same name) and merge it when main is green". While the gate is red, `land` puts a production change onto the
# local branch `waiting` (worktree <main clone>-wt-waiting) instead of being refused: rebased onto it, the local checks
# run on the combined tip, `WAITING <sha> (n changes queued on waiting)`. One processor (`waiting run`, detached, locked)
# watches the gate; once main is green it rebuilds `waiting` on forgejo/main, runs the hook's dry run, pushes the whole
# branch in ONE push, deletes it, and every waiting `land` goes on to its LANDED and WATCH. Tools-only commits and
# Fixes-Red fixes never wait (the hook lets them land while red). Replaces the merge queue.
WAITING_BRANCH = "waiting"
WAITING_DIR = None  # a test's override; else waiting_dir(): under the state root, resolved at each use


def waiting_dir():
    return WAITING_DIR or state_root("waiting")
PRODUCTION_GLOBS = ("*/src/main/*", "conf/*", "*/conf/*", "build.sbt", "project/*", "infra/nix/*", "infra/kubernetes/*",
                    "Dockerfile")
WAITING_AWAIT_TIMEOUT = 24 * 3600
WAITING_POLL = 60          # the processor's gate poll floor (backs off to 300 s)
WAITING_HELP = """While main is red, a production change that passed its OWN checks (land runs them first, red or green) joins
ONE local branch, `waiting`, by cherry-pick (land: WAITING <sha> (entry <id>, n in batch), exit 0). At green the
processor rebuilds `waiting` on main, runs ONE fast check of the batch (pre-push --fast-only: compile and the fast tests,
a fresh sbt server, a stall retried once then HELD), pushes it in one push, bisects a failing batch by prefix and rejects
only the culprit. A Fixes-Red entry goes first. Every verdict (LANDED, NOT LANDED, HELD, each landed entry's detached
WATCH) goes to `agentctl inbox`.

  agentctl waiting status                       # the entries, the batch being checked, a HELD batch, the gate
  agentctl waiting cancel <id>                  # drop a change; `waiting` is rebuilt without it
  agentctl waiting pause|resume                 # stop / restart taking batches (joins still queue)
  agentctl waiting run [--once] [--service]     # the processor (land starts it detached; one at a time, by lock)
  agentctl waiting service install|uninstall|status   # it as the launchd agent net.bitcashier.agentctl-waiting"""


def is_production_path(p):
    """movies' pre-push is_production_path: what reaches a pod or a fleet host (the rest lands while red)."""
    return any(fnmatch.fnmatch(p, g) for g in PRODUCTION_GLOBS)


GATE_UNREAD = "unread"  # gate_reds' member when the gate could not be read: never green, and no Fixes-Red matches it
gate_unread_why = [""]


def gate_reds(repo):
    """The ids (run numbers and run ids) of the gating workflows' red runs on main; empty when green or not gated.
    When the gate cannot be read: {GATE_UNREAD}, which every caller takes as RED -- a production change waits, the
    processor takes no batch (the owner, 2026-10-27: an unread gate is never green; at 08:05Z a launchd processor with
    no Forgejo token read it as green, and the hook, with no token either, skipped its own gate: a push onto red #2047)."""
    try:
        o_r = slug(repo)
        if o_r not in GATING:
            return set()
        reds = set()
        for _name, decided, _newer, _streak in gate_runs(o_r):
            if decided and decided.get("conclusion") != "success":
                reds |= {str(decided.get("number")), str(decided.get("databaseId"))}
        gate_unread_why[0] = ""
        return reds
    except (Exception, SystemExit) as e:  # SystemExit: NoToken
        gate_unread_why[0] = str(e).replace("agentctl: ", "")[:200]
        err(f"could not read the gate ({gate_unread_why[0]}): taken as RED until it is read")
        return {GATE_UNREAD}


def waiting_supported(repo):
    """A repo hook, if any, must have --checks-only (its checks without the red gate) to check a waiting tip."""
    hook = precheck_hook(repo)
    if not hook:
        return True
    with open(hook) as f:
        return "--checks-only" in f.read()


def waiting_commits(repo, base, head):
    return git(repo, "rev-list", "--reverse", f"{base}..{head}").split()


def must_wait(repo, commits, reds):
    """A production commit with no Fixes-Red: naming a red run waits; tools-only and declared fixes go (the hook's rule)."""
    for c in commits:
        paths = git(repo, "diff-tree", "--no-commit-id", "--name-only", "-r", "--root", "-m", c).split("\n")
        if not any(p and is_production_path(p) for p in paths):
            continue
        fixes = git(repo, "log", "-1", "--format=%(trailers:key=Fixes-Red,valueonly,separator=%x2C)", c).strip()
        if not ({f.strip().lstrip("#") for f in fixes.split(",") if f.strip()} & reds):
            return True
    return False


def waiting_state(repo):
    common = os.path.realpath(git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir").strip())
    d = os.path.join(waiting_dir(), re.sub(r"[^A-Za-z0-9._-]", "_", common.strip("/")))
    os.makedirs(os.path.join(d, "entries"), exist_ok=True)
    clone = os.path.dirname(common) if os.path.basename(common) == ".git" else common
    return d, clone, f"{clone}-wt-waiting"


def waiting_entries(d, open_only=True):
    out = []
    for p in sorted(glob.glob(os.path.join(d, "entries", "*.json"))):
        try:
            with open(p) as f:
                e = json.load(f)
        except (OSError, ValueError):
            continue
        if not open_only or e.get("status") == "waiting":
            out.append(e)
    return sorted(out, key=lambda e: e["seq"])


def save_entry(d, e):
    p = os.path.join(d, "entries", f"{e['id']}.json")
    with open(p + ".tmp", "w") as f:
        json.dump(e, f, indent=1)
    os.replace(p + ".tmp", p)


def wlog(d, msg):
    with open(os.path.join(d, "processor.log"), "a") as f:
        f.write(f"{ts()} {msg}\n")


def ensure_waiting_tree(repo, wt):
    if not os.path.isdir(wt):
        git(repo, "worktree", "prune", check=False)  # a removed tree's stale registration refuses the add (audit #9)
        if git_ok(repo, "rev-parse", "--verify", "-q", f"refs/heads/{WAITING_BRANCH}"):
            git(repo, "worktree", "add", "-q", mark_internal(wt), WAITING_BRANCH)
        else:
            git(repo, "worktree", "add", "-q", "-b", WAITING_BRANCH, mark_internal(wt), f"{REMOTE}/main")
    return wt


def drop_waiting_tree(repo, wt):
    if os.path.isdir(wt):
        git(repo, "worktree", "remove", "--force", wt, check=False)
    git(repo, "worktree", "prune", check=False)
    git(repo, "branch", "-D", WAITING_BRANCH, check=False)


# NEVER AN EMPTY COMMIT (2026-10-27). An agent queued a commit, queued it again, and both entries ran: the later one's
# commit had already landed through the earlier one, its rebase (a cherry-pick with --keep-redundant-commits) left an
# EMPTY commit, and that was pushed -- four times on movies main (317fba9b3, 1fddd8951, 1d554f051, 693e1be78/82f4d9f55).
# Now every rebuild of an entry drops a commit that is patch-equivalent to its new base, or empty after the pick; an
# entry left with nothing is LANDED (already on main via <commit>); re-queueing supersedes the older entry; and the
# squash guard refuses any push carrying an empty commit unless it is a deliberate one with an `Allow-Empty:` trailer.
ALLOW_EMPTY_TRAILER = "Allow-Empty"


def deliberate_empty(repo, c):
    """A commit made empty on purpose: `git commit --allow-empty` with an `Allow-Empty: <why>` trailer."""
    return bool(git(repo, "log", "-1", f"--format=%(trailers:key={ALLOW_EMPTY_TRAILER},valueonly)", c,
                    check=False).stdout.strip())


def is_empty_commit(repo, c):
    """A non-merge commit whose tree is its parent's (a root commit is never empty here)."""
    parents = git(repo, "rev-list", "--parents", "-n", "1", c).split()[1:]
    if len(parents) != 1:
        return False
    return git(repo, "rev-parse", f"{c}^{{tree}}").strip() == git(repo, "rev-parse", f"{parents[0]}^{{tree}}").strip()


def patch_id(repo, c):
    diff = git(repo, "show", "--format=", "--no-color", "--no-ext-diff", c, check=False).stdout
    if not diff.strip():
        return None
    r = subprocess.run(["git", "patch-id", "--stable"], cwd=repo, input=diff, capture_output=True, text=True)
    return (r.stdout.split() or [None])[0]


def equivalent_on(repo, c, upstream, limit=400):
    """The commit of `upstream` (since its merge-base with c) that carries c's patch, or None (`git cherry`'s test,
    naming the commit)."""
    pid = patch_id(repo, c)
    if not pid:
        return None
    mb = git(repo, "merge-base", c, upstream, check=False).stdout.strip()
    rng = f"{mb}..{upstream}" if mb else upstream
    for u in git(repo, "rev-list", "--no-merges", "-n", str(limit), rng, check=False).stdout.split():
        if patch_id(repo, u) == pid:
            return u
    return None


def pick(wt, commits, dropped=None):
    """Cherry-pick commits onto wt's HEAD, one at a time: None, or the conflicting files (the pick aborted, HEAD back
    where it was). A commit already in HEAD's history (patch-equivalent), or empty once picked, is DROPPED, never kept
    as an empty commit: appended to `dropped` as (commit, the commit of HEAD carrying it, or None). A deliberate empty
    commit (an Allow-Empty: trailer) is kept."""
    start = git(wt, "rev-parse", "HEAD").strip()
    for c in commits:
        before = git(wt, "rev-parse", "HEAD").strip()
        r = git(wt, "cherry-pick", "--allow-empty", "--keep-redundant-commits", c, check=False)
        if r.returncode != 0:
            files = git(wt, "diff", "--name-only", "--diff-filter=U", check=False).stdout.split()
            git(wt, "cherry-pick", "--abort", check=False)
            via = equivalent_on(wt, c, before) if files else None
            if via:  # its patch is already there, and a later change to the same lines conflicts with it again
                git(wt, "reset", "--hard", "-q", before)
                if dropped is not None:
                    dropped.append((c, via))
                continue
            git(wt, "reset", "--hard", "-q", start)
            return files or [r.stderr.strip()[:200]]
        if is_empty_commit(wt, "HEAD") and not deliberate_empty(wt, c):
            git(wt, "reset", "--hard", "-q", before)
            if dropped is not None:
                dropped.append((c, equivalent_on(wt, c, before)))
    return None


def apply_entry(d, wt, e, base):
    """Pick the entry's commits onto wt's HEAD (base, or base plus earlier entries): ('ok', None), ('conflict', files),
    ('landed', via) or ('duplicate', via). A commit already on MAIN (base's history) is dropped from the entry for good
    (a partly landed entry keeps only the rest); one only an earlier entry carries is left out of this build alone (that
    entry may still be rejected). Nothing left of it on main: 'landed' -- the caller says LANDED, never pushes empty."""
    first = git(wt, "rev-parse", "HEAD").strip() == base
    dropped = []
    conflict = pick(wt, e["commits"], dropped)
    if conflict:
        return "conflict", conflict
    if not dropped:
        return "ok", None
    on_main = [(c, v) for c, v in dropped
               if (v and git(wt, "merge-base", "--is-ancestor", v, base, check=False).returncode == 0) or (not v and first)]
    if on_main:
        gone = {c for c, _v in on_main}
        e["commits"] = [c for c in e["commits"] if c not in gone]
        e.setdefault("dropped", []).extend([[c, v] for c, v in on_main])
        save_entry(d, e)
        wlog(d, f"{e['id']}: {len(on_main)} commit(s) already on {REMOTE}/main, dropped: "
                + ", ".join(f"{c[:10]} (via {v[:10] if v else 'an empty pick'})" for c, v in on_main))
        if not e["commits"]:
            return "landed", next((v for _c, v in reversed(on_main) if v), None)
    if not [c for c in e["commits"] if c not in {x for x, _v in dropped}]:  # all of it is on an earlier entry
        return "duplicate", next((v for _c, v in reversed(dropped) if v), None)
    return "ok", None


def already_landed(d, e, via):
    """Every commit of the entry is on main already (an earlier entry, or someone, landed it): LANDED, nothing pushed."""
    queue_verdict(d, e, "landed", f"LANDED {e['head']} (already on main via {via or 'an equivalent commit'}): "
                                  "nothing left to push", code=0, landed_sha=via, already=True)


def supersede(d, e, by, why):
    """The entry gives way to `by` (a newer entry of the same worktree and branch, or one carrying the same change): its
    checker, if running, is stopped; said in the inbox."""
    e.update(status="superseded", superseded_by=by, why=why, decided=ts())
    save_entry(d, e)
    cancel_entry_remote(e, f"its queue entry was superseded by {by}")
    h = read_record(entry_owned(e["id"]).record) or {}
    if lock_held(entry_owned(e["id"]).lockpath) and h.get("pid") and int(h["pid"]) != os.getpid():
        try:
            os.kill(int(h["pid"]), signal.SIGTERM)  # its checker: its CI run is cancelled with it
        except OSError:
            pass
    line = f"SUPERSEDED {e['id']} by {by}: {why}"
    wlog(d, line)
    inbox_write("land", line, [line], [], 0, cwd=e["worktree"])


def run_hook(wt, mode, base):
    """(ok, output) of the checkout's scripts/hooks/pre-push <mode> base..HEAD; (True, '') when the repo has no hook."""
    hook = precheck_hook(wt)
    if not hook:
        return True, ""
    with open(hook) as f:
        has_checks_only = "--checks-only" in f.read()
    if mode == "--checks-only" and not has_checks_only:
        return False, ("scripts/hooks/pre-push has no --checks-only mode (the checks without the red gate) at this base: "
                       "the waiting branch needs the hook from movies' 'waiting' change")
    head = git(wt, "rev-parse", "HEAD").strip()
    lock_note(f"{mode} checks on `{WAITING_BRANCH}`")
    rc, out = run_watched([hook, mode, f"{base}..{head}"], wt, tool_env(), os.path.join(scratch(), f"agentctl-waiting-{os.getpid()}"),
                          "waiting-checks")
    if rc is None:
        mins = float(os.environ.get("AGENTCTL_LAND_STALL_MIN", LAND_STALL_MIN))
        return False, f"{out}\nstalled: scripts/hooks/pre-push {mode}: no output and no CPU for {mins:g} min, so it was ended"
    return rc == 0, out


def tail_of(out, n=25):
    return "\n  ".join([l for l in out.splitlines() if l.strip()][-n:])


def batching(repo):
    """Whether land batches here (every change joins `waiting`): a repo hook with --checks-only (movies)."""
    hook = precheck_hook(repo)
    return bool(hook) and waiting_supported(repo)


def fixes_of(repo, commits):
    """The run ids/numbers the commits' Fixes-Red: trailers name."""
    out = set()
    for c in commits:
        v = git(repo, "log", "-1", "--format=%(trailers:key=Fixes-Red,valueonly,separator=%x2C)", c).strip()
        out |= {f.strip().lstrip("#") for f in v.split(",") if f.strip()}
    return out


def batch_order(repo, entries, reds):
    """The order a batch is built in: a fix for the current red first, then (main red) what may land while red -- tools
    only, or every commit carrying a Fixes-Red for a red run -- then the rest; by join order within each."""
    def rank(e):
        if reds and set(e.get("fixes") or []) & reds:
            return 0
        if reds and not must_wait(repo, e["commits"], reds):
            return 1
        return 2
    return sorted(entries, key=lambda e: (rank(e), e["seq"]))


def join(repo, main_ref, sh, log_path, a, head=None, worktree=None, branch=None):
    """Under the landing lock, in seconds: the change (its own checks passed) joins `waiting`, rebuilt on forgejo/main.
    Rejected only on a cherry-pick conflict. Prints `WAITING <tip> (entry <id>, n in batch)`, starts the processor."""
    lock_note("join `waiting`")
    if head is None:
        rc, head = sync(repo, main_ref, sh)
        if rc is not None:
            return rc
    d, _clone, wt = waiting_state(repo)
    commits = waiting_commits(repo, f"{REMOTE}/main", head)
    reds = gate_reds(repo)
    ensure_waiting_tree(repo, wt)
    base = git(repo, "rev-parse", main_ref).strip()
    branch = branch_of(repo) if branch is None else branch
    seq_lock = open(os.path.join(d, "seq.lock"), "a+")  # a seq of its own, beside a land queueing meanwhile
    fcntl.flock(seq_lock, fcntl.LOCK_EX)
    seq = max([e["seq"] for e in waiting_entries(d, open_only=False)] + [0]) + 1
    eid = f"{dt.datetime.now().strftime('%Y%m%d-%H%M%S')}-{os.path.basename(worktree or repo)}-{seq}"
    for old in waiting_entries(d):  # joining again replaces this worktree and branch's older waiting entry
        if same_change_source(old, worktree or repo, branch):
            supersede(d, old, eid, f"{worktree or repo} joined `{WAITING_BRANCH}` again; only the newest entry lands")
    seq_lock.close()
    kept = rebuild(repo, d, wt, batch_order(repo, waiting_entries(d), reds), base)
    before = git(wt, "rev-parse", "HEAD").strip()
    dropped = []
    conflict = pick(wt, commits, dropped)
    if conflict:
        git(wt, "reset", "--hard", "-q", before)
        print(f"NOT LANDED: the change conflicts with the changes already on `{WAITING_BRANCH}` (rebuilt on {REMOTE}/main "
              f"{base[:10]}) in: {', '.join(conflict)}. Rebase onto them (git rebase {WAITING_BRANCH}) or wait for them "
              f"to land.")
        return 1
    if commits and len(dropped) == len(commits):  # the very same change already waits: no empty entry of its own
        via = next((v for _c, v in reversed(dropped) if v), None)
        owner = next((x for x in kept if via and x.get("tip") and git(
            wt, "merge-base", "--is-ancestor", via, x["tip"], check=False).returncode == 0), None)
        if owner:
            print(f"WAITING {owner['tip']} (entry {owner['id']}: the same change already waits; nothing new joined)",
                  flush=True)
            a.waiting = owner
            spawn_waiting_processor(repo)
            return 0
    e = {"id": eid, "seq": seq, "worktree": worktree or repo, "branch": branch, "head": head, "commits": commits,
         "fixes": sorted(fixes_of(repo, commits)), "status": "waiting", "created": ts(),
         "tip": git(wt, "rev-parse", "HEAD").strip(), "follow": bool(getattr(a, "follow", False))}
    save_entry(d, e)
    if reds and set(e["fixes"]) & reds:  # a fix goes FIRST: the branch is rebuilt in batch order with it
        rebuild(repo, d, wt, batch_order(repo, waiting_entries(d), reds), base)
        e = next(x for x in waiting_entries(d) if x["id"] == e["id"])
    n = len(waiting_entries(d))
    with open(log_path, "a") as f:
        f.write(f"=== joined {ts()} {head} as {e['id']} ({n} on {WAITING_BRANCH})\n")
    print(f"WAITING {e['tip']} (entry {e['id']}, {n} in batch)", flush=True)
    a.waiting = e
    spawn_waiting_processor(repo)
    offer_token(repo)
    return 0


# ---------------------------------------------------------------- the land queue: agents never wait on a land
# The owner (2026-10-27): "agents never wait on a land". `land` rebases the change onto forgejo/main, runs the squash
# guard, enqueues it and returns at once: `QUEUED <id> (<sha>)`. The always-on `waiting` processor (launchd
# net.bitcashier.agentctl-waiting) runs each queued change's checks in a CHECK TREE of its own (a pool of detached
# worktrees <clone>-wt-check-<n>, kept warm between checks, seeded from the shared build cache when cold), admitted by
# the governor (a check; red for a Fixes-Red fix of a red run, which goes first) -- or on ci-runner's check tier when the
# governor reports pressure (see "remote checks") -- then, under the landing lock: main green (or a change that may land
# while red), the checked tip is pushed (`LANDED`, and a detached watch); main red, it joins `waiting` (`WAITING`). Main
# moved meanwhile: rebased in the tree and checked again. Every verdict goes to the inbox with the agent's worktree.
# `land --follow` keeps the old in-process land (checks, push, watch) for scripts and red fixers.
QUEUE_POOL = 3          # check trees, so at most this many queued changes are checked at once ($AGENTCTL_CHECK_TREES)
# A check the LAPTOP failed, not the change: sbt's server never came up or was lost, a script test cut off by its
# time bound, a stall. Queued again after QUEUE_INFRA_DELAY, at most QUEUE_INFRA_RETRIES times, then judged as it is.
INFRA_CHECK_FAILURE = re.compile(r"failed to connect to server|sbt server did not start within \d+ seconds|"
                                 r"sbt server disconnected|^TIMEOUT +\d+s|STALLED:", re.M)
QUEUE_INFRA_RETRIES = 3
QUEUE_INFRA_DELAY = 300
# A PUSH, FETCH OR TUNNEL BLIP IS NO VERDICT ON THE CHANGE (audit #6, 2026-10-28: entry 67 "the push failed (pre-push
# hook or remote)" was a tunnel error in its tail; a fixer GAVE UP on it): such a failure, a stalled push, a lock that
# never came free and main moving under every round re-queue the entry (retry_after, at most QUEUE_INFRA_RETRIES),
# its `attempts` reset (a checker restart after an infra re-queue is no failure of the change).
TRANSIENT_PUSH = re.compile(r"Connection (reset|refused|timed out|closed)|closed by remote host|Could not resolve host|ssh: connect to host|"
                            r"kex_exchange_identification|[Bb]roken pipe|early EOF|remote end hung up|RPC failed|"
                            r"unable to access|HTTP (502|503|504)|timed out|Operation timed out|tunnel", re.I)
SLOT_WAIT_MAX = 2 * 3600  # a checker waits this long for a check tree, then the entry is re-queued


def requeue_infra(d, e, why, delay=None):
    """Back to queued for a later look (not NOT LANDED): (True) when retries are left, else False."""
    if e.get("infra_retries", 0) >= QUEUE_INFRA_RETRIES:
        return False
    e["infra_retries"] = e.get("infra_retries", 0) + 1
    e.update(status="queued", retry_after=time.time() + (QUEUE_INFRA_DELAY if delay is None else delay), why=f"infra: {why}",
             attempts=0, waiting_on=None)
    save_entry(d, e)
    wlog(d, f"{e['id']}: {why}: queued again in {int((QUEUE_INFRA_DELAY if delay is None else delay) // 60)} min "
            f"(retry {e['infra_retries']}/{QUEUE_INFRA_RETRIES})")
    return True
QUEUE_ROUNDS = 3        # checked again while main moves under the checks; the last round pushes, its hook checking
# Main moved between a change's check and its push: re-checked only when what landed meanwhile can change the verdict
# (the owner, 2026-10-27: memo-key -41 passed runs 3341 and 3350, then main moved and it was checked a third time) --
# a path both touch, an sbt module one touches that the other's module is (or depends on: the hook's own compile plan,
# `pre-push --compile-plan`, build.sbt's dependsOn), or the build or the hook itself. Otherwise rebased and pushed with
# the change's checks skipped at the push (PREPUSH_SKIP: the hook's own plan for its paths; the red gate still runs);
# main's CI tests the combination. A rebase conflict is NOT LANDED, as ever.
RECHECK_ALWAYS = re.compile(r"^(build\.sbt|project/.*|scripts/hooks/.*|scripts/hooks-path\.sh|scripts/tool-conventions\.sh)$")


def range_paths(cwd, a, b):
    """The paths a..b changes (both sides of a rename)."""
    return [p for p in git(cwd, "diff", "--name-only", "--no-renames", a, b).splitlines() if p]


def hook_query(hook, tree, flag, paths):
    """The hook's dry-run answer for paths on stdin (`--plan`, `--compile-plan`), as words; None when unreadable."""
    try:
        r = subprocess.run([hook, flag], cwd=tree, input="".join(f"{p}\n" for p in paths), capture_output=True,
                           text=True, timeout=120, env=tool_env())
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout.split() if r.returncode == 0 else None


def sbt_modules(hook, tree, paths):
    """[(module, {module and its dependents})] per path that compiles into one, from the hook's compile plan (its first
    task is the path's own module); None when the plan cannot be read. The plan reads a path's directory and extension
    only, so one query per (directory, extension)."""
    reps = {}
    for p in paths:
        reps.setdefault((os.path.dirname(p), os.path.splitext(p)[1]), p)
    out = []
    for p in reps.values():
        tasks = hook_query(hook, tree, "--compile-plan", [p])
        if tasks is None:
            return None
        mods = [t.split("/", 1)[0] for t in tasks]
        if mods:
            out.append((mods[0], set(mods)))
    return out


def recheck_reason(hook, tree, base, moved, change_paths):
    """(commits main moved by, why the change must be checked again or None)."""
    n = len(git(tree, "rev-list", f"{base}..{moved}", check=False).stdout.split())
    landed_paths = range_paths(tree, base, moved)
    build = sorted(p for p in landed_paths if RECHECK_ALWAYS.match(p))
    if build:
        return n, f"they change {build[0]}"
    same = sorted(set(landed_paths) & set(change_paths))
    if same:
        return n, f"both touch {same[0]}" + (f" (+{len(same) - 1} more)" if len(same) > 1 else "")
    if not hook:
        return n, None
    mine, theirs = sbt_modules(hook, tree, change_paths), sbt_modules(hook, tree, landed_paths)
    if mine is None or theirs is None:
        return n, "the hook's compile plan could not be read"
    for m, m_deps in mine:
        for t, t_deps in theirs:
            if m in t_deps or t in m_deps:
                return n, f"sbt modules overlap ({m} and {t})"
    return n, None


def branch_of(wt):
    """The worktree's checked-out branch ('' when detached or gone)."""
    if not os.path.isdir(wt or ""):
        return ""
    return git(wt, "symbolic-ref", "--short", "-q", "HEAD", check=False).stdout.strip()


def same_change_source(e, worktree, branch):
    """Whether entry e came from this worktree and branch (an entry from before branches were recorded: the worktree)."""
    if os.path.realpath(e.get("worktree") or "") != os.path.realpath(worktree or ""):
        return False
    return not e.get("branch") or not branch or e["branch"] == branch


def queued_entries(d):
    return [e for e in waiting_entries(d, open_only=False) if e.get("status") in ("queued", "checking")]


def queue_mode(repo, a):
    """Whether land queues (QUEUED, returning at once): a repo whose hook can check a change apart (movies), unless
    --follow / --no-watch (scripts), a dispatched red fixer (its wrapper reads LANDED), or AGENTCTL_QUEUE=0."""
    if getattr(a, "follow", False) or getattr(a, "no_watch", False) or os.environ.get("AGENTCTL_RED_FIXER"):
        return False
    return os.environ.get("AGENTCTL_QUEUE", "1") != "0" and batching(repo)


def enqueue(repo, main_ref, sh, a):
    """Rebase, squash guard, then the change becomes a queued entry: prints QUEUED and starts the processor."""
    rc, head = sync(repo, main_ref, sh)
    if rc is not None:
        return rc
    d, _clone, _wt = waiting_state(repo)
    commits = waiting_commits(repo, f"{REMOTE}/main", head)
    with open(os.path.join(d, "seq.lock"), "a+") as seq_lock:  # a unique seq; never the landing lock (a push holds it)
        fcntl.flock(seq_lock, fcntl.LOCK_EX)
        seq = max([e["seq"] for e in waiting_entries(d, open_only=False)] + [0]) + 1
        e = {"id": f"{dt.datetime.now().strftime('%Y%m%d-%H%M%S')}-{os.path.basename(repo)}-{seq}", "seq": seq,
             "worktree": repo, "branch": branch_of(repo), "head": head, "commits": commits,
             "fixes": sorted(fixes_of(repo, commits)),
             "status": "queued", "created": ts(), "keep_worktree": bool(getattr(a, "keep_worktree", False)),
             "claude_pid": int(os.environ["CLAUDE_PID"]) if (os.environ.get("CLAUDE_PID") or "").isdigit() else None,
             "session": os.environ.get("CLAUDE_CODE_SESSION_ID") or None,
             "base": git(repo, "rev-parse", main_ref).strip()}
        save_entry(d, e)
        for old in queued_entries(d):  # RE-QUEUEING REPLACES: only the newest entry per worktree and branch runs
            if old["id"] != e["id"] and same_change_source(old, repo, e["branch"]):
                supersede(d, old, e["id"], f"{repo} queued again ({head[:10]}); only the newest entry runs")
    ahead = len(queued_entries(d)) - 1
    print(f"QUEUED {e['id']} ({head[:10]}{f', {ahead} ahead' if ahead > 0 else ''}): its checks run in the background; "
          "LANDED / WAITING / NOT LANDED goes to `agentctl inbox`", flush=True)
    spawn_waiting_processor(repo)
    offer_token(repo)
    return 0


def check_tree_slot(repo, d):
    """(index, open lock file) of a free check tree slot, or None when all QUEUE_POOL are busy."""
    n = int(env_num("AGENTCTL_CHECK_TREES", QUEUE_POOL))
    for i in range(1, n + 1):
        f = open(os.path.join(d, f"check-tree-{i}.lock"), "a+")
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return i, f
        except BlockingIOError:
            f.close()
    return None


def check_tree(repo, i, sha):
    """The detached worktree <clone>-wt-check-<i> at sha (kept between checks: its build stays warm)."""
    _d, clone, _w = waiting_state(repo)
    tree = mark_internal(f"{clone}-wt-check-{i}")
    if not os.path.isdir(tree):
        git(repo, "worktree", "prune", check=False)
        git(repo, "worktree", "add", "-q", "--detach", mark_internal(tree), sha)
        seed = os.path.join(tree, "scripts", "sbt-warm")
        if os.access(seed, os.X_OK):  # a cold tree's first compile seeded from the shared build cache, not from scratch
            try:
                subprocess.run([seed, "--seed"], cwd=tree, capture_output=True, text=True, timeout=600, env=tool_env())
            except subprocess.TimeoutExpired:
                err(f"sbt-warm --seed in {tree} took over 10 min")
    else:
        git(tree, "reset", "-q", "--hard", check=False)
        git(tree, "clean", "-qfd", "-e", "target/", check=False)
        git(tree, "checkout", "-q", "--force", "--detach", sha)
    return tree


def entry_owned(eid):
    return Owned("check", eid, ["waiting", "check", eid])


def spawn_checks(repo, d):
    """Start a checker (`agentctl waiting check <id>`, detached, owned per entry) for each queued entry, oldest first,
    while check trees are free; red fixes first."""
    try:
        reds = gate_reds(repo)
    except Exception:
        reds = set()
    todo = sorted([e for e in waiting_entries(d, open_only=False) if e.get("status") in ("queued", "checking")],
                  key=lambda e: (0 if reds and set(e.get("fixes") or []) & reds else 1, e["seq"]))
    newest = {}
    for e in sorted(todo, key=lambda e: e["seq"]):  # entries queued before re-queueing replaced: the newest one runs
        for k, older in list(newest.items()):
            if same_change_source(older, e["worktree"], e.get("branch") or ""):
                supersede(d, older, e["id"], f"{e['worktree']} queued again; only the newest entry runs")
                del newest[k]
        newest[e["id"]] = e
    todo = [e for e in todo if e["id"] in newest]
    started = 0
    for e in todo:
        if lock_held(entry_owned(e["id"]).lockpath) or e.get("retry_after", 0) > time.time():
            continue
        slot = check_tree_slot(repo, d)
        if not slot:
            break
        slot[1].close()  # the checker takes it again itself
        with open(os.path.join(d, "processor.log"), "a") as logf:
            subprocess.Popen([sys.executable, os.path.realpath(__file__), "waiting", "check", e["id"], "--repo", repo],
                             stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, start_new_session=True, cwd=repo,
                             env=detached_env(repo))
        started += 1
        time.sleep(1)  # it takes its tree slot before the next looks
    return started


def queue_verdict(d, e, status, verdict, tail=(), code=1, **fields):
    e.update(status=status, decided=ts(), why=verdict, **fields)
    save_entry(d, e)
    wlog(d, f"{e['id']}: {verdict.splitlines()[0]}")
    if status == "rejected" and verdict.startswith("NOT LANDED"):  # infra: a condition that lands it again
        land_not_landed(verdict, e["worktree"], tail, code)
    else:
        inbox_write("land", verdict.splitlines()[0], [verdict.splitlines()[0]], list(tail)[-25:], code, cwd=e["worktree"])


def rebase_in_tree(d, tree, e, base):
    """The entry's commits on base, in the tree: (head, None); (None, None) on a conflict (aborted); (None, via) when
    every commit is on base already (dropped: LANDED via that commit, never an empty push)."""
    git(tree, "checkout", "-q", "--force", "--detach", base)
    how, x = apply_entry(d, tree, e, base)
    if how == "conflict":
        return None, None
    if how in ("landed", "duplicate"):
        return None, x or "an equivalent commit"
    return git(tree, "rev-parse", "HEAD").strip(), None


def check_entry(repo, eid):
    """One queued change: its checks in a check tree within the governor's budget (or on ci-runner under pressure),
    then pushed (green), joined to `waiting` (red) or rejected. Owned per entry."""
    d, _c, _w = waiting_state(repo)
    own = entry_owned(eid)
    if not own.acquire():
        return 0
    try:
        p = os.path.join(d, "entries", f"{eid}.json")
        e = read_record(p)
        if not e or e.get("status") not in ("queued", "checking"):
            return 0
        rem = e.get("remote") or {}
        if rem.get("run") is not None and not rem.get("collected_at") and e.get("adoptions", 0) < 10:
            e["adoptions"] = e.get("adoptions", 0) + 1  # a replacement that adopts the entry's remote run: not a retry
        else:
            e["attempts"] = e.get("attempts", 0) + 1
        if e.get("attempts", 0) > 3:  # its checkers died three times (killed, crashed): said, not tried forever
            queue_verdict(d, e, "rejected", f"NOT LANDED: the checker of {eid} ended without a verdict 3 times; land again")
            return 1
        e["waiting_on"] = "a check tree slot"
        save_entry(d, e)
        slot, t_slot = None, time.time()
        while not slot:
            slot = check_tree_slot(repo, d)
            if not slot:
                if time.time() - t_slot > env_num("AGENTCTL_SLOT_WAIT_MAX", SLOT_WAIT_MAX):  # bounded (audit #12)
                    if not requeue_infra(d, e, f"no check tree free for {int((time.time() - t_slot) // 60)} min"):
                        queue_verdict(d, e, "rejected", f"NOT LANDED: no check tree came free for {eid} in "
                                      f"{QUEUE_INFRA_RETRIES + 1} tries (the laptop's check trees are all busy)")
                    return 0
                time.sleep(10)
        e["waiting_on"] = None
        i, slot_f = slot
        try:
            return _check_entry(repo, d, e, i, own)
        finally:
            slot_f.close()
    finally:
        own.release()


def _check_entry(repo, d, e, i, own=None):
    hook = precheck_hook(repo)
    log_path = os.path.join(d, f"check-{e['id']}")
    if e.get("status") != "checking" or not e.get("since"):
        e["since"] = ts()
    e["status"] = "checking"
    save_entry(d, e)
    for round_ in range(QUEUE_ROUNDS):
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
        base = git(repo, "rev-parse", f"{REMOTE}/main").strip()
        rem = e.get("remote") or {}
        adopt = (rem.get("head") == e["head"] and rem.get("base") == base and not rem.get("collected_at")
                 and rem.get("status") not in ("cancelled", "skipped", "abandoned")
                 and git_ok(repo, "cat-file", "-e", f"{rem.get('tip')}^{{commit}}"))
        if adopt:  # a replacement checker (the last one died, was stopped or re-exec'd mid-wait): the same tip, its run
            tree = check_tree(repo, i, rem["tip"])
            head, via = rem["tip"], None
        else:
            if rem.get("run") is not None and not rem.get("status"):
                cancel_entry_remote(e, "superseded by a new round of its checks")
            e.pop("remote", None)
            e.pop("remote_run", None)
            e["round_since"] = ts()
            save_entry(d, e)
            tree = check_tree(repo, i, base)
            head, via = rebase_in_tree(d, tree, e, base)
        if via:
            already_landed(d, e, via if via != "an equivalent commit" else None)
            return 0
        if not head and not git_ok(repo, "rev-parse", "--verify", "-q", f"{REMOTE}/main"):
            if requeue_infra(d, e, "its fetch of main failed"):
                return 0
        if not head:
            queue_verdict(d, e, "rejected", f"NOT LANDED: the change no longer applies on {REMOTE}/main {base[:10]} "
                          f"(main moved since QUEUED): rebase onto forgejo/main and land again")
            return 1
        e["tip"] = head
        save_entry(d, e)
        lock_note(f"queued {e['id']}: checks of {head[:10]}")
        reds = gate_reds(repo) if waiting_supported(repo) else set()
        commits = waiting_commits(tree, base, head)
        joining = bool(reds) and must_wait(repo, commits, reds)
        cls = gov_class_of(repo, commits, reds)
        mode = "--checks-only" if joining else "--range"
        where = "no hook"
        if hook:
            ok, out, where = run_entry_checks(repo, d, e, tree, base, head, mode, cls, log_path, own)
            if ok is None:
                queue_verdict(d, e, "rejected", f"NOT LANDED: stalled checks ({where}): no output and no CPU for "
                              f"{env_num('AGENTCTL_LAND_STALL_MIN', LAND_STALL_MIN):g} min", (out or "").splitlines())
                return 1
            if not ok and INFRA_CHECK_FAILURE.search(out or "") and e.get("infra_retries", 0) < QUEUE_INFRA_RETRIES:
                # the laptop failed the checks, not the change (an sbt server that never came up under load, a script
                # test cut off by its bound): queued again for a later look, not NOT LANDED (2026-10-27, load ~250)
                e["infra_retries"] = e.get("infra_retries", 0) + 1
                e.update(status="queued", retry_after=time.time() + QUEUE_INFRA_DELAY, attempts=0,
                         why=f"infra: {INFRA_CHECK_FAILURE.search(out).group(0)}")
                save_entry(d, e)
                wlog(d, f"{e['id']}: its checks failed on the laptop, not on the change ({e['why']}): queued again "
                        f"in {QUEUE_INFRA_DELAY // 60} min (retry {e['infra_retries']}/{QUEUE_INFRA_RETRIES})")
                return 0
            if not ok:
                queue_verdict(d, e, "rejected", f"NOT LANDED: the pre-push checks failed ({where}); the change "
                              f"{e['head'][:10]} stays in {e['worktree']}", (out or "").splitlines())
                return 1
        with land_lock(repo) as held:
            if not held:
                continue
            now_ = read_record(os.path.join(d, "entries", f"{e['id']}.json")) or {}
            if now_.get("status") not in ("queued", "checking"):  # superseded / cancelled during its checks: no push
                wlog(d, f"{e['id']}: {now_.get('status')} during its checks: not pushed")
                return 0
            git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
            moved = git(repo, "rev-parse", f"{REMOTE}/main").strip()
            skip = None
            if moved != base:
                # rebased under the lock; then re-checked only when what landed meanwhile overlaps (RECHECK_ALWAYS)
                new_head, via = rebase_in_tree(d, tree, e, moved)
                if via:
                    already_landed(d, e, via if via != "an equivalent commit" else None)
                    return 0
                if not new_head:
                    queue_verdict(d, e, "rejected", f"NOT LANDED: the change no longer applies on {REMOTE}/main "
                                  f"{moved[:10]} (main moved during its checks): rebase onto forgejo/main and land again")
                    return 1
                tree_hook = precheck_hook(tree) if hook else None
                mine = range_paths(tree, moved, new_head)
                n, why = recheck_reason(tree_hook, tree, base, moved, mine)
                if why is None and tree_hook:
                    skip = hook_query(tree_hook, tree, "--plan", mine)
                    if skip is None:
                        why = "the hook's plan could not be read"
                moved_by = f"main moved by {n} commit{'' if n == 1 else 's'}"
                if why is None:
                    note = f"{moved_by}, no overlap: pushed without re-check"
                    wlog(d, f"{e['id']}: {note}")
                    where = f"{where}; {note}"
                elif round_ < QUEUE_ROUNDS - 1:
                    wlog(d, f"{e['id']}: {moved_by} during its checks, {why}: rebased and checked again")
                    continue
                else:
                    # the last round: pushed as rebased under the lock, so the push's hook runs the checks on the new
                    # base here (as land's last round did): a busy main never starves a change
                    where = f"by the push's hook, under the landing lock ({moved_by}, {why})"
                e.pop("remote_run", None)
                base, head, e["tip"] = moved, new_head, new_head
                commits = waiting_commits(tree, base, head)
            reds = gate_reds(repo) if waiting_supported(repo) else set()
            if reds and must_wait(repo, commits, reds):
                return queue_join(repo, d, e, tree, head)
            fixes = sorted(fixes_of(repo, commits))
            pushed_at = time.time()
            env = tool_env()
            if e.get("remote_run"):  # the hook takes ci-runner's pass once Forgejo confirms it (remote checks)
                env["PREPUSH_REMOTE_RUN"] = str(e["remote_run"])
            if skip:  # checked on the old base, no overlap with what landed since: the hook judges the red gate only
                env["PREPUSH_SKIP"] = " ".join(skip)
            rc, out = run_watched(push_argv(REMOTE, head), tree, env, log_path, "push", **push_bounds())
            if rc == 0:
                mark_gate_dirty()
            if rc == 0:
                git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
                if landed(repo, head, f"refs/remotes/{REMOTE}/main"):
                    queue_verdict(d, e, "landed", f"LANDED {head} (queued {e['id']}, checked {where})", code=0,
                                  landed_sha=head, pushed_at=pushed_at)
                    close = None if e.get("keep_worktree") else e["worktree"]
                    spawn_watch_of(e["worktree"] if os.path.isdir(e["worktree"]) else repo, head, pushed_at,
                                   close=close if close and os.path.isdir(close) else None, fixes=fixes)
                    return 0
            if rc is not None and RACE.search(out or ""):
                continue
            if rc is not None and REDGATE.search(out or ""):
                continue  # red now: the next round joins `waiting`
            blip = "the push stalled" if rc is None else (TRANSIENT_PUSH.search(out or "") or [None])[0]
            if blip and requeue_infra(d, e, f"the push failed on infra ({blip})"):
                return 0
            queue_verdict(d, e, "rejected", "NOT LANDED: the push failed (pre-push hook or remote)"
                          + (f": {blip}" if blip else ""), (out or "").splitlines())
            return 1
    if requeue_infra(d, e, f"main moved (or the landing lock stayed busy) under {QUEUE_ROUNDS} rounds of its checks"):
        return 0
    queue_verdict(d, e, "rejected", f"NOT LANDED: main moved under the checks {QUEUE_ROUNDS} times; land again")
    return 1


def queue_join(repo, d, e, tree, head):
    """Under the landing lock, main red: the checked change joins `waiting` (land's join, from the check tree)."""
    a = argparse.Namespace(follow=False)
    out = io.StringIO()
    with contextlib.redirect_stdout(out):
        rc = join(repo, f"refs/remotes/{REMOTE}/main", lambda *x: subprocess.run(x, cwd=tree, capture_output=True,
                                                                                  text=True, env=tool_env()),
                  os.path.join(d, f"check-{e['id']}"), a, head=head, worktree=e["worktree"],
                  branch=e.get("branch") or "")
    line = (out.getvalue().strip().splitlines() or [""])[-1]
    if rc == 0:
        e.update(status="joined", decided=ts(), waiting_id=a.waiting["id"])
        save_entry(d, e)
        inbox_write("land", line, [line], [], None, final=False, cwd=e["worktree"])
        wlog(d, f"{e['id']}: {line}")
        return 0
    queue_verdict(d, e, "rejected", line or "NOT LANDED: could not join `waiting`")
    return 1


def run_entry_checks(repo, d, e, tree, base, head, mode, cls, log_path, own=None):
    """(ok, output, where) of the change's checks: on ci-runner when the governor reports pressure (and the repo has the
    remote check workflow), else in the tree, admitted by the governor. ok None: stalled."""
    adopted = remote_matches(e, base, head, mode)
    why = "its remote run, adopted" if adopted else \
        gov_pressure() if os.environ.get("AGENTCTL_REMOTE_CHECKS", "1") != "0" else None
    if why and (adopted or remote_checks_supported(tree)):
        wlog(d, f"{e['id']}: the laptop is under pressure ({why}): checks on ci-runner")
        ok, out = remote_check(repo, e, base, head, mode, own)
        if ok is not None:
            return ok, out, f"on ci-runner ({why})"
        wlog(d, f"{e['id']}: the remote check gave no verdict ({out.splitlines()[-1] if out else '?'}): checking here")
    # the range through the remote's ref (forgejo/main is `base` now, fetched just before): the hook finds the remote, and
    # with it Forgejo's red gate, from it -- given bare shas it fell back to gh (GitHub, suspended): the gate unread
    rng = f"{REMOTE}/main..{head}" if git(tree, "rev-parse", f"{REMOTE}/main").strip() == base else f"{base}..{head}"
    e["waiting_on"] = "the governor (a check slot)"
    save_entry(d, e)
    try:
        with check_slot(repo, f"queued {e['id']} {head[:10]}", cls) as slot:
            e["waiting_on"] = None
            save_entry(d, e)
            rc, out = run_watched([os.path.join(tree, "scripts", "hooks", "pre-push"), mode, rng], tree,
                                  slot.env(tool_env()), log_path, "checks", sampler=slot.sample)
            slot.done(rc, out)
    except GovTimeout as ex:  # an infra failure of the laptop, re-queued by the caller (INFRA_CHECK_FAILURE)
        return False, f"TIMEOUT 0s {ex}", "locally (never admitted)"
    with open(os.path.join(d, "checks.log"), "a") as f:
        f.write(f"=== {ts()} {e['id']} {base[:10]}..{head[:10]} {mode} rc {rc}\n{out}\n")
    return (None if rc is None else rc == 0), out, f"locally, check tree {os.path.basename(tree)}"


# ---------------------------------------------------------------- remote checks: ci-runner's check tier under pressure
# The owner (2026-10-27): when the governor reports memory or CPU pressure (gov_pressure), a queued change's pre-commit
# checks run on ci-runner's check tier instead. The checked tip is pushed to `check/<entry id>` (the hook checks nothing
# for a check/ branch: it is a run's ref, never landed), whose push runs .github/workflows/precommit-check.yml: the same
# hook, `--checks-only <merge-base with main>..HEAD`, on the check tier's runner. agentctl follows that run (owned: the run
# is cancelled if the checker dies), reads the verdict -- the same (ok, output) shape as a local check, the failed jobs'
# relevant lines as output -- and deletes the branch. The push to main then carries PREPUSH_REMOTE_RUN=<run id>: the hook
# takes that run's pass for its checks only after Forgejo confirms it (the workflow, success, the pushed commit itself).
REMOTE_WORKFLOW = "precommit-check.yml"
REMOTE_TIMEOUT = 2 * 3600
REMOTE_START = 15 * 60  # no run for the pushed branch by then: no verdict (checked locally instead)


def remote_checks_supported(tree):
    return os.path.exists(os.path.join(tree, ".github", "workflows", REMOTE_WORKFLOW))


REMOTE_EXPECTED_MIN = 30  # a check's expected duration ($AGENTCTL_CHECK_EXPECTED_MIN): an entry checking 2x that is re-examined
REMOTE_COLLECT_GRACE = 300  # a run decided this long ago and still uncollected: its checker is stranded, stopped, replaced


class Terminated(SystemExit):
    """A signal's exit (Owned's handler): never swallowed by a wait loop that rides out a token or tunnel outage."""


def remote_matches(e, base, head, mode):
    """The entry's recorded remote check, when it is the check of exactly this tip on this base in this mode."""
    rem = e.get("remote") or {}
    if rem.get("tip") == head and rem.get("base") == base and rem.get("mode") == mode and rem.get("head") == e.get("head") \
            and rem.get("status") not in ("cancelled", "skipped", "abandoned"):
        return rem
    return None


def remote_poll(o_r, rem):
    """STATELESS: the remote check's state from Forgejo alone -- the run (found by its check/ branch and tip when its id
    is not known yet), its status, and for a decided run the verdict. Returns the updated record (a copy); raises when
    Forgejo cannot be read."""
    rem = dict(rem)
    if rem.get("run") is None:
        runs = (api(o_r, "GET", "actions/runs", {"workflow_id": REMOTE_WORKFLOW, "limit": 50})
                or {}).get("workflow_runs") or []
        hit = next((x for x in runs if x.get("commit_sha") == rem["tip"]
                    and x.get("prettyref") in (rem["branch"], f"refs/heads/{rem['branch']}")), None)
        if not hit:
            return rem
        rem["run"] = hit["id"]
    run = api(o_r, "GET", f"actions/runs/{rem['run']}") or {}
    status = run.get("status")
    rem["run_status"] = status
    if status in ("success", "failure", "cancelled", "skipped") and not rem.get("status"):
        rem["status"], rem["decided_at"] = status, time.time()
        name = f"{REMOTE_WORKFLOW} run {rem['run']} (#{run.get('index_in_repo')})"
        if status == "success":
            rem["out"] = f"{name}: success"
        elif status == "failure":
            out = [f"{name} failed: {run.get('html_url')}"]
            try:
                for job, ls in relevant_lines(fetch_failed_log(o_r, rem["run"]), 25).items():
                    out += [f"-- {job}"] + ls
            except Exception as ex:
                out.append(f"(its failed log could not be read: {str(ex)[:120]})")
            rem["out"] = "\n".join(out)
        else:
            rem["out"] = f"{REMOTE_WORKFLOW} run {rem['run']} {status}"
    return rem


def save_remote(d, e, rem):
    """The remote check's record in the entry, saved at once (a replacement checker adopts it); `remote_run` mirrors the
    run for the push's hook and `waiting status`."""
    e["remote"] = rem
    if rem.get("run") is not None:
        e["remote_run"] = rem["run"]
    else:
        e.pop("remote_run", None)
    if d and e.get("seq") is not None:
        save_entry(d, e)


def delete_check_branch(o_r, branch):
    try:
        api(o_r, "DELETE", f"branches/{urllib.parse.quote(branch, safe='')}")
    except Exception as ex:
        err(f"could not delete {branch} ({str(ex)[:120]}): `agentctl sweep` lists it")


def remote_check(repo, e, base, head, mode, own=None):
    """(ok, output) of the change's checks on ci-runner; ok None when no verdict came (the caller checks locally).
    The run belongs to the ENTRY, not to this process: its record (`remote` in the entry) is saved the moment the branch is
    pushed and again when the run is found, so a checker that dies or is replaced mid-wait strands nothing -- the next one
    ADOPTS the run (no new push, no new run) and the processor re-derives its state from Forgejo every cycle. Its time
    bounds count from the push, not from this process's start."""
    o_r = slug(repo)
    try:
        d = waiting_state(repo)[0]
    except (Exception, SystemExit):
        d = None
    rem = remote_matches(e, base, head, mode)
    if rem and d:
        wlog(d, f"{e['id']}: adopting its remote check (run {rem.get('run') or 'not found yet'}, pushed "
                f"{int((time.time() - rem['pushed_at']) // 60)} min ago)")
    if not rem:
        branch = f"check/{e['id']}"
        r = git(repo, "push", "--quiet", "--force", REMOTE, f"{head}:refs/heads/{branch}", check=False)
        if r.returncode != 0:
            return None, f"push of {branch} failed: {r.stderr.strip()[:300]}"
        rem = {"branch": branch, "head": e.get("head"), "base": base, "tip": head, "mode": mode, "run": None,
               "pushed_at": time.time(), "status": None}
        save_remote(d, e, rem)
        try:
            record_dispatch(branch=branch, workflow=REMOTE_WORKFLOW, worktree=e.get("worktree"), sha=head,
                            agent="land queue", pid=os.getpid(), purpose=f"pre-commit check of queue entry {e['id']}")
        except (Exception, SystemExit) as ex:
            err(f"remote check of {e['id']}: owner not recorded ({str(ex)[:120]})")
    delays = backoff(15, 120)
    while True:
        try:
            new = remote_poll(o_r, rem)
            if new.get("run") is not None and rem.get("run") is None:
                try:
                    save_dispatch({"branch": rem["branch"], "run_id": new["run"]})
                except OSError:
                    pass
            if new != rem:
                rem = new
                save_remote(d, e, rem)
        except Terminated:
            raise
        except (Exception, SystemExit) as ex:  # Forgejo down for a while: keep reading until the bound
            err(f"remote check of {e['id']}: {str(ex)[:160]}")
        if rem.get("status"):
            rem["collected_at"] = time.time()
            save_remote(d, e, rem)
            delete_check_branch(o_r, rem["branch"])
            if rem["status"] in ("success", "failure"):
                return rem["status"] == "success", rem["out"]
            return None, rem["out"]
        age = time.time() - rem["pushed_at"]
        if rem.get("run") is None and age > REMOTE_START:
            rem.update(status="abandoned", collected_at=time.time())
            save_remote(d, e, rem)
            delete_check_branch(o_r, rem["branch"])
            return None, f"no {REMOTE_WORKFLOW} run started for {rem['branch']} in {REMOTE_START // 60} min"
        if age > REMOTE_TIMEOUT:
            cancel_run(o_r, rem["run"], "the remote check timed out")
            rem.update(status="abandoned", collected_at=time.time())
            save_remote(d, e, rem)
            delete_check_branch(o_r, rem["branch"])
            return None, f"{REMOTE_WORKFLOW} run {rem['run']} undecided after {REMOTE_TIMEOUT // 3600} h"
        time.sleep(next(delays))


def cancel_entry_remote(e, why):
    """An entry that ends (superseded, cancelled) takes its undecided remote run with it: the run is the entry's."""
    rem = e.get("remote") or {}
    if rem.get("run") is not None and not rem.get("status"):
        try:
            cancel_run(slug(e["worktree"]) if os.path.isdir(e.get("worktree") or "") else SHORT["movies"], rem["run"], why)
        except (Exception, SystemExit) as ex:
            err(f"could not cancel run {rem['run']} of {e['id']}: {str(ex)[:120]}")


# ---------------------------------------------------------------- the processor re-derives every checking entry
def reconcile_dir(d):
    p = os.path.join(d, "reconcile")
    os.makedirs(p, exist_ok=True)
    return p


def reconcile_checking(repo, d, now_=None):
    """Every processor cycle, STATELESS and idempotent: each `checking` entry's state from the facts -- its checker's lock
    and its remote run's status on Forgejo -- never from a live waiter's memory.
    - a remote run DECIDED over REMOTE_COLLECT_GRACE ago that its live checker has not collected: the checker is
      stranded (wedged mid-wait): stopped, so spawn_checks starts one that adopts the run and its verdict;
    - no live checker: spawn_checks restarts one (adopting the run);
    - checking over 2x the expected duration ($AGENTCTL_CHECK_EXPECTED_MIN, 30 min), counted from the round's start:
      re-examined, and when it is still unresolvable (Forgejo unreadable, a decided run still uncollected after its
      checker was stopped, no checker) escalated ONCE to the inbox as STALLED.
    The processor's own marks live in reconcile/<id>.json, never in the entry (its checker owns that file)."""
    now_ = now_ if now_ is not None else time.time()
    try:
        o_r = slug(repo)
    except (Exception, SystemExit):
        o_r = SHORT["movies"]
    expected = env_num("AGENTCTL_CHECK_EXPECTED_MIN", REMOTE_EXPECTED_MIN) * 60
    out = []
    for e in waiting_entries(d, open_only=False):
        if e.get("status") != "checking":
            continue
        mpath = os.path.join(reconcile_dir(d), f"{e['id']}.json")
        marks = read_record(mpath) or {}
        if marks.get("run") != (e.get("remote") or {}).get("run") or marks.get("tip") != (e.get("remote") or {}).get("tip"):
            marks = {k: v for k, v in marks.items() if k in ("escalated", "dead_since")}  # a new run: its own marks
            marks.update(run=(e.get("remote") or {}).get("run"), tip=(e.get("remote") or {}).get("tip"))
        alive = lock_held(entry_owned(e["id"]).lockpath)
        rem, unreadable = e.get("remote"), None
        if rem and not rem.get("status"):
            try:
                new = remote_poll(o_r, rem)
                if new.get("status") and not marks.get("decided_at"):
                    marks["decided_at"] = now_
                    wlog(d, f"{e['id']}: its remote run {new['run']} is {new['status']} (seen by the processor)")
                rem = new
            except (Exception, SystemExit) as ex:
                unreadable = str(ex)[:160]
        decided_at = marks.get("decided_at") or (rem or {}).get("decided_at")
        uncollected = bool(rem and rem.get("status") and not rem.get("collected_at") and decided_at and now_ - decided_at > REMOTE_COLLECT_GRACE)
        if uncollected and alive and not marks.get("stopped_at"):
            h = read_record(entry_owned(e["id"]).record) or {}
            if h.get("pid") and int(h["pid"]) != os.getpid():
                try:
                    os.kill(int(h["pid"]), signal.SIGTERM)
                except OSError:
                    pass
            marks["stopped_at"] = now_
            wlog(d, f"{e['id']}: remote run {rem.get('run')} decided {int((now_ - decided_at) // 60)} min ago and not "
                    f"collected: its checker (pid {h.get('pid')}) is stranded; stopped, a new one adopts the verdict")
            out.append(("stopped", e["id"]))
        since = e.get("round_since") or e.get("since")
        overdue = since and now_ - parse_time(since).timestamp() > 2 * expected
        why = None
        if overdue:
            if unreadable:
                why = f"its remote run cannot be read ({unreadable})"
            elif uncollected and marks.get("stopped_at") and now_ - marks["stopped_at"] > REMOTE_COLLECT_GRACE:
                why = f"remote run {rem.get('run')} is {rem.get('status')} but no checker collects it"
            elif not alive and marks.get("dead_since") and now_ - marks["dead_since"] > REMOTE_COLLECT_GRACE:
                why = "no checker runs for it"
            elif alive and e.get("waiting_on"):  # a live checker that waits (audit #12): said, with what it waits on
                why = f"its live checker waits on {e['waiting_on']}"
        if not alive:
            marks.setdefault("dead_since", now_)
        else:
            marks.pop("dead_since", None)
        key = f"{since}"
        if why and marks.get("escalated") != key:
            marks["escalated"] = key
            mins = int((now_ - parse_time(since).timestamp()) // 60)
            line = (f"STALLED: queue entry {e['id']} checking for {mins} min (over 2x the expected "
                    f"{int(expected // 60)} min): {why}")
            wlog(d, line)
            open_condition("STALLED", line, run_probe("queue_entry", {"repo": repo, "eid": e["id"], "round": since}), [],
                           key=f"queue-{e['id']}", command="land", cwd=e.get("worktree"),
                           tail=[f"remote: {json.dumps(rem)[:400]}" if rem else "remote: none", f"checker alive: {alive}"])
            out.append(("escalated", e["id"]))
        tmp = f"{mpath}.{os.getpid()}.tmp"
        with open(tmp, "w") as f:
            json.dump(marks, f)
        os.replace(tmp, mpath)
    return out


def processor_owned(d, repo=None):
    """The processor's ownership: one per waiting state directory (one per repository)."""
    return Owned("waiting", os.path.basename(d.rstrip("/")) or "repo", ["waiting", "run", "--repo", repo or ""])


def waiting_processor_alive(d):
    return lock_held(processor_owned(d).lockpath)


def spawn_waiting_processor(repo):
    d, clone, _w = waiting_state(repo)
    if waiting_processor_alive(d):
        return
    repo = clone if os.path.isdir(clone) else repo  # the clone, not a joiner's worktree: that one closes after WATCH OK
    with open(os.path.join(d, "processor.log"), "a") as logf:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "waiting", "run", "--repo", repo],
                         stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, start_new_session=True, cwd=repo,
                         env=detached_env(repo))


# THE TOKEN HAND-OFF. The processor as a launchd service, or detached once its land exits, gets no answer from the vault
# (an unlock belongs to the session that made it). So it listens on a unix socket (0600, in a 0700 directory) and a
# process that can read the vault -- every `land` that joins `waiting`, and `waiting status` / `resume` -- hands it the
# token. It lives only in the processor's memory and environment (a re-exec keeps it; the push's hook and the watches it
# starts inherit it), never on disk. Until it has one, the gate is unread: taken as red, said once in the inbox.
def token_sock_path(d):
    import hashlib
    base = os.environ.get("AGENTCTL_SOCK_DIR") or f"/tmp/agentctl-{os.getuid()}"  # short: a socket path is <= 104 bytes
    return os.path.join(base, hashlib.sha1(os.path.abspath(d).encode()).hexdigest()[:12] + ".sock")


TOKEN_SHAPE = re.compile(r"[\w.~+/=-]{8,512}")
TOKEN_REQUEST = b"?token\n"  # a client asking the processor for its token (not shaped like one)


class TokenDrop:
    """The processor's end of the hand-off."""

    def __init__(self, d, o_r):
        self.path, self.o_r, self.sock = token_sock_path(d), o_r, None

    def open(self):
        import socket
        try:
            os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
            os.chmod(os.path.dirname(self.path), 0o700)
            if os.path.exists(self.path):
                os.unlink(self.path)
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            old = os.umask(0o177)
            try:
                s.bind(self.path)
            finally:
                os.umask(old)
            s.listen(4)
            self.sock = s
            import threading  # served on a thread of its own: no step of the main loop can leave a client waiting
            threading.Thread(target=self.serve, name="token-socket", daemon=True).start()
        except OSError as e:
            err(f"no token hand-off socket ({e}): the processor reads the vault itself")
        return self

    def held(self):
        return os.environ.get("FORGEJO_API_TOKEN" if token_ns(self.o_r) == "movies" else "GH_TOKEN", "")

    def serve(self):
        import select
        while self.sock:
            try:
                ready, _, _ = select.select([self.sock], [], [], 1)
                if ready and self.sock:
                    self.take()
            except (OSError, ValueError):
                return

    def nap(self, secs):
        """Sleep secs (the socket is served by its own thread)."""
        end = time.time() + secs
        while True:
            HEARTBEAT[0] = time.monotonic()
            left = end - time.time()
            if left <= 0:
                return
            time.sleep(min(left, 10))

    def take(self):
        try:
            conn, _ = self.sock.accept()
        except OSError:
            return
        with conn:
            conn.settimeout(5)
            try:
                tok = conn.recv(4096).decode().strip()
                if tok == TOKEN_REQUEST.decode().strip():  # a same-uid process (the socket is 0600) asks for the token
                    conn.sendall(self.held().encode())
                    return
            except (OSError, UnicodeDecodeError):
                return
            if TOKEN_SHAPE.fullmatch(tok):
                os.environ["FORGEJO_API_TOKEN" if token_ns(self.o_r) == "movies" else "GH_TOKEN"] = tok
                err("the Forgejo token was handed over: the gate is read again")

    def close(self):
        if self.sock:
            sock, self.sock = self.sock, None
            sock.close()
            try:
                os.unlink(self.path)
            except OSError:
                pass


def offer_token(repo):
    """Hand this process's Forgejo token to the repo's waiting processor when it listens (see THE TOKEN HAND-OFF). Never
    fatal; True when handed over."""
    import socket
    try:
        d, _c, _w = waiting_state(repo)
        path = token_sock_path(d)
        if not os.path.exists(path):
            return False
        tok = token(slug(repo))
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(3)
            s.connect(path)
            s.sendall(tok.encode())
        return True
    except (Exception, SystemExit):
        return False


def await_entry(repo, eid, close=None):
    """Block until the entry lands or is rejected: (rc, landed sha, pushed_at). Restarts a dead processor. OWNED (one
    awaiter per entry; on agentctl's new code it re-execs as `agentctl waiting await <entry>`, which then watches)."""
    own = Owned("await", eid, ["waiting", "await", eid, "--repo", repo] + (["--close", close] if close else []))
    if not own.acquire():
        h = own.holder or {}
        print(f"NOT LANDED (still waiting): entry {eid} is already awaited by pid {h.get('pid')} ({h.get('owner')})")
        return 2, None, None
    try:
        return _await_entry(repo, eid, own)
    finally:
        own.release()


def _await_entry(repo, eid, own):
    d, _c, _w = waiting_state(repo)
    p = os.path.join(d, "entries", f"{eid}.json")
    t0, delays = time.time(), backoff(15, 60)
    timeout = float(os.environ.get("AGENTCTL_WAITING_TIMEOUT", WAITING_AWAIT_TIMEOUT))
    while True:
        with open(p) as f:
            e = json.load(f)
        if e["status"] == "landed":
            print(f"LANDED {e['landed_sha']} (with the {e.get('batch', 1)} change(s) of `{WAITING_BRANCH}`, once main was green)",
                  flush=True)
            return 0, e["landed_sha"], e.get("pushed_at")
        if e["status"] in ("rejected", "cancelled"):
            print(f"NOT LANDED: {e.get('why') or e['status']}")
            return 1, None, None
        if time.time() - t0 > timeout:
            print(f"NOT LANDED (still waiting): entry {eid} on `{WAITING_BRANCH}` after {int(timeout // 3600)} h; "
                  "`agentctl waiting status`")
            return 2, None, None
        spawn_waiting_processor(repo)
        restart_if_changed([own])
        time.sleep(next(delays))


def reject(d, e, why):
    e.update(status="rejected", why=why, decided=ts())
    save_entry(d, e)
    wlog(d, f"rejected {e['id']}: {why.splitlines()[0]}")


def rebuild(repo, d, wt, entries, base):
    """`waiting` = base + each entry's commits, in order; a conflicting entry is rejected alone. Returns the kept ones."""
    git(wt, "reset", "--hard", "-q", base)
    kept = []
    for e in entries:
        how, x = apply_entry(d, wt, e, base)
        if how == "conflict":
            reject(d, e, f"main moved while it waited and the change no longer applies (conflicts in: "
                         f"{', '.join(x)}): rebase onto forgejo/main and land again")
            continue
        if how == "landed":  # all of it reached main meanwhile: LANDED, and nothing of it is pushed again
            already_landed(d, e, x)
            continue
        if how == "duplicate":  # an earlier entry carries the very same change: that one lands it
            owner = next((k for k in kept if x and git(wt, "merge-base", "--is-ancestor", x, k["tip"],
                                                        check=False).returncode == 0), None)
            supersede(d, e, owner["id"] if owner else "an earlier entry",
                      f"the same change already waits on `{WAITING_BRANCH}`" + (f" as {owner['id']}" if owner else ""))
            continue
        e["tip"] = git(wt, "rev-parse", "HEAD").strip()
        kept.append(e)
    return kept


def batch_state(d):
    try:
        with open(os.path.join(d, "batch.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_batch_state(d, st):
    with open(os.path.join(d, "batch.json.tmp"), "w") as f:
        json.dump(st, f, indent=1)
    os.replace(os.path.join(d, "batch.json.tmp"), os.path.join(d, "batch.json"))


def batch_tree(repo, sha):
    """A detached worktree of the clone at `sha`: the batch is checked there, so `waiting` keeps taking joins."""
    _d, clone, wt = waiting_state(repo)
    bwt = f"{clone}-wt-batch"
    if not os.path.isdir(bwt):
        git(repo, "worktree", "prune", check=False)
        git(repo, "worktree", "add", "-q", "--detach", mark_internal(bwt), sha)
    else:
        git(bwt, "checkout", "-q", "--force", "--detach", sha)
    return bwt


def sbt_stop(tree):
    """A FRESH sbt server for the batch check: stop the tree's server and keeper (scripts/sbt-warm --stop), if any."""
    script = os.path.join(tree, "scripts", "sbt-warm")
    if os.access(script, os.X_OK):
        try:
            subprocess.run([script, "--stop"], cwd=tree, capture_output=True, text=True, timeout=180, env=tool_env())
        except subprocess.TimeoutExpired:
            err(f"sbt-warm --stop in {tree} took over 3 min")


STALL_SIGNAL = re.compile(r"(^|\s)(pre-push |sbt-warm )?STALLED:", re.M)
BATCH_HOLD = 30 * 60


def batch_mode(hook):
    """The combined check's hook mode: `--fast-only` (compile of every test config and the fast tests: every change
    passed its own full checks before it joined) when the hook has it, else the full `--range` dry run."""
    try:
        with open(hook) as f:
            return "--fast-only" if "--fast-only" in f.read() else "--range"
    except OSError:
        return "--range"


def batch_check(repo, d, tree, base, tip, cls="check"):
    """The hook's dry run over base..tip in `tree` (the basic checks plus every touched area's), on a fresh sbt server,
    under the stall abort. (ok, output, stalled): a stall -- land's 20 min, or the hook's exit 75 / `STALLED:` -- is
    retried once on a fresh server; stalled twice, `stalled` is True."""
    hook = precheck_hook(tree) or precheck_hook(repo)
    if not hook:
        return True, "", False
    out = ""
    for attempt in (1, 2):
        batch_tree(repo, tip)
        sbt_stop(tree)
        wlog(d, f"checking {base[:10]}..{tip[:10]} (attempt {attempt}, fresh sbt server)")
        with check_slot(repo, f"waiting batch {tip[:10]}", cls) as slot:
            rc, out = run_watched([hook, batch_mode(hook), f"{base}..{tip}"], tree, slot.env(tool_env()),
                                  os.path.join(d, f"check-{tip[:10]}"), f"batch-check-{attempt}", sampler=slot.sample)
            slot.done(rc, out)
        sbt_stop(tree)
        with open(os.path.join(d, "checks.log"), "a") as f:
            f.write(f"=== {ts()} {base[:10]}..{tip[:10]} attempt {attempt} rc {rc}\n{out}\n")
        if rc is None or rc == 75 or STALL_SIGNAL.search(out or ""):
            wlog(d, f"the check of {tip[:10]} STALLED (attempt {attempt})")
            continue
        return rc == 0, out, False
    return False, out, True


def push_batch(repo, d, entries, tip, base, how):
    """Under the lock: push `tip` (main still at `base`) through the hook. 'landed' | 'moved' | 'red' | 'failed'."""
    with land_lock(repo) as held:
        if not held:
            return "moved"
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
        if git(repo, "rev-parse", f"{REMOTE}/main").strip() != base:
            wlog(d, f"main moved during the check of {tip[:10]}: the batch is rebuilt and checked again")
            return "moved"
        lock_note(f"push of the batch {tip[:10]}")
        pushed_at = time.time()
        tree = batch_tree(repo, tip)  # the push's hook runs in the tree it checked, so it reuses that pass
        env = dict(tool_env(), PREPUSH_REUSE_FAST="1")  # the batch's fast pass stands for the push (pre-push --fast-only)
        rc, out = run_watched(push_argv(REMOTE, tip), tree, env, os.path.join(d, f"push-{tip[:10]}"), "push",
                              **push_bounds())
        if rc == 0:
            mark_gate_dirty()
        with open(os.path.join(d, "checks.log"), "a") as f:
            f.write(f"=== push {ts()} {tip[:10]} rc {rc}\n{out}\n")
        if rc is None:
            wlog(d, f"the push of {tip[:10]} stalled")
            return "failed"
        if rc != 0:
            if REDGATE.search(out):
                wlog(d, "the gate went red before the push: waiting")
                return "red"
            if RACE.search(out):
                return "moved"
            wlog(d, f"the push of {tip[:10]} failed:\n  {tail_of(out, 12)}")
            return "failed"
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
        if not landed(repo, tip, f"refs/remotes/{REMOTE}/main"):
            return "moved"
    for e in entries:
        e.update(status="landed", landed_sha=e["tip"], pushed_at=pushed_at, batch=len(entries), decided=ts())
        save_entry(d, e)
        inbox_write("land", f"LANDED {e['tip']} ({how}: {len(entries)} change(s) in one push)", [f"LANDED {e['tip']}"],
                    [], 0, cwd=e["worktree"])
        spawn_watch(repo, e, pushed_at)
    wlog(d, f"LANDED {tip} ({len(entries)} change(s) in one push)")
    return "landed"


def main_clone(path):
    """The main clone a worktree belongs to (its git common dir's checkout): what a DETACHED process works from, since
    the worktree it was started for may be removed under it (2026-10-27: a watch crashed with `git rev-parse
    --show-toplevel in ~/projects/movies-wt-gate-closed: cannot change to ...` after its agent removed the worktree at
    LANDED). A path that is gone resolves by name: <clone>-wt-<name> -> <clone>."""
    if path and os.path.isdir(path):
        r = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir", check=False)
        if r.returncode == 0:
            common = os.path.realpath(r.stdout.strip())
            clone = os.path.dirname(common) if os.path.basename(common) == ".git" else common
            if os.path.isdir(clone):
                return clone
        return git(path, "rev-parse", "--show-toplevel").strip()
    m = re.match(r"^(.*?)-wt-[^/]+/?$", path or "")
    if m and os.path.isdir(m.group(1)):
        return m.group(1)
    raise RuntimeError(f"{path}: gone, and no main clone found for it")


def spawn_watch_of(repo, sha, pushed_at, close=None, fixes=()):
    """A DETACHED `agentctl watch` of sha (its own session): its verdict goes to the inbox, agent alive or not. It is
    handed the Forgejo token (token_env): once land exits, the vault no longer answers it. It runs from the MAIN CLONE
    (main_clone): the worktree it closes may be removed by its agent first."""
    agent, repo = repo, main_clone(repo)
    d = state_root()
    os.makedirs(d, exist_ok=True)
    argv = [sys.executable, os.path.realpath(__file__), "watch", "--repo", repo, "--for", agent, "--sha", sha,
            "--pushed-at", str(pushed_at or time.time())] + (["--close", close] if close else []) + \
        [x for f in fixes for x in ("--fixes", str(f))]
    with open(os.path.join(d, "watches.log"), "a") as logf:
        subprocess.Popen(argv, cwd=repo, stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, start_new_session=True,
                         env=detached_env(repo))


def spawn_watch(repo, e, pushed_at):
    """A DETACHED watch of a landed entry (its own session): its WATCH verdict goes to the inbox whether or not the agent
    that joined lives. Not when a `land --follow` (or an older land's await) waits on the entry: that one watches."""
    if lock_held(Owned("await", e["id"]).lockpath):
        return
    where = main_clone(repo)  # never the joiner's worktree: it may be removed while the watch runs
    d, _c, _w = waiting_state(repo)
    argv = [sys.executable, os.path.realpath(__file__), "watch", "--repo", where, "--for", e["worktree"], "--sha", e["tip"],
            "--pushed-at", str(pushed_at)] + (["--close", e["worktree"]] if os.path.isdir(e["worktree"]) else []) + \
        [x for f in e.get("fixes") or [] for x in ("--fixes", str(f))]
    with open(os.path.join(d, "watches.log"), "a") as logf:
        subprocess.Popen(argv, cwd=where, stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, start_new_session=True,
                         env=detached_env(repo))


def bisect(repo, d, batch, base):
    """The batch failed: the first entry whose prefix fails (binary search over the prefixes' tips). (index, output) of
    the culprit; (None, output) when the whole batch passes on its own again (flaky or infra)."""
    _d, _c, _w = waiting_state(repo)
    bwt = batch_tree(repo, batch[-1]["tip"])
    lo, hi, out_hi = 0, len(batch) - 1, ""
    ok, out, stalled = batch_check(repo, d, bwt, base, batch[hi]["tip"])
    if ok or stalled:
        return None, out
    out_hi = out
    while lo < hi:
        mid = (lo + hi) // 2
        ok, out, stalled = batch_check(repo, d, bwt, base, batch[mid]["tip"])
        if stalled:
            return None, out
        if ok:
            lo = mid + 1
        else:
            hi, out_hi = mid, out
    # one flaky failure rejects nobody (audit #10): the culprit's prefix is checked once more before it is rejected
    ok, out, stalled = batch_check(repo, d, bwt, base, batch[lo]["tip"])
    if ok or stalled:
        wlog(d, f"bisect: the prefix through {batch[lo]['id']} passed when checked again: flaky, nobody rejected")
        return None, out
    return lo, out_hi


def unread_note(d, reds, entries):
    """The gate unread while changes wait: once per unread spell, an UNKNOWN inbox entry (they would wait unseen)."""
    if GATE_UNREAD not in reds or os.path.exists(recovery_dir("gate-unread-waiting.json")):
        return
    wlog(d, f"the gate is unread ({gate_unread_why[0]}): taken as red")
    open_condition("UNKNOWN", f"UNKNOWN: the waiting processor cannot read the gate ({gate_unread_why[0]}); {len(entries)} "
                              "change(s) wait, taken as red. Hand it the token: `~/bin/agentctl waiting status` from a "
                              "session with the vault unlocked",
                   run_probe("gate_read", {"since": time.time()}), [], key="gate-unread-waiting", command="waiting",
                   exit_code=2, cwd=entries[0].get("worktree") if entries else None)


def waiting_round(repo, d, wt):
    """One batch: 'empty', 'paused', 'held', 'red' (nothing may go while red), 'landed', 'rejected', 'retry'.

    Under the lock (seconds): fetch, rebuild `waiting` on forgejo/main in batch order, take the batch -- every entry, or
    while main is red only what may land while red, and only once a Fixes-Red entry for the red run is among them.
    Released, one check of the batch's tip (a fresh sbt server, the stall abort; a stall is retried once, then the batch
    is HELD with an inbox entry). Pass: one push of the tip through the hook, every entry LANDED. Fail: bisect by
    prefix, reject only the culprit (NOT LANDED with the failing tail, to the inbox), land the passing prefix before it.
    Entries that join meanwhile wait for the next batch."""
    entries = waiting_entries(d)
    if not entries:
        return "empty"
    st = batch_state(d)
    if os.path.exists(os.path.join(d, "PAUSED")):
        return "paused"
    if st.get("held_until", 0) > time.time():
        return "held"
    reds = gate_reds(repo)
    unread_note(d, reds, entries)
    with land_lock(repo) as held:
        if not held:
            return "retry"
        lock_note("rebuild `waiting` for a batch")
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
        ensure_waiting_tree(repo, wt)
        base = git(repo, "rev-parse", f"{REMOTE}/main").strip()
        kept = rebuild(repo, d, wt, batch_order(repo, entries, reds), base)
    for e in [e for e in entries if e not in kept and e.get("status") == "rejected"]:  # LANDED / SUPERSEDED: said
        land_not_landed(f"NOT LANDED: {e.get('why', 'rejected').splitlines()[0]}", e["worktree"])
    if not kept:
        return "rejected"
    if reds:
        batch = [e for e in kept if not must_wait(repo, e["commits"], reds)]
        if not any(set(e.get("fixes") or []) & reds for e in batch):
            return "red"
    else:
        batch = kept
    tip = batch[-1]["tip"]
    save_batch_state(d, {"checking": [e["id"] for e in batch], "tip": tip, "base": base, "since": ts()})
    bwt = batch_tree(repo, tip)
    ok, out, stalled = batch_check(repo, d, bwt, base, tip,
                                   "red" if reds and any(set(e.get("fixes") or []) & reds for e in batch) else "check")
    save_batch_state(d, {})
    if stalled:
        until = time.time() + float(os.environ.get("AGENTCTL_BATCH_HOLD", BATCH_HOLD))
        save_batch_state(d, {"held_until": until, "why": f"the check of {tip[:10]} stalled twice, on fresh sbt servers"})
        open_condition("STALLED", f"HELD: the batch check of {tip[:10]} ({len(batch)} change(s)) stalled twice on a fresh "
                                  f"sbt server; the changes stay on `{WAITING_BRANCH}`, checked again after "
                                  f"{int((until - time.time()) // 60)} min",
                       run_probe("batch_hold", {"d": d}), [], key=f"batch-held-{int(until)}", command="waiting",
                       cwd=repo, tail=(out or "").splitlines()[-15:])
        wlog(d, f"HELD: the check of {tip[:10]} stalled twice")
        return "held"
    if ok:
        r = push_batch(repo, d, batch, tip, base, "batch")
        if r in ("landed", "red"):
            batch_retry(d, None)
            return r
        return batch_retry(d, tip, f"its push {r}", len(batch))
    if REDGATE.search(out or ""):
        return "red"
    wlog(d, f"the batch {tip[:10]} failed its checks; bisecting by prefix")
    culprit, cout = bisect(repo, d, batch, base)
    if culprit is None:
        wlog(d, "every prefix passed on its own again (flaky or infra): checked again next round")
        return batch_retry(d, tip, "it failed, then every prefix passed on its own (flaky or infra)", len(batch))
    bad = batch[culprit]
    reject(d, bad, f"the checks failed with your change in the batch on `{WAITING_BRANCH}`:\n  {tail_of(cout)}")
    inbox_write("land", f"NOT LANDED: the checks failed with your change in the batch (entry {bad['id']})", [],
                cout.splitlines()[-25:], 1, cwd=bad["worktree"])
    if culprit > 0:  # the prefix before it passed its own check: it lands now; the rest join the next batch
        push_batch(repo, d, batch[:culprit], batch[culprit - 1]["tip"], base, "batch prefix before a rejected change")
    return "rejected"


BATCH_RETRY_MAX = 3  # a batch tip that fails to land this many times is HELD, with a condition (audit #5)


def batch_retry(d, tip, why=None, n_changes=0):
    """Count a failed landing of the batch at `tip` (tip None: it landed, the count clears). 'retry', or 'held' after
    BATCH_RETRY_MAX: the batch is held and a condition opened on the git route (git_fetch), cleared with the hold."""
    p = os.path.join(d, "batch-retries.json")
    if tip is None:
        write_json(p, {})
        return "retry"
    st = read_record(p) or {}
    n = int(st.get(tip) or 0) + 1
    write_json(p, {tip: n})
    if n < env_num("AGENTCTL_BATCH_RETRY_MAX", BATCH_RETRY_MAX):
        wlog(d, f"the batch {tip[:10]} did not land ({why}): retry {n}/{BATCH_RETRY_MAX}")
        return "retry"
    until = time.time() + float(os.environ.get("AGENTCTL_BATCH_HOLD", BATCH_HOLD))
    save_batch_state(d, {"held_until": until, "why": f"the batch {tip[:10]} did not land {n} times ({why})"})
    write_json(p, {})
    text = (f"HELD: the batch {tip[:10]} ({n_changes} change(s)) did not land {n} times ({why}); it stays on "
            f"`{WAITING_BRANCH}` and is tried again when git can read {REMOTE}/main, or after {int((until - time.time()) // 60)} min")
    c = open_condition("STALLED", text, run_probe("git_fetch", {"repo": os.path.dirname(d)}), [("clear_hold", {"d": d})],
                       key=f"batch-retry-{tip[:10]}", command="waiting")
    if not c:  # git answers: not the route -- held for its time, said once (a note: the hold ends on its own)
        note = "BATCH " + text
        inbox_write("waiting", note, [note], [], 1)
    wlog(d, text)
    return "held"


HEARTBEAT = [time.monotonic()]  # the processor's loop stamps it each pass (monotonic: a laptop sleep is no stall)
IN_BATCH = [False]  # inside waiting_round: a batch's checks legitimately take long
STALL_SECS = 300


def start_watchdog(argv):
    """If the loop completes no cycle in STALL_SECS (outside a batch): dump every thread's stack to the log, write one
    STALLED inbox entry, and re-exec. SIGUSR1 dumps the stacks on demand."""
    import faulthandler, threading
    try:
        faulthandler.register(signal.SIGUSR1, all_threads=True)
    except (AttributeError, ValueError, OSError):
        pass

    def watch():
        while True:
            time.sleep(env_num("AGENTCTL_WATCHDOG_TICK", 30))
            stalled = time.monotonic() - HEARTBEAT[0]
            duty_stalled = time.monotonic() - DUTY_BEAT[0]
            limit = env_num("AGENTCTL_STALL_SECS", STALL_SECS)
            # the duties thread is never in a batch; its bounded steps join for up to 2 x AGENTCTL_STEP_BOUND
            if duty_stalled >= limit + 2 * env_num("AGENTCTL_STEP_BOUND", 120):
                stalled, what = duty_stalled, "the duties thread (gate line, patrol)"
            elif stalled >= limit and not IN_BATCH[0]:
                what = "the loop"
            else:
                continue
            err(f"STALLED: {what} made no cycle in {int(stalled)} s; stacks follow, then re-exec")
            faulthandler.dump_traceback(all_threads=True)
            open_condition("STALLED", f"STALLED: the waiting processor's {what} made no cycle in {int(stalled)} s; stacks in "
                                      "its service.log; re-exec'd", run_probe("processor", {"since": time.time()}), [],
                           key="processor-stalled", command="waiting", exit_code=2)
            for pg in list(WATCHED_GROUPS):  # a hook mid-batch would outlive the re-exec in the batch tree (audit #13)
                try:
                    stop_group(pg, 5)
                except OSError:
                    pass
            sys.stdout.flush()
            sys.stderr.flush()
            os.execv(sys.executable, [sys.executable, TOOL_PATH] + list(argv))
    threading.Thread(target=watch, name="watchdog", daemon=True).start()


DUTY_BEAT = [time.monotonic()]  # the duties thread stamps it each tick (monotonic, like HEARTBEAT)
DUTY_TICK = 5


def start_duties(repo):
    """The processor's always-on duties, on a thread of their own so neither a batch check nor a red-gate nap (up to
    300 s) delays them: the tunnel probe, the gate line for the status line, the red patrol, the inbox escalations.
    Each is rate-limited inside; a step that hangs is bounded (run_bounded) and the watchdog re-execs a stuck thread.
    Returns the Event that stops it."""
    import threading
    stop = threading.Event()

    def loop():
        while not stop.is_set():
            DUTY_BEAT[0] = time.monotonic()
            write_beat("processor")  # the watchdog's W5 reads it (a separate process: no shared memory)
            for name, step in (("network watch", network_watch),  # a new route: tunnel kicked, gate read at once
                               ("tunnel probe", tunnel_watch),  # 2 timeouts/refusals in a row -> kickstart the tunnel
                               ("gate summary", lambda: maybe_publish_gate(repo)),  # ~/.cache/agentctl/gate-summary.txt
                               ("red patrol", lambda: maybe_patrol(repo)),  # who fixes each red; dispatch a fixer
                               ("recovery", maybe_recovery_tick),  # each open condition's own probe; a pass clears it
                               ("inbox escalation", maybe_escalate_inbox)):  # unacked past 10 min: notified
                try:
                    step()
                except (Exception, SystemExit) as e:
                    err(f"{name} failed: {str(e).replace('agentctl: ', '')[:200]}")
                DUTY_BEAT[0] = time.monotonic()
                if stop.is_set():
                    return
            stop.wait(env_num("AGENTCTL_DUTY_TICK", DUTY_TICK))
    threading.Thread(target=loop, name="duties", daemon=True).start()
    return stop


ROUND_ERRORS_MAX = 3
round_errors = [0]
SERVICE_IDLE_POLL = 30  # seconds between looks at an empty `waiting` (a directory listing: no git, no network)


def waiting_run(repo, once=False, service=False):
    """The processor: batches until `waiting` is empty -- or, as the launchd service, for good, looking at an empty
    `waiting` every SERVICE_IDLE_POLL s (a directory listing). Re-execs on agentctl's new code between batches. Wall-clock
    sleeps only: after the laptop sleeps it simply polls again."""
    d, _c, wt = waiting_state(repo)
    own = processor_owned(d, repo)
    if not own.acquire():
        return 0
    with contextlib.ExitStack() as stack:
        stack.callback(own.release)
        try:
            o_r = slug(repo)
        except (Exception, SystemExit):
            o_r = SHORT["movies"]
        _IN_PROCESSOR[0] = True
        HEARTBEAT[0] = time.monotonic()
        start_watchdog(["waiting", "run", "--repo", repo] + (["--once"] if once else []) + (["--service"] if service else []))
        drop = TokenDrop(d, o_r).open()
        stack.callback(drop.close)
        stack.callback(start_duties(repo).set)  # the duties end with this processor
        delays = backoff(float(os.environ.get("AGENTCTL_WAITING_POLL", WAITING_POLL)), 300)
        while True:
            HEARTBEAT[0] = time.monotonic()
            LOOP_CYCLED[0] = True
            restart_if_changed([own], ["waiting", "run", "--repo", repo] + (["--once"] if once else [])
                               + (["--service"] if service else []))
            try:  # every checking entry re-derived from its checker's lock and its run on Forgejo (never a waiter's memory)
                reconcile_checking(repo, d)
            except Exception as e:
                err(f"reconcile of the checking entries failed: {e}")
            spawn_checks(repo, d)  # THE LAND QUEUE first: each queued change's checks, in a checker of its own (the
            # patrol below can take minutes -- a fixer's worktree checkout under load -- and held queued changes back)
            # the tunnel probe, the gate line, the patrol and the escalations run on the duties thread (start_duties), never
            # here: this loop sits in a batch check or a red-gate nap for minutes, and the gate line went stale with it
            if not service and not waiting_entries(d) and queued_entries(d):
                drop.nap(float(os.environ.get("AGENTCTL_SERVICE_POLL", SERVICE_IDLE_POLL)))
                continue
            if service and not waiting_entries(d):
                if os.path.isdir(wt) and not git_ok(repo, "rev-parse", "--verify", "-q", f"refs/heads/{WAITING_BRANCH}"):
                    drop_waiting_tree(repo, wt)
                if once:
                    return 0
                drop.nap(float(os.environ.get("AGENTCTL_SERVICE_POLL", SERVICE_IDLE_POLL)))
                continue
            IN_BATCH[0] = True
            try:
                state = waiting_round(repo, d, wt)
                round_errors[0] = 0
                write_json(os.path.join(d, "round-ok.json"), {"at": time.time()})
            except Exception as ex:  # one git error is one bad round, never a crash loop (audit #9)
                state = "retry"
                round_errors[0] += 1
                wlog(d, f"the round failed ({type(ex).__name__}: {str(ex)[:200]}); {round_errors[0]} in a row")
                if round_errors[0] == ROUND_ERRORS_MAX:
                    open_condition("STALLED", f"STALLED: the waiting processor's rounds failed {ROUND_ERRORS_MAX} times in a "
                                              f"row ({type(ex).__name__}: {str(ex)[:160]}); see {d}/processor.log",
                                   run_probe("waiting_ok", {"d": d, "since": time.time()}), [], key="waiting-rounds",
                                   command="waiting")
            finally:
                IN_BATCH[0] = False
                HEARTBEAT[0] = time.monotonic()
            if state == "empty":
                if not waiting_entries(d):
                    drop_waiting_tree(repo, wt)
                if service:
                    continue
                return 0
            if once:
                return 0
            if state in ("landed", "rejected"):
                delays = backoff(float(os.environ.get("AGENTCTL_WAITING_POLL", WAITING_POLL)), 300)
                continue
            drop.nap(next(delays) if state in ("red", "held", "paused") else 5)


