# ---------------------------------------------------------------- helpers
def now():
    return dt.datetime.now(dt.timezone.utc)


def ts():
    return now().strftime("%Y-%m-%dT%H:%M:%SZ")


def err(msg):
    print(f"agentctl: {msg}", file=sys.stderr, flush=True)


def scratch():
    d = os.environ.get("AGENTCTL_SCRATCH")
    if not d:
        sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
        hits = sorted(glob.glob(f"/private/tmp/claude-{os.getuid()}/*/{sid}/scratchpad")) if sid else []
        d = hits[0] if hits else os.path.join(HOME, ".cache", "agentctl")
    os.makedirs(d, exist_ok=True)
    return d


def git(repo, *args, check=True, input=None):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, input=input)
    if check and r.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)} in {repo}: {r.stderr.strip()}")
    return r.stdout if check else r


def git_ok(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True).returncode == 0


def slug(repo_arg):
    if repo_arg in SHORT:
        return SHORT[repo_arg]
    if os.path.isdir(repo_arg):
        url = git(repo_arg, "remote", "get-url", REMOTE).strip()
        m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?/?$", url)
        if not m:
            raise SystemExit(f"agentctl: cannot parse remote url of {repo_arg}")
        return m.group(1)
    if re.fullmatch(r"[\w.-]+/[\w.-]+", repo_arg):
        return repo_arg
    raise SystemExit(f"agentctl: unknown repo {repo_arg!r}")


_tokens = {}


def token(o_r):
    if os.environ.get("GH_TOKEN"):
        return os.environ["GH_TOKEN"]
    ns = "movies" if o_r.startswith("pawelkrupinski/") else "bitcashier"
    if ns == "movies" and os.environ.get("FORGEJO_API_TOKEN"):  # a token the environment already carries
        return os.environ["FORGEJO_API_TOKEN"]
    if ns not in _tokens:
        r = subprocess.run(["secrets", "get", ns, "FORGEJO_API_TOKEN"], capture_output=True, text=True)
        if r.returncode != 0 or not r.stdout.strip():
            raise SystemExit(f"agentctl: could not read the {ns} FORGEJO_API_TOKEN from the vault")
        _tokens[ns] = r.stdout.strip()
    return _tokens[ns]


def gh_json(o_r, *args):
    env = dict(os.environ, GH_TOKEN=token(o_r))
    r = subprocess.run([FORGEJO_GH, *args, "-R", o_r], capture_output=True, text=True, env=env, timeout=300)
    if r.returncode != 0:
        raise RuntimeError(f"forgejo-gh {' '.join(args)}: {r.stderr.strip()[:300]}")
    return json.loads(r.stdout)


def api(o_r, method, path, params=None):
    url = f"{API}/repos/{o_r}/{path}" + ("?" + urllib.parse.urlencode(params) if params else "")
    req = urllib.request.Request(url, method=method, headers={"Authorization": f"token {token(o_r)}"})
    with urllib.request.urlopen(req, timeout=60) as resp:
        body = resp.read()
    return json.loads(body) if body else None


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def parse_time(s):
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))


# ---------------------------------------------------------------- wait
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
LOG_TS = re.compile(r"^\d{4}-\d\d-\d\dT[\d:.]+Z ")
STRONG = re.compile(r"\*\*\* FAILED|\[error\]|::error::|(?i:assertion|assert(ion)? failed)|\bError:|ENOENT|artifact already exists|(?i:exit code [1-9])|\bFAILED\b")
WEAK = re.compile(r"\bfail(ed|ure)?\b|\berror\b|exception|assert", re.I)
NOISE = re.compile(r"Setting level of logger|\|-INFO in ch\.qos|\berrors?[=:] ?0\b|\b0 (errors?|failed)\b|\b(INFO|DEBUG|TRACE)\b", re.I)
MEASURE_WORKFLOWS = {"Identity model convergence"}


def relevant_lines(log_text, tail):
    """{job: [last `tail` relevant lines]} from `forgejo-gh run view --log-failed` output (job<TAB>step<TAB>line).
    Strong markers (*** FAILED, [error], ::error::, assertion, exit code) win; plain fail/error words only when a job
    has none, and never from INFO/DEBUG log lines."""
    strong, weak, follow = {}, {}, {}
    for raw in log_text.splitlines():
        parts = raw.split("\t", 2)
        job, line = (parts[0], parts[2]) if len(parts) == 3 else ("?", raw)
        line = LOG_TS.sub("", ANSI.sub("", line)).rstrip()
        if not line:
            continue
        if follow.get(job):  # the 2 lines after a scalatest `*** FAILED ***` carry its reason
            follow[job] -= 1
            strong.setdefault(job, []).append(line[:300])
            continue
        if "*** FAILED ***" in line:
            follow[job] = 2
        if STRONG.search(line) and not re.search(r"Setting level of logger|-INFO in ch\.qos", line):
            strong.setdefault(job, []).append(line[:300])
        elif WEAK.search(line) and not NOISE.search(line):
            weak.setdefault(job, []).append(line[:300])
    return {j: (strong.get(j) or weak.get(j))[-tail:] for j in set(strong) | set(weak)}


def raw_tails(log_text, n=3):
    """{job: (line count, last n cleaned lines)} of a --log-failed output."""
    out = {}
    for raw in log_text.splitlines():
        parts = raw.split("\t", 2)
        job, line = (parts[0], parts[2]) if len(parts) == 3 else ("?", raw)
        line = LOG_TS.sub("", ANSI.sub("", line)).rstrip()
        cnt, last = out.get(job, (0, []))
        out[job] = (cnt + 1, (last + [line[:200]])[-n:])
    return out


def fetch_failed_log(o_r, run_id):
    env = dict(os.environ, GH_TOKEN=token(o_r))
    r = subprocess.run([FORGEJO_GH, "run", "view", str(run_id), "--log-failed", "-R", o_r], capture_output=True, text=True, env=env, timeout=300)
    return r.stdout


def fetch_takes_verdicts(o_r, run_id):
    """{artifact: verdict.txt text} of a measure run's identity-takes-<cc> artifacts (the takes rows' verdict files)."""
    env = dict(os.environ, GH_TOKEN=token(o_r))
    arts = gh_json(o_r, "api", f"repos/{o_r}/actions/runs/{run_id}/artifacts").get("artifacts", [])
    out = {}
    for a in arts:
        name = a.get("name", "")
        if not name.startswith("identity-takes-"):
            continue
        d = os.path.join(scratch(), "agentctl-wait", f"art-{run_id}-{name}")
        os.makedirs(d, exist_ok=True)
        subprocess.run([FORGEJO_GH, "run", "download", str(run_id), "-n", name, "-D", d, "-R", o_r], capture_output=True, env=env, timeout=300)
        p = os.path.join(d, "verdict.txt")
        out[name] = open(p, errors="replace").read().strip() if os.path.exists(p) else "(no verdict.txt in the artifact)"
    return out


def is_measure_run(d):
    return d.get("workflowName") in MEASURE_WORKFLOWS and (d.get("headBranch") or "").startswith("measure/")


def fetch_job_log(o_r, run_id, job_id):
    env = dict(os.environ, GH_TOKEN=token(o_r))
    r = subprocess.run([FORGEJO_GH, "run", "view", str(run_id), "--log", "--job", str(job_id), "-R", o_r],
                       capture_output=True, text=True, env=env, timeout=300)
    return r.stdout


ANNOTATION = re.compile(r"::error\b[^:]*::")
MAX_JOB_LOG_FETCHES = 5


def job_log_lines(o_r, run_id, job, tail):
    """Relevant lines from a job's WHOLE log. Forgejo's per-step slices (what --log-failed prints) are shifted by a
    few lines from the stored log, so a failed step's slice can hold only its neighbours' checkout/cache lines while
    its `::error` annotation and output sit just past it (run 1988, takes (united-kingdom)). `::error` annotations
    first, else the strong/weak markers."""
    jid = job.get("databaseId") if isinstance(job, dict) else None
    if not jid:
        return []
    try:
        log = fetch_job_log(o_r, run_id, jid)
    except Exception:
        return []
    clean = [LOG_TS.sub("", ANSI.sub("", (l.split("\t", 2)[2] if l.count("\t") >= 2 else l))).rstrip() for l in log.splitlines()]
    notes = [l[:300] for l in clean if ANNOTATION.search(l)]
    if notes:
        return notes[-tail:]
    name = job.get("name", "?")
    return relevant_lines("\n".join(f"{name}\t-\t{l}" for l in clean), tail).get(name, [])


def failure_detail(o_r, run_id, failed, tail):
    """failed: job dicts (name, databaseId) or names."""
    if not failed or tail <= 0:
        return []
    try:
        per = relevant_lines(fetch_failed_log(o_r, run_id), tail)
    except Exception as e:
        return [f"  (could not read the failed log: {e})"]
    out, fetched = [], 0
    for jd in failed:
        job = jd["name"] if isinstance(jd, dict) else jd
        lines = per.get(job) or next((v for k, v in per.items() if k in job or job in k), [])
        if not lines and fetched < MAX_JOB_LOG_FETCHES and isinstance(jd, dict):
            fetched += 1
            lines = job_log_lines(o_r, run_id, jd, tail)
        out.append(f"  -- {job}: " + ("no FAILED/error/assert line in its log (0-length log or setup failure? see `agentctl ci-why`)" if not lines else f"last {len(lines)} relevant line(s)"))
        out += [f"     {l}" for l in lines]
    return out


def run_verdict(o_r, run_id, until="done", tail=0):
    """(done, ok, text) for a Forgejo run. until=landable: a measure run is done once its takes rows ended."""
    d = gh_json(o_r, "run", "view", str(run_id), "--json", "status,conclusion,jobs,workflowName,headBranch")
    jobs = d.get("jobs") or []
    head = f"run {o_r}#{run_id}"
    if until == "landable" and is_measure_run(d):
        takes = [j for j in jobs if j.get("name", "").startswith("takes")]
        if d.get("status") == "completed" or (takes and all(j.get("status") == "completed" for j in takes)):
            badj = [j for j in takes if j.get("conclusion") not in ("success", "skipped")]
            bad = [j["name"] for j in badj]
            lines = [f"{head}: takes rows ended ({len(takes)}): " + ("all green" if not bad else "failed: " + ", ".join(bad))]
            try:
                for name, text in sorted(fetch_takes_verdicts(o_r, run_id).items()):
                    lines += [f"  [{name}] {l}" for l in text.splitlines()]
            except Exception as e:
                lines.append(f"  (could not read the verdict files: {e})")
            lines.append(f"  collect the LANDABLE verdict: scripts/identity-measure --run {run_id}")
            lines += failure_detail(o_r, run_id, badj, tail)
            return True, not bad and bool(takes), "\n".join(lines)
        n_done = sum(1 for j in takes if j.get("status") == "completed")
        return False, None, f"{head}: {d.get('status')} (takes rows {n_done}/{len(takes)} ended)"
    if d.get("status") != "completed":
        return False, None, f"{head}: {d.get('status')}"
    concl = d.get("conclusion") or "unknown"
    failedj = [j for j in jobs if j.get("conclusion") in ("failure", "cancelled", "timed_out")]
    failed = [j["name"] for j in failedj]
    line = f"{head}: {concl}" + (f"; failed: {', '.join(failed)}" if failed else "")
    lines = [line] + failure_detail(o_r, run_id, failedj, tail)
    return True, concl in ("success", "skipped", "neutral"), "\n".join(lines)


def file_verdict(path, contains):
    if not os.path.exists(path):
        return False, None, f"file {path}: absent"
    if contains:
        try:
            with open(path, errors="replace") as f:
                if not re.search(contains, f.read(), re.M):
                    return False, None, f"file {path}: present, no match for {contains!r}"
        except OSError as e:
            return False, None, f"file {path}: unreadable ({e})"
    st = os.stat(path)
    when = dt.datetime.fromtimestamp(st.st_mtime, dt.timezone.utc).strftime("%H:%M:%SZ")
    return True, True, f"file {path}: present ({st.st_size} bytes, mtime {when})"


def foreign_loops_on(run_id):
    """Other (non-agentctl) processes already polling this run id."""
    me = os.getpid()
    out = []
    for pid, ppid, etime, cmd in ps():
        if pid in (me, os.getppid()) or "agentctl" in cmd:
            continue
        if re.search(rf"run view {run_id}\b|runs/{run_id}\b", cmd) and "sleep" in cmd:
            out.append(pid)
    return out


def default_repo():
    try:
        return slug(os.getcwd())
    except (SystemExit, RuntimeError):
        return SHORT["movies"]


def backoff(floor, cap):
    """Poll delays: floor, x1.5 each time, never above cap (<= 300 s)."""
    d = floor
    while True:
        yield d
        d = min(cap, d * 1.5)


class Waiter:
    """One target waited on: holds the target's lock (and polls) or attaches to the live holder's verdict file."""

    def __init__(self, d, key, check):
        self.key, self.check = key, check
        self.lock, self.verdict = os.path.join(d, key + ".lock"), os.path.join(d, key + ".verdict")
        self.owned, self.holder, self.result = False, None, None

    def acquire(self):
        """True if we own the lock now; False if a live waiter holds it (self.holder = its info)."""
        while True:
            try:
                fd = os.open(self.lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            except FileExistsError:
                try:
                    info = json.load(open(self.lock))
                except (OSError, ValueError):
                    info = {}
                pid = info.get("pid")
                if pid and pid_alive(pid):
                    self.holder = info
                    return False
                err(f"stale lock (pid {pid} gone), taking over")
                try:
                    os.unlink(self.lock)
                except FileNotFoundError:
                    pass
                continue
            with os.fdopen(fd, "w") as f:
                json.dump({"pid": os.getpid(), "started": ts(), "target": self.key}, f)
            self.owned = True
            try:
                os.unlink(self.verdict)
            except FileNotFoundError:
                pass
            return True

    def poll_owned(self):
        try:
            done, ok, text = self.check()
        except Exception as e:  # transient API trouble: report and keep waiting
            done, ok, text = False, None, f"check failed: {e}"
        if done:
            tmp = self.verdict + f".{os.getpid()}"
            with open(tmp, "w") as f:
                json.dump({"ok": ok, "line": text, "at": ts()}, f)
            os.replace(tmp, self.verdict)
            self.result = (ok, text)
        return text

    def poll_attached(self):
        """Holder gone: read its verdict, or take over when it left none."""
        pid = (self.holder or {}).get("pid")
        if os.path.exists(self.lock) and pid and pid_alive(pid):
            return
        try:
            v = json.load(open(self.verdict))
            self.result = (v["ok"], v["line"])
        except (OSError, ValueError, KeyError):
            err(f"{self.key}: waiter pid {pid} ended without a verdict; taking over")
            self.holder = None
            if not self.acquire():
                return

    def release(self):
        if self.owned:
            try:
                os.unlink(self.lock)
            except FileNotFoundError:
                pass
            self.owned = False


def wait_all(waiters, timeout, floor, cap):
    """Block until every waiter has a verdict. Prints each verdict as it lands. Exit 0 all ok, 1 any failed, 2 timeout."""
    deadline = time.time() + timeout
    attach_poll = float(os.environ.get("AGENTCTL_ATTACH_POLL", "15"))
    for w in waiters:
        if not w.acquire():
            err(f"{w.key}: attached to existing waiter pid {w.holder.get('pid')} (since {w.holder.get('started')}); not polling Forgejo")
    delays = backoff(floor, cap)
    next_check, last = 0.0, {}
    try:
        while True:
            pending = [w for w in waiters if w.result is None]
            if time.time() >= next_check:
                for w in pending:
                    if w.owned:
                        last[w.key] = w.poll_owned()
                        if w.result:
                            print(w.result[1], flush=True)
                next_check = time.time() + next(delays)
            for w in pending:
                if w.result is None and not w.owned:
                    w.poll_attached()
                    if w.result:
                        print(w.result[1], flush=True)
            pending = [w for w in waiters if w.result is None]
            if not pending:
                return 0 if all(w.result[0] for w in waiters) else 1
            if time.time() >= deadline:
                for w in pending:
                    print(f"TIMEOUT after {timeout}s; last: {last.get(w.key, 'attached to another waiter')}", flush=True)
                return 2
            step = next_check - time.time()
            if any(not w.owned for w in pending):
                step = min(step, attach_poll)
            time.sleep(max(0.05, min(step, deadline - time.time())))
    finally:
        for w in waiters:
            w.release()


def cmd_wait(a):
    floor = float(os.environ.get("AGENTCTL_MIN_INTERVAL", "60"))
    cap = max(floor, min(300, a.interval))
    d = os.path.join(scratch(), "agentctl-wait")
    os.makedirs(d, exist_ok=True)
    if a.kind == "run":
        ids = list(a.ids)
        repo = a.repo
        if ids and not ids[0].isdigit():  # legacy form: wait run <repo> <id>...
            repo = repo or ids[0]
            ids = ids[1:]
        if not ids or not all(i.isdigit() for i in ids):
            raise SystemExit("agentctl: wait run needs numeric run ids (action_run.id, the GITHUB_RUN_ID)")
        o_r = slug(repo) if repo else default_repo()
        waiters = []
        for i in dict.fromkeys(ids):
            others = foreign_loops_on(i)
            if others:
                err(f"note: other loops already poll run {i}: pids {others} (see `agentctl orphans`)")
            key = f"run-{o_r.replace('/', '_')}-{i}" + ("-landable" if a.until == "landable" else "")
            waiters.append(Waiter(d, key, (lambda i=i: run_verdict(o_r, int(i), a.until, a.tail))))
        return wait_all(waiters, a.timeout, floor, cap)
    path = os.path.abspath(a.target)
    key = "file-" + re.sub(r"[^\w.-]", "_", path)[-150:]
    return wait_all([Waiter(d, key, lambda: file_verdict(path, a.contains))], a.timeout, min(floor, a.interval), max(min(floor, a.interval), min(300, a.interval)))


# ---------------------------------------------------------------- ci-why
# Exactly the workflows movies' scripts/hooks/pre-push check_redgate reads (GatingWorkflows / GatingWorkflowFiles).
GATING = {"pawelkrupinski/movies": [("Main", "main.yml"), ("Identity model convergence", "identity-model-convergence.yml"),
                                    ("Record scrape fixtures", "record-scrape-fixtures.yml")]}
SETUP_STEP = re.compile(r"^(Set up job|Initialize containers|actions/checkout|Checkout|.*(download|upload)-artifact|.*cache@|Set up .*runner)", re.I)
INFRA_LOG = re.compile(r"artifact already exists|ENOENT|No space left on device|Cannot connect to the Docker daemon|"
                       r"connection (refused|reset)|Could not resolve host|TLS handshake timeout|runner .* lost|context deadline exceeded|"
                       r"The operation was canceled|exit code 137|Killed", re.I)
RUN_FIELDS = "databaseId,number,status,conclusion,headSha,url,displayTitle,workflowName,createdAt"


def repo_path_for(o_r):
    for p in REPOS:
        if os.path.isdir(p) and git_ok(p, "remote", "get-url", REMOTE):
            try:
                if slug(p) == o_r:
                    return p
            except (SystemExit, RuntimeError):
                pass
    return None


def commit_line(o_r, sha, repo=None):
    repo = repo or repo_path_for(o_r)
    if repo and git_ok(repo, "cat-file", "-e", f"{sha}^{{commit}}"):
        return git(repo, "log", "-1", "--format=%h %an <%ae> %ad: %s", "--date=format:%m-%d %H:%M", sha).strip()
    try:
        c = gh_json(o_r, "api", f"repos/{o_r}/git/commits/{sha}")
        a = c.get("author") or c.get("commit", {}).get("author", {})
        msg = c.get("message") or c.get("commit", {}).get("message", "")
        return f"{sha[:9]} {a.get('name')} <{a.get('email')}>: {msg.splitlines()[0] if msg else ''}"
    except Exception:
        return sha[:9]


def classify_job(job, lines, raw=(0, [])):
    """('infra'|'unclear'|'test', why) for one failed job, from its steps, relevant log lines and raw (count, tail)."""
    bad = [s for s in job.get("steps") or [] if s.get("conclusion") in ("failure", "timed_out")]
    step = bad[0]["name"] if bad else None
    if step and SETUP_STEP.match(step):
        return "infra", f"failed in setup step '{step}' (often a `needs:` cascade or runner/setup trouble)"
    if not raw[0] and not lines:
        return "infra", "0-length log" + (f" (step '{step}')" if step else "")
    hit = next((l for l in lines if INFRA_LOG.search(l)), None)
    if hit and not any("*** FAILED" in l or "[error]" in l for l in lines):
        return "infra", f"infra-shaped log line: {hit[:120]}"
    if not lines:
        tail = " | ".join(raw[1])
        return "unclear", f"{raw[0]}-line log with no FAILED/error/assert line (truncated? runner lost?) in step '{step}'; ends: {tail}"
    return "test", f"failed step '{step}'" if step else "test failure"


def gate_runs(o_r):
    """[(workflow, newest decided run on main | None, newer unfinished run | None)]."""
    flows = GATING.get(o_r)
    if not flows:
        recent = gh_json(o_r, "run", "list", "--branch", "main", "--limit", "40", "--json", RUN_FIELDS)
        flows = [(n, n) for n in dict.fromkeys(r["workflowName"] for r in recent)]
    out = []
    for name, wfile in flows:
        runs = gh_json(o_r, "run", "list", "--workflow", wfile, "--branch", "main", "--limit", "30", "--json", RUN_FIELDS)
        decided = next((r for r in runs if r.get("status") == "completed" and r.get("conclusion") in ("success", "failure", "timed_out")), None)
        newer = next((r for r in runs if r.get("status") != "completed"), None)
        if newer and decided and newer["databaseId"] < decided["databaseId"]:
            newer = None
        out.append((name, decided, newer))
    return out


def explain_run(o_r, run, tail, repo=None):
    """Lines explaining one red run: commit, failed jobs, their log tails, infra vs test."""
    rid = run["databaseId"]
    d = gh_json(o_r, "run", "view", str(rid), "--json", "jobs,headSha,url,number,conclusion,workflowName")
    num = d.get("number") or run.get("number")
    failed = [j for j in d.get("jobs") or [] if j.get("conclusion") in ("failure", "timed_out")]
    try:
        log = fetch_failed_log(o_r, rid) if failed else ""
    except Exception as e:
        log = ""
        err(f"could not read run {rid}'s failed log: {e}")
    per, raws = relevant_lines(log, tail), raw_tails(log)
    lines = [f"  run id {rid} (#{num}) {d.get('url') or run.get('url')}",
             f"  commit {commit_line(o_r, d.get('headSha') or run.get('headSha'), repo)}"]
    kinds, fetched = [], 0
    for j in failed:
        jl = per.get(j["name"]) or []
        bad = [st for st in j.get("steps") or [] if st.get("conclusion") in ("failure", "timed_out")]
        setup = bool(bad) and bool(SETUP_STEP.match(bad[0]["name"]))
        if not jl and not setup and fetched < MAX_JOB_LOG_FETCHES:  # a shifted step slice: read the whole job log
            fetched += 1
            jl = job_log_lines(o_r, rid, j, tail)
        kind, why = classify_job(j, jl, raws.get(j["name"], (0, [])))
        kinds.append(kind)
        lines.append(f"  [{kind}] {j['name']}: {why}")
        lines += [f"      {l}" for l in jl]
    rerun = f"rerun: {FORGEJO_GH.replace(HOME, '~')} run rerun {rid} --failed -R {o_r}"
    if "test" in kinds:
        verdict = "TEST FAILURE"
    elif "unclear" in kinds:
        verdict = f"UNCLEAR (a failed step logged no FAILED/error line: read `forgejo-gh run view {rid} --log-failed`; if infra, {rerun})"
    else:
        verdict = f"INFRA-SHAPED ({rerun})" if kinds else "no failed job listed"
    lines.insert(0, f"  verdict: {verdict}")
    return lines, num


def ci_why(o_r, tail=6, run_id=None, repo=None):
    """(red, text). run_id: explain that one run; else the gating workflows' newest decided runs on main."""
    if run_id:
        lines, _ = explain_run(o_r, {"databaseId": int(run_id)}, tail, repo)
        return True, f"run {o_r}#{run_id}\n" + "\n".join(lines)
    out, red = [], False
    for name, decided, newer in gate_runs(o_r):
        pending = f"; newer run {newer['databaseId']} (#{newer.get('number')}) {newer.get('status')} may clear it" if newer else ""
        if not decided:
            out.append(f"{name}: no decided run on main")
            continue
        if decided["conclusion"] == "success":
            out.append(f"{name}: GREEN (run {decided['databaseId']} #{decided.get('number')})")
            continue
        red = True
        out.append(f"{name}: RED (run {decided['databaseId']} #{decided.get('number')}, {decided['conclusion']}){pending}")
        lines, num = explain_run(o_r, decided, tail, repo)
        out += lines
        out.append(f"  clears when: a later {name} run on main is green, or every pushed commit touching a production path "
                   f"carries `Fixes-Red: {num}` (or `Fixes-Red: {decided['databaseId']}`); tools-only commits land while red")
    head = f"ci-why {o_r}: " + ("main is RED for the gate" if red else "main is green for the gate")
    return red, "\n".join([head] + out)


def cmd_ci_why(a):
    o_r = slug(a.repo) if a.repo else default_repo()
    target = None if a.target in (None, "main") else a.target
    if target and not target.isdigit():
        raise SystemExit("agentctl: ci-why takes a run id or `main`")
    red, text = ci_why(o_r, a.tail, target)
    print(text)
    return 1 if red else 0


# ---------------------------------------------------------------- land / env
SDKMAN_BINS = [f"{HOME}/.sdkman/candidates/sbt/current/bin", f"{HOME}/.sdkman/candidates/java/current/bin"]
RACE = re.compile(r"non-fast-forward|cannot lock ref|fetch first|failed to update ref|stale info|incorrect old value|"
                  r"reference already exists|remote rejected.*(lock|update)", re.I)
# The hook REFUSING for red (its "is RED on main" warnings also print when tools-only commits land while red: not a refusal)
REDGATE = re.compile(r"main is red: only a fix|carries no Fixes-Red")
TUNNEL_TROUBLE = re.compile(r"GitOps manifests STALE|Connection to localhost closed|forgejo\.internal.*(refused|unreachable)|"
                            r"Could not read from remote repository|Connection refused", re.I)
LAND_RETRIES = 3
# One lander per repository: with no pre-merge CI left (movies, 2026-10-26) a landing is the hook's local tests --
# minutes for an identity or page change -- and two landers would each test a base the other is about to move, then
# race, rebase, and test again. Agents wait for the lock instead (land runs in the background), and it caps the
# laptop at one landing hook's JVM at a time.
LAND_LOCK_DIR = os.path.join(HOME, ".cache", "agentctl", "land")
LAND_LOCK_TIMEOUT = 4 * 3600


def tool_env():
    """os.environ with sdkman's sbt and java first on PATH (the movies hook's sbt check needs them)."""
    env = dict(os.environ)
    path = env.get("PATH", "").split(":")
    env["PATH"] = ":".join([b for b in SDKMAN_BINS if os.path.isdir(b) and b not in path] + path)
    java_home = f"{HOME}/.sdkman/candidates/java/current"
    if not env.get("JAVA_HOME") and os.path.isdir(java_home):
        env["JAVA_HOME"] = java_home
    return env


def push_argv(remote, src, dst="main"):
    argv = ["git", "push", remote, f"{src}:refs/heads/{dst}"]
    assert not any(a in ("--no-verify", "-n", "--force", "-f") or a.startswith("--force") for a in argv)
    return argv


class Stash:
    """A NAMED stash (git's stash list is shared by every worktree of a clone): found again by its own sha, never by
    position, and restored exactly once."""

    def __init__(self, repo):
        self.repo, self.name, self.sha = repo, f"agentctl-land-{os.getpid()}-{int(time.time())}", None

    def save(self):
        git(self.repo, "stash", "push", "--include-untracked", "-m", self.name)
        for line in git(self.repo, "stash", "list", "--format=%H %gs").splitlines():
            sha, _, msg = line.partition(" ")
            if msg.endswith(self.name):
                self.sha = sha
                return
        raise RuntimeError(f"stash {self.name} not found after saving it")

    def restore(self):
        if not self.sha:
            return True
        r = git(self.repo, "stash", "apply", "--index", self.sha, check=False)
        if r.returncode != 0:
            r = git(self.repo, "stash", "apply", self.sha, check=False)
        if r.returncode != 0:
            err(f"could not re-apply stash {self.name} ({self.sha[:10]}): {r.stderr.strip()[:200]}; it is kept: "
                f"`git stash list | grep {self.name}`")
            return False
        for i, line in enumerate(git(self.repo, "stash", "list", "--format=%H").splitlines()):
            if line.strip() == self.sha:
                git(self.repo, "stash", "drop", f"stash@{{{i}}}", check=False)
                break
        self.sha = None
        return True


def landed(repo, sha, main_ref):
    if git_ok(repo, "merge-base", "--is-ancestor", sha, main_ref):
        return "ancestor"
    lines = git(repo, "cherry", main_ref, sha).splitlines()
    if lines and all(l.startswith("-") for l in lines):
        return "patch-equivalent"
    return None


def land_lock_path(repo):
    """One lock per repository: every worktree of a clone shares its git common dir."""
    common = os.path.realpath(git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir").strip())
    return os.path.join(LAND_LOCK_DIR, re.sub(r"[^A-Za-z0-9._-]", "_", common.strip("/")) + ".lock")


@contextlib.contextmanager
def land_lock(repo):
    """Hold the repository's landing lock (an flock, freed by the kernel when the holder dies), waiting for it with one
    line saying who holds it. Yields True when held, False when the wait timed out."""
    path = land_lock_path(repo)
    os.makedirs(LAND_LOCK_DIR, exist_ok=True)
    f = open(path, "a+")
    try:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            f.seek(0)
            err(f"waiting for the landing lock ({path}), held by: {f.read().strip() or 'unknown'}")
            deadline = time.monotonic() + float(os.environ.get("AGENTCTL_LAND_LOCK_TIMEOUT", LAND_LOCK_TIMEOUT))
            while True:
                try:
                    fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() > deadline:
                        yield False
                        return
                    time.sleep(5)
            err("got the landing lock")
        f.seek(0)
        f.truncate()
        f.write(f"pid {os.getpid()} {repo} since {ts()}\n")
        f.flush()
        yield True
    finally:
        f.close()


def precheck_hook(repo):
    """The repo's own pre-push hook, when it has one with a dry-run mode (movies: scripts/hooks/pre-push --range)."""
    hook = os.path.join(repo, "scripts", "hooks", "pre-push")
    return hook if os.access(hook, os.X_OK) else None


def cmd_land(a):
    if os.environ.get("PREPUSH_SKIP"):
        print("NOT LANDED: PREPUSH_SKIP is set in the environment; agentctl land never skips checks. `unset PREPUSH_SKIP`.")
        return 1
    repo = git(a.repo or os.getcwd(), "rev-parse", "--show-toplevel").strip()
    main_ref = f"refs/remotes/{REMOTE}/main"
    env = tool_env()
    log_path = os.path.join(scratch(), f"agentctl-land-{os.path.basename(repo)}-{os.getpid()}.log")

    def sh(*args):
        return subprocess.run(args, cwd=repo, capture_output=True, text=True, env=env)

    dirty = git(repo, "status", "--porcelain", "--untracked-files=no").strip()
    stash = None
    if dirty and not a.stash:
        print(f"NOT LANDED: the working tree has uncommitted changes ({len(dirty.splitlines())} file(s)). Commit them, or "
              "pass --stash to set them aside in a named stash and restore them afterwards.")
        return 1
    if a.branch:
        r = sh("git", "rev-parse", "--abbrev-ref", "HEAD")
        if r.stdout.strip() != a.branch:
            if dirty:
                print("NOT LANDED: --branch with a dirty tree; commit first")
                return 1
            r = sh("git", "switch", a.branch)
            if r.returncode:
                print(f"NOT LANDED: cannot switch to {a.branch}: {r.stderr.strip()}")
                return 1
    try:
        if dirty:
            stash = Stash(repo)
            stash.save()
            err(f"stashed local changes as {stash.name} ({stash.sha[:10]})")
        a.landed_sha, a.pushed_at = None, None
        with land_lock(repo) as held:
            if not held:
                print("NOT LANDED: timed out waiting for the landing lock (another land is running its checks); land again.")
                return 1
            rc = land_loop(repo, main_ref, sh, log_path, a)
    finally:
        if stash and not stash.restore():
            print(f"WARNING: local changes are in stash {stash.name}, not restored")
    if rc != 0 or not a.landed_sha or getattr(a, "no_watch", False):
        return rc
    # the lock is free again: the next lander goes while this one watches main's CI
    return watch_landed(repo, a.landed_sha, a.pushed_at)


def land_loop(repo, main_ref, sh, log_path, a):
    for attempt in range(LAND_RETRIES + 1):
        r = sh("git", "fetch", "--quiet", REMOTE, "main")
        if r.returncode:  # a tunnel restart is seconds long: one more try before giving up
            err(f"git fetch failed ({r.stderr.strip()[:120]}); retrying once in 15 s")
            time.sleep(15)
            r = sh("git", "fetch", "--quiet", REMOTE, "main")
        if r.returncode:
            print(f"NOT LANDED: git fetch {REMOTE} main failed: {r.stderr.strip()[:300]} (tunnel? `agentctl env --check`)")
            return 1
        head = git(repo, "rev-parse", "HEAD").strip()
        if landed(repo, head, main_ref):
            print(f"LANDED {head} (already on {REMOTE}/main)")
            return 0
        r = sh("git", "rebase", "--quiet", f"{REMOTE}/main")
        if r.returncode:
            conflicts = git(repo, "diff", "--name-only", "--diff-filter=U", check=False).stdout.split()
            sh("git", "rebase", "--abort")
            print(f"NOT LANDED: rebase onto {REMOTE}/main conflicts in: {', '.join(conflicts) or r.stderr.strip()[:300]}. "
                  "Resolve by hand (git rebase forgejo/main), then land again.")
            return 1
        head = git(repo, "rev-parse", "HEAD").strip()
        if landed(repo, head, main_ref):
            print(f"LANDED {head} (the rebase left nothing: already on {REMOTE}/main)")
            return 0
        problems = check_range(repo, f"{REMOTE}/main", head, [], int(os.environ.get("AGENTCTL_MAX_FOREIGN", "2")))
        if problems:
            print("NOT LANDED: prepush-check refused:\n  " + "\n  ".join(problems))
            return 1
        hook = precheck_hook(repo)
        if hook:
            # CHECK FIRST: the hook's dry run over exactly what the push will carry (its pass is stored, so the push's own
            # hook run reuses it in seconds). A long hook inside `git push` holds the push's ssh connection idle, and a
            # tunnel drop kills it after "all clear" (2026-10-23); the area tests make long hooks the norm.
            err(f"checking {head[:10]}: {os.path.relpath(hook, repo)} --range {REMOTE}/main..HEAD (log: {log_path})")
            r = sh(hook, "--range", f"{REMOTE}/main..{head}")
            with open(log_path, "a") as f:
                f.write(f"=== check {attempt + 1} {ts()} {head}\n{r.stdout}{r.stderr}\n")
            if r.returncode != 0:
                return refused(repo, r.stdout + r.stderr, log_path, "the pre-push checks failed")
        err(f"pushing {head[:10]} to {REMOTE}/main (attempt {attempt + 1}/{LAND_RETRIES + 1}; hook log: {log_path})")
        a.pushed_at = time.time()
        r = sh(*push_argv(REMOTE, head))
        with open(log_path, "a") as f:
            f.write(f"=== attempt {attempt + 1} {ts()} {head}\n{r.stdout}{r.stderr}\n")
        out = r.stdout + r.stderr
        if r.returncode == 0:
            sh("git", "fetch", "--quiet", REMOTE, "main")
            how = landed(repo, head, main_ref)
            if how:
                print(f"LANDED {head}" + ("" if how == "ancestor" else f" ({how})"), flush=True)
                a.landed_sha = head
                return 0
            print(f"NOT LANDED: the push exited 0 but {head[:10]} is not on {REMOTE}/main after a fetch; see {log_path}")
            return 1
        if RACE.search(out) and attempt < LAND_RETRIES:
            err(f"push race ({RACE.search(out).group(0)}): refetch, rebase, retry")
            time.sleep(min(30, 2 + 3 * attempt))
            continue
        if RACE.search(out) and not REDGATE.search(out):
            print(f"NOT LANDED: still racing after {LAND_RETRIES} retries ({RACE.search(out).group(0)}); try again shortly.")
            return 1
        return refused(repo, out, log_path, "the push failed (pre-push hook or remote)")
    return 1


def refused(repo, out, log_path, what):
    """Print the NOT LANDED line for a hook or push that said no: the red gate explained by ci-why, a tunnel hinted."""
    tail = "\n  ".join([l for l in out.splitlines() if l.strip()][-25:])
    if REDGATE.search(out):
        print(f"NOT LANDED: the red gate refused the push (main is red).\n  {tail}")
        try:
            print(ci_why(slug(repo), 4, repo=repo)[1])
        except Exception as e:
            print(f"(agentctl ci-why failed: {e})")
        return 1
    hint = ""
    if TUNNEL_TROUBLE.search(out):
        hint = ("\n  HINT: the hook could not reach Forgejo (tunnel dropped?): `~/bin/agentctl env --check` "
                "(it says the kickstart fix), then land again.")
    print(f"NOT LANDED: {what}. Last lines (full log {log_path}):\n  {tail}{hint}")
    return 1


# ---------------------------------------------------------------- land: the watch after LANDED
# The owner (2026-10-26): "whenever an agent pushed to main, make a script watch the corresponding convergence and main
# build and tell the agent if it fails". With no pre-merge CI, main's CI is where a change is tested in full: land keeps
# running after LANDED until Main and the convergence say green or red, so the agent (land in the background) hears it.
WATCH = {"pawelkrupinski/movies": {"main": ("Main", "main.yml"),
                                   "convergence": ("Identity model convergence", "identity-model-convergence.yml")}}
WATCH_TIMEOUT = 3 * 3600          # either run undecided by then: exit 2, could not tell
WATCH_CONV_START = 3600           # no convergence run containing the sha started by then: said, not waited for
WATCH_SLACK = 120                 # clock skew between the laptop and Forgejo's createdAt
WATCH_ERRORS = 10                 # consecutive failed API reads before giving up (exit 2)
UNDECIDED = ("cancelled", "skipped", "neutral", "")


def contains(repo, sha, head):
    """Whether a run's head commit contains sha (fetching main once when head is unknown here)."""
    if not head:
        return False
    if head == sha:
        return True
    if not git_ok(repo, "cat-file", "-e", f"{head}^{{commit}}"):
        git(repo, "fetch", "--quiet", REMOTE, "main", check=False)
    return git_ok(repo, "merge-base", "--is-ancestor", sha, head)


def is_cancelled(r):
    return r.get("status") == "completed" and (r.get("conclusion") or "") in UNDECIDED


def pick_main_run(repo, sha, runs):
    """Main's run for sha: its own push run, unless that was cancelled or never came (a newer push superseded it); then the
    newest run whose head contains sha."""
    own = next((r for r in runs if r.get("headSha") == sha and not is_cancelled(r)), None)
    if own:
        return own
    later = [r for r in runs if not is_cancelled(r) and contains(repo, sha, r.get("headSha"))]
    return max(later, key=lambda r: r["databaseId"]) if later else None


def pick_convergence_run(repo, sha, runs, pushed_at):
    """The FIRST convergence run on main created after the push whose head contains sha -- this commit's kick, a later
    push's, or the daily run (the owner, 2026-10-26: never hunt the sha's own kick). A cancelled one (the lane replaced
    it) passes to the next."""
    after = [r for r in runs if r.get("createdAt") and parse_time(r["createdAt"]).timestamp() >= pushed_at - WATCH_SLACK]
    ok = [r for r in sorted(after, key=lambda r: r["databaseId"]) if not is_cancelled(r) and contains(repo, sha, r.get("headSha"))]
    return ok[0] if ok else None


def watch_landed(repo, sha, pushed_at, o_r=None):
    """Watch Main and the convergence for a landed sha. 0 green (or nothing to watch), 3 red, 2 could not tell."""
    o_r = o_r or slug(repo)
    flows = WATCH.get(o_r)
    if not flows:
        print(f"watch: no CI watched for {o_r} (only movies' Main and convergence are)")
        return 0
    pushed_at = pushed_at or time.time()
    timeout = float(os.environ.get("AGENTCTL_WATCH_TIMEOUT", WATCH_TIMEOUT))
    conv_start = float(os.environ.get("AGENTCTL_WATCH_CONV_START", WATCH_CONV_START))
    t0 = time.time()
    err(f"watching Main and the convergence for {sha[:10]} (up to {int(timeout // 60)} min; `--no-watch` skips this)")
    done, errors, said = {}, 0, set()  # kind -> (run, ok | None for none started)
    delays = backoff(float(os.environ.get("AGENTCTL_WATCH_POLL", 60)), 300)
    while True:
        try:
            for kind, (name, wfile) in flows.items():
                if kind in done:
                    continue
                runs = gh_json(o_r, "run", "list", "--workflow", wfile, "--branch", "main", "--limit", "30",
                               "--json", RUN_FIELDS)
                run = pick_main_run(repo, sha, runs) if kind == "main" else pick_convergence_run(repo, sha, runs, pushed_at)
                if run is None:
                    if kind == "convergence" and time.time() - t0 >= conv_start:
                        done[kind] = (None, None)
                        print(f"convergence: none started within {int(conv_start // 60)} min of the push", flush=True)
                    continue
                if (kind, run["databaseId"]) not in said:
                    said.add((kind, run["databaseId"]))
                    err(f"{name}: following run #{run.get('number')} ({run.get('status')}, head {str(run.get('headSha'))[:10]})")
                if run.get("status") == "completed" and not is_cancelled(run):
                    done[kind] = (run, run.get("conclusion") == "success")
                    print(f"{name} #{run.get('number')}: {run.get('conclusion')}", flush=True)
            errors = 0
        except Exception as e:  # a tunnel blip or a token hiccup: read again, give up after a run of them
            errors += 1
            err(f"watch: could not read the runs ({str(e)[:160]}) [{errors}/{WATCH_ERRORS}]")
            if errors >= WATCH_ERRORS:
                print(f"WATCH UNKNOWN: could not read Forgejo's runs {errors} times in a row; check `agentctl ci-why` later")
                return 2
        reds = [(k, r) for k, (r, ok) in done.items() if ok is False]
        if reds:
            for kind, r in reds:
                d = gh_json(o_r, "run", "view", str(r["databaseId"]), "--json", "jobs")
                failed = [j["name"] for j in d.get("jobs") or [] if j.get("conclusion") in ("failure", "timed_out", "cancelled")]
                print(f"WATCH RED: {flows[kind][0]} #{r.get('number')} {', '.join(failed) or r.get('conclusion')} "
                      f"(it contains your {sha[:10]}: if your change broke it, fix forward now with `Fixes-Red: "
                      f"{r.get('number')}`)")
            try:
                print(ci_why(o_r, 4, repo=repo)[1])
            except Exception as e:
                print(f"(agentctl ci-why failed: {e})")
            return 3
        if len(done) == len(flows):
            parts = [f"{flows[k][0].split()[0] if k == 'main' else 'convergence'} " +
                     (f"#{r.get('number')} green" if r else "none started") for k, (r, ok) in done.items()]
            print("WATCH OK: " + ", ".join(sorted(parts, key=lambda x: not x.startswith("Main"))))
            return 0
        if time.time() - t0 >= timeout:
            left = ", ".join(flows[k][0] for k in flows if k not in done)
            print(f"WATCH UNKNOWN: {left} undecided after {int(timeout // 60)} min; check `agentctl ci-why` later")
            return 2
        time.sleep(next(delays))


