        with open(path, "w") as f:
            f.write(f"# sbt server pid {pid}, checkout {cwd}\n{r.stdout}{r.stderr}")
        return path
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"(no thread dump: {e})"


def is_sbt(cmd):
