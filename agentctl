        (f"; fixers: {' | '.join(verdicts[-4:])}" if verdicts else "; no fixer dispatched")
    return (f"failing: {failing}. tried: {tried}. only the owner: {OWNER_CAUSES[owner_cause]}. run: `! {cmd}`. "
            f"auto-clears when {words}")


# -- owner blocks are leases (design §5.3 blocked-external; phase 1 step 11)
# A block is a lease `block/<key>` (one red) or `block/cause/<name>` (ONE external cause holding every red it explains),
# holder `owner:<owner cause>`, TTL 10 min, max 7 d. Only the tick renews it, and only while its probe still fails AND
# its justification holds for a red it holds (an owner cause, the owner's exact command, never a TEST FAILURE, no live
# fixer). Its probe passing, the justification gone, or the max hold: it lapses, and its reds go on (verify / offered).
BLOCK_TTL, BLOCK_MAX = 10 * 60, 7 * 86400
BLOCK_PROBE_EVERY = 60


def block_lease(key=None, cause=None):
    return f"block/cause/{re.sub(r'[^\w.-]+', '_', cause)}" if cause else f"block/{key}"


def red_block_of(it, store=None):
    """{name, text, cause, until, meta} of the live block lease holding this red, or None."""
    st = store or Store()
    d = it["data"]
    for row in st.list("block/"):
        if lease_is_live(row, st.clock()):
            m = lease_meta(row)
            if d.get("key") in (m.get("keys") or []):
                return {"name": row["name"], "text": m.get("text") or "BLOCKED ON OWNER", "cause": m.get("cause"),
                        "until": m.get("until"), "meta": m}
    return None


def block_invalid(store, it, m, t):
    """Why this block no longer justifies holding red `it`, or None (checked at the block AND every tick)."""
    d = it["data"]
    if m.get("crash_loop"):  # the fixers crash-looped on it (red_crash_loop): the harness, never the code, is the cause
        row = store.get(red_lease(d["key"]))
        return f"a live fixer is on it: {row['holder']}" if lease_is_live(row, t) else None
    if m.get("wait_cause") in WAIT_CAUSES:  # an external wait (a spent quota): no owner cause, no owner command
        if d.get("kind") == "test":
            return "its red is a TEST FAILURE: a code red is a fixer's"
        row = store.get(red_lease(d["key"]))
        return f"a live fixer is on it: {row['holder']}" if lease_is_live(row, t) else None
    if QUOTA_LOG.search(str(d.get("line") or "")) or QUOTA_LOG.search(str(m.get("details") or m.get("text") or "")):
        return "a spent quota resets on its own: an external wait, never the owner's"
    if m.get("owner_cause") not in OWNER_CAUSES:
        return f"no owner cause (one of {', '.join(OWNER_CAUSES)}): only the owner's causes may block on the owner"
    if not str(m.get("cmd") or "").strip():
        return "no owner command"
    if d.get("kind") == "test":
        return "its red is a TEST FAILURE: a code red is never the owner's"
    row = store.get(red_lease(d["key"]))
    if lease_is_live(row, t):
        return f"a live fixer is on it: {row['holder']}"
    return None


def red_renew_blocks(store, t):
    """The tick's look at every live block: its probe (at most every BLOCK_PROBE_EVERY s) and its justification per red.
    Still failing and still justified: renewed (the probe's fresh failing result is its progress). Otherwise it lapses
    now (revoked, the reason in its outcome) or a red that lost its justification is detached from it."""
    out = []
    active = {it["data"]["key"]: it for it in red_active(store).values()}
    for row in store.list("block/"):
        if not lease_is_live(row, t):
            continue
        m = lease_meta(row)
        keys = [k for k in m.get("keys") or [] if k in active]
        dropped = [(k, block_invalid(store, active[k], m, t)) for k in keys]
        dropped = [(k, why) for k, why in dropped if why]
        keep = [k for k in keys if k not in {k_ for k_, _w in dropped}]
        for k, why in dropped:
            out.append(f"dropped the owner block of {red_what(active[k]['data'])}: {why}")
        if not keep:
            why = dropped[0][1] if dropped else "it holds no open red"
            store.revoke(row["name"], f"INVALID: {why}")
            out.append(f"block {row['name']} lapsed: {why}")
            continue
        if keep != m.get("keys"):
            store.set_meta(row["name"], row["epoch"], row["secret"], {"keys": keep})
        if t - float(m.get("probed_at") or 0) < BLOCK_PROBE_EVERY:
            store.renew(row["name"], row["epoch"], row["secret"], f"held@{int(t // BLOCK_PROBE_EVERY)}", BLOCK_TTL)
            continue
        pr = m.get("probe") or {}
        r = run_probe(pr.get("kind"), pr.get("args")) if pr.get("kind") in PROBES else None
        store.set_meta(row["name"], row["epoch"], row["secret"], {"probed_at": t, "last": r.detail if r else "no probe"})
        if r is not None and r.ok:
            store.revoke(row["name"], f"PROBE PASSED: {r.detail}")
            out.append(f"RECOVERED: {m.get('until')} ({r.detail}): the block {row['name']} lapsed")
            line = f"RECOVERED: {m.get('until')} ({r.detail}): {m.get('text', '')[:200]}"
            inbox_write("recover", line, [line], [], 0)
            continue
        store.renew(row["name"], row["epoch"], row["secret"], f"{r.detail if r else 'cannot tell'}@{int(t)}", BLOCK_TTL)
    return out


# A SPENT QUOTA IS AN EXTERNAL WAIT, NOT THE OWNER'S (the owner's coordinator, 2026-10-29: Record scrape fixtures #2426
# sat BLOCKED ON OWNER for OMDb's `HTTP 401: Request limit reached` -- a daily quota, which resets on its own; only an
# invalid key is the owner's). A red whose error line says a quota is spent is held by a WAIT lease (block/cause/quota-
# <service>, holder `wait:quota`), never offered to a fixer and never an owner block. Its probe re-checks the key the
# cheap way the workflow itself does: the red's workflow dispatched on main once the quota's window has reset (OMDb's
# daily window: midnight UTC), whose first job (the recording preflight: one OMDb call) fails within minutes if the key
# is still refused; the wait clears when a run of the workflow created after the block got past that job.
QUOTA_LOG = re.compile(r"request limit reached|daily limit|quota (exceeded|reached|exhausted)|rate limit(ed)? reached|"
                       r"too many requests", re.I)
WAIT_CAUSES = {"quota": "an outside service's quota for the run's key, spent; it resets on its own"}
QUOTA_RESET_HOUR_UTC = 0


def quota_service(line):
    m = re.search(r"::error[^:]*::(\w+) refuses the key", line or "") or re.search(r"\b(OMDb|TMDB|Decodo)\b", line or "", re.I)
    return m.group(1) if m else "the service"


def next_quota_reset(after):
    """The first quota window reset (QUOTA_RESET_HOUR_UTC, daily) after unix time `after`."""
    d = dt.datetime.fromtimestamp(after, dt.timezone.utc)
    r = d.replace(hour=QUOTA_RESET_HOUR_UTC, minute=0, second=0, microsecond=0)
    if r <= d:
        r += dt.timedelta(days=1)
    return r.timestamp()


def probe_quota_reset(a):
    """The key accepted again: a run of a['workflow'] on main created after a['since'] got past its first job
    (a['job'], the preflight) -- or the whole run is green."""
    o_r = a.get("repo") or SHORT["movies"]
    runs = gh_json(o_r, "run", "list", "--workflow", a["workflow"], "--branch", "main", "--json", RUN_FIELDS, "-L", "10")
    since = float(a.get("since") or 0)
    for r in runs or []:
        try:
            if parse_time(r["createdAt"]).timestamp() <= since:
                continue
        except (KeyError, ValueError, TypeError):
            continue
        if r.get("conclusion") == "success":
            return True, f"{a['workflow']} #{r.get('number')} green"
        jobs = run_jobs(o_r, r) or []
        first = next((j for j in jobs if j.get("name") == a.get("job")), None)
        if first and first.get("conclusion") == "success":
            return True, f"{a['workflow']} #{r.get('number')}: {a.get('job')} passed (the key is accepted again)"
        if first and first.get("conclusion") in ("failure", "timed_out"):
            return False, f"{a['workflow']} #{r.get('number')}: {a.get('job')} failed again (still spent)"
    return False, (f"no run of {a['workflow']} since the quota was spent; the next window opens "
                   f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(next_quota_reset(since)))}")


def red_quota_waits(store, o_r, repo, t):
    """Each open red whose line says a quota is spent, held by nobody (no fixer lease, no block): put on the WAIT lease
    of its service; each wait past its window's reset with no run since: its workflow dispatched once per window."""
    out = []
    for it in red_active(store).values():
        d = it["data"]
        if not QUOTA_LOG.search(str(d.get("line") or "")) or d.get("kind") == "test":
            continue
        if lease_is_live(store.get(red_lease(d["key"])), t) or red_block_of(it, store):
            continue
        svc = quota_service(d.get("line"))
        lname = block_lease(cause=f"quota-{svc.lower()}")
        row = store.get(lname)
        if lease_is_live(row, t):
            m = lease_meta(row)
            store.set_meta(lname, row["epoch"], row["secret"], {"keys": sorted(set(m.get("keys") or []) | {d["key"]})})
        else:
            probe = {"kind": "quota_reset", "args": {"repo": o_r, "workflow": d["workflow"], "since": t, "job": d.get("job")
                                                     if d.get("job") else "preflight"}}
            until = f"{svc}'s quota resets and {d['workflow']}'s {probe['args']['job']} passes"
            store.acquire(lname, "wait:quota", BLOCK_TTL, BLOCK_MAX, progress=f"spent@{int(t)}",
                          meta={"kind": "block", "wait_cause": "quota", "cause": f"quota-{svc.lower()}", "probe": probe,
                                "until": until, "keys": [d["key"]], "probed_at": t, "redispatch": d["workflow"],
                                "text": f"WAITING: {svc}'s quota for the run's key is spent; it resets on its own "
                                        f"(auto-clears when {until})"})
            line = f"RED WAITING: {red_what(d)}: {svc}'s quota is spent -- an external wait, not the owner's; " \
                   f"{d['workflow']} is dispatched again after the reset"
            inbox_write("red", line, [line], [], 0)
        cur = store.item("red", it["id"])
        store.update_item("red", it["id"], cur["version"], {"block": lname})
        out.append(f"{red_what(d)}: waits on {svc}'s quota ({lname})")
    for row in store.list("block/cause/quota-"):
        m = lease_meta(row)
        if not lease_is_live(row, t) or not m.get("redispatch"):
            continue
        since = float((m.get("probe") or {}).get("args", {}).get("since") or t)
        last = float(m.get("dispatched_at") or since)
        if t >= next_quota_reset(last) + 300:
            msg = red_verify_dispatch(o_r, repo, m["redispatch"], "quota-reset")
            out.append(f"{m['redispatch']} after {m.get('cause')}'s reset (re-checks the key): {msg}")
            store.set_meta(row["name"], row["epoch"], row["secret"], {"dispatched_at": t})
    return out


def red_block(o_r, a):
    """`red block`: the red waits on the OWNER, for an owner cause only, as a block lease the tick renews while its
    probe -- named (--until-green / --until-http / --until-tcp), an open cause's, or the red's own workflow going green
    -- still fails and its justification holds. --cause NAME: ONE lease for that outage, every red it explains attached."""
    st = Store()
    n = str(a.run).lstrip("#")
    name, units = None, []
    try:
        name, _r, units = red_run_units(o_r, n)
    except (Exception, SystemExit):
        name, _r = resolve_run(o_r, n)
    cause = getattr(a, "cause", None)
    lname = block_lease(cause=cause) if cause else None
    old = st.get(lname) if lname else None
    old = old if lease_is_live(old, st.clock()) else None
    om = lease_meta(old)
    owner_cause = getattr(a, "owner_cause", None) or om.get("owner_cause")
    if owner_cause not in OWNER_CAUSES:
        print(f"NOT BLOCKED: a block on the owner needs --owner-cause, one of: {', '.join(OWNER_CAUSES)} (a cause outside "
              "the code that only the owner can act on). A code red is yours: claim it and fix it.")
        return 2
    if any(QUOTA_LOG.search(str(x.get("line") or "")) for x in units):
        print(f"NOT BLOCKED: #{n}'s key hit a spent quota ({str(units[0].get('line'))[:120]}): it resets on its own, so "
              "it is no owner action -- the tick holds the red as an external wait and re-runs its workflow after the "
              "reset (`agentctl red status`)")
        return 2
    if any(x.get("kind") == "test" for x in units):
        print(f"NOT BLOCKED: #{n} is a TEST FAILURE ({units[0].get('job')}): a code red is never the owner's -- "
              f"`~/bin/agentctl red claim {n}` and fix it")
        return 2
    items = red_targets(st, o_r, n) if units else []
    own = read_record(own_fixer_record_path() or "") or {}
    handed = [] if not items else [red_lease(it["data"]["key"]) for it in items]
    handed = [x for x in handed if x == own.get("lease") and lease_is_live(st.get(x), st.clock())
              and st.get(x)["epoch"] == own.get("epoch")]
    live = [st.get(red_lease(it["data"]["key"]))["holder"] for it in items
            if red_lease(it["data"]["key"]) not in handed and lease_is_live(st.get(red_lease(it["data"]["key"])), st.clock())]
    if live:
        print(f"NOT BLOCKED: a live fixer is on #{n}: {live[0]}")
        return 1
    if old and not (a.until_green or a.until_http or a.until_tcp):  # attach to the outage's ONE lease: its probe
        iprobe = run_probe(om["probe"]["kind"], om["probe"]["args"])
    elif cause and not (a.until_green or a.until_http or a.until_tcp):
        print(f"NOT BLOCKED: no open cause {cause!r} to attach to; open it with its probe: --cause {cause} "
              "--until-green <workflow> | --until-http <url> | --until-tcp <host:port>")
        return 2
    elif a.until_green:
        iprobe = run_probe("workflow_green", {"repo": o_r, "workflow": a.until_green})
    elif a.until_http:
        iprobe = run_probe("http", {"url": a.until_http})
    elif a.until_tcp:
        host, _, port = a.until_tcp.rpartition(":")
        iprobe = run_probe("tcp", {"host": host, "port": int(port)})
    elif name:
        iprobe = run_probe("workflow_green", {"repo": o_r, "workflow": name})
    else:
        print(f"NOT BLOCKED: #{n}'s workflow is unknown, so no probe can clear the block; name one: --until-green "
              "<workflow> | --until-http <url> | --until-tcp <host:port>")
        return 2
    words = probe_words(iprobe.kind, iprobe.args)
    if iprobe.ok:
        print(f"NOT BLOCKED: {words} already ({iprobe.detail}): nothing waits on the owner -- `red claim {n}` and fix it")
        return 1
    if not items:
        print(f"NOT BLOCKED: #{n} names no red on main")
        return 1
    details = owner_details(o_r, n, name, units, a.owner_cmd or om.get("cmd"), words, owner_cause)
    keys = [it["data"]["key"] for it in items]
    what = ", ".join(red_what(it["data"]) for it in items)
    text = (f"BLOCKED: {cause} down (auto-clears when {words})" if cause else
            f"BLOCKED ON OWNER: {details}")
    verify = not (iprobe.kind == "workflow_green" and iprobe.args.get("workflow") == name)
    if old:
        st.set_meta(lname, old["epoch"], old["secret"], {"keys": sorted(set(om.get("keys") or []) | set(keys))})
        print(f"attached {what} to {cause!r}: {om.get('text')} ({iprobe.detail}; `agentctl red status`)")
    else:
        lname = lname or block_lease(keys[0])
        r = st.acquire(lname, f"owner:{owner_cause}", BLOCK_TTL, BLOCK_MAX, progress=f"{iprobe.detail}@{int(time.time())}",
                       meta={"kind": "block", "owner_cause": owner_cause, "cmd": a.owner_cmd, "cause": cause,
                             "probe": {"kind": iprobe.kind, "args": iprobe.args}, "until": words, "keys": keys,
                             "text": text, "details": details, "verify": verify, "probed_at": time.time()})
        same = st.get(lname) if "held" in r else None
        if "held" in r and lease_meta(same).get("kind") != "block":
            print(f"NOT BLOCKED: {lname} is held by {r['held']['holder']}")
            return 1
        if same:  # the run's block is already up (named after its first red): these reds join it
            sm = lease_meta(same)
            st.set_meta(lname, same["epoch"], same["secret"], {"keys": sorted(set(sm.get("keys") or []) | set(keys))})
            print(f"already blocked: {what} joined {lname}: {sm.get('text')}")
        else:
            line = (f"RED BLOCKED ON OWNER: {cause} down (blocks {what}): {details}" if cause else
                    f"RED BLOCKED ON OWNER: {what}: {details}")
            inbox_write("red", line, [line], [], 1)
            print(line + f" ({iprobe.detail}; `agentctl red status`)")
    for it in items:
        cur = st.item("red", it["id"])
        st.update_item("red", it["id"], cur["version"], {"block": lname})
    for x in handed:  # the dispatched fixer's own lease, handed to the owner: its wrapper ends with the block's verdict
        st.revoke(x, f"BLOCKED ON OWNER (handed over by its fixer): {a.owner_cmd or om.get('cmd')}")
    return 0


# ---------------------------------------------------------------- land / env
SDKMAN_BINS = [f"{HOME}/.sdkman/candidates/sbt/current/bin", f"{HOME}/.sdkman/candidates/java/current/bin"]
RACE = re.compile(r"non-fast-forward|cannot lock ref|fetch first|failed to update ref|stale info|incorrect old value|"
                  r"reference already exists|remote rejected.*(lock|update)", re.I)
# The hook REFUSING for red (its "is RED on main" warnings also print when tools-only commits land while red: not a refusal)
REDGATE = re.compile(r"main is red: only a fix|carries no Fixes-Red")
TUNNEL_TROUBLE = re.compile(r"GitOps manifests STALE|Connection to localhost closed|forgejo\.internal.*(refused|unreachable)|"
                            r"Could not read from remote repository|Connection refused", re.I)
LAND_RETRIES = 3
# One lander per repository: with no pre-merge CI left (movies, 2026-10-26) a landing is the hook's local tests --
# minutes for an identity or page change -- and two landers would each test a base the other is about to move, then
# race, rebase, and test again. Agents wait for the lock instead (land runs in the background), and it caps the
# laptop at one landing hook's JVM at a time.
LAND_LOCK_TIMEOUT = 4 * 3600
# NO STALLED HOLDER (the owner, 2026-10-27): one land's hook hung 2.5 h in sbt-warm and blocked every lander behind the
# lock. A step land runs (the hook's dry run, the push) that makes NO PROGRESS -- its output does not grow and its
# process group uses no CPU -- for LAND_STALL_MIN minutes ($AGENTCTL_LAND_STALL_MIN) is ended (its process group,
# TERM then KILL) and land says `NOT LANDED: stalled <step>`. And the long checks run BEFORE the lock: under it, only a
# fetch, a check that main has not moved since, and the push (whose hook reuses the dry run's pass). Waiters print
# how long the holder has held the lock, and what it is doing, every LAND_WAIT_REPORT_MIN minutes.
LAND_STALL_MIN = 20
LAND_WAIT_REPORT_MIN = 10
LAND_PRECHECK_ROUNDS = 2  # main moved under the lock this often: the next check runs under it, so a lander finishes


def group_cpu_seconds(pgid):
    """The CPU seconds every live process of process group `pgid` has used (ps's cumulative TIME), or 0."""
    r = subprocess.run(["ps", "-A", "-o", "pgid=,time="], capture_output=True, text=True)
    total = 0.0
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) != 2 or parts[0] != str(pgid):
            continue
        secs = 0.0
        for field in re.split(r"[:-]", parts[1]):
            try:
                secs = secs * 60 + float(field)
            except ValueError:
                pass
        total += secs
    return total


STALL_CPU_SECONDS = 1.0  # CPU that counts as progress per window: a watchdog's polls are not work


def stall_clock():
    """The stall judge's clock (tests drive it, with group_cpu_seconds, so no verdict depends on the machine's load)."""
    return time.monotonic()


WATCHED_GROUPS = set()  # process groups run_watched started and that may still run: the watchdog ends them first


def run_watched(argv, cwd, env, log_path, step, stall=None, sampler=None, cpu=None, clock=None, wall=None):
    """Run argv (its own process group, stdin closed), its output into a file beside log_path. (returncode, output);
    returncode None when it STALLED: no output and no CPU in its process group for `stall` seconds, after which the
    group is ended. Waits with Popen.wait, never time.sleep. `cpu` (pgid -> CPU seconds) and `clock` are the samples the
    verdict reads: group_cpu_seconds and stall_clock unless given."""
    cpu_of, clock = cpu or group_cpu_seconds, clock or stall_clock
    stall = stall if stall is not None else float(os.environ.get("AGENTCTL_LAND_STALL_MIN", LAND_STALL_MIN)) * 60
    out_path = f"{log_path}.{re.sub(r'[^A-Za-z0-9_-]', '_', step)}.out"
    with open(out_path, "w") as out:
        p = subprocess.Popen(argv, cwd=cwd, env=env, stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                             start_new_session=True)
    WATCHED_GROUPS.add(p.pid)
    size, cpu, changed, stalled = -1, None, clock(), False
    poll = max(0.2, min(15.0, stall / 4))
    need = float(os.environ.get("AGENTCTL_STALL_CPU_SECONDS", STALL_CPU_SECONDS))
    t_start = time.monotonic()
    while True:
        try:
            p.wait(timeout=poll)
            break
        except subprocess.TimeoutExpired:
            pass
        if sampler:
            sampler()
        now_size, now_cpu = os.path.getsize(out_path), cpu_of(p.pid)
        try:  # the landing lease's holder renews on real progress only (output bytes, whole CPU seconds)
            lock_beat(f"{step}:{now_size}:{int(now_cpu or 0)}")
        except LeaseLost as ex:
            err(f"{ex}: ending {step}")
            stalled = True
        # progress: output grew, or the group used a real second of CPU since the last progress (the hook idle in
        # `wait` with only its watchdog polling used ~0.08 s in 50 min, 2026-10-27: that is not progress)
        now_c = clock()
        if now_size != size or cpu is None or now_cpu - cpu >= need:
            size, cpu, changed = now_size, now_cpu, now_c
        elif now_c - changed > stall:
            stalled = True
        if wall is not None and time.monotonic() - t_start > wall:  # busy or not: the wall bound (a push's)
            stalled = True
        if stalled:
            for sig, grace in ((signal.SIGTERM, 10), (signal.SIGKILL, 5)):
                try:
                    os.killpg(p.pid, sig)
                except ProcessLookupError:
                    break
                try:
                    p.wait(timeout=grace)
                    break
                except subprocess.TimeoutExpired:
                    continue
            break
    WATCHED_GROUPS.discard(p.pid)
    with open(out_path, errors="replace") as f:
        output = f.read()
    try:
        os.unlink(out_path)
    except OSError:
        pass
    return (None if stalled else p.returncode), output


# ---------------------------------------------------------------- the governor: ONE admission control for memory and CPU
# The owner (2026-10-27): "one governor for laptop memory and CPU". Three limiters guarded the 36 GB / 14-core Mac each on
# its own -- movies' scripts/jvm-gate.sh (4 JVM slots), the check slots' cap (below) and sbt-warm's kept servers (each
# holding a JVM slot, idle or not) -- so an idle warm server held the slot a red fix's check waited for, and none knew
# what the others had admitted. Now one governor admits every heavy unit of work:
#
# - A TICKET is an flock on <gov>/t-<id>.lock (freed by the kernel when its holder ends, however it ends) with its record
#   beside it, t-<id>.json: class, expected GB, label, pid, cwd, since. agentctl's own checks hold one in-process; movies'
#   scripts/jvm-gate.sh opens descriptor 7 on a ticket file and runs `agentctl gov admit --fd 7`, which locks that shared
#   open file: the shell, and the JVM or the kept server's keeper it hands descriptor 7 to, hold the ticket.
# - CLASSES, in priority order: red (a change carrying Fixes-Red for a red run; a red fixer's worktree), check (a
#   pre-commit check), agent (an agent's own sbt), measure (identity-measure*). Waiters queue in that order, first come
#   first served within a class, and only the head of the queue is admitted: a lower class never overtakes a higher one.
# - MEMORY: the expected GB must fit under the BUDGET (the sum of the live tickets' expected GB; $AGENTCTL_GOV_BUDGET_GB,
#   default 60% of RAM), and what it needs NOW ($AGENTCTL_GOV_FREE_NEED_GB, 2.5, or less) must fit into FREE memory
#   (free + inactive + speculative pages) less a reserve ($AGENTCTL_GOV_RESERVE_GB, 1) less what the tickets admitted in
#   the last 2 min will still grow into (a JVM takes its heap over its first minutes); and memory pressure (100 -
#   memory_pressure's free %) must be under 75% (90% for red).
# - CPU: checks wait while the 1-min load is over 4x the cores (a load of ~250 kept an sbt server from starting in 5 min
#   and failed two checks, 2026-10-27), agent work over 1.5x, measurements over 1x; red never.
# - EVICTION: when the head waiter does not fit on memory, the governor stops the idle kept sbt server unused longest
#   (sbt-warm's registry: no call running in it -- its busy lock taken exclusively for the stop, so none starts under it --
#   unused for a minute, not serving, never the root checkout's), then looks again. Idle warm servers go first.
# - CHECKS keep their cap (`checks`, below): measured and auto-tuned as before, now one of the governor's limits.
# Every admission is a line of <gov>/admits.jsonl (class, GB, wait, what it waited on); every eviction a line of gov.log.
GOV_CLASSES = {"red": 0, "check": 1, "agent": 2, "measure": 3, "suite": 4}
GOV_MEM_GB = {"red": 5.0, "check": 5.0, "agent": 5.0, "measure": 6.0, "hook": 1.0, "suite": 1.0}
SUITE_CAP = 1  # agentctl's own test-suite runs at once ($AGENTCTL_SUITE_CAP): parallel agents queue, never pile up
GOV_RAMP = 120          # seconds a new ticket's JVM is still growing into its expected memory
GOV_RESERVE_GB = 1.0
GOV_FREE_NEED_GB = 2.5  # free memory a new JVM needs NOW (beyond the reserve); its heap grows into the budget's share later
GOV_PRESSURE_STOP = {"red": 90}  # memory pressure (%) at which a class waits; others: GOV_PRESSURE_DEFAULT
GOV_PRESSURE_DEFAULT = 75
GOV_LOAD = {"check": 4.0, "agent": 1.5, "measure": 1.0}  # waits while load1 > factor x cores; red never waits on CPU
GOV_EVICT_IDLE = 60     # a kept server unused this long (seconds) may be evicted
GOV_POLL = 2.0
GOV_REPORT = 600


def gov_dir():
    d = os.environ.get("AGENTCTL_GOV_DIR") or state_root("gov")
    os.makedirs(d, exist_ok=True)
    return d


def gov_log(msg):
    with open(os.path.join(gov_dir(), "gov.log"), "a") as f:
        f.write(f"{ts()} {msg}\n")


def ram_gb():
    try:
        r = subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True, text=True, timeout=10)
        return int(r.stdout.strip()) / 2 ** 30
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return 36.0


def gov_budget():
    return env_num("AGENTCTL_GOV_BUDGET_GB", round(0.6 * ram_gb(), 1))


def free_gb():
    """GB of RAM a new heap can have now (free + inactive + speculative pages); $AGENTCTL_GOV_FREE_PROBE's output when
    set (the tests' seam); None when unreadable."""
    probe = os.environ.get("AGENTCTL_GOV_FREE_PROBE")
    if probe:
        try:
            return float(subprocess.run(probe, shell=True, capture_output=True, text=True).stdout.strip())
        except ValueError:
            return None
    try:
        out = subprocess.run(["vm_stat"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    page = re.search(r"page size of (\d+) bytes", out)
    pages = sum(int(m.group(2)) for m in re.finditer(r"Pages (free|inactive|speculative):\s+(\d+)", out))
    return pages * int(page.group(1)) / 2 ** 30 if page else None


def gov_machine():
    """{free, pressure, load1, cores}: live memory and CPU ($AGENTCTL_GOV_PRESSURE_PROBE / _LOAD_PROBE: the tests')."""
    load1, _cpu, pressure, _swap = machine_sample()
    if os.environ.get("AGENTCTL_GOV_PRESSURE_PROBE"):
        pressure = float(subprocess.run(os.environ["AGENTCTL_GOV_PRESSURE_PROBE"], shell=True, capture_output=True,
                                        text=True).stdout.strip() or 0)
    if os.environ.get("AGENTCTL_GOV_LOAD_PROBE"):
        load1 = float(subprocess.run(os.environ["AGENTCTL_GOV_LOAD_PROBE"], shell=True, capture_output=True,
                                     text=True).stdout.strip() or 0)
    return {"free": free_gb(), "pressure": pressure, "load1": load1, "cores": os.cpu_count() or 1}


def gov_tickets():
    """The live tickets' records (their lock held), oldest first; a dead ticket's files are removed."""
    out = []
    for p in sorted(glob.glob(os.path.join(gov_dir(), "t-*.json"))):
        lock = p[:-5] + ".lock"
        if not lock_held(lock):
            try:
                if time.time() - os.path.getmtime(p) > 30:  # never one being written
                    os.unlink(p)
                    os.unlink(lock)
            except OSError:
                pass
            continue
        rec = read_record(p)
        if rec:
            rec["path"] = lock
            out.append(rec)
    return sorted(out, key=lambda r: r.get("at", 0))


def gov_committed(tickets):
    return sum(float(t.get("mem") or 0) for t in tickets)


def gov_ramp(tickets, now=None):
    now = now or time.time()
    return sum(float(t.get("mem") or 0) for t in tickets if now - t.get("at", 0) < GOV_RAMP)


def gov_fits(cls, mem, tickets, m, kind="job"):
    """(True, None) when work of class cls expecting `mem` GB may start now; else (False, why, on_memory)."""
    if cls == "suite":  # agentctl's own test suite (`agentctl suite`): at most SUITE_CAP at once
        suites = sum(1 for t in tickets if t.get("class") == "suite")
        if suites >= env_num("AGENTCTL_SUITE_CAP", SUITE_CAP):
            return False, f"{suites}/{env_num('AGENTCTL_SUITE_CAP', SUITE_CAP):g} agentctl suite run(s) going (the suite cap)", False
    if kind == "check" and cls != "red":
        checks = sum(1 for t in tickets if t.get("kind") == "check")
        if checks >= checks_cap():
            return False, f"{checks}/{checks_cap()} checks running (the check cap)", False
    budget = gov_budget()
    committed = gov_committed(tickets)
    if committed + mem > budget:
        return False, f"{committed:.0f}+{mem:.0f} GB over the {budget:.0f} GB budget", True
    if m.get("free") is not None:
        room = m["free"] - env_num("AGENTCTL_GOV_RESERVE_GB", GOV_RESERVE_GB) - gov_ramp(tickets)
        need = min(mem, env_num("AGENTCTL_GOV_FREE_NEED_GB", GOV_FREE_NEED_GB))
        if need > room:
            return False, (f"{m['free']:.1f} GB free, {gov_ramp(tickets):.0f} GB still growing: {max(room, 0):.1f} GB "
                           f"for the {need:g} GB it needs now"), True
    stop = GOV_PRESSURE_STOP.get(cls, GOV_PRESSURE_DEFAULT)
    if m.get("pressure") is not None and m["pressure"] >= stop:
        return False, f"memory pressure {m['pressure']:.0f}% (waits at {stop}%)", True
    factor = GOV_LOAD.get(cls)
    if factor and m.get("load1") is not None and m["load1"] > factor * m["cores"]:
        return False, f"load {m['load1']:.0f} over {factor:g}x {m['cores']} cores", False
    return True, None, False


def gov_waiters():
    """The live waiters, in admission order: (class priority, arrival)."""
    out = []
    for p in glob.glob(os.path.join(gov_dir(), "w-*.json")):
        rec = read_record(p)
        if not rec or not pid_alive(int(rec.get("pid", 0))):
            try:
                os.unlink(p)
            except OSError:
                pass
            continue
        rec["path"] = p
        out.append(rec)
    return sorted(out, key=lambda r: (GOV_CLASSES.get(r.get("class"), 9), r.get("at", 0)))


def sbt_warm_state():
    return os.environ.get("KINOWO_SBT_WARM_STATE") or os.path.join(HOME, ".cache", "kinowo-sbt-warm")


def idle_servers(min_idle=None):
    """The kept sbt servers the governor may evict, unused longest first: [(idle seconds, root, key prefix)]. Never the
    root checkout's (the owner's own), a serving one, or one a call is running in (its busy lock held)."""
    min_idle = GOV_EVICT_IDLE if min_idle is None else min_idle
    out = []
    for f in glob.glob(os.path.join(sbt_warm_state(), "*.root")):
        prefix = f[:-5]
        try:
            with open(f) as rf, open(prefix + ".pid") as pf:
                root, pid = rf.read().strip(), int(pf.read().strip())
        except (OSError, ValueError):
            continue
        if not os.path.isdir(root) or os.path.isdir(os.path.join(root, ".git")) or not pid_alive(pid):
            continue
        if os.path.exists(prefix + ".serving") or lock_held(prefix + ".busy"):
            continue
        try:
            idle = time.time() - os.path.getmtime(prefix + ".used")
        except OSError:
            continue
        if idle >= min_idle:
            out.append((idle, root, prefix))
    return sorted(out, reverse=True)


def gov_evict(why):
    """Stop the idle kept server unused longest (holding its busy lock, so no call starts under the stop). The evicted
    checkout, or None."""
    for idle, root, prefix in idle_servers():
        f = open(prefix + ".busy", "a+")
        try:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                continue  # a call started meanwhile
            script = os.path.join(root, "scripts", "sbt-warm")
            if not os.access(script, os.X_OK):
                continue
            try:
                subprocess.run([script, "--stop", "--root"], cwd=root, capture_output=True, text=True, timeout=180)
            except subprocess.TimeoutExpired:
                gov_log(f"evict {root}: sbt-warm --stop took over 3 min")
            gov_log(f"evicted the idle sbt server of {root} (unused {int(idle // 60)} min) for: {why}")
            return root
        finally:
            f.close()
    return None


class GovTicket:
    def __init__(self, path, rec, f=None):
        self.path, self.rec, self.f = path, rec, f
        self.waited, self.why = rec.get("waited", 0.0), rec.get("waited_on")

    def release(self):
        for p in (self.path[:-5] + ".json", self.path):
            try:
                os.unlink(p)
            except OSError:
                pass
        if self.f:
            self.f.close()
            self.f = None


class GovTimeout(RuntimeError):
    """The governor did not admit the work within its bound (audit #12: an unbounded wait hid a stuck queue entry)."""


GOV_ADMIT_MAX = 2 * 3600  # a check waits this long for the governor at most ($AGENTCTL_GOV_ADMIT_MAX)


def gov_admit(cls, mem=None, label="", kind="job", fd=None, ticket=None, wait=True, force=False, pid=None, cwd=None,
              report=None, max_wait=None):
    """Admit one unit of work: a GovTicket once it may start (None for a --try that may not). With `fd`, the lock is
    taken on that inherited descriptor (a shell's, which then holds the ticket); else on a file this process keeps open."""
    cls = cls if cls in GOV_CLASSES else "agent"
    mem = GOV_MEM_GB.get(cls, 5.0) if mem is None else float(mem)
    d = gov_dir()
    t0 = time.time()
    me = os.path.join(d, f"w-{t0:.6f}-{os.getpid()}.json")
    write_json(me, {"class": cls, "mem": mem, "label": label, "kind": kind, "pid": os.getpid(), "at": t0})
    said, report_at, why = False, 0.0, None
    report = report or err
    try:
        while True:
            tickets = gov_tickets()
            waiters = gov_waiters()
            head = waiters and os.path.abspath(waiters[0]["path"]) == os.path.abspath(me)
            if force:
                ok, why, on_mem = True, None, False
            elif not head:
                w = waiters[0] if waiters else {}
                ok, on_mem = False, False
                why = f"behind {w.get('class')} work ({w.get('label') or '?'}, pid {w.get('pid')})"
            else:
                ok, why, on_mem = gov_fits(cls, mem, tickets, gov_machine(), kind)
            if ok:
                break
            if head and on_mem and cls != "measure" and gov_evict(f"{cls} {label} ({why})"):
                time.sleep(env_num("AGENTCTL_GOV_EVICT_SETTLE", 3))  # the freed memory shows in vm_stat
                continue
            if not wait:
                return None
            if max_wait is not None and time.time() - t0 > max_wait:
                raise GovTimeout(f"the governor did not admit {cls} work ({label}) in {int(max_wait // 60)} min: {why}")
            try:  # a check waiting its turn holds its leases (bounded by max_wait and their max hold), never loses them
                lock_beat(f"gov-wait:{label}:{int(time.time() // 60)}")
            except LeaseLost as ex:
                raise GovTimeout(f"{ex} while waiting for the governor") from None
            if time.monotonic() >= report_at:
                report(f"{'still ' if said else ''}waiting for the governor ({cls}, {mem:g} GB, {label}): {why}; "
                       f"{len(tickets)} admitted, {gov_committed(tickets):.0f}/{gov_budget():.0f} GB")
                said, report_at = True, time.monotonic() + GOV_REPORT
            time.sleep(env_num("AGENTCTL_GOV_POLL", GOV_POLL))
    finally:
        try:
            os.unlink(me)
        except OSError:
            pass
    path = ticket or os.path.join(d, f"t-{t0:.6f}-{os.getpid()}.lock")
    f = None
    if fd is not None:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    else:
        f = open(path, "a+")
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    waited = round(time.time() - t0, 1)
    rec = {"class": cls, "mem": mem, "label": label, "kind": kind, "pid": pid or os.getpid(), "cwd": cwd or os.getcwd(),
           "at": time.time(), "since": ts(), "waited": waited, "waited_on": why if waited >= 1 else None}
    write_json(path[:-5] + ".json", rec)
    with open(os.path.join(d, "admits.jsonl"), "a") as af:
        af.write(json.dumps({k: rec[k] for k in ("class", "mem", "label", "kind", "at", "waited", "waited_on")}) + "\n")
    if said:
        report(f"admitted by the governor after {int(waited)} s ({cls}, {mem:g} GB, {label})")
    return GovTicket(path, rec, f)


@contextlib.contextmanager
def gov_ticket(cls, mem=None, label="", kind="job", report=None):
    t = gov_admit(cls, mem, label, kind=kind, report=report)
    try:
        yield t
    finally:
        t.release()


def gov_pressure():
    """Why the laptop is under pressure now (memory pressure, free memory or load past the governor's limits for a
    check), or None: `land` runs a change's checks on ci-runner while it says so."""
    m = gov_machine()
    if m.get("pressure") is not None and m["pressure"] >= env_num("AGENTCTL_REMOTE_PRESSURE", GOV_PRESSURE_DEFAULT):
        return f"memory pressure {m['pressure']:.0f}%"
    if m.get("free") is not None and m["free"] < env_num("AGENTCTL_GOV_RESERVE_GB", GOV_RESERVE_GB) + GOV_MEM_GB["check"] \
            and not idle_servers():
        return f"{m['free']:.1f} GB free and no idle sbt server to evict"
    if m.get("load1") is not None and m["load1"] > env_num("AGENTCTL_REMOTE_LOAD", 2.0) * m["cores"]:
        return f"load {m['load1']:.0f} on {m['cores']} cores"
    return None


# NO NEW FIXER ON A LAPTOP UNDER PRESSURE (the owner's coordinator, 2026-10-29: load 56-72 on 14 cores, swap 30.4 of
# 31.7 GB). The dispatcher starts no fixer while swap used is over FIXER_SWAP_GB, the load over FIXER_LOAD x the cores,
# or free memory under FIXER_FREE_GB: the red stays offered (`waiting: laptop pressure (...)`), takes no slot, and
# dispatches when the pressure clears; its offer's own deadline still escalates it (RED UNCLAIMED / STARVED).
FIXER_SWAP_GB = 16.0    # $AGENTCTL_FIXER_SWAP_GB: swap USED, absolute -- macOS shrinks the swap total as it frees,
                        # so a share of the total never drops (15.0 GB total, 13.9 used read as 93% with 57% RAM free)
FIXER_LOAD = 3.0        # $AGENTCTL_FIXER_LOAD (x cores)
FIXER_FREE_GB = 4.0     # $AGENTCTL_FIXER_FREE_GB


def swap_usage():
    """(used MB, total MB) of swap, or (None, None)."""
    try:
        r = subprocess.run(["sysctl", "-n", "vm.swapusage"], capture_output=True, text=True, timeout=10)
        tot, used = re.search(r"total = ([\d.]+)M", r.stdout), re.search(r"used = ([\d.]+)M", r.stdout)
        return (float(used.group(1)), float(tot.group(1))) if tot and used else (None, None)
    except (OSError, subprocess.TimeoutExpired):
        return None, None


def laptop_pressure(m=None, swap=None):
    """Why no new fixer may start on this laptop now, or None (gov_machine's free memory and load, vm.swapusage).
    $AGENTCTL_LAPTOP_PRESSURE set (the tests'): its value is the answer, `-` or empty for none."""
    if m is None and swap is None and "AGENTCTL_LAPTOP_PRESSURE" in os.environ:
        return os.environ["AGENTCTL_LAPTOP_PRESSURE"].strip("-") or None  # `-` or empty: none
    m = m or gov_machine()
    used, total = swap or swap_usage()
    if used is not None and used / 1024 > env_num("AGENTCTL_FIXER_SWAP_GB", FIXER_SWAP_GB):
        return f"swap {used / 1024:.1f} of {total / 1024:.1f} GB used"
    if m.get("load1") is not None and m["load1"] > env_num("AGENTCTL_FIXER_LOAD", FIXER_LOAD) * m["cores"]:
        return f"load {m['load1']:.0f} on {m['cores']} cores"
    if m.get("free") is not None and m["free"] < env_num("AGENTCTL_FIXER_FREE_GB", FIXER_FREE_GB):
        return f"{m['free']:.1f} GB free"
    return None


def cmd_suite(a):
    """`agentctl suite [tests/run.py args]`: agentctl's own test suite (tests/run.py: parallel, a timeout per test; in
    this directory) under a governor ticket of class `suite` (SUITE_CAP at once): parallel agents queue here instead of
    piling up. Arguments are run.py's (-j N, --timeout S, PATTERN...)."""
    args = list(a.args or [])
    with gov_ticket("suite", label=f"agentctl suite {os.path.basename(os.getcwd())}"):
