SDKMAN_BINS = [f"{HOME}/.sdkman/candidates/sbt/current/bin", f"{HOME}/.sdkman/candidates/java/current/bin"]
RACE = re.compile(r"non-fast-forward|cannot lock ref|fetch first|failed to update ref|stale info|incorrect old value|"
                  r"reference already exists|remote rejected.*(lock|update)", re.I)
# The hook REFUSING for red (its "is RED on main" warnings also print when tools-only commits land while red: not a refusal)
REDGATE = re.compile(r"main is red: only a fix|carries no Fixes-Red")
TUNNEL_TROUBLE = re.compile(r"GitOps manifests STALE|Connection to localhost closed|forgejo\.internal.*(refused|unreachable)|"
                            r"Could not read from remote repository|Connection refused", re.I)
LAND_RETRIES = 3
# One lander per repository: with no pre-merge CI left (movies, 2026-10-26) a landing is the hook's local tests --
# minutes for an identity or page change -- and two landers would each test a base the other is about to move, then
# race, rebase, and test again. Agents wait for the lock instead (land runs in the background), and it caps the
# laptop at one landing hook's JVM at a time.
LAND_LOCK_DIR = os.path.join(HOME, ".cache", "agentctl", "land")
LAND_LOCK_TIMEOUT = 4 * 3600
# NO STALLED HOLDER (the owner, 2026-10-27): one land's hook hung 2.5 h in sbt-warm and blocked every lander behind the
# lock. A step land runs (the hook's dry run, the push) that makes NO PROGRESS -- its output does not grow and its
# process group uses no CPU -- for LAND_STALL_MIN minutes ($AGENTCTL_LAND_STALL_MIN) is ended (its process group,
# TERM then KILL) and land says `NOT LANDED: stalled <step>`. And the long checks run BEFORE the lock: under it, only a
# fetch, a check that main has not moved since, and the push (whose hook reuses the dry run's pass). Waiters print
# how long the holder has held the lock, and what it is doing, every LAND_WAIT_REPORT_MIN minutes.
LAND_STALL_MIN = 20
LAND_WAIT_REPORT_MIN = 10
LAND_PRECHECK_ROUNDS = 2  # main moved under the lock this often: the next check runs under it, so a lander finishes


def group_cpu_seconds(pgid):
    """The CPU seconds every live process of process group `pgid` has used (ps's cumulative TIME), or 0."""
    r = subprocess.run(["ps", "-A", "-o", "pgid=,time="], capture_output=True, text=True)
    total = 0.0
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) != 2 or parts[0] != str(pgid):
            continue
        secs = 0.0
        for field in re.split(r"[:-]", parts[1]):
            try:
                secs = secs * 60 + float(field)
            except ValueError:
                pass
        total += secs
    return total


STALL_CPU_SECONDS = 1.0  # CPU that counts as progress per window: a watchdog's polls are not work


def run_watched(argv, cwd, env, log_path, step, stall=None, sampler=None):
    """Run argv (its own process group, stdin closed), its output into a file beside log_path. (returncode, output);
    returncode None when it STALLED: no output and no CPU in its process group for `stall` seconds, after which the
    group is ended. Waits with Popen.wait, never time.sleep."""
    stall = stall if stall is not None else float(os.environ.get("AGENTCTL_LAND_STALL_MIN", LAND_STALL_MIN)) * 60
    out_path = f"{log_path}.{re.sub(r'[^A-Za-z0-9_-]', '_', step)}.out"
    with open(out_path, "w") as out:
        p = subprocess.Popen(argv, cwd=cwd, env=env, stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                             start_new_session=True)
    size, cpu, changed, stalled = -1, None, time.monotonic(), False
    poll = max(0.2, min(15.0, stall / 4))
    need = float(os.environ.get("AGENTCTL_STALL_CPU_SECONDS", STALL_CPU_SECONDS))
    while True:
        try:
            p.wait(timeout=poll)
            break
        except subprocess.TimeoutExpired:
            pass
        if sampler:
            sampler()
        now_size, now_cpu = os.path.getsize(out_path), group_cpu_seconds(p.pid)
        # progress: output grew, or the group used a real second of CPU since the last progress (the hook idle in
        # `wait` with only its watchdog polling used ~0.08 s in 50 min, 2026-10-27: that is not progress)
        if now_size != size or cpu is None or now_cpu - cpu >= need:
            size, cpu, changed = now_size, now_cpu, time.monotonic()
        elif time.monotonic() - changed > stall:
            stalled = True
            for sig, grace in ((signal.SIGTERM, 10), (signal.SIGKILL, 5)):
                try:
                    os.killpg(p.pid, sig)
                except ProcessLookupError:
                    break
                try:
                    p.wait(timeout=grace)
                    break
                except subprocess.TimeoutExpired:
                    continue
            break
    with open(out_path, errors="replace") as f:
        output = f.read()
    try:
        os.unlink(out_path)
    except OSError:
        pass
    return (None if stalled else p.returncode), output


# ---------------------------------------------------------------- check slots
# The owner (2026-10-27): "just limit the precommit checks to a reasonable number", and "keep measuring to adjust that
# number". Every pre-commit check run (land's dry run, the `waiting` batch check) holds one of N slots: flocks
# ~/.cache/agentctl/checks/slot-<i>.lock, freed by the kernel when the holder dies, so a slot never leaks; a check
# that stalls is ended by run_watched, and its slot goes with it. N: $AGENTCTL_MAX_CHECKS if set, else the automatic cap
# (checks/cap.json, default 3, leaving one of jvm-gate's 4 JVM slots to agents' own sbt work). A waiter prints its
# position and the holders. Each run appends to checks/runs.jsonl: its duration, its wait for a slot, the cap and the
# number of checks running, the load average, CPU % and memory pressure / swap sampled during it. After each run the
# cap is adjusted from the data (adjust_cap), at most once a day, each change logged and sent to the inbox.
CHECKS_DEFAULT_CAP = 3
JVM_SLOTS_DEFAULT = 4


def checks_dir():
    d = os.environ.get("AGENTCTL_CHECKS_DIR") or os.path.join(HOME, ".cache", "agentctl", "checks")
    os.makedirs(d, exist_ok=True)
    return d


def jvm_slots():
    try:
        return max(1, int(os.environ.get("KINOWO_JVM_SLOTS", JVM_SLOTS_DEFAULT)))
    except ValueError:
        return JVM_SLOTS_DEFAULT


def cap_state():
    try:
        with open(os.path.join(checks_dir(), "cap.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"cap": CHECKS_DEFAULT_CAP}


def checks_cap():
    if os.environ.get("AGENTCTL_MAX_CHECKS"):
        return max(1, int(os.environ["AGENTCTL_MAX_CHECKS"]))
    return max(1, min(jvm_slots(), int(cap_state().get("cap", CHECKS_DEFAULT_CAP))))


def machine_sample():
    """(load1, cpu %, memory pressure %, swap used MB) of this machine, cheaply; None where unreadable."""
    load1 = os.getloadavg()[0]
    cpu = min(100.0, 100.0 * load1 / (os.cpu_count() or 1))
    pressure = swap = None
    try:
        r = subprocess.run(["memory_pressure", "-Q"], capture_output=True, text=True, timeout=10)
        m = re.search(r"free percentage:\s*(\d+)", r.stdout)
        pressure = 100 - int(m.group(1)) if m else None
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        r = subprocess.run(["sysctl", "-n", "vm.swapusage"], capture_output=True, text=True, timeout=10)
        m = re.search(r"used = ([\d.]+)M", r.stdout)
        swap = float(m.group(1)) if m else None
    except (OSError, subprocess.TimeoutExpired):
        pass
    return load1, cpu, pressure, swap


class Slot:
    def __init__(self, label):
        self.label, self.f, self.index, self.waited, self.t0 = label, None, None, 0.0, None
        self.samples, self.running, self.cap, self._last_sample = [], 0, 0, 0.0

    def sample(self, force=False):
        if force or time.monotonic() - self._last_sample >= 30:
            self._last_sample = time.monotonic()
            try:
                self.samples.append(machine_sample())
            except Exception:
                pass

    def done(self, rc, out):
        self.rc, self.out = rc, out


def slot_holders(cap):
    out = []
    for i in range(cap):
        path = os.path.join(checks_dir(), f"slot-{i}.lock")
        if lock_held(path):
            try:
                out.append(open(path).read().strip() or f"slot {i}")
            except OSError:
                out.append(f"slot {i}")
    return out


@contextlib.contextmanager
def check_slot(repo, label):
    """Hold one of the check slots for a pre-commit check run; waits (FIFO by arrival, a ticket file) printing its
    position and the holders. Records the run in runs.jsonl and adjusts the cap afterwards."""
    d = checks_dir()
    slot, t_wait = Slot(label), time.monotonic()
    ticket = os.path.join(d, f"wait-{time.time():.6f}-{os.getpid()}")
    open(ticket, "w").write(label)
    said, report_at = False, 0.0
    try:
        while True:
            cap = checks_cap()
            waiters = sorted(n for n in os.listdir(d) if n.startswith("wait-")
                             and pid_alive(int(n.rsplit("-", 1)[1])))
            mine = os.path.basename(ticket)
            ahead = waiters.index(mine) if mine in waiters else 0
            free = None
            if ahead < cap:
                for i in range(cap):
                    f = open(os.path.join(d, f"slot-{i}.lock"), "a+")
                    try:
                        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                        free = (i, f)
                        break
                    except BlockingIOError:
                        f.close()
            if free:
                slot.index, slot.f = free
                break
            if time.monotonic() >= report_at:
                holders = slot_holders(cap)
                err(f"{'still ' if said else ''}waiting for a check slot ({len(holders)}/{cap} busy; position "
                    f"{ahead + 1} in line): " + "; ".join(holders))
                said, report_at = True, time.monotonic() + 600
            time.sleep(2)
    finally:
        try:
            os.unlink(ticket)
        except OSError:
            pass
    slot.waited, slot.cap = time.monotonic() - t_wait, checks_cap()
    slot.running = len(slot_holders(slot.cap))
    slot.f.seek(0)
    slot.f.truncate()
    slot.f.write(f"pid {os.getpid()} {label} since {ts()}")
    slot.f.flush()
    slot.t0, slot.rc = time.monotonic(), None
    slot.sample(force=True)
    try:
        yield slot
    finally:
        slot.sample(force=True)
        record_check(slot, time.monotonic() - slot.t0)
        slot.f.close()
        try:
            maybe_adjust_cap()
        except Exception as e:
            err(f"could not adjust the check cap: {e}")


def record_check(slot, duration):
    def mx(i):
        vals = [x[i] for x in slot.samples if x and x[i] is not None]
        return max(vals) if vals else None
    rec = {"at": time.time(), "label": slot.label, "duration": round(duration, 1), "waited": round(slot.waited, 1),
           "cap": slot.cap, "running": slot.running, "rc": slot.rc, "load1": mx(0), "cpu": mx(1), "pressure": mx(2),
           "swap_mb": mx(3), "swap_mb_start": slot.samples[0][3] if slot.samples and slot.samples[0] else None}
    with open(os.path.join(checks_dir(), "runs.jsonl"), "a") as f:
        f.write(json.dumps(rec) + "\n")


def check_runs(days=7, now=None):
    now = now or time.time()
    out = []
    try:
        with open(os.path.join(checks_dir(), "runs.jsonl")) as f:
            for line in f:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if r.get("at", 0) >= now - days * 86400:
                    out.append(r)
    except OSError:
        pass
    return out


def pct(vals, q):
    vals = sorted(vals)
    if not vals:
        return None
    return vals[min(len(vals) - 1, int(round(q * (len(vals) - 1))))]


SLOT_WAIT_COMMON = 0.3        # share of the day's runs that waited over a minute for a slot
PRESSURE_LOW, PRESSURE_HIGH = 50, 75
SWAP_GROWTH_HIGH_MB = 512


def adjust_cap(runs, cap, max_cap, last_change, now):
    """(new cap, reason) from the last day's check runs, or (cap, None). At most one change a day. Lower by 1 (to 1)
    when memory pressure or swap rises, or when p90 duration at the current level is over 1.5x the p90 at the level
    below; raise by 1 (to max_cap) when slot waits are common and memory pressure and swap stay low."""
    if now - (last_change or 0) < 86400:
        return cap, None
    day = [r for r in runs if r.get("at", 0) >= now - 86400]
    if not day:
        return cap, None
    pressures = [r["pressure"] for r in day if r.get("pressure") is not None]
    growth = [(r["swap_mb"] or 0) - (r.get("swap_mb_start") or 0) for r in day if r.get("swap_mb") is not None]
    if (pressures and max(pressures) >= PRESSURE_HIGH) or (growth and max(growth) >= SWAP_GROWTH_HIGH_MB):
        if cap > 1:
            return cap - 1, (f"memory pressure up to {max(pressures) if pressures else '?'}% or swap growing up to "
                             f"{int(max(growth)) if growth else 0} MB during a check")
        return cap, None
    at = [r["duration"] for r in runs if r.get("running") == cap]
    below = [r["duration"] for r in runs if r.get("running") == cap - 1]
    if cap > 1 and len(at) >= 5 and len(below) >= 5 and pct(at, 0.9) > 1.5 * pct(below, 0.9):
        return cap - 1, f"p90 check duration with {cap} running is {pct(at, 0.9):.0f}s, over 1.5x the {pct(below, 0.9):.0f}s with {cap - 1}"
    waited = [r for r in day if r.get("waited", 0) > 60]
    if (cap < max_cap and len(day) >= 5 and len(waited) / len(day) >= SLOT_WAIT_COMMON
            and (not pressures or max(pressures) < PRESSURE_LOW) and (not growth or max(growth) < 64)):
        return cap + 1, (f"{len(waited)} of {len(day)} checks today waited over a minute for a slot, memory pressure "
                         f"under {PRESSURE_LOW}% and swap steady")
    return cap, None


def maybe_adjust_cap(now=None):
    if os.environ.get("AGENTCTL_MAX_CHECKS"):
        return None
    now = now or time.time()
    st = cap_state()
    cap = int(st.get("cap", CHECKS_DEFAULT_CAP))
    new, why = adjust_cap(check_runs(7, now), cap, jvm_slots(), st.get("changed_at"), now)
    if why is None or new == cap:
        return None
    st = {"cap": new, "changed_at": now, "reason": why, "previous": cap}
    with open(os.path.join(checks_dir(), "cap.json.tmp"), "w") as f:
        json.dump(st, f)
    os.replace(os.path.join(checks_dir(), "cap.json.tmp"), os.path.join(checks_dir(), "cap.json"))
    line = f"CHECK CAP {cap} -> {new}: {why}"
    with open(os.path.join(checks_dir(), "adjust.log"), "a") as f:
        f.write(f"{ts()} {line}\n")
    inbox_write("checks", line, [line], [], 0)
    return line


