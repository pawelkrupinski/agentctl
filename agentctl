def cmd_state(a):
    path = os.path.join(scratch(), f"state-{a.topic}.md")
    if not os.path.exists(path):
        with open(path, "w") as f:
            f.write(TEMPLATE.format(topic=a.topic, ts=ts()))
        err(f"created {path}")
    text = open(path).read()
    changed = False
    for spec, append in [(s, False) for s in a.set or []] + [(s, True) for s in a.add or []]:
        field, _, value = spec.partition("=")
        field = field.strip()
        pat = re.compile(rf"^{re.escape(field)}:[ \t]*(.*)$", re.M)
        m = pat.search(text)
        if m:
            old = m.group(1).strip()
            new = f"{old}, {value}" if append and old else value
            text = text[: m.start()] + f"{field}: {new}" + text[m.end():]
        else:
            text = text.rstrip("\n") + f"\n{field}: {value}\n"
        changed = True
    if changed:
        text = re.sub(r"^updated:.*$", f"updated: {ts()}", text, count=1, flags=re.M)
        with open(path, "w") as f:
            f.write(text)
    print(f"# {path}")
    print(text, end="")
    return 0


# ---------------------------------------------------------------- prepush-check
def changed_files(repo, a, b):
    """[(status, path)] for a..b (renames split into delete + add)."""
    out = git(repo, "diff", "--name-status", "--no-renames", "-z", a, b)
    parts = out.split("\0")
    res = []
    i = 0
    while i + 1 < len(parts):
        res.append((parts[i], parts[i + 1]))
        i += 2
    return res


def blobs(repo, specs):
    """Map 'rev:path' -> blob sha or None, in one cat-file call."""
    if not specs:
        return {}
    r = git(repo, "cat-file", "--batch-check=%(objectname)", input="\n".join(specs) + "\n")
    lines = r.splitlines()
    return {s: (None if l.endswith("missing") else l.strip()) for s, l in zip(specs, lines)}


def reverted_commits(repo, mb, head):
    shas = set()
    for body in git(repo, "log", "--format=%B%x00", f"{mb}..{head}").split("\0"):
        shas.update(re.findall(r"This reverts commit ([0-9a-f]{7,40})", body))
    files = set()
    for s in shas:
        r = git(repo, "show", "--name-only", "--format=", s, check=False)
        if r.returncode == 0:
            files.update(l for l in r.stdout.splitlines() if l)
    files.update(declared_retirements(repo, mb, head))
    return files


def declared_retirements(repo, mb, head):
    """Paths named by a `Retires: <path>` trailer (final trailer block) of a commit in mb..head AND absent at head:
    a declared deletion is the author's call, not a squash undoing main. Undeclared or still-present files don't count."""
    paths = set()
    for body in git(repo, "log", "--format=%(trailers:key=Retires,valueonly,unfold)%x00", f"{mb}..{head}").split("\0"):
        paths.update(l.strip() for l in body.splitlines() if l.strip())
    return {p for p in paths if git(repo, "cat-file", "-e", f"{head}:{p}", check=False).returncode != 0}


def foreign_reverts(repo, base, head, files, depth=8, since="45.days"):
    """Files whose content at head equals an OLDER version from main's history -- i.e. the push would undo
    someone's change on main (absence counts: deleting a file main recently added)."""
    hits = []
    head_specs = [f"{head}:{p}" for _, p in files]
    head_blob = blobs(repo, head_specs)
    for (_, p), hs in zip(files, head_specs):
        hb = head_blob[hs]
        commits = git(repo, "log", f"-n{depth}", f"--since={since}", "--format=%H", base, "--", p).split()
        if not commits:
            continue
        olds = blobs(repo, [f"{c}^:{p}" for c in commits])
        cur = blobs(repo, [f"{base}:{p}"])[f"{base}:{p}"]
        for c in commits:
            ob = olds[f"{c}^:{p}"]
            if ob == hb and ob != cur:
                hits.append((p, c[:10]))
                break
    return hits


def allowed(path, globs):
    return any(fnmatch.fnmatch(path, g) or path.startswith(g.rstrip("/") + "/") for g in globs)


def check_range(repo, base, head, allow, max_foreign):
    problems = []
    mb = git(repo, "merge-base", base, head).strip()
    files = changed_files(repo, mb, head)
    stat = git(repo, "diff", "--shortstat", mb, head).strip()
    print(f"prepush-check: {base}...{head[:12]}: {stat or 'no changes'}")
    if allow:
        outside = [p for _, p in files if not allowed(p, allow)]
        if outside:
            problems.append(f"{len(outside)} file(s) outside the allowed set {allow}: " + ", ".join(outside[:20]))
    empty = [c for c in git(repo, "rev-list", "--no-merges", f"{mb}..{head}").split()
             if is_empty_commit(repo, c) and not deliberate_empty(repo, c)]
    if empty:  # never an empty commit on main (four landed as re-queued duplicates, 2026-10-27)
        problems.append(f"{len(empty)} EMPTY commit(s) (no change: already on main?): "
                        + ", ".join(f"{c[:10]} {git(repo, 'log', '-1', '--format=%s', c).strip()[:60]}" for c in empty[:10])
                        + f". Drop them (git rebase {base}); a deliberate empty commit needs an "
                          f"`{ALLOW_EMPTY_TRAILER}: <why>` trailer")
    exempt = reverted_commits(repo, mb, head)
    reverts = [(p, c) for p, c in foreign_reverts(repo, base, head, files) if p not in exempt]
    if allow:  # files in the allowed set are the agent's own: reverting them is its call
        reverts = [(p, c) for p, c in reverts if not allowed(p, allow)]
    if len(reverts) > max_foreign:
        problems.append(
            f"{len(reverts)} file(s) would be reverted/deleted back to an older main version (max {max_foreign}) -- "
            "a squash onto a moved main? `git rebase forgejo/main` and re-check. "
            + ", ".join(f"{p} (undoes {c})" for p, c in reverts[:20])
        )
    return problems


def cmd_prepush(a):
    repo = os.getcwd()
    allow = (a.allow or []) + os.environ.get("AGENTCTL_ALLOW", "").split()
    max_foreign = a.max_foreign if a.max_foreign is not None else int(os.environ.get("AGENTCTL_MAX_FOREIGN", "2"))
    problems = []
    if a.hook:
        remote = a.hook[0]
        base_ref = f"refs/remotes/{remote}/main"
        for line in sys.stdin.read().splitlines():
            parts = line.split()
            if len(parts) != 4:
                continue
            _, lsha, rref, rsha = parts
            if lsha == ZERO or not rref.startswith("refs/heads/"):
                continue  # deletes and tags: nothing to check
            base = base_ref if git_ok(repo, "rev-parse", "--verify", "-q", base_ref) else rsha
            if base == ZERO:
                continue
            problems += check_range(repo, base, lsha, allow, max_foreign)
    else:
        problems = check_range(repo, a.base, git(repo, "rev-parse", a.head).strip(), allow, max_foreign)
    for p in problems:
        print(f"prepush-check: REFUSED: {p}", file=sys.stderr)
    if problems:
        return 1
    print("prepush-check: ok")
    return 0


# ---------------------------------------------------------------- cleanup
def log_deletion(kind, repo, name, sha, why):
    with open(os.path.join(scratch(), "agentctl-deleted.log"), "a") as f:
        f.write(f"{ts()}\t{kind}\t{repo}\t{name}\t{sha}\t{why}\n")


def worktrees(repo):
    wts, cur = [], {}
    for line in git(repo, "worktree", "list", "--porcelain").splitlines() + [""]:
        if not line:
            if cur:
                wts.append(cur)
            cur = {}
            continue
        k, _, v = line.partition(" ")
        cur[k] = v if v else True
    return [w for w in wts if not isinstance(w.get("worktree"), str) or allowed_path(w["worktree"])]


SYSTEM_CMD = ("/System/", "/Applications/", "/usr/libexec/", "/Library/", "/usr/sbin/", "/sbin/", "/usr/bin/login")


def cwd_candidates():
    """Pids worth asking for a cwd: everything but GUI apps and system daemons (Finder, Preview...). NEVER every process:
    lsof walking all cwds touches ~/Desktop, ~/Documents... and macOS charges those to our Python (TCC prompts)."""
    return [pid for pid, _pp, _e, cmd in ps() if not cmd.startswith(SYSTEM_CMD) and pid != os.getpid()]


def lsof_cwds(pids):
    """{pid: cwd} through ONE `lsof -a -p <pids> -d cwd` (always pid-scoped), keeping only allowed paths."""
    pids = [int(x) for x in pids]
    res = {}
    for i in range(0, len(pids), 200):
        r = subprocess.run(["lsof", "-nP", "-a", "-p", ",".join(map(str, pids[i:i + 200])), "-d", "cwd", "-Fpn"],
                           capture_output=True, text=True, stdin=subprocess.DEVNULL)
        pid = None
        for line in r.stdout.splitlines():
            if line.startswith("p"):
                pid = int(line[1:])
            elif line.startswith("n") and pid and allowed_path(line[1:]):
                res[pid] = line[1:]
    return res


def process_cwds():
    return lsof_cwds(cwd_candidates())


def gitdir_activity(repo, wt_path):
    gd = git(repo, "-C", wt_path, "rev-parse", "--absolute-git-dir", check=False)
    if gd.returncode != 0:
        return None
    d = gd.stdout.strip()
    mt = [os.stat(os.path.join(d, f)).st_mtime for f in ("HEAD", "index", "logs/HEAD", "ORIG_HEAD") if os.path.exists(os.path.join(d, f))]
    return max(mt) if mt else None


def merged_reason(repo, head, main):
    if git_ok(repo, "merge-base", "--is-ancestor", head, main):
        return "ancestor of forgejo/main"
    lines = git(repo, "cherry", main, head).splitlines()
    if lines and all(l.startswith("-") for l in lines):
        return f"all {len(lines)} commit(s) patch-equivalent on forgejo/main"
    return None


CACHE_TREES = os.path.join(HOME, ".cache") + "/"  # tool-owned trees (e.g. kinowo-identity measure-local): reused, not litter


def plan_worktrees(repo, main, min_age_h, cwds, include_caches=False):
    """[(action, wt, branch, sha, reason)] where action is 'delete' or 'skip'."""
    plan = []
    wts = worktrees(repo)
    checked_out = {w.get("branch") for w in wts if w.get("branch")}
    for w in wts[1:]:  # the first entry is the main checkout
        path, sha = w["worktree"], w.get("HEAD", "")
        branch = w.get("branch", "").removeprefix("refs/heads/") or None
        def skip(why):
            plan.append(("skip", path, branch, sha, why))
        if "locked" in w:
            skip("locked"); continue
        if branch in PROTECTED_BRANCHES:
            skip(f"on {branch}"); continue
        if path.startswith(CACHE_TREES) and not include_caches:
            skip("tool cache tree (--include-caches to consider)"); continue
        if "prunable" in w or not os.path.isdir(path):
            skip("directory missing (prunable; not touched)"); continue
        busy = [p for p, c in cwds.items() if c == path or c.startswith(path + "/")]
        if busy:
            skip(f"in use by pid {busy[:3]}"); continue
        act = gitdir_activity(repo, path)
        if act and time.time() - act < min_age_h * 3600:
            skip(f"active {int((time.time() - act) / 60)} min ago"); continue
        dirty = git(repo, "-C", path, "status", "--porcelain", "--untracked-files=all", check=False)
        if dirty.returncode != 0:
            skip("git status failed"); continue
        if dirty.stdout.strip():
            skip(f"dirty ({len(dirty.stdout.splitlines())} changed/untracked)"); continue
        why = merged_reason(repo, sha, main)
        if not why:
            n = len(git(repo, "rev-list", f"{main}..{sha}").split())
            skip(f"unmerged ({n} commit(s) not on forgejo/main)"); continue
        plan.append(("delete", path, branch, sha, why))
    return plan


def plan_measure(o_r, runs_for, now_=None):
    """Remote measure/* branches: [(action, name, sha, reason)]. runs_for(name) -> list of run dicts."""
    now_ = now_ or now()
    plan, page = [], 1
    while True:
        bs = api(o_r, "GET", "branches", {"limit": 50, "page": page})
        for b in bs:
            if b["name"].startswith("measure/"):
                plan.append(measure_decision(b["name"], b["commit"]["id"], parse_time(b["commit"]["timestamp"]), runs_for(b["name"]), now_))
        if len(bs) < 50:
            return plan
        page += 1


def measure_decision(name, sha, commit_time, runs, now_):
    if not name.startswith("measure/"):
        return ("skip", name, sha, "not a measure/ branch")
    active = [r for r in runs if r.get("status") != "completed"]
    if active:
        return ("skip", name, sha, f"run {active[0].get('databaseId')} {active[0].get('status')}")
    if runs:
        return ("delete", name, sha, f"{len(runs)} run(s) finished")
    age_h = (now_ - commit_time).total_seconds() / 3600
    if age_h > 24:
        return ("delete", name, sha, f"no runs, {age_h:.0f}h old")
    return ("skip", name, sha, f"no runs yet, {age_h:.1f}h old")


def cmd_cleanup(a):
    dry = a.dry_run or (sys.stdin.isatty() and not a.execute)
    mode = "DRY RUN" if dry else "EXECUTE"
    print(f"agentctl cleanup ({mode}); log: {os.path.join(scratch(), 'agentctl-deleted.log')}")
    cwds = process_cwds()
    rc = 0
    for repo in a.repo or REPOS:
        repo = os.path.abspath(os.path.expanduser(repo))
        name = os.path.basename(repo)
        if not os.path.isdir(repo):
            continue
        try:
            if not a.no_fetch:
                git(repo, "fetch", "--quiet", REMOTE, "main")
            main = git(repo, "rev-parse", f"refs/remotes/{REMOTE}/main").strip()
        except RuntimeError as e:
            err(f"{name}: {e}; skipping repo"); rc = 1; continue
        print(f"\n== {name} (forgejo/main {main[:10]})")
        for action, path, branch, sha, why in plan_worktrees(repo, main, a.min_age_hours, cwds, a.include_caches):
            label = f"worktree {path} [{branch or 'detached'}] {sha[:10]}"
            if action == "skip":
                if a.verbose:
                    print(f"  keep   {label}: {why}")
                continue
            print(f"  {'would delete' if dry else 'delete'} {label}: {why}")
            if dry:
                continue
            # Re-verify right before acting; `git worktree remove` (no --force) refuses dirty trees itself.
            if git(repo, "-C", path, "rev-parse", "HEAD").strip() != sha or not merged_reason(repo, sha, main):
                print("    changed since planning; kept"); continue
            r = git(repo, "worktree", "remove", path, check=False)
            if r.returncode != 0:
                print(f"    worktree remove refused: {r.stderr.strip()}"); rc = 1; continue
            log_deletion("worktree", name, path, sha, why)
            if branch and branch not in PROTECTED_BRANCHES:
                others = {w.get("branch") for w in worktrees(repo)}
                if f"refs/heads/{branch}" in others:
                    print(f"    branch {branch} checked out elsewhere; kept"); continue
                r = git(repo, "update-ref", "-d", f"refs/heads/{branch}", sha, check=False)
                if r.returncode == 0:
                    log_deletion("branch", name, branch, sha, why)
                    print(f"    deleted branch {branch} ({sha[:10]})")
                else:
                    print(f"    branch {branch} not deleted: {r.stderr.strip()}"); rc = 1
        if a.no_remote:
            continue
        o_r = slug(repo)
        try:
            runs_for = lambda b: gh_json(o_r, "run", "list", "--branch", b, "--limit", "20", "--json", "databaseId,status")
            mplan = plan_measure(o_r, runs_for)
        except Exception as e:
            err(f"{name}: measure branches not checked: {e}"); rc = 1; continue
        for action, bname, sha, why in mplan:
            label = f"remote {o_r}:{bname} {sha[:10]}"
            if action == "skip":
                if a.verbose:
                    print(f"  keep   {label}: {why}")
                continue
            print(f"  {'would delete' if dry else 'delete'} {label}: {why}")
            if dry:
                continue
            try:
                cur = api(o_r, "GET", f"branches/{urllib.parse.quote(bname, safe='')}")["commit"]["id"]
                if cur != sha:
                    print("    moved since planning; kept"); continue
                api(o_r, "DELETE", f"branches/{urllib.parse.quote(bname, safe='')}")
                log_deletion("remote-branch", o_r, bname, sha, why)
            except Exception as e:
                print(f"    delete failed: {e}"); rc = 1
    return rc


# ---------------------------------------------------------------- the lifecycle closes itself
# The owner (2026-10-26): after WATCH OK, land removes the worktree it ran from and its branch -- only when proven merged
# (git cherry shows nothing of its own left, the tree clean) and never the root checkout or a tree another process is
# in; and a daily `agentctl sweep` reports what is unmerged and idle, deleting only remote branches proven merged.
SWEEP_IDLE_DAYS = 3
SWEEP_KEEP_REMOTE = ("main", "master", WAITING_BRANCH)
SWEEP_DIR = None  # a test's override; else sweep_dir(): under the state root, resolved at each use


def sweep_dir():
    return SWEEP_DIR or state_root("sweep")
SWEEP_REPOS = [os.path.join(HOME, "projects", "movies")]


def own_ancestry():
    """This process and its parents (the agent's shell is in the worktree it lands from)."""
    parents = {p: pp for p, pp, _e, _c in ps()}
    chain, pid = set(), os.getpid()
    while pid and pid not in chain:
        chain.add(pid)
        pid = parents.get(pid)
    return chain


def close_worktree(wt):
    """Remove the worktree land ran from and its local branch, when proven merged. Returns one line saying what."""
    wt = os.path.realpath(wt)
    try:
        trees = worktrees(wt)
    except RuntimeError as e:
        return f"worktree {wt} kept: {e}"
    root = os.path.realpath(trees[0]["worktree"])
    if wt == root:
        return f"worktree {wt} kept: the root checkout is never closed"
    me = next((t for t in trees if os.path.realpath(t["worktree"]) == wt), None)
    if me is None:
        return f"worktree {wt} kept: not a worktree of {root}"
    if "locked" in me:
        return f"worktree {wt} kept: locked"
    branch = (me.get("branch") or "").removeprefix("refs/heads/") or None
    if branch in PROTECTED_BRANCHES:
        return f"worktree {wt} kept: on {branch}"
    mine = own_ancestry()
    busy = [p for p, c in process_cwds().items() if p not in mine and (c == wt or c.startswith(wt + "/"))]
    if busy:
        return f"worktree {wt} kept: in use by pid {busy[:3]}"
    dirty = git(wt, "status", "--porcelain", "--untracked-files=all", check=False)
    if dirty.returncode or dirty.stdout.strip():
        return f"worktree {wt} kept: the tree is not clean ({len(dirty.stdout.splitlines())} changed/untracked)"
    git(wt, "fetch", "--quiet", REMOTE, "main", check=False)
    main = f"refs/remotes/{REMOTE}/main"
    head = git(wt, "rev-parse", "HEAD").strip()
    ahead = [l for l in git(wt, "cherry", main, head).splitlines() if l.startswith("+")]
    if ahead:
        return f"worktree {wt} kept: {len(ahead)} commit(s) not on forgejo/main"
    why = merged_reason(root, head, main) or "nothing of its own left"
    r = git(root, "worktree", "remove", wt, check=False)
    if r.returncode:
        return f"worktree {wt} kept: git worktree remove refused: {r.stderr.strip()[:200]}"
    log_deletion("worktree", os.path.basename(root), wt, head, f"closed after WATCH OK: {why}")
    msg = f"closed worktree {wt}"
    if branch and f"refs/heads/{branch}" not in {t.get("branch") for t in worktrees(root)}:
        if git(root, "update-ref", "-d", f"refs/heads/{branch}", head, check=False).returncode == 0:
            log_deletion("branch", os.path.basename(root), branch, head, f"closed after WATCH OK: {why}")
            msg += f" and branch {branch}"
    return msg + f" ({why})"


def delete_remote_branch(repo, o_r, name, sha):
    """Delete a forge branch through the API, only if it still points at sha."""
    q = urllib.parse.quote(name, safe="")
    cur = api(o_r, "GET", f"branches/{q}")["commit"]["id"]
    if cur != sha:
        raise RuntimeError(f"moved to {cur[:10]} since it was read")
    api(o_r, "DELETE", f"branches/{q}")


FETCH_TIMEOUT = 180  # an unattended fetch's bound ($AGENTCTL_FETCH_TIMEOUT)


def bounded_fetch(repo, *extra):
    """`git fetch forgejo` for an unattended run (maintain's sweep): bounded, ssh keepalives on, never prompting. True,
    or why not (2026-10-27: Forgejo's ssh accepted the connection and never answered, and the first maintain pass hung
    in the sweep's fetch)."""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_SSH_COMMAND=GIT_NET_SSH)
    try:
        r = subprocess.run(["git", "-C", repo, "fetch", "--quiet", *extra, REMOTE], capture_output=True, text=True, env=env,
                           timeout=env_num("AGENTCTL_FETCH_TIMEOUT", FETCH_TIMEOUT), stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return f"timed out after {int(env_num('AGENTCTL_FETCH_TIMEOUT', FETCH_TIMEOUT))} s"
    return True if r.returncode == 0 else (r.stderr.strip().splitlines() or ["exit %d" % r.returncode])[-1][:160]


def sweep_repo(repo, idle_days, dry, out):
    name = os.path.basename(repo)
    now_ = time.time()
    fetched = bounded_fetch(repo, "--prune")
    main = f"refs/remotes/{REMOTE}/main"
    if fetched is not True:
        out.append(f"== {name}: fetch failed ({fetched}): from the last fetched state")
    out.append(f"== {name} (forgejo/main {git(repo, 'rev-parse', main).strip()[:10]})")
    idle_wt, checked_out = [], set()
    for w in worktrees(repo)[1:]:
        path, sha = w["worktree"], w.get("HEAD", "")
        branch = (w.get("branch") or "").removeprefix("refs/heads/")
        checked_out.add(branch)
        if not os.path.isdir(path) or path.startswith(CACHE_TREES) or merged_reason(repo, sha, main):
            continue
        tip = int(git(repo, "log", "-1", "--format=%ct", sha, check=False).stdout.strip() or 0)
        last = max(gitdir_activity(repo, path) or 0, tip)
        days = (now_ - last) / 86400
        if days > idle_days:
            n = len(git(repo, "rev-list", f"{main}..{sha}").split())
            idle_wt.append(f"  UNMERGED worktree {path} [{branch or 'detached'}]: {n} commit(s), idle {int(days)} d")
    out += idle_wt or [f"  no unmerged worktree idle more than {idle_days} d"]
    lonely = []
    for line in git(repo, "for-each-ref", "--format=%(refname:short) %(objectname) %(committerdate:unix)",
                    "refs/heads").splitlines():
        b, sha, t = line.split()
        if b in PROTECTED_BRANCHES or b in checked_out or merged_reason(repo, sha, main):
            continue
        days = (now_ - int(t)) / 86400
        if days > idle_days:
            lonely.append(f"  UNMERGED branch {b} (no worktree): tip {sha[:10]}, idle {int(days)} d")
    out += lonely
    o_r = None
    for line in git(repo, "ls-remote", "--heads", REMOTE).splitlines():
        sha, ref = line.split()
        b = ref.removeprefix("refs/heads/")
        if b in SWEEP_KEEP_REMOTE or b.startswith("measure/"):
            continue  # measure/* is `agentctl cleanup`'s, by its runs
        if not git_ok(repo, "cat-file", "-e", f"{sha}^{{commit}}"):
            git(repo, "fetch", "--quiet", REMOTE, b, check=False)
        why = git_ok(repo, "cat-file", "-e", f"{sha}^{{commit}}") and merged_reason(repo, sha, main)
        if not why:
            t = int(git(repo, "log", "-1", "--format=%ct", sha, check=False).stdout.strip() or now_)
            out.append(f"  unmerged remote branch {b}: tip {sha[:10]}, {int((now_ - t) / 86400)} d old (listed, kept)")
            continue
        if dry:
            out.append(f"  would delete remote branch {b} {sha[:10]}: {why}")
            continue
        try:
            o_r = o_r or slug(repo)
            delete_remote_branch(repo, o_r, b, sha)
            log_deletion("remote-branch", o_r, b, sha, f"sweep: {why}")
            out.append(f"  deleted remote branch {b} {sha[:10]}: {why}")
        except Exception as e:
            out.append(f"  remote branch {b} not deleted: {e}")
    out.append("== branches whose owner is gone (worktree removed or pid dead) and whose runs all finished")
    try:
        if not orphan_branches(repo, o_r or slug(repo), dry, out):
            out.append("  none")
    except (Exception, SystemExit) as e:
        out.append(f"  could not list them ({str(e)[:160]})")


def cmd_sweep(a):
    repos = [os.path.abspath(os.path.expanduser(r)) for r in (a.repo or SWEEP_REPOS)]
    out = [f"agentctl sweep {ts()}{' (DRY RUN)' if a.dry_run else ''}: unmerged and idle > {a.idle_days} d is listed, "
           "never deleted; remote branches proven merged into main are deleted (standing OK)"]
    rc = 0
    for repo in repos:
        try:
            sweep_repo(repo, a.idle_days, a.dry_run, out)
        except RuntimeError as e:
            out.append(f"== {os.path.basename(repo)}: {e}")
            rc = 1
    out.append("== red claims (stale: no commit, activity or live process for "
               f"{int(env_num('AGENTCTL_RED_STALE_MIN', RED_STALE_MIN))} min){': not removed (DRY RUN)' if a.dry_run else ''}")
    if not a.dry_run:
        sweep_claims(out=out)
    reaped = io.StringIO()
    if os.environ.get("AGENTCTL_SBT_REAP") != "0":  # the tests never reap this machine's servers
        with contextlib.redirect_stdout(reaped):
            cmd_orphans(argparse.Namespace(kill=not a.dry_run, sbt_only=True))
    out.append("== sbt servers (a gone worktree, an orphaned serving command, a running command with no CPU for "
               f"{SBT_STALL_MIN} min){'' if not a.dry_run else ': not reaped (DRY RUN)'}")
    out += ["  " + l for l in reaped.getvalue().splitlines()]
    text = "\n".join(out)
    print(text)
    if not a.no_report:
        os.makedirs(sweep_dir(), exist_ok=True)
        with open(os.path.join(sweep_dir(), dt.date.today().isoformat() + ".txt"), "w") as f:
            f.write(text + "\n")
    return rc


# ---------------------------------------------------------------- orphans
def ps():
    r = subprocess.run(["ps", "-axo", "pid=,ppid=,etime=,command="], capture_output=True, text=True)
    out = []
    for line in r.stdout.splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4:
            out.append((int(parts[0]), int(parts[1]), parts[2], parts[3]))
    return out


def loop_body(cmd):
    m = re.search(r"eval '(.*)' < /dev/null", cmd, re.S)
    return m.group(1) if m else cmd


def is_wait_loop(cmd):
    if re.search(r"\bagentctl wait\b", cmd):
        return True
    if not re.match(r"\S*(zsh|bash|sh) ", cmd):
        return False
    body = loop_body(cmd)
    return bool(re.search(r"\bsleep\b", body) and re.search(r"\b(until|while)\b", body))


def loop_targets(body):
    ids = set(re.findall(r"run (?:view|watch) (\d+)", body)) | set(re.findall(r"/runs/(\d+)", body))
    ids |= {i for m in re.findall(r"for \w+ in ((?:\d+\s+)*\d+)\s*;", body) for i in m.split()}
    m = re.search(r"(?:-R|--repo)[ =]([\w.-]+/[\w.-]+)", body) or re.search(r"agentctl wait run (\S+)", body)
    repo = None
    if m:
        try:
            repo = slug(m.group(1))
        except SystemExit:
            repo = None
    return repo, sorted(ids, key=int)


def missing_tree_paths(text):
    gone = set()
    for p in re.findall(rf"{re.escape(HOME)}/(?:projects|bitcashier)/[\w.-]+", text):
        if not os.path.exists(p):
            gone.add(p)
    return sorted(gone)


# STUCK SBT SERVERS (2026-10-27): a worktree's one server ran an orphaned `--serve` (its owner's shell died) for hours,
# and every later command queued behind it at 0% CPU. Besides a gone worktree, orphans/sweep reap a server whose
# serving command's sbt-warm or owner is dead (scripts/sbt-warm's $State/<key>.serving), and one with a command
# running (an sbtn client in its checkout) whose process tree used no CPU for SBT_STALL_MIN minutes, judged across
# runs from ~/.cache/agentctl/sbt-cpu.json. A thread dump (jcmd Thread.print) is saved first, under
# ~/.cache/agentctl/sbt-dumps/.
SBT_STALL_MIN = 20


def sbt_warm_state():
    return os.environ.get("KINOWO_SBT_WARM_STATE") or os.path.join(HOME, ".cache", "kinowo-sbt-warm")


def sbt_serving():
    """{checkout root: (serving sbt-warm pid, owner pid or None, command)} from sbt-warm's .serving marks."""
    out = {}
    for path in glob.glob(os.path.join(sbt_warm_state(), "*.serving")):
        try:
            with open(path) as f:
                parts = f.read().split(None, 2)
            with open(path[: -len(".serving")] + ".root") as f:
                root = f.read().strip()
        except OSError:
            continue
        if len(parts) >= 2:
            owner = None if parts[1] == "-" else int(parts[1]) if parts[1].isdigit() else None
            out[root] = (int(parts[0]) if parts[0].isdigit() else 0, owner, parts[2].strip() if len(parts) > 2 else "")
    return out


def tree_cpu(pid, procs_cpu, children):
    """CPU seconds of pid and every descendant (the server and its forked test JVMs)."""
    total, todo = 0.0, [pid]
    while todo:
        p = todo.pop()
        total += procs_cpu.get(p, 0.0)
        todo += children.get(p, [])
    return total


def sbt_stuck_reasons(pid, cwd, cpu, clients, serving, state, now):
    """Why the sbt server pid (checkout cwd, tree CPU seconds) is stuck: an orphaned serving command, or a running
    command and no CPU for SBT_STALL_MIN. Updates state[pid] = {cpu, since}."""
    reasons = []
    serve = serving.get(cwd)
    if serve:
        spid, owner, cmd = serve
        if not pid_alive(spid) or (owner and not pid_alive(owner)):
            reasons.append(f"serving `{cmd[:60]}` for {'sbt-warm pid ' + str(spid) if not pid_alive(spid) else 'owner pid ' + str(owner)}, which ended")
    rec = state.get(str(pid))
    if not rec or abs(rec.get("cpu", -1) - cpu) > 0.5:
        state[str(pid)] = {"cpu": cpu, "since": now}
    elif clients.get(cwd):
        mins = (now - rec["since"]) / 60
        limit = float(os.environ.get("AGENTCTL_SBT_STALL_MIN", SBT_STALL_MIN))
        if mins >= limit:
            reasons.append(f"a command running (sbtn pid {clients[cwd][0]}) and no CPU for {int(mins)} min")
    return reasons


def thread_dump(pid, cwd):
