GATE_LINE = re.compile(r"gate (RED|green)\b")


def gate_summary_path():
    return os.environ.get("AGENTCTL_GATE_SUMMARY") or state_root("gate-summary.txt")


def publish_gate_summary(o_r, line, epoch=None):
    """Atomically: `<epoch>\t<repo>\t<line>`. Only a read gate line is ever published (never UNREAD)."""
    if not GATE_LINE.match(line):
        return
    path = gate_summary_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        with open(path) as f:
            prev = f.read().rstrip("\n").split("\t", 2)[1:]
    except (OSError, ValueError):
        prev = None
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        f.write(f"{int(epoch or time.time())}\t{o_r}\t{line}\n")
    os.replace(tmp, path)
    if prev != [o_r, line]:  # the reds or their states changed: the status line refreshes at its next call, not at 60 s
        marker = statusline_stale_path()
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        with open(marker, "a"):
            pass
        os.utime(marker, None)


def cached_gate_summary(o_r, now=None):
    """(line, written_epoch). line is None for a missing, malformed, other-repo, future-dated or too-old file."""
    try:
        epoch, repo_, line = open(gate_summary_path()).read().rstrip("\n").split("\t", 2)
        epoch = int(epoch)
    except (OSError, ValueError):
        return None, None
    age = (now or time.time()) - epoch
    if repo_ != o_r or not GATE_LINE.match(line) or age < -5 or age > GATE_SUMMARY_MAX_AGE:
        return None, epoch
    return line, epoch


_last_gate_publish = [0.0]
