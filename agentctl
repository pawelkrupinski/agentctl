# ---- THE PACKAGE: the rest of agentctl's code (lib/agentctl/, see its __init__.py) runs in THIS namespace, in
# order, as if it were still written here: one namespace, so `agentctl.<name>` is every name and a test's patch of one
# is seen by all. The entry finds the package relative to itself (ci-runner runs `python3 <pinned tree>/agentctl`).
def _load_package():
    import os as _os
    lib = _os.path.join(_os.path.dirname(_os.path.realpath(__file__)), "lib", "agentctl")
    init = _os.path.join(lib, "__init__.py")
    ns = {"__name__": "agentctl._parts"}
    with open(init) as f:
        exec(compile(f.read(), init, "exec"), ns)
    ns["load_into"](globals())


_load_package()

