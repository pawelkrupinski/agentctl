# ---------------------------------------------------------------- helpers
def now():
    return dt.datetime.now(dt.timezone.utc)


def ts():
    return now().strftime("%Y-%m-%dT%H:%M:%SZ")


def err(msg):
    print(f"agentctl: {msg}", file=sys.stderr, flush=True)


def scratch():
    d = os.environ.get("AGENTCTL_SCRATCH")
    if not d:
        sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
        hits = sorted(glob.glob(f"/private/tmp/claude-{os.getuid()}/*/{sid}/scratchpad")) if sid else []
        d = hits[0] if hits else os.path.join(HOME, ".cache", "agentctl")
    os.makedirs(d, exist_ok=True)
    return d


def git(repo, *args, check=True, input=None):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, input=input)
    if check and r.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)} in {repo}: {r.stderr.strip()}")
    return r.stdout if check else r


def git_ok(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True).returncode == 0


def slug(repo_arg):
    if repo_arg in SHORT:
        return SHORT[repo_arg]
    if os.path.isdir(repo_arg):
        url = git(repo_arg, "remote", "get-url", REMOTE).strip()
        m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?/?$", url)
        if not m:
            raise SystemExit(f"agentctl: cannot parse remote url of {repo_arg}")
        return m.group(1)
    if re.fullmatch(r"[\w.-]+/[\w.-]+", repo_arg):
        return repo_arg
    raise SystemExit(f"agentctl: unknown repo {repo_arg!r}")


_tokens = {}


def token(o_r):
    if os.environ.get("GH_TOKEN"):
        return os.environ["GH_TOKEN"]
    ns = "movies" if o_r.startswith("pawelkrupinski/") else "bitcashier"
    if ns == "movies" and os.environ.get("FORGEJO_API_TOKEN"):  # the queue processor's handed-over token
        return os.environ["FORGEJO_API_TOKEN"]
    if ns not in _tokens:
        r = subprocess.run(["secrets", "get", ns, "FORGEJO_API_TOKEN"], capture_output=True, text=True)
        if r.returncode != 0 or not r.stdout.strip():
            raise SystemExit(f"agentctl: could not read the {ns} FORGEJO_API_TOKEN from the vault")
        _tokens[ns] = r.stdout.strip()
    return _tokens[ns]


def gh_json(o_r, *args):
    env = dict(os.environ, GH_TOKEN=token(o_r))
    r = subprocess.run([FORGEJO_GH, *args, "-R", o_r], capture_output=True, text=True, env=env, timeout=300)
    if r.returncode != 0:
        raise RuntimeError(f"forgejo-gh {' '.join(args)}: {r.stderr.strip()[:300]}")
    return json.loads(r.stdout)


def api(o_r, method, path, params=None):
    url = f"{API}/repos/{o_r}/{path}" + ("?" + urllib.parse.urlencode(params) if params else "")
    req = urllib.request.Request(url, method=method, headers={"Authorization": f"token {token(o_r)}"})
    with urllib.request.urlopen(req, timeout=60) as resp:
        body = resp.read()
    return json.loads(body) if body else None


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def parse_time(s):
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))


# ---------------------------------------------------------------- wait
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
LOG_TS = re.compile(r"^\d{4}-\d\d-\d\dT[\d:.]+Z ")
STRONG = re.compile(r"\*\*\* FAILED|\[error\]|::error::|(?i:assertion|assert(ion)? failed)|\bError:|ENOENT|artifact already exists|(?i:exit code [1-9])|\bFAILED\b")
WEAK = re.compile(r"\bfail(ed|ure)?\b|\berror\b|exception|assert", re.I)
NOISE = re.compile(r"Setting level of logger|\|-INFO in ch\.qos|\berrors?[=:] ?0\b|\b0 (errors?|failed)\b|\b(INFO|DEBUG|TRACE)\b", re.I)
MEASURE_WORKFLOWS = {"Identity model convergence"}


def relevant_lines(log_text, tail):
    """{job: [last `tail` relevant lines]} from `forgejo-gh run view --log-failed` output (job<TAB>step<TAB>line).
    Strong markers (*** FAILED, [error], ::error::, assertion, exit code) win; plain fail/error words only when a job
    has none, and never from INFO/DEBUG log lines."""
    strong, weak, follow = {}, {}, {}
    for raw in log_text.splitlines():
        parts = raw.split("\t", 2)
        job, line = (parts[0], parts[2]) if len(parts) == 3 else ("?", raw)
        line = LOG_TS.sub("", ANSI.sub("", line)).rstrip()
        if not line:
            continue
        if follow.get(job):  # the 2 lines after a scalatest `*** FAILED ***` carry its reason
            follow[job] -= 1
            strong.setdefault(job, []).append(line[:300])
            continue
        if "*** FAILED ***" in line:
            follow[job] = 2
        if STRONG.search(line) and not re.search(r"Setting level of logger|-INFO in ch\.qos", line):
            strong.setdefault(job, []).append(line[:300])
        elif WEAK.search(line) and not NOISE.search(line):
            weak.setdefault(job, []).append(line[:300])
    return {j: (strong.get(j) or weak.get(j))[-tail:] for j in set(strong) | set(weak)}


def raw_tails(log_text, n=3):
    """{job: (line count, last n cleaned lines)} of a --log-failed output."""
    out = {}
    for raw in log_text.splitlines():
        parts = raw.split("\t", 2)
        job, line = (parts[0], parts[2]) if len(parts) == 3 else ("?", raw)
        line = LOG_TS.sub("", ANSI.sub("", line)).rstrip()
        cnt, last = out.get(job, (0, []))
        out[job] = (cnt + 1, (last + [line[:200]])[-n:])
    return out


def fetch_failed_log(o_r, run_id):
    env = dict(os.environ, GH_TOKEN=token(o_r))
    r = subprocess.run([FORGEJO_GH, "run", "view", str(run_id), "--log-failed", "-R", o_r], capture_output=True, text=True, env=env, timeout=300)
    return r.stdout


def fetch_takes_verdicts(o_r, run_id):
    """{artifact: verdict.txt text} of a measure run's identity-takes-<cc> artifacts (the takes rows' verdict files)."""
    env = dict(os.environ, GH_TOKEN=token(o_r))
    arts = gh_json(o_r, "api", f"repos/{o_r}/actions/runs/{run_id}/artifacts").get("artifacts", [])
    out = {}
    for a in arts:
        name = a.get("name", "")
        if not name.startswith("identity-takes-"):
            continue
        d = os.path.join(scratch(), "agentctl-wait", f"art-{run_id}-{name}")
        os.makedirs(d, exist_ok=True)
        subprocess.run([FORGEJO_GH, "run", "download", str(run_id), "-n", name, "-D", d, "-R", o_r], capture_output=True, env=env, timeout=300)
        p = os.path.join(d, "verdict.txt")
        out[name] = open(p, errors="replace").read().strip() if os.path.exists(p) else "(no verdict.txt in the artifact)"
    return out


def is_measure_run(d):
    return d.get("workflowName") in MEASURE_WORKFLOWS and (d.get("headBranch") or "").startswith("measure/")


def fetch_job_log(o_r, run_id, job_id):
    env = dict(os.environ, GH_TOKEN=token(o_r))
    r = subprocess.run([FORGEJO_GH, "run", "view", str(run_id), "--log", "--job", str(job_id), "-R", o_r],
                       capture_output=True, text=True, env=env, timeout=300)
    return r.stdout


ANNOTATION = re.compile(r"::error\b[^:]*::")
MAX_JOB_LOG_FETCHES = 5


def job_log_lines(o_r, run_id, job, tail):
    """Relevant lines from a job's WHOLE log. Forgejo's per-step slices (what --log-failed prints) are shifted by a
    few lines from the stored log, so a failed step's slice can hold only its neighbours' checkout/cache lines while
    its `::error` annotation and output sit just past it (run 1988, takes (united-kingdom)). `::error` annotations
    first, else the strong/weak markers."""
    jid = job.get("databaseId") if isinstance(job, dict) else None
    if not jid:
        return []
    try:
        log = fetch_job_log(o_r, run_id, jid)
    except Exception:
        return []
    clean = [LOG_TS.sub("", ANSI.sub("", (l.split("\t", 2)[2] if l.count("\t") >= 2 else l))).rstrip() for l in log.splitlines()]
    notes = [l[:300] for l in clean if ANNOTATION.search(l)]
    if notes:
        return notes[-tail:]
    name = job.get("name", "?")
    return relevant_lines("\n".join(f"{name}\t-\t{l}" for l in clean), tail).get(name, [])


def failure_detail(o_r, run_id, failed, tail):
    """failed: job dicts (name, databaseId) or names."""
    if not failed or tail <= 0:
        return []
    try:
        per = relevant_lines(fetch_failed_log(o_r, run_id), tail)
    except Exception as e:
        return [f"  (could not read the failed log: {e})"]
    out, fetched = [], 0
    for jd in failed:
        job = jd["name"] if isinstance(jd, dict) else jd
        lines = per.get(job) or next((v for k, v in per.items() if k in job or job in k), [])
        if not lines and fetched < MAX_JOB_LOG_FETCHES and isinstance(jd, dict):
            fetched += 1
            lines = job_log_lines(o_r, run_id, jd, tail)
        out.append(f"  -- {job}: " + ("no FAILED/error/assert line in its log (0-length log or setup failure? see `agentctl ci-why`)" if not lines else f"last {len(lines)} relevant line(s)"))
        out += [f"     {l}" for l in lines]
    return out


def run_verdict(o_r, run_id, until="done", tail=0):
    """(done, ok, text) for a Forgejo run. until=landable: a measure run is done once its takes rows ended."""
    d = gh_json(o_r, "run", "view", str(run_id), "--json", "status,conclusion,jobs,workflowName,headBranch")
    jobs = d.get("jobs") or []
    head = f"run {o_r}#{run_id}"
    if until == "landable" and is_measure_run(d):
        takes = [j for j in jobs if j.get("name", "").startswith("takes")]
        if d.get("status") == "completed" or (takes and all(j.get("status") == "completed" for j in takes)):
            badj = [j for j in takes if j.get("conclusion") not in ("success", "skipped")]
            bad = [j["name"] for j in badj]
            lines = [f"{head}: takes rows ended ({len(takes)}): " + ("all green" if not bad else "failed: " + ", ".join(bad))]
            try:
                for name, text in sorted(fetch_takes_verdicts(o_r, run_id).items()):
                    lines += [f"  [{name}] {l}" for l in text.splitlines()]
            except Exception as e:
                lines.append(f"  (could not read the verdict files: {e})")
            lines.append(f"  collect the LANDABLE verdict: scripts/identity-measure --run {run_id}")
            lines += failure_detail(o_r, run_id, badj, tail)
            return True, not bad and bool(takes), "\n".join(lines)
        n_done = sum(1 for j in takes if j.get("status") == "completed")
        return False, None, f"{head}: {d.get('status')} (takes rows {n_done}/{len(takes)} ended)"
    if d.get("status") != "completed":
        return False, None, f"{head}: {d.get('status')}"
    concl = d.get("conclusion") or "unknown"
    failedj = [j for j in jobs if j.get("conclusion") in ("failure", "cancelled", "timed_out")]
    failed = [j["name"] for j in failedj]
    line = f"{head}: {concl}" + (f"; failed: {', '.join(failed)}" if failed else "")
    lines = [line] + failure_detail(o_r, run_id, failedj, tail)
    return True, concl in ("success", "skipped", "neutral"), "\n".join(lines)


def file_verdict(path, contains):
    if not os.path.exists(path):
        return False, None, f"file {path}: absent"
    if contains:
        try:
            with open(path, errors="replace") as f:
                if not re.search(contains, f.read(), re.M):
                    return False, None, f"file {path}: present, no match for {contains!r}"
        except OSError as e:
            return False, None, f"file {path}: unreadable ({e})"
    st = os.stat(path)
    when = dt.datetime.fromtimestamp(st.st_mtime, dt.timezone.utc).strftime("%H:%M:%SZ")
    return True, True, f"file {path}: present ({st.st_size} bytes, mtime {when})"


def foreign_loops_on(run_id):
    """Other (non-agentctl) processes already polling this run id."""
    me = os.getpid()
    out = []
    for pid, ppid, etime, cmd in ps():
        if pid in (me, os.getppid()) or "agentctl" in cmd:
            continue
        if re.search(rf"run view {run_id}\b|runs/{run_id}\b", cmd) and "sleep" in cmd:
            out.append(pid)
    return out


def default_repo():
    try:
        return slug(os.getcwd())
    except (SystemExit, RuntimeError):
        return SHORT["movies"]


def backoff(floor, cap):
    """Poll delays: floor, x1.5 each time, never above cap (<= 300 s)."""
    d = floor
    while True:
        yield d
        d = min(cap, d * 1.5)


class Waiter:
    """One target waited on: holds the target's lock (and polls) or attaches to the live holder's verdict file."""

    def __init__(self, d, key, check):
        self.key, self.check = key, check
        self.lock, self.verdict = os.path.join(d, key + ".lock"), os.path.join(d, key + ".verdict")
        self.owned, self.holder, self.result = False, None, None

    def acquire(self):
        """True if we own the lock now; False if a live waiter holds it (self.holder = its info)."""
        while True:
            try:
                fd = os.open(self.lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            except FileExistsError:
                try:
                    info = json.load(open(self.lock))
                except (OSError, ValueError):
                    info = {}
                pid = info.get("pid")
                if pid and pid_alive(pid):
                    self.holder = info
                    return False
                err(f"stale lock (pid {pid} gone), taking over")
                try:
                    os.unlink(self.lock)
                except FileNotFoundError:
                    pass
                continue
            with os.fdopen(fd, "w") as f:
                json.dump({"pid": os.getpid(), "started": ts(), "target": self.key}, f)
            self.owned = True
            try:
                os.unlink(self.verdict)
            except FileNotFoundError:
                pass
            return True

    def poll_owned(self):
        try:
            done, ok, text = self.check()
        except Exception as e:  # transient API trouble: report and keep waiting
            done, ok, text = False, None, f"check failed: {e}"
        if done:
            tmp = self.verdict + f".{os.getpid()}"
            with open(tmp, "w") as f:
                json.dump({"ok": ok, "line": text, "at": ts()}, f)
            os.replace(tmp, self.verdict)
            self.result = (ok, text)
        return text

    def poll_attached(self):
        """Holder gone: read its verdict, or take over when it left none."""
        pid = (self.holder or {}).get("pid")
        if os.path.exists(self.lock) and pid and pid_alive(pid):
            return
        try:
            v = json.load(open(self.verdict))
            self.result = (v["ok"], v["line"])
        except (OSError, ValueError, KeyError):
            err(f"{self.key}: waiter pid {pid} ended without a verdict; taking over")
            self.holder = None
            if not self.acquire():
                return

    def release(self):
        if self.owned:
            try:
                os.unlink(self.lock)
            except FileNotFoundError:
                pass
            self.owned = False


def wait_all(waiters, timeout, floor, cap):
    """Block until every waiter has a verdict. Prints each verdict as it lands. Exit 0 all ok, 1 any failed, 2 timeout."""
    deadline = time.time() + timeout
    attach_poll = float(os.environ.get("AGENTCTL_ATTACH_POLL", "15"))
    for w in waiters:
        if not w.acquire():
            err(f"{w.key}: attached to existing waiter pid {w.holder.get('pid')} (since {w.holder.get('started')}); not polling Forgejo")
    delays = backoff(floor, cap)
    next_check, last = 0.0, {}
    try:
        while True:
            pending = [w for w in waiters if w.result is None]
            if time.time() >= next_check:
                for w in pending:
                    if w.owned:
                        last[w.key] = w.poll_owned()
                        if w.result:
                            print(w.result[1], flush=True)
                next_check = time.time() + next(delays)
            for w in pending:
                if w.result is None and not w.owned:
                    w.poll_attached()
                    if w.result:
                        print(w.result[1], flush=True)
            pending = [w for w in waiters if w.result is None]
            if not pending:
                return 0 if all(w.result[0] for w in waiters) else 1
            if time.time() >= deadline:
                for w in pending:
                    print(f"TIMEOUT after {timeout}s; last: {last.get(w.key, 'attached to another waiter')}", flush=True)
                return 2
            step = next_check - time.time()
            if any(not w.owned for w in pending):
                step = min(step, attach_poll)
            time.sleep(max(0.05, min(step, deadline - time.time())))
    finally:
        for w in waiters:
            w.release()


def cmd_wait(a):
    floor = float(os.environ.get("AGENTCTL_MIN_INTERVAL", "60"))
    cap = max(floor, min(300, a.interval))
    d = os.path.join(scratch(), "agentctl-wait")
    os.makedirs(d, exist_ok=True)
    if a.kind == "run":
        ids = list(a.ids)
        repo = a.repo
        if ids and not ids[0].isdigit():  # legacy form: wait run <repo> <id>...
            repo = repo or ids[0]
            ids = ids[1:]
        if not ids or not all(i.isdigit() for i in ids):
            raise SystemExit("agentctl: wait run needs numeric run ids (action_run.id, the GITHUB_RUN_ID)")
        o_r = slug(repo) if repo else default_repo()
        waiters = []
        for i in dict.fromkeys(ids):
            others = foreign_loops_on(i)
            if others:
                err(f"note: other loops already poll run {i}: pids {others} (see `agentctl orphans`)")
            key = f"run-{o_r.replace('/', '_')}-{i}" + ("-landable" if a.until == "landable" else "")
            waiters.append(Waiter(d, key, (lambda i=i: run_verdict(o_r, int(i), a.until, a.tail))))
        return wait_all(waiters, a.timeout, floor, cap)
    path = os.path.abspath(a.target)
    key = "file-" + re.sub(r"[^\w.-]", "_", path)[-150:]
    return wait_all([Waiter(d, key, lambda: file_verdict(path, a.contains))], a.timeout, min(floor, a.interval), max(min(floor, a.interval), min(300, a.interval)))


