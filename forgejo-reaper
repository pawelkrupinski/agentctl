#!/usr/bin/env python3
"""forgejo-reaper: make Forgejo's non-cancelling concurrency groups behave like github.com.

GitHub keeps at most ONE pending run per concurrency group (a newer one replaces the older pending one); Forgejo 15
queues every run FIFO. This loop cancels each group's older WAITING runs and keeps the newest -- never a running one.

Reads waiting runs read-only from Forgejo's sqlite over ssh; cancels each through OUR actions API's GitHub-shaped
`POST /repos/<o>/<r>/actions/runs/<id>/cancel` (bitcashier infra nix/files/forgejo-gh/actions_api.py), which needs a
token with Actions write on the repository. The token comes from $FORGEJO_API_TOKEN or, failing that, the Touch ID
vault (`secrets get bitcashier FORGEJO_API_TOKEN`); it is never printed or put on argv.

The actions API listens on ci-runner only (port 3010; the laptop tunnel forwards just 3000/2222), so by default the
POST is made there with curl over the same ssh, its header read from stdin. Set $FORGEJO_ACTIONS_API to call it
directly instead (e.g. through a tunnel of your own).

Usage:  forgejo-reaper [--dry-run] [--once] [--interval 60] [--exclude-group REGEX ...]
"""
import argparse, json, os, re, subprocess, time, urllib.error, urllib.parse, urllib.request

SSH = ["ssh", "-o", "BatchMode=yes", "pawel@10.1.0.3"]
DB = "/mnt/data/forgejo/data/forgejo.db"
REMOTE_API = "http://localhost:3010"
QUERY = """
.mode json
select r.id, r."index" as idx, r.concurrency_group as grp, r.workflow_id as wf,
       (select u.lower_name from user u where u.id = repo.owner_id) as owner, repo.lower_name as repo
from action_run r join repository repo on repo.id = r.repo_id
where r.status = 5 and coalesce(r.concurrency_group, '') != '' and coalesce(r.concurrency_cancel, 0) = 0
order by r.repo_id, r.concurrency_group, r.id;
"""


def log(msg):
    print(time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), msg, flush=True)


def waiting_runs():
    cmd = SSH + [f'sudo -u forgejo nix --extra-experimental-features "nix-command flakes" shell nixpkgs#sqlite -c sqlite3 -readonly {DB}']
    out = subprocess.run(cmd, input=QUERY, capture_output=True, text=True, timeout=120)
    if out.returncode != 0:
        # an older schema may lack concurrency_cancel: retry without that filter
        q = QUERY.replace("and coalesce(r.concurrency_cancel, 0) = 0", "")
        out = subprocess.run(cmd, input=q, capture_output=True, text=True, timeout=120)
        out.check_returncode()
    return json.loads(out.stdout or "[]")


def superseded(runs, excludes):
    groups = {}
    for r in runs:
        if any(re.search(x, r["grp"]) for x in excludes):
            continue
        groups.setdefault((r["owner"], r["repo"], r["grp"]), []).append(r)
    victims = []
    for rs in groups.values():
        rs.sort(key=lambda r: r["id"])
        victims += rs[:-1]          # keep the newest waiting run of each group
    return victims


def api_token():
    tok = os.environ.get("FORGEJO_API_TOKEN", "").strip()
    if tok:
        return tok
    out = subprocess.run(["secrets", "get", "bitcashier", "FORGEJO_API_TOKEN"], capture_output=True, text=True)
    tok = out.stdout.strip()
    if out.returncode != 0 or not tok:
        raise RuntimeError("no token: set FORGEJO_API_TOKEN or unlock the vault (secrets unlock bitcashier)")
    return tok


def cancel_path(owner, repo, run_id):
    return f"/repos/{urllib.parse.quote(owner)}/{urllib.parse.quote(repo)}/actions/runs/{int(run_id)}/cancel"


def cancel(token, owner, repo, run_id):
    """The actions API's HTTP status for cancelling run `run_id` (action_run.id): 202 cancelled, 409 already done."""
    path = cancel_path(owner, repo, run_id)
    direct = os.environ.get("FORGEJO_ACTIONS_API", "").rstrip("/")
    if direct:
        req = urllib.request.Request(direct + path, data=b"", method="POST",
                                     headers={"Authorization": f"token {token}"})
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                return r.status
        except urllib.error.HTTPError as e:
            e.close()
            return e.code
    # curl on ci-runner; `-K -` reads the Authorization header from stdin, so the token is on no argv.
    cmd = SSH + [f"curl -sS -m 60 -o /dev/null -w '%{{http_code}}' -X POST -K - '{REMOTE_API}{path}'"]
    out = subprocess.run(cmd, input=f'header = "Authorization: token {token}"\n', capture_output=True, text=True,
                         timeout=120)
    try:
        return int(out.stdout.strip())
    except ValueError:
        raise RuntimeError(f"curl over ssh failed (exit {out.returncode}): {out.stderr.strip()[:200]}") from None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--interval", type=int, default=60)
    ap.add_argument("--exclude-group", action="append", default=[])
    a = ap.parse_args()
    token = None
    while True:
        try:
            victims = superseded(waiting_runs(), a.exclude_group)
            if victims and not a.dry_run and token is None:
                token = api_token()
            for v in victims:
                if a.dry_run:
                    log(f"would cancel {v['owner']}/{v['repo']} run {v['idx']} (id {v['id']}) group {v['grp']}")
                    continue
                st = cancel(token, v["owner"], v["repo"], v["id"])
                note = {202: "cancelled", 409: "already finished"}.get(st, "FAILED")
                log(f"cancel {v['owner']}/{v['repo']} run {v['idx']} (id {v['id']}) group {v['grp']}: HTTP {st} {note}")
            if not victims:
                log("nothing superseded")
        except Exception as e:  # keep looping through transient ssh/network errors
            log(f"error: {e}")
        if a.once:
            break
        time.sleep(a.interval)


if __name__ == "__main__":
    main()
