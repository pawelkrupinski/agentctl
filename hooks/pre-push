#!/bin/sh
# ~/bin's pre-push hook (core.hooksPath=hooks): main must stay green -- a push to main is live on the laptop at once,
# and ci-runner's auto-pin holds on a red tests.yml run. Runs the suite on EXACTLY the commit being pushed (a detached
# temporary worktree: never the uncommitted state of the pushing checkout), bounded, and refuses the push when it fails.
# Never bypass it (no --no-verify).
z=0000000000000000000000000000000000000000
rc=0
while read -r _lref lsha _rref _rsha; do
  [ "$lsha" = "$z" ] && continue  # a deletion: nothing to test
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/agentctl-prepush.XXXXXX")
  git worktree add -q --detach "$tmp/tree" "$lsha" || { rm -rf "$tmp"; exit 1; }
  echo "pre-push: tests/run.py on ${lsha%"${lsha#????????????}"} ..." >&2
  # --foreground: the suite stays in the push's process group, where `agentctl land` reads its CPU as progress (GNU
  # timeout's own group hid it: land ended the push as stalled, 2026-11-06); run.py's own bound ends its workers.
  # THE BOUND GROWS WITH THE LAPTOP'S LOAD (2026-11-21: d2be9d3 refused twice as SUITE TIMEOUT after 280 s, no test
  # failing, while other agents' what-ifs held load 30 on 18 cores): 280 s times load per core, 1x to 4x
  cores=${AGENTCTL_PREPUSH_CORES:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)}
  load=${AGENTCTL_PREPUSH_LOAD:-$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')}
  [ -n "$load" ] || load=$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)
  # ITS BASE IS THE SUITE'S OWN (2026-11-22: 82b6231 refused twice as SUITE TIMEOUT at 280 s, load 18-24, while every
  # full run that day took 415-525 s): 1.5 x the last full run's wall time (tests/run.py, suite-wall.json), at least 280
  wall=$(python3 -c 'import json, os, sys
try: print(float(json.load(open(os.path.expanduser("~/.cache/agentctl-tests/suite-wall.json")))["wall"]))
except Exception: print(0)' 2>/dev/null)
  bound=$(awk -v l="${load:-0}" -v c="$cores" -v w="${wall:-0}" 'BEGIN { f = (c > 0) ? l / c : 1; if (f < 1) f = 1; if (f > 4) f = 4;
                                                     b = 1.5 * w; if (b < 280) b = 280; printf "%d", b * f }')
  # the per-test timeout grows the same way (2026-11-22: queue_sim's mutation 1, ~40 s idle, timed out at load 290)
  per_test=$(awk -v b="$bound" 'BEGIN { printf "%d", 60 * b / 280 }')
  if ! (cd "$tmp/tree" && timeout --foreground -s KILL $((bound + 20)) python3 tests/run.py --suite-timeout "$bound" --timeout "$per_test" >"$tmp/out" 2>&1); then
    tail -40 "$tmp/out" >&2
    echo "pre-push: REFUSED -- the suite fails on $lsha (fix forward; never --no-verify)" >&2
    rc=1
  else
    tail -2 "$tmp/out" >&2
    # THE SIMULATOR GATE (tests/sim_gate.py): no invariant kind's violations rise against the remote's main, and no
    # invariant changes beside the code it measures. Against the remote's sha when this clone has it, else alone.
    base=""
    [ "$_rsha" != "$z" ] && git cat-file -e "$_rsha^{commit}" 2>/dev/null && base="--base $_rsha"
    # shellcheck disable=SC2086
    if [ -f "$tmp/tree/tests/sim_gate.py" ] && ! (cd "$tmp/tree" && timeout --foreground -s KILL 300 python3 tests/sim_gate.py $base >"$tmp/gate" 2>&1); then
      tail -20 "$tmp/gate" >&2
      echo "pre-push: REFUSED -- the simulator gate fails on $lsha (tests/sim_gate.py; fix forward)" >&2
      rc=1
    elif [ -f "$tmp/gate" ]; then
      tail -1 "$tmp/gate" >&2
    fi
    # THE RATCHETS (quality/ratchet.py; CLAUDE.md "The ratchets"): quality (complexity, length, duplication,
    # coupling) and types (mypy --strict) held to their baselines, the pushed range's baseline growth to its
    # trailers. The tools come from quality/tools.lock, installed outside the tree by quality/tools.py: a tool that
    # cannot be installed REFUSES the push with the fix, never a skip. The selftest seeds a violation of every
    # measure first, so a tool that measures nothing never passes.
    range=""
    [ -n "$base" ] && range="--range $_rsha..$lsha"
    if [ $rc -eq 0 ] && [ -f "$tmp/tree/quality/ratchet.py" ]; then
      if ! py=$(cd "$tmp/tree" && python3 quality/tools.py 2>"$tmp/tools"); then
        cat "$tmp/tools" >&2
        echo "pre-push: REFUSED -- the quality tools are not installed (the fix is above)" >&2
        rc=1
      # shellcheck disable=SC2086
      elif ! (cd "$tmp/tree" && "$py" quality/ratchet.py selftest && "$py" quality/ratchet.py check $range) >"$tmp/ratchet" 2>&1; then
        grep -v '^quality: fell\|^types: fell' "$tmp/ratchet" | tail -40 >&2
        echo "pre-push: REFUSED -- a ratchet refuses $lsha (quality/ratchet.py; fix forward)" >&2
        rc=1
      else
        tail -1 "$tmp/ratchet" >&2
      fi
    fi
  fi
  git worktree remove --force "$tmp/tree" >/dev/null 2>&1
  rm -rf "$tmp"
  [ $rc -ne 0 ] && exit $rc
done
exit 0
