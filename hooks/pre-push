#!/bin/sh
# ~/bin's pre-push hook (core.hooksPath=hooks): main must stay green -- a push to main is live on the laptop at once,
# and ci-runner's auto-pin holds on a red tests.yml run. Runs the suite on EXACTLY the commit being pushed (a detached
# temporary worktree: never the uncommitted state of the pushing checkout), bounded, and refuses the push when it fails.
# Never bypass it (no --no-verify).
z=0000000000000000000000000000000000000000
rc=0
while read -r _lref lsha _rref _rsha; do
  [ "$lsha" = "$z" ] && continue  # a deletion: nothing to test
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/agentctl-prepush.XXXXXX")
  git worktree add -q --detach "$tmp/tree" "$lsha" || { rm -rf "$tmp"; exit 1; }
  echo "pre-push: tests/run.py on ${lsha%"${lsha#????????????}"} ..." >&2
  # --foreground: the suite stays in the push's process group, where `agentctl land` reads its CPU as progress (GNU
  # timeout's own group hid it: land ended the push as stalled, 2026-11-06); run.py's own bound ends its workers.
  if ! (cd "$tmp/tree" && timeout --foreground -s KILL 300 python3 tests/run.py --suite-timeout 280 >"$tmp/out" 2>&1); then
    tail -40 "$tmp/out" >&2
    echo "pre-push: REFUSED -- the suite fails on $lsha (fix forward; never --no-verify)" >&2
    rc=1
  else
    tail -2 "$tmp/out" >&2
  fi
  git worktree remove --force "$tmp/tree" >/dev/null 2>&1
  rm -rf "$tmp"
  [ $rc -ne 0 ] && exit $rc
done
exit 0
