#!/bin/sh
# ~/bin's pre-push hook (core.hooksPath=hooks): main must stay green -- a push to main is live on the laptop at once,
# and ci-runner's auto-pin holds on a red tests.yml run. Runs the suite on EXACTLY the commit being pushed (a detached
# temporary worktree: never the uncommitted state of the pushing checkout), bounded, and refuses the push when it fails.
# Never bypass it (no --no-verify).
z=0000000000000000000000000000000000000000
rc=0
# Several agents push at once and a push rejected after the suite ran costs the whole suite again: the serialised
# push (devtools/selfpush.py: one lock, fetch, rebase, push) runs it once. A direct push still works.
[ -n "$AGENTCTL_SELFPUSH" ] || echo "pre-push: hint -- push with 'python3 devtools/selfpush.py' (serialised: the suite runs once even when main moves)" >&2
while read -r _lref lsha _rref _rsha; do
  [ "$lsha" = "$z" ] && continue  # a deletion: nothing to test
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/agentctl-prepush.XXXXXX")
  git worktree add -q --detach "$tmp/tree" "$lsha" || { rm -rf "$tmp"; exit 1; }
  echo "pre-push: tests/run.py on ${lsha%"${lsha#????????????}"} ..." >&2
  # govstep keeps the suite in the push's process group, where `agentctl land` reads its CPU as progress (GNU timeout's
  # own group hid it: land ended the push as stalled, 2026-11-06); run.py's own bound ends its workers.
  # THE BOUND GROWS WITH THE LAPTOP'S LOAD (2026-11-21: d2be9d3 refused twice as SUITE TIMEOUT after 280 s, no test
  # failing, while other agents' what-ifs held load 30 on 18 cores): 280 s times load per core, 1x to 4x
  cores=${AGENTCTL_PREPUSH_CORES:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)}
  load=${AGENTCTL_PREPUSH_LOAD:-$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')}
  [ -n "$load" ] || load=$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)
  # ITS BASE IS THE SUITE'S OWN (2026-11-22: 82b6231 refused twice as SUITE TIMEOUT at 280 s, load 18-24, while every
  # full run that day took 415-525 s): 1.5 x the last full run's wall time (tests/run.py, suite-wall.json), at least 280
  wall=$(python3 -c 'import json, os, sys
try: print(float(json.load(open(os.path.expanduser("~/.cache/agentctl-tests/suite-wall.json")))["wall"]))
except Exception: print(0)' 2>/dev/null)
  # THE FACTOR COUNTS THE SUITE'S OWN WORKERS (2026-11-27: 48f4bd1 refused as SUITE TIMEOUT at 560 s, none failing: the
  # load sampled before the suite, 17.6 on 18 cores, gave 1x, and its 8 workers then put ~26 threads on 18 cores)
  jobs=8
  bound=$(awk -v l="${load:-0}" -v j="$jobs" -v c="$cores" -v w="${wall:-0}" 'BEGIN { f = (c > 0) ? (l + j) / c : 1; if (f < 1) f = 1; if (f > 4) f = 4;
                                                     b = 1.5 * w; if (b < 280) b = 280; printf "%d", b * f }')
  # EVERY STEP RUNS UNDER devtools/govstep.py (2026-11-26: the stress lane's 300 s kill bound counted a 686 s wait for
  # cores, and a push was refused with no test failing): it takes the step's governor ticket, waiting at most
  # $AGENTCTL_GOV_WAIT (30 min) -- past that "governor busy", exit 75, not a test failure -- and starts the step's own
  # bound (--run) when the ticket is GRANTED. The runners inside run under that ticket and take none.
  gstep="python3 $tmp/tree/devtools/govstep.py"
  refuse() { # refuse <exit status> <what failed>: a governor that never admitted the step is no verdict on the code
    if [ "$1" -eq 75 ]; then
      echo "pre-push: REFUSED -- governor busy: no cores for $2 within ${AGENTCTL_GOV_WAIT:-1800} s (load, NOT a failure of $lsha; nothing was judged; push again when 'agentctl gov status' shows room)" >&2
    else
      echo "pre-push: REFUSED -- $3" >&2
    fi
  }
  # A PUSH OF VENDORED COPIES ALONE IS SCOPED (devtools/vendorscope.py, 2026-11-28: a full suite at load 25-45 timed out twice on a
  # correct, mechanical 5-file sync): test_vendored and the tests importing a changed copy, the simulator gate only when the
  # simulator imports one, no stress lane or e2e (the push touches no test). Every other push runs everything.
  scope=full
  if [ "$_rsha" != "$z" ] && git cat-file -e "$_rsha^{commit}" 2>/dev/null && [ -f "$tmp/tree/devtools/vendorscope.py" ]; then
    scope=$(cd "$tmp/tree" && python3 devtools/vendorscope.py "$_rsha..$lsha" 2>/dev/null | head -1)
    [ -n "$scope" ] || scope=full
  fi
  patterns=""; sim=1
  case "$scope" in
    scoped*) echo "pre-push: vendored copies only: the scoped suite ($scope)" >&2
             sim=0; case "$scope" in *"sim=1"*) sim=1 ;; esac
             patterns=${scope#scoped sim=? } ;;
    *) scope=full ;;
  esac
  per_test=$(awk -v b="$bound" 'BEGIN { printf "%d", 60 * b / 280 }')
  [ -f "$tmp/tree/devtools/govstep.py" ] || gstep=""  # a pushed tree older than the tool
  (cd "$tmp/tree" && $gstep${gstep:+ --job prepush-suite --cores $jobs --run $((bound + 120)) --} python3 tests/run.py -j "$jobs" --suite-timeout "$bound" --timeout "$per_test" $patterns >"$tmp/out" 2>&1); st=$?
  if [ $st -ne 0 ]; then
    tail -40 "$tmp/out" >&2
    refuse $st "the suite" "the suite fails on $lsha (fix forward; never --no-verify)"
    rc=1
  else
    tail -2 "$tmp/out" >&2
    # THE STRESS LANE (tests/stress.py, 2026-11-25): the tests this push touches, 5 more times each, shuffled, under a
    # raised test-clock lag, at most ~45 s: a newly flaky test fails the push (its seed and REPLAY line are printed).
    if [ $rc -eq 0 ] && [ "$scope" = full ] && [ "$_rsha" != "$z" ] && git cat-file -e "$_rsha^{commit}" 2>/dev/null && [ -f "$tmp/tree/tests/stress.py" ]; then
      (cd "$tmp/tree" && $gstep${gstep:+ --job prepush-stress --cores 8 --run 300 --} python3 tests/stress.py --range "$_rsha..$lsha" >"$tmp/stress" 2>&1); st=$?
      if [ $st -ne 0 ]; then
        tail -30 "$tmp/stress" >&2
        refuse $st "the stress lane" "the stress lane fails on $lsha (a test of this push is flaky: replay with the REPLAY line)"
        rc=1
      else
        tail -2 "$tmp/stress" >&2
      fi
    fi
    # THE END-TO-END LAYER (tests/e2e/run.py, the owner 2026-11-27): the real store server, reconciler tick, sync and
    # laptop CLI against a real git remote and a stub GitHub, one temp root per scenario, ~2 min; the scenarios run
    # under the step's ticket.
    if [ $rc -eq 0 ] && [ "$scope" = full ] && [ -f "$tmp/tree/tests/e2e/run.py" ]; then
      (cd "$tmp/tree" && $gstep${gstep:+ --job prepush-e2e --cores 4 --run 420 --} python3 tests/e2e/run.py >"$tmp/e2e" 2>&1); st=$?
      if [ $st -ne 0 ]; then
        tail -60 "$tmp/e2e" >&2
        refuse $st "the e2e layer" "the e2e layer fails on $lsha (tests/e2e/run.py; fix forward)"
        rc=1
      else
        tail -2 "$tmp/e2e" >&2
      fi
    fi
    # THE SIMULATOR GATE (tests/sim_gate.py): no invariant kind's violations rise against the remote's main, and no
    # invariant changes beside the code it measures. Against the remote's sha when this clone has it, else alone. Its
    # chunks run under the step's ticket (THE GOVERNED FAN-OUT); the 1220 s bound starts at the grant.
    base=""
    [ "$_rsha" != "$z" ] && git cat-file -e "$_rsha^{commit}" 2>/dev/null && base="--base $_rsha"
    # shellcheck disable=SC2086
    st=0
    [ "$sim" = 1 ] && [ -f "$tmp/tree/tests/sim_gate.py" ] && { (cd "$tmp/tree" && $gstep${gstep:+ --job prepush-gate --cores 8 --run 1220 --} python3 tests/sim_gate.py $base >"$tmp/gate" 2>&1); st=$?; }
    if [ $st -ne 0 ]; then
      tail -20 "$tmp/gate" >&2
      refuse $st "the simulator gate" "the simulator gate fails on $lsha (tests/sim_gate.py; fix forward)"
      rc=1
    elif [ -f "$tmp/gate" ]; then
      tail -1 "$tmp/gate" >&2
    fi
    # THE RATCHETS (quality/ratchet.py; CLAUDE.md "The ratchets"): quality (complexity, length, duplication,
    # coupling) and types (mypy --strict) held to their baselines, the pushed range's baseline growth to its
    # trailers. The tools come from quality/tools.lock, installed outside the tree by quality/tools.py: a tool that
    # cannot be installed REFUSES the push with the fix, never a skip. The selftest seeds a violation of every
    # measure first, so a tool that measures nothing never passes.
    range=""
    [ -n "$base" ] && range="--range $_rsha..$lsha"
    if [ $rc -eq 0 ] && [ -f "$tmp/tree/quality/ratchet.py" ]; then
      if ! py=$(cd "$tmp/tree" && python3 quality/tools.py 2>"$tmp/tools"); then
        cat "$tmp/tools" >&2
        echo "pre-push: REFUSED -- the quality tools are not installed (the fix is above)" >&2
        rc=1
      # shellcheck disable=SC2086
      elif ! (cd "$tmp/tree" && "$py" quality/ratchet.py selftest && "$py" quality/ratchet.py check $range) >"$tmp/ratchet" 2>&1; then
        grep -v '^quality: fell\|^types: fell' "$tmp/ratchet" | tail -40 >&2
        echo "pre-push: REFUSED -- a ratchet refuses $lsha (quality/ratchet.py; fix forward)" >&2
        rc=1
      else
        tail -1 "$tmp/ratchet" >&2
      fi
    fi
  fi
  git worktree remove --force "$tmp/tree" >/dev/null 2>&1
  rm -rf "$tmp"
  [ $rc -ne 0 ] && exit $rc
done
exit 0
