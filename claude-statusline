#!/bin/bash
# Claude Code status line: the movies landing state in one line.
#   gate RED (convergence #2036) · waiting: 3 — dep-index step 1…, metrics fix… · inbox: 2 unread
# The status line runs often, so this prints a cached line at once and refreshes the cache in the background
# at most once a minute (ci-why talks to Forgejo). `claude-statusline --refresh` rebuilds it in the foreground.
set -u
cache="${HOME}/.cache/agentctl/statusline.txt"
lock="${HOME}/.cache/agentctl/statusline.lock"
repo="${HOME}/projects/movies"
mkdir -p "$(dirname "$cache")"
cat >/dev/null # the session JSON Claude Code sends on stdin; not needed

refresh() {
  local gate waiting inbox line
  gate=$(cd "$repo" && ~/bin/agentctl ci-why 2>/dev/null | awk '
    NR == 1 { state = ($0 ~ /is RED/) ? "RED" : (($0 ~ /is green/) ? "green" : "?") }
    / RED \(run / { split($0, a, ":"); name = a[1]; sub(/^ +/, "", name)
                    if (match($0, /#[0-9]+/)) { n2 = tolower(name); sub(/identity model /, "", n2); sub(/verify scrape /, "", n2)
                                                reds = reds (reds ? ", " : "") n2 " " substr($0, RSTART, RLENGTH) } }
    END { printf "gate %s", state; if (reds) printf " (%s)", reds }')
  waiting=$(cd "$repo" && ~/bin/agentctl waiting status 2>/dev/null | awk '
    /^  [0-9]{8}-/ { n++; w = $2; sub(".*/movies-wt-", "", w); names = names (names ? ", " : "") w }
    END { if (n) printf "waiting: %d — %s", n, names; else printf "waiting: 0" }')
  # ci-why takes ~20 s and talks to Forgejo; if it came back empty, keep the last good gate rather than blank it
  case "$gate" in "gate RED"* | "gate green"*) ;; *) gate=$(sed -n 's/ · waiting:.*//p' "$cache" 2>/dev/null) ;; esac
  inbox=$(~/bin/agentctl inbox --unread 2>/dev/null | grep -c UNREAD)
  line="${gate:-gate ?} · ${waiting:-waiting: ?} · inbox: ${inbox:-0} unread"
  printf '%s\n' "$line" >"$cache.tmp" && mv "$cache.tmp" "$cache"
}

if [ "${1:-}" = "--refresh" ]; then refresh; cat "$cache"; exit 0; fi
if [ "${1:-}" = "--refresh-only" ]; then refresh; exit 0; fi

age=999999
[ -f "$cache" ] && age=$(( $(date +%s) - $(stat -f %m "$cache") ))
# Claude Code ends the status-line command's process group, so the refresh runs in a session of its own
# (python's start_new_session; macOS has no setsid). A lock older than 5 min is a refresh that died: take it over.
[ -d "$lock" ] && [ $(( $(date +%s) - $(stat -f %m "$lock") )) -ge 300 ] && rmdir "$lock" 2>/dev/null
if [ "$age" -ge 60 ] && mkdir "$lock" 2>/dev/null; then
  python3 -c 'import subprocess, sys
subprocess.Popen(["/bin/bash", "-c", "trap \"rmdir \\\"$1\\\"\" EXIT; \"$0\" --refresh-only", sys.argv[1], sys.argv[2]],
                 start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)' \
    "$0" "$lock"
fi
if [ -f "$cache" ]; then cat "$cache"; else echo "landing state: loading…"; fi
