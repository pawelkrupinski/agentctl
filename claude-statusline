#!/bin/bash
# Claude Code status line: the movies landing state in one line.
#   gate RED (main #2066 → fix 0a5767c awaiting #2070; convergence green) · waiting: 3 — dep-index, … · inbox: 2 unread
# An unacked escalation (`ESCALATED: ...`, agentctl inbox escalated) follows the gate. A red whose offer nobody took in time (offered (ESCALATED)), one waiting on the owner (BLOCKED ON OWNER, WAITING ON YOU: <question>) and a branch red that PREDICTS MAIN RED are
# shown in bold red; a cache older than 5 min says `as of HH:MM`. Branch reds (runs on measure/check/fixer branches)
# follow main's, apart: `branch reds: N → owner (workflow #n)`.
# The status line runs often, so this prints a cached line at once and refreshes the cache in the background
# at most every 15 s (state.json and the inbox: local reads only; Claude Code re-runs this every 10 s: statusLine.refreshInterval). `claude-statusline --refresh` rebuilds it in the foreground.
set -u
cache="${AGENTCTL_STATUSLINE_CACHE:-${HOME}/.cache/agentctl/statusline.txt}"
lock="${cache%.txt}.lock"
repo="${AGENTCTL_STATUSLINE_REPO:-${HOME}/projects/movies}"
mkdir -p "$(dirname "$cache")"
# WHEN IT SHOWS (owner 2026-11-04): while movies work is active. In a session working in a movies checkout
# (~/projects/movies, ~/projects/movies-*) always; in any other session only while something is happening on
# movies -- the cached line names a red, a change checking/waiting, a WAITING ON YOU / ESCALATED / BLOCKED, or an
# agent touched a movies worktree's git index in the last 30 min. All idle: an empty status line.
# AGENTCTL_STATUSLINE_ALWAYS=1 shows it everywhere; --refresh / --refresh-only (no session) always run.
in_movies=0
case "${1:-}" in
  --refresh|--refresh-only) in_movies=1 ;;
  *)
    dir=$(python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: d={}
print((d.get("workspace") or {}).get("current_dir") or d.get("cwd") or "")' 2>/dev/null)
    case "${AGENTCTL_STATUSLINE_ALWAYS:-}:$dir/" in
      1:*|*:"$HOME"/projects/movies/*|*:"$HOME"/projects/movies-*) in_movies=1 ;;
    esac ;;
esac
movies_active() { # cheap: the cached line and a few stats, no git, no network
  local c="${AGENTCTL_STATUSLINE_CACHE:-${HOME}/.cache/agentctl/statusline.txt}"
  [ -f "$c" ] && grep -qE 'gate (RED|UNREAD|\?)|reds: [1-9]|checking: [1-9]|waiting: [1-9]|WAITING ON YOU|ESCALATED|BLOCKED|STALLED|branch reds: [1-9]|inbox: [1-9]' "$c" && return 0
  local g="${HOME}/projects/movies/.git"
  [ -n "$(find "$g/index" "$g"/worktrees/*/index -maxdepth 0 -mmin -30 2>/dev/null | head -1)" ] && return 0
  return 1
}

refresh() {
  local gate inbox esc line
  # `agentctl status --line`: the processor's snapshot (state.json) alone -- the gate line, waiting / checking, and
  # `RECONCILER STALLED since HH:MM` when its tick is old. No git, no GitHub (design §9).
  gate=$(~/bin/agentctl status --line 2>/dev/null | tail -1)
  inbox=$(~/bin/agentctl inbox --unread --audience owner 2>/dev/null | grep -c UNREAD)  # the owner's alerts only (THE ALERT MODEL)
  # an unacked escalation: notified (macOS) and following the gate, in bold
  esc=$(~/bin/agentctl inbox escalated 2>/dev/null | head -1)
  line="${gate:-gate ?} · ${esc:+$esc · }inbox: ${inbox:-0} unread"  # the gate first (owner)
  printf '%s\n' "$line" >"$cache.tmp" && mv "$cache.tmp" "$cache"
}

show() { # the cached line, an escalated offer / BLOCKED ON OWNER in bold red, and its age once it is over 5 min old
  local stale=""
  [ "$age" -ge 300 ] && stale=" · as of $(date -r "$(stat -f %m "$cache")" +%H:%M)"
  sed -e $'s/\\(ESCALATED: [^·]*\\)/\033[1;31m\\1\033[0m/' -e $'s/offered (ESCALATED)/\033[1;31moffered (ESCALATED)\033[0m/g' -e $'s/PREDICTS MAIN RED/\033[1;31mPREDICTS MAIN RED\033[0m/g' -e $'s/gate UNREAD/\033[1;31mgate UNREAD\033[0m/' -e $'s/BLOCKED ON OWNER\\([^;)]*\\)/\033[1;31mBLOCKED ON OWNER\\1\033[0m/g' -e $'s/WAITING ON YOU: \\([^;·]*\\)/\033[1;31mWAITING ON YOU: \\1\033[0m/g' "$cache" \
    | sed "s/\$/$stale/"
}
if [ "${1:-}" = "--refresh" ]; then refresh; age=0; show; exit 0; fi
if [ "${1:-}" = "--refresh-only" ]; then refresh; exit 0; fi

age=999999
[ -f "$cache" ] && age=$(( $(date +%s) - $(stat -f %m "$cache") ))
# Claude Code ends the status-line command's process group, so the refresh runs in a session of its own
# (python's start_new_session; macOS has no setsid). A lock older than 5 min is a refresh that died: take it over.
[ -d "$lock" ] && [ $(( $(date +%s) - $(stat -f %m "$lock") )) -ge 300 ] && rmdir "$lock" 2>/dev/null
if [ "$age" -ge 15 ] && mkdir "$lock" 2>/dev/null; then
  python3 -c 'import subprocess, sys
subprocess.Popen(["/bin/bash", "-c", "trap \"rmdir \\\"$1\\\"\" EXIT; \"$0\" --refresh-only", sys.argv[1], sys.argv[2]],
                 start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)' \
    "$0" "$lock"
fi
[ "$in_movies" = 1 ] || movies_active || exit 0
if [ -f "$cache" ]; then show; else echo "landing state: loading…"; fi
